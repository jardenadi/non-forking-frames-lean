      · rw [xa1 b' h]; exact Vi a' ha b' h hab
      · rw [h, xa2]; exact lext a' ha
    · intro β hβ hl'
      show (xa β).carrier = _
      rcases (show β ≤ t from hβ).lt_or_eq with h | h
      · rw [xa1 β h, Vc β h hl']
        exact Set.iUnion₂_congr fun ζ hζ => by
          show _ = (xa ζ).carrier
          rw [xa1 ζ (lt_trans hζ h)]
      · rw [h, xa2, uxt.1]
        exact Set.iUnion₂_congr fun ζ hζ => by
          show _ = (xa ζ).carrier
          rw [xa1 ζ hζ]
    · show s.S.le (xa t) xT
      rw [xa2]; exact xtT
    · have hεt : ε < t := lt_of_le_of_lt hε hr
      show s.S.le ((c r).1 ε) (xa ε)
      rw [xa1 ε hεt]
      have := leV ε hεt r hr
