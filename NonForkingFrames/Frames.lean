          have e := (prev β hβ (lt_trans hβ hακ)).2.2
          exact hS.sub (hAlt β (lt_trans hβ hακ) α hακ hβ).1 (e ▸ (⟨hx0, hxβ⟩ : x ∈ M₀.carrier ∩ (c β).carrier))
        · intro hx
