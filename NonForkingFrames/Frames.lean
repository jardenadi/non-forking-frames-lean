/-- AUX: not in paper. The limit ordinals above `t` form a club of `λ⁺`. -/
theorem ClubL.limits {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {t : Ordinal.{u}}
    (ht : t < (Order.succ lam).ord) : ClubL lam {ε | Order.IsSuccLimit ε ∧ t < ε} := by
  have hp := Ordinal.isPrincipal_add_ord (hinf.trans (Order.le_succ lam))
  have hω : Ordinal.omega0 < (Order.succ lam).ord := by
    rw [Cardinal.lt_ord, Ordinal.card_omega0]
