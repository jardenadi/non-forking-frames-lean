      constructor
      · intro hx
        obtain ⟨i, hi, rfl⟩ := hecov x hx
        have hi1 := hκl.add_one_lt hi
        refine ⟨i + 1, hi1, hS.sub (tT (i + 1) _ le_add_self (tlt ε _ hε hi1)) ?_⟩
        exact ((hG (i + 1) hi1).2.2.2.2.2 i rfl).2.2.2.2
      · rintro ⟨i, hi, hx⟩
        exact hS.sub (hTle i hi) hx
    · exact fun i hi => hS.incl _ _ (hTle i hi)
  have hNcont : ∀ β < κ, Order.IsSuccLimit β →
      (Mε (1 + β)).carrier = ⋃ ζ ∈ Iio β, (Mε (1 + ζ)).carrier := by
    intro β hβ hl
    have hb : 1 + β = β := Ordinal.one_add_of_omega0_le (Ordinal.omega0_le_of_isSuccLimit hl)
    rw [hb, Mcont β hβ hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ζ, hζ, hx⟩
      refine ⟨ζ, hζ, ?_⟩
      rcases (le_add_self : ζ ≤ 1 + ζ).lt_or_eq with h' | h'
      · exact hS.sub (Minc _ (hζ.trans hβ) _ (hadd h1κ (hζ.trans hβ)) h') hx
      · rw [← h']; exact hx
    · rintro ⟨ζ, hζ, hx⟩
      have h1 : 1 + ζ < β := by
        have := (add_lt_add_iff_left (1 : Ordinal.{u})).2 hζ
        rwa [hb] at this
      exact ⟨_, h1, hx⟩
  have hsat : ∀ ε, ε < κ → Mε (1 + ε) ∈ s.Ksat lam := by
    intro ε
    induction ε using Ordinal.lt_wf.induction with
    | _ ε ih =>
      intro hε
      rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h0 | ⟨η, hη⟩ | hl
      · subst h0
        have e1 : (1 : Ordinal.{u}) + 0 = 0 + 1 := by simp
        rw [e1]
        exact prop_7_1_10_b lam hU s hs7 _ _ (hplus 0 hκl.bot_lt)
      · have hη' : ε = η + 1 := hη.symm
        subst hη'
        have hη1 : η < κ := lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hε.le
        rw [show (1 : Ordinal.{u}) + (η + 1) = 1 + η + 1 from (add_assoc _ _ _).symm]
        exact prop_7_1_10_b lam hU s hs7 _ _ (hplus _ (hadd h1κ hη1))
      · have hb : 1 + ε = ε := Ordinal.one_add_of_omega0_le (Ordinal.omega0_le_of_isSuccLimit hl)
        have hεκ₂ := hε.trans hκ₂
        have hNlt : ∀ ζ < ε, 1 + ζ < κ := fun ζ hζ => hadd h1κ (hζ.trans hε)
        have hNi : IsIncreasing s.S.le (fun ζ => Mε (1 + ζ)) (Iio ε) := fun x hx y' hy' h' =>
          Minc _ (hNlt x hx) _ (hNlt y' hy') ((add_lt_add_iff_left _).2 h')
        have hNc : IsContinuous (fun ζ => Mε (1 + ζ)) (Iio ε) := fun β hβ hl' =>
          hNcont β (lt_trans hβ hε) hl'
        have hNstep : ∀ i, i + 1 < ε → s.leNF lam (Mε (1 + i)) (Mε (1 + (i + 1))) := by
          intro i hi
          have hi' : i < ε := lt_trans (Order.lt_add_one_iff.2 le_rfl) hi
          rw [show (1 : Ordinal.{u}) + (i + 1) = 1 + i + 1 from (add_assoc _ _ _).symm]
          exact (prop_7_1_10_a lam hU s hs7 _ _ (hplus _ (hNlt i hi'))).1
        have hnfc := Frame.leNF_chain hU hs6 hinf hεκ₂ hNi hNc hNstep
        obtain ⟨Q, hQ, kQ, -⟩ := thm_7_1_18_a lam hU s hs7 ε hl hεκ₂ (fun ζ => Mε (1 + ζ))
          (fun x hx y' hy' h' => ⟨ih x hx (hx.trans hε), ih y' hy' (hy'.trans hε), hnfc x hx y' hy' h'⟩) hNc
        have uε : IsUnionOf (fun ζ => Mε (1 + ζ)) (Iio ε) (Mε (1 + ε)) := by
          refine ⟨hNcont ε hε hl, fun ζ hζ => hS.incl _ _ (Minc _ (hNlt ζ hζ) _ (hadd h1κ hε) ?_)⟩
          exact (add_lt_add_iff_left _).2 hζ
        have hsubN : ∀ α < ε, ∀ β < ε, α < β →
            (Mε (1 + α)).carrier ⊆ (Mε (1 + β)).carrier := fun α hα β hβ h' =>
          hS.sub (Minc _ (hNlt α hα) _ (hNlt β hβ) ((add_lt_add_iff_left _).2 h'))
        rw [← IsUnionOf.unique hl hsubN hQ uε]
        exact kQ
  let N : Ordinal.{u} → Model U L := fun ε =>
    if ε < κ then Mε (1 + ε) else if ε = κ then M₁s else M₂s
  have N1 : ∀ ε < κ, N ε = Mε (1 + ε) := fun ε hε => by simp [N, hε]
  have Nκ : N κ = M₁s := by simp [N]
  have Nκ1 : N (κ + 1) = M₂s := by
    have h1' : ¬ (κ + 1 < κ) := not_lt.2 (Order.le_succ κ)
    have h2' : κ + 1 ≠ κ := (Order.lt_add_one_iff.2 le_rfl).ne'
    simp [N, h1', h2']
  have hκ1 : κ < κ + 1 := Order.lt_add_one_iff.2 le_rfl
  refine ⟨N, ⟨?_, ?_, ?_⟩, Nκ, Nκ1, fun ε hε => ?_, fun ε hε => ?_⟩
  · intro x hx y' hy' hxy
    have hxκ : x ≤ κ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hxy hy')
    rcases (show y' ≤ κ + 1 from hy').lt_or_eq with h' | h'
    · have hy'κ : y' ≤ κ := Order.lt_add_one_iff.1 h'
      rcases hy'κ.lt_or_eq with h'' | h''
      · rw [N1 x (hxy.trans h''), N1 y' h'']
        exact Minc _ (hadd h1κ (hxy.trans h'')) _ (hadd h1κ h'') ((add_lt_add_iff_left _).2 hxy)
      · rw [h'', Nκ, N1 x (h'' ▸ hxy)]
        exact Mle _ (hadd h1κ (h'' ▸ hxy))
    · rw [h', Nκ1]
      rcases hxκ.lt_or_eq with h'' | h''
      · rw [N1 x h'']; exact hS.trans (Mle _ (hadd h1κ h'')) l12
      · rw [h'', Nκ]; exact l12
  · intro β hβ hl
    have hβκ : β ≤ κ := by
      rcases (show β ≤ κ + 1 from hβ).lt_or_eq with h' | h'
      · exact Order.lt_add_one_iff.1 h'
      · exact absurd (h' ▸ hl) fun hl' => lt_irrefl _ (hl'.add_one_lt hκ1)
    rcases hβκ.lt_or_eq with h' | h'
    · show (N β).carrier = _
      rw [N1 β h', hNcont β h' hl]
      exact Set.iUnion₂_congr fun ζ hζ => by rw [N1 ζ (lt_trans hζ h')]
    · subst h'
      show (N κ).carrier = _
      rw [Nκ]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · intro hx
        obtain ⟨i, hi, rfl⟩ := hecov x (hS.sub l12 hx)
        have hi1 := hκl.add_one_lt hi
        refine ⟨i + 1, hi1, ?_⟩
        rw [N1 _ hi1]
        have hin := hcov i hi hx
        rcases (le_add_self : i + 1 ≤ 1 + (i + 1)).lt_or_eq with h'' | h''
        · exact hS.sub (Minc _ hi1 _ (hadd h1κ hi1) h'') hin
        · rw [← h'']; exact hin
      · rintro ⟨ζ, hζ, hx⟩
        rw [N1 ζ hζ] at hx
        exact hS.sub (Mle _ (hadd h1κ hζ)) hx
  · intro ε hε
    rcases (show ε ≤ κ + 1 from hε).lt_or_eq with h' | h'
    · rcases (Order.lt_add_one_iff.1 h').lt_or_eq with h'' | h''
      · rw [N1 ε h'']; exact hsat ε h''
      · rw [h'', Nκ]; exact k₁
    · rw [h', Nκ1]; exact k₂
  · rw [N1 ε hε, N1 _ (hκl.add_one_lt hε),
      show (1 : Ordinal.{u}) + (ε + 1) = 1 + ε + 1 from (add_assoc _ _ _).symm]
    exact hplus _ (hadd h1κ hε)
  · rw [N1 ε hε]; exact hnf _ (hadd h1κ hε)

/-- AUX: not in paper. Inside an increasing continuous `⟨M_ε : ε < θ⟩` (`θ < λ⁺` limit), a sequence
`N_ε ≼ M_ε` in `K_λ`, increasing continuous, above `N₀` at `0`, with `A ∩ M_ε ⊆ N_{ε+1}`, for a set
`A` of size `≤ λ`: the sequence of Case b in the proofs of Thm 2.6.8(4),(5). -/
theorem IsAEC.approx_chain {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hL : S.LST ≤ lam)
    (hinf : ℵ₀ ≤ lam) {θ : Ordinal.{u}} (hθ' : θ < (Order.succ lam).ord)
    {M : Ordinal.{u} → Model U L} (hi : IsIncreasing S.le M (Iio θ)) (hK : ∀ ε < θ, M ε ∈ S.K)
    {N₀ : Model U L} (kN₀ : N₀ ∈ S.Kc lam) (l0 : 0 < θ → S.le N₀ (M 0)) {A : Set U} (hA : #A ≤ lam) :
    ∃ Y : Ordinal.{u} → Model U L, (∀ ε < θ, Y ε ∈ S.Kc lam ∧ S.le (Y ε) (M ε)) ∧
      IsIncreasing S.le Y (Iio θ) ∧ IsContinuous Y (Iio θ) ∧ (0 < θ → Y 0 = N₀) ∧
      ∀ ε, ε + 1 < θ → A ∩ (M ε).carrier ⊆ (Y (ε + 1)).carrier := by
  classical
  have : Nonempty (Model U L) := ⟨N₀⟩
  have hsubM : ∀ a < θ, ∀ b < θ, a ≤ b → (M a).carrier ⊆ (M b).carrier := fun a ha b hb h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hi a ha b hb h')
    · rw [h']
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun ε c =>
    ε < θ → c ε ∈ S.Kc lam ∧ S.le (c ε) (M ε) ∧ (∀ ζ < ε, S.le (c ζ) (c ε)) ∧
      (Order.IsSuccLimit ε → (c ε).carrier = ⋃ ζ ∈ Iio ε, (c ζ).carrier) ∧ (ε = 0 → c ε = N₀) ∧
      ∀ η, ε = η + 1 → A ∩ (M η).carrier ⊆ (c ε).carrier
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' e h hα
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h hα
    have eα := e α le_rfl
    refine ⟨eα ▸ h1, eα ▸ h2, fun ζ hζ => by rw [← eα, ← e ζ hζ.le]; exact h3 ζ hζ, fun hl => ?_,
      fun h0 => eα ▸ h5 h0, fun η hη => eα ▸ h6 η hη⟩
    rw [← eα, h4 hl]
    exact Set.iUnion₂_congr fun ζ hζ => by rw [e ζ (le_of_lt hζ)]
  obtain ⟨c, hcI⟩ := transfinite_construction θ Inv hloc (by
    intro ε hεθ c ih
    by_cases hε : ε < θ
    swap
    · exact ⟨N₀, fun h => absurd h hε⟩
    have ih' : ∀ ζ < ε, _ := fun ζ hζ => ih ζ hζ (hζ.trans hε)
    suffices hx : ∃ x : Model U L, x ∈ S.Kc lam ∧ S.le x (M ε) ∧ (∀ ζ < ε, S.le (c ζ) x) ∧
        (Order.IsSuccLimit ε → x.carrier = ⋃ ζ ∈ Iio ε, (c ζ).carrier) ∧ (ε = 0 → x = N₀) ∧
        ∀ η, ε = η + 1 → A ∩ (M η).carrier ⊆ x.carrier by
      obtain ⟨x, h1, h2, h3, h4, h5, h6⟩ := hx
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, h2, fun ζ hζ => ?_, fun hl => ?_, h5, h6⟩
      · simp only [hζ, ite_true]; exact h3 ζ hζ
      · rw [h4 hl]
        exact Set.iUnion₂_congr fun ζ hζ => by
          have : ζ < ε := hζ
          simp only [this, ite_true]
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h0 | ⟨η, hη⟩ | hl
    · subst h0
      exact ⟨N₀, kN₀, l0 hε, fun ζ hζ => absurd hζ (not_lt.2 zero_le),
        fun hl => absurd hl Order.not_isSuccLimit_bot, fun _ => rfl, fun η h => absurd h.symm (by simp)⟩
    · have hη' : ε = η + 1 := hη.symm
      subst hη'
      have hηlt : η < η + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨kc, lc, -, -, -, -⟩ := ih' η hηlt
      have hsubX : (c η).carrier ∪ (A ∩ (M η).carrier) ⊆ (M (η + 1)).carrier :=
        Set.union_subset ((hS.sub lc).trans (hsubM η (hηlt.trans hε) _ hε hηlt.le))
          (fun y hy => hsubM η (hηlt.trans hε) _ hε hηlt.le hy.2)
      have hcard : #((c η).carrier ∪ (A ∩ (M η).carrier) : Set U) ≤ lam :=
        (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kc.2)
          ((Cardinal.mk_le_mk_of_subset Set.inter_subset_left).trans hA))
      obtain ⟨W, kW, hsW, lW⟩ := hS.exists_hull hL hinf kc (hK _ hε) Set.subset_union_left hsubX hcard
      have le1 : S.le (c η) W := hS.le_of_sub (hS.trans lc (hi η (hηlt.trans hε) _ hε hηlt)) lW
        (Set.subset_union_left.trans hsW)
      refine ⟨W, kW, lW, fun ζ hζ => ?_, fun hl' => absurd hl' fun hl' => lt_irrefl _
        (hl'.add_one_lt hηlt), fun h => absurd h (by simp), fun η' he y hy => ?_⟩
      · rcases (Order.lt_succ_iff.1 hζ).lt_or_eq with h | h
        · exact hS.trans ((ih' η hηlt).2.2.1 ζ h) le1
        · rw [h]; exact le1
      · have : η' = η := (Order.succ_injective (show Order.succ η = Order.succ η' from he)).symm
        rw [this] at hy
        exact hsW (Or.inr hy)
    · have hco : IsContinuous c (Iio ε) := fun β hβ hl' => (ih' β hβ).2.2.2.1 hl'
      have hio : IsIncreasing S.le c (Iio ε) := fun a' _ b' hb' h' => (ih' b' hb').2.2.1 a' h'
      obtain ⟨V, kV, uV, lV⟩ := hS.union_Kc hinf hl (hε.trans hθ') hio hco fun β hβ => (ih' β hβ).1
      refine ⟨V, kV, ?_, lV, fun _ => uV.1, fun h => by rw [h] at hl; exact absurd hl Order.not_isSuccLimit_bot,
        fun η h => absurd (h ▸ hl) fun hl' => lt_irrefl _ (hl'.add_one_lt (Order.lt_add_one_iff.2 le_rfl))⟩
      exact hS.smooth ε hl c (M ε) hio hco (fun ζ hζ => hS.trans (ih' ζ hζ).2.1 (hi ζ (hζ.trans hε) ε hε hζ))
        V uV kV.1)
  have hI : ∀ ε < θ, _ := fun ε hε => hcI ε hε.le hε
  exact ⟨c, fun ε hε => ⟨(hI ε hε).1, (hI ε hε).2.1⟩, fun a' _ b' hb' h' => (hI b' hb').2.2.1 a' h',
    fun β hβ hl => (hI β hβ).2.2.2.1 hl, fun h => (hI 0 h).2.2.2.2.1 rfl,
    fun ε hε => (hI (ε + 1) hε).2.2.2.2.2 ε rfl⟩

/-- AUX: not in paper. A type that does not fork over some model is basic in the sense of `S^bs_{≥λ}`. -/
theorem Frame.sbsGe_of_notForkGe {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M₀ M₁ : Model U L} {p : Set (Tri U L)} (h : s.NotForkGe lam M₀ M₁ p) : p ∈ s.SbsGe lam M₁ := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h₀, h₁, h01, hpS, M₂, a, hmem, hge⟩ := id h
  obtain ⟨-, -, -, -, h12, ha, N₀, kN₀, lN₀, huniv⟩ := id hge
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc kN₀
  rcases h₁.2.lt_or_eq with hgt | heq
  · refine Or.inr ⟨hgt, ⟨h₁.1, hgt⟩, hpS, N₀, kN₀, hS.trans lN₀ h01, ?_⟩
    exact ⟨⟨kN₀.1, kN₀.2.ge⟩, h₁, hS.trans lN₀ h01, hpS, M₂, a, hmem, kN₀.2.ge, hge.2.1, hge.2.2.1,
      hS.trans lN₀ h01, h12, ha, N₀, kN₀, hS.refl kN₀.1, huniv⟩
  · refine Or.inl ⟨heq.symm, ?_⟩
    have kM₁ : M₁ ∈ s.S.Kc lam := ⟨h₁.1, heq.symm⟩
    obtain ⟨W, kW, hsW, lW⟩ := hS.exists_small hc.ax0b hinf kM₁ (hS.mem_right h12) (hS.sub h12) ha.1
    have hn := huniv M₁ kM₁ ((hS.sub lN₀).trans (hS.sub h01)) (hS.refl h₁.1) W kW hsW lW
    have h3 := hc.ax3a.1 _ _ _ _ hn
    have hE : p = tp s.S lam a M₁ W := by
      obtain ⟨X, b, hK, rfl⟩ := hpS
      have e1 : tp s.S lam b M₁ X = tp s.S lam a M₁ M₂ := tp_eq_iff.2 hmem
      rw [e1]
      exact (tp_eq_of_le hS ⟨h₁.1, hS.mem_right h12, h12, ha.1⟩ lW h3.2.2.2.2.2.1 (hsW (Or.inr rfl))).symm
    rw [hE]; exact h3.2.2.2.2.2.2.2

/-- Thm 2.6.8(5), continuity: `⟨M_α : α ≤ δ+1⟩` increasing continuous in `K_{≥λ}`,
`c ∈ M_{δ+1} - M_δ`, `p_α = tp(c, M_α, M_{δ+1})`; if every `p_α` (`α < δ`) does not fork over
`M₀`, then `p_δ` does not fork over `M₀`. -/
theorem thm_2_6_8_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.IsSemiGoodExceptLC lam) (δ : Ordinal.{u}) (hδ : Order.IsSuccLimit δ)
    (M : Ordinal.{u} → Model U L) (hM : IsIncCont s.S M (Iic (δ + 1)) (s.S.KGe lam))
    (c : U) (hc' : c ∈ (M (δ + 1)).carrier \ (M δ).carrier)
    (hnf : ∀ α < δ, s.NotForkGe lam (M 0) (M α) (tp s.S lam c (M α) (M (δ + 1)))) :
    s.NotForkGe lam (M 0) (M δ) (tp s.S lam c (M δ) (M (δ + 1))) := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have h0δ : (0 : Ordinal.{u}) < δ := hδ.bot_lt
  have hδ1 : δ < δ + 1 := Order.lt_add_one_iff.2 le_rfl
  have mI : ∀ i ≤ δ, i ∈ Iic (δ + 1) := fun i hi => Set.mem_Iic.2 (hi.trans hδ1.le)
  have hδm : δ + 1 ∈ Iic (δ + 1) := Set.mem_Iic.2 le_rfl
  have hle : ∀ a ≤ δ, ∀ b ≤ δ, a < b → s.S.le (M a) (M b) := fun a ha b hb h' =>
    hM.1 a (mI a ha) b (mI b hb) h'
  have htop : ∀ a ≤ δ, s.S.le (M a) (M (δ + 1)) := fun a ha =>
    hM.1 a (mI a ha) _ hδm (lt_of_le_of_lt ha hδ1)
  obtain ⟨-, -, -, -, M₂, a, hmem, hge⟩ := hnf 0 h0δ
  obtain ⟨-, -, -, -, -, -, N₀, kN₀, lN₀, huniv⟩ := id hge
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc kN₀
  have hL := hc.ax0b
  have kK0 : N₀ ∈ s.S.KGe lam := ⟨kN₀.1, kN₀.2.ge⟩
  have hK3 : ∀ i ≤ δ, (M i, M (δ + 1), c) ∈ s.S.K3 := fun i hi =>
    ⟨(hM.2.2 i (mI i hi)).1, (hM.2.2 _ hδm).1, htop i hi, hc'.1⟩
  have hsubtop : ∀ i ≤ δ, c ∉ (M i).carrier := fun i hi hin => by
    rcases hi.lt_or_eq with h' | h'
    · exact hc'.2 (hS.sub (hle i hi δ le_rfl h') hin)
    · exact hc'.2 (h' ▸ hin)
  have m0 : (0 : Ordinal.{u}) ≤ δ := h0δ.le
  have kM : ∀ i ≤ δ, M i ∈ s.S.KGe lam := fun i hi => hM.2.2 i (mI i hi)
  have kMt : M (δ + 1) ∈ s.S.KGe lam := hM.2.2 _ hδm
  obtain ⟨c1, c2, c3, l01, l12, ha1, -⟩ := id hge
  have hN0 : s.NotForkGe lam N₀ (M 0) (tp s.S lam c (M 0) (M (δ + 1))) := by
    obtain ⟨-, -, -, hpS, -, -, -, -⟩ := hnf 0 h0δ
    exact ⟨kK0, kM 0 m0, lN₀, hpS, M₂, a, hmem, kN₀.2.ge, c2, c3, lN₀, l12, ha1, N₀, kN₀,
      hS.refl kN₀.1, huniv⟩
  have hNα : ∀ α < δ, s.NotForkGe lam N₀ (M α) (tp s.S lam c (M α) (M (δ + 1))) := by
    intro α hα
    rcases (zero_le : (0 : Ordinal.{u}) ≤ α).lt_or_eq with h' | h'
    · have l := hle 0 m0 α hα.le h'
      refine thm_2_6_8_3 lam hU s hs N₀ (M 0) (M α) kK0 (kM 0 m0) (kM α hα.le) lN₀ l _
        (Frame.sbsGe_of_notForkGe hc (hnf α hα)) (hnf α hα) ?_
      rw [res_tp hS l]; exact hN0
    · rw [← h']; exact hN0
  have key : ∀ α < δ, ∀ N ∈ s.S.Kc lam, N₀.carrier ⊆ N.carrier → s.S.le N (M α) →
      ∀ N' ∈ s.S.Kc lam, N.carrier ∪ {c} ⊆ N'.carrier → s.S.le N' (M (δ + 1)) → s.nf N₀ N c N' := by
    intro α hα N kN hsN lNα N' kN' hsub' lN'
    obtain ⟨-, -, lαN, pS, -⟩ := id (hNα α hα)
    have hge2 := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b N₀ (M α) kK0
      (kM α hα.le) lαN _ pS).1 (hNα α hα) (M (δ + 1)) c (mem_tp_self _ _ _ _ _)
    obtain ⟨-, -, -, -, -, -, N₁, kN₁, lN₁, hu⟩ := hge2
    have lN₀N : s.S.le N₀ N := hS.le_of_sub lαN lNα hsN
    have n := hu N kN ((hS.sub lN₁).trans hsN) lNα N' kN' hsub' lN'
    exact Frame.nf_mono hS hc.ax3a hc.ax3b n lN₁ lN₀N (hS.refl kN.1)
  have hδm' : δ ∈ Iic (δ + 1) := mI δ le_rfl
  refine ⟨kM 0 m0, kM δ le_rfl, hle 0 m0 δ le_rfl h0δ, ⟨_, _, hK3 δ le_rfl, rfl⟩, M (δ + 1), c,
    mem_tp_self _ _ _ _ _, (kM 0 m0).2, (kM δ le_rfl).2, kMt.2, hle 0 m0 δ le_rfl h0δ, htop δ le_rfl, hc', N₀, kN₀,
    lN₀, fun N kN hsN lNδ N' kN' hsN' lN' => ?_⟩
  have lN₀N : s.S.le N₀ N := hS.le_of_sub (hS.trans lN₀ (hle 0 m0 δ le_rfl h0δ)) lNδ hsN
  by_cases hcof : Order.succ lam ≤ δ.cof
  · have hex : ∀ x : N.carrier, ∃ ζ < δ, x.1 ∈ (M ζ).carrier := fun x => by
      have hx := (Set.ext_iff.1 (hM.2.1 δ hδm' hδ) x.1).1 (hS.sub lNδ x.2)
      obtain ⟨ζ, hζ, h'⟩ := Set.mem_iUnion₂.1 hx
      exact ⟨ζ, hζ, h'⟩
    choose f hf hfR using hex
    have hcard : #N.carrier < δ.cof :=
      lt_of_le_of_lt (le_of_eq kN.2) (lt_of_lt_of_le (Order.lt_succ lam) hcof)
    have hsup : iSup f < δ := Ordinal.iSup_lt_of_lt_cof hcard hf
    have hsub' : N.carrier ⊆ (M (iSup f)).carrier := fun x hx => by
      have hle' : f ⟨x, hx⟩ ≤ iSup f := Ordinal.le_iSup f ⟨x, hx⟩
      rcases hle'.lt_or_eq with h' | h'
      · exact hS.sub (hle _ (hf ⟨x, hx⟩).le _ hsup.le h') (hfR ⟨x, hx⟩)
      · rw [← h']; exact hfR ⟨x, hx⟩
    have lNsup : s.S.le N (M (iSup f)) := hS.le_of_sub lNδ (hle _ hsup.le δ le_rfl hsup) hsub'
    exact key _ hsup N kN hsN lNsup N' kN' hsN' lN'
  · have hcof' : δ.cof ≤ lam := Order.lt_succ_iff.1 (not_le.1 hcof)
    obtain ⟨θ, g, hθ, -, gδ, gm, g0, gcof, -, -, hθc⟩ := exists_cof_seq hinf hδ
      (hcof'.trans (Order.le_succ lam))
    have hθlt : θ < (Order.succ lam).ord := by
      rw [hθc]; exact Cardinal.ord_lt_ord.2 (Order.lt_succ_of_le hcof')
    have Qi : IsIncreasing s.S.le (fun i => M (g i)) (Iio θ) := fun a' ha b' hb h' =>
      hle _ (gδ a' ha).le _ (gδ b' hb).le (gm a' b' h' hb)
    obtain ⟨Y, hY, Yi, Yc, Y0, hYA⟩ := hS.approx_chain hL hinf hθlt (M := fun i => M (g i)) Qi
      (fun ε hε => (kM _ (gδ ε hε).le).1) kN₀
      (fun _ => by show s.S.le N₀ (M (g 0)); rw [g0]; exact lN₀) (A := N.carrier) (le_of_eq kN.2)
    obtain ⟨V, kV, uV, lV⟩ := hS.union_Kc hinf hθ hθlt Yi Yc fun ε hε => (hY ε hε).1
    have hYδ : ∀ ε < θ, s.S.le (Y ε) (M δ) := fun ε hε =>
      hS.trans (hY ε hε).2 (hle _ (gδ ε hε).le δ le_rfl (gδ ε hε))
    have lVδ : s.S.le V (M δ) := hS.smooth θ hθ Y (M δ) Yi Yc hYδ V uV kV.1
    have hNV : N.carrier ⊆ V.carrier := by
      intro x hx
      have hxδ := (Set.ext_iff.1 (hM.2.1 δ hδm' hδ) x).1 (hS.sub lNδ hx)
      obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hxδ
      obtain ⟨i, hi, hlt⟩ := gcof ξ hξ
      have hi1 := hθ.add_one_lt hi
      have hxi : x ∈ (M (g i)).carrier := hS.sub (hle ξ (le_of_lt hξ) _ (gδ i hi).le hlt) hxξ
      exact hS.sub (lV _ hi1) (hYA i hi1 ⟨hx, hxi⟩)
    have lNV : s.S.le N V := hS.le_of_sub lNδ lVδ hNV
    have lVt : s.S.le V (M (δ + 1)) := hS.trans lVδ (htop δ le_rfl)
    have hA : V.carrier ∪ N'.carrier ∪ {c} ⊆ (M (δ + 1)).carrier :=
      Set.union_subset (Set.union_subset (hS.sub lVt) (hS.sub lN')) (Set.singleton_subset_iff.2 hc'.1)
    have hAc : #(V.carrier ∪ N'.carrier ∪ {c} : Set U) ≤ lam :=
      (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf
        ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kV.2) (le_of_eq kN'.2)))
        (by rw [Cardinal.mk_singleton]; exact Cardinal.one_le_aleph0.trans hinf))
    obtain ⟨W, kW, hsW, lW⟩ := hS.exists_hull hL hinf kV kMt.1
      (Set.subset_union_left.trans Set.subset_union_left) hA hAc
    have lVW : s.S.le V W := hS.le_of_sub lVt lW
      ((Set.subset_union_left.trans Set.subset_union_left).trans hsW)
    let Z : Ordinal.{u} → Model U L := fun ε => if ε < θ then Y ε else V
    have Z1 : ∀ ε < θ, Z ε = Y ε := fun ε hε => by simp [Z, hε]
    have Z2 : Z θ = V := by simp [Z]
    have hZ : IsIncCont s.S Z (Iic θ) (s.S.Kc lam) := by
      refine ⟨fun a' ha b' hb h' => ?_, fun β hβ hl => ?_, fun ε hε => ?_⟩
      · have ha' : a' < θ := lt_of_lt_of_le h' hb
        rw [Z1 a' ha']
        rcases (show b' ≤ θ from hb).lt_or_eq with h'' | h''
        · rw [Z1 b' h'']; exact Yi a' ha' b' h'' h'
        · rw [h'', Z2]; exact lV a' ha'
      · show (Z β).carrier = _
        rcases (show β ≤ θ from hβ).lt_or_eq with h'' | h''
        · rw [Z1 β h'', Yc β h'' hl]
          exact Set.iUnion₂_congr fun ζ hζ => by rw [Z1 ζ (lt_trans hζ h'')]
        · rw [h'', Z2, uV.1]
          exact Set.iUnion₂_congr fun ζ hζ => by rw [Z1 ζ hζ]
      · rcases (show ε ≤ θ from hε).lt_or_eq with h'' | h''
        · rw [Z1 ε h'']; exact (hY ε h'').1
        · rw [h'', Z2]; exact kV
    have h3g := hs.2.1 θ hθ hθlt Z hZ (tp s.S lam c (Z θ) W) ⟨W, c, ?_, rfl⟩ ?_
    · obtain ⟨-, hn⟩ := h3g
      rw [Z1 0 hθ.bot_lt, Y0 hθ.bot_lt, Z2] at hn
      have nV := Frame.nf_of_notFork hU hc hn kW
      exact hc.ax3b N₀ N₀ N V W (M (δ + 1)) N' c (hS.refl kN₀.1) lN₀N lNV lVW lW hsN' lN' kN' nV
    · rw [Z2]
      exact ⟨kV.1, kW.1, lVW, hsW (Or.inr rfl)⟩
    · intro α hα
      rw [Z1 0 hθ.bot_lt, Y0 hθ.bot_lt, Z1 α hα, Z2, res_tp hS (lV α hα)]
      have hsN₀ : N₀.carrier ⊆ (Y α).carrier := by
        rcases (zero_le : (0 : Ordinal.{u}) ≤ α).lt_or_eq with h' | h'
        · rw [← Y0 hθ.bot_lt]; exact hS.sub (Yi 0 hθ.bot_lt α hα h')
        · rw [← h', Y0 hθ.bot_lt]
      have hsW' : (Y α).carrier ∪ {c} ⊆ W.carrier := Set.union_subset
        (fun y hy => hsW (Or.inl (Or.inl (hS.sub (lV α hα) hy)))) (Set.singleton_subset_iff.2 (hsW (Or.inr rfl)))
      exact ⟨c, W, rfl, key _ (gδ α hα) _ (hY α hα).1 hsN₀ (hY α hα).2 W kW hsW' lW⟩

/-- Thm 2.6.8(4), about local character: `δ` limit; if `s` satisfies local character or
`λ⁺ ≤ cf(δ)`, `⟨M_α : α ≤ δ⟩` is increasing continuous in `K_{>λ}` and
`p ∈ S^bs_{>λ}(M_δ)`, then `p` does not fork over some `M_α`, `α < δ`. -/
theorem thm_2_6_8_4 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.IsSemiGoodExceptLC lam) (δ : Ordinal.{u}) (hδ : Order.IsSuccLimit δ)
    (hlc : s.Ax3c lam ∨ Order.succ lam ≤ δ.cof) (M : Ordinal.{u} → Model U L)
    (hM : IsIncCont s.S M (Iic δ) (s.S.KGt lam)) (p : Set (Tri U L)) (hp : p ∈ s.SbsGt lam (M δ)) :
    ∃ α < δ, s.NotForkGe lam (M α) (M δ) p := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have h0δ : (0 : Ordinal.{u}) < δ := hδ.bot_lt
  have hδm : δ ∈ Iic δ := Set.mem_Iic.2 le_rfl
  have hle : ∀ a ≤ δ, ∀ b ≤ δ, a < b → s.S.le (M a) (M b) := fun a ha b hb h' =>
    hM.1 a (Set.mem_Iic.2 ha) b (Set.mem_Iic.2 hb) h'
  have kM : ∀ i ≤ δ, M i ∈ s.S.KGe lam := fun i hi =>
    ⟨(hM.2.2 i (Set.mem_Iic.2 hi)).1, (hM.2.2 i (Set.mem_Iic.2 hi)).2.le⟩
  have hgt : lam < (M δ).card := (hM.2.2 δ hδm).2
  obtain ⟨-, pS, Ns, kNs, lNs, hnfs⟩ := hp
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc kNs
  have hpGe : p ∈ s.SbsGe lam (M δ) := Frame.sbsGe_of_notForkGe hc hnfs
  have kNsG : Ns ∈ s.S.KGe lam := ⟨kNs.1, kNs.2.ge⟩
  have hmono : ∀ X : Model U L, X ∈ s.S.KGe lam → s.S.le Ns X → s.S.le X (M δ) →
      s.NotForkGe lam X (M δ) p := fun X kX l1 l2 =>
    (thm_2_6_8_2 lam hU s hs Ns X (M δ) l1 l2 kNsG kX (kM δ le_rfl) hgt p hpGe hnfs).1
  by_cases hcof : Order.succ lam ≤ δ.cof
  · have hex : ∀ x : Ns.carrier, ∃ ζ < δ, x.1 ∈ (M ζ).carrier := fun x => by
      have hx := (Set.ext_iff.1 (hM.2.1 δ hδm hδ) x.1).1 (hS.sub lNs x.2)
      obtain ⟨ζ, hζ, h'⟩ := Set.mem_iUnion₂.1 hx
      exact ⟨ζ, hζ, h'⟩
    choose f hf hfR using hex
    have hcard : #Ns.carrier < δ.cof :=
      lt_of_le_of_lt (le_of_eq kNs.2) (lt_of_lt_of_le (Order.lt_succ lam) hcof)
    have hsup : iSup f < δ := Ordinal.iSup_lt_of_lt_cof hcard hf
    have hsub' : Ns.carrier ⊆ (M (iSup f)).carrier := fun x hx => by
      have hle' : f ⟨x, hx⟩ ≤ iSup f := Ordinal.le_iSup f ⟨x, hx⟩
      rcases hle'.lt_or_eq with h' | h'
      · exact hS.sub (hle _ (hf ⟨x, hx⟩).le _ hsup.le h') (hfR ⟨x, hx⟩)
      · rw [← h']; exact hfR ⟨x, hx⟩
    exact ⟨_, hsup, hmono _ (kM _ hsup.le) (hS.le_of_sub lNs (hle _ hsup.le δ le_rfl hsup) hsub')
      (hle _ hsup.le δ le_rfl hsup)⟩
  · have h3c : s.Ax3c lam := by
      rcases hlc with h | h
      · exact h
      · exact absurd h hcof
    have hL := hc.ax0b
    have hcof' : δ.cof ≤ lam := Order.lt_succ_iff.1 (not_le.1 hcof)
    obtain ⟨θ, g, hθ, -, gδ, gm, g0, gcof, -, -, hθc⟩ := exists_cof_seq hinf hδ
      (hcof'.trans (Order.le_succ lam))
    have hθlt : θ < (Order.succ lam).ord := by
      rw [hθc]; exact Cardinal.ord_lt_ord.2 (Order.lt_succ_of_le hcof')
    -- a model of `K_λ` below `M 0`
    obtain ⟨A0, hA0, hcA0⟩ : ∃ A0 : Set U, A0 ⊆ (M 0).carrier ∧ #A0 = lam := by
      obtain ⟨A0', hA0', hc0⟩ := Cardinal.le_mk_iff_exists_subset.1 (kM 0 h0δ.le).2
      exact ⟨A0', hA0', hc0⟩
    have hLS : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hL
    obtain ⟨N₀, kN₀', hAN, lN₀, hcN₀⟩ := hLS (M 0) (kM 0 h0δ.le).1 A0 hA0
    have kN₀ : N₀ ∈ s.S.Kc lam := ⟨kN₀', le_antisymm
      (hcN₀.trans (Cardinal.add_le_of_le hinf le_rfl (le_of_eq hcA0)))
      (by rw [← hcA0]; exact Cardinal.mk_le_mk_of_subset hAN)⟩
    have Qi : IsIncreasing s.S.le (fun i => M (g i)) (Iio θ) := fun a' ha b' hb h' =>
      hle _ (gδ a' ha).le _ (gδ b' hb).le (gm a' b' h' hb)
    obtain ⟨Y, hY, Yi, Yc, Y0, hYA⟩ := hS.approx_chain hL hinf hθlt (M := fun i => M (g i)) Qi
      (fun ε hε => (kM _ (gδ ε hε).le).1) kN₀
      (fun _ => by show s.S.le N₀ (M (g 0)); rw [g0]; exact lN₀) (A := Ns.carrier) (le_of_eq kNs.2)
    obtain ⟨V, kV, uV, lV⟩ := hS.union_Kc hinf hθ hθlt Yi Yc fun ε hε => (hY ε hε).1
    have hYδ : ∀ ε < θ, s.S.le (Y ε) (M δ) := fun ε hε =>
      hS.trans (hY ε hε).2 (hle _ (gδ ε hε).le δ le_rfl (gδ ε hε))
    have lVδ : s.S.le V (M δ) := hS.smooth θ hθ Y (M δ) Yi Yc hYδ V uV kV.1
    have hNV : Ns.carrier ⊆ V.carrier := by
      intro x hx
      have hxδ := (Set.ext_iff.1 (hM.2.1 δ hδm hδ) x).1 (hS.sub lNs hx)
      obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hxδ
      obtain ⟨i, hi, hlt⟩ := gcof ξ hξ
      have hi1 := hθ.add_one_lt hi
      have hxi : x ∈ (M (g i)).carrier := hS.sub (hle ξ (le_of_lt hξ) _ (gδ i hi).le hlt) hxξ
      exact hS.sub (lV _ hi1) (hYA i hi1 ⟨hx, hxi⟩)
    have lNsV : s.S.le Ns V := hS.le_of_sub lNs lVδ hNV
    have kVG : V ∈ s.S.KGe lam := ⟨kV.1, kV.2.ge⟩
    have hnV := hmono V kVG lNsV lVδ
    obtain ⟨X, c, hK, rfl⟩ := pS
    obtain ⟨-, -, -, -, -, -, N₁, kN₁, lN₁, hu⟩ := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b V (M δ) kVG
      (kM δ le_rfl) lVδ _ ⟨X, c, hK, rfl⟩).1 hnV X c (mem_tp_self _ _ _ _ _)
    have lVX : s.S.le V X := hS.trans lVδ hK.2.2.1
    obtain ⟨W, kW, hsW, lW⟩ := hS.exists_small hL hinf kV (hS.mem_right lVX) (hS.sub lVX) hK.2.2.2
    have lVW : s.S.le V W := hS.le_of_sub lVX lW (Set.subset_union_left.trans hsW)
    have hnW := hu V kV (hS.sub lN₁) lVδ W kW hsW lW
    have h3 := hc.ax3a.1 _ _ _ _ hnW
    -- the sequence for local character
    let Z : Ordinal.{u} → Model U L := fun ε => if ε < θ then Y ε else if ε = θ then V else W
    have Z1 : ∀ ε < θ, Z ε = Y ε := fun ε hε => by simp [Z, hε]
    have Z2 : Z θ = V := by simp [Z]
    have Z3 : Z (θ + 1) = W := by
      have h1' : ¬ (θ + 1 < θ) := not_lt.2 (Order.le_succ θ)
      have h2' : θ + 1 ≠ θ := (Order.lt_add_one_iff.2 le_rfl).ne'
      simp [Z, h1', h2']
    have hZ : IsIncCont s.S Z (Iic (θ + 1)) (s.S.Kc lam) := by
      refine ⟨fun a' ha b' hb h' => ?_, fun β hβ hl => ?_, fun ε hε => ?_⟩
      · have ha' : a' ≤ θ := Order.lt_add_one_iff.1 (lt_of_lt_of_le h' hb)
        rcases (show b' ≤ θ + 1 from hb).lt_or_eq with h'' | h''
        · have hbθ : b' ≤ θ := Order.lt_add_one_iff.1 h''
          rcases hbθ.lt_or_eq with h3' | h3'
          · rw [Z1 a' (h'.trans h3'), Z1 b' h3']; exact Yi a' (h'.trans h3') b' h3' h'
          · rw [h3', Z2, Z1 a' (h3' ▸ h')]; exact lV a' (h3' ▸ h')
        · rw [h'', Z3]
          rcases ha'.lt_or_eq with h3' | h3'
          · rw [Z1 a' h3']; exact hS.trans (lV a' h3') lVW
          · rw [h3', Z2]; exact lVW
      · show (Z β).carrier = _
        have hβθ : β ≤ θ := by
          rcases (show β ≤ θ + 1 from hβ).lt_or_eq with h' | h'
          · exact Order.lt_add_one_iff.1 h'
          · exact absurd (h' ▸ hl) fun hl' => lt_irrefl _ (hl'.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
        rcases hβθ.lt_or_eq with h'' | h''
        · rw [Z1 β h'', Yc β h'' hl]
          exact Set.iUnion₂_congr fun ζ hζ => by rw [Z1 ζ (lt_trans hζ h'')]
        · rw [h'', Z2, uV.1]
          exact Set.iUnion₂_congr fun ζ hζ => by rw [Z1 ζ hζ]
      · rcases (show ε ≤ θ + 1 from hε).lt_or_eq with h'' | h''
        · have hεθ : ε ≤ θ := Order.lt_add_one_iff.1 h''
          rcases hεθ.lt_or_eq with h3' | h3'
          · rw [Z1 ε h3']; exact (hY ε h3').1
          · rw [h3', Z2]; exact kV
        · rw [h'', Z3]; exact kW
    have hbs : tp s.S lam c (Z θ) (Z (θ + 1)) ∈ s.Sbs (Z θ) := by
      rw [Z2, Z3]; exact h3.2.2.2.2.2.2.2
    obtain ⟨α, hα, hn⟩ := h3c θ hθ hθlt Z hZ c hbs
    rw [Z1 α hα, Z2, Z3] at hn
    have lYV : s.S.le (Y α) V := lV α hα
    have nY := Frame.nf_of_notFork hU hc hn kW
    have kYG : Y α ∈ s.S.KGe lam := ⟨(hY α hα).1.1, (hY α hα).1.2.ge⟩
    have hnf1 : s.NotForkGe lam (Y α) V (res s.S lam (tp s.S lam c (M δ) X) V) := by
      rw [res_tp hS lVδ]
      refine ⟨kYG, kVG, lYV, ⟨X, c, ⟨kV.1, hK.2.1, lVX, hK.2.2.2⟩, rfl⟩, X, c, mem_tp_self _ _ _ _ _,
        (hY α hα).1.2.ge, kV.2.ge, kV.2.ge.trans (Model.card_le_of_sub (hS.sub lVX)), lYV, lVX, ⟨hK.2.2.2, ?_⟩,
        Y α, (hY α hα).1, hS.refl (hY α hα).1.1, fun N kN hsN lN N' kN' hsN' lN' => ?_⟩
      · exact fun hin => h3.2.2.2.1.2 hin
      · have lYN : s.S.le (Y α) N := hS.le_of_sub lYV lN hsN
        exact hc.ax3b _ _ _ _ _ X _ c (hS.refl (hY α hα).1.1) lYN lN lVW lW hsN' lN' kN' nY
    have hn2 := thm_2_6_8_3 lam hU s hs (Y α) V (M δ) kYG kVG (kM δ le_rfl) lYV lVδ _ hpGe hnV hnf1
    have hgα := gδ α hα
    exact ⟨g α, hgα, (thm_2_6_8_2 lam hU s hs (Y α) (M (g α)) (M δ) (hY α hα).2 (hle _ hgα.le δ le_rfl hgα)
      kYG (kM _ hgα.le) (kM δ le_rfl) hgt _ hpGe hn2).1⟩

/-! ════════════════════════════════════════════════════════════════════════════
    PART 9 : SECTION 9  (Non-smoothness implies non-structure)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 9.1.1 (= Hypothesis 6.1.1). -/
def Hyp_9_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop := Hyp_6_1_1 s lam

/-- Def 9.1.2: an increasing sequence `⟨M_α : α < α*⟩` in `K_{λ⁺}` is `≼^NF`-increasing in the
successor ordinals: `β < γ < α* → M_{β+1} ≼^NF M_{γ+1}`. -/
def Frame.IncNFSucc (s : Frame U L) (lam : Cardinal.{u}) (M : Ordinal.{u} → Model U L)
    (αs : Ordinal.{u}) : Prop :=
  IsIncreasing s.S.le M (Iio αs) ∧ (∀ α < αs, M α ∈ s.S.Kc (Order.succ lam)) ∧
    ∀ β γ, β < γ → γ < αs → s.leNF lam (M (β + 1)) (M (γ + 1))

/-- Def 9.1.3: `T(M̄) = {δ < λ^{+2} : ∃ α ∈ (δ, λ^{+2}), M_δ ⋠^NF M_α}`. -/
def Frame.TSet (s : Frame U L) (lam : Cardinal.{u}) (M : Ordinal.{u} → Model U L) :
    Set Ordinal.{u} :=
  {δ | δ < (plusN lam 2).ord ∧ ∃ α, δ < α ∧ α < (plusN lam 2).ord ∧ ¬ s.leNF lam (M δ) (M α)}

/-- Def 9.1.3: `T(M) = T(M̄)/D_{λ^{+2}}` equals `X/D_{λ^{+2}}`, for some representation `M̄` of `M`
that is `≼^NF`-increasing in the successor ordinals and continuous with union `M`. -/
def Frame.HasT (s : Frame U L) (lam : Cardinal.{u}) (M : Model U L) (X : Set Ordinal.{u}) :
    Prop :=
  ∃ Ms : Ordinal.{u} → Model U L, s.IncNFSucc lam Ms (plusN lam 2).ord ∧
    IsContinuous Ms (Iio (plusN lam 2).ord) ∧
    -- PROOF-STAGE CHANGE: ENCODING (clarification): union of structures, hence `IsUnionOf`.
    IsUnionOf Ms (Iio (plusN lam 2).ord) M ∧
    ClubEq (plusN lam 2).ord (s.TSet lam Ms) X

/-- Prop 9.1.4: for `M̄ = ⟨M_α : α < λ^{+2}⟩` `≼^NF`-increasing in the successor ordinals and
continuous: (a) `M_α ≼^NF M_{α+1} ↔ ∀ β ∈ (α, λ^{+2}), M_α ≼^NF M_β`;
(b) `T(M̄) = {δ < λ^{+2} : ∀ α ∈ (δ, λ^{+2}), M_δ ⋠^NF M_α}`. -/
theorem prop_9_1_4 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_9_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 6.1.6.
    (hinf : ℵ₀ ≤ lam)
    (M : Ordinal.{u} → Model U L) (hM : s.IncNFSucc lam M (plusN lam 2).ord)
    (hc : IsContinuous M (Iio (plusN lam 2).ord)) :
    (∀ α < (plusN lam 2).ord, s.leNF lam (M α) (M (α + 1)) ↔
      ∀ β, α < β → β < (plusN lam 2).ord → s.leNF lam (M α) (M β)) ∧
    s.TSet lam M = {δ | δ < (plusN lam 2).ord ∧
      ∀ α, δ < α → α < (plusN lam 2).ord → ¬ s.leNF lam (M δ) (M α)} := by
  have hs6 : Hyp_6_1_1 s lam := hs
  have hS : IsAEC s.S := hs.1.1.ax0a
  have hκl : Order.IsSuccLimit (plusN lam 2).ord := Cardinal.isSuccLimit_ord
    (show ℵ₀ ≤ Order.succ (Order.succ lam) from
      hinf.trans ((Order.le_succ lam).trans (Order.le_succ _)))
  obtain ⟨Mi, MK, Ms⟩ := hM
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  have ha : ∀ α < (plusN lam 2).ord, s.leNF lam (M α) (M (α + 1)) →
      ∀ β, α < β → β < (plusN lam 2).ord → s.leNF lam (M α) (M β) := by
    intro α hα h β hαβ hβ
    have hβ1 := hκl.add_one_lt hβ
    have l1 : s.leNF lam (M α) (M (β + 1)) := Frame.leNF_trans hU hs6 h (Ms α β hαβ hβ)
    exact Frame.leNF_mid hU hs6 (Mi α hα β hβ hαβ) (Mi β hβ _ hβ1 (lt1 β)) l1
  refine ⟨fun α hα => ⟨ha α hα, fun h => h _ (lt1 α) (hκl.add_one_lt hα)⟩, ?_⟩
  ext δ
  constructor
  · rintro ⟨hδ, α, hα, hακ, hn⟩
    refine ⟨hδ, fun α' hα' hακ' hl => hn ?_⟩
    have h1 : s.leNF lam (M δ) (M (δ + 1)) := by
      rcases (Order.add_one_le_of_lt hα').lt_or_eq with h' | h'
      · exact Frame.leNF_mid hU hs6 (Mi δ hδ _ (hκl.add_one_lt hδ) (lt1 δ))
          (Mi _ (hκl.add_one_lt hδ) _ hακ' h') hl
      · rw [h']; exact hl
    exact ha δ hδ h1 α hα hακ
  · rintro ⟨hδ, h⟩
    exact ⟨hδ, δ + 1, lt1 δ, hκl.add_one_lt hδ, h _ (lt1 δ) (hκl.add_one_lt hδ)⟩

-- DEVIATION (typo fixed to evident intent): the paper defines `M̄² := ⟨M_{α,1} : α < λ^{+2}⟩`;
-- fixed to `M̄² := ⟨M_{α,2} : α < λ^{+2}⟩`.
/-- Prop 9.1.5: for `M̄¹ = ⟨M_{α,1}⟩`, `M̄² = ⟨M_{α,1}⟩` [typo: `⟨M_{α,2}⟩`] `≼^NF`-increasing in
the successor ordinals and continuous, `M₁ = ⋃ M_{α,1}`, `M₂ = ⋃ M_{α,2}`, `M₁ ≅ M₂`:
`T(M̄¹)/D = T(M̄²)/D`. -/
theorem prop_9_1_5 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_9_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 6.1.6.
    (hinf : ℵ₀ ≤ lam)
    (Ma1 Ma2 : Ordinal.{u} → Model U L) (M₁ M₂ : Model U L)
    (h1 : s.IncNFSucc lam Ma1 (plusN lam 2).ord ∧ IsContinuous Ma1 (Iio (plusN lam 2).ord))
    (h2 : s.IncNFSucc lam Ma2 (plusN lam 2).ord ∧ IsContinuous Ma2 (Iio (plusN lam 2).ord))
    -- PROOF-STAGE CHANGE: ENCODING (clarification): unions of structures, hence `IsUnionOf`. With equality of
    -- universes only, `M₁, M₂` are unrelated to the chains' structures and the statement is false.
    (hM₁ : IsUnionOf Ma1 (Iio (plusN lam 2).ord) M₁)
    (hM₂ : IsUnionOf Ma2 (Iio (plusN lam 2).ord) M₂)
    (hiso : ∃ f, IsoOn f M₁ M₂) :
    ClubEq (plusN lam 2).ord (s.TSet lam Ma1) (s.TSet lam Ma2) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨f, hf⟩ := hiso
  have hinf' : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl : Order.IsSuccLimit (plusN lam 2).ord := Cardinal.isSuccLimit_ord
    (show ℵ₀ ≤ Order.succ (Order.succ lam) from hinf'.trans (Order.le_succ _))
  obtain ⟨⟨Ai, AK, As⟩, Ac⟩ := id h1
  obtain ⟨⟨Bi, BK, Bs⟩, Bc⟩ := id h2
  have lA := (hS.le_union hκl Ai Ac hM₁).2
  have lB := (hS.le_union hκl Bi Bc hM₂).2
  have subA : ∀ a b, a ≤ b → b < (plusN lam 2).ord → (Ma1 a).carrier ⊆ (Ma1 b).carrier := fun a b h hb => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (Ai a (lt_trans h' hb) b hb h')
    · rw [h']
  have subB : ∀ a b, a ≤ b → b < (plusN lam 2).ord → (Ma2 a).carrier ⊆ (Ma2 b).carrier := fun a b h hb => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (Bi a (lt_trans h' hb) b hb h')
    · rw [h']
  obtain ⟨hub, hcl⟩ := filt_club (lam := Order.succ lam) hinf' (F := fun ε => f '' (Ma1 ε).carrier)
    (G := fun ε => (Ma2 ε).carrier) (fun a b h hb => Set.image_mono (subA a b h hb)) subB
    (fun b hb hl => by
      show f '' (Ma1 b).carrier = _
      rw [Ac b hb hl, Set.image_iUnion₂])
    (fun b hb hl => Bc b hb hl)
    (fun a ha => Cardinal.mk_image_le.trans (le_of_eq (AK a ha).2))
    (fun a ha => le_of_eq (BK a ha).2)
    (by
      rw [← Set.image_iUnion₂]
      exact (congrArg (f '' ·) hM₁.1.symm).trans (hf.carrier_eq.symm.trans hM₂.1))
  have hClub : ClubL (Order.succ lam) {ε | f '' (Ma1 ε).carrier = (Ma2 ε).carrier} := ⟨hub, hcl⟩
  have hC := hClub.isClub_inter
  have model_eq : ∀ ε ∈ {ε | f '' (Ma1 ε).carrier = (Ma2 ε).carrier}, ε < (plusN lam 2).ord →
      IsoOn f (Ma1 ε) (Ma2 ε) := by
    intro ε hε hκ
    obtain ⟨-, P, hP, lP⟩ := hS.iso _ M₁ M₂ f (hS.mem_right (lA ε hκ)) (lA ε hκ) hf
    have e : P.carrier = (Ma2 ε).carrier := by rw [hP.carrier_eq]; exact hε
    have : P = Ma2 ε := hS.po.2.2.1 _ _ (hS.le_of_sub lP (lB ε hκ) e.subset)
      (hS.le_of_sub (lB ε hκ) lP e.symm.subset)
    rwa [this] at hP
  obtain ⟨gf, hgf, gf1, -⟩ := hf.exists_inv
  have model_inv : ∀ ε ∈ {ε | f '' (Ma1 ε).carrier = (Ma2 ε).carrier}, ε < (plusN lam 2).ord →
      IsoOn gf (Ma2 ε) (Ma1 ε) := fun ε hε hκ =>
    iso_of_left_inv (model_eq ε hε hκ) fun y hy => gf1 y (hS.sub (lA ε hκ) hy)
  have tr : ∀ {X Y X' Y' : Model U L} {h : U → U}, Y ∈ s.S.Kc (Order.succ lam) → IsoOn h X X' →
      IsoOn h Y Y' → s.leNF lam X Y → s.leNF lam X' Y' := by
    intro X Y X' Y' h kY i1 i2 hl
    obtain ⟨-, P, hP, lP⟩ := Frame.leNF_iso hU hs6 X Y Y' h kY hl i2
    have e : P = X' := hP.unique i1
    rwa [e] at lP
  have tA := (prop_9_1_4 lam hU s hs hinf Ma1 h1.1 h1.2).2
  have tB := (prop_9_1_4 lam hU s hs hinf Ma2 h2.1 h2.2).2
  refine ⟨_, hC, ?_⟩
  ext δ
  constructor
  · rintro ⟨hδ, hδC⟩
    refine ⟨?_, hδC⟩
    rw [tA] at hδ
    obtain ⟨hδκ, hn⟩ := hδ
    obtain ⟨α, hαC, hαgt⟩ := hC.2.1 δ hδκ
    have hακ := hC.1 hαC
    exact ⟨hδκ, α, hαgt, hακ, fun hl => hn α hαgt hακ
      (tr (AK α hακ |> fun _ => BK α hακ) (model_inv δ hδC.1 hδκ) (model_inv α hαC.1 hακ) hl)⟩
  · rintro ⟨hδ, hδC⟩
    refine ⟨?_, hδC⟩
    rw [tB] at hδ
    obtain ⟨hδκ, hn⟩ := hδ
    obtain ⟨α, hαC, hαgt⟩ := hC.2.1 δ hδκ
    have hακ := hC.1 hαC
    exact ⟨hδκ, α, hαgt, hακ, fun hl => hn α hαgt hακ
      (tr (AK α hακ) (model_eq δ hδC.1 hδκ) (model_eq α hαC.1 hακ) hl)⟩

/-- `S^{λ^{+2}}_{λ⁺}`: stationary subsets of `λ^{+2}` all of whose elements have cofinality `λ⁺`. -/
def StatCof (lam : Cardinal.{u}) (X : Set Ordinal.{u}) : Prop :=
  IsStationaryIn (plusN lam 2).ord X ∧ ∀ α ∈ X, α.cof = Order.succ lam

/-- AUX: not in paper. Every club of `μ⁺` contains an ordinal of cofinality `μ`, `μ = λ⁺`. -/
theorem club_has_cof {mu : Cardinal.{u}} (hinf : ℵ₀ ≤ mu) (hreg : mu.IsRegular) {C : Set Ordinal.{u}}
    (hC : IsClubIn (Order.succ mu).ord C) : ∃ δ ∈ C, δ.cof = mu := by
  classical
  obtain ⟨e, he1, he2, he3, he4⟩ := exists_club_enum' hinf (ClubL.of_isClub hC)
  have ho : mu.ord < (Order.succ mu).ord := Cardinal.ord_lt_ord.2 (Order.lt_succ mu)
  have hl : Order.IsSuccLimit mu.ord := Cardinal.isSuccLimit_ord hinf
  obtain ⟨-, hcof⟩ := he4 _ ho hl
  refine ⟨e mu.ord, he3 _ ho, ?_⟩
  let f : Iio mu.ord → Ordinal.{u} := fun i => e i.1
  have hf : StrictMono f := fun a b h => he2 _ _ h (lt_trans b.2 ho)
  have hsup : ⨆ i, f i = e mu.ord := by
    apply le_antisymm
    · exact ciSup_le' fun i => (he2 _ _ i.2 ho).le
    · refine le_of_forall_lt fun ξ hξ => ?_
      obtain ⟨γ, hγ, h⟩ := hcof ξ hξ
      exact lt_of_lt_of_le h (Ordinal.le_iSup f ⟨γ, hγ⟩)
  have h2 := Ordinal.cof_iSup_Iio hf hl.isSuccPrelimit
  rw [hsup, hreg.cof_ord] at h2
  exact h2

/-- AUX: not in paper. Transitivity of equality modulo the club filter on `μ⁺`. -/
theorem ClubEq.trans' {mu : Cardinal.{u}} (hinf : ℵ₀ ≤ mu) {X Y Z : Set Ordinal.{u}}
    (h1 : ClubEq (Order.succ mu).ord X Y) (h2 : ClubEq (Order.succ mu).ord Y Z) :
    ClubEq (Order.succ mu).ord X Z := by
  obtain ⟨C, hC, e1⟩ := h1
  obtain ⟨D, hD, e2⟩ := h2
  have hI := (ClubL.inter hinf (ClubL.of_isClub hC) (ClubL.of_isClub hD)).isClub_inter
  refine ⟨_, hI, ?_⟩
  ext δ
  constructor
  · rintro ⟨hX, hm⟩
    have m : δ ∈ C ∧ δ ∈ D := ⟨hm.1.2.1, hm.1.2.2⟩
    have hY : δ ∈ Y ∩ C := e1 ▸ (⟨hX, m.1⟩ : δ ∈ X ∩ C)
    have hZ : δ ∈ Z ∩ D := e2 ▸ (⟨hY.1, m.2⟩ : δ ∈ Y ∩ D)
    exact ⟨hZ.1, hm⟩
  · rintro ⟨hZ, hm⟩
    have m : δ ∈ C ∧ δ ∈ D := ⟨hm.1.2.1, hm.1.2.2⟩
    have hY : δ ∈ Y ∩ D := e2.symm ▸ (⟨hZ, m.2⟩ : δ ∈ Z ∩ D)
    have hX : δ ∈ X ∩ C := e1.symm ▸ (⟨hY.1, m.1⟩ : δ ∈ Y ∩ C)
    exact ⟨hX.1, hm⟩

/-- AUX: not in paper. `S^{μ⁺}_μ` contains `μ⁺` pairwise disjoint stationary sets (`μ` regular), by an Ulam
matrix. This is the fact used without proof in Prop 9.1.6 ("`|S^{λ^{+2}}_{λ⁺}| = 2^{λ^{+2}}`"). -/
theorem exists_disjoint_stat {mu : Cardinal.{u}} (hinf : ℵ₀ ≤ mu) (hreg : mu.IsRegular) :
    ∃ (I : Type u) (T : I → Set Ordinal.{u}), Order.succ mu ≤ #I ∧
      (∀ i, IsStationaryIn (Order.succ mu).ord (T i) ∧ ∀ α ∈ T i, α.cof = mu) ∧
      ∀ i j, i ≠ j → Disjoint (T i) (T j) := by
  classical
  set κ := (Order.succ mu).ord with hκ
  have hoκ : mu.ord < κ := Cardinal.ord_lt_ord.2 (Order.lt_succ mu)
  have hreg' : (Order.succ mu).IsRegular := Cardinal.isRegular_succ hinf
  have hF : ∀ α : Ordinal.{u}, ∃ F : Ordinal.{u} → Ordinal.{u}, α < κ →
      (∀ ξ < α, F ξ < mu.ord) ∧ ∀ ξ < α, ∀ ξ' < α, F ξ = F ξ' → ξ = ξ' := by
    intro α
    by_cases hα : α < κ
    · have hc : #(Iio α : Set Ordinal.{u}) ≤ #(Iio mu.ord : Set Ordinal.{u}) := by
        rw [Cardinal.mk_Iio_ordinal, Cardinal.mk_Iio_ordinal, Cardinal.card_ord, Cardinal.lift_le]
        exact Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hα)
      obtain ⟨e⟩ := Cardinal.le_def _ _ |>.1 hc
      refine ⟨fun ξ => if h : ξ < α then (e ⟨ξ, h⟩).1 else 0, fun _ => ⟨fun ξ hξ => ?_, fun ξ hξ ξ' hξ' h => ?_⟩⟩
      · simp only [hξ, dite_true]; exact (e ⟨ξ, hξ⟩).2
      · simp only [hξ, hξ', dite_true] at h
        exact congrArg Subtype.val (e.injective (Subtype.ext h))
    · exact ⟨id, fun h => absurd h hα⟩
  choose F hF1 hF2 using hF
  let A : Ordinal.{u} → Ordinal.{u} → Set Ordinal.{u} := fun ξ η =>
    {α | α < κ ∧ α.cof = mu ∧ ξ < α ∧ F α ξ = η}
  have key : ∀ ξ, ∃ η, ξ < κ → η < mu.ord ∧ IsStationaryIn κ (A ξ η) := by
    intro ξ
    by_cases hξ : ξ < κ
    swap
    · exact ⟨0, fun h => absurd h hξ⟩
    by_contra hno
    push Not at hno
    have hex : ∀ η, ∃ C, ClubL mu C ∧ (η < mu.ord → ∀ α ∈ C, α < κ → α ∉ A ξ η) := by
      intro η
      by_cases hη : η < mu.ord
      · have h1 := (hno η).2 hη
        unfold IsStationaryIn at h1
        push Not at h1
        obtain ⟨C, hC, hemp⟩ := h1 fun α hα => hα.1
        refine ⟨C, ClubL.of_isClub hC, fun _ α hα _ hA => ?_⟩
        have : α ∈ A ξ η ∩ C := ⟨hA, hα⟩
        rw [hemp] at this
        exact this
      · exact ⟨Set.univ, ClubL.univ hinf, fun h => absurd h hη⟩
    choose P hP hPn using hex
    have hI := (ClubL.inter hinf (ClubL.bInter hinf hoκ hP) (ClubL.gt hinf hξ)).isClub_inter
    obtain ⟨δ, ⟨⟨-, ⟨-, hδ1⟩, hδ2⟩, hδκ⟩, hcof⟩ := club_has_cof hinf hreg hI
    exact hPn _ (hF1 δ hδκ ξ hδ2) δ (hδ1 _ (hF1 δ hδκ ξ hδ2)) hδκ ⟨hδκ, hcof, hδ2, rfl⟩
  choose η hη hst using key
  let val : κ.ToType → Ordinal.{u} := fun x => (Ordinal.ToType.mk.symm x).1
  have hval : ∀ x, val x < κ := fun x => (Ordinal.ToType.mk.symm x).2
  have hinj : Function.Injective val := fun x y h =>
    Ordinal.ToType.mk.symm.injective (Subtype.ext h)
  let h' : κ.ToType → mu.ord.ToType := fun x => Ordinal.ToType.mk ⟨η (val x), hη _ (hval x)⟩
  obtain ⟨y, hy⟩ := Cardinal.infinite_pigeonhole_card h' (Order.succ mu)
    (by rw [hκ, Cardinal.mk_ord_toType])
    (hinf.trans (Order.le_succ mu))
    (by rw [hreg'.cof_ord, Cardinal.mk_ord_toType]; exact Order.lt_succ mu)
  let η₀ : Ordinal.{u} := (Ordinal.ToType.mk.symm y).1
  have hyaux : ∀ y' x', h' x' = y' → η (val x') = (Ordinal.ToType.mk.symm y').1 := by
    rintro y' x' rfl
    simp [h']
  have hyη : ∀ x : h' ⁻¹' {y}, η (val x.1) = η₀ := fun x => hyaux y x.1 x.2
  refine ⟨h' ⁻¹' {y}, fun x => A (val x.1) η₀, hy, fun x => ⟨?_, fun α hα => hα.2.1⟩, fun i j hij => ?_⟩
  · have := hst _ (hval x.1)
    rw [hyη x] at this
    exact this
  · refine Set.disjoint_left.2 fun α hi hj => hij ?_
    have e : F α (val i.1) = F α (val j.1) := hi.2.2.2.trans hj.2.2.2.symm
    exact Subtype.ext (hinj (hF2 α hi.1 _ hi.2.2.1 _ hj.2.2.1 e))

/-- Prop 9.1.6: if to each `S ∈ S^{λ^{+2}}_{λ⁺}` we can assign `M^S ∈ K_{λ^{+2}}` with
`T(M^S) = S/D_{λ^{+2}}`, then there are `2^{λ^{+2}}` non-isomorphic models in `K_{λ^{+2}}`. -/
-- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 6.1.6.
theorem prop_9_1_6 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_9_1_1 s lam)
    (hinf : ℵ₀ ≤ lam)
    (h : ∀ X, StatCof lam X → ∃ M ∈ s.S.Kc (plusN lam 2), s.HasT lam M X) :
    (2 : Cardinal.{u}) ^ (plusN lam 2) ≤ numModels s.S (plusN lam 2) := by
  classical
  have hmu : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  obtain ⟨I, T, hI, hT, hdis⟩ := exists_disjoint_stat hmu (Cardinal.isRegular_succ hinf)
  have hIinf : ℵ₀ ≤ #I := (hmu.trans (Order.le_succ _)).trans hI
  have hopt : #(Option I) = #I := by
    rw [Cardinal.mk_option]; exact Cardinal.add_one_eq hIinf
  obtain ⟨e⟩ := Cardinal.eq.1 hopt
  let X : Set I → Set Ordinal.{u} := fun J => T (e none) ∪ ⋃ i ∈ J, T (e (some i))
  have hXs : ∀ J, StatCof lam (X J) := by
    intro J
    refine ⟨⟨?_, fun C hC => ?_⟩, fun α hα => ?_⟩
    · refine Set.union_subset (hT _).1.1 (Set.iUnion₂_subset fun i _ => (hT _).1.1)
    · obtain ⟨α, hα1, hα2⟩ := (hT (e none)).1.2 C hC
      exact ⟨α, Or.inl hα1, hα2⟩
    · rcases hα with h' | h'
      · exact (hT _).2 α h'
      · obtain ⟨i, -, hi⟩ := Set.mem_iUnion₂.1 h'
        exact (hT _).2 α hi
  have sep : ∀ J J' : Set I, ∀ i ∈ J, i ∉ J' → ¬ ClubEq (plusN lam 2).ord (X J) (X J') := by
    rintro J J' i hi hn ⟨C, hC, heq⟩
    obtain ⟨α, hα1, hα2⟩ := (hT (e (some i))).1.2 C hC
    have m1 : α ∈ X J ∩ C := ⟨Or.inr (Set.mem_biUnion hi hα1), hα2⟩
    have m2 : α ∈ X J' ∩ C := heq ▸ m1
    rcases m2.1 with h' | h'
    · have ne : e (some i) ≠ e none := fun h2 => by simpa using e.injective h2
      exact Set.disjoint_left.1 (hdis _ _ ne) hα1 h'
    · obtain ⟨j, hj, hjα⟩ := Set.mem_iUnion₂.1 h'
      have ne : e (some i) ≠ e (some j) := fun h2 => hn (by
        have := e.injective h2
        simp only [Option.some.injEq] at this
        exact this ▸ hj)
      exact Set.disjoint_left.1 (hdis _ _ ne) hα1 hjα
  choose Mm kM hT' using fun J => h (X J) (hXs J)
  let φ : Set I → Quotient (isoSetoid s.S (plusN lam 2)) := fun J => Quotient.mk _ ⟨Mm J, kM J⟩
  have hφ : Function.Injective φ := by
    intro J J' he
    have hr : Nonempty ((Mm J).carrier ≃[L] (Mm J').carrier) := Quotient.exact he
    obtain ⟨g⟩ := hr
    let f : U → U := fun x => if hx : x ∈ (Mm J).carrier then (g ⟨x, hx⟩ : U) else x
    have hf : IsoOn f (Mm J) (Mm J') := ⟨g, fun x => by simp [f]⟩
    obtain ⟨Ms, i1, c1, u1, q1⟩ := hT' J
    obtain ⟨Ms', i2, c2, u2, q2⟩ := hT' J'
    have ce := prop_9_1_5 lam hU s hs hinf Ms Ms' _ _ ⟨i1, c1⟩ ⟨i2, c2⟩ u1 u2 ⟨f, hf⟩
    have symmE : ∀ {P Q : Set Ordinal.{u}}, ClubEq (plusN lam 2).ord P Q →
        ClubEq (plusN lam 2).ord Q P := fun ⟨C, hC, heq⟩ => ⟨C, hC, heq.symm⟩
    have hJ : ClubEq (plusN lam 2).ord (X J) (X J') :=
      ClubEq.trans' (mu := Order.succ lam) hmu (ClubEq.trans' (mu := Order.succ lam) hmu (symmE q1) ce) q2
    ext i
    constructor
    · intro hi; by_contra hn; exact sep J J' i hi hn hJ
    · intro hi; by_contra hn; exact sep J' J i hi hn (symmE hJ)
  calc (2 : Cardinal.{u}) ^ (plusN lam 2) ≤ 2 ^ #I := Cardinal.power_le_power_left two_ne_zero hI
    _ = #(Set I) := (Cardinal.mk_set).symm
    _ ≤ numModels s.S (plusN lam 2) := Cardinal.mk_le_of_injective hφ

/-- AUX: not in paper. The requirements on step `α` of the construction in the proof of
Thm 9.1.7 (clauses 1–5 and `(*)_β` of the paper, with `M_0 = M*_0`). -/
def Frame.G97 (s : Frame U L) (lam : Cardinal.{u}) (X : Set Ordinal.{u}) (M0 : Model U L)
    (α : Ordinal.{u}) (c : Ordinal.{u} → Model U L) (x : Model U L) : Prop :=
  x ∈ s.Ksat lam ∧ (α = 0 → x = M0) ∧ (∀ β < α, s.S.le (c β) x) ∧
    (Order.IsSuccLimit α → IsUnionOf c (Iio α) x ∧ ∀ β, β + 1 < α → s.leNF lam (c (β + 1)) x) ∧
    ∀ ξ, α = ξ + 1 → (ξ ∉ X → s.ltPlus lam (c ξ) x) ∧ (ξ ∈ X → ¬ s.leNF lam (c ξ) x) ∧
      ∀ β < ξ, s.leNF lam (c (β + 1)) x ∧ (ξ ∉ X → s.ltPlus lam (c (β + 1)) x)

/-- AUX: not in paper. `G97` depends only on the values of `c` below `α`. -/
theorem Frame.G97.congr {s : Frame U L} {lam : Cardinal.{u}} {X : Set Ordinal.{u}} {M0 : Model U L}
    {α : Ordinal.{u}} {c c' : Ordinal.{u} → Model U L} {x : Model U L} (h : s.G97 lam X M0 α c x)
    (e : ∀ β < α, c β = c' β) : s.G97 lam X M0 α c' x := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  refine ⟨h1, h2, fun β hβ => e β hβ ▸ h3 β hβ, fun hl => ⟨(h4 hl).1.congr' e, fun β hβ => ?_⟩,
    fun ξ hξ => ?_⟩
  · rw [← e _ hβ]; exact (h4 hl).2 β hβ
  · subst hξ
    obtain ⟨a, b, d⟩ := h5 ξ rfl
    have eξ : c ξ = c' ξ := e ξ (Order.lt_add_one_iff.2 le_rfl)
    have eβ : ∀ β < ξ, c (β + 1) = c' (β + 1) := fun β hβ =>
      e _ (Order.lt_add_one_iff.2 (Order.add_one_le_of_lt hβ))
    rw [← eξ]
    refine ⟨a, b, fun β hβ => ?_⟩
    rw [← eβ β hβ]; exact d β hβ

/-- AUX: not in paper. The sequence `⟨γ_ε : ε < cf δ⟩` of the proof of Thm 9.1.7, Claims
9.1.9–9.1.10. -/
theorem Frame.g97_chain [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_9_1_1 s lam) (hinf : ℵ₀ ≤ lam) {X : Set Ordinal.{u}}
    (hX : ∀ α ∈ X, α.cof = Order.succ lam) {M0 : Model U L} {δ : Ordinal.{u}}
    (hδ : Order.IsSuccLimit δ) (hδ' : δ < (plusN lam 2).ord) {c : Ordinal.{u} → Model U L}
    (ih : ∀ β < δ, s.G97 lam X M0 β c (c β)) :
    ∃ (θ : Ordinal.{u}) (γ : Ordinal.{u} → Ordinal.{u}), Order.IsSuccLimit θ ∧
      θ ≤ (Order.succ lam).ord ∧ θ = δ.cof.ord ∧ γ 0 = 0 ∧ (∀ i < θ, γ i < δ) ∧
      (∀ a b, a < b → b < θ → γ a < γ b) ∧ (∀ ξ < δ, ∃ i < θ, ξ < γ i) ∧
      IsContinuous (fun i => c (γ i)) (Iio θ) ∧
      (∀ i, i + 1 < θ → s.ltPlus lam (c (γ i)) (c (γ (i + 1)))) ∧
      ∀ i, i + 1 < θ → ∃ ζ, γ (i + 1) = ζ + 1 ∧ γ i ≤ ζ := by
  classical
  have hs7 : Hyp_7_1_1 s lam := hs
  have hS : IsAEC s.S := hs.1.1.ax0a
  have nlim : ∀ i : Ordinal.{u}, ¬ Order.IsSuccLimit (i + 1) := fun i hl =>
    lt_irrefl _ (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
  have hXlim : ∀ ξ ∈ X, Order.IsSuccLimit ξ := fun ξ h => Ordinal.one_lt_cof_iff.1 (by
    rw [hX ξ h]; exact lt_of_lt_of_le Cardinal.one_lt_aleph0 (hinf.trans (Order.le_succ lam)))
  obtain ⟨θ, g, hθ, hθκ, gδ, gm, g0, gcof, gl, gsl, hθc⟩ := exists_cof_seq hinf hδ
    ((Ordinal.cof_le_card δ).trans (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hδ')))
  let P : Ordinal.{u} → Prop := fun i => i = 0 ∨ Order.IsSuccLimit i
  let γ : Ordinal.{u} → Ordinal.{u} := fun i => if P i then g i else g i + 1 + 1
  have γT : ∀ i, P i → γ i = g i := fun i h => by simp [γ, h]
  have γF : ∀ i, ¬ P i → γ i = g i + 1 + 1 := fun i h => by simp [γ, h]
  have Ps : ∀ i : Ordinal.{u}, ¬ P (i + 1) := fun i h => by
    rcases h with h | h
    · simp at h
    · exact nlim i h
  have gle : ∀ i, g i ≤ γ i := fun i => by
    by_cases h : P i
    · rw [γT i h]
    · rw [γF i h]; exact (Order.le_succ _).trans (Order.le_succ _)
  have gs : ∀ a b, g a < g b → g a + 1 + 1 < g b + 1 + 1 := fun a b h => by
    have h1 : g a + 1 ≤ g b := Order.add_one_le_of_lt h
    exact lt_of_le_of_lt (Order.add_one_le_of_lt (Order.lt_add_one_iff.2 h1))
      (Order.lt_add_one_iff.2 le_rfl)
  have γδ : ∀ i < θ, γ i < δ := fun i hi => by
    by_cases h : P i
    · rw [γT i h]; exact gδ i hi
    · rw [γF i h]; exact hδ.add_one_lt (hδ.add_one_lt (gδ i hi))
  have γm : ∀ a b, a < b → b < θ → γ a < γ b := by
    intro a b hab hb
    have hg := gm a b hab hb
    by_cases hP : P b
    · rw [γT b hP]
      have hbl : Order.IsSuccLimit b := by
        rcases hP with h | h
        · subst h; exact absurd hab (not_lt.2 zero_le)
        · exact h
      have hgl := gsl b hb hbl
      by_cases hPa : P a
      · rw [γT a hPa]; exact hg
      · rw [γF a hPa]; exact hgl.add_one_lt (hgl.add_one_lt hg)
    · rw [γF b hP]
      by_cases hPa : P a
      · rw [γT a hPa]
        exact hg.trans ((Order.lt_add_one_iff.2 le_rfl).trans (Order.lt_add_one_iff.2 le_rfl))
      · rw [γF a hPa]; exact gs a b hg
  have γ0 : γ 0 = 0 := by rw [γT 0 (Or.inl rfl)]; exact g0
  have γcof : ∀ ξ < δ, ∃ i < θ, ξ < γ i := fun ξ hξ => by
    obtain ⟨i, hi, h⟩ := gcof ξ hξ
    exact ⟨i, hi, lt_of_lt_of_le h (gle i)⟩
  have hsub : ∀ a < δ, ∀ b < δ, a ≤ b → (c a).carrier ⊆ (c b).carrier := fun a ha b hb h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub ((ih b hb).2.2.1 a h')
    · rw [h']
  have hcont : IsContinuous (fun i => c (γ i)) (Iio θ) := by
    intro b hb hl
    have hb' : b < θ := hb
    have e : γ b = g b := γT b (Or.inr hl)
    have hgl := gsl b hb' hl
    have hδb : g b < δ := gδ b hb'
    show (c (γ b)).carrier = _
    rw [e, ((ih (g b) hδb).2.2.2.1 hgl).1.1]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨j, hj, h⟩ := gl b hb' hl ξ hξ
      have hjθ := lt_trans hj hb'
      exact ⟨j, hj, hsub ξ (lt_trans hξ hδb) _ (γδ j hjθ) (h.le.trans (gle j)) hx⟩
    · rintro ⟨j, hj, hx⟩
      exact ⟨γ j, e ▸ γm j b hj hb', hx⟩
  have notX : ∀ i < θ, γ i ∉ X := by
    intro i hi hmem
    by_cases hP : P i
    · rcases hP with h | hl
      · subst h
        rw [γ0] at hmem
        exact Order.not_isSuccLimit_bot (hXlim _ hmem)
      · have e : γ i = g i := γT i (Or.inr hl)
        have hco : (g i).cof = Order.succ lam := e ▸ hX _ hmem
        let E := Ordinal.ToType.mk (o := i)
        let f : i.ToType → Ordinal.{u} := fun j => g (E.symm j : Ordinal)
        have hcard : #i.ToType < (g i).cof := by
          rw [hco, Cardinal.mk_toType]
          exact Order.lt_succ_iff.2 (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 (lt_of_lt_of_le hi hθκ)))
        have hf : ∀ j, f j < g i := fun j => gm _ _ (E.symm j).2 hi
        have hsup : iSup f < g i := Ordinal.iSup_lt_of_lt_cof hcard hf
        obtain ⟨j, hj, h⟩ := gl i hi hl _ hsup
        have : g j ≤ iSup f := by
          have := Ordinal.le_iSup f (E ⟨j, hj⟩)
          simpa [f] using this
        exact absurd h (not_lt.2 this)
    · rw [γF i hP] at hmem
      exact nlim _ (hXlim _ hmem)
  have hform : ∀ i, i + 1 < θ → γ (i + 1) = (g (i + 1) + 1) + 1 ∧ γ i ≤ g (i + 1) + 1 := by
    intro i hi
    refine ⟨γF _ (Ps i), ?_⟩
    have hg := gm i (i + 1) (Order.lt_add_one_iff.2 le_rfl) hi
    by_cases hPa : P i
    · rw [γT i hPa]; exact hg.le.trans (Order.le_succ _)
    · rw [γF i hPa]; exact Order.succ_le_succ (Order.add_one_le_of_lt hg)
  refine ⟨θ, γ, hθ, hθκ, hθc, γ0, γδ, γm, γcof, hcont, ?_, fun i hi => ⟨_, (hform i hi).1, (hform i hi).2⟩⟩
  intro i hi
  obtain ⟨e1, e2⟩ := hform i hi
  have hiθ : i < θ := lt_trans (Order.lt_add_one_iff.2 le_rfl) hi
  have hγi : γ i < δ := γδ i hiθ
  have L1 := ((ih (γ i + 1) (hδ.add_one_lt hγi)).2.2.2.2 (γ i) rfl).1 (notX i hiθ)
  rcases e2.lt_or_eq with h | h
  · have hζ : g (i + 1) + 1 + 1 < δ := e1 ▸ γδ _ hi
    have hnζ : g (i + 1) + 1 ∉ X := fun hm => nlim _ (hXlim _ hm)
    have L2 := (((ih _ hζ).2.2.2.2 _ rfl).2.2 (γ i) h).2 hnζ
    rw [e1]
    exact prop_7_1_10_d lam hU s hs7 _ _ _ L1 L2
  · rw [e1, ← h]; exact L1

/-- AUX: not in paper. One step of the construction in the proof of Thm 9.1.7. At `ξ ∈ X` the
model `M_{ξ+1}` is chosen after the isomorphisms `f_ε`, as the image of `M*_{λ⁺+1}` under an
extension of `⋃ f_ε` (the paper picks `M_{ξ+1}` first; see "Gaps in the paper's proofs"). -/
theorem Frame.g97_step [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_9_1_1 s lam) (hinf : ℵ₀ ≤ lam) {X : Set Ordinal.{u}}
    (hX : ∀ α ∈ X, α.cof = Order.succ lam) {Ms : Ordinal.{u} → Model U L}
    (hIC : IsIncCont s.S Ms (Iic ((Order.succ lam).ord + 1)) (s.Ksat lam))
    (hp1 : ∀ α < (Order.succ lam).ord, s.ltPlus lam (Ms α) (Ms (α + 1)))
    (hp2 : ∀ β < (Order.succ lam).ord, s.leNF lam (Ms β) (Ms ((Order.succ lam).ord + 1)))
    (hno : ¬ s.leNF lam (Ms (Order.succ lam).ord) (Ms ((Order.succ lam).ord + 1)))
    {α : Ordinal.{u}} (hα : α < (plusN lam 2).ord) {c : Ordinal.{u} → Model U L}
    (ih : ∀ β < α, s.G97 lam X (Ms 0) β c (c β)) : ∃ x, s.G97 lam X (Ms 0) α c x := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hs7 : Hyp_7_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have nlim : ∀ i : Ordinal.{u}, ¬ Order.IsSuccLimit (i + 1) := fun i hl =>
    lt_irrefl _ (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
  have hXlim : ∀ ξ ∈ X, Order.IsSuccLimit ξ := fun ξ h => Ordinal.one_lt_cof_iff.1 (by
    rw [hX ξ h]; exact lt_of_lt_of_le Cardinal.one_lt_aleph0 (hinf.trans (Order.le_succ lam)))
  have hκ₂ : (Order.succ lam).ord < (plusN lam 2).ord :=
    Cardinal.ord_lt_ord.2 (Order.lt_succ (Order.succ lam))
  have hκl : Order.IsSuccLimit (Order.succ lam).ord :=
    Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨ξ, hk⟩ | hl
  · subst h0
    refine ⟨Ms 0, hIC.2.2 0 (Set.mem_Iic.2 zero_le), fun _ => rfl,
      fun β hβ => absurd hβ (not_lt.2 zero_le), fun hl => absurd hl Order.not_isSuccLimit_bot,
      fun ξ h => absurd h.symm (by simp)⟩
  · have hk' : α = ξ + 1 := hk.symm
    subst hk'
    have hξα : ξ < ξ + 1 := Order.lt_add_one_iff.2 le_rfl
    have kc : c ξ ∈ s.Ksat lam := (ih ξ hξα).1
    have uniq : ∀ ξ', ξ + 1 = ξ' + 1 → ξ' = ξ := fun ξ' e =>
      (Order.succ_injective (show Order.succ ξ = Order.succ ξ' from e)).symm
    have prev : ∀ β < ξ, s.leNF lam (c (β + 1)) (c ξ) := by
      intro β hβ
      rcases Ordinal.zero_or_succ_or_isSuccLimit ξ with h0 | ⟨η, hη⟩ | hl'
      · subst h0; exact absurd hβ (not_lt.2 zero_le)
      · have hη' : ξ = η + 1 := hη.symm
        subst hη'
        have hβη : β ≤ η := Order.lt_succ_iff.1 hβ
        rcases hβη.lt_or_eq with h | h
        · exact ((ih (η + 1) hξα).2.2.2.2 η rfl).2.2 β h |>.1
        · rw [h]; exact Frame.leNF_refl hU hs6 hinf kc.1
      · exact ((ih ξ hξα).2.2.2.1 hl').2 β (hl'.add_one_lt hβ)
    by_cases hξX : ξ ∈ X
    · have hl := hXlim ξ hξX
      have hξ' : ξ < (plusN lam 2).ord := hξα.trans hα
      obtain ⟨θ, γ, hθ, hθκ, hθc, γ0, γδ, γm, γcof, γcont, γplus, γζ⟩ :=
        Frame.g97_chain hU hs hinf hX hl hξ' (fun β hβ => ih β (hβ.trans hξα))
      rw [hX ξ hξX] at hθc
      subst hθc
      set κ := (Order.succ lam).ord with hκdef
      have hκm : κ ∈ Iic (κ + 1) := Set.mem_Iic.2 (Order.le_succ _)
      have hκ1m : κ + 1 ∈ Iic (κ + 1) := Set.mem_Iic.2 le_rfl
      have hκ1 : κ < κ + 1 := Order.lt_add_one_iff.2 le_rfl
      have mI : ∀ i < κ, i ∈ Iic (κ + 1) := fun i hi => Set.mem_Iic.2 (hi.le.trans hκ1.le)
      have hAi : IsIncreasing s.S.le Ms (Iio κ) := fun a ha b hb h => hIC.1 a (mI a ha) b (mI b hb) h
      have hγle : IsIncreasing s.S.le (fun i => c (γ i)) (Iio κ) := fun a ha b hb h =>
        (ih (γ b) ((γδ b hb).trans hξα)).2.2.1 _ (γm a b h hb)
      obtain ⟨F, hF⟩ := Frame.plus_iso_chain (A := Ms) (B := fun i => c (γ i)) hU hs7
        (by show Ms 0 = c (γ 0); rw [γ0]; exact ((ih 0 (hl.bot_lt.trans hξα)).2.1 rfl).symm)
        (fun i hi => (hIC.2.2 i (mI i hi)).1) hAi hγle
        (fun β hβ hl' => hIC.2.1 β (mI β hβ) hl') γcont
        (fun i hi => hp1 i (lt_trans (Order.lt_add_one_iff.2 le_rfl) hi)) γplus
      have uA : IsUnionOf Ms (Iio κ) (Ms κ) := ⟨hIC.2.1 κ hκm hκl,
        fun i hi => hS.incl _ _ (hIC.1 i (mI i hi) κ hκm hi)⟩
      have uξ := ((ih ξ hξα).2.2.2.1 hl).1
      have uB : IsUnionOf (fun i => c (γ i)) (Iio κ) (c ξ) := by
        refine ⟨?_, fun i hi => uξ.2 _ (γδ i hi)⟩
        rw [uξ.1]
        ext x
        simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
        constructor
        · rintro ⟨β, hβ, hx⟩
          obtain ⟨i, hi, h⟩ := γcof β hβ
          exact ⟨i, hi, hS.sub ((ih (γ i) ((γδ i hi).trans hξα)).2.2.1 β h) hx⟩
        · rintro ⟨i, hi, hx⟩
          exact ⟨γ i, γδ i hi, hx⟩
      have iκ : IsoOn F (Ms κ) (c ξ) := IsoOn.union hS hκl hAi hγle uA uB hF
      have hsm : #(Ms κ).carrier < #U := by
        have e : #(Ms κ).carrier = Order.succ lam := (hIC.2.2 κ hκm).1.2
        rw [e]
        exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam))
          (hU.1.isStrongPrelimit hU.2)
      obtain ⟨σ, hσ⟩ := exists_perm_ext hU.infinite iκ.injOn hsm
      have jκ : IsoOn σ (Ms κ) (c ξ) := iκ.congr fun x hx => (hσ x hx).symm
      have ji : ∀ i < κ, IsoOn σ (Ms i) (c (γ i)) := fun i hi =>
        (hF i hi).congr fun x hx =>
          (hσ x (hS.sub (hIC.1 i (mI i hi) κ hκm hi) hx)).symm
      have iP := permModel_iso σ (Ms (κ + 1))
      have kP : permModel σ (Ms (κ + 1)) ∈ s.Ksat lam :=
        Saturated.iso hU hc hinf (hIC.2.2 _ hκ1m) iP
      have ls : s.S.le (c ξ) (permModel σ (Ms (κ + 1))) :=
        hS.iso_le (hIC.1 κ hκm _ hκ1m hκ1) iP jκ
      have noNF : ¬ s.leNF lam (c ξ) (permModel σ (Ms (κ + 1))) := by
        intro h
        obtain ⟨-, M', hM', hle⟩ := Frame.leNF_iso hU hs6 _ _ _ _ kP.1 h (permModel_symm_iso σ _)
        have e : M' = Ms κ := by
          have := permModel_symm_iso σ (Ms κ)
          rw [permModel_eq jκ] at this
          exact hM'.unique this
        exact hno (e ▸ hle)
      have nfγ : ∀ i, i + 1 < κ → s.leNF lam (c (γ (i + 1))) (permModel σ (Ms (κ + 1))) := by
        intro i hi
        obtain ⟨-, M', hM', hle⟩ := Frame.leNF_iso hU hs6 _ _ _ _ (hIC.2.2 _ hκ1m).1
          (hp2 (i + 1) hi) iP
        have e : M' = c (γ (i + 1)) := hM'.unique (ji _ hi)
        exact e ▸ hle
      refine ⟨permModel σ (Ms (κ + 1)), kP, fun h => absurd h (by simp), fun β hβ => ?_,
        fun hl' => absurd hl' (nlim ξ), fun ξ' e => ?_⟩
      · rcases (Order.lt_succ_iff.1 hβ).lt_or_eq with h | h
        · exact hS.trans ((ih ξ hξα).2.2.1 β h) ls
        · rw [h]; exact ls
      · rw [uniq ξ' e]
        refine ⟨fun h => absurd hξX h, fun _ => noNF, fun β hβ => ⟨?_, fun h => absurd hξX h⟩⟩
        obtain ⟨i, hi, hβi⟩ := γcof β hβ
        have hi1 : i + 1 < κ := hκl.add_one_lt hi
        obtain ⟨ζ, hζ, hle⟩ := γζ i hi1
        have hβζ : β < ζ := lt_of_lt_of_le hβi hle
        have hζξ : ζ + 1 < ξ + 1 := hζ ▸ (γδ (i + 1) hi1).trans hξα
        have h1 := (((ih (ζ + 1) hζξ).2.2.2.2 ζ rfl).2.2 β hβζ).1
        rw [← hζ] at h1
        exact Frame.leNF_trans hU hs6 h1 (nfγ i hi1)
    · obtain ⟨x, hx⟩ := prop_7_1_12_a lam hU s hs7 hinf (c ξ) kc.1
      have kx := prop_7_1_10_b lam hU s hs7 _ _ hx
      have hxn := (prop_7_1_10_a lam hU s hs7 _ _ hx).1
      refine ⟨x, kx, fun h => absurd h (by simp), fun β hβ => ?_, fun hl' => absurd hl' (nlim ξ),
        fun ξ' e => ?_⟩
      · rcases (Order.lt_succ_iff.1 hβ).lt_or_eq with h | h
        · exact hS.trans ((ih ξ hξα).2.2.1 β h) hxn.2.2.1
        · rw [h]; exact hxn.2.2.1
      · rw [uniq ξ' e]
        refine ⟨fun _ => hx, fun h => absurd h hξX, fun β hβ => ?_⟩
        have hp := prop_7_1_10_c lam hU s hs7 _ _ _ (prev β hβ) hx
        exact ⟨(prop_7_1_10_a lam hU s hs7 _ _ hp).1, fun _ => hp⟩
  · obtain ⟨θ, γ, hθ, hθκ, -, γ0, γδ, γm, γcof, γcont, γplus, γζ⟩ :=
      Frame.g97_chain hU hs hinf hX hl hα ih
    have hγle : IsIncreasing s.S.le (fun i => c (γ i)) (Iio θ) := fun a ha b hb h =>
      (ih (γ b) (γδ b hb)).2.2.1 _ (γm a b h hb)
    have hθ₂ : θ < (plusN lam 2).ord := lt_of_le_of_lt hθκ hκ₂
    have hnf : IsIncreasing (s.leNF lam) (fun i => c (γ i)) (Iio θ) :=
      Frame.leNF_chain hU hs6 hinf hθ₂ hγle γcont fun i hi =>
        (prop_7_1_10_a lam hU s hs7 _ _ (γplus i hi)).1
    obtain ⟨x, hx, kx, -⟩ := thm_7_1_18_a lam hU s hs7 θ hθ hθ₂ (fun i => c (γ i))
      (fun a ha b hb h => ⟨(ih _ (γδ a ha)).1, (ih _ (γδ b hb)).1, hnf a ha b hb h⟩) γcont
    have hlex : ∀ i < θ, s.S.le (c (γ i)) x := fun i hi =>
      (hS.le_union hθ hγle γcont hx).2 i hi
    have hle : ∀ β < α, s.S.le (c β) x := fun β hβ => by
      obtain ⟨i, hi, h⟩ := γcof β hβ
      exact hS.trans ((ih (γ i) (γδ i hi)).2.2.1 β h) (hlex i hi)
    refine ⟨x, kx, fun h => by rw [h] at hl; exact absurd hl Order.not_isSuccLimit_bot, hle, fun _ => ⟨⟨?_,
      fun β hβ => hS.incl _ _ (hle β hβ)⟩, fun β hβ => ?_⟩, fun ξ e => absurd (e ▸ hl) (nlim ξ)⟩
    · rw [hx.1]
      ext y
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨i, hi, hy⟩
        exact ⟨γ i, γδ i hi, hy⟩
      · rintro ⟨β, hβ, hy⟩
        obtain ⟨i, hi, h⟩ := γcof β hβ
        exact ⟨i, hi, hS.sub ((ih (γ i) (γδ i hi)).2.2.1 β h) hy⟩
    · have hβα : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hβ
      obtain ⟨i, hi, hβi⟩ := γcof β hβα
      have hi1 : i + 1 < θ := hθ.add_one_lt hi
      obtain ⟨ζ, hζ, hle'⟩ := γζ i hi1
      have hβζ : β < ζ := lt_of_lt_of_le hβi hle'
      have h1 := (((ih (ζ + 1) (hζ ▸ γδ (i + 1) hi1)).2.2.2.2 ζ rfl).2.2 β hβζ).1
      rw [← hζ] at h1
      exact Frame.leNF_trans hU hs6 h1 (Frame.leNF_of_union hU hs6 hinf hθ hθ₂ hnf γcont hx hi1)


/-- Thm 9.1.7: if there is an increasing continuous `⟨M*_α : α ≤ λ⁺+1⟩` in `K^sat` with
`M*_α ≺⁺ M*_β ≼^NF M*_{λ⁺+1}` for `α < β < λ⁺` but `M*_{λ⁺} ⋠^NF M*_{λ⁺+1}`, then there are
`2^{λ^{+2}}` pairwise non-isomorphic models in `K_{λ^{+2}}`. -/
theorem thm_9_1_7 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_9_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 9.1.4–9.1.6 (`λ^{+2}` must be a limit ordinal).
    (hinf : ℵ₀ ≤ lam)
    (h : ∃ M : Ordinal.{u} → Model U L,
      IsIncCont s.S M (Iic ((Order.succ lam).ord + 1)) (s.Ksat lam) ∧
      -- PROOF-STAGE CHANGE: hypothesis weakened to its successor case (the paper has
      -- `M*_α ≺⁺ M*_β ≼^NF M*_{λ⁺+1}` for all `α < β < λ⁺`); the proof uses only this, and the
      -- paper's hypothesis implies it. Needed by Thm 7.1.3, since Prop 8.1.6 gives only successors.
      (∀ α < (Order.succ lam).ord, s.ltPlus lam (M α) (M (α + 1))) ∧
      (∀ β < (Order.succ lam).ord, s.leNF lam (M β) (M ((Order.succ lam).ord + 1))) ∧
      ¬ s.leNF lam (M (Order.succ lam).ord) (M ((Order.succ lam).ord + 1))) :
    (2 : Cardinal.{u}) ^ (plusN lam 2) ≤ numModels s.S (plusN lam 2) := by
  classical
  obtain ⟨Ms, hIC, hp1, hp2, hno⟩ := h
  have hs6 : Hyp_6_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf₂ : ℵ₀ ≤ plusN lam 2 :=
    hinf.trans ((Order.le_succ lam).trans (Order.le_succ _))
  have hκl : Order.IsSuccLimit (plusN lam 2).ord := Cardinal.isSuccLimit_ord hinf₂
  refine prop_9_1_6 lam hU s hs hinf fun X hX => ?_
  have nlim : ∀ i : Ordinal.{u}, ¬ Order.IsSuccLimit (i + 1) := fun i hl =>
    lt_irrefl _ (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c =>
    α < (plusN lam 2).ord → s.G97 lam X (Ms 0) α c (c α)
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' e h hα
    rw [← e α le_rfl]
    exact (h hα).congr fun β hβ => e β hβ.le
  have : Nonempty (Model U L) := ⟨Ms 0⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (plusN lam 2).ord Inv hloc (by
    intro α hαθ c ih
    by_cases hα : α < (plusN lam 2).ord
    · obtain ⟨x, hx⟩ := Frame.g97_step hU hs hinf hX.2 hIC hp1 hp2 hno hα
        (c := c) (fun β hβ => ih β hβ (hβ.trans hα))
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      exact hx.congr fun β hβ => by simp [hβ]
    · exact ⟨Ms 0, fun h => absurd h hα⟩)
  have hG : ∀ α < (plusN lam 2).ord, s.G97 lam X (Ms 0) α c (c α) := fun α hα => hcI α hα.le hα
  have hinc : IsIncreasing s.S.le c (Iio (plusN lam 2).ord) := fun a _ b hb h =>
    (hG b hb).2.2.1 a h
  have hcont : IsContinuous c (Iio (plusN lam 2).ord) := fun β hβ hl =>
    ((hG β hβ).2.2.2.1 hl).1.1
  have hlt : ∀ β < (plusN lam 2).ord, β + 1 < (plusN lam 2).ord := fun β hβ => hκl.add_one_lt hβ
  have hKs : ∀ β < (plusN lam 2).ord, c β ∈ s.S.Kc (Order.succ lam) := fun β hβ => (hG β hβ).1.1
  obtain ⟨N, hN, hNK, -⟩ := hS.union _ hκl c hinc hcont
  have hG5 : ∀ β < (plusN lam 2).ord, _ := fun β hβ => (hG (β + 1) (hlt β hβ)).2.2.2.2 β rfl
  have hdiff : ∀ β < (plusN lam 2).ord, ∃ a ∈ (c (β + 1)).carrier, a ∉ (c β).carrier := by
    intro β hβ
    have hle := hinc β hβ (β + 1) (hlt β hβ) (Order.lt_add_one_iff.2 le_rfl)
    have hne : c β ≠ c (β + 1) := by
      intro e
      by_cases hX' : β ∈ X
      · exact (hG5 β hβ).2.1 hX' (e ▸ Frame.leNF_refl hU hs6 hinf (hKs β hβ))
      · have := (prop_7_1_10_a lam hU s hs _ _ ((hG5 β hβ).1 hX')).2
        exact this e
    by_contra hcon
    push Not at hcon
    exact hne ((hS.incl _ _ hle).eq_of_carrier hcon)
  have : Infinite U := hU.infinite
  choose! a ha hna using hdiff
  have hNcard : N.card = plusN lam 2 := by
    apply le_antisymm
    · have hb := card_biUnion_le hinf₂ (δ := (plusN lam 2).ord) (X := fun β => (c β).carrier)
        (by rw [Cardinal.card_ord]) (fun β hβ => by
          show #(c β).carrier ≤ plusN lam 2
          rw [show #(c β).carrier = Order.succ lam from (hKs β hβ).2]
          exact Order.le_succ _)
      show #N.carrier ≤ _
      rw [hN.1]; exact hb
    · have hinj : Function.Injective fun i : (plusN lam 2).ord.ToType =>
          (⟨a ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm i : Ordinal), by
            have hi := ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm i).2
            rw [hN.1]
            exact Set.mem_iUnion₂.2 ⟨_, hlt _ hi, ha _ hi⟩⟩ : N.carrier) := by
        intro i j hij
        have hij' := congrArg Subtype.val hij
        simp only at hij'
        by_contra hne
        have hne' : ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm i : Ordinal) ≠
            (Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm j := fun e =>
          hne ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm.injective (Subtype.ext e))
        have hi := ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm i).2
        have hj := ((Ordinal.ToType.mk (o := (plusN lam 2).ord)).symm j).2
        have key : ∀ x y : Ordinal.{u}, x < (plusN lam 2).ord → y < (plusN lam 2).ord → x < y →
            a x ≠ a y := by
          intro x y hx hy hxy e
          have h1 : (c (x + 1)).carrier ⊆ (c y).carrier := by
            rcases (Order.add_one_le_of_lt hxy).lt_or_eq with h | h
            · exact hS.sub (hinc _ (hlt x hx) y hy h)
            · rw [h]
          exact hna y hy (e ▸ h1 (ha x hx))
        rcases lt_or_gt_of_ne hne' with h | h
        · exact key _ _ hi hj h hij'
        · exact key _ _ hj hi h hij'.symm
      have := Cardinal.mk_le_of_injective hinj
      rw [Cardinal.mk_toType, Cardinal.card_ord] at this
      exact this
  have hM : s.IncNFSucc lam c (plusN lam 2).ord :=
    ⟨hinc, hKs, fun β γ hβγ hγ => ((hG5 γ hγ).2.2 β hβγ).1⟩
  refine ⟨N, ⟨hNK, hNcard⟩, c, hM, hcont, hN, ?_⟩
  refine ⟨Iio (plusN lam 2).ord, ⟨Subset.rfl, fun α hα => ⟨α + 1, hlt α hα,
    Order.lt_add_one_iff.2 le_rfl⟩, fun γ hγ _ _ => hγ⟩, ?_⟩
  ext δ
  simp only [Set.mem_inter_iff, Set.mem_Iio]
  have ht := (prop_9_1_4 lam hU s hs hinf c hM hcont).1
  constructor
  · rintro ⟨⟨hδ, α, hα, hα', hne⟩, h2⟩
    refine ⟨?_, h2⟩
    by_contra hnX
    exact hne ((ht δ hδ).1 (prop_7_1_10_a lam hU s hs _ _ ((hG5 δ hδ).1 hnX)).1 α hα hα')
  · rintro ⟨hX', h2⟩
    exact ⟨⟨h2, δ + 1, Order.lt_add_one_iff.2 le_rfl, hlt δ h2, (hG5 δ h2).2.1 hX'⟩, h2⟩

/-- AUX: not in paper. The content of `b ⇐ a` in Thm 9.1.13 (Prop 8.1.3(b) along a cofinal
sequence). -/
theorem Frame.b_of_nonsmooth [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_9_1_1 s lam) (hinf : ℵ₀ ≤ lam)
    (hns : ¬ ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ) :
    ∃ M₁s ∈ s.Ksat lam, ∃ M₂s ∈ s.Ksat lam, s.leOt lam M₁s M₂s ∧ ¬ s.ltNF lam M₁s M₂s := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκ₂ : (Order.succ lam).ord < (plusN lam 2).ord :=
    Cardinal.ord_lt_ord.2 (Order.lt_succ (Order.succ lam))
  simp only [not_forall] at hns
  obtain ⟨δ, hl, hnot⟩ := hns
  simp only [KSys.AxSmooth, not_forall] at hnot
  obtain ⟨M, N, hi, hcont, hall, N', hu, hK, hnle⟩ := hnot
  have hMs : ∀ α < δ, M α ∈ s.Ksat lam := fun α hα => (hall α hα).1
  have hN : N ∈ s.Ksat lam := (hall 0 hl.bot_lt).2.1
  have hN' : N' ∈ s.Ksat lam := hK
  have hMle : IsIncreasing s.S.le M (Iio δ) := fun a ha b hb h' => (hi a ha b hb h').2.2.2.2.1
  have hle' := (hS.le_union hl hMle hcont hu).2
  have hsubM : ∀ a < δ, ∀ b < δ, a ≤ b → (M a).carrier ⊆ (M b).carrier := fun a ha b hb h' => by
    rcases h'.lt_or_eq with h'' | h''
    · exact hS.sub (hMle a ha b hb h'')
    · rw [h'']
  have hne : N' ≠ N := by
    rintro rfl
    exact hnle ⟨hN', hN', Frame.leNF_refl hU hs6 hinf hN'.1⟩
  by_cases hcof : δ.cof ≤ Order.succ lam
  · obtain ⟨θ, g, hθ, hθκ, gδ, gm, g0, gcof, gl, gsl, -⟩ := exists_cof_seq hinf hl hcof
    have hθ₂ : θ < (plusN lam 2).ord := lt_of_le_of_lt hθκ hκ₂
    have hMg : IsIncreasing (s.leNF lam) (fun i => M (g i)) (Iio θ) := fun a ha b hb h' =>
      (hi _ (gδ a ha) _ (gδ b hb) (gm a b h' hb)).2.2
    have hcm : IsContinuous (fun i => M (g i)) (Iio θ) := fun b hb hlb => by
      have hbθ : b < θ := hb
      show (M (g b)).carrier = _
      rw [hcont _ (gδ b hbθ) (gsl b hbθ hlb)]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨j, hj, h'⟩ := gl b hbθ hlb ξ hξ
        have hjθ := lt_trans hj hbθ
        exact ⟨j, hj, hsubM ξ (lt_trans h' (gδ j hjθ)) _ (gδ j hjθ) h'.le hx⟩
      · rintro ⟨j, hj, hx⟩
        exact ⟨g j, gm j b hj hbθ, hx⟩
    have hNm : IsUnionOf (fun i => M (g i)) (Iio θ) N' := ⟨by
      rw [hu.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨i, hi', h'⟩ := gcof ξ hξ
        exact ⟨i, hi', hsubM ξ hξ _ (gδ i hi') h'.le hx⟩
      · rintro ⟨i, hi', hx⟩
        exact ⟨g i, gδ i hi', hx⟩, fun i hi' => hu.2 _ (gδ i hi')⟩
    have hto : ∀ i < θ, s.leNF lam (M (g i)) N' := fun i hi' =>
      Frame.leNF_of_union hU hs6 hinf hθ hθ₂ hMg hcm hNm hi'
    let Y : Ordinal.{u} → Model U L := fun i => if i < θ then M (g i) else if i = θ then N' else N
    have Y1 : ∀ i < θ, Y i = M (g i) := fun i hi' => by simp [Y, hi']
    have Yθ : Y θ = N' := by simp [Y]
    have Yθ1 : Y (θ + 1) = N := by
      have h1' : ¬ (θ + 1 < θ) := not_lt.2 (Order.le_succ θ)
      have h2' : θ + 1 ≠ θ := (Order.lt_add_one_iff.2 le_rfl).ne'
      simp [Y, h1', h2']
    have hOt := prop_8_1_3_b lam hU s hs θ hθ Y ⟨?_, ?_, ?_⟩ ?_ (by rw [Yθ1]; exact hN)
      (by rw [Yθ, Yθ1]; exact hne)
    · rw [Yθ, Yθ1] at hOt
      refine ⟨N', hN', N, hN, hOt, fun hlt => hnle ⟨hN', hN, hlt.1⟩⟩
    · intro a ha b hb hab
      have haθ : a < θ := lt_of_lt_of_le hab hb
      rw [Y1 a haθ]
      rcases (show b ≤ θ from hb).lt_or_eq with h' | h'
      · rw [Y1 b h']; exact hMg a haθ b h' hab
      · rw [h', Yθ]; exact hto a haθ
    · intro β hβ hl'
      show (Y β).carrier = _
      rcases (show β ≤ θ from hβ).lt_or_eq with h' | h'
      · rw [Y1 β h', hcm β h' hl']
        exact Set.iUnion₂_congr fun ζ hζ => by rw [Y1 ζ (lt_trans hζ h')]
      · rw [h', Yθ, hNm.1]
        exact Set.iUnion₂_congr fun ζ hζ => by rw [Y1 ζ hζ]
    · intro ε hε
      rcases hε.lt_or_eq with h' | h'
      · rw [Y1 ε h']; exact hMs _ (gδ ε h')
      · rw [h', Yθ]; exact hN'
    · intro ε hε
      rw [Y1 ε hε, Yθ1]
      exact (hall _ (gδ ε hε)).2.2
  · exfalso
    have hex : ∀ x : N'.carrier, ∃ ζ < δ, x.1 ∈ (M ζ).carrier := fun x => by
      have hx := (Set.ext_iff.1 hu.1 x.1).1 x.2
      obtain ⟨ζ, hζ, h'⟩ := Set.mem_iUnion₂.1 hx
      exact ⟨ζ, hζ, h'⟩
    choose f hf hfR using hex
    have hcard : #N'.carrier ≤ Order.succ lam := le_of_eq hN'.1.2
    have hsup : iSup f < δ := Ordinal.iSup_lt_of_lt_cof (lt_of_le_of_lt hcard (not_le.1 hcof)) hf
    have hsub' : N'.carrier ⊆ (M (iSup f)).carrier := fun x hx =>
      hsubM _ (hf ⟨x, hx⟩) _ hsup (Ordinal.le_iSup f ⟨x, hx⟩) (hfR ⟨x, hx⟩)
    have e : M (iSup f) = N' := (hu.2 _ hsup).eq_of_carrier hsub'
    exact hnle (e ▸ hall _ hsup)

/-- AUX: not in paper. `b ⇒ c` of Thm 9.1.13 in the form used for Thm 9.1.7. -/
theorem Frame.c_of_b [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_9_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₁s M₂s : Model U L} (h : s.leOt lam M₁s M₂s)
    (hn : ¬ s.ltNF lam M₁s M₂s) :
    ∃ M : Ordinal.{u} → Model U L,
      IsIncCont s.S M (Iic ((Order.succ lam).ord + 1)) (s.Ksat lam) ∧
      (∀ α < (Order.succ lam).ord, s.ltPlus lam (M α) (M (α + 1))) ∧
      (∀ β < (Order.succ lam).ord, s.leNF lam (M β) (M ((Order.succ lam).ord + 1))) ∧
      ¬ s.leNF lam (M (Order.succ lam).ord) (M ((Order.succ lam).ord + 1)) := by
  obtain ⟨M, hIC, e1, e2, hp, hl⟩ := prop_8_1_6 lam hU s hs hinf M₁s M₂s h
  refine ⟨M, hIC, hp, fun β hβ => by rw [e2]; exact hl β hβ, ?_⟩
  rw [e1, e2]
  exact fun hle => hn ⟨hle, h.2.2.1.2⟩

/-- Thm 9.1.13: equivalent: (a) `(K^sat, ≼^NF ↾ K^sat)` does not satisfy smoothness; (b) there
are `M₁*, M₂* ∈ K^sat` with `M₁* ≼^⊗ M₂*` but `M₁* ⊀^NF M₂*`; (c) there is
`⟨M_ε : ε ≤ λ⁺+1⟩` in `K^sat`, increasing and continuous, with `M_ε ≺⁺ M_{ε+1}` and
`M_ε ≼^NF M_{λ⁺+1}` for `ε < λ⁺`, and `M_{λ⁺} ⋠^NF M_{λ⁺+1}`.

Original text of item (c): "There is a sequence `⟨M_ε : ε ≤ λ⁺+1⟩` of models in `K^sat` such that for
each `ε, ζ` with `ε < ζ ≤ λ⁺+1`, we have `ε ≠ λ⁺ ⇔ M_ε ≺⁺ M_ζ ⇔ M_ε ≼^NF M_ζ`." -/
theorem thm_9_1_13 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_9_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 9.1.4–9.1.6.
    (hinf : ℵ₀ ≤ lam) :
    ((¬ ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ) ↔
      ∃ M₁s ∈ s.Ksat lam, ∃ M₂s ∈ s.Ksat lam, s.leOt lam M₁s M₂s ∧ ¬ s.ltNF lam M₁s M₂s) ∧
    ((∃ M₁s ∈ s.Ksat lam, ∃ M₂s ∈ s.Ksat lam, s.leOt lam M₁s M₂s ∧ ¬ s.ltNF lam M₁s M₂s) ↔
      -- PROOF-STAGE CHANGE: item (c) restated; see docs/METHOD.md. The paper's text
      -- omits continuity, without which `c ⇒ a` has no proof, and it requires `M_ε ≺⁺ M_ζ` at limit
      -- `ζ`, which neither Prop 8.1.6 nor the proof gives.
      ∃ M : Ordinal.{u} → Model U L,
        IsIncCont s.S M (Iic ((Order.succ lam).ord + 1)) (s.Ksat lam) ∧
        (∀ α < (Order.succ lam).ord, s.ltPlus lam (M α) (M (α + 1))) ∧
        (∀ β < (Order.succ lam).ord, s.leNF lam (M β) (M ((Order.succ lam).ord + 1))) ∧
        ¬ s.leNF lam (M (Order.succ lam).ord) (M ((Order.succ lam).ord + 1))) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hs7 : Hyp_7_1_1 s lam := hs
  have hS : IsAEC s.S := hs.1.1.ax0a
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl : Order.IsSuccLimit (Order.succ lam).ord := Cardinal.isSuccLimit_ord hinf₁
  have hκ₂ : (Order.succ lam).ord < (plusN lam 2).ord :=
    Cardinal.ord_lt_ord.2 (Order.lt_succ (Order.succ lam))
  have key : ∀ M : Ordinal.{u} → Model U L,
      IsIncCont s.S M (Iic ((Order.succ lam).ord + 1)) (s.Ksat lam) →
      (∀ α < (Order.succ lam).ord, s.ltPlus lam (M α) (M (α + 1))) →
      (IsIncreasing (s.leNF lam) M (Iio (Order.succ lam).ord) ∧
        IsIncreasing s.S.le M (Iio (Order.succ lam).ord) ∧
        IsContinuous M (Iio (Order.succ lam).ord) ∧
        IsUnionOf M (Iio (Order.succ lam).ord) (M (Order.succ lam).ord)) := by
    intro M hIC hp1
    have hκm : (Order.succ lam).ord ∈ Iic ((Order.succ lam).ord + 1) := Set.mem_Iic.2 (Order.le_succ _)
    have mI : ∀ i < (Order.succ lam).ord, i ∈ Iic ((Order.succ lam).ord + 1) := fun i hi =>
      Set.mem_Iic.2 (hi.le.trans (Order.le_succ _))
    have hle : IsIncreasing s.S.le M (Iio (Order.succ lam).ord) := fun a ha b hb h' =>
      hIC.1 a (mI a ha) b (mI b hb) h'
    have hco : IsContinuous M (Iio (Order.succ lam).ord) := fun β hβ hl' => hIC.2.1 β (mI β hβ) hl'
    exact ⟨Frame.leNF_chain hU hs6 hinf hκ₂ hle hco fun i hi =>
        (prop_7_1_10_a lam hU s hs7 _ _ (hp1 i (lt_trans (Order.lt_add_one_iff.2 le_rfl) hi))).1,
      hle, hco, hIC.2.1 _ hκm hκl, fun i hi => hS.incl _ _ (hIC.1 i (mI i hi) _ hκm hi)⟩
  refine ⟨⟨Frame.b_of_nonsmooth hU hs hinf, ?_⟩, ⟨?_, ?_⟩⟩
  · rintro ⟨M₁s, -, M₂s, -, h, hn⟩ hsm
    obtain ⟨M, hIC, hp1, hp2, hno⟩ := Frame.c_of_b hU hs hinf h hn
    obtain ⟨hnf, hle, hco, hu⟩ := key M hIC hp1
    have hsat : ∀ i, i ≤ (Order.succ lam).ord + 1 → M i ∈ s.Ksat lam := fun i hi =>
      hIC.2.2 i (Set.mem_Iic.2 hi)
    have hκ1m := hsat _ le_rfl
    have hκm := hsat _ (Order.le_succ _)
    have hsi : ∀ i < (Order.succ lam).ord, i ≤ (Order.succ lam).ord + 1 := fun i hi =>
      hi.le.trans (Order.le_succ _)
    exact hno (hsm _ hκl M (M ((Order.succ lam).ord + 1))
      (fun a ha b hb h' => ⟨hsat a (hsi a ha), hsat b (hsi b hb), hnf a ha b hb h'⟩) hco
      (fun α hα => ⟨hsat α (hsi α hα), hκ1m, hp2 α hα⟩) _ hu hκm).2.2
  · rintro ⟨M₁s, -, M₂s, -, h, hn⟩
    exact Frame.c_of_b hU hs hinf h hn
  · rintro ⟨M, hIC, hp1, hp2, hno⟩
    obtain ⟨hnf, hle, hco, hu⟩ := key M hIC hp1
    have hsat : ∀ i, i ≤ (Order.succ lam).ord + 1 → M i ∈ s.Ksat lam := fun i hi =>
      hIC.2.2 i (Set.mem_Iic.2 hi)
    have hto : ∀ i < (Order.succ lam).ord, s.leNF lam (M i) (M (Order.succ lam).ord) := fun i hi =>
      Frame.leNF_of_union hU hs6 hinf hκl hκ₂ hnf hco hu hi
    have hne : M (Order.succ lam).ord ≠ M ((Order.succ lam).ord + 1) := fun e =>
      hno (e ▸ Frame.leNF_refl hU hs6 hinf (hsat _ (Order.le_succ _)).1)
    have hOt := prop_8_1_3_b lam hU s hs _ hκl M ⟨fun a ha b hb hab => ?_,
      fun β hβ hl' => hIC.2.1 β (Set.mem_Iic.2 (le_trans hβ (Order.le_succ _))) hl',
      fun ε hε => hsat ε (hε.trans (Order.le_succ _))⟩ hp2 (hsat _ le_rfl) hne
    · exact ⟨_, hsat _ (Order.le_succ _), _, hsat _ le_rfl, hOt, fun hlt => hno hlt.1⟩
    · have ha' : a < (Order.succ lam).ord := lt_of_lt_of_le hab hb
      rcases (show b ≤ _ from hb).lt_or_eq with h' | h'
      · exact hnf a ha' b h' hab
      · rw [h']; exact hto a ha'

/-- Thm 7.1.3: if `(K^sat, ≼^NF ↾ K^sat)` does not satisfy smoothness, then there are
`2^{λ^{+2}}` pairwise non-isomorphic models in `K_{λ^{+2}}` (encoded as
`2^{λ^{+2}} ≤ I(λ^{+2}, K)`). -/
theorem thm_7_1_3 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (hns : ¬ ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ) :
    (2 : Cardinal.{u}) ^ (plusN lam 2) ≤ numModels s.S (plusN lam 2) := by
  have hs9 : Hyp_9_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hinf : ℵ₀ ≤ lam := by
    have hns' := hns
    simp only [not_forall] at hns'
    obtain ⟨δ, hl, hnot⟩ := hns'
    simp only [KSys.AxSmooth, not_forall] at hnot
    obtain ⟨M, N, -, -, hall, -⟩ := hnot
    obtain ⟨-, -, -, W, hW, -⟩ := (hall 0 hl.bot_lt).2.2
    exact Frame.aleph0_le hc hW
  obtain ⟨M₁s, -, M₂s, -, h, hn⟩ := Frame.b_of_nonsmooth hU hs9 hinf hns
  exact thm_9_1_7 lam hU s hs9 hinf (Frame.c_of_b hU hs9 hinf h hn)

/-! ════════════════════════════════════════════════════════════════════════════
    PART 10 : SECTION 10  (A good λ⁺-frame)
    ════════════════════════════════════════════════════════════════════════════ -/

-- AGENT-CHOICE (reading): item 2 of Def 10.1.1 reads "satisfies smoothness" with no subject; we
-- read it as "`(K^sat, ≼^NF_{λ⁺} ↾ K^sat)` satisfies smoothness" (cf. Thm 7.1.3, 7.1.18(b)).
/-- Def 10.1.1: the semi-good `λ`-frame `s` is successful: (1) `K^{3,uq}` satisfies the existence
property, (2) `(K^sat, ≼^NF ↾ K^sat)` satisfies smoothness. -/
def Frame.Successful (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.ExistProp lam (s.K3uq lam) ∧
    ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ

/-- Hypothesis 10.1.2: `s` is a successful semi-good `λ`-frame with conjugation. -/
def Hyp_10_1_2 (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.IsSemiGood lam ∧ s.Successful lam ∧ ConjProp s lam

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

/-- `((K^sat)^up, (≼^NF ↾ K^sat)^up)`. -/
def upKSys : KSys U L := (s.satKSys lam).up

-- (After the erratum in Def 1.0.22 the pool is the whole class `(K^sat)^up`; the cardinal
-- argument `λ⁺` of `tp` is irrelevant.)
/-- Def 10.1.3: `tp⁺(a, M₀, M₁) := tp_{((K^sat)^up, (≼^NF ↾ K^sat)^up)}(a, M₀, M₁)`. -/
def tpPlus (a : U) (M₀ M₁ : Model U L) : Set (Tri U L) :=
  tp (s.upKSys lam) (Order.succ lam) a M₀ M₁

/-- Def 10.1.5: for `p = tp⁺(a, M₀, M₁)` and `N ∈ K_λ`, `N ≼ M₀`, `p ↾ N := tp(a, N, M₁)`
(union over representatives, as in `res`). -/
-- PROOF-STAGE CHANGE: ENCODING: the union runs over representatives with `M₁ ∈ K^sat` (Def 10.1.3
-- defines `tp⁺(a, M₀, M₁)` only for `M₀, M₁ ∈ K^sat`). Over all representatives of `(K^sat)^up` some
-- `M₁` may lie outside `K`, where `tp(a, N, M₁)` is a singleton, and `q ↾ N = p` (Prop 10.1.13(1))
-- would fail. Step: proof of Prop 10.1.13(1).
def resPlus (p : Set (Tri U L)) (N : Model U L) : Set (Tri U L) :=
  {t | ∃ (M₀ M₁ : Model U L) (a : U), M₁ ∈ s.Ksat lam ∧ (M₀, M₁, a) ∈ p ∧ t ∈ tp s.S lam a N M₁}

/-- Def 10.1.6(1): `S^{bs,+}(M) = {tp⁺(a, M, N) : M, N ∈ K^sat, M ≼^NF N, tp(a, M, N) ∈ S^bs_{>λ}}`
(for `M ∈ K^sat`). -/
def SbsPlus (M : Model U L) : Set (Set (Tri U L)) :=
  {p | M ∈ s.Ksat lam ∧ ∃ (N : Model U L) (a : U), N ∈ s.Ksat lam ∧ s.leNF lam M N ∧
    tp s.S lam a M N ∈ s.SbsGt lam M ∧ p = s.tpPlus lam a M N}

-- DEVIATION (encoding): Def 10.1.6(2) defines "tp⁺(a, M₁, M₂) does not fork over M₀"; as a
-- frame needs a relation on quadruples, we set `⨿⁺(M₀, M₁, a, M₂)` to hold exactly when the
-- defining condition holds for the triple `(M₁, M₂, a)`.
/-- Def 10.1.6(2): `⨿⁺(M₀, M₁, a, M₂)` iff `M₀, M₁, M₂ ∈ K^sat`, `M₀ ≼^NF M₁ ≼^NF M₂` and
`tp(a, M₁, M₂)` does not fork over `M₀` in the sense of Def 2.6.2. -/
def nfPlus (M₀ M₁ : Model U L) (a : U) (M₂ : Model U L) : Prop :=
  M₀ ∈ s.Ksat lam ∧ M₁ ∈ s.Ksat lam ∧ M₂ ∈ s.Ksat lam ∧ s.leNF lam M₀ M₁ ∧ s.leNF lam M₁ M₂ ∧
    s.NotForkGe lam M₀ M₁ (tp s.S lam a M₁ M₂)

/-- Def 10.1.6: `s⁺ := ((K^sat)^up, (≼^NF ↾ K^sat)^up, S^{bs,+}, ⨿⁺)`. -/
def splus : Frame U L where
  S := s.upKSys lam
  Sbs := s.SbsPlus lam
  nf := s.nfPlus lam

end Frame

/-- Prop 10.1.8: for a successful semi-good `λ`-frame with conjugation, `(K^sat, ≼^NF ↾ K^sat)`
(1) satisfies Axiom c of AEC in `λ⁺`, (2) is an AEC in `λ⁺`, (3) satisfies the amalgamation
property. -/
theorem prop_10_1_8 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_10_1_2 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Thm 7.1.18(b).
    (hinf : ℵ₀ ≤ lam) :
    (∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → δ < (plusN lam 2).ord →
      (s.satKSys lam).AxUnion δ) ∧
    IsAECIn (s.satKSys lam) (Order.succ lam) ∧ AP (s.satKSys lam) (Order.succ lam) := by
  have hs7 : Hyp_7_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  exact ⟨thm_7_1_18_a lam hU s hs7, thm_7_1_18_b lam hU s hs7 hinf hs.2.1.2,
    thm_7_1_18_c lam hU s hs7⟩

/-- AUX: not in paper. `Room U λ` gives `Room U λ⁺`. -/
theorem Room.succ {lam : Cardinal.{u}} (hU : Room U lam) : Room U (Order.succ lam) :=
  ⟨hU.1, lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.isStrongPrelimit hU.2)⟩

/-- AUX: not in paper. Fact 1.0.18 applied to `(K^sat, ≼^NF ↾ K^sat)` (an AEC in `λ⁺` by
Prop 10.1.8), as in the proof of Thm 10.1.9. -/
theorem Frame.up_facts [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    IsAEC (s.upKSys lam) ∧ (s.upKSys lam).Kc (Order.succ lam) = s.Ksat lam ∧
      (∀ M ∈ s.Ksat lam, ∀ N ∈ s.Ksat lam, ((s.upKSys lam).le M N ↔ (s.satKSys lam).le M N)) ∧
      (s.upKSys lam).LST = Order.succ lam :=
  C.fact_1_0_18 (Order.succ lam) hU.succ (s.satKSys lam) (prop_10_1_8 lam hU s hs hinf).2.1 hne

/-- AUX: not in paper. An embedding of `(K^sat, ≼^NF)` between models of `K^sat` is an embedding of
`(K^sat)^up`, and conversely. -/
theorem Frame.emb_up_iff [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) {f : U → U} {M N : Model U L} (hM : M ∈ s.Ksat lam) (hN : N ∈ s.Ksat lam) :
    IsEmb (s.upKSys lam) f M N ↔ IsEmb (s.satKSys lam) f M N := by
  obtain ⟨hA, hK, hle, -⟩ := Frame.up_facts hU hs hinf ⟨M, hM⟩
  have mem : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).K := fun X hX => by
    rw [← hK] at hX; exact hX.1
  have hc : s.Core lam := hs.1.1
  constructor
  · rintro ⟨-, -, M', hM'N, iso⟩
    have kM' : M' ∈ s.Ksat lam := by
      rw [← hK]; exact ⟨hA.mem_left hM'N, by rw [iso.card_eq]; exact hM.1.2⟩
    exact ⟨hM, hN, M', (hle M' kM' N hN).1 hM'N, iso⟩
  · rintro ⟨-, -, M', hM'N, iso⟩
    exact ⟨mem M hM, mem N hN, M', (hle M' hM'N.1 N hN).2 hM'N, iso⟩

-- AGENT-CHOICE (reading): the hypothesis "a ∈ M₁ - M₀" (with `a` not otherwise mentioned) is read
-- as "a₁ ∈ M₁ - M₀".
-- PROOF-STAGE CHANGE: added `M₀, M₁, M₂ ∈ K^sat`; Def 10.1.3 defines `tp⁺(a, M₀, M₁)` only for
-- `M₀, M₁ ∈ K^sat` (outside `(K^sat)^up` the `E`-class of a triple is a singleton, and `⇐` fails).
-- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 10.1.8.
/-- Prop 10.1.4: for `M₀ ≼^NF M₁`, `M₀ ≼^NF M₂`, `a₁ ∈ M₁ - M₀`, `a₂ ∈ M₂ - M₀`:
`tp⁺(a₁, M₀, M₁) = tp⁺(a₂, M₀, M₂) ↔ tp(a₁, M₀, M₁) = tp(a₂, M₀, M₂)`. -/
theorem prop_10_1_4 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam)
    (M₀ M₁ M₂ : Model U L) (k₀ : M₀ ∈ s.Ksat lam) (k₁ : M₁ ∈ s.Ksat lam) (k₂ : M₂ ∈ s.Ksat lam)
    (h01 : s.leNF lam M₀ M₁) (h02 : s.leNF lam M₀ M₂) (a₁ a₂ : U)
    (ha₁ : a₁ ∈ M₁.carrier \ M₀.carrier) (ha₂ : a₂ ∈ M₂.carrier \ M₀.carrier) :
    s.tpPlus lam a₁ M₀ M₁ = s.tpPlus lam a₂ M₀ M₂ ↔ tp s.S lam a₁ M₀ M₁ = tp s.S lam a₂ M₀ M₂ := by
  classical
  have hs7 : Hyp_7_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf ⟨M₀, k₀⟩
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  constructor
  · intro h
    have hAP : AP (s.upKSys lam) (Order.succ lam) := by
      intro N₀ kN₀ N₁ kN₁ N₂ kN₂ l1 l2
      rw [hK] at kN₀ kN₁ kN₂
      obtain ⟨f₁, f₂, N₃, ⟨e1, e2, o1, o2⟩, kN₃⟩ := thm_7_1_18_c lam hU s hs7 N₀ ⟨kN₀, kN₀.1.2⟩ N₁ ⟨kN₁, kN₁.1.2⟩ N₂ ⟨kN₂, kN₂.1.2⟩
        ((hle _ kN₀ _ kN₁).1 l1) ((hle _ kN₀ _ kN₂).1 l2)
      have kN₃' : N₃ ∈ s.Ksat lam := kN₃.1
      exact ⟨f₁, f₂, N₃, ⟨(Frame.emb_up_iff hU hs hinf kN₁ kN₃').2 e1,
        (Frame.emb_up_iff hU hs hinf kN₂ kN₃').2 e2, o1, o2⟩, kc N₃ kN₃'⟩
    obtain ⟨N₂, kN₂, l2, f, hf, hov, hfa⟩ := tp_eq_small hA hU.succ hAP hL.le
      (hinf.trans (Order.le_succ lam))
      (M := M₀) (N := M₁) (N' := M₂) (a := a₁) (a' := a₂)
      ⟨kc M₀ k₀, kc M₁ k₁, (hle _ k₀ _ k₁).2 ⟨k₀, k₁, h01⟩, ha₁.1⟩
      ⟨kc M₀ k₀, kc M₂ k₂, (hle _ k₀ _ k₂).2 ⟨k₀, k₂, h02⟩, ha₂.1⟩ h
    rw [hK] at kN₂
    have hf' := (Frame.emb_up_iff hU hs hinf k₁ kN₂).1 hf
    obtain ⟨-, -, M', lM', iso⟩ := hf'
    refine tp_eq_iff.2 (Relation.EqvGen.rel _ _ ⟨⟨k₀.1.1, k₁.1.1, h01.2.2.1, ha₁.1⟩,
      ⟨k₀.1.1, k₂.1.1, h02.2.2.1, ha₂.1⟩, rfl, N₂, kN₂.1.1, ((hle _ k₂ _ kN₂).1 l2).2.2.2.2.1, f,
      ⟨k₁.1.1, kN₂.1.1, M', lM'.2.2.2.2.1, iso⟩, hov, hfa⟩)
  · intro h
    obtain ⟨P₁, hP₁⟩ := prop_7_1_12_a lam hU s hs7 hinf M₁ k₁.1
    obtain ⟨P₂, hP₂⟩ := prop_7_1_12_a lam hU s hs7 hinf M₂ k₂.1
    have q₁ := prop_7_1_10_c lam hU s hs7 _ _ _ h01 hP₁
    have q₂ := prop_7_1_10_c lam hU s hs7 _ _ _ h02 hP₂
    have n₁ := (prop_7_1_10_a lam hU s hs7 _ _ hP₁).1
    have n₂ := (prop_7_1_10_a lam hU s hs7 _ _ hP₂).1
    have kP₁ := prop_7_1_10_b lam hU s hs7 _ _ hP₁
    have kP₂ := prop_7_1_10_b lam hU s hs7 _ _ hP₂
    have hE : ERel s.S lam (M₀, M₁, a₁) (M₀, M₂, a₂) := tp_eq_iff.1 h
    obtain ⟨g, hg, hgo, hga⟩ := thm_7_1_13_b lam hU s hs7 M₀ P₁ P₂ q₁ q₂ a₁ a₂
      (hS.sub n₁.2.2.1 ha₁.1) (hS.sub n₂.2.2.1 ha₂.1) (fun N kN lN => by
        have hr := ERel.restrict hS hE N lN
        have e1 : tp s.S lam a₁ N M₁ = tp s.S lam a₂ N M₂ := tp_eq_iff.2 hr
        rw [← tp_eq_of_le hS ⟨kN.1, kP₁.1.1, hS.trans (hS.trans lN h01.2.2.1) n₁.2.2.1,
            hS.sub n₁.2.2.1 ha₁.1⟩ n₁.2.2.1 (hS.trans lN h01.2.2.1) ha₁.1,
          ← tp_eq_of_le hS ⟨kN.1, kP₂.1.1, hS.trans (hS.trans lN h02.2.2.1) n₂.2.2.1,
            hS.sub n₂.2.2.1 ha₂.1⟩ n₂.2.2.1 (hS.trans lN h02.2.2.1) ha₂.1]
        exact e1)
    -- `g[M₁] ≼^NF P₂`
    obtain ⟨-, Q, iQ, lQ⟩ := Frame.leNF_iso hU (hs7 : Hyp_6_1_1 s lam) M₁ P₁ P₂ g kP₁.1 n₁ hg
    have kQ : Q ∈ s.Ksat lam := Saturated.iso hU hc hinf k₁ iQ
    have hemb : IsEmb (s.upKSys lam) g M₁ P₂ :=
      (Frame.emb_up_iff hU hs hinf k₁ kP₂).2 ⟨k₁, kP₂, Q, ⟨kQ, kP₂, lQ⟩, iQ⟩
    refine tp_eq_iff.2 (Relation.EqvGen.rel _ _ ⟨⟨(kc M₀ k₀).1, (kc M₁ k₁).1,
      (hle _ k₀ _ k₁).2 ⟨k₀, k₁, h01⟩, ha₁.1⟩, ⟨(kc M₀ k₀).1, (kc M₂ k₂).1,
      (hle _ k₀ _ k₂).2 ⟨k₀, k₂, h02⟩, ha₂.1⟩, rfl, P₂, (kc P₂ kP₂).1,
      (hle _ k₂ _ kP₂).2 ⟨k₂, kP₂, n₂⟩, g, hemb, ⟨fun x hx => ⟨hS.sub h01.2.2.1 hx,
        hS.sub (hS.trans h02.2.2.1 n₂.2.2.1) hx⟩, fun x hx => hgo.2 x hx⟩, hga⟩)

/-- AUX: not in paper. The direction `⇒` of Prop 10.1.4, for any `a, a'` (not only outside `M`). -/
theorem Frame.tp_of_tpPlus [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) {M N N' : Model U L} {a a' : U} (k₀ : M ∈ s.Ksat lam) (k₁ : N ∈ s.Ksat lam)
    (k₂ : N' ∈ s.Ksat lam) (h01 : s.leNF lam M N) (h02 : s.leNF lam M N')
    (h : s.tpPlus lam a M N = s.tpPlus lam a' M N') : tp s.S lam a M N = tp s.S lam a' M N' := by
  classical
  have hs7 : Hyp_7_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf ⟨M, k₀⟩
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  have hE : ERel (s.upKSys lam) (Order.succ lam) (M, N, a) (M, N', a') := tp_eq_iff.1 h
  by_cases ha : a ∈ N.carrier
  swap
  · have e := ERel.eq_of_not_K3 hE (fun hk => ha hk.2.2.2)
    simp only [Prod.mk.injEq] at e
    obtain ⟨-, rfl, rfl⟩ := e
    rfl
  have hK3 : (M, N, a) ∈ (s.upKSys lam).K3 :=
    ⟨(kc M k₀).1, (kc N k₁).1, (hle _ k₀ _ k₁).2 ⟨k₀, k₁, h01⟩, ha⟩
  have ha' : a' ∈ N'.carrier := ((ERel.K3_iff hE).1 hK3).2.2.2
  have hAP : AP (s.upKSys lam) (Order.succ lam) := by
    intro N₀ kN₀ N₁ kN₁ N₂ kN₂ l1 l2
    rw [hK] at kN₀ kN₁ kN₂
    obtain ⟨f₁, f₂, N₃, ⟨e1, e2, o1, o2⟩, kN₃⟩ := thm_7_1_18_c lam hU s hs7 N₀ ⟨kN₀, kN₀.1.2⟩
      N₁ ⟨kN₁, kN₁.1.2⟩ N₂ ⟨kN₂, kN₂.1.2⟩ ((hle _ kN₀ _ kN₁).1 l1) ((hle _ kN₀ _ kN₂).1 l2)
    have kN₃' : N₃ ∈ s.Ksat lam := kN₃.1
    exact ⟨f₁, f₂, N₃, ⟨(Frame.emb_up_iff hU hs hinf kN₁ kN₃').2 e1,
      (Frame.emb_up_iff hU hs hinf kN₂ kN₃').2 e2, o1, o2⟩, kc N₃ kN₃'⟩
  obtain ⟨N₂, kN₂, l2, f, hf, hov, hfa⟩ := tp_eq_small hA hU.succ hAP hL.le
    (hinf.trans (Order.le_succ lam)) (M := M) (N := N) (N' := N') (a := a) (a' := a')
    ⟨kc M k₀, kc N k₁, (hle _ k₀ _ k₁).2 ⟨k₀, k₁, h01⟩, ha⟩
    ⟨kc M k₀, kc N' k₂, (hle _ k₀ _ k₂).2 ⟨k₀, k₂, h02⟩, ha'⟩ h
  rw [hK] at kN₂
  obtain ⟨-, -, M', lM', iso⟩ := (Frame.emb_up_iff hU hs hinf k₁ kN₂).1 hf
  exact tp_eq_iff.2 (Relation.EqvGen.rel _ _ ⟨⟨k₀.1.1, k₁.1.1, h01.2.2.1, ha⟩,
    ⟨k₀.1.1, k₂.1.1, h02.2.2.1, ha'⟩, rfl, N₂, kN₂.1.1, ((hle _ k₂ _ kN₂).1 l2).2.2.2.2.1, f,
    ⟨k₁.1.1, kN₂.1.1, M', lM'.2.2.2.2.1, iso⟩, hov, hfa⟩)

-- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 10.1.8.
/-- Prop 10.1.7(a): `S^{bs,+}` is well-defined: it does not depend on the representing triple. -/
theorem prop_10_1_7_a [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_10_1_2 s lam) (hinf : ℵ₀ ≤ lam) (M N N' : Model U L) (a a' : U) (hM : M ∈ s.Ksat lam)
    (hN : N ∈ s.Ksat lam) (hN' : N' ∈ s.Ksat lam) (h : s.leNF lam M N) (h' : s.leNF lam M N')
    (heq : s.tpPlus lam a M N = s.tpPlus lam a' M N') :
    tp s.S lam a M N ∈ s.SbsGt lam M ↔ tp s.S lam a' M N' ∈ s.SbsGt lam M := by
  rw [Frame.tp_of_tpPlus hU hs hinf hM hN hN' h h' heq]

-- PROOF-STAGE CHANGE: added `M₂, M₂' ∈ K^sat` (Def 10.1.6(2) has `M₂ ∈ K^sat`: the representing
-- triples of `tp⁺` are in `K^sat`; with a representative outside `K^sat` the right side fails) and
-- `ℵ₀ ≤ λ`, as in Prop 10.1.8.
/-- Prop 10.1.7(b): `⨿⁺` is well-defined: it does not depend on the representing triple. -/
theorem prop_10_1_7_b [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_10_1_2 s lam) (hinf : ℵ₀ ≤ lam) (M₀ M₁ M₂ M₂' : Model U L) (a a' : U)
    (k₂ : M₂ ∈ s.Ksat lam) (k₂' : M₂' ∈ s.Ksat lam)
    (heq : s.tpPlus lam a M₁ M₂ = s.tpPlus lam a' M₁ M₂') :
    s.nfPlus lam M₀ M₁ a M₂ ↔ s.nfPlus lam M₀ M₁ a' M₂' := by
  classical
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf ⟨M₂, k₂⟩
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  have key : ∀ {N N' : Model U L} {b b' : U}, N ∈ s.Ksat lam → N' ∈ s.Ksat lam →
      s.tpPlus lam b M₁ N = s.tpPlus lam b' M₁ N' →
      s.nfPlus lam M₀ M₁ b N → s.nfPlus lam M₀ M₁ b' N' := by
    intro N N' b b' kN kN' he hn
    obtain ⟨k0, k1, -, l01, l12, hnf⟩ := hn
    obtain ⟨-, -, -, ⟨X, c, hKX, hpX⟩, -⟩ := id hnf
    have hKb : (M₁, N, b) ∈ s.S.K3 := (ERel.K3_iff (tp_eq_iff.1 hpX)).2 hKX
    have hE : ERel (s.upKSys lam) (Order.succ lam) (M₁, N, b) (M₁, N', b') := tp_eq_iff.1 he
    have hK3 : (M₁, N, b) ∈ (s.upKSys lam).K3 :=
      ⟨(kc M₁ k1).1, (kc N kN).1, (hle _ k1 _ kN).2 ⟨k1, kN, l12⟩, hKb.2.2.2⟩
    have hK3' := (ERel.K3_iff hE).1 hK3
    have l12' : s.leNF lam M₁ N' := ((hle _ k1 _ kN').1 hK3'.2.2.1).2.2
    refine ⟨k0, k1, kN', l01, l12', ?_⟩
    rw [← Frame.tp_of_tpPlus hU hs hinf k1 kN kN' l12 l12' he]
    exact hnf
  exact ⟨key k₂ k₂' heq, key k₂' k₂ heq.symm⟩


/-- AUX: not in paper. A type that does not fork (Def 2.6.2) is realized outside its domain. -/
theorem Frame.mem_of_notForkGe {s : Frame U L} {lam : Cardinal.{u}} {X M N : Model U L} {a : U}
    (h : s.NotForkGe lam X M (tp s.S lam a M N)) : (M, N, a) ∈ s.S.K3 ∧ a ∉ M.carrier := by
  obtain ⟨-, -, -, ⟨Y, c, hK, hpc⟩, M₂, b, hmem, hge⟩ := h
  have hE1 : ERel s.S lam (M, N, a) (M, Y, c) := tp_eq_iff.1 hpc
  have hE2 : ERel s.S lam (M, N, a) (M, M₂, b) := hmem
  refine ⟨(ERel.K3_iff hE1).2 hK, fun ha => ?_⟩
  have e : b = a := (ERel.alg hE2).1 ha
  exact hge.2.2.2.2.2.1.2 (e ▸ ha)

/-- AUX: not in paper. A representative in `K^sat` for a triple of `(K^sat)^up` over `M ∈ K^sat`
(LST for `(K^sat)^up`, Fact 1.0.18(4)). -/
theorem Frame.up_small [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) {M N : Model U L} {a : U} (hM : M ∈ s.Ksat lam)
    (hK3 : (M, N, a) ∈ (s.upKSys lam).K3) :
    ∃ N₀ ∈ s.Ksat lam, (s.upKSys lam).le N₀ N ∧ s.leNF lam M N₀ ∧ a ∈ N₀.carrier ∧
      s.tpPlus lam a M N = s.tpPlus lam a M N₀ := by
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf ⟨M, hM⟩
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hLS : (s.upKSys lam).HasLST (Order.succ lam) := by
    have := KSys.hasLST_LST hA.lst; rwa [hL] at this
  have hsub : M.carrier ∪ {a} ⊆ N.carrier :=
    Set.union_subset (hA.sub hK3.2.2.1) (Set.singleton_subset_iff.2 hK3.2.2.2)
  obtain ⟨W, kW, hAW, lW, hcW⟩ := hLS N hK3.2.1 _ hsub
  have hcM : M.card = Order.succ lam := hM.1.2
  have hcard : W.card = Order.succ lam := by
    refine le_antisymm (hcW.trans (Cardinal.add_le_of_le hinf₁ le_rfl ?_)) ?_
    · refine (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf₁ (le_of_eq hcM) ?_)
      rw [Cardinal.mk_singleton]; exact Cardinal.one_le_aleph0.trans hinf₁
    · rw [← hcM]; exact Model.card_le_of_sub (Set.subset_union_left.trans hAW)
  have kWs : W ∈ s.Ksat lam := by rw [← hK]; exact ⟨kW, hcard⟩
  have lMW : (s.upKSys lam).le M W := hA.le_of_sub hK3.2.2.1 lW (Set.subset_union_left.trans hAW)
  have haW : a ∈ W.carrier := hAW (Or.inr rfl)
  refine ⟨W, kWs, lW, ((hle _ hM _ kWs).1 lMW).2.2, haW, ?_⟩
  exact (tp_eq_of_le hA hK3 lW lMW haW).symm

/-- AUX: not in paper. `s⁺` lives in `(K^sat)^up`; models of `K_{λ⁺}` of it are those of `K^sat`. -/
theorem Frame.splus_Kc [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    (s.splus lam).S.Kc (Order.succ lam) = s.Ksat lam :=
  (Frame.up_facts hU hs hinf hne).2.1

/-- AUX: not in paper. The axioms (0)–(2) of Def 2.1.1 for `s⁺` (first part of Thm 10.1.9). -/
theorem Frame.splus_ax012 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    (s.splus lam).Ax0a ∧ (s.splus lam).Ax0b (Order.succ lam) ∧ (s.splus lam).Ax1a (Order.succ lam) ∧
      (s.splus lam).Ax1b (Order.succ lam) ∧ (s.splus lam).Ax1c (Order.succ lam) ∧
      (s.splus lam).Ax2a (Order.succ lam) ∧ (s.splus lam).Ax2c (Order.succ lam) := by
  classical
  have hs7 : Hyp_7_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  refine ⟨hA, hL.le, ?_, ?_, ?_, ?_, ?_⟩
  · intro M₁ kM₁ M₂ kM₂
    have k₁ := kc' M₁ kM₁
    have k₂ := kc' M₂ kM₂
    obtain ⟨f, hf⟩ := C.thm_1_0_32_2 lam hU s.S hS hc.ax1b hc.ax0b M₁ M₂ k₁ k₂ hc.ax1a
    have r₂ : s.leNF lam M₂ M₂ := Frame.leNF_refl hU (hs7 : Hyp_6_1_1 s lam) hinf k₂.1
    exact ⟨f, id, M₂, kM₂, (Frame.emb_up_iff hU hs hinf k₁ k₂).2 ⟨k₁, k₂, M₂, ⟨k₂, k₂, r₂⟩, hf⟩,
      (Frame.emb_up_iff hU hs hinf k₂ k₂).2 ⟨k₂, k₂, M₂, ⟨k₂, k₂, r₂⟩, IsoOn.refl M₂⟩⟩
  · intro N₀ kN₀ N₁ kN₁ N₂ kN₂ l1 l2
    have k0 := kc' N₀ kN₀
    have k1 := kc' N₁ kN₁
    have k2 := kc' N₂ kN₂
    obtain ⟨f₁, f₂, N₃, ⟨e1, e2, o1, o2⟩, kN₃⟩ := thm_7_1_18_c lam hU s hs7 N₀ ⟨k0, k0.1.2⟩
      N₁ ⟨k1, k1.1.2⟩ N₂ ⟨k2, k2.1.2⟩ ((hle _ k0 _ k1).1 l1) ((hle _ k0 _ k2).1 l2)
    have kN₃' : N₃ ∈ s.Ksat lam := kN₃.1
    exact ⟨f₁, f₂, N₃, ⟨(Frame.emb_up_iff hU hs hinf k1 kN₃').2 e1,
      (Frame.emb_up_iff hU hs hinf k2 kN₃').2 e2, o1, o2⟩, kc N₃ kN₃'⟩
  · intro M kM hmax
    have k := kc' M kM
    obtain ⟨P, hP⟩ := prop_7_1_12_a lam hU s hs7 hinf M k.1
    have kP := prop_7_1_10_b lam hU s hs7 _ _ hP
    have hn := prop_7_1_10_a lam hU s hs7 _ _ hP
    exact hmax.2 ⟨P, kc P kP, ⟨kM, kc P kP, (hle _ k _ kP).2 ⟨k, kP, hn.1⟩⟩, hn.2⟩
  · intro M kM p hp
    obtain ⟨-, N, a, kN, lN, hgt, rfl⟩ := hp
    obtain ⟨-, -, X, kX, lX, hnf⟩ := hgt
    obtain ⟨hK3, haM⟩ := Frame.mem_of_notForkGe hnf
    have k := kc' M kM
    refine ⟨N, a, ⟨(hle _ k _ kN).2 ⟨k, kN, lN⟩, fun e => haM (e ▸ hK3.2.2.2)⟩, kc N kN,
      ⟨hK3.2.2.2, haM⟩, rfl⟩
  · intro M kM N kN hlt
    have k := kc' M kM
    have kN' := kc' N kN
    have lMN := (hle _ k _ kN').1 hlt.1
    have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
    obtain ⟨a, ha, hp⟩ := thm_2_6_8_1 lam hU s hsg hs.1.2.2.2.2 hinf M N ⟨lMN.2.2.2.2.1, hlt.2⟩
      ⟨k.1.1, by rw [k.1.2]; exact Order.le_succ lam⟩
    refine ⟨a, ha, k, N, a, kN', lMN.2.2, ?_, rfl⟩
    rcases hp with ⟨hc', -⟩ | ⟨-, hp⟩
    · exact absurd hc' (by rw [k.1.2]; exact (Order.lt_succ_of_not_isMax (not_isMax lam)).ne')
    · exact hp

/-- AUX: not in paper. A witness in `K_λ` for non-forking (Def 2.6.2). -/
theorem Frame.notForkGe_wit {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M₀ M₁ : Model U L} {p : Set (Tri U L)} (h : s.NotForkGe lam M₀ M₁ p) :
    ∃ N₀ ∈ s.S.Kc lam, s.S.le N₀ M₀ ∧ s.NotForkGe lam N₀ M₁ p := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h₀, h₁, h01, hpS, M₂, a, hmem, hge⟩ := id h
  obtain ⟨-, -, -, -, h12, ha, N₀, kN₀, lN₀, huniv⟩ := id hge
  exact ⟨N₀, kN₀, lN₀, ⟨kN₀.1, kN₀.2.ge⟩, h₁, hS.trans lN₀ h01, hpS, M₂, a, hmem, kN₀.2.ge,
    hge.2.1, hge.2.2.1, hS.trans lN₀ h01, h12, ha, N₀, kN₀, hS.refl kN₀.1, huniv⟩

/-- AUX: not in paper. Non-forking (Def 2.6.2) is preserved by a permutation of `U`. -/
theorem Frame.notForkGe_perm {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (σ : Equiv.Perm U) {M₀ M₁ M₂ : Model U L} {a : U}
    (h : s.NotForkGe lam M₀ M₁ (tp s.S lam a M₁ M₂)) :
    s.NotForkGe lam (permModel σ M₀) (permModel σ M₁)
      (tp s.S lam (σ a) (permModel σ M₁) (permModel σ M₂)) := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have iP := permModel_iso (L := L) σ
  have iQ := permModel_iso (L := L) σ.symm
  obtain ⟨hK3, haM⟩ := Frame.mem_of_notForkGe h
  obtain ⟨h₀, h₁, h01, hpS, -⟩ := id h
  have hge := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b M₀ M₁ h₀ h₁ h01 _ hpS).1 h
    M₂ a (mem_tp_self _ _ _ _ _)
  obtain ⟨c0, c1, c2, -, l12, ha, N₀, kN₀, lN₀, hu⟩ := hge
  have card : ∀ X : Model U L, (permModel σ X).card = X.card := fun X => (iP X).card_eq
  have kK : ∀ X : Model U L, X ∈ s.S.K → permModel σ X ∈ s.S.K := fun X hX => hS.iso_mem hX (iP X)
  have back : ∀ {X Y : Model U L}, Y.carrier ⊆ (permModel σ X).carrier →
      (permModel σ.symm Y).carrier ⊆ X.carrier := fun {X Y} h y hy => by
    rw [(iQ Y).carrier_eq] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    have hz' := h hz
    rw [(iP X).carrier_eq] at hz'
    obtain ⟨w, hw, rfl⟩ := hz'
    simpa using hw
  have hK3' : (permModel σ M₁, permModel σ M₂, σ a) ∈ s.S.K3 :=
    ⟨kK _ hK3.1, kK _ hK3.2.1, hS.iso_le hK3.2.2.1 (iP _) (iP _), (iP _).mapsTo hK3.2.2.2⟩
  have hnot : σ a ∉ (permModel σ M₁).carrier := fun hin => by
    rw [(iP M₁).carrier_eq] at hin
    obtain ⟨w, hw, he⟩ := hin
    exact haM (σ.injective he ▸ hw)
  refine ⟨⟨kK _ h₀.1, by rw [card]; exact h₀.2⟩, ⟨kK _ h₁.1, by rw [card]; exact h₁.2⟩,
    hS.iso_le h01 (iP _) (iP _), ⟨_, _, hK3', rfl⟩, permModel σ M₂, σ a, mem_tp_self _ _ _ _ _,
    by rw [card]; exact c0, by rw [card]; exact c1, by rw [card]; exact c2,
    hS.iso_le h01 (iP _) (iP _), hS.iso_le l12 (iP _) (iP _), ⟨(iP _).mapsTo ha.1, hnot⟩,
    permModel σ N₀, ⟨kK _ kN₀.1, by rw [card]; exact kN₀.2⟩, hS.iso_le lN₀ (iP _) (iP _),
    fun N kN hsN lN N' kN' hsN' lN' => ?_⟩
  have e1 : permModel σ (permModel σ.symm N) = N := permModel_symm' σ N
  have e2 : permModel σ (permModel σ.symm N') = N' := permModel_symm' σ N'
  have eM₁ : permModel σ.symm (permModel σ M₁) = M₁ := permModel_symm σ M₁
  have eM₂ : permModel σ.symm (permModel σ M₂) = M₂ := permModel_symm σ M₂
  have eN₀ : permModel σ.symm (permModel σ N₀) = N₀ := permModel_symm σ N₀
  have kQ : ∀ {X : Model U L}, X ∈ s.S.Kc lam → permModel σ.symm X ∈ s.S.Kc lam := fun hX =>
    ⟨hS.iso_mem hX.1 (iQ _), by rw [(iQ _).card_eq]; exact hX.2⟩
  have l1 : s.S.le (permModel σ.symm N) M₁ := by
    have := hS.iso_le lN (iQ _) (iQ _); rwa [eM₁] at this
  have l2 : s.S.le (permModel σ.symm N') M₂ := by
    have := hS.iso_le lN' (iQ _) (iQ _); rwa [eM₂] at this
  have s1 : N₀.carrier ⊆ (permModel σ.symm N).carrier := fun x hx => by
    have : σ x ∈ N.carrier := hsN ((iP N₀).mapsTo hx)
    have := (iQ N).mapsTo this
    simpa using this
  have s2 : (permModel σ.symm N).carrier ∪ {a} ⊆ (permModel σ.symm N').carrier := by
    intro x hx
    rcases hx with hx | hx
    · rw [(iQ N).carrier_eq] at hx
      obtain ⟨z, hz, rfl⟩ := hx
      exact (iQ N').mapsTo (hsN' (Or.inl hz))
    · rw [hx]
      have := (iQ N').mapsTo (hsN' (Or.inr rfl))
      simpa using this
  have n := hu _ (kQ kN) s1 l1 _ (kQ kN') s2 l2
  have n' := hc.ax3a.2 _ _ _ _ _ _ a σ n (iP _) (iP _) (iP _)
  rwa [e1, e2] at n'

/-- AUX: not in paper. Non-forking (Def 2.6.2) is preserved by isomorphisms of models of size
`< #U`. -/
theorem Frame.notForkGe_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {f : U → U} {M₀ M₁ M₂ M₀' M₁' M₂' : Model U L} {a : U}
    (h : s.NotForkGe lam M₀ M₁ (tp s.S lam a M₁ M₂)) (hsm : #M₂.carrier < #U)
    (i₂ : IsoOn f M₂ M₂') (i₀ : IsoOn f M₀ M₀') (i₁ : IsoOn f M₁ M₁') :
    s.NotForkGe lam M₀' M₁' (tp s.S lam (f a) M₁' M₂') := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hK3, -⟩ := Frame.mem_of_notForkGe h
  obtain ⟨-, -, l01, -⟩ := id h
  obtain ⟨σ, hσ⟩ := exists_perm_ext hU.infinite i₂.injOn hsm
  have s1 : M₁.carrier ⊆ M₂.carrier := hS.sub hK3.2.2.1
  have s0 : M₀.carrier ⊆ M₂.carrier := (hS.sub l01).trans s1
  have e2 : permModel σ M₂ = M₂' := permModel_eq (i₂.congr fun x hx => (hσ x hx).symm)
  have e1 : permModel σ M₁ = M₁' := permModel_eq (i₁.congr fun x hx => (hσ x (s1 hx)).symm)
  have e0 : permModel σ M₀ = M₀' := permModel_eq (i₀.congr fun x hx => (hσ x (s0 hx)).symm)
  have := Frame.notForkGe_perm hU hc σ h
  rwa [e0, e1, e2, hσ a hK3.2.2.2] at this

/-- AUX: not in paper. `S^bs_{>λ}` is preserved by isomorphisms of models of size `< #U`. -/
theorem Frame.sbsGt_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {f : U → U} {M N M' N' : Model U L} {a : U} (h : tp s.S lam a M N ∈ s.SbsGt lam M)
    (hK3 : (M, N, a) ∈ s.S.K3) (hsm : #N.carrier < #U) (iN : IsoOn f N N') (iM : IsoOn f M M') :
    tp s.S lam (f a) M' N' ∈ s.SbsGt lam M' := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hgt, -, N₀, kN₀, lN₀, hnf⟩ := h
  have s0 : N₀.carrier ⊆ N.carrier := (hS.sub lN₀).trans (hS.sub hK3.2.2.1)
  obtain ⟨N₀', iN₀⟩ := exists_isoOn (iN.injOn.mono s0)
  refine ⟨⟨hS.iso_mem hgt.1 iM, by rw [iM.card_eq]; exact hgt.2⟩,
    ⟨N', f a, ⟨hS.iso_mem hgt.1 iM, hS.iso_mem hK3.2.1 iN, hS.iso_le hK3.2.2.1 iN iM,
      iN.mapsTo hK3.2.2.2⟩, rfl⟩, N₀', ⟨hS.iso_mem kN₀.1 iN₀, by rw [iN₀.card_eq]; exact kN₀.2⟩,
    hS.iso_le lN₀ iM iN₀, Frame.notForkGe_iso hU hc hnf hsm iN iN₀ iM⟩

/-- AUX: not in paper. Two models of `K^sat` below a model of `(K^sat)^up` are below a common one in
`K^sat`. -/
theorem Frame.up_common [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) {X Y Z : Model U L} (hX : X ∈ s.Ksat lam) (hY : Y ∈ s.Ksat lam)
    (lX : (s.upKSys lam).le X Z) (lY : (s.upKSys lam).le Y Z) :
    ∃ W ∈ s.Ksat lam, (s.upKSys lam).le W Z ∧ (s.upKSys lam).le X W ∧ (s.upKSys lam).le Y W := by
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf ⟨X, hX⟩
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hLS : (s.upKSys lam).HasLST (Order.succ lam) := by
    have := KSys.hasLST_LST hA.lst; rwa [hL] at this
  obtain ⟨W, kW, hAW, lW, hcW⟩ := hLS Z (hA.mem_right lX) _ (Set.union_subset (hA.sub lX) (hA.sub lY))
  have hcX : X.card = Order.succ lam := hX.1.2
  have hcard : W.card = Order.succ lam := by
    refine le_antisymm (hcW.trans (Cardinal.add_le_of_le hinf₁ le_rfl ?_)) ?_
    · exact (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf₁ (le_of_eq hcX)
        (le_of_eq hY.1.2))
    · rw [← hcX]; exact Model.card_le_of_sub (Set.subset_union_left.trans hAW)
  have kWs : W ∈ s.Ksat lam := by rw [← hK]; exact ⟨kW, hcard⟩
  exact ⟨W, kWs, lW, hA.le_of_sub lX lW (Set.subset_union_left.trans hAW),
    hA.le_of_sub lY lW (Set.subset_union_right.trans hAW)⟩

/-- AUX: not in paper. Basic types of `s⁺` from non-forking (Def 2.6.2) in `K^sat`. -/
theorem Frame.sbsPlus_of_nf {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    (hsg : s.IsSemiGoodExceptLC lam) (hU : Room U lam) {M₀ M₁ M₂ : Model U L} {a : U}
    (k₀ : M₀ ∈ s.Ksat lam) (k₁ : M₁ ∈ s.Ksat lam) (k₂ : M₂ ∈ s.Ksat lam) (l01 : s.leNF lam M₀ M₁)
    (l12 : s.leNF lam M₁ M₂) (l02 : s.leNF lam M₀ M₂) (h : s.NotForkGe lam M₀ M₁ (tp s.S lam a M₁ M₂)) :
    s.tpPlus lam a M₀ M₂ ∈ s.SbsPlus lam M₀ ∧ s.tpPlus lam a M₁ M₂ ∈ s.SbsPlus lam M₁ := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hK3, -⟩ := Frame.mem_of_notForkGe h
  obtain ⟨N₀, kN₀, lN₀, hN⟩ := Frame.notForkGe_wit hc h
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kG : ∀ X : Model U L, X ∈ s.Ksat lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1.1, (hgt X hX).le⟩
  have l01' := l01.2.2.1
  have l12' := l12.2.2.1
  have h2 := thm_2_6_8_2 lam hU s hsg N₀ M₀ M₁ lN₀ l01' ⟨kN₀.1, kN₀.2.ge⟩ (kG M₀ k₀) (kG M₁ k₁)
    (hgt M₁ k₁) _ (Frame.sbsGe_of_notForkGe hc h) hN
  rw [res_tp hS l01'] at h2
  refine ⟨⟨k₀, M₂, a, k₂, l02, ⟨⟨k₀.1.1, hgt M₀ k₀⟩,
    ⟨M₂, a, ⟨k₀.1.1, k₂.1.1, hS.trans l01' l12', hK3.2.2.2⟩, rfl⟩, N₀, kN₀, lN₀, h2.2⟩, rfl⟩,
    ⟨k₁, M₂, a, k₂, l12, ⟨⟨k₁.1.1, hgt M₁ k₁⟩, ⟨M₂, a, hK3, rfl⟩, N₀, kN₀, hS.trans lN₀ l01', hN⟩, rfl⟩⟩

/-- AUX: not in paper. Axioms (2)(b), (3)(a), (3)(b), (3)(c) of Def 2.1.1 for `s⁺` (part of the proof
of Thm 10.1.9: (2)(b), (3)(a) are invariance, (3)(b) monotonicity, (3)(c) local character, by
Thm 2.6.8(2),(4)). -/
theorem Frame.splus_ax23 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    (s.splus lam).Ax2b (Order.succ lam) ∧ (s.splus lam).Ax3a (Order.succ lam) ∧
      (s.splus lam).Ax3b (Order.succ lam) ∧ (s.splus lam).Ax3c (Order.succ lam) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  have hsm : ∀ X : Model U L, X ∈ s.Ksat lam → #X.carrier < #U := fun X hX => by
    have e : #X.carrier = Order.succ lam := hX.1.2
    rw [e]; exact hU.succ.2
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kG : ∀ X : Model U L, X ∈ s.Ksat lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1.1, (hgt X hX).le⟩
  have isoK : ∀ {f : U → U} {X Y : Model U L}, X ∈ s.Ksat lam → IsoOn f X Y → Y ∈ s.Ksat lam :=
    fun hX hf => Saturated.iso hU hc hinf hX hf
  have isoNF : ∀ {f : U → U} {X Y X' Y' : Model U L}, s.leNF lam X Y → IsoOn f Y Y' →
      IsoOn f X X' → s.leNF lam X' Y' := fun {f X Y X' Y'} h iY iX => by
    obtain ⟨-, X'', iX'', l⟩ := Frame.leNF_iso hU hs6 X Y Y' f h.2.1 h iY
    rwa [iX''.unique iX] at l
  refine ⟨?_, ⟨?_, ?_⟩, ?_, ?_⟩
  -- (2)(b)
  · intro M N N' M' a f kM hp iN iM
    have k := kc' M kM
    obtain ⟨-, N₁, b, kN₁, lN₁, hgtb, e⟩ := hp
    obtain ⟨-, -, Nb, kNb, lNb, hnfb⟩ := id hgtb
    obtain ⟨hK3b, -⟩ := Frame.mem_of_notForkGe hnfb
    have hK3b' : (M, N₁, b) ∈ (s.upKSys lam).K3 :=
      ⟨(kc M k).1, (kc N₁ kN₁).1, (hle _ k _ kN₁).2 ⟨k, kN₁, lN₁⟩, hK3b.2.2.2⟩
    have hK3 : (M, N, a) ∈ (s.upKSys lam).K3 := (ERel.K3_iff (tp_eq_iff.1 e)).2 hK3b'
    obtain ⟨N₀, kN₀, lN₀N, lMN₀, haN₀, e₀⟩ := Frame.up_small hU hs hinf k hK3
    have htp := Frame.tp_of_tpPlus hU hs hinf k kN₀ kN₁ lMN₀ lN₁ (e₀.symm.trans e)
    have hsb : tp s.S lam a M N₀ ∈ s.SbsGt lam M := htp ▸ hgtb
    obtain ⟨N₀', iN₀⟩ := exists_isoOn (iN.injOn.mono (hA.sub lN₀N))
    have kM' := isoK k iM
    have kN₀' := isoK kN₀ iN₀
    have lMN₀' : s.leNF lam M' N₀' := isoNF lMN₀ iN₀ iM
    have hK3₀ : (M, N₀, a) ∈ s.S.K3 := ⟨k.1.1, kN₀.1.1, lMN₀.2.2.1, haN₀⟩
    have hsb' := Frame.sbsGt_iso hU hc hsb hK3₀ (hsm N₀ kN₀) iN₀ iM
    have lN₀N' : (s.upKSys lam).le N₀' N' := hA.iso_le lN₀N iN iN₀
    have lM'N₀' : (s.upKSys lam).le M' N₀' := (hle _ kM' _ kN₀').2 ⟨kM', kN₀', lMN₀'⟩
    have hK3' : (M', N', f a) ∈ (s.upKSys lam).K3 :=
      ⟨(kc M' kM').1, hA.iso_mem hK3.2.1 iN, hA.trans lM'N₀' lN₀N', iN.mapsTo hK3.2.2.2⟩
    refine ⟨kM', N₀', f a, kN₀', lMN₀', hsb', ?_⟩
    exact (tp_eq_of_le hA hK3' lN₀N' lM'N₀' (iN₀.mapsTo haN₀)).symm
  -- (3)(a), first part
  · intro M₀ M₁ a M₃ h
    obtain ⟨k0, k1, k3, l01, l13, hnf⟩ := h
    obtain ⟨hK3, haM⟩ := Frame.mem_of_notForkGe hnf
    have l03 := Frame.leNF_trans hU hs6 l01 l13
    have hb := Frame.sbsPlus_of_nf hc hsg hU k0 k1 k3 l01 l13 l03 hnf
    exact ⟨kc M₀ k0, kc M₁ k1, kc M₃ k3, ⟨hK3.2.2.2, haM⟩, (hle _ k0 _ k1).2 ⟨k0, k1, l01⟩,
      (hle _ k1 _ k3).2 ⟨k1, k3, l13⟩, hb.1, hb.2⟩
  -- (3)(a), invariance
  · intro M₀ M₁ M₃ M₀' M₁' M₃' a f h i3 i0 i1
    obtain ⟨k0, k1, k3, l01, l13, hnf⟩ := h
    exact ⟨isoK k0 i0, isoK k1 i1, isoK k3 i3, isoNF l01 i1 i0, isoNF l13 i3 i1,
      Frame.notForkGe_iso hU hc hnf (hsm M₃ k3) i3 i0 i1⟩
  -- (3)(b)
  · intro M₀ M₀s M₁s M₁ M₃ M₃s M₃ss a l1 l2 l3 l4 l5 hsub l6 kss h
    obtain ⟨k0, k1, k3, l01, l13, hnf⟩ := h
    have kss' := kc' _ kss
    have card_mid : ∀ X, (s.upKSys lam).le M₀ X → (s.upKSys lam).le X M₁ → X ∈ s.Ksat lam := by
      intro X hX1 hX2
      refine kc' X ⟨hA.mem_right hX1, le_antisymm ?_ ?_⟩
      · rw [← k1.1.2]; exact Model.card_le_of_sub (hA.sub hX2)
      · rw [← k0.1.2]; exact Model.card_le_of_sub (hA.sub hX1)
    have k0s := card_mid M₀s l1 (hA.trans l2 l3)
    have k1s := card_mid M₁s (hA.trans l1 l2) l3
    have l1s3 : (s.upKSys lam).le M₁s M₃ss :=
      hA.le_of_sub (hA.trans (hA.trans l3 l4) l5) l6 (Set.subset_union_left.trans hsub)
    have n0s1s : s.leNF lam M₀s M₁s := ((hle _ k0s _ k1s).1 l2).2.2
    have n1s3 : s.leNF lam M₁s M₃ss := ((hle _ k1s _ kss').1 l1s3).2.2
    refine ⟨k0s, k1s, kss', n0s1s, n1s3, ?_⟩
    have n00s := ((hle _ k0 _ k0s).1 l1).2.2
    have n0s1 := ((hle _ k0s _ k1).1 (hA.trans l2 l3)).2.2
    have n1s1 := ((hle _ k1s _ k1).1 l3).2.2
    have hpGe := Frame.sbsGe_of_notForkGe hc hnf
    have st1 := (thm_2_6_8_2 lam hU s hsg M₀ M₀s M₁ n00s.2.2.1 n0s1.2.2.1 (kG M₀ k0) (kG M₀s k0s)
      (kG M₁ k1) (hgt M₁ k1) _ hpGe hnf).1
    have st2 := (thm_2_6_8_2 lam hU s hsg M₀s M₁s M₁ n0s1s.2.2.1 n1s1.2.2.1 (kG M₀s k0s)
      (kG M₁s k1s) (kG M₁ k1) (hgt M₁ k1) _ hpGe st1).2
    rw [res_tp hS n1s1.2.2.1] at st2
    -- move the top model from `M₃` to `M₃ss` through a common model of `K^sat`
    obtain ⟨W, kW, lW, l3W, lssW⟩ := Frame.up_common hU hs hinf k3 kss' l5 l6
    have n3W := ((hle _ k3 _ kW).1 l3W).2.2.2.2.1
    have nssW := ((hle _ kss' _ kW).1 lssW).2.2.2.2.1
    have ha3 : a ∈ M₃.carrier := (Frame.mem_of_notForkGe hnf).1.2.2.2
    have l1s3' : s.S.le M₁s M₃ := hS.trans n1s1.2.2.1 l13.2.2.1
    have e1 : tp s.S lam a M₁s M₃ = tp s.S lam a M₁s W :=
      tp_eq_of_le hS ⟨k1s.1.1, kW.1.1, hS.trans l1s3' n3W, hS.sub n3W ha3⟩ n3W l1s3' ha3
    have e2 : tp s.S lam a M₁s M₃ss = tp s.S lam a M₁s W :=
      tp_eq_of_le hS ⟨k1s.1.1, kW.1.1, hS.trans n1s3.2.2.1 nssW, hS.sub n3W ha3⟩ nssW
        n1s3.2.2.1 (hsub (Or.inr rfl))
    rw [e2, ← e1]; exact st2
  -- (3)(c)
  · intro δ hδ hδκ M hM a hp
    have kM : ∀ i ≤ δ + 1, M i ∈ s.Ksat lam := fun i hi => kc' _ (hM.2.2 i (Set.mem_Iic.2 hi))
    have hδ1 : δ ≤ δ + 1 := Order.le_succ δ
    have nM : ∀ i ≤ δ + 1, ∀ j ≤ δ + 1, i < j → s.leNF lam (M i) (M j) := fun i hi j hj h =>
      ((hle _ (kM i hi) _ (kM j hj)).1 (hM.1 i (Set.mem_Iic.2 hi) j (Set.mem_Iic.2 hj) h)).2.2
    obtain ⟨-, N, b, kN, lN, hgtb, e⟩ := hp
    have nδ := nM δ hδ1 _ le_rfl (Order.lt_add_one_iff.2 le_rfl)
    have htp := Frame.tp_of_tpPlus hU hs hinf (kM δ hδ1) (kM _ le_rfl) kN nδ lN e
    have hch : IsIncCont s.S M (Iic δ) (s.S.KGt lam) :=
      ⟨fun i hi j hj h => (nM i (Set.mem_Iic.1 hi |>.trans hδ1) j (Set.mem_Iic.1 hj |>.trans hδ1) h).2.2.1,
        fun β hβ hl => hM.2.1 β (Set.mem_Iic.2 ((Set.mem_Iic.1 hβ).trans hδ1)) hl,
        fun i hi => ⟨(kM i ((Set.mem_Iic.1 hi).trans hδ1)).1.1,
          hgt _ (kM i ((Set.mem_Iic.1 hi).trans hδ1))⟩⟩
    obtain ⟨α, hα, hn⟩ := thm_2_6_8_4 lam hU s hsg δ hδ (Or.inl hs.1.2.2.2.2) M hch _ (htp ▸ hgtb)
    have hαδ : α ≤ δ + 1 := hα.le.trans hδ1
    exact ⟨α, hα, a, M (δ + 1), rfl, kM α hαδ, kM δ hδ1, kM _ le_rfl, nM α hαδ δ hδ1 hα, nδ, hn⟩

/-- AUX: not in paper. Axiom (3)(g) of Def 2.1.1 (continuity) for `s⁺`, by Thm 2.6.8(5). -/
theorem Frame.splus_ax3g [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) : (s.splus lam).Ax3g (Order.succ lam) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  intro δ hδ hδκ M hM p hp hnf
  have h0δ : (0 : Ordinal.{u}) < δ := hδ.bot_lt
  have kM : ∀ i ≤ δ, M i ∈ s.Ksat lam := fun i hi => kc' _ (hM.2.2 i (Set.mem_Iic.2 hi))
  have nM : ∀ i ≤ δ, ∀ j ≤ δ, i < j → s.leNF lam (M i) (M j) := fun i hi j hj h =>
    ((hle _ (kM i hi) _ (kM j hj)).1 (hM.1 i (Set.mem_Iic.2 hi) j (Set.mem_Iic.2 hj) h)).2.2
  obtain ⟨N, c, hK3, rfl⟩ := hp
  obtain ⟨N₀, kN₀, lN₀N, lδN₀, hcN₀, e₀⟩ := Frame.up_small hU hs hinf (kM δ le_rfl) hK3
  have e₀' : tp (s.splus lam).S (Order.succ lam) c (M δ) N =
      tp (s.splus lam).S (Order.succ lam) c (M δ) N₀ := e₀
  rw [e₀'] at hnf ⊢
  have hα : ∀ α < δ, s.NotForkGe lam (M 0) (M α) (tp s.S lam c (M α) N₀) := by
    intro α hαδ
    have lαδ := nM α hαδ.le δ le_rfl hαδ
    have lαN₀ : s.leNF lam (M α) N₀ := Frame.leNF_trans hU hs6 lαδ lδN₀
    have hupα : (s.upKSys lam).le (M α) (M δ) := hM.1 α (Set.mem_Iic.2 hαδ.le) δ
      (Set.mem_Iic.2 le_rfl) hαδ
    have hupδ : (s.upKSys lam).le (M δ) N₀ :=
      (hle _ (kM δ le_rfl) _ kN₀).2 ⟨kM δ le_rfl, kN₀, lδN₀⟩
    have hres := res_tp (lam := Order.succ lam) (a := c) (N := N₀) hA hupα
    obtain ⟨b, N', he, hnp⟩ := hnf α hαδ
    have he' : s.tpPlus lam c (M α) N₀ = s.tpPlus lam b (M α) N' := hres.symm.trans he
    obtain ⟨-, -, kN', -, lαN', hng⟩ := hnp
    rw [Frame.tp_of_tpPlus hU hs hinf (kM α hαδ.le) kN₀ kN' lαN₀ lαN' he']
    exact hng
  have hcδ : c ∉ (M δ).carrier := by
    intro hin
    rw [hM.2.1 δ (Set.mem_Iic.2 le_rfl) hδ] at hin
    obtain ⟨α, hαδ, hin'⟩ := Set.mem_iUnion₂.1 hin
    exact (Frame.mem_of_notForkGe (hα α hαδ)).2 hin'
  let M' : Ordinal.{u} → Model U L := fun i => if i ≤ δ then M i else N₀
  have M1 : ∀ i ≤ δ, M' i = M i := fun i hi => by simp [M', hi]
  have M2 : M' (δ + 1) = N₀ := by simp [M']
  have hch : IsIncCont s.S M' (Iic (δ + 1)) (s.S.KGe lam) := by
    refine ⟨fun i hi j hj h => ?_, fun β hβ hl => ?_, fun i hi => ?_⟩
    · have hi' : i ≤ δ := Order.lt_add_one_iff.1 (lt_of_lt_of_le h hj)
      rw [M1 i hi']
      rcases (show j ≤ δ + 1 from hj).lt_or_eq with h' | h'
      · rw [M1 j (Order.lt_add_one_iff.1 h')]
        exact (nM i hi' j (Order.lt_add_one_iff.1 h') h).2.2.1
      · rw [h', M2]
        rcases hi'.lt_or_eq with h'' | h''
        · exact hS.trans (nM i hi' δ le_rfl h'').2.2.1 lδN₀.2.2.1
        · rw [h'']; exact lδN₀.2.2.1
    · have hβδ : β ≤ δ := by
        rcases (show β ≤ δ + 1 from hβ).lt_or_eq with h' | h'
        · exact Order.lt_add_one_iff.1 h'
        · exact absurd (h' ▸ hl) fun hl' => lt_irrefl _ (hl'.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
      show (M' β).carrier = _
      rw [M1 β hβδ, hM.2.1 β (Set.mem_Iic.2 hβδ) hl]
      exact Set.iUnion₂_congr fun ζ hζ => by rw [M1 ζ (le_of_lt (lt_of_lt_of_le hζ hβδ))]
    · rcases (show i ≤ δ + 1 from hi).lt_or_eq with h' | h'
      · rw [M1 i (Order.lt_add_one_iff.1 h')]
        exact ⟨(kM i (Order.lt_add_one_iff.1 h')).1.1, (hgt _ (kM i (Order.lt_add_one_iff.1 h'))).le⟩
      · rw [h', M2]; exact ⟨kN₀.1.1, (hgt _ kN₀).le⟩
  have h5 := thm_2_6_8_5 lam hU s hsg δ hδ M' hch c (by rw [M2, M1 δ le_rfl]; exact ⟨hcN₀, hcδ⟩)
    (fun α hαδ => by rw [M1 0 h0δ.le, M1 α hαδ.le, M2]; exact hα α hαδ)
  rw [M1 0 h0δ.le, M1 δ le_rfl, M2] at h5
  have l0δ := nM 0 h0δ.le δ le_rfl h0δ
  refine ⟨(Frame.sbsPlus_of_nf hc hsg hU (kM 0 h0δ.le) (kM δ le_rfl) kN₀ l0δ lδN₀
    (Frame.leNF_trans hU hs6 l0δ lδN₀) h5).2, c, N₀, rfl,
    kM 0 h0δ.le, kM δ le_rfl, kN₀, l0δ, lδN₀, h5⟩


/-- AUX: not in paper. A set of size `≤ λ` inside the union of an increasing chain of length `λ⁺` is
inside one member. -/
theorem chain_cover {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {A : Ordinal.{u} → Model U L} {M : Model U L} (Ai : IsIncreasing S.le A (Iio (Order.succ lam).ord))
    (hM : IsUnionOf A (Iio (Order.succ lam).ord) M) {X : Set U} (hX : X ⊆ M.carrier) (hc : #X ≤ lam) :
    ∃ α < (Order.succ lam).ord, X ⊆ (A α).carrier := by
  classical
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hex : ∀ x : X, ∃ ζ < (Order.succ lam).ord, x.1 ∈ (A ζ).carrier := fun x => by
    have hx := (Set.ext_iff.1 hM.1 x.1).1 (hX x.2)
    obtain ⟨ζ, hζ, h'⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨ζ, hζ, h'⟩
  choose f hf hfR using hex
  have hsup : iSup f < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
    (by rw [hreg.cof_ord]; exact Order.lt_succ_iff.2 hc) hf
  refine ⟨iSup f, hsup, fun x hx => ?_⟩
  have hle : f ⟨x, hx⟩ ≤ iSup f := Ordinal.le_iSup f ⟨x, hx⟩
  rcases hle.lt_or_eq with h' | h'
  · exact hS.sub (Ai _ (hf ⟨x, hx⟩) _ hsup h') (hfR ⟨x, hx⟩)
  · rw [← h']; exact hfR ⟨x, hx⟩

/-- AUX: not in paper. `NF^` respects `s` on the other side: if `NF^(N₀, N₁, M₀, M₁)` and
`tp(a, N₀, N₁) ∈ S^bs(N₀)`, then `tp(a, M₀, M₁)` does not fork over `N₀` (Def 2.6.2). The proof of
Prop 10.1.13(1) applies Thm 5.15(e) (= Thm 6.1.3(e)) in this form, which is not the stated one. -/
theorem Frame.nfhat_dual [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_6_1_1 s lam)
    {N₀ N₁ M₀ M₁ : Model U L} {a : U} (h : s.NFhat lam N₀ N₁ M₀ M₁)
    (hb : tp s.S lam a N₀ N₁ ∈ s.Sbs N₀) : s.NotForkGe lam N₀ M₀ (tp s.S lam a M₀ M₁) := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hd := thm_6_1_3_a lam hU s hs N₀ N₁ M₀ M₁ h
  obtain ⟨k0, k1, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have h0κ := hκl.bot_lt
  obtain ⟨-, hleA⟩ := hS.le_union hκl Ai Ac hMA
  obtain ⟨-, hleB⟩ := hS.le_union hκl Bi Bc hMB
  have hAB : ∀ α < (Order.succ lam).ord, s.S.le (A α) (B α) := fun α hα => (hst α hα).2.2.2.2.1
  have lM : s.S.le M₀ M₁ := hS.smooth _ hκl A M₁ Ai Ac (fun α hα => hS.trans (hAB α hα) (hleB α hα))
    M₀ hMA kM₀.1
  obtain ⟨N', a', hlt, hN', ha', heq⟩ := hc.ax2a N₀ k0 hb
  have hK : (N₀, N₁, a) ∈ s.S.K3 :=
    (ERel.K3_iff (tp_eq_iff.1 heq)).2 ⟨k0.1, hN'.1, hlt.1, ha'.1⟩
  have haN₀ : a ∉ N₀.carrier := by
    intro hin
    have e : a' = a := (ERel.alg (tp_eq_iff.1 heq)).1 hin
    exact ha'.2 (e ▸ hin)
  have l0M : s.S.le N₀ M₀ := hA0 ▸ hleA 0 h0κ
  have l1M : s.S.le N₁ M₁ := hB0 ▸ hleB 0 h0κ
  have haM₁ : a ∈ M₁.carrier := hS.sub l1M hK.2.2.2
  have haM₀ : a ∉ M₀.carrier := fun hin => haN₀ (hd ▸ ⟨hK.2.2.2, hin⟩)
  have gtl : lam ≤ M₀.card := by rw [kM₀.2]; exact Order.le_succ lam
  have gtl1 : lam ≤ M₁.card := by rw [kM₁.2]; exact Order.le_succ lam
  refine ⟨⟨k0.1, k0.2.ge⟩, ⟨kM₀.1, gtl⟩, l0M, ⟨M₁, a, ⟨kM₀.1, kM₁.1, lM, haM₁⟩, rfl⟩, M₁, a,
    mem_tp_self _ _ _ _ _, k0.2.ge, gtl, gtl1, l0M, lM, ⟨haM₁, haM₀⟩, N₀, k0, hS.refl k0.1,
    fun N kN hsN lN N' kN' hsN' lN' => ?_⟩
  obtain ⟨α, hα, hNα⟩ := chain_cover hS hinf Ai hMA (hS.sub lN) (le_of_eq kN.2)
  obtain ⟨β, hβ, hN'β⟩ := chain_cover hS hinf Bi hMB (hS.sub lN') (le_of_eq kN'.2)
  set γ := max α β + 1 with hγ
  have hγκ : γ < (Order.succ lam).ord := hκl.add_one_lt (max_lt hα hβ)
  have hγpos : (0 : Ordinal.{u}) < γ := lt_of_le_of_lt zero_le (Order.lt_add_one_iff.2 le_rfl)
  have hαγ : α < γ := Order.lt_add_one_iff.2 (le_max_left _ _)
  have hβγ : β < γ := Order.lt_add_one_iff.2 (le_max_right _ _)
  have n := Frame.nf_interval hU hs5 Ai Ac Bi Bc hst hγpos hγκ
  rw [hA0, hB0] at n
  have hr := thm_5_4_10 lam hU s hs5 _ _ _ _ a n hb
  have kBγ : B γ ∈ s.S.Kc lam := (hst γ hγκ).2.1
  have nγ := Frame.nf_of_notFork hU hc hr kBγ
  have lAγ : s.S.le N (A γ) := hS.le_of_sub lN (hleA γ hγκ)
    (hNα.trans (hS.sub (Ai α hα γ hγκ hαγ)))
  have l0N : s.S.le N₀ N := hS.le_of_sub l0M lN hsN
  have lN'B : s.S.le N' (B γ) := hS.le_of_sub lN' (hleB γ hγκ)
    (hN'β.trans (hS.sub (Bi β hβ γ hγκ hβγ)))
  exact hc.ax3b N₀ N₀ N (A γ) (B γ) (B γ) N' a (hS.refl k0.1) l0N lAγ (hAB γ hγκ)
    (hS.refl kBγ.1) hsN' lN'B kN' nγ

/-- AUX: not in paper. The construction of Prop 10.1.13(1): over `N ≼ M ∈ K^sat`, `N ∈ K_λ`, a basic
type `p` of `N` has an extension `tp(b, M, M')` with `M ≼^NF M' ∈ K^sat` not forking over `N`. -/
theorem Frame.ext_one [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) {N M : Model U L} (lNM : s.S.le N M) (kM : M ∈ s.Ksat lam)
    (kN : N ∈ s.S.Kc lam) {p : Set (Tri U L)} (hp : p ∈ s.Sbs N) :
    ∃ (b : U) (M' : Model U L), M' ∈ s.Ksat lam ∧ s.leNF lam M M' ∧
      s.NotForkGe lam N M (tp s.S lam b M M') ∧ tp s.S lam b N M' = p := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨N₁', b', hlt, kN₁', hb', rfl⟩ := hc.ax2a N kN hp
  have hsmall : #(M.carrier ∪ N.carrier : Set U) < #U := by
    refine lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le ?_ ?_)
    · rw [show #M.carrier = Order.succ lam from kM.1.2]; exact hU.succ.2
    · rw [show #N.carrier = lam from kN.2]; exact hU.2
  obtain ⟨h, N₁, iN₁, hid, lNN₁, memN₁, hout⟩ :=
    hS.rename hU.infinite M.carrier hlt.1 (IsoOn.refl N) hsmall
  have kN₁ : N₁ ∈ s.S.Kc lam := ⟨memN₁, by rw [iN₁.card_eq]; exact kN₁'.2⟩
  have hd : N₁.carrier ∩ M.carrier = N.carrier := by
    ext x; constructor
    · rintro ⟨hx, hxM⟩
      rw [iN₁.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_contra hn
      have hyN : y ∉ N.carrier := fun hyN => hn (by rw [hid y hyN]; exact hyN)
      exact hout y ⟨hy, hyN⟩ (Or.inl hxM)
    · intro hx; exact ⟨hS.sub lNN₁ hx, hS.sub lNM hx⟩
  have htp : tp s.S lam b' N N₁' = tp s.S lam (h b') N N₁ :=
    tp_emb hS ⟨kN.1, kN₁'.1, hlt.1, hb'.1⟩ lNN₁ ⟨kN₁'.1, memN₁, N₁, hS.refl memN₁, iN₁⟩
      fun x hx => hid x hx
  have hb : tp s.S lam (h b') N N₁ ∈ s.Sbs N := htp ▸ hp
  obtain ⟨M₁', hNF⟩ := thm_6_1_3_c lam hU s hs6 N N₁ M kN kN₁ kM.1 lNN₁ lNM hd
  have nfd := Frame.nfhat_dual hU hs6 hNF hb
  have hK3 := (Frame.mem_of_notForkGe nfd).1
  have l1M : s.S.le N₁ M₁' := by
    obtain ⟨-, -, -, -, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := hNF
    have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
    exact hB0 ▸ (hS.le_union hκl Bi Bc hMB).2 0 hκl.bot_lt
  have nMM₁ : s.leNF lam M M₁' := ⟨kM.1, hNF.2.2.2.1, hK3.2.2.1, N, kN, N₁, kN₁, hNF⟩
  obtain ⟨P, hP⟩ := prop_7_1_12_a lam hU s hs7 hinf M₁' hNF.2.2.2.1
  have kP := prop_7_1_10_b lam hU s hs7 _ _ hP
  have nP := (prop_7_1_10_a lam hU s hs7 _ _ hP).1
  have hbM₁ : h b' ∈ M₁'.carrier := hK3.2.2.2
  refine ⟨h b', P, kP, Frame.leNF_trans hU hs6 nMM₁ nP, ?_, ?_⟩
  · rw [← tp_eq_of_le hS ⟨kM.1.1, kP.1.1, hS.trans hK3.2.2.1 nP.2.2.1, hS.sub nP.2.2.1 hbM₁⟩
      nP.2.2.1 hK3.2.2.1 hbM₁]
    exact nfd
  · rw [htp]
    have lNP : s.S.le N₁ P := hS.trans l1M nP.2.2.1
    exact (tp_eq_of_le hS ⟨kN.1, kP.1.1, hS.trans lNN₁ lNP, hS.sub lNP (iN₁.mapsTo hb'.1)⟩ lNP
      lNN₁ (iN₁.mapsTo hb'.1)).symm

/-- AUX: not in paper. Axioms (3)(d) (uniqueness, Prop 10.1.11) and (3)(f) (extension,
Prop 10.1.13) of Def 2.1.1 for `s⁺`. -/
theorem Frame.splus_ax3df [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    (s.splus lam).Ax3d (Order.succ lam) ∧ (s.splus lam).Ax3f (Order.succ lam) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kG : ∀ X : Model U L, X ∈ s.Ksat lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1.1, (hgt X hX).le⟩
  have kGs : ∀ X : Model U L, X ∈ s.S.Kc lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1, hX.2.ge⟩
  refine ⟨?_, ?_⟩
  -- (3)(d)
  · intro M kM N kN lMN p hp q hq hnp hnq hres
    have k := kc' M kM
    have kN' := kc' N kN
    have nMN : s.leNF lam M N := ((hle _ k _ kN').1 lMN).2.2
    obtain ⟨a, N₁, rfl, k0a, -, k1, -, l1, hfa⟩ := hnp
    obtain ⟨b, N₂, rfl, -, -, k2, -, l2, hfb⟩ := hnq
    have hr1 := res_tp (lam := Order.succ lam) (a := a) (N := N₁) hA lMN
    have hr2 := res_tp (lam := Order.succ lam) (a := b) (N := N₂) hA lMN
    have hE : s.tpPlus lam a M N₁ = s.tpPlus lam b M N₂ := hr1.symm.trans (hres.trans hr2)
    have n1 := Frame.leNF_trans hU hs6 nMN l1
    have n2 := Frame.leNF_trans hU hs6 nMN l2
    have htM := Frame.tp_of_tpPlus hU hs hinf k k1 k2 n1 n2 hE
    obtain ⟨Np, kNp, lNp, hNp⟩ := Frame.notForkGe_wit hc hfa
    obtain ⟨Nq, kNq, lNq, hNq⟩ := Frame.notForkGe_wit hc hfb
    have hsub : Np.carrier ∪ Nq.carrier ⊆ M.carrier :=
      Set.union_subset (hS.sub lNp) (hS.sub lNq)
    obtain ⟨W, kW, hsW, lW⟩ := hS.exists_hull hc.ax0b hinf kNp k.1.1 Set.subset_union_left hsub
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kNp.2) (le_of_eq kNq.2)))
    have lpW : s.S.le Np W := hS.le_of_sub lNp lW (Set.subset_union_left.trans hsW)
    have lqW : s.S.le Nq W := hS.le_of_sub lNq lW (Set.subset_union_right.trans hsW)
    have lWN := hS.trans lW nMN.2.2.1
    have m1 := (thm_2_6_8_2 lam hU s hsg Np W N lpW lWN (kGs Np kNp) (kGs W kW) (kG N kN')
      (hgt N kN') _ (Frame.sbsGe_of_notForkGe hc hNp) hNp).1
    have m2 := (thm_2_6_8_2 lam hU s hsg Nq W N lqW lWN (kGs Nq kNq) (kGs W kW) (kG N kN')
      (hgt N kN') _ (Frame.sbsGe_of_notForkGe hc hNq) hNq).1
    have hW : tp s.S lam a W N₁ = tp s.S lam b W N₂ :=
      tp_eq_iff.2 (ERel.restrict hS (tp_eq_iff.1 htM) W lW)
    have hW' : tp s.S lam a W N₁ = tp s.S lam b W N₂ := hW
    have eN := cor_7_1_17_c lam hU s hs7 N N₁ N₂ kN'.1 k1.1 k2.1 l1 l2 a b
      ⟨W, kW, m1, m2, hW'⟩
    obtain ⟨_, ha⟩ := Frame.mem_of_notForkGe hfa
    obtain ⟨_, hb⟩ := Frame.mem_of_notForkGe hfb
    exact (prop_10_1_4 lam hU s hs hinf N N₁ N₂ kN' k1 k2 l1 l2 a b ⟨(Frame.mem_of_notForkGe hfa).1.2.2.2, ha⟩
      ⟨(Frame.mem_of_notForkGe hfb).1.2.2.2, hb⟩).2 eN
  -- (3)(f)
  · intro M kM N kN p hp hlt
    have k := kc' M kM
    have kN' := kc' N kN
    have nMN : s.leNF lam M N := ((hle _ k _ kN').1 hlt.1).2.2
    obtain ⟨-, M₁, a, k1, l1, hgtp, rfl⟩ := hp
    obtain ⟨-, -, N₀, kN₀, lN₀, hn0⟩ := hgtp
    have hpGe := Frame.sbsGe_of_notForkGe hc hn0
    have h00 := (thm_2_6_8_2 lam hU s hsg N₀ N₀ M (hS.refl kN₀.1) lN₀ (kGs N₀ kN₀) (kGs N₀ kN₀)
      (kG M k) (hgt M k) _ hpGe hn0).2
    rw [res_tp hS lN₀] at h00
    have hb0 : tp s.S lam a N₀ M₁ ∈ s.Sbs N₀ := by
      rcases Frame.sbsGe_of_notForkGe hc h00 with ⟨-, h'⟩ | ⟨hc', -⟩
      · exact h'
      · exact absurd kN₀.2 hc'.ne'
    have lN₀N := hS.trans lN₀ nMN.2.2.1
    obtain ⟨b, M', kM', nNM', hnf, htp⟩ := Frame.ext_one hU hs hinf lN₀N kN' kN₀ hb0
    have hK3b := (Frame.mem_of_notForkGe hnf).1
    have mono := thm_2_6_8_2 lam hU s hsg N₀ M N lN₀ nMN.2.2.1 (kGs N₀ kN₀) (kG M k) (kG N kN')
      (hgt N kN') _ (Frame.sbsGe_of_notForkGe hc hnf) hnf
    refine ⟨s.tpPlus lam b N M', ⟨kN', M', b, kM', nNM', ⟨⟨kN'.1.1, hgt N kN'⟩, ⟨M', b, hK3b, rfl⟩,
      N₀, kN₀, lN₀N, hnf⟩, rfl⟩, ⟨b, M', rfl, k, kN', kM', nMN, nNM', mono.1⟩, ?_⟩
    have hr := res_tp (lam := Order.succ lam) (a := b) (N := M') hA hlt.1
    refine hr.trans ?_
    have nMM' := Frame.leNF_trans hU hs6 nMN nNM'
    have m2 := mono.2
    rw [res_tp hS nMN.2.2.1] at m2
    have eM := cor_7_1_17_c lam hU s hs7 M M' M₁ k.1 kM'.1 k1.1 nMM' l1 b a
      ⟨N₀, kN₀, m2, hn0, by rw [← htp]⟩
    have hbM : b ∉ M.carrier := fun hin => (Frame.mem_of_notForkGe hnf).2 (hS.sub nMN.2.2.1 hin)
    have haM := (Frame.mem_of_notForkGe hn0)
    exact (prop_10_1_4 lam hU s hs hinf M M' M₁ k kM' k1 nMM' l1 b a ⟨hK3b.2.2.2, hbM⟩
      ⟨haM.1.2.2.2, haM.2⟩).2 eM

/-- AUX: not in paper. Basic stability of `s⁺` (Prop 10.1.10). -/
theorem Frame.splus_stab [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) :
    (s.splus lam).BasicStab (Order.succ lam) (Order.succ lam) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl := Cardinal.isSuccLimit_ord hinf₁
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kGs : ∀ X : Model U L, X ∈ s.S.Kc lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1, hX.2.ge⟩
  intro M kM
  have k : M ∈ s.Ksat lam := by rw [← hK]; exact kM
  have kG : M ∈ s.S.KGe lam := ⟨k.1.1, (hgt M k).le⟩
  obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf k.1
  have hRle : ∀ α < (Order.succ lam).ord, s.S.le (R α) M := fun α hα => hR.le hS hinf hα
  -- the data attached to a basic type
  have hdata : ∀ p : (s.SbsPlus lam M), ∃ x : Ordinal.{u} × U × Model U L,
      x.1 < (Order.succ lam).ord ∧ x.2.2 ∈ s.Ksat lam ∧ s.leNF lam M x.2.2 ∧
      s.NotForkGe lam (R x.1) M (tp s.S lam x.2.1 M x.2.2) ∧
      (p : Set (Tri U L)) = s.tpPlus lam x.2.1 M x.2.2 := by
    rintro ⟨p, hp⟩
    obtain ⟨-, N, a, kN, lN, ⟨-, -, N₀, kN₀, lN₀, hn⟩, rfl⟩ := hp
    obtain ⟨α, hα, hsub⟩ := chain_cover hS hinf hR.1 hR.2.2.2 (hS.sub lN₀) (le_of_eq kN₀.2)
    have l0α : s.S.le N₀ (R α) := hS.le_of_sub lN₀ (hRle α hα) hsub
    have hm := (thm_2_6_8_2 lam hU s hsg N₀ (R α) M l0α (hRle α hα) (kGs N₀ kN₀)
      (kGs _ (hR.2.2.1 α hα)) kG (hgt M k) _ (Frame.sbsGe_of_notForkGe hc hn) hn).1
    exact ⟨(α, a, N), hα, kN, lN, hm, rfl⟩
  choose x hxα hxK hxl hxn hxe using hdata
  let E := Ordinal.ToType.mk (o := (Order.succ lam).ord)
  let g : (s.SbsPlus lam M) → {y : (Order.succ lam).ord.ToType × Set (Tri U L) //
      y.2 ∈ s.Sbs (R (E.symm y.1 : Ordinal))} := fun p =>
    ⟨(E ⟨(x p).1, hxα p⟩, tp s.S lam (x p).2.1 (R (x p).1) (x p).2.2), by
      rw [show ((E.symm (E ⟨(x p).1, hxα p⟩) : Ordinal.{u})) = (x p).1 by simp]
      have hn := hxn p
      have h0 := (thm_2_6_8_2 lam hU s hsg _ _ M (hS.refl (hR.2.2.1 _ (hxα p)).1) (hRle _ (hxα p))
        (kGs _ (hR.2.2.1 _ (hxα p))) (kGs _ (hR.2.2.1 _ (hxα p))) kG (hgt M k) _
        (Frame.sbsGe_of_notForkGe hc hn) hn).2
      rw [res_tp hS (hRle _ (hxα p))] at h0
      rcases Frame.sbsGe_of_notForkGe hc h0 with ⟨-, h'⟩ | ⟨hc', -⟩
      · exact h'
      · exact absurd (hR.2.2.1 _ (hxα p)).2 hc'.ne'⟩
  have hg : Function.Injective g := by
    intro p q he
    have h1 := congrArg (fun y => y.1.1) he
    have h2 := congrArg (fun y => y.1.2) he
    simp only [g, EmbeddingLike.apply_eq_iff_eq] at h1 h2
    have eα : (x p).1 = (x q).1 := congrArg Subtype.val h1
    have hKp := (Frame.mem_of_notForkGe (hxn p))
    have hKq := (Frame.mem_of_notForkGe (hxn q))
    have hnq := hxn q
    rw [← eα] at hnq h2
    have eM := cor_7_1_17_c lam hU s hs7 M (x p).2.2 (x q).2.2 k.1 (hxK p).1 (hxK q).1 (hxl p) (hxl q)
      (x p).2.1 (x q).2.1 ⟨R (x p).1, hR.2.2.1 _ (hxα p), hxn p, hnq, h2⟩
    have e := (prop_10_1_4 lam hU s hs hinf M (x p).2.2 (x q).2.2 k (hxK p) (hxK q) (hxl p) (hxl q)
      (x p).2.1 (x q).2.1 ⟨hKp.1.2.2.2, hKp.2⟩ ⟨hKq.1.2.2.2, hKq.2⟩).2 eM
    exact Subtype.ext ((hxe p).trans (e.trans (hxe q).symm))
  have hT : #{y : (Order.succ lam).ord.ToType × Set (Tri U L) //
      y.2 ∈ s.Sbs (R (E.symm y.1 : Ordinal))} ≤ Order.succ lam := by
    rw [Cardinal.mk_congr (Equiv.subtypeProdEquivSigmaSubtype
      (fun (i : (Order.succ lam).ord.ToType) (q : Set (Tri U L)) => q ∈ s.Sbs (R (E.symm i : Ordinal)))),
      Cardinal.mk_sigma]
    refine (Cardinal.sum_le_mk_mul_iSup _).trans ?_
    rw [Cardinal.mk_toType, Cardinal.card_ord]
    refine (mul_le_mul_right (ciSup_le' fun i => hs.1.2.2.2.1 _ (hR.2.2.1 _ (E.symm i).2)) _).trans ?_
    exact le_of_eq (Cardinal.mul_eq_self hinf₁)
  exact (Cardinal.mk_le_of_injective hg).trans hT

/-- AUX: not in paper. `Frame.nfhat_of_club` at a given point `ε₀` of the club. -/
theorem Frame.nfhat_of_club_at [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ M₁ : Model U L}
    (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam)) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) {ε₀ : Ordinal.{u}} (hε₀ : ε₀ ∈ E) (hε₀κ : ε₀ < (Order.succ lam).ord)
    {A B : Ordinal.{u} → Model U L}
    (hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ))
    (Ac : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (A ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (A ε').carrier)
    (Bc : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (B ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (B ε').carrier)
    (AU : M₀.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (A ε).carrier)
    (BU : M₁.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (B ε).carrier)
    (As : ∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (A ε) M₀)
    (Bs : ∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (B ε) M₁) :
    s.NFhat lam (A ε₀) (B ε₀) M₀ M₁ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨e₁, e0, eκ₁, em₁, eE₁, el₁⟩ := exists_club_enum hinf (E := {ε | ε ∈ E ∧ ε₀ < ε})
    (fun ξ hξ => by
      obtain ⟨ε, hε, h1, h2⟩ := hE.1 (max ξ ε₀) (max_lt hξ hε₀κ)
      exact ⟨ε, ⟨hε, lt_of_le_of_lt (le_max_right _ _) h1⟩, lt_of_le_of_lt (le_max_left _ _) h1, h2⟩)
    (fun δ hδ hl H => by
      obtain ⟨ε, ⟨-, hε⟩, -, h2⟩ := H 0 hl.bot_lt
      exact ⟨hE.2 δ hδ hl fun ξ hξ => let ⟨ε', hε', h1', h2'⟩ := H ξ hξ; ⟨ε', hε'.1, h1', h2'⟩,
        hε.trans h2⟩)
  let e : Ordinal.{u} → Ordinal.{u} := fun β => if β = 0 then ε₀ else e₁ β
  have e00 : e 0 = ε₀ := by simp [e]
  have epos : ∀ β, β ≠ 0 → e β = e₁ β := fun β h => by simp [e, h]
  have eκ : ∀ β < (Order.succ lam).ord, e β < (Order.succ lam).ord := fun β hβ => by
    by_cases h : β = 0
    · rw [h, e00]; exact hε₀κ
    · rw [epos β h]; exact eκ₁ β hβ
  have em : ∀ a b, a < b → b < (Order.succ lam).ord → e a < e b := fun a b h hb => by
    have hb0 : b ≠ 0 := (lt_of_le_of_lt zero_le h).ne'
    rw [epos b hb0]
    by_cases ha : a = 0
    · rw [ha, e00]; exact (eE₁ b hb (lt_of_le_of_lt zero_le h)).2
    · rw [epos a ha]; exact em₁ a b h hb
  have eE : ∀ β < (Order.succ lam).ord, e β ∈ E := fun β hβ => by
    by_cases h : β = 0
    · rw [h, e00]; exact hε₀
    · rw [epos β h]; exact (eE₁ β hβ (pos_iff_ne_zero.2 h)).1
  have el : ∀ β < (Order.succ lam).ord, Order.IsSuccLimit β → Order.IsSuccLimit (e β) ∧
      ∀ ξ < e β, ∃ γ < β, ξ < e γ := fun β hβ hl => by
    rw [epos β hl.ne_bot]
    refine ⟨(el₁ β hβ hl).1, fun ξ hξ => ?_⟩
    obtain ⟨γ, hγ, h⟩ := (el₁ β hβ hl).2 ξ hξ
    have hγ0 : γ ≠ 0 := fun h0 => by rw [h0, e0] at h; exact absurd h (not_lt.2 zero_le)
    exact ⟨γ, hγ, by rw [epos γ hγ0]; exact h⟩
  have hid : ∀ β < (Order.succ lam).ord, β ≤ e β := by
    intro β
    induction β using Ordinal.lt_wf.induction with
    | ind β ih =>
    intro hβ
    by_contra hno
    have h1 : e β < β := not_le.1 hno
    exact absurd (em _ _ h1 hβ) (not_lt.2 (ih _ h1 (lt_trans h1 hβ)))
  have hN : ∀ a b, a < b → b < (Order.succ lam).ord →
      s.NF lam (A (e a)) (A (e b)) (B (e a)) (B (e b)) :=
    fun a b h hb => hNF _ (eE a (lt_trans h hb)) _ (eE b hb) (em a b h hb) (eκ b hb)
  have sA : ∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (A ε).carrier ⊆ (A ζ).carrier := by
    intro ε hε ζ hζ h hl
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hNF ε hε ζ hζ h' hl).2.2.2.2.1
    · rw [h']
  have sB : ∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (B ε).carrier ⊆ (B ζ).carrier := by
    intro ε hε ζ hζ h hl
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hNF ε hε ζ hζ h' hl).2.2.2.2.2.2.2.1
    · rw [h']
  have mkC : ∀ X : Ordinal.{u} → Model U L,
      (∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (X ε).carrier ⊆ (X ζ).carrier) →
      (∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (X ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (X ε').carrier) →
      IsContinuous (fun β => X (e β)) (Iio (Order.succ lam).ord) := by
    intro X Xs Xc b hb hl
    have hbκ : b < (Order.succ lam).ord := hb
    obtain ⟨l1, l2⟩ := el b hbκ hl
    show (X (e b)).carrier = _
    rw [Xc _ (eE b hbκ) (eκ b hbκ) l1 (fun ξ hξ => by
      obtain ⟨γ, hγ, h⟩ := l2 ξ hξ
      exact ⟨e γ, eE γ (lt_trans hγ hbκ), h, em γ b hγ hbκ⟩)]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, ⟨hξE, hξ⟩, hx⟩
      obtain ⟨γ, hγ, h⟩ := l2 ξ hξ
      have hγκ := lt_trans hγ hbκ
      exact ⟨γ, hγ, Xs ξ hξE _ (eE γ hγκ) h.le (eκ γ hγκ) hx⟩
    · rintro ⟨γ, hγ, hx⟩
      exact ⟨e γ, ⟨eE γ (lt_trans hγ hbκ), em γ b hγ hbκ⟩, hx⟩
  have mkU : ∀ (X : Ordinal.{u} → Model U L) (T : Model U L),
      (∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (X ε).carrier ⊆ (X ζ).carrier) →
      T.carrier = (⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (X ε).carrier) →
      (∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (X ε) T) →
      IsUnionOf (fun β => X (e β)) (Iio (Order.succ lam).ord) T := by
    intro X T Xs XU Xsub
    refine ⟨?_, fun β hβ => Xsub _ (eE β hβ) (eκ β hβ)⟩
    rw [XU]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, ⟨hξE, hξ⟩, hx⟩
      exact ⟨ξ, hξ, Xs ξ hξE _ (eE ξ hξ) (hid ξ hξ) (eκ ξ hξ) hx⟩
    · rintro ⟨β, hβ, hx⟩
      exact ⟨e β, ⟨eE β hβ, eκ β hβ⟩, hx⟩
  have h01κ : (1 : Ordinal.{u}) < (Order.succ lam).ord := by
    simpa using hκl.add_one_lt hκl.bot_lt
  have h0κ : (0 : Ordinal.{u}) < (Order.succ lam).ord := hκl.bot_lt
  have n01 := hN 0 1 zero_lt_one h01κ
  rw [← e00]
  exact ⟨n01.1, n01.2.2.1, h₀, h₁, fun β => A (e β), fun β => B (e β),
    fun a _ b hb h => (hN a b h hb).2.2.2.2.1, mkC A sA Ac,
    fun a _ b hb h => (hN a b h hb).2.2.2.2.2.2.2.1, mkC B sB Bc,
    fun α hα => Frame.nf_symm hU hs (hN α (α + 1) (Order.lt_add_one_iff.2 le_rfl) (hκl.add_one_lt hα)),
    rfl, rfl, mkU A M₀ sA AU As, mkU B M₁ sB BU Bs⟩

/-- AUX: not in paper. `Frame.nfhat_of_club_filt` at a given point of the club. -/
theorem Frame.nfhat_of_club_filt_at [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ M₁ : Model U L}
    (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam)) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) {ε₀ : Ordinal.{u}} (hε₀ : ε₀ ∈ E) (hε₀κ : ε₀ < (Order.succ lam).ord)
    {A B : Ordinal.{u} → Model U L}
    (hA : IsFilt s.S lam M₀ A) (hB : IsFilt s.S lam M₁ B)
    (hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ)) :
    s.NFhat lam (A ε₀) (B ε₀) M₀ M₁ := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  have mkC : ∀ {T : Model U L} {X : Ordinal.{u} → Model U L}, IsFilt s.S lam T X →
      ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (X ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (X ε').carrier := by
    intro T X hX ε _ hεκ hl hcof
    rw [hX.2.1 ε hεκ hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨ε', h1, h2, h3⟩ := hcof ξ hξ
      exact ⟨ε', ⟨h1, h3⟩, hX.sub hS h2.le (lt_trans h3 hεκ) hx⟩
    · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
      exact ⟨ξ, hξ, hx⟩
  have mkU : ∀ {T : Model U L} {X : Ordinal.{u} → Model U L}, IsFilt s.S lam T X →
      T.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (X ε).carrier := by
    intro T X hX
    rw [hX.2.2.2.1]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨ε', h1, h2, h3⟩ := hE.1 ξ hξ
      exact ⟨ε', ⟨h1, h3⟩, hX.sub hS h2.le h3 hx⟩
    · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
      exact ⟨ξ, hξ, hx⟩
  exact Frame.nfhat_of_club_at hU hs hinf h₀ h₁ hE hε₀ hε₀κ hNF (mkC hA) (mkC hB) (mkU hA) (mkU hB)
    (fun ε _ hε => hA.2.2.2.2 ε hε) (fun ε _ hε => hB.2.2.2.2 ε hε)

/-- AUX: not in paper. Transitivity of `NF^` ("the transitivity of the relation `NF^`", used in the
proof of Prop 10.1.12): `NF^(N₀, N₁, M₀, M₁)` and `NF^(N₁, N₂, M₁, M₂)` give `NF^(N₀, N₂, M₀, M₂)`. -/
theorem Frame.nfhat_trans [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_6_1_1 s lam)
    {N₀ N₁ N₂ M₀ M₁ M₂ : Model U L} (h₁ : s.NFhat lam N₀ N₁ M₀ M₁)
    (h₂ : s.NFhat lam N₁ N₂ M₁ M₂) : s.NFhat lam N₀ N₂ M₀ M₂ := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₁.1
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨-, -, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h₁
  obtain ⟨-, -, -, kM₂, B', C, Bi', Bc', Ci, Cc, hst', hB0', hC0, hMB', hMC⟩ := h₂
  obtain ⟨fA, fB⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst hMA hMB
  obtain ⟨fB', fC⟩ := Frame.nfhat_filt Bi' Bc' Ci Cc hst' hMB' hMC
  obtain ⟨E, hE, hEq⟩ := IsFilt.agree hS hinf fB fB'
  have hE0 : ClubL lam (insert 0 E) :=
    ⟨fun ξ hξ => let ⟨ε, hε, h1, h2⟩ := hE.1 ξ hξ; ⟨ε, Or.inr hε, h1, h2⟩,
      fun δ hδ hl H => Or.inr (hE.2 δ hδ hl fun ξ hξ => by
        obtain ⟨ε, hε, h1, h2⟩ := H (ξ + 1) (hl.add_one_lt hξ)
        rcases hε with rfl | hε
        · exact absurd h1 (not_lt.2 zero_le)
        · exact ⟨ε, hε, lt_trans (Order.lt_add_one_iff.2 le_rfl) h1, h2⟩)⟩
  have hEq0 : ∀ ε ∈ insert 0 E, ε < (Order.succ lam).ord → B ε = B' ε := by
    rintro ε (rfl | hε) hεκ
    · rw [hB0, hB0']
    · exact hEq ε hε hεκ
  have hNF : ∀ ε ∈ insert 0 E, ∀ ζ ∈ insert 0 E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (C ε) (C ζ) := by
    intro ε hε ζ hζ h hζκ
    have n1 := Frame.nf_symm hU hs5 (Frame.nf_interval hU hs5 Ai Ac Bi Bc hst h hζκ)
    have n2 := Frame.nf_symm hU hs5 (Frame.nf_interval hU hs5 Bi' Bc' Ci Cc hst' h hζκ)
    rw [← hEq0 ε hε (lt_trans h hζκ), ← hEq0 ζ hζ hζκ] at n2
    exact Frame.nf_trans2 hU hs5 n1 n2
  have := Frame.nfhat_of_club_filt_at hU hs hinf kM₀ kM₂ hE0 (Set.mem_insert 0 E) hκl.bot_lt fA fC hNF
  rwa [hA0, hC0] at this

/-- AUX: not in paper. `NF^` is preserved by a permutation of `U`. -/
theorem Frame.nfhat_perm {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (σ : Equiv.Perm U) {N₀ N₁ M₀ M₁ : Model U L} (h : s.NFhat lam N₀ N₁ M₀ M₁) :
    s.NFhat lam (permModel σ N₀) (permModel σ N₁) (permModel σ M₀) (permModel σ M₁) := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have iP := permModel_iso (L := L) σ
  obtain ⟨k0, k1, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h
  have tK : ∀ {κ : Cardinal.{u}} {X : Model U L}, X ∈ s.S.Kc κ → permModel σ X ∈ s.S.Kc κ :=
    fun hX => ⟨hS.iso_mem hX.1 (iP _), by rw [(iP _).card_eq]; exact hX.2⟩
  have tI : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing s.S.le X (Iio (Order.succ lam).ord) →
      IsIncreasing s.S.le (fun α => permModel σ (X α)) (Iio (Order.succ lam).ord) :=
    fun hX a ha b hb hab => hS.iso_le (hX a ha b hb hab) (iP _) (iP _)
  have tC : ∀ {X : Ordinal.{u} → Model U L}, IsContinuous X (Iio (Order.succ lam).ord) →
      IsContinuous (fun α => permModel σ (X α)) (Iio (Order.succ lam).ord) := by
    intro X hX β hβ hl
    show (permModel σ (X β)).carrier = _
    rw [(iP _).carrier_eq, hX β hβ hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun a _ => ((iP (X a)).carrier_eq).symm
  have tU : ∀ {X : Ordinal.{u} → Model U L} {N : Model U L},
      IsUnionOf X (Iio (Order.succ lam).ord) N →
      IsUnionOf (fun α => permModel σ (X α)) (Iio (Order.succ lam).ord) (permModel σ N) := by
    intro X N hX
    refine ⟨?_, fun α hα => hX.2 α hα |>.image (iP N) (iP _)⟩
    rw [(iP N).carrier_eq, hX.1, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun a _ => ((iP (X a)).carrier_eq).symm
  exact ⟨tK k0, tK k1, tK kM₀, tK kM₁, fun α => permModel σ (A α), fun α => permModel σ (B α),
    tI Ai, tC Ac, tI Bi, tC Bc,
    fun α hα => Frame.nf_iso hU hc (hst α hα) (iP _) (iP _) (iP _) (iP _),
    by simp only [hA0], by simp only [hB0], tU hMA, tU hMB⟩

/-- AUX: not in paper. In `NF^(N₀, N₁, M₀, M₁)`, `N₀ ≼ M₀` and `N₁ ≼ M₁`. -/
theorem Frame.nfhat_small_le {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {N₀ N₁ M₀ M₁ : Model U L} (h : s.NFhat lam N₀ N₁ M₀ M₁) : s.S.le N₀ M₀ ∧ s.S.le N₁ M₁ := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, -, -, -, A, B, Ai, Ac, Bi, Bc, -, hA0, hB0, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  exact ⟨hA0 ▸ (hS.le_union hκl Ai Ac hMA).2 0 hκl.bot_lt,
    hB0 ▸ (hS.le_union hκl Bi Bc hMB).2 0 hκl.bot_lt⟩

/-- AUX: not in paper. For models of `K_λ`, non-forking of `s` gives non-forking in the sense of
Def 2.6.2. -/
theorem Frame.notForkGe_of_notFork {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {N₀ N M : Model U L} {a : U} (kN₀ : N₀ ∈ s.S.Kc lam) (kN : N ∈ s.S.Kc lam)
    (kM : M ∈ s.S.Kc lam) (h : s.NotFork lam N₀ N (tp s.S lam a N M)) :
    s.NotForkGe lam N₀ N (tp s.S lam a N M) := by
  have hS : IsAEC s.S := hc.ax0a
  have n := Frame.nf_of_notFork hU hc h kM
  have F := hc.ax3a.1 _ _ _ _ n
  obtain ⟨-, -, -, ha, l0, l1, -⟩ := F
  refine ⟨⟨kN₀.1, kN₀.2.ge⟩, ⟨kN.1, kN.2.ge⟩, l0, ⟨M, a, ⟨kN.1, kM.1, l1, ha.1⟩, rfl⟩, M, a,
    mem_tp_self _ _ _ _ _, kN₀.2.ge, kN.2.ge, kM.2.ge, l0, l1, ha, N₀, kN₀, hS.refl kN₀.1,
    fun N' kN' hs' lN' N'' kN'' hs'' lN'' => ?_⟩
  exact hc.ax3b N₀ N₀ N' N M M N'' a (hS.refl kN₀.1) (hS.le_of_sub l0 lN' hs') lN' l1 (hS.refl kM.1)
    hs'' lN'' kN'' n

/-- AUX: not in paper. Axiom (3)(e) (symmetry) of Def 2.1.1 for `s⁺` (Prop 10.1.12), following the
paper's steps (a)–(e), with two repairs (see docs/ERRATA.md): Thm 5.15(e)
is used on the other side (`Frame.nfhat_dual`), and the isomorphism of step (28) is taken over
`M₀ ∪ N₄` (not `M₀ ∪ N₂`), so that it fixes `a₁`. -/
theorem Frame.splus_ax3e [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hinf : ℵ₀ ≤ lam) (hne : (s.Ksat lam).Nonempty) : (s.splus lam).Ax3e (Order.succ lam) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hs5 : Hyp_5_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl := Cardinal.isSuccLimit_ord hinf₁
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hne
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kG : ∀ X : Model U L, X ∈ s.Ksat lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1.1, (hgt X hX).le⟩
  have kGs : ∀ X : Model U L, X ∈ s.S.Kc lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1, hX.2.ge⟩
  have hsmS : ∀ X : Model U L, X ∈ s.Ksat lam → #X.carrier < #U := fun X hX => by
    rw [show #X.carrier = Order.succ lam from hX.1.2]; exact hU.succ.2
  have hsmL : ∀ X : Model U L, X ∈ s.S.Kc lam → #X.carrier < #U := fun X hX => by
    rw [show #X.carrier = lam from hX.2]; exact hU.2
  have isoK : ∀ {f : U → U} {X Y : Model U L}, X ∈ s.Ksat lam → IsoOn f X Y → Y ∈ s.Ksat lam :=
    fun hX hf => Saturated.iso hU hc hinf hX hf
  have isoNF : ∀ {f : U → U} {X Y X' Y' : Model U L}, s.leNF lam X Y → IsoOn f Y Y' →
      IsoOn f X X' → s.leNF lam X' Y' := fun {f X Y X' Y'} h iY iX => by
    obtain ⟨-, X'', iX'', l⟩ := Frame.leNF_iso hU hs6 X Y Y' f h.2.1 h iY
    rwa [iX''.unique iX] at l
  have fixIso : ∀ {f : U → U} {X : Model U L}, (∀ x ∈ X.carrier, f x = x) → IsoOn f X X :=
    fun hf => (IsoOn.refl _).congr fun x hx => (hf x hx).symm
  intro M₀ kM₀ M₁ kM₁ M₃ kM₃ a₁ a₂ u01 u13 ha₁ hb hnf
  have k0 := kc' M₀ kM₀
  have k1 := kc' M₁ kM₁
  have k3 := kc' M₃ kM₃
  have n01 : s.leNF lam M₀ M₁ := ((hle _ k0 _ k1).1 u01).2.2
  have n13 : s.leNF lam M₁ M₃ := ((hle _ k1 _ k3).1 u13).2.2
  have n03 := Frame.leNF_trans hU hs6 n01 n13
  -- (4), (5) in `(K, ≼)`
  obtain ⟨-, Nb, b, kNb, lNb, hgb, eb⟩ := hb
  have hsb : tp s.S lam a₁ M₀ M₃ ∈ s.SbsGt lam M₀ := by
    rw [Frame.tp_of_tpPlus hU hs hinf k0 k3 kNb n03 lNb eb]; exact hgb
  obtain ⟨-, -, W₈, kW₈, lW₈, nf8⟩ := hsb
  obtain ⟨c, N', ec, -, -, kN', -, l1N', ngc⟩ := hnf
  have h5 : s.NotForkGe lam M₀ M₁ (tp s.S lam a₂ M₁ M₃) := by
    rw [Frame.tp_of_tpPlus hU hs hinf k1 k3 kN' n13 l1N' ec]; exact ngc
  obtain ⟨hK5, ha₂M₁⟩ := Frame.mem_of_notForkGe h5
  obtain ⟨W₇, kW₇, lW₇, nf7⟩ := Frame.notForkGe_wit hc h5
  -- step (a): `N₀, N₁, N₃` from filtrations
  obtain ⟨R₀, hR₀⟩ := hS.exists_filt hc.ax0b hinf k0.1
  obtain ⟨R₁, hR₁⟩ := hS.exists_filt hc.ax0b hinf k1.1
  obtain ⟨R₃, hR₃⟩ := hS.exists_filt hc.ax0b hinf k3.1
  obtain ⟨E03, hE03, hN03⟩ := Frame.club_of_leNF hU hs6 n03 hR₀ hR₃
  obtain ⟨E01, hE01, hs01⟩ := IsFilt.club_sub hS hinf hR₀ hR₁ (hS.sub n01.2.2.1)
  obtain ⟨E13, hE13, hs13⟩ := IsFilt.club_sub hS hinf hR₁ hR₃ (hS.sub n13.2.2.1)
  obtain ⟨γ₁, hγ₁, hW⟩ := chain_cover hS hinf hR₀.1 hR₀.2.2.2
    (Set.union_subset (hS.sub lW₇) (hS.sub lW₈))
    ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kW₇.2) (le_of_eq kW₈.2)))
  obtain ⟨γ₂, hγ₂, h1⟩ := chain_cover hS hinf hR₁.1 hR₁.2.2.2 (Set.singleton_subset_iff.2 ha₁)
    (by rw [Cardinal.mk_singleton]; exact Cardinal.one_le_aleph0.trans hinf)
  obtain ⟨γ₃, hγ₃, h3⟩ := chain_cover hS hinf hR₃.1 hR₃.2.2.2
    (Set.singleton_subset_iff.2 hK5.2.2.2)
    (by rw [Cardinal.mk_singleton]; exact Cardinal.one_le_aleph0.trans hinf)
  set γ := max γ₁ (max γ₂ γ₃) with hγ
  have hγκ : γ < (Order.succ lam).ord := max_lt hγ₁ (max_lt hγ₂ hγ₃)
  have hE := ClubL.inter hinf (ClubL.inter hinf (ClubL.gt hinf hγκ) hE03) (ClubL.inter hinf hE01 hE13)
  obtain ⟨ε, hεE, -, hεκ⟩ := hE.1 0 hκl.bot_lt
  have hγε : γ < ε := hεE.2.1.2.1
  have hε01 : ε ∈ E01 := hεE.2.2.2.1
  have hε13 : ε ∈ E13 := hεE.2.2.2.2
  set N₀ := R₀ ε with hN₀d
  set N₁ := R₁ ε with hN₁d
  set N₃ := R₃ ε with hN₃d
  have kN₀ : N₀ ∈ s.S.Kc lam := hR₀.2.2.1 ε hεκ
  have kN₁ : N₁ ∈ s.S.Kc lam := hR₁.2.2.1 ε hεκ
  have kN₃ : N₃ ∈ s.S.Kc lam := hR₃.2.2.1 ε hεκ
  have lN₀M : s.S.le N₀ M₀ := hR₀.le hS hinf hεκ
  have lN₁M : s.S.le N₁ M₁ := hR₁.le hS hinf hεκ
  have lN₃M : s.S.le N₃ M₃ := hR₃.le hS hinf hεκ
  have sub01 : N₀.carrier ⊆ N₁.carrier := hs01 ε hε01 hεκ
  have sub13 : N₁.carrier ⊆ N₃.carrier := hs13 ε hε13 hεκ
  have l01 : s.S.le N₀ N₁ := hS.le_of_sub (hS.trans lN₀M n01.2.2.1) lN₁M sub01
  have l13 : s.S.le N₁ N₃ := hS.le_of_sub (hS.trans lN₁M n13.2.2.1) lN₃M sub13
  have hNF03 : s.NFhat lam N₀ N₃ M₀ M₃ :=
    Frame.nfhat_of_club_filt_at hU hs6 hinf k0.1 k3.1 hE hεE hεκ hR₀ hR₃
      (fun ε' hε' ζ hζ h hζκ => hN03 ε' hε'.2.1.2.2 ζ hζ.2.1.2.2 h hζκ)
  have sW : W₇.carrier ∪ W₈.carrier ⊆ N₀.carrier :=
    hW.trans (hR₀.sub hS ((le_max_left _ _).trans hγε.le) hεκ)
  have lW₇ : s.S.le W₇ N₀ := hS.le_of_sub lW₇ lN₀M (Set.subset_union_left.trans sW)
  have lW₈' : s.S.le W₈ N₀ := hS.le_of_sub lW₈ lN₀M (Set.subset_union_right.trans sW)
  have ha₁N₁ : a₁ ∈ N₁.carrier :=
    hR₁.sub hS (((le_max_left _ _).trans (le_max_right _ _)).trans hγε.le) hεκ (h1 rfl)
  have ha₂N₃ : a₂ ∈ N₃.carrier :=
    hR₃.sub hS (((le_max_right _ _).trans (le_max_right _ _)).trans hγε.le) hεκ (h3 rfl)
  have ha₁N₃ : a₁ ∈ N₃.carrier := sub13 ha₁N₁
  have lN₀M₁ := hS.trans lN₀M n01.2.2.1
  have h7 := (thm_2_6_8_2 lam hU s hsg W₇ N₀ M₁ lW₇ lN₀M₁ (kGs _ kW₇) (kGs _ kN₀) (kG _ k1)
    (hgt _ k1) _ (Frame.sbsGe_of_notForkGe hc nf7) nf7).1
  have h8 := (thm_2_6_8_2 lam hU s hsg W₈ N₀ M₀ lW₈' lN₀M (kGs _ kW₈) (kGs _ kN₀) (kG _ k0)
    (hgt _ k0) _ (Frame.sbsGe_of_notForkGe hc nf8) nf8).1
  -- step (b)
  have h00 := (thm_2_6_8_2 lam hU s hsg N₀ N₀ M₀ (hS.refl kN₀.1) lN₀M (kGs _ kN₀) (kGs _ kN₀)
    (kG _ k0) (hgt _ k0) _ (Frame.sbsGe_of_notForkGe hc h8) h8).2
  rw [res_tp hS lN₀M] at h00
  have hK8 := (Frame.mem_of_notForkGe nf8).1
  have h13 : tp s.S lam a₁ N₀ N₃ ∈ s.Sbs N₀ := by
    rw [tp_eq_of_le hS ⟨kN₀.1, k3.1.1, hS.trans lN₀M n03.2.2.1, hK8.2.2.2⟩ lN₃M
      (hS.trans l01 l13) ha₁N₃]
    rcases Frame.sbsGe_of_notForkGe hc h00 with ⟨-, h'⟩ | ⟨hc', -⟩
    · exact h'
    · exact absurd kN₀.2 hc'.ne'
  have h14 : s.NotFork lam N₀ N₁ (tp s.S lam a₂ N₁ N₃) := by
    obtain ⟨-, -, -, pS, -⟩ := id h7
    have hge := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b N₀ M₁ (kGs _ kN₀) (kG _ k1)
      lN₀M₁ _ pS).1 h7 M₃ a₂ (mem_tp_self _ _ _ _ _)
    obtain ⟨-, -, -, -, -, -, N₀', kN₀', lN₀', hu⟩ := hge
    have n := hu N₁ kN₁ ((hS.sub lN₀').trans sub01) lN₁M N₃ kN₃
      (Set.union_subset sub13 (Set.singleton_subset_iff.2 ha₂N₃)) lN₃M
    exact ⟨a₂, N₃, rfl, Frame.nf_mono hS hc.ax3a hc.ax3b n lN₀' l01 (hS.refl kN₁.1)⟩
  obtain ⟨N₂s, kN₂s, N₄s, kN₄s, ha₂N₂s, l02s, l2s4s, l34s, nf18⟩ :=
    hs.1.2.2.1 N₀ kN₀ N₁ kN₁ N₃ kN₃ a₁ a₂ l01 l13 ha₁N₁ h13 h14
  -- enlarge `N₄*` strictly
  obtain ⟨N₄t, kN₄t, lt4⟩ : ∃ N ∈ s.S.Kc lam, s.S.lt N₄s N := by
    have hnm := hc.ax1c _ kN₄s
    by_contra hcon
    exact hnm ⟨kN₄s, fun ⟨N, hN, hl⟩ => hcon ⟨N, hN, hl.1.2.2, hl.2⟩⟩
  have ha₁N₄s : a₁ ∈ N₄s.carrier := hS.sub l34s ha₁N₃
  have l2s4t := hS.trans l2s4s lt4.1
  have nf18' : s.NotFork lam N₀ N₂s (tp s.S lam a₁ N₂s N₄t) := by
    rw [← tp_eq_of_le hS ⟨kN₂s.1, kN₄t.1, l2s4t, hS.sub lt4.1 ha₁N₄s⟩ lt4.1 l2s4s ha₁N₄s]
    exact nf18
  -- step (c): rename `N₄*` over `N₃`, away from `M₃`
  have hsm3 : #(M₃.carrier ∪ N₃.carrier : Set U) < #U :=
    lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le (hsmS _ k3) (hsmL _ kN₃))
