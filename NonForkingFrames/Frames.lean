  obtain ⟨pr, hpr⟩ := exists_pair_ord hinf
  obtain ⟨en, hen⟩ := Frame.exists_en (s := s) (lam := lam) hs.1.2.2.2.1
  let D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U := fun _ _ => M₀.carrier
  obtain ⟨G, hG⟩ := Frame.exists_plusG hU hs' pr en D
  have hG' : s.IsPlusG lam pr en D G := hG
  have hDs : #M₀.carrier < #U := by
    have e : #M₀.carrier = Order.succ lam := hM.2
    rw [e]
    exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.two_power_lt hU.2)
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c =>
