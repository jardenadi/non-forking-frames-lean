/-- AUX: not in paper. Prop 6.1.6(b), reflexivity. -/
theorem Frame.leNF_refl {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M : Model U L}
