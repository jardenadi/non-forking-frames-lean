    · show s.S.le (xa (r + 1)) N1
      rw [xa2]; exact lN01
    · have hr'r : r' ≤ r := Order.lt_add_one_iff.1 hr'
      refine ⟨fun ε hε => ?_, ?_⟩
      · have hεr : ε ≤ r := hε.trans hr'r
        show s.S.le ((c r').1 ε) (xa ε)
