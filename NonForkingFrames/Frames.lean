      have hcx : c' α = (Mu, Nu) := if_neg (lt_irrefl _)
      refine ⟨fun β hβ => ?_, by rw [hcl 0 h0α]; exact hc0, fun β hβ β' hβ' hl => ?_,
        fun β' hβ' hl => ?_, fun β hβ β' hβ' hl => ?_, fun β' hβ' hl => ?_, fun β hβ => ?_⟩
      · rcases (show β ≤ α from hβ).lt_or_eq with h | h
