  have kM₂ := prop_7_1_10_b lam hU s hs7 _ _ pl02
  have n02 := (prop_7_1_10_a lam hU s hs7 _ _ pl02).1
  have lN₂M₂ := (Frame.nfhat_small_le hc hNF02).2
  have ltN₂M₂ : s.S.lt N₂ M₂ := ⟨lN₂M₂, fun e => by
