  · have : Nonempty (Model U L) := ⟨M₁⟩
    have Rowi : ∀ r < t, IsIncreasing s.S.le (c r).1 (Iic r) := fun r hr => (ih r hr).2.1.1
    have Rowc : ∀ r < t, IsContinuous (c r).1 (Iic r) := fun r hr => (ih r hr).2.1.2
    have RK : ∀ r < t, ∀ ε ≤ r, (c r).1 ε ∈ s.S.Kc lam ∧ s.S.le ((c r).1 ε) M₁ :=
      fun r hr ε hε => (ih r hr).1 ε hε
    have tm : ∀ ε u v, ε ≤ u → u ≤ v → v < t → s.S.le ((c u).1 ε) ((c v).1 ε) := fun ε u v h1 h2 hv => by
      rcases h2.lt_or_eq with h | h
      · exact ((ih v hv).2.2.2.1 u h).1 ε h1
      · rw [h]; exact hS.refl (RK v hv ε (h ▸ h1)).1.1
    have rowle : ∀ m < t, ∀ ζ ≤ m, ∀ ε ≤ m, ζ ≤ ε → s.S.le ((c m).1 ζ) ((c m).1 ε) :=
      fun m hm ζ hζ ε hε h => by
      rcases h.lt_or_eq with h' | h'
      · exact Rowi m hm ζ hζ ε hε h'
      · rw [h']; exact hS.refl (RK m hm ε hε).1.1
    let Bf : Ordinal.{u} → Ordinal.{u} → Model U L := fun ε r => (c (max r ε)).1 ε
    have hmaxt : ∀ r < t, ∀ ε < t, max r ε < t := fun r hr ε hε => max_lt hr hε
    have Bi : ∀ ε < t, IsIncreasing s.S.le (Bf ε) (Iio t) := fun ε hε x hx y hy hxy =>
      tm ε _ _ (le_max_right _ _) (max_le_max hxy.le le_rfl) (hmaxt y hy ε hε)
    have Bc : ∀ ε < t, IsContinuous (Bf ε) (Iio t) := by
      intro ε hε β hβ hl
      have hβ' : β < t := hβ
      rcases le_or_gt β ε with h | h
      · show ((c (max β ε)).1 ε).carrier = _
        ext y
        simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Bf]
        rw [max_eq_right h]
        constructor
        · intro hy; exact ⟨0, hl.bot_lt, by rw [max_eq_right zero_le]; exact hy⟩
        · rintro ⟨α, hα, hy⟩
          rw [max_eq_right (hα.le.trans h)] at hy; exact hy
      · show ((c (max β ε)).1 ε).carrier = _
        rw [max_eq_left h.le]
        exact (((ih β hβ').2.2.2.2.1 hl).1 ε h).1
    have BK : ∀ ε < t, ∀ r < t, Bf ε r ∈ s.S.Kc lam := fun ε hε r hr =>
      (RK _ (hmaxt r hr ε hε) ε (le_max_right _ _)).1
    have hV : ∀ ε, ε < t → ∃ V ∈ s.S.Kc lam, IsUnionOf (Bf ε) (Iio t) V ∧ ∀ β < t, s.S.le (Bf ε β) V :=
      fun ε hε => hS.union_Kc hinf hl ht (Bi ε hε) (Bc ε hε) (BK ε hε)
    choose! V kV uV leV using hV
    have hBle : ∀ ζ ε, ζ ≤ ε → ε < t → ∀ r < t, s.S.le (Bf ζ r) (V ε) := fun ζ ε h hε r hr => by
      have hm := hmaxt r hr ε hε
      have h1 : s.S.le ((c (max r ζ)).1 ζ) ((c (max r ε)).1 ζ) :=
        tm ζ _ _ (le_max_right _ _) (max_le_max le_rfl h) hm
      have h2 : s.S.le ((c (max r ε)).1 ζ) ((c (max r ε)).1 ε) :=
        rowle _ hm _ (h.trans (le_max_right _ _)) _ (le_max_right _ _) h
      exact hS.trans (hS.trans h1 h2) (leV ε hε r hr)
    have Vi : IsIncreasing s.S.le V (Iio t) := fun ζ hζ ε hε h =>
      hS.smooth t hl (Bf ζ) (V ε) (Bi ζ hζ) (Bc ζ hζ) (hBle ζ ε h.le hε) (V ζ) (uV ζ hζ) (kV ζ hζ).1
    have Vc : IsContinuous V (Iio t) := by
      intro δ hδ hlδ
      have hδ' : δ < t := hδ
      ext y
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · intro hy
        rw [(uV δ hδ').1] at hy
        obtain ⟨r, hr, hy⟩ := Set.mem_iUnion₂.1 hy
        have hr' : r < t := hr
        have hm := hmaxt r hr' δ hδ'
        have hy' : y ∈ ((c (max r δ)).1 δ).carrier := hy
        rw [Rowc _ hm δ (Set.mem_Iic.2 (le_max_right _ _)) hlδ] at hy'
        obtain ⟨ζ, hζ, hy'⟩ := Set.mem_iUnion₂.1 hy'
        have hζ' : ζ < δ := hζ
        have hζt := hζ'.trans hδ'
        refine ⟨ζ, hζ', ?_⟩
        have hBm : Bf ζ (max r δ) = (c (max r δ)).1 ζ := by
          simp only [Bf]; rw [max_eq_left (hζ'.le.trans (le_max_right _ _))]
        have := hS.sub (leV ζ hζt _ hm)
        rw [hBm] at this; exact this hy'
      · rintro ⟨ζ, hζ, hy⟩
        exact hS.sub (Vi ζ (lt_trans hζ hδ') δ hδ' hζ) hy
    obtain ⟨xt, kxt, uxt, lext⟩ := hS.union_Kc hinf hl ht Vi Vc kV
    have Ti : IsIncreasing s.S.le (fun r => (c r).2.2) (Iio t) := fun x _ y hy hxy =>
      ((ih y hy).2.2.2.1 x hxy).2
    have Tc : IsContinuous (fun r => (c r).2.2) (Iio t) := fun β hβ hl' =>
      ((ih β hβ).2.2.2.2.1 hl').2.1
    obtain ⟨xT, kxT, uxT, lexT⟩ := hS.union_Kc hinf hl ht Ti Tc fun r hr => (ih r hr).2.2.1.1
    have VM : ∀ ε < t, s.S.le (V ε) M₁ := fun ε hε =>
      hS.smooth t hl (Bf ε) M₁ (Bi ε hε) (Bc ε hε)
        (fun r hr => (RK _ (hmaxt r hr ε hε) ε (le_max_right _ _)).2) (V ε) (uV ε hε) (kV ε hε).1
    have VT : ∀ ε < t, s.S.le (V ε) xT := fun ε hε =>
      hS.smooth t hl (Bf ε) xT (Bi ε hε) (Bc ε hε) (fun r hr => by
        have hm := hmaxt r hr ε hε
        have h1 := rowle _ hm ε (le_max_right _ _) _ le_rfl (le_max_right _ _)
        exact hS.trans (hS.trans h1 (ih _ hm).2.2.1.2.2) (lexT _ hm)) (V ε) (uV ε hε) (kV ε hε).1
    have xtM : s.S.le xt M₁ := hS.smooth t hl V M₁ Vi Vc VM xt uxt kxt.1
    have xtT : s.S.le xt xT := hS.smooth t hl V xT Vi Vc VT xt uxt kxt.1
    have xTM : s.S.le xT M₂ := hS.smooth t hl _ M₂ Ti Tc (fun r hr => (ih r hr).2.2.1.2.1) xT uxT kxT.1
    let xa : Ordinal.{u} → Model U L := fun ε => if ε < t then V ε else xt
    have xa1 : ∀ ε < t, xa ε = V ε := fun ε hε => by simp [xa, hε]
    have xa2 : xa t = xt := by simp [xa]
    refine ⟨(xa, fun _ => xt, xT), fun ε hε => ?_, ⟨fun a' ha' b' hb' hab => ?_, ?_⟩, ⟨kxT, xTM, ?_⟩,
      fun r hr => ⟨fun ε hε => ?_, lexT r hr⟩, fun _ => ⟨fun ε hε => ?_, uxT⟩,
      fun r hr => absurd (hr ▸ hl) (nlim r)⟩
    · show xa ε ∈ _ ∧ s.S.le (xa ε) _
