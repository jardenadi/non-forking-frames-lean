        obtain ⟨kA, kB, l, -⟩ := Frame.run_inv hc hinf hG' hακ.le b ξ (lt1 ξ)
        have kA' := (hAk (ξ + 1) hακ).1
        have hlt := hAlt ξ hξκ (ξ + 1) hακ (lt1 ξ)
        have hsub : (A (ξ + 1)).carrier ⊆ D ξ (fun i => A i) := hS.sub (hAk (ξ + 1) hακ).2
        obtain ⟨-, -, -, -, -, -, g7⟩ := hG' ξ (fun i => A i) (fun i => c i) (A ξ) (A (ξ + 1)) (c ξ)
          hξκ rfl rfl rfl kA kA' kB hlt.1 l hDs hsub d
        refine ⟨(G ξ (fun i => A i) (fun i => c i)).2, fun _ => ?_⟩
