            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
        · show (c' b).2.2.1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).2.2.1.carrier
          rcases (show b ≤ ε from hb).lt_or_eq with h2 | h2
          · rw [hcl b h2]
            have := Cc b h2 hl'
            simp only at this
            rw [this]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h2)]
          · rw [h2, hcx, uC.1]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
        · rcases (show b ≤ ε from hb).lt_or_eq with h2 | h2
          · have hy2 : y ∈ (c b).1.carrier := by
