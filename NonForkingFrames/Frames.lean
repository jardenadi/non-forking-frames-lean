  have hPK : ∀ β ≤ αs, P β ∈ s.S.Kc lam := fun β hβ =>
    ⟨hS.mem_left (hP β hβ).2, by rw [(hP β hβ).1.card_eq]; exact (xK β hβ).2⟩
  have hsteps : ∀ ε < αs, s.NFStar lam (P ε) (P (ε + 1)) ((c ε).1) ((c (ε + 1)).1) := fun ε hε => by
    have h1 := Order.add_one_le_iff.2 hε
    obtain ⟨P', Q', hP', hQ', hS'⟩ := c8 ε h1
    rw [(hP ε hε.le).1.unique hP', (hP (ε + 1) h1).1.unique hQ']
    exact hS'
  have hstar := prop_5_3_8 lam hU s hs αs hαs P (fun β => (c β).1) (hPK 0 zero_le) (c1 0 zero_le)
    hpos ⟨Pi, Pc⟩ ⟨c4, c5⟩ hsteps
  have hN₇ := Frame.nfstar_nf hc hstar
  rw [hP0] at hN₇
  have hb0 : s.S.le (Y 0) (c 0).1 := by rw [c2]; exact hS.refl (yK 0 zero_le).1
  exact Frame.nf_claim hU hs hαs hpos xi xc xK yi yc yK hNF h0 c4 c5 c1 hb0 c6 c3 c7
    (fun ε hε => ⟨P ε, P (ε + 1), (hP ε hε.le).1, (hP _ (Order.add_one_le_iff.2 hε)).1,
      Frame.nfstar_nf hc (hsteps ε hε)⟩) ⟨P αs, (hP αs le_rfl).1, hN₇⟩

/-- AUX: not in paper. Case b for `α* = 2`. -/
theorem Frame.nf_trans_dec [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {A A' B B' C C' : Model U L} (h1 : s.NF lam A A' B B')
    (h2 : s.NF lam B B' C C') (d1 : Decomposable s.S lam (s.K3uq lam) A B)
    (d2 : Decomposable s.S lam (s.K3uq lam) B C) : s.NF lam A A' C C' := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨kA, kA', kB, kB', lAA', lA'B', lAB, -, -⟩ := id h1
  obtain ⟨-, -, kC, kC', -, lB'C', lBC, -, -⟩ := id h2
  have hκ := Cardinal.isSuccLimit_ord ((Frame.aleph0_le hc kA).trans (Order.le_succ lam))
  obtain ⟨X, x0, x1, x2, xi, xc⟩ := hS.three_chain lAB lBC
  obtain ⟨Y, y0, y1, y2, yi, yc⟩ := hS.three_chain lA'B' lB'C'
  have hcase : ∀ ε ≤ (0 : Ordinal.{u}) + 1 + 1, ε = 0 ∨ ε = 0 + 1 ∨ ε = 0 + 1 + 1 := fun ε hε => by
    rcases hε.lt_or_eq with h' | h'
    · rcases (Order.lt_add_one_iff.1 h').lt_or_eq with h'' | h''
      · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h'') zero_le)
      · exact Or.inr (Or.inl h'')
    · exact Or.inr (Or.inr h')
  have hi2 : ∀ i < (0 : Ordinal.{u}) + 1 + 1, i = 0 ∨ i = 0 + 1 := fun i hi => by
    rcases (Order.lt_add_one_iff.1 hi).lt_or_eq with h' | h'
    · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h') zero_le)
    · exact Or.inr h'
  have := Frame.nf_caseb hU hs (αs := 0 + 1 + 1) (hκ.add_one_lt (hκ.add_one_lt hκ.bot_lt)) xi xc
    (fun ε hε => by
      rcases hcase ε hε with rfl | rfl | rfl
      · rw [x0]; exact kA
      · rw [x1]; exact kB
      · rw [x2]; exact kC) yi yc (fun ε hε => by
      rcases hcase ε hε with rfl | rfl | rfl
      · rw [y0]; exact kA'
      · rw [y1]; exact kB'
      · rw [y2]; exact kC') (fun i hi => by
      rcases hi2 i hi with rfl | rfl
      · rw [x0, x1, y0, y1]; exact Frame.nf_symm hU hs h1
      · rw [x1, x2, y1, y2]; exact Frame.nf_symm hU hs h2)
    (by rw [x0, y0]; exact lAA') (fun i hi => by
      rcases hi2 i hi with rfl | rfl
      · rw [x0, x1]; exact d1
      · rw [x1, x2]; exact d2)
  rw [x0, x2, y0, y2] at this
  exact Frame.nf_symm hU hs this

/-- AUX: not in paper. One step of the construction of Prop 5.5.3. -/
theorem Frame.nf_step [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {P Q N : Model U L} (hP : P ∈ s.S.Kc lam) (hQ : Q ∈ s.S.Kc lam)
    (hN : N ∈ s.S.Kc lam) (hPQ : s.S.le P Q) (hPN : s.S.le P N)
    (hd : Q.carrier ∩ N.carrier = P.carrier) :
    ∃ N' ∈ s.S.Kc lam, s.S.le N N' ∧ s.S.le Q N' ∧ s.NF lam P Q N N' ∧
      Decomposable s.S lam (s.K3uq lam) N N' ∧ Decomposable s.S lam (s.K3uq lam) Q N' := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨N₃, hN₃, hNF⟩ := Frame.thm_5_3_7_a hU hs hP hQ hN hPQ hPN hd
  obtain ⟨-, -, -, -, -, lQ3, -, lN3, -⟩ := id hNF
  obtain ⟨N', hN', h3N', d1, d2⟩ := prop_3_2_4 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3uq lam)
    (fun _ h => h.1) (Frame.K3uq_isoClosed hU hc) hex N Q N₃ hN hQ hN₃ lN3 lQ3
  have lNN := hS.trans lN3 h3N'
  have lQN := hS.trans lQ3 h3N'
  exact ⟨N', hN', lNN, lQN, prop_5_3_9_4 lam hU s hs P hP Q hQ N hN N₃ hN₃ P hP Q hQ N hN N' hN' hNF rfl
    ⟨hS.refl hP.1, hS.refl hP.1, hS.trans hPQ lQN⟩ ⟨hS.refl hQ.1, hPQ, lQN⟩
    ⟨hS.refl hN.1, hPN, lNN⟩ ⟨N', h3N', hS.refl hN'.1⟩, d1, d2⟩

/-- AUX: not in paper. The proof of Thm 5.5.1 (Cases c and general), with the two-step
transitivity as a parameter. -/
theorem Frame.nf_long_core [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord) (hpos : 0 < αs)
    {Ma Mb : Ordinal.{u} → Model U L} (ai : IsIncreasing s.S.le Ma (Iic αs))
    (ac : IsContinuous Ma (Iic αs)) (aK : ∀ ε ≤ αs, Ma ε ∈ s.S.Kc lam)
    (bi : IsIncreasing s.S.le Mb (Iic αs)) (bc : IsContinuous Mb (Iic αs))
    (bK : ∀ ε ≤ αs, Mb ε ∈ s.S.Kc lam)
    (hNF : ∀ ε < αs, s.NF lam (Ma ε) (Ma (ε + 1)) (Mb ε) (Mb (ε + 1)))
    (h0 : s.S.le (Ma 0) (Mb 0))
    (Htr : ∀ ε < αs, 0 < ε → ∀ A A' B B' C C' : Model U L, s.NF lam A A' B B' →
      s.NF lam B B' C C' → ((∃ β, ε = β + 1) → Decomposable s.S lam (s.K3uq lam) A B ∧
        Decomposable s.S lam (s.K3uq lam) B C) → s.NF lam A A' C C') :
    s.NF lam (Ma 0) (Ma αs) (Mb 0) (Mb αs) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have k0 := aK 0 zero_le
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hiso := Frame.K3uq_isoClosed hU hc
  let StepNF : Ordinal.{u} → QRel U L := fun _ P Q N N' => s.NF lam P Q N N' ∧
    Decomposable s.S lam (s.K3uq lam) N N' ∧ Decomposable s.S lam (s.K3uq lam) Q N'
  have mkstep : ∀ {M : Ordinal.{u} → Model U L}, (∀ ε ≤ αs, M ε ∈ s.S.Kc lam) → ∀ ε < αs,
      ∀ (g : U → U) (P Q N : Model U L), IsoOn g (M ε) P → IsoOn g (M (ε + 1)) Q → s.S.le P Q →
      N ∈ s.S.Kc lam → s.S.le P N → Q.carrier ∩ N.carrier = P.carrier →
      ∃ N' ∈ s.S.Kc lam, s.S.le N N' ∧ s.S.le Q N' ∧ StepNF ε P Q N N' := by
    intro M hM ε hε g P Q N hgP hgQ hPQ hN hPN hd
    have hK1 := hM (ε + 1) (Order.add_one_le_iff.2 hε)
    have hQc : Q ∈ s.S.Kc lam := ⟨hS.iso_mem hK1.1 hgQ, by rw [hgQ.card_eq]; exact hK1.2⟩
    have hPc : P ∈ s.S.Kc lam := ⟨hS.mem_left hPQ, by rw [hgP.card_eq]; exact (hM ε hε.le).2⟩
    exact Frame.nf_step hU hs hPc hQc hN hPQ hPN hd
  obtain ⟨cA, a1, a2, a3, a4, a5, a6, a7, a8⟩ := hS.chain_build hU hinf hαs (M := Ma)
    ⟨ai, ac, fun ε h => aK ε h⟩ (X := Ma 0) k0 (hS.refl k0.1) StepNF (mkstep aK)
  have hb0K := bK 0 zero_le
  obtain ⟨Mp, hMp, hlt, hdecp, -⟩ := Frame.exists_decomp_ext hU hs k0 k0 hb0K (hS.refl k0.1) h0
    (Set.inter_eq_left.2 (hS.sub h0))
  obtain ⟨cB, b1, b2, b3, b4, b5, b6, b7, b8⟩ := hS.chain_build hU hinf hαs
    (M := fun β => (cA β).1) ⟨a4, a5, fun ε h => a1 ε h⟩ (X := Mp) hMp
    (by show s.S.le (cA 0).1 Mp; rw [a2]; exact hS.trans h0 hlt.1) StepNF (mkstep a1)
  have hsuc : ∀ ε < αs, ε + 1 ≤ αs := fun ε h => Order.add_one_le_iff.2 h
  have hlt1 : ∀ ε : Ordinal.{u}, ε < ε + 1 := fun ε => Order.lt_add_one_iff.2 le_rfl
  have hfbe : ∀ ε < αs, ∀ y ∈ (cA ε).1.carrier, (cB (ε + 1)).2 y = (cB ε).2 y := fun ε hε y hy =>
    b7 ε (Set.mem_Iic.2 hε.le) (ε + 1) (Set.mem_Iic.2 (hsuc ε hε)) (hlt1 ε) y hy
  have hfid : ∀ {P : Model U L} {g : U → U}, IsoOn g (Ma 0) P → (∀ x ∈ (Ma 0).carrier, g x = x) →
      P = Ma 0 := fun {P g} hg hx => (Model.eq_of_isoOn_id (hg.congr hx |> fun h => h)).symm
  refine Frame.nf_claim hU hs (f := fun ε => (cB ε).2 ∘ (cA ε).2) hαs hpos ai ac aK bi bc bK hNF h0
    b4 b5 b1 (by rw [b2]; exact hlt.1) (fun ε hε => IsEmb.comp hS (a6 ε hε) (b6 ε hε)) ?_ ?_ ?_ ?_
  · intro x hx
    show (cB 0).2 ((cA 0).2 x) = x
    rw [a3 x hx]
    exact b3 x (by show x ∈ (cA 0).1.carrier; rw [a2]; exact hx)
  · intro a ha b hb hl y hy
    show (cB b).2 ((cA b).2 y) = (cB a).2 ((cA a).2 y)
    have e7 : (cA b).2 y = (cA a).2 y := a7 a ha b hb hl y hy
    rw [e7]
    exact b7 a ha b hb hl _ ((a6 a ha).mapsTo hS hy)
  · intro ε hε
    obtain ⟨P, Q, hP, hQ, hN, d1, d2⟩ := a8 ε (hsuc ε hε)
    obtain ⟨P', Q', hP', hQ', hN', d1', d2'⟩ := b8 ε (hsuc ε hε)
    obtain ⟨-, -, -, -, lPQ, lQN, lPN, -, -⟩ := id hN
    obtain ⟨kP', kQ', kNb, kNb', lPQ', lQN', lPN', lNN', -⟩ := id hN'
    have hP'' : IsoOn (cB (ε + 1)).2 (cA ε).1 P' :=
      hP'.congr fun y hy => (hfbe ε hε y hy).symm
    obtain ⟨A₁, hA⟩ := exists_isoOn (hP''.injOn.mono (hS.sub lPN))
    obtain ⟨A₂, hA'⟩ := exists_isoOn (hQ'.injOn.mono (hS.sub lQN))
    have hNF1 := (prop_5_3_3 lam hU s hs P Q (cA ε).1 (cA (ε + 1)).1 A₁ A₂ P' Q' (cB (ε + 1)).2 hQ'
      hA hA' hP'').2 hN
    have hAε : IsoOn (cB ε).2 P A₁ := hA.congr fun y hy => hfbe ε hε y (hS.sub lPN hy)
    refine ⟨A₁, A₂, hP.comp hAε, hQ.comp hA', ?_⟩
    rcases (zero_le : (0 : Ordinal.{u}) ≤ ε).lt_or_eq with hε0 | hε0
    · refine Htr ε hε hε0 A₁ A₂ P' Q' _ _ hNF1 hN' ?_
      rintro ⟨β, rfl⟩
      have hβ : β < αs := lt_trans (hlt1 β) hε
      obtain ⟨P₂, Q₂, -, hQ₂, -, -, d2₂⟩ := a8 β (hsuc β hβ)
      obtain ⟨P₃, Q₃, -, hQ₃, -, -, d2₃⟩ := b8 β (hsuc β hβ)
      rw [← hP.unique hQ₂] at d2₂
      rw [← hP'.unique hQ₃] at d2₃
      obtain ⟨-, γ, D, e, hd⟩ := d2₂
      exact ⟨decomp_iso hS hiso hd hP'' hA (a1 _ hε.le), d2₃⟩
    · subst hε0
      have eP : P = Ma 0 := hfid hP a3
      have eA : A₁ = P' := by
        have h3 : (cA 0).1 = Ma 0 := a2
        apply hA.unique
        rw [eP, ← h3]; exact hP''
      rw [eA] at hNF1 ⊢
      obtain ⟨kA₁, kA₂, -, -, lA, lA2, -⟩ := id hNF1
      have hA'Q : s.S.le A₂ Q' := hS.iso_le lQN hQ' hA'
      exact prop_5_3_9_4 lam hU s hs P' kP' Q' kQ' _ kNb _ kNb' P' kP' A₂ kA₂ _ kNb _ kNb' hN' rfl
        ⟨hS.refl kP'.1, hS.refl kP'.1, hS.trans lPN' lNN'⟩ ⟨hA'Q, lA, hS.trans hA'Q lQN'⟩
        ⟨hS.refl kNb.1, lPN', lNN'⟩ ⟨_, hS.refl kNb'.1, hS.refl kNb'.1⟩
  · obtain ⟨R, hR, Ri, Rc⟩ := hS.image_chain (M := fun β => (cA β).1) (f := fun β => (cB β).2)
      (N := fun β => (cB β).1) a4 a5 b4 b6 b7
    have hR0 : R 0 = Ma 0 := by
      have h3 := (hR 0 zero_le).1
      have e := Model.eq_of_isoOn_id (h3.congr fun x hx => b3 x hx)
      rw [← e]; exact a2
    have hRK : ∀ β ≤ αs, R β ∈ s.S.Kc lam := fun β hβ =>
      ⟨hS.mem_left (hR β hβ).2, by rw [(hR β hβ).1.card_eq]; exact (a1 β hβ).2⟩
    have hN7 := Frame.nf_caseb hU hs hαs Ri Rc hRK b4 b5 b1
      (fun ε hε => by
        obtain ⟨P', Q', hP', hQ', hN', -, -⟩ := b8 ε (hsuc ε hε)
        rw [(hR ε hε.le).1.unique hP', (hR _ (hsuc ε hε)).1.unique hQ']
        exact hN') (hR 0 zero_le).2
      (fun ε hε => by
        obtain ⟨P, Q, -, -, -, d1, -⟩ := a8 ε (hsuc ε hε)
        obtain ⟨-, γ, D, e, hd⟩ := d1
        exact decomp_iso hS hiso hd (hR _ (hsuc ε hε)).1
          ((hR ε hε.le).1.congr fun y hy => (hfbe ε hε y hy).symm) (a1 _ (hsuc ε hε)))
    rw [hR0] at hN7
    obtain ⟨-, -, Y, hY, hfY⟩ := id (a6 αs le_rfl)
    obtain ⟨Qt, hQt⟩ := exists_isoOn ((hR αs le_rfl).1.injOn.mono (hS.sub hY))
    have hcomp : IsoOn ((cB αs).2 ∘ (cA αs).2) (Ma αs) Qt := hfY.comp hQt
    have hQR : s.S.le Qt (R αs) := hS.iso_le hY (hR αs le_rfl).1 hQt
    have hfix0 : IsoOn ((cB αs).2 ∘ (cA αs).2) (Ma 0) (Ma 0) := (IsoOn.refl _).congr fun x hx => by
      show x = (cB αs).2 ((cA αs).2 x)
      have hx' : x ∈ (cA 0).1.carrier := by rw [a2]; exact hx
      have e7 : (cA αs).2 x = (cA 0).2 x := a7 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos x hx
      have e8 : (cB αs).2 x = (cB 0).2 x := b7 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos x hx'
      rw [e7, a3 x hx, e8, b3 x hx']
    have h0α := ai 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos
    have l0Q : s.S.le (Ma 0) Qt := hS.iso_le h0α hcomp hfix0
    have hQc : Qt ∈ s.S.Kc lam := ⟨hS.mem_left hQR, by
      rw [hcomp.card_eq]; exact (aK αs le_rfl).2⟩
    obtain ⟨kM, kRα, kb0, kbα, l1, l2, l3, l4, -⟩ := id hN7
    exact ⟨Qt, hcomp, prop_5_3_9_4 lam hU s hs (Ma 0) kM (R αs) kRα _ kb0 _ kbα (Ma 0) kM Qt hQc _ kb0
      _ kbα hN7 rfl ⟨hS.refl kM.1, hS.refl kM.1, hS.trans l1 l2⟩ ⟨hQR, l0Q, hS.trans hQR l2⟩
      ⟨hS.refl kb0.1, l3, l4⟩ ⟨_, hS.refl kbα.1, hS.refl kbα.1⟩⟩

/-- AUX: not in paper. Two-step transitivity of `NF` (Case c of Thm 5.5.1 for `α* = 2`). -/
theorem Frame.nf_trans2 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {A A' B B' C C' : Model U L} (h1 : s.NF lam A A' B B')
    (h2 : s.NF lam B B' C C') : s.NF lam A A' C C' := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨kA, kA', kB, kB', lAA', lA'B', lAB, -, -⟩ := id h1
  obtain ⟨-, -, kC, kC', -, lB'C', lBC, -, -⟩ := id h2
  have hκ := Cardinal.isSuccLimit_ord ((Frame.aleph0_le hc kA).trans (Order.le_succ lam))
  obtain ⟨X, x0, x1, x2, xi, xc⟩ := hS.three_chain lAB lBC
  obtain ⟨Y, y0, y1, y2, yi, yc⟩ := hS.three_chain lA'B' lB'C'
  have hcase : ∀ ε ≤ (0 : Ordinal.{u}) + 1 + 1, ε = 0 ∨ ε = 0 + 1 ∨ ε = 0 + 1 + 1 := fun ε hε => by
    rcases hε.lt_or_eq with h' | h'
    · rcases (Order.lt_add_one_iff.1 h').lt_or_eq with h'' | h''
      · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h'') zero_le)
      · exact Or.inr (Or.inl h'')
    · exact Or.inr (Or.inr h')
  have hi2 : ∀ i < (0 : Ordinal.{u}) + 1 + 1, i = 0 ∨ i = 0 + 1 := fun i hi => by
    rcases (Order.lt_add_one_iff.1 hi).lt_or_eq with h' | h'
    · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h') zero_le)
    · exact Or.inr h'
  have hpos : (0 : Ordinal.{u}) < 0 + 1 + 1 :=
    lt_trans (Order.lt_add_one_iff.2 le_rfl) (Order.lt_add_one_iff.2 le_rfl)
  have := Frame.nf_long_core hU hs (αs := 0 + 1 + 1) (hκ.add_one_lt (hκ.add_one_lt hκ.bot_lt)) hpos
    xi xc (fun ε hε => by
      rcases hcase ε hε with rfl | rfl | rfl
      · rw [x0]; exact kA
      · rw [x1]; exact kB
      · rw [x2]; exact kC) yi yc (fun ε hε => by
      rcases hcase ε hε with rfl | rfl | rfl
      · rw [y0]; exact kA'
      · rw [y1]; exact kB'
      · rw [y2]; exact kC') (fun i hi => by
      rcases hi2 i hi with rfl | rfl
      · rw [x0, x1, y0, y1]; exact Frame.nf_symm hU hs h1
      · rw [x1, x2, y1, y2]; exact Frame.nf_symm hU hs h2)
    (by rw [x0, y0]; exact lAA') (fun ε hε hε0 A₁ A₂ B₁ B₂ C₁ C₂ n1 n2 hd => by
      rcases hi2 ε hε with rfl | rfl
      · exact absurd hε0 (lt_irrefl _)
      · obtain ⟨d1, d2⟩ := hd ⟨0, rfl⟩
        exact Frame.nf_trans_dec hU hs n1 n2 d1 d2)
  rw [x0, x2, y0, y2] at this
  exact Frame.nf_symm hU hs this

-- DEVIATION (author-confirmed: α* ≠ 0 omitted in the paper): added `0 < α*`.
/-- Thm 5.5.1 (long transitivity for `NF`): for `≺`-increasing continuous sequences
`⟨M_{x,ε} : ε ≤ α*⟩` in `K_λ` with `NF(M_{a,ε}, M_{a,ε+1}, M_{b,ε}, M_{b,ε+1})`,
`NF(M_{a,0}, M_{a,α*}, M_{b,0}, M_{b,α*})`. -/
theorem thm_5_5_1 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (αs : Ordinal.{u}) (Ma Mb : Ordinal.{u} → Model U L)
    (hMa : IsIncreasing s.S.lt Ma (Iic αs) ∧ IsContinuous Ma (Iic αs) ∧
      ∀ ε ≤ αs, Ma ε ∈ s.S.Kc lam)
    (hMb : IsIncreasing s.S.lt Mb (Iic αs) ∧ IsContinuous Mb (Iic αs) ∧
      ∀ ε ≤ αs, Mb ε ∈ s.S.Kc lam)
    (h : ∀ ε < αs, s.NF lam (Ma ε) (Ma (ε + 1)) (Mb ε) (Mb (ε + 1)))
    (hpos : 0 < αs) :
    s.NF lam (Ma 0) (Ma αs) (Mb 0) (Mb αs) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨ai, ac, aK⟩ := hMa
  obtain ⟨bi, bc, bK⟩ := hMb
  -- `M_{a,0} ≼ M_{b,0}` is read off from the definition of `NF`
  have h0 : s.S.le (Ma 0) (Mb 0) := (h 0 hpos).2.2.2.2.2.2.1
  have hlt1 : ∀ {x y : Ordinal.{u}}, x < y + 1 → x ≤ y := fun h' => Order.lt_add_one_iff.1 h'
  have hex : ∀ ε, ∃ x : U, ε < αs → x ∈ (Ma (ε + 1)).carrier \ (Ma ε).carrier := fun ε => by
    by_cases he : ε < αs
    · obtain ⟨x, h1, h2⟩ := hS.exists_diff_of_lt (ai ε (Set.mem_Iic.2 he.le) (ε + 1)
        (Set.mem_Iic.2 (Order.add_one_le_iff.2 he)) (Order.lt_add_one_iff.2 le_rfl))
      exact ⟨x, fun _ => ⟨h1, h2⟩⟩
    · haveI : Infinite U := hU.infinite
      exact ⟨Classical.arbitrary U, fun h' => absurd h' he⟩
  choose d hd using hex
  have hlen := hS.chain_card_le (θ := αs + 1) (M := Ma) (d := d)
    (fun a ha b hb h' => (ai a (hlt1 ha) b (hlt1 hb) h').1) (fun α hα => aK α (hlt1 hα))
    (fun α hα => hd α (Order.add_one_le_iff.1 (hlt1 hα))) αs (Order.lt_add_one_iff.2 le_rfl)
  have hαs : αs < (Order.succ lam).ord :=
    Cardinal.lt_ord.2 (lt_of_le_of_lt hlen (Order.lt_succ lam))
  exact Frame.nf_long_core hU hs hαs hpos (fun a ha b hb h' => (ai a ha b hb h').1) ac aK
    (fun a ha b hb h' => (bi a ha b hb h').1) bc bK h h0
    fun _ _ _ A A' B B' C C' n1 n2 _ => Frame.nf_trans2 hU hs n1 n2

/-- AUX: not in paper. The construction of Prop 5.5.3(a),(b): after `IsAEC.chain_build_gen`, the
top model is renamed by the inverse of `f_{α*}`, so that `f_ε = id` (the paper's "without loss of
generality"), keeping `M*` fixed. -/
theorem Frame.nf_ext_core [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {αs : Ordinal.{u}} (hαs : αs ≤ (Order.succ lam).ord)
    {M : Ordinal.{u} → Model U L} (mi : IsIncreasing s.S.lt M (Iic αs))
    (mc : IsContinuous M (Iic αs)) (mK : ∀ ε ≤ αs, M ε ∈ s.S.K)
    (mKc : ∀ ε ≤ αs, ε < (Order.succ lam).ord → M ε ∈ s.S.Kc lam) {Ms X : Model U L}
    (hMs : Ms ∈ s.S.Kc lam) (h0 : s.S.le (M 0) Ms)
    (hdisj : Ms.carrier ∩ (M αs).carrier = (M 0).carrier) (hX : X ∈ s.S.Kc lam)
    (hMsX : s.S.le Ms X) :
    ∃ (N : Ordinal.{u} → Model U L) (g : U → U), IsIncreasing s.S.lt N (Iic αs) ∧
      IsContinuous N (Iic αs) ∧ (∀ ε ≤ αs, N ε ∈ s.S.K) ∧ IsoOn g X (N 0) ∧
      (∀ x ∈ Ms.carrier, g x = x) ∧ (∀ ε ≤ αs, s.S.le (M ε) (N ε)) ∧
      ∀ ε < αs, s.NF lam (M ε) (M (ε + 1)) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (M (ε + 1)) (N (ε + 1)) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hMs
  have hiso := Frame.K3uq_isoClosed hU hc
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have mi' : IsIncreasing s.S.le M (Iic αs) := fun a ha b hb h => (mi a ha b hb h).1
  have hsuc : ∀ ε < αs, ε + 1 ≤ αs := fun ε h => Order.add_one_le_iff.2 h
  have hκ1 : ∀ ε < αs, ε + 1 < (Order.succ lam).ord := fun ε h =>
    hκl.add_one_lt (lt_of_lt_of_le h hαs)
  obtain ⟨c, c1, c2, c3, c4, c5, c6, c7, c8⟩ := hS.chain_build_gen
    (Step := fun _ P Q N N' => s.NF lam P Q N N' ∧ Decomposable s.S lam (s.K3uq lam) N N' ∧
      Decomposable s.S lam (s.K3uq lam) Q N') hU hinf hαs mi' mc
    (fun ε hε => ⟨mK ε hε, mKc ε hε⟩) hX (hS.trans h0 hMsX)
    (fun ε hε g P Q N hgP hgQ hPQ hN hPN hd => by
      have hK1 := mKc (ε + 1) (hsuc ε hε) (hκ1 ε hε)
      have hQc : Q ∈ s.S.Kc lam := ⟨hS.iso_mem hK1.1 hgQ, by rw [hgQ.card_eq]; exact hK1.2⟩
      have hPc : P ∈ s.S.Kc lam := ⟨hS.mem_left hPQ, by
        rw [hgP.card_eq]; exact (mKc ε hε.le (lt_of_lt_of_le hε hαs)).2⟩
      exact Frame.nf_step hU hs hPc hQc hN hPQ hPN hd)
  obtain ⟨P, hP, Pi, Pc⟩ := hS.image_chain (f := fun β => (c β).2) (N := fun β => (c β).1) mi' mc c4
    c6 c7
  have hP0 : P 0 = M 0 :=
    (Model.eq_of_isoOn_id ((hP 0 zero_le).1.congr fun x hx => c3 x hx)).symm
  have hPle : ∀ a ≤ αs, ∀ b ≤ αs, a ≤ b → (P a).carrier ⊆ (P b).carrier := fun a ha b hb h => by
    rcases h.lt_or_eq with h | h
    · exact hS.sub (Pi a ha b hb h)
    · rw [h]
  have hNle : ∀ a ≤ αs, ∀ b ≤ αs, a ≤ b → ((c a).1).carrier ⊆ ((c b).1).carrier :=
    fun a ha b hb h => by
      rcases h.lt_or_eq with h | h
      · exact hS.sub (c4 a ha b hb h)
      · rw [h]
  have hstep : ∀ ε < αs, s.NF lam (P ε) (P (ε + 1)) (c ε).1 (c (ε + 1)).1 ∧
      Decomposable s.S lam (s.K3uq lam) (c ε).1 (c (ε + 1)).1 ∧
      Decomposable s.S lam (s.K3uq lam) (P (ε + 1)) (c (ε + 1)).1 := fun ε hε => by
    obtain ⟨P', Q', hP', hQ', hS'⟩ := c8 ε (hsuc ε hε)
    rw [(hP ε hε.le).1.unique hP', (hP _ (hsuc ε hε)).1.unique hQ']
    exact hS'
  have hPN0 : ∀ ε ≤ αs, (P ε).carrier ∩ (c 0).1.carrier ⊆ (M 0).carrier := by
    intro ε
    induction ε using Ordinal.lt_wf.induction with
    | ind ε ih =>
    rintro hε x ⟨hx1, hx2⟩
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h | ⟨γ, hγ⟩ | hl
    · subst h; rw [hP0] at hx1; exact hx1
    · rw [Order.succ_eq_add_one] at hγ
      subst hγ
      have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
      have hγα : γ < αs := lt_of_lt_of_le hγ1 hε
      have hd := (prop_5_3_6 lam hU s hs _ _ _ _).2 (hstep γ hγα).1
      have hx3 : x ∈ (P γ).carrier := by
        rw [← hd]; exact ⟨hx1, hNle 0 zero_le γ hγα.le zero_le hx2⟩
      exact ih γ hγ1 hγα.le ⟨hx3, hx2⟩
    · rw [Pc ε hε hl] at hx1
      obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx1
      exact ih ξ hξ ((le_of_lt hξ).trans hε) ⟨hxξ, hx2⟩
  have hfinc : ∀ ε ≤ αs, ∀ y ∈ (M ε).carrier, (c αs).2 y = (c ε).2 y := fun ε hε y hy => by
    rcases hε.lt_or_eq with h | h
    · exact c7 ε hε αs (Set.mem_Iic.2 le_rfl) h y hy
    · rw [h]
  have hMsub : ∀ ε ≤ αs, (M ε).carrier ⊆ (M αs).carrier := fun ε hε => by
    rcases hε.lt_or_eq with h | h
    · exact hS.sub (mi' ε hε αs (Set.mem_Iic.2 le_rfl) h)
    · rw [h]
  have hFid : ∀ x ∈ (M 0).carrier, (c αs).2 x = x := fun x hx => by
    rw [hfinc 0 zero_le x hx]; exact c3 x hx
  have hYsub : (M 0).carrier ⊆ (P αs).carrier := by
    have := hPle 0 zero_le αs le_rfl zero_le; rwa [hP0] at this
  have h1Y : Ms.carrier ∩ (P αs).carrier = (M 0).carrier := by
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub h0 hx, hYsub hx⟩⟩
    exact hPN0 αs le_rfl ⟨hx.2, by rw [c2]; exact hS.sub hMsX hx.1⟩
  have hsuccl : Order.succ lam < #U := hU.1.isSuccLimit.succ_lt hU.2
  have hU' : Room U (Order.succ lam) := ⟨hU.1, hsuccl⟩
  have hinf' : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hcardT : #(M αs).carrier ≤ Order.succ lam := by
    rcases hαs.lt_or_eq with h | h
    · exact (le_of_eq (mKc αs le_rfl h).2).trans (Order.le_succ lam)
    · have hl : Order.IsSuccLimit αs := by rw [h]; exact hκl
      rw [mc αs (Set.mem_Iic.2 le_rfl) hl]
      refine card_biUnion_le hinf' (by rw [h, Cardinal.card_ord]) fun β hβ => ?_
      exact (le_of_eq (mKc β hβ.le (lt_of_lt_of_le hβ hαs)).2).trans (Order.le_succ lam)
  obtain ⟨g, hg, hgMs, hgF⟩ := rename_back (T := (c αs).1.carrier) hU' hinf' (hP αs le_rfl).1 hFid
    (hMsub 0 zero_le) hYsub hdisj h1Y ((le_of_eq hMs.2).trans (Order.le_succ lam)) hcardT
  have hex : ∀ ε, ∃ Y : Model U L, ε ≤ αs → IsoOn g (c ε).1 Y := fun ε => by
    by_cases h : ε ≤ αs
    · obtain ⟨Y, hY⟩ := exists_isoOn (hg.mono (hNle ε h αs le_rfl h))
      exact ⟨Y, fun _ => hY⟩
    · exact ⟨M 0, fun h' => absurd h' h⟩
  choose N hN using hex
  have hgP : ∀ ε ≤ αs, IsoOn g (P ε) (M ε) := fun ε hε => by
    obtain ⟨κ, hκ, -, hfκ⟩ := (hP ε hε).1.exists_inv
    refine hκ.congr fun z hz => ?_
    have hy := hκ.mapsTo hz
    have h3 := hgF (κ z) (hMsub ε hε hy)
    rw [hfinc ε hε _ hy, hfκ z hz] at h3
    exact h3.symm
  have hNK : ∀ ε ≤ αs, N ε ∈ s.S.K := fun ε hε => hS.iso_mem (c1 ε hε).1 (hN ε hε)
  have hNinc : IsIncreasing s.S.le N (Iic αs) := fun a ha b hb h =>
    hS.iso_le (c4 a ha b hb h) (hN b hb) (hN a ha)
  have hNF' : ∀ ε < αs, s.NF lam (M ε) (M (ε + 1)) (N ε) (N (ε + 1)) := fun ε hε =>
    (prop_5_3_3 lam hU s hs _ _ _ _ (M ε) (M (ε + 1)) (N ε) (N (ε + 1)) g (hN _ (hsuc ε hε))
      (hgP ε hε.le) (hgP _ (hsuc ε hε)) (hN ε hε.le)).2 (hstep ε hε).1
  have hne : ∀ ε < αs, N ε ≠ N (ε + 1) := fun ε hε e => by
    obtain ⟨x, hx1, hx2⟩ := hS.exists_diff_of_lt (mi ε hε.le (ε + 1) (hsuc ε hε)
      (Order.lt_add_one_iff.2 le_rfl))
    have hd := (prop_5_3_6 lam hU s hs _ _ _ _).2 (hNF' ε hε)
    obtain ⟨-, -, -, -, -, l13, -⟩ := id (hNF' ε hε)
    exact hx2 (by rw [← hd]; exact ⟨hx1, by rw [e]; exact hS.sub l13 hx1⟩)
  refine ⟨N, g, fun a ha b hb h => ⟨hNinc a ha b hb h, fun e => ?_⟩, fun b hb hl => ?_, hNK,
    by have := hN 0 zero_le; rwa [c2] at this, hgMs, fun ε hε => ?_, fun ε hε => ⟨hNF' ε hε, ?_, ?_⟩⟩
  · have haα : a < αs := lt_of_lt_of_le h hb
    have h1 : a + 1 ≤ b := Order.add_one_le_iff.2 h
    have h2 : s.S.le (N a) (N (a + 1)) := hNinc a ha (a + 1) (hsuc a haα)
      (Order.lt_add_one_iff.2 le_rfl)
    refine hne a haα (hS.po.2.2.1 _ _ h2 ?_)
    rcases h1.lt_or_eq with h' | h'
    · have := hNinc (a + 1) (hsuc a haα) b hb h'
      rwa [← e] at this
    · rw [h', ← e]; exact hS.refl (hNK a ha)
  · have hb' : b ≤ αs := hb
    rw [(hN b hb').carrier_eq, c5 b hb hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ξ hξ => ((hN ξ ((le_of_lt hξ).trans hb')).carrier_eq).symm
  · exact hS.iso_le (hP ε hε).2 (hN ε hε) (hgP ε hε)
  · obtain ⟨-, γ, D, e, hd⟩ := (hstep ε hε).2.1
    have hKc : (c (ε + 1)).1 ∈ s.S.Kc lam := (c1 _ (hsuc ε hε)).2 (hκ1 ε hε)
    exact decomp_iso hS hiso hd (hN _ (hsuc ε hε)) (hN ε hε.le) hKc
  · obtain ⟨-, γ, D, e, hd⟩ := (hstep ε hε).2.2
    have hKc : (c (ε + 1)).1 ∈ s.S.Kc lam := (c1 _ (hsuc ε hε)).2 (hκ1 ε hε)
    exact decomp_iso hS hiso hd (hN _ (hsuc ε hε)) (hgP _ (hsuc ε hε)) hKc

-- AGENT-CHOICE (reading): "decomposable" is not given a class; in Section 5 we read it as
-- decomposable by `K^{3,uq}` (the class used in Thm 5.3.7 and by Hypothesis 5.1.1(3)).
/-- Prop 5.5.3(a): let `α* ≤ λ⁺` and `⟨M_ε : ε ≤ α*⟩` be `≺`-increasing continuous in `K` with
`M_ε ∈ K_λ` for `ε < λ⁺`. There is a `≺`-increasing continuous `⟨N_ε : ε ≤ α*⟩` in `K` with
`N₀ = M₀`, `M_ε ≼ N_ε`, `NF(M_ε, M_{ε+1}, N_ε, N_{ε+1})` and `N_{ε+1}` decomposable over `N_ε`
and over `M_{ε+1}`. -/
theorem prop_5_5_3_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (αs : Ordinal.{u}) (hαs : αs ≤ (Order.succ lam).ord) (M : Ordinal.{u} → Model U L)
    (hM : IsIncreasing s.S.lt M (Iic αs) ∧ IsContinuous M (Iic αs) ∧ (∀ ε ≤ αs, M ε ∈ s.S.K) ∧
      ∀ ε ≤ αs, ε < (Order.succ lam).ord → M ε ∈ s.S.Kc lam) :
    ∃ N : Ordinal.{u} → Model U L, IsIncreasing s.S.lt N (Iic αs) ∧ IsContinuous N (Iic αs) ∧
      (∀ ε ≤ αs, N ε ∈ s.S.K) ∧ N 0 = M 0 ∧ (∀ ε ≤ αs, s.S.le (M ε) (N ε)) ∧
      ∀ ε < αs, s.NF lam (M ε) (M (ε + 1)) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (M (ε + 1)) (N (ε + 1)) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨mi, mc, mK, mKc⟩ := hM
  have h0K : M 0 ∈ s.S.Kc lam := by
    refine mKc 0 zero_le (lt_of_le_of_ne zero_le fun h => ?_)
    have h' := Cardinal.lt_ord.2 (show (0 : Ordinal.{u}).card < Order.succ lam by
      rw [Ordinal.card_zero]; exact lt_of_le_of_lt zero_le (Order.lt_succ lam))
    exact absurd h.symm h'.ne'
  have hsub : (M 0).carrier ⊆ (M αs).carrier := by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h | h
    · exact hS.sub (mi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) h).1
    · rw [← h]
  obtain ⟨N, g, h1, h2, h3, hX, hfix, h5, h6⟩ := Frame.nf_ext_core hU hs hαs mi mc mK mKc h0K
    (hS.refl h0K.1) (Set.inter_eq_left.2 hsub) h0K (hS.refl h0K.1)
  have e : N 0 = M 0 := (hX.unique ((IsoOn.refl _).congr fun x hx => (hfix x hx).symm))
  exact ⟨N, h1, h2, h3, e, h5, h6⟩

-- AGENT-CHOICE (reading): as in (a), "decomposable" means decomposable by `K^{3,uq}`.
/-- Prop 5.5.3(b): with `M₀ ≺ M* ∈ K_λ` and `M* ∩ M_{α*} = M₀`, there is a `≺`-increasing
continuous `⟨N_ε : ε ≤ α*⟩` with `M* ≼ N₀`, `M_ε ≼ N_ε`, `NF(M_ε, M_{ε+1}, N_ε, N_{ε+1})`, `N₀`
decomposable over `M₀`, `N_{ε+1}` decomposable over `N_ε` and over `M_{ε+1}`. -/
theorem prop_5_5_3_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (αs : Ordinal.{u}) (hαs : αs ≤ (Order.succ lam).ord) (M : Ordinal.{u} → Model U L)
    (hM : IsIncreasing s.S.lt M (Iic αs) ∧ IsContinuous M (Iic αs) ∧ (∀ ε ≤ αs, M ε ∈ s.S.K) ∧
      ∀ ε ≤ αs, ε < (Order.succ lam).ord → M ε ∈ s.S.Kc lam)
    (Ms : Model U L) (hMs : Ms ∈ s.S.Kc lam) (hlt : s.S.lt (M 0) Ms)
    (hdisj : Ms.carrier ∩ (M αs).carrier = (M 0).carrier) :
    ∃ N : Ordinal.{u} → Model U L, IsIncreasing s.S.lt N (Iic αs) ∧ IsContinuous N (Iic αs) ∧
      (∀ ε ≤ αs, N ε ∈ s.S.K) ∧ s.S.le Ms (N 0) ∧ (∀ ε ≤ αs, s.S.le (M ε) (N ε)) ∧
      Decomposable s.S lam (s.K3uq lam) (M 0) (N 0) ∧
      ∀ ε < αs, s.NF lam (M ε) (M (ε + 1)) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (N ε) (N (ε + 1)) ∧
        Decomposable s.S lam (s.K3uq lam) (M (ε + 1)) (N (ε + 1)) := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨mi, mc, mK, mKc⟩ := hM
  have h0K : M 0 ∈ s.S.Kc lam := by
    refine mKc 0 zero_le (lt_of_le_of_ne zero_le fun h => ?_)
    have h' := Cardinal.lt_ord.2 (show (0 : Ordinal.{u}).card < Order.succ lam by
      rw [Ordinal.card_zero]; exact lt_of_le_of_lt zero_le (Order.lt_succ lam))
    exact absurd h.symm h'.ne'
  have hiso := Frame.K3uq_isoClosed hU hc
  obtain ⟨X, hX, hMsX, -, γ, D, e, hd⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3uq lam)
    (fun _ h => h.1) hiso hex (M 0) Ms h0K hMs hlt).1
  obtain ⟨N, g, h1, h2, h3, hgX, hfix, h5, h6⟩ := Frame.nf_ext_core hU hs hαs mi mc mK mKc hMs hlt.1
    hdisj hX hMsX
  have hfixM : IsoOn g Ms Ms := (IsoOn.refl _).congr fun x hx => (hfix x hx).symm
  have hfix0 : IsoOn g (M 0) (M 0) :=
    (IsoOn.refl _).congr fun x hx => (hfix x (hS.sub hlt.1 hx)).symm
  exact ⟨N, h1, h2, h3, hS.iso_le hMsX hgX hfixM, h5, decomp_iso hS hiso hd hgX hfix0 hX, h6⟩

/-! ════════════════════════════════════════════════════════════════════════════
    PART 6 : SECTION 6  (A relation on K_{λ⁺} based on NF)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 6.1.1: `s` is a semi-good `λ`-frame with conjugation and `K^{3,uq}` satisfies the
existence property. (The same hypothesis is repeated as 7.1.1, 8.1.1, 9.1.1.) -/
def Hyp_6_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.IsSemiGood lam ∧ ConjProp s lam ∧ s.ExistProp lam (s.K3uq lam)

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

/-- Def 6.1.2: `NF^(N₀, N₁, M₀, M₁)` iff (1) `Nₙ ∈ K_λ`, `Mₙ ∈ K_{λ⁺}`; (2) there are increasing
continuous `⟨N_{0,α} : α < λ⁺⟩`, `⟨N_{1,α} : α < λ⁺⟩` with
`NF(N_{0,α}, N_{1,α}, N_{0,α+1}, N_{1,α+1})`, `N_{n,0} = Nₙ`, `Mₙ = ⋃_α N_{n,α}`. -/
def NFhat (N₀ N₁ M₀ M₁ : Model U L) : Prop :=
  N₀ ∈ s.S.Kc lam ∧ N₁ ∈ s.S.Kc lam ∧ M₀ ∈ s.S.Kc (Order.succ lam) ∧
    M₁ ∈ s.S.Kc (Order.succ lam) ∧
    ∃ A B : Ordinal.{u} → Model U L,
      IsIncreasing s.S.le A (Iio (Order.succ lam).ord) ∧ IsContinuous A (Iio (Order.succ lam).ord) ∧
      IsIncreasing s.S.le B (Iio (Order.succ lam).ord) ∧ IsContinuous B (Iio (Order.succ lam).ord) ∧
      (∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1))) ∧
      A 0 = N₀ ∧ B 0 = N₁ ∧
      -- ENCODING (clarification, author-confirmed): `Mₙ = ⋃ N_{n,α}` in the paper is the union of
      -- structures, hence `IsUnionOf`.
      IsUnionOf A (Iio (Order.succ lam).ord) M₀ ∧ IsUnionOf B (Iio (Order.succ lam).ord) M₁

/-- Def 6.1.4: for `M₀ ≼ M₁` in `K_{λ⁺}`, `M₀ ≼^NF_{λ⁺} M₁` iff `NF^(N₀, N₁, M₀, M₁)` for some
`N₀, N₁ ∈ K_λ`. -/
def leNF (M₀ M₁ : Model U L) : Prop :=
  M₀ ∈ s.S.Kc (Order.succ lam) ∧ M₁ ∈ s.S.Kc (Order.succ lam) ∧ s.S.le M₀ M₁ ∧
    ∃ N₀ ∈ s.S.Kc lam, ∃ N₁ ∈ s.S.Kc lam, s.NFhat lam N₀ N₁ M₀ M₁

/-- `M₀ ≺^NF_{λ⁺} M₁`: `M₀ ≼^NF_{λ⁺} M₁` and `M₀ ≠ M₁` (Def 1.0.14 applied to `≼^NF`). -/
def ltNF (M₀ M₁ : Model U L) : Prop := s.leNF lam M₀ M₁ ∧ M₀ ≠ M₁

/-- `(K_{λ⁺}, ≼^NF_{λ⁺})`. -/
def nfKSys : KSys U L := ⟨s.S.Kc (Order.succ lam), s.leNF lam⟩

end Frame

/-- AUX: not in paper. `≼`-chain version of Thm 5.5.1 (`α* > 0`). -/
theorem Frame.nf_long [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord) (hpos : 0 < αs)
    {Ma Mb : Ordinal.{u} → Model U L} (ai : IsIncreasing s.S.le Ma (Iic αs))
    (ac : IsContinuous Ma (Iic αs)) (aK : ∀ ε ≤ αs, Ma ε ∈ s.S.Kc lam)
    (bi : IsIncreasing s.S.le Mb (Iic αs)) (bc : IsContinuous Mb (Iic αs))
    (bK : ∀ ε ≤ αs, Mb ε ∈ s.S.Kc lam)
    (hNF : ∀ ε < αs, s.NF lam (Ma ε) (Ma (ε + 1)) (Mb ε) (Mb (ε + 1))) :
    s.NF lam (Ma 0) (Ma αs) (Mb 0) (Mb αs) :=
  Frame.nf_long_core hU hs hαs hpos ai ac aK bi bc bK hNF (hNF 0 hpos).2.2.2.2.2.2.1
    fun _ _ _ _ _ _ _ _ _ n1 n2 _ => Frame.nf_trans2 hU hs n1 n2

/-- AUX: not in paper. Along a witness for `NF^`, `NF` holds between any two levels (Thm 5.5.1
applied to a final segment). -/
theorem Frame.nf_interval [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {A B : Ordinal.{u} → Model U L}
    (Ai : IsIncreasing s.S.le A (Iio (Order.succ lam).ord))
    (Ac : IsContinuous A (Iio (Order.succ lam).ord))
    (Bi : IsIncreasing s.S.le B (Iio (Order.succ lam).ord))
    (Bc : IsContinuous B (Iio (Order.succ lam).ord))
    (hst : ∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)))
    {ε ζ : Ordinal.{u}} (h : ε < ζ) (hζ : ζ < (Order.succ lam).ord) :
    s.NF lam (A ε) (B ε) (A ζ) (B ζ) := by
  have hbase := Ordinal.add_sub_cancel_of_le h.le
  have hδpos : 0 < ζ - ε := by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ ζ - ε).lt_or_eq with h' | h'
    · exact h'
    · rw [← h', add_zero] at hbase; exact absurd hbase h.ne
  have hlt : ∀ i ≤ ζ - ε, ε + i < (Order.succ lam).ord := fun i hi =>
    lt_of_le_of_lt (by rw [← hbase]; exact (add_le_add_iff_left _).2 hi) hζ
  have hδ : ζ - ε < (Order.succ lam).ord := lt_of_le_of_lt (Ordinal.sub_le_self _ _) hζ
  have mkI : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing s.S.le X (Iio (Order.succ lam).ord) →
      IsIncreasing s.S.le (fun i => X (ε + i)) (Iic (ζ - ε)) := fun hX a ha b hb hab =>
    hX _ (hlt a ha) _ (hlt b hb) ((add_lt_add_iff_left _).2 hab)
  have mkC : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing s.S.le X (Iio (Order.succ lam).ord) →
      IsContinuous X (Iio (Order.succ lam).ord) →
      IsContinuous (fun i => X (ε + i)) (Iic (ζ - ε)) := by
    intro X hXi hXc b hb hl
    have hbκ := hlt b hb
    show (X (ε + b)).carrier = _
    rw [hXc _ hbκ (Ordinal.isSuccLimit_add _ hl)]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      rcases le_total ε ξ with h' | h'
      · have e : ε + (ξ - ε) = ξ := Ordinal.add_sub_cancel_of_le h'
        refine ⟨ξ - ε, (add_lt_add_iff_left ε).1 (by rw [e]; exact hξ), ?_⟩
        rw [e]; exact hx
      · refine ⟨0, hl.bot_lt, ?_⟩
        rw [add_zero]
        rcases h'.lt_or_eq with h'' | h''
        · exact (hs.1.1.ax0a).sub (hXi ξ (lt_trans h'' (lt_trans h hζ)) ε (lt_trans h hζ) h'') hx
        · rw [← h'']; exact hx
    · rintro ⟨i, hi, hx⟩
      exact ⟨ε + i, (add_lt_add_iff_left _).2 hi, hx⟩
  have hstK : ∀ α < (Order.succ lam).ord, A α ∈ s.S.Kc lam ∧ B α ∈ s.S.Kc lam := fun α hα =>
    ⟨(hst α hα).1, (hst α hα).2.1⟩
  have := Frame.nf_long hU hs hδ hδpos (mkI Ai) (mkC Ai Ac) (fun i hi => (hstK _ (hlt i hi)).1)
    (mkI Bi) (mkC Bi Bc) (fun i hi => (hstK _ (hlt i hi)).2) (fun i hi => by
      have h1 := Frame.nf_symm hU hs (hst (ε + i) (hlt i hi.le))
      show s.NF lam (A (ε + i)) (A (ε + (i + 1))) (B (ε + i)) (B (ε + (i + 1)))
      rw [← add_assoc]; exact h1)
  simp only [add_zero, hbase] at this
  exact Frame.nf_symm hU hs this

/-- AUX: not in paper. Increasing enumeration, starting from `0`, of a club of `λ⁺`. -/
theorem exists_club_enum {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {E : Set Ordinal.{u}}
    (hub : ∀ ξ < (Order.succ lam).ord, ∃ ε ∈ E, ξ < ε ∧ ε < (Order.succ lam).ord)
    (hcl : ∀ δ < (Order.succ lam).ord, Order.IsSuccLimit δ → (∀ ξ < δ, ∃ ε ∈ E, ξ < ε ∧ ε < δ) → δ ∈ E) :
    ∃ e : Ordinal.{u} → Ordinal.{u}, e 0 = 0 ∧ (∀ β < (Order.succ lam).ord, e β < (Order.succ lam).ord) ∧
      (∀ a b, a < b → b < (Order.succ lam).ord → e a < e b) ∧
      (∀ β < (Order.succ lam).ord, 0 < β → e β ∈ E) ∧
      (∀ β < (Order.succ lam).ord, Order.IsSuccLimit β → Order.IsSuccLimit (e β) ∧
        ∀ ξ < e β, ∃ γ < β, ξ < e γ) := by
  classical
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  let κ := (Order.succ lam).ord
  have hclE := hcl
  let Inv : Ordinal.{u} → (Ordinal.{u} → Ordinal.{u}) → Prop := fun α c => α < κ →
    c 0 = 0 ∧ (∀ β ≤ α, c β < κ) ∧ (∀ a b, a < b → b ≤ α → c a < c b) ∧
    (∀ β ≤ α, 0 < β → c β ∈ E) ∧
    (∀ β ≤ α, Order.IsSuccLimit β → Order.IsSuccLimit (c β) ∧ ∀ ξ < c β, ∃ γ < β, ξ < c γ)
  have hloc : ∀ α (c c' : Ordinal.{u} → Ordinal.{u}), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' h hi hα
    obtain ⟨h1, h2, h3, h4, h5⟩ := hi hα
    have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
    refine ⟨by rw [e 0 zero_le]; exact h1, fun β hβ => by rw [e β hβ]; exact h2 β hβ,
      fun a b hab hb => by rw [e a (hab.le.trans hb), e b hb]; exact h3 a b hab hb,
      fun β hβ h0 => by rw [e β hβ]; exact h4 β hβ h0, fun β hβ hl => ?_⟩
    rw [e β hβ]
    refine ⟨(h5 β hβ hl).1, fun ξ hξ => ?_⟩
    obtain ⟨γ, hγ, hx⟩ := (h5 β hβ hl).2 ξ hξ
    exact ⟨γ, hγ, by rw [e γ (hγ.le.trans hβ)]; exact hx⟩
  obtain ⟨c, hc⟩ := transfinite_construction κ Inv hloc (by
    intro α hα c hprev
    rcases hα.lt_or_eq with hακ | hακ
    swap
    · exact ⟨0, fun h => absurd h (by rw [hακ]; exact lt_irrefl _)⟩
    replace hprev := fun β (h : β < α) => hprev β h (lt_trans h hακ)
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨γ, hγ⟩ | hlim
    · subst h0
      refine ⟨0, fun _ => ?_⟩
      have hbad : ∀ {a : Ordinal.{u}}, a ≤ 0 → a = 0 := fun h => le_antisymm h zero_le
      refine ⟨if_neg (lt_irrefl _), fun β hβ => ?_, fun a b hab hb => ?_, fun β hβ h0 => ?_,
        fun β hβ hl => ?_⟩
      · rw [hbad hβ]; simp only [lt_irrefl, if_false]; exact hακ
      · exact absurd (lt_of_lt_of_le hab hb) (not_lt.2 zero_le)
      · rw [hbad hβ] at h0; exact absurd h0 (lt_irrefl _)
      · rw [hbad hβ] at hl; exact absurd hl Order.not_isSuccLimit_bot
    · rw [Order.succ_eq_add_one] at hγ
      subst hγ
      have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨p1, p2, p3, p4, p5⟩ := hprev γ hγ1
      obtain ⟨x, hxE, hx1, hx2⟩ := hub (c γ) (p2 γ le_rfl)
      refine ⟨x, fun _ => ?_⟩
      set c' : Ordinal.{u} → Ordinal.{u} := fun b => if b < γ + 1 then c b else x with hc'
      have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
      have hcx : c' (γ + 1) = x := if_neg (lt_irrefl _)
      have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
        rcases hb.lt_or_eq with h | h
        · exact Or.inl (Order.lt_add_one_iff.1 h)
        · exact Or.inr h
      have hleγ : ∀ a ≤ γ, c a ≤ c γ := fun a ha => by
        rcases ha.lt_or_eq with h | h
        · exact (p3 a γ h le_rfl).le
        · rw [h]
      refine ⟨by rw [hcl 0 zero_le]; exact p1, fun β hβ => ?_, fun a b hab hb => ?_,
        fun β hβ h0 => ?_, fun β hβ hl => ?_⟩
      · rcases hcases β hβ with h | h
        · rw [hcl β h]; exact p2 β h
        · rw [h, hcx]; exact hx2
      · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
        rw [hcl a haγ]
        rcases hcases b hb with h | h
        · rw [hcl b h]; exact p3 a b hab h
        · rw [h, hcx]; exact lt_of_le_of_lt (hleγ a haγ) hx1
      · rcases hcases β hβ with h | h
        · rw [hcl β h]; exact p4 β h h0
        · rw [h, hcx]; exact hxE
      · have hβγ : β ≤ γ := by
          rcases hcases β hβ with h | h
          · exact h
          · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax γ)
        rw [hcl β hβγ]
        refine ⟨(p5 β hβγ hl).1, fun ξ hξ => ?_⟩
        obtain ⟨g, hg, hx⟩ := (p5 β hβγ hl).2 ξ hξ
        exact ⟨g, hg, by rw [hcl g (hg.le.trans hβγ)]; exact hx⟩
    · have h0α : (0 : Ordinal.{u}) < α := hlim.bot_lt
      have hstrict : ∀ a < α, ∀ b < α, a < b → c a < c b := fun a _ b hb h =>
        (hprev b hb).2.2.1 a b h le_rfl
      let et := Ordinal.ToType.mk (o := α)
      let f : α.ToType → Ordinal.{u} := fun i => c (et.symm i : Ordinal.{u})
      have hle : ∀ β < α, c β ≤ iSup f := fun β hβ => by
        have h3 := Ordinal.le_iSup f (et ⟨β, hβ⟩)
        simpa [f] using h3
      have hcard : #α.ToType < κ.cof := by
        rw [hreg.cof_ord, Cardinal.mk_toType]
        exact Cardinal.lt_ord.1 hακ
      have hsup : iSup f < κ := Ordinal.iSup_lt_of_lt_cof hcard fun i =>
        (hprev _ (et.symm i).2).2.1 _ le_rfl
      have hbelow : ∀ ξ < iSup f, ∃ β < α, ξ < c β := fun ξ hξ => by
        by_contra hno
        push Not at hno
        have : iSup f ≤ ξ := ciSup_le' fun i => hno _ (et.symm i).2
        exact absurd hξ (not_lt.2 this)
      have hlts : ∀ β < α, c β < iSup f := fun β hβ =>
        lt_of_lt_of_le (hstrict β hβ _ (hlim.add_one_lt hβ) (Order.lt_add_one_iff.2 le_rfl))
          (hle _ (hlim.add_one_lt hβ))
      have hxl : Order.IsSuccLimit (iSup f) := by
        rcases Ordinal.zero_or_succ_or_isSuccLimit (iSup f) with h' | ⟨d, hd⟩ | h'
        · have := hlts 0 h0α; rw [h'] at this; exact absurd this (not_lt.2 zero_le)
        · rw [Order.succ_eq_add_one] at hd
          obtain ⟨β, hβ, hx⟩ := hbelow d (by rw [← hd]; exact Order.lt_add_one_iff.2 le_rfl)
          have h2 := hlts β hβ
          rw [← hd] at h2
          exact absurd h2 (not_lt.2 (Order.add_one_le_iff.2 hx))
        · exact h'
      refine ⟨iSup f, fun _ => ?_⟩
      set c' : Ordinal.{u} → Ordinal.{u} := fun b => if b < α then c b else iSup f with hc'
      have hcl : ∀ b < α, c' b = c b := fun b hb => if_pos hb
      have hcx : c' α = iSup f := if_neg (lt_irrefl _)
      have hp0 := hprev 0 h0α
      refine ⟨by rw [hcl 0 h0α]; exact hp0.1, fun β hβ => ?_, fun a b hab hb => ?_, fun β hβ h0 => ?_,
        fun β hβ hl => ?_⟩
      · rcases hβ.lt_or_eq with h | h
        · rw [hcl β h]; exact (hprev β h).2.1 β le_rfl
        · rw [h, hcx]; exact hsup
      · have haα := lt_of_lt_of_le hab hb
        rw [hcl a haα]
        rcases hb.lt_or_eq with h | h
        · rw [hcl b h]; exact hstrict a haα b h hab
        · rw [h, hcx]; exact hlts a haα
      · rcases hβ.lt_or_eq with h | h
        · rw [hcl β h]; exact (hprev β h).2.2.2.1 β le_rfl h0
        · rw [h, hcx]
          refine hclE _ hsup hxl fun ξ hξ => ?_
          obtain ⟨g, hg, hx⟩ := hbelow ξ hξ
          have hg1 := hlim.add_one_lt hg
          exact ⟨c (g + 1), (hprev _ hg1).2.2.2.1 _ le_rfl (lt_of_le_of_lt zero_le
            (Order.lt_add_one_iff.2 le_rfl)), lt_trans hx (hstrict g hg _ hg1
            (Order.lt_add_one_iff.2 le_rfl)), hlts _ hg1⟩
      · rcases hβ.lt_or_eq with h | h
        · rw [hcl β h]
          refine ⟨((hprev β h).2.2.2.2 β le_rfl hl).1, fun ξ hξ => ?_⟩
          obtain ⟨g, hg, hx⟩ := ((hprev β h).2.2.2.2 β le_rfl hl).2 ξ hξ
          exact ⟨g, hg, by rw [hcl g (lt_trans hg h)]; exact hx⟩
        · rw [h, hcx]
          refine ⟨hxl, fun ξ hξ => ?_⟩
          obtain ⟨g, hg, hx⟩ := hbelow ξ hξ
          exact ⟨g, hg, by rw [hcl g hg]; exact hx⟩)
  have hI := fun α (h : α < κ) => hc α h.le h
  have h0κ : (0 : Ordinal.{u}) < κ :=
    (Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))).bot_lt
  exact ⟨c, (hI 0 h0κ).1, fun β hβ => (hI β hβ).2.1 β le_rfl,
    fun a b hab hb => (hI b hb).2.2.1 a b hab le_rfl, fun β hβ h0 => (hI β hβ).2.2.2.1 β le_rfl h0,
    fun β hβ hl => (hI β hβ).2.2.2.2 β le_rfl hl⟩

/-- AUX: not in paper. Two filtrations of the same set agree on a club of `λ⁺`. -/
theorem filt_club {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {F G : Ordinal.{u} → Set U}
    (Fi : ∀ a b, a ≤ b → b < (Order.succ lam).ord → F a ⊆ F b)
    (Gi : ∀ a b, a ≤ b → b < (Order.succ lam).ord → G a ⊆ G b)
    (Fc : ∀ b < (Order.succ lam).ord, Order.IsSuccLimit b → F b = ⋃ ξ ∈ Iio b, F ξ)
    (Gc : ∀ b < (Order.succ lam).ord, Order.IsSuccLimit b → G b = ⋃ ξ ∈ Iio b, G ξ)
    (Fcard : ∀ a < (Order.succ lam).ord, #(F a) ≤ lam)
    (Gcard : ∀ a < (Order.succ lam).ord, #(G a) ≤ lam)
    (hun : (⋃ a ∈ Iio (Order.succ lam).ord, F a) = ⋃ a ∈ Iio (Order.succ lam).ord, G a) :
    (∀ ξ < (Order.succ lam).ord, ∃ ε ∈ {ε | F ε = G ε}, ξ < ε ∧ ε < (Order.succ lam).ord) ∧
    (∀ δ < (Order.succ lam).ord, Order.IsSuccLimit δ →
      (∀ ξ < δ, ∃ ε ∈ {ε | F ε = G ε}, ξ < ε ∧ ε < δ) → δ ∈ {ε | F ε = G ε}) := by
  classical
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have cov : ∀ {F G : Ordinal.{u} → Set U}, (∀ a b, a ≤ b → b < (Order.succ lam).ord → G a ⊆ G b) →
      (∀ a < (Order.succ lam).ord, #(F a) ≤ lam) →
      ((⋃ a ∈ Iio (Order.succ lam).ord, F a) = ⋃ a ∈ Iio (Order.succ lam).ord, G a) →
      ∀ ε < (Order.succ lam).ord, ∃ ζ < (Order.succ lam).ord, ε ≤ ζ ∧ F ε ⊆ G ζ := by
    intro F G Gi Fcard hun ε hε
    have hex : ∀ x : F ε, ∃ ζ < (Order.succ lam).ord, x.1 ∈ G ζ := fun x => by
      have hx : x.1 ∈ ⋃ a ∈ Iio (Order.succ lam).ord, F a := Set.mem_iUnion₂.2 ⟨ε, hε, x.2⟩
      rw [hun] at hx
      obtain ⟨ζ, hζ, h⟩ := Set.mem_iUnion₂.1 hx
      exact ⟨ζ, hζ, h⟩
    choose f hf hfG using hex
    have hsup : iSup f < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
      (by rw [hreg.cof_ord]; exact Order.lt_succ_iff.2 (Fcard ε hε)) hf
    refine ⟨max ε (iSup f), max_lt hε hsup, le_max_left _ _, fun x hx => ?_⟩
    exact Gi _ _ ((Ordinal.le_iSup f ⟨x, hx⟩).trans (le_max_right _ _)) (max_lt hε hsup)
      (hfG ⟨x, hx⟩)
  have hnext : ∀ ε, ∃ ζ, ε < (Order.succ lam).ord → (ε < ζ ∧ ζ < (Order.succ lam).ord ∧ F ε ⊆ G ζ ∧
      G ε ⊆ F ζ) := fun ε => by
    by_cases hε : ε < (Order.succ lam).ord
    · obtain ⟨ζ₁, h1, -, h1F⟩ := cov Gi Fcard hun ε hε
      obtain ⟨ζ₂, h2, -, h2G⟩ := cov Fi Gcard hun.symm ε hε
      have hm := max_lt h1 h2
      have hm1 := hκl.add_one_lt (max_lt hε hm)
      refine ⟨_, fun _ => ⟨?_, hm1, ?_, ?_⟩⟩
      · exact lt_of_le_of_lt (le_max_left _ _) (Order.lt_add_one_iff.2 le_rfl)
      · exact h1F.trans (Gi _ _ ((le_max_left _ _).trans ((le_max_right _ _).trans
          (Order.lt_add_one_iff.2 le_rfl).le)) hm1)
      · exact h2G.trans (Fi _ _ ((le_max_right _ _).trans ((le_max_right _ _).trans
          (Order.lt_add_one_iff.2 le_rfl).le)) hm1)
    · exact ⟨0, fun h => absurd h hε⟩
  choose nxt hnxt using hnext
  refine ⟨fun ξ hξ => ?_, fun δ hδ hl h => ?_⟩
  · let h : ℕ → Ordinal.{u} := fun n => Nat.rec ξ (fun _ x => nxt x) n
    have hlt : ∀ n, h n < (Order.succ lam).ord := fun n => by
      induction n with
      | zero => exact hξ
      | succ n ih => exact (hnxt _ ih).2.1
    have hs : ∀ n, h n < h (n + 1) := fun n => (hnxt _ (hlt n)).1
    have hmono : ∀ m n, m ≤ n → h m ≤ h n := fun m n hmn => by
      induction n, hmn using Nat.le_induction with
      | base => exact le_rfl
      | succ n _ ih => exact ih.trans (hs n).le
    let hu : ULift.{u} ℕ → Ordinal.{u} := fun n => h n.down
    have hsup : iSup hu < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
      (by
        have hc : #(ULift.{u} ℕ) = ℵ₀ := by simp
        rw [hreg.cof_ord, hc]
        exact lt_of_le_of_lt hinf (Order.lt_succ lam)) fun n => hlt n.down
    have hle : ∀ n, h n ≤ iSup hu := fun n => Ordinal.le_iSup hu ⟨n⟩
    have hlts : ∀ n, h n < iSup hu := fun n => lt_of_lt_of_le (hs n) (hle (n + 1))
    have hbelow : ∀ x < iSup hu, ∃ n, x < h n := fun x hx => by
      by_contra hno
      push Not at hno
      exact absurd hx (not_lt.2 (ciSup_le' fun n => hno n.down))
    have hl : Order.IsSuccLimit (iSup hu) := by
      rcases Ordinal.zero_or_succ_or_isSuccLimit (iSup hu) with h' | ⟨d, hd⟩ | h'
      · have := hlts 0; rw [h'] at this; exact absurd this (not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at hd
        obtain ⟨n, hn⟩ := hbelow d (by rw [← hd]; exact Order.lt_add_one_iff.2 le_rfl)
        have h2 := hlts n
        rw [← hd] at h2
        exact absurd h2 (not_lt.2 (Order.add_one_le_iff.2 hn))
      · exact h'
    refine ⟨iSup hu, ?_, hlts 0, hsup⟩
    show F (iSup hu) = G (iSup hu)
    rw [Fc _ hsup hl, Gc _ hsup hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨y, hy, hx⟩
      obtain ⟨n, hn⟩ := hbelow y hy
      exact ⟨h (n + 1), hlts (n + 1), (hnxt _ (hlt n)).2.2.1 (Fi _ _ hn.le (hlt n) hx)⟩
    · rintro ⟨y, hy, hx⟩
      obtain ⟨n, hn⟩ := hbelow y hy
      exact ⟨h (n + 1), hlts (n + 1), (hnxt _ (hlt n)).2.2.2 (Gi _ _ hn.le (hlt n) hx)⟩
  · show F δ = G δ
    rw [Fc δ hδ hl, Gc δ hδ hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨y, hy, hx⟩
      obtain ⟨ε, hε, hyε, hεδ⟩ := h y hy
      refine ⟨ε, hεδ, ?_⟩
      have e : F ε = G ε := hε
      rw [← e]; exact Fi _ _ hyε.le (lt_trans hεδ hδ) hx
    · rintro ⟨y, hy, hx⟩
      obtain ⟨ε, hε, hyε, hεδ⟩ := h y hy
      refine ⟨ε, hεδ, ?_⟩
      have e : F ε = G ε := hε
      rw [e]; exact Gi _ _ hyε.le (lt_trans hεδ hδ) hx

/-- AUX: not in paper. A filtration of a model of `K_{λ⁺}`, starting from a given `N₀ ≼ M` in
`K_λ`. -/
theorem IsAEC.exists_filtration {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}}
    (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {M N₀ : Model U L} (hM : M ∈ S.Kc (Order.succ lam))
    (hN₀ : N₀ ∈ S.Kc lam) (hle : S.le N₀ M) :
    ∃ A : Ordinal.{u} → Model U L, A 0 = N₀ ∧
      (∀ α < (Order.succ lam).ord, A α ∈ S.Kc lam ∧ S.le (A α) M) ∧
      IsIncreasing S.lt A (Iio (Order.succ lam).ord) ∧
      IsContinuous A (Iio (Order.succ lam).ord) ∧ IsUnionOf A (Iio (Order.succ lam).ord) M := by
  classical
  let κ := (Order.succ lam).ord
  have hκl : Order.IsSuccLimit κ := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hcM : #M.carrier = Order.succ lam := hM.2
  have hne : (M.carrier).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro he
    have h00 : #(∅ : Set U) = 0 := by simp
    rw [he, h00] at hcM
    exact absurd hcM.symm (ne_of_gt (lt_of_le_of_lt zero_le (Order.lt_succ lam)))
  have hty : #κ.ToType = #M.carrier := by rw [Cardinal.mk_toType, Cardinal.card_ord, hcM]
  obtain ⟨E⟩ := Cardinal.eq.1 hty
  let et := Ordinal.ToType.mk (o := κ)
  obtain ⟨y₀, hy₀⟩ := hne
  let x : Ordinal.{u} → U := fun ξ => if h : ξ < κ then (E (et ⟨ξ, h⟩) : U) else y₀
  have hxM : ∀ ξ < κ, x ξ ∈ M.carrier := fun ξ h => by
    simp only [x, h, dite_true]; exact (E _).2
  have hxS : ∀ y ∈ M.carrier, ∃ ξ < κ, x ξ = y := fun y hy => by
    refine ⟨(et.symm (E.symm ⟨y, hy⟩) : Ordinal.{u}), (et.symm _).2, ?_⟩
    have h : ((et.symm (E.symm ⟨y, hy⟩) : Iio κ) : Ordinal.{u}) < κ := (et.symm (E.symm ⟨y, hy⟩)).2
    simp only [x]
    rw [dif_pos h]
    show ((E (et (et.symm (E.symm ⟨y, hy⟩)))) : U) = y
    rw [OrderIso.apply_symm_apply, Equiv.apply_symm_apply]
  haveI : Nonempty (Model U L) := ⟨N₀⟩
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c => α < κ →
    (∀ β ≤ α, c β ∈ S.Kc lam ∧ S.le (c β) M) ∧ c 0 = N₀ ∧ IsIncreasing S.le c (Iic α) ∧
    IsContinuous c (Iic α) ∧ ∀ β, β + 1 ≤ α → x β ∈ (c (β + 1)).carrier ∧ c β ≠ c (β + 1)
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' h hi hα
    obtain ⟨h1, h2, h3, h4, h5⟩ := hi hα
    have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
    refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e 0 zero_le]; exact h2,
      fun a ha b hb hl => by rw [e a ha, e b hb]; exact h3 a ha b hb hl, fun b hb hl => ?_,
      fun β hβ => ?_⟩
    · rw [e b hb, h4 b hb hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hb)]
    · rw [e β ((Order.lt_add_one_iff.2 le_rfl).le.trans hβ), e (β + 1) hβ]; exact h5 β hβ
  obtain ⟨c, hc⟩ := transfinite_construction κ Inv hloc (by
    intro α hα c hprev
    rcases hα.lt_or_eq with hακ | hακ
    swap
    · exact ⟨N₀, fun h => absurd h (by rw [hακ]; exact lt_irrefl _)⟩
    replace hprev := fun β (h : β < α) => hprev β h (lt_trans h hακ)
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨γ, hγ⟩ | hlim
    · subst h0
      refine ⟨N₀, fun _ => ?_⟩
      have hc0 : (fun b => if b < (0 : Ordinal.{u}) then c b else N₀) = fun _ => N₀ :=
        funext fun b => if_neg (not_lt.2 zero_le)
      rw [hc0]
      have hz : ∀ b ≤ (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
      refine ⟨fun _ _ => ⟨hN₀, hle⟩, rfl, fun a _ b hb h => absurd (lt_of_lt_of_le h hb) (not_lt.2 zero_le),
        fun b hb hl => ?_, fun β hβ => ?_⟩
      · rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
      · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hβ) (not_lt.2 zero_le)
    · rw [Order.succ_eq_add_one] at hγ
      subst hγ
      have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨p1, p2, p3, p4, p5⟩ := hprev γ hγ1
      obtain ⟨hK, hLe⟩ := p1 γ le_rfl
      have hγκ : γ < κ := lt_trans hγ1 hακ
      have hex : ∃ y ∈ M.carrier, y ∉ (c γ).carrier := by
        by_contra hno
        push Not at hno
        have h1 : Order.succ lam ≤ lam := by
          rw [← hcM, ← hK.2]; exact Model.card_le_of_sub hno |> fun h => h
        exact absurd h1 (not_le.2 (Order.lt_succ lam))
      obtain ⟨y, hyM, hyn⟩ := hex
      have hAc : #((c γ).carrier ∪ {x γ, y} : Set U) ≤ lam := by
        refine (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq hK.2) ?_)
        exact (Cardinal.mk_insert_le.trans (by simp)).trans hinf
      obtain ⟨W, hW, hsub, hWM⟩ := hS.exists_hull hlst hinf hK hM.1 Set.subset_union_left
        (Set.union_subset (hS.sub hLe) (by
          rintro z (rfl | rfl)
          · exact hxM γ hγκ
          · exact hyM)) hAc
      have hcW : S.le (c γ) W := hS.le_of_sub hLe hWM (Set.subset_union_left.trans hsub)
      refine ⟨W, fun _ => ?_⟩
      set c' : Ordinal.{u} → Model U L := fun b => if b < γ + 1 then c b else W with hc'
      have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
      have hcx : c' (γ + 1) = W := if_neg (lt_irrefl _)
      have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
        rcases hb.lt_or_eq with h | h
        · exact Or.inl (Order.lt_add_one_iff.1 h)
        · exact Or.inr h
      have hle1 : ∀ b ≤ γ, S.le (c b) (c γ) := fun b hb => by
        rcases hb.lt_or_eq with h | h
        · exact p3 b hb γ (Set.mem_Iic.2 le_rfl) h
        · rw [h]; exact hS.refl hK.1
      refine ⟨fun β hβ => ?_, by rw [hcl 0 zero_le]; exact p2, fun a ha b hb hl => ?_,
        fun b hb hl => ?_, fun β hβ => ?_⟩
      · rcases hcases β hβ with h | h
        · rw [hcl β h]; exact p1 β h
        · rw [h, hcx]; exact ⟨hW, hWM⟩
      · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hb)
        rw [hcl a haγ]
        rcases hcases b hb with h | h
        · rw [hcl b h]; exact p3 a haγ b h hl
        · rw [h, hcx]; exact hS.trans (hle1 a haγ) hcW
      · have hbγ : b ≤ γ := by
          rcases hcases b hb with h | h
          · exact h
          · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax γ)
        rw [hcl b hbγ, p4 b hbγ hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hbγ)]
      · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hβ)
        rcases hβγ.lt_or_eq with h | h
        · have hb1 : β + 1 ≤ γ := Order.add_one_le_iff.2 h
          rw [hcl β hβγ, hcl (β + 1) hb1]; exact p5 β hb1
        · subst h
          rw [hcl β le_rfl, hcx]
          exact ⟨hsub (Or.inr (Or.inl rfl)), fun e => hyn (by rw [e]; exact hsub (Or.inr (Or.inr rfl)))⟩
    · have h0α : (0 : Ordinal.{u}) < α := hlim.bot_lt
      have hαcard : α.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hακ)
      have hK : ∀ β < α, c β ∈ S.Kc lam ∧ S.le (c β) M := fun β hβ => (hprev β hβ).1 β le_rfl
      have hinc : IsIncreasing S.le c (Iio α) := fun β hβ β' hβ' h =>
        (hprev β' hβ').2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h
      have hcont : IsContinuous c (Iio α) := fun β hβ hl =>
        (hprev β hβ).2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl
      obtain ⟨Nα, hU', -, -⟩ := hS.union α hlim _ hinc hcont
      obtain ⟨hNαK, hleN⟩ := hS.le_union hlim hinc hcont hU'
      have hNc : Nα ∈ S.Kc lam := by
        refine ⟨hNαK, le_antisymm ?_ ?_⟩
        · change #Nα.carrier ≤ lam
          rw [hU'.1]
          exact card_biUnion_le hinf hαcard fun β hβ => le_of_eq (hK β hβ).1.2
        · rw [← (hK 0 h0α).1.2]; exact Model.card_le_of_sub (hS.sub (hleN 0 h0α))
      have hNM : S.le Nα M := hS.smooth α hlim _ M hinc hcont (fun β hβ => (hK β hβ).2) Nα hU' hNαK
      refine ⟨Nα, fun _ => ?_⟩
      set c' : Ordinal.{u} → Model U L := fun b => if b < α then c b else Nα with hc'
      have hcl : ∀ b < α, c' b = c b := fun b hb => if_pos hb
      have hcx : c' α = Nα := if_neg (lt_irrefl _)
      refine ⟨fun β hβ => ?_, by rw [hcl 0 h0α]; exact (hprev 0 h0α).2.1, fun a ha b hb hl => ?_,
        fun b hb hl => ?_, fun β hβ => ?_⟩
      · rcases hβ.lt_or_eq with h | h
        · rw [hcl β h]; exact hK β h
        · rw [h, hcx]; exact ⟨hNc, hNM⟩
      · have haα := lt_of_lt_of_le hl hb
        rw [hcl a haα]
        rcases (show b ≤ α from hb).lt_or_eq with h | h
        · rw [hcl b h]; exact hinc a haα b h hl
        · rw [h, hcx]; exact hleN a haα
      · rcases (show b ≤ α from hb).lt_or_eq with h | h
        · rw [hcl b h, hcont b h hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
        · rw [h, hcx, hU'.1]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
      · have hb1 : β + 1 < α := lt_of_le_of_ne hβ fun h => by
          rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax β)
        have hb' : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
        rw [hcl β hb', hcl (β + 1) hb1]
        exact (hprev (β + 1) hb1).2.2.2.2 β le_rfl)
  have hI := fun α (h : α < κ) => hc α h.le h
  have h0κ : (0 : Ordinal.{u}) < κ := hκl.bot_lt
  have hinc : IsIncreasing S.le c (Iio κ) := fun a _ b hb h =>
    (hI b hb).2.2.1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h
  have hst : ∀ β < κ, c β ≠ c (β + 1) := fun β hβ =>
    ((hI _ (hκl.add_one_lt hβ)).2.2.2.2 β le_rfl).2
  refine ⟨c, (hI 0 h0κ).2.1, fun α hα => (hI α hα).1 α le_rfl, fun a ha b hb h => ⟨hinc a ha b hb h, fun e => ?_⟩,
    fun b hb hl => (hI b hb).2.2.2.1 b (Set.mem_Iic.2 le_rfl) hl, ?_, fun α hα => ?_⟩
  · have h1 : a + 1 ≤ b := Order.add_one_le_iff.2 h
    have ha1 : a + 1 < κ := lt_of_le_of_lt h1 hb
    have h2 : S.le (c a) (c (a + 1)) := hinc a ha (a + 1) ha1 (Order.lt_add_one_iff.2 le_rfl)
    refine hst a ha (hS.po.2.2.1 _ _ h2 ?_)
    rcases h1.lt_or_eq with h' | h'
    · have := hinc (a + 1) ha1 b hb h'; rwa [← e] at this
    · rw [h', ← e]; exact hS.refl ((hI a ha).1 a le_rfl).1.1
  · ext y
    constructor
    · intro hy
      obtain ⟨ξ, hξ, rfl⟩ := hxS y hy
      exact Set.mem_iUnion₂.2 ⟨ξ + 1, hκl.add_one_lt hξ,
        ((hI _ (hκl.add_one_lt hξ)).2.2.2.2 ξ le_rfl).1⟩
    · intro hy
      obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hy
      exact hS.sub ((hI ξ hξ).1 ξ le_rfl).2 h
  · exact hS.incl _ _ ((hI α hα).1 α le_rfl).2

/-- AUX: not in paper. Composition of a chain with a continuous increasing `e`. -/
theorem IsAEC.comp_chain {S : KSys U L} (hS : IsAEC S) {κ : Ordinal.{u}}
    {X : Ordinal.{u} → Model U L} (Xi : IsIncreasing S.le X (Iio κ)) (Xc : IsContinuous X (Iio κ))
    {e : Ordinal.{u} → Ordinal.{u}} (he : ∀ β < κ, e β < κ) (hm : ∀ a b, a < b → b < κ → e a < e b)
    (hl : ∀ β < κ, Order.IsSuccLimit β → Order.IsSuccLimit (e β) ∧ ∀ ξ < e β, ∃ γ < β, ξ < e γ) :
    IsIncreasing S.le (fun β => X (e β)) (Iio κ) ∧ IsContinuous (fun β => X (e β)) (Iio κ) := by
  refine ⟨fun a ha b hb h => Xi _ (he a ha) _ (he b hb) (hm a b h hb), fun b hb hlb => ?_⟩
  show (X (e b)).carrier = _
  rw [Xc _ (he b hb) (hl b hb hlb).1]
  ext x
  simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
  constructor
  · rintro ⟨ξ, hξ, hx⟩
    obtain ⟨γ, hγ, h⟩ := (hl b hb hlb).2 ξ hξ
    have hγκ := lt_trans hγ hb
    exact ⟨γ, hγ, hS.sub (Xi ξ (lt_trans h (he γ hγκ)) _ (he γ hγκ) h) hx⟩
  · rintro ⟨γ, hγ, hx⟩
    exact ⟨e γ, hm γ b hγ hb, hx⟩

/-- AUX: not in paper. The union along a strictly increasing `e`. -/
theorem IsUnionOf.comp {κ : Ordinal.{u}} {X : Ordinal.{u} → Model U L} {T : Model U L}
    (hT : IsUnionOf X (Iio κ) T) {e : Ordinal.{u} → Ordinal.{u}} (he : ∀ β < κ, e β < κ)
    (hm : ∀ a b, a < b → b < κ → e a < e b)
    (Xs : ∀ a < κ, ∀ b < κ, a ≤ b → (X a).carrier ⊆ (X b).carrier) :
    IsUnionOf (fun β => X (e β)) (Iio κ) T := by
  have hid : ∀ β < κ, β ≤ e β := by
    intro β
    induction β using Ordinal.lt_wf.induction with
    | ind β ih =>
    intro hβ
    by_contra hno
    have h1 : e β < β := not_le.1 hno
    exact absurd (hm _ _ h1 hβ) (not_lt.2 (ih _ h1 (lt_trans h1 hβ)))
  refine ⟨?_, fun β hβ => hT.2 _ (he β hβ)⟩
  rw [hT.1]
  ext x
  simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
  constructor
  · rintro ⟨ξ, hξ, hx⟩
    exact ⟨ξ, hξ, Xs ξ hξ _ (he ξ hξ) (hid ξ hξ) hx⟩
  · rintro ⟨β, hβ, hx⟩
    exact ⟨e β, he β hβ, hx⟩

/-- Thm 6.1.3(a), disjointness: `NF^(N₀, N₁, M₀, M₁) → N₁ ∩ M₀ = N₀`. -/
theorem thm_6_1_3_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (N₀ N₁ M₀ M₁ : Model U L) (h : s.NFhat lam N₀ N₁ M₀ M₁) :
    N₁.carrier ∩ M₀.carrier = N₀.carrier := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, -, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, -⟩ := h
  have hκl := Cardinal.isSuccLimit_ord
    ((Frame.aleph0_le hc (hst 0 (Cardinal.ord_pos.2 (lt_of_le_of_lt zero_le (Order.lt_succ lam)))).1 |>
      fun h => h).trans (Order.le_succ lam))
  have h0κ : (0 : Ordinal.{u}) < (Order.succ lam).ord := hκl.bot_lt
  have hd : ∀ ε < (Order.succ lam).ord, (B ε).carrier ∩ (A (ε + 1)).carrier = (A ε).carrier :=
    fun ε hε => (prop_5_3_6 lam hU s hs _ _ _ _).2 (hst ε hε)
  have key : ∀ ε < (Order.succ lam).ord, N₁.carrier ∩ (A ε).carrier ⊆ N₀.carrier := by
    intro ε
    induction ε using Ordinal.lt_wf.induction with
    | ind ε ih =>
    rintro hε x ⟨hx1, hx2⟩
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h | ⟨γ, hγ⟩ | hl
    · subst h; rw [hA0] at hx2; exact hx2
    · rw [Order.succ_eq_add_one] at hγ
      subst hγ
      have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
      have hγκ := lt_trans hγ1 hε
      have hxB : x ∈ (B γ).carrier := by
        rw [← hB0] at hx1
        rcases (zero_le : (0 : Ordinal.{u}) ≤ γ).lt_or_eq with h | h
        · exact hS.sub (Bi 0 h0κ γ hγκ h) hx1
        · rw [← h]; exact hx1
      exact ih γ hγ1 hγκ ⟨hx1, by rw [← hd γ hγκ]; exact ⟨hxB, hx2⟩⟩
    · rw [Ac ε hε hl] at hx2
      obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx2
      exact ih ξ hξ (lt_trans hξ hε) ⟨hx1, hxξ⟩
  have h01 : s.S.le N₀ N₁ := by have := (hst 0 h0κ).2.2.2.2.1; rwa [hA0, hB0] at this
  ext x
  constructor
  · rintro ⟨hx1, hx2⟩
    rw [hMA.1] at hx2
    obtain ⟨ε, hε, hxε⟩ := Set.mem_iUnion₂.1 hx2
    exact key ε hε ⟨hx1, hxε⟩
  · intro hx
    refine ⟨hS.sub h01 hx, ?_⟩
    rw [hMA.1]
    exact Set.mem_iUnion₂.2 ⟨0, h0κ, by rw [hA0]; exact hx⟩

/-- Thm 6.1.3(b), monotonicity: `NF^(N₀, N₁, M₀, M₁)`, `N₀ ≼ N₁* ≼ N₁`, `N₁* ∪ M₀ ⊆ M₁* ≼ M₁`,
`M₁* ∈ K_{λ⁺}` imply `NF^(N₀, N₁*, M₀, M₁*)`. -/
theorem thm_6_1_3_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (N₀ N₁ M₀ M₁ N₁s M₁s : Model U L) (h : s.NFhat lam N₀ N₁ M₀ M₁) (h1 : s.S.le N₀ N₁s)
    (h2 : s.S.le N₁s N₁) (h3 : N₁s.carrier ∪ M₀.carrier ⊆ M₁s.carrier) (h4 : s.S.le M₁s M₁)
    (h5 : M₁s ∈ s.S.Kc (Order.succ lam)) : s.NFhat lam N₀ N₁s M₀ M₁s := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have h0κ := hκl.bot_lt
  obtain ⟨-, hleA⟩ := hS.le_union hκl Ai Ac hMA
  obtain ⟨-, hleB⟩ := hS.le_union hκl Bi Bc hMB
  have hN₁M : s.S.le N₁ M₁ := by have := hleB 0 h0κ; rwa [hB0] at this
  have hN₁sK : N₁s ∈ s.S.Kc lam := ⟨hS.mem_left h2, le_antisymm
    (by rw [← k1.2]; exact Model.card_le_of_sub (hS.sub h2))
    (by rw [← k0.2]; exact Model.card_le_of_sub (hS.sub h1))⟩
  have hN₁sM : s.S.le N₁s M₁s := hS.le_of_sub (hS.trans h2 hN₁M) h4
    (Set.subset_union_left.trans h3)
  obtain ⟨C, hC0, hCK, Ci, Cc, hCU⟩ := hS.exists_filtration hc.ax0b hinf h5 hN₁sK hN₁sM
  have Cile : IsIncreasing s.S.le C (Iio (Order.succ lam).ord) := fun a ha b hb h => (Ci a ha b hb h).1
  have hK : ∀ α < (Order.succ lam).ord, A α ∈ s.S.Kc lam ∧ B α ∈ s.S.Kc lam ∧ s.S.le (A α) (B α) :=
    fun α hα => ⟨(hst α hα).1, (hst α hα).2.1, (hst α hα).2.2.2.2.1⟩
  have Bs : ∀ a b, a ≤ b → b < (Order.succ lam).ord → (B a).carrier ⊆ (B b).carrier := fun a b h hb => by
    rcases h.lt_or_eq with h | h
    · exact hS.sub (Bi a (lt_trans h hb) b hb h)
    · rw [h]
  have Csl : ∀ a b, a ≤ b → b < (Order.succ lam).ord → (C a).carrier ⊆ (C b).carrier := fun a b h hb => by
    rcases h.lt_or_eq with h | h
    · exact hS.sub (Cile a (lt_trans h hb) b hb h)
    · rw [h]
  obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (B ε).carrier ∩ M₁s.carrier)
    (G := fun ε => (C ε).carrier) (fun a b h hb => Set.inter_subset_inter_left _ (Bs a b h hb)) Csl
    (fun b hb hl => by
      show (B b).carrier ∩ M₁s.carrier = _
      rw [Bc b hb hl]
      ext x
      simp only [Set.mem_inter_iff, Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      exact ⟨fun ⟨⟨ξ, hξ, hx⟩, h'⟩ => ⟨ξ, hξ, hx, h'⟩, fun ⟨ξ, hξ, hx, h'⟩ => ⟨⟨ξ, hξ, hx⟩, h'⟩⟩)
    (fun b hb hl => Cc b hb hl)
    (fun a ha => (Cardinal.mk_le_mk_of_subset Set.inter_subset_left).trans (le_of_eq (hK a ha).2.1.2))
    (fun a ha => le_of_eq (hCK a ha).1.2)
    (by
      rw [← hCU.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_inter_iff, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, -, -, hx⟩; exact hx
      · intro hx
        have hx1 := hS.sub h4 hx
        rw [hMB.1] at hx1
        obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx1
        exact ⟨ξ, hξ, hxξ, hx⟩)
  obtain ⟨e, e0, eκ, em, eE, el⟩ := exists_club_enum hinf hub hcl
  have hA'i := hS.comp_chain Ai Ac eκ em el
  have hC'i := hS.comp_chain Cile Cc eκ em el
  have hCB : ∀ β < (Order.succ lam).ord, s.S.le (C (e β)) (B (e β)) := fun β hβ => by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h' | h'
    · have hF : (B (e β)).carrier ∩ M₁s.carrier = (C (e β)).carrier := eE β hβ h'
      exact hS.le_of_sub (hS.trans (hCK _ (eκ β hβ)).2 h4) (hleB _ (eκ β hβ))
        (by rw [← hF]; exact Set.inter_subset_left)
    · rw [← h', e0, hC0, hB0]; exact h2
  have hAC : ∀ β < (Order.succ lam).ord, s.S.le (A (e β)) (C (e β)) := fun β hβ => by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h' | h'
    · have hF : (B (e β)).carrier ∩ M₁s.carrier = (C (e β)).carrier := eE β hβ h'
      have hABle := (hK _ (eκ β hβ)).2.2
      refine hS.le_of_sub (hS.trans hABle (hleB _ (eκ β hβ))) (hS.trans (hCK _ (eκ β hβ)).2 h4) ?_
      rw [← hF]
      intro x hx
      exact ⟨hS.sub hABle hx, h3 (Or.inr (hS.sub (hleA _ (eκ β hβ)) hx))⟩
    · rw [← h', e0, hA0, hC0]; exact h1
  refine ⟨k0, hN₁sK, kM₀, h5, fun β => A (e β), fun β => C (e β), hA'i.1, hA'i.2, hC'i.1, hC'i.2,
    fun β hβ => ?_, by show A (e 0) = N₀; rw [e0, hA0], by show C (e 0) = N₁s; rw [e0, hC0],
    hMA.comp eκ em fun a ha b hb h => by
      rcases h.lt_or_eq with h | h
      · exact hS.sub (Ai a ha b hb h)
      · rw [h],
    hCU.comp eκ em fun a ha b hb h => Csl a b h hb⟩
  have hβ1 := hκl.add_one_lt hβ
  have hlt := em β (β + 1) (Order.lt_add_one_iff.2 le_rfl) hβ1
  have hN := Frame.nf_interval hU hs Ai Ac Bi Bc hst hlt (eκ _ hβ1)
  have kAε := (hK _ (eκ β hβ)).1
  have kBε := (hK _ (eκ β hβ)).2.1
  have kAζ := (hK _ (eκ _ hβ1)).1
  have kBζ := (hK _ (eκ _ hβ1)).2.1
  have lAA := Ai _ (eκ β hβ) _ (eκ _ hβ1) hlt
  have lCC := Cile _ (eκ β hβ) _ (eκ _ hβ1) hlt
  have lACs := hAC _ hβ1
  exact prop_5_3_9_4 lam hU s hs _ kAε _ kBε _ kAζ _ kBζ _ kAε _ (hCK _ (eκ β hβ)).1 _ kAζ _
    (hCK _ (eκ _ hβ1)).1 hN rfl ⟨hS.refl kAε.1, hS.refl kAε.1, hS.trans lAA lACs⟩
    ⟨hCB β hβ, hAC β hβ, lCC⟩ ⟨hS.refl kAζ.1, lAA, lACs⟩ ⟨_, hS.refl kBζ.1, hCB _ hβ1⟩

/-- Thm 6.1.3(c), existence: for `Nₙ ∈ K_λ`, `M₀ ∈ K_{λ⁺}`, `N₀ ≼ N₁`, `N₀ ≼ M₀`,
`N₁ ∩ M₀ = N₀`, there is `M₁` with `NF^(N₀, N₁, M₀, M₁)`. -/
theorem thm_6_1_3_c [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (N₀ N₁ M₀ : Model U L) (h₀ : N₀ ∈ s.S.Kc lam) (h₁ : N₁ ∈ s.S.Kc lam)
    (hM : M₀ ∈ s.S.Kc (Order.succ lam)) (h01 : s.S.le N₀ N₁) (h0M : s.S.le N₀ M₀)
    (hd : N₁.carrier ∩ M₀.carrier = N₀.carrier) : ∃ M₁, s.NFhat lam N₀ N₁ M₀ M₁ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₀
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨A, hA0, hAK, Ai, Ac, hAU⟩ := hS.exists_filtration hc.ax0b hinf hM h₀ h0M
  have Ai' : IsIncreasing s.S.le A (Iio (Order.succ lam).ord) := fun a ha b hb h => (Ai a ha b hb h).1
  by_cases heq : N₀ = N₁
  · subst heq
    refine ⟨M₀, h₀, h₀, hM, hM, A, A, Ai', Ac, Ai', Ac, fun α hα => ?_, hA0, hA0, hAU, hAU⟩
    exact Frame.nfstar_nf hc (Frame.nfstar_zero hU hc (hAK α hα).1 (hAK _ (hκl.add_one_lt hα)).1
      (Ai' α hα _ (hκl.add_one_lt hα) (Order.lt_add_one_iff.2 le_rfl)))
  obtain ⟨hMuK, hle⟩ := hS.le_union hκl Ai' Ac hAU
  obtain ⟨hext, hextc⟩ := IsAEC.extend_union Ai' Ac hAU hle
  let Mc : Ordinal.{u} → Model U L := fun β => if β < (Order.succ lam).ord then A β else M₀
  have hMcl : ∀ β < (Order.succ lam).ord, Mc β = A β := fun β h => if_pos h
  have hMcx : Mc (Order.succ lam).ord = M₀ := if_neg (lt_irrefl _)
  have hAcne : ∀ β < (Order.succ lam).ord, A β ≠ M₀ := fun β hβ e => by
    have h1 := (hAK β hβ).1.2
    rw [e] at h1
    have h2 : Model.card M₀ = Order.succ lam := hM.2
    rw [h2] at h1
    exact absurd h1 (ne_of_gt (Order.lt_succ lam))
  have hMlt : IsIncreasing s.S.lt Mc (Iic (Order.succ lam).ord) := by
    intro a ha b hb h
    have haκ := lt_of_lt_of_le h hb
    show s.S.lt (Mc a) (Mc b)
    rw [hMcl a haκ]
    rcases (show b ≤ _ from hb).lt_or_eq with h' | h'
    · rw [hMcl b h']; exact Ai a haκ b h' h
    · rw [h', hMcx]; exact ⟨hle a haκ, hAcne a haκ⟩
  have hdisj' : N₁.carrier ∩ (Mc (Order.succ lam).ord).carrier = (Mc 0).carrier := by
    rw [hMcx, hMcl 0 hκl.bot_lt, hA0]; exact hd
  obtain ⟨N, Nlt, Nc, NK, hN₁N, hMN, hrest⟩ := prop_5_5_3_b lam hU s hs (Order.succ lam).ord le_rfl Mc
    ⟨hMlt, hextc, fun ε hε => by
      rcases (show ε ≤ _ from hε).lt_or_eq with h' | h'
      · rw [hMcl ε h']; exact (hAK ε h').1.1
      · rw [h', hMcx]; exact hM.1, fun ε _ h' => by rw [hMcl ε h']; exact (hAK ε h').1⟩
    N₁ h₁ (by rw [hMcl 0 hκl.bot_lt, hA0]; exact ⟨h01, heq⟩) hdisj'
  have hNstep := fun ε (h : ε < (Order.succ lam).ord) => hrest.2 ε h
  have Nil : IsIncreasing s.S.le N (Iic (Order.succ lam).ord) := fun a ha b hb h => (Nlt a ha b hb h).1
  let B : Ordinal.{u} → Model U L := fun β => if β = 0 then N₁ else N β
  have hB0 : B 0 = N₁ := if_pos rfl
  have hBn : ∀ β, β ≠ 0 → B β = N β := fun β h => if_neg h
  have hsucc : ∀ i : Ordinal.{u}, i + 1 ≠ 0 := fun i h =>
    absurd (h ▸ Order.lt_add_one_iff.2 (le_refl i)) (not_lt.2 zero_le)
  have hN1b : ∀ γ ≤ (Order.succ lam).ord, γ ≠ 0 → s.S.le N₁ (N γ) := fun γ hγ h0' =>
    hS.trans hN₁N (Nil 0 (Set.mem_Iic.2 zero_le) γ hγ (pos_iff_ne_zero.2 h0'))
  have Bi : IsIncreasing s.S.le B (Iio (Order.succ lam).ord) := by
    intro a _ b hb hl
    have hb0 : b ≠ 0 := fun h => absurd (h ▸ hl) (not_lt.2 zero_le)
    show s.S.le (B a) (B b)
    rw [hBn b hb0]
    by_cases ha0 : a = 0
    · rw [ha0, hB0]; exact hN1b b (le_of_lt (Set.mem_Iio.1 hb)) hb0
    · rw [hBn a ha0]; exact Nil a (hl.le.trans (le_of_lt (Set.mem_Iio.1 hb))) b (le_of_lt (Set.mem_Iio.1 hb)) hl
  have Bc : IsContinuous B (Iio (Order.succ lam).ord) := by
    intro b hb hl
    have hb0 : b ≠ 0 := by
      rintro rfl; exact absurd hl Order.not_isSuccLimit_bot
    show (B b).carrier = _
    rw [hBn b hb0, Nc b (le_of_lt (Set.mem_Iio.1 hb)) hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · have h1b : (0 : Ordinal.{u}) + 1 < b := hl.add_one_lt (pos_iff_ne_zero.2 hb0)
        refine ⟨0 + 1, h1b, ?_⟩
        rw [hBn _ (hsucc 0)]
        rw [hξ0] at hx
        exact hS.sub (Nil 0 (Set.mem_Iic.2 zero_le) (0 + 1) ((le_of_lt h1b).trans (le_of_lt (Set.mem_Iio.1 hb)))
          (Order.lt_add_one_iff.2 le_rfl)) hx
      · exact ⟨ξ, hξ, by rw [hBn ξ hξ0]; exact hx⟩
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · rw [hξ0, hB0] at hx
        exact ⟨0, pos_iff_ne_zero.2 hb0, hS.sub hN₁N hx⟩
      · exact ⟨ξ, hξ, by rw [hBn ξ hξ0] at hx; exact hx⟩
  have hκlim : Order.IsSuccLimit (Order.succ lam).ord := hκl
  have hTopc := Nc _ (Set.mem_Iic.2 le_rfl) hκlim
  have hM₁c : N (Order.succ lam).ord ∈ s.S.Kc (Order.succ lam) := by
    refine ⟨NK _ le_rfl, le_antisymm ?_ ?_⟩
    · change #(N (Order.succ lam).ord).carrier ≤ Order.succ lam
      rw [hTopc]
      refine card_biUnion_le (hinf.trans (Order.le_succ lam)) (by rw [Cardinal.card_ord]) fun β hβ => ?_
      have hNK : N β ∈ s.S.Kc lam := by
        have h1 := (hNstep β hβ).1
        exact h1.2.2.1
      exact (le_of_eq hNK.2).trans (Order.le_succ lam)
    · have h1 := hMN _ le_rfl
      rw [hMcx] at h1
      exact (le_of_eq (show Model.card M₀ = Order.succ lam from hM.2).symm).trans
        (Model.card_le_of_sub (hS.sub h1))
  refine ⟨N (Order.succ lam).ord, h₀, h₁, hM, hM₁c, A, B, Ai', Ac, Bi, Bc, fun α hα => ?_, hA0, hB0, hAU,
    ⟨?_, fun α hα => ?_⟩⟩
  · have hα1 := hκl.add_one_lt hα
    have hN' := (hNstep α hα).1
    rw [hMcl α hα, hMcl _ hα1] at hN'
    have hsym := Frame.nf_symm hU hs hN'
    rw [hBn _ (hsucc α)]
    by_cases hα0 : α = 0
    · subst hα0
      rw [hB0]
      rw [hA0] at hsym ⊢
      obtain ⟨kP, kQ, kA1, kN, lPQ, lQN, lPA, lAN, -⟩ := id hsym
      exact prop_5_3_9_4 lam hU s hs _ kP _ kQ _ kA1 _ kN _ kP _ h₁ _ kA1 _ kN hsym rfl
        ⟨hS.refl kP.1, hS.refl kP.1, hS.trans lPA lAN⟩ ⟨hN₁N, h01, hS.trans hN₁N lQN⟩
        ⟨hS.refl kA1.1, lPA, lAN⟩ ⟨_, hS.refl kN.1, hS.refl kN.1⟩
    · rw [hBn α hα0]; exact hsym
  · rw [hTopc]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      refine ⟨ξ + 1, hκl.add_one_lt hξ, ?_⟩
      rw [hBn _ (hsucc ξ)]
      exact hS.sub (Nil ξ hξ.le _ (hκl.add_one_lt hξ).le (Order.lt_add_one_iff.2 le_rfl)) hx
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · rw [hξ0, hB0] at hx
        exact ⟨0, hκl.bot_lt, hS.sub hN₁N hx⟩
      · exact ⟨ξ, hξ, by rw [hBn ξ hξ0] at hx; exact hx⟩
  · have hle' : s.S.le (B α) (N (Order.succ lam).ord) := by
      by_cases hα0 : α = 0
      · rw [hα0, hB0]; exact hN1b _ le_rfl hκl.bot_lt.ne'
      · rw [hBn α hα0]; exact Nil α (Set.mem_Iic.2 (le_of_lt hα)) _ (Set.mem_Iic.2 le_rfl) hα
    exact hS.incl _ _ hle'

/-- Thm 6.1.3(d), weak uniqueness: if `NF^(N₀, N₁, M₀, M_{1,n})` (`n < 2`), there are
`M, f₀, f₁` with `fₙ : M_{1,n} → M` embeddings over `N₁ ∪ M₀`. -/
theorem thm_6_1_3_d [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (N₀ N₁ M₀ M₁₀ M₁₁ : Model U L) (h₀ : s.NFhat lam N₀ N₁ M₀ M₁₀)
    (h₁ : s.NFhat lam N₀ N₁ M₀ M₁₁) :
    ∃ (M : Model U L) (f₀ f₁ : U → U), IsEmb s.S f₀ M₁₀ M ∧ IsEmb s.S f₁ M₁₁ M ∧
      Over f₀ M₁₀ M (N₁.carrier ∪ M₀.carrier) ∧ Over f₁ M₁₁ M (N₁.carrier ∪ M₀.carrier) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, kM₀, kM10, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h₀
  obtain ⟨-, -, -, kM11, A', B', Ai', Ac', Bi', Bc', hst', hA0', hB0', hMA', hMB'⟩ := h₁
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have h0κ := hκl.bot_lt
  have hsA : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing s.S.le X (Iio (Order.succ lam).ord) →
      ∀ a < (Order.succ lam).ord, ∀ b < (Order.succ lam).ord, a ≤ b → (X a).carrier ⊆ (X b).carrier :=
    fun {X} hX a ha b hb h => by
      rcases h.lt_or_eq with h | h
      · exact hS.sub (hX a ha b hb h)
      · rw [h]
  obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (A ε).carrier)
    (G := fun ε => (A' ε).carrier)
    (fun a b h hb => hsA Ai a (lt_of_le_of_lt h hb) b hb h)
    (fun a b h hb => hsA Ai' a (lt_of_le_of_lt h hb) b hb h)
    (fun b hb hl => Ac b hb hl) (fun b hb hl => Ac' b hb hl)
    (fun a ha => le_of_eq (hst a ha).1.2) (fun a ha => le_of_eq (hst' a ha).1.2)
    (by rw [← hMA.1, ← hMA'.1])
  obtain ⟨e, e0, eκ, em, eE, el⟩ := exists_club_enum hinf hub hcl
  obtain ⟨-, hleA⟩ := hS.le_union hκl Ai Ac hMA
  obtain ⟨-, hleA'⟩ := hS.le_union hκl Ai' Ac' hMA'
  have hAeq : ∀ β < (Order.succ lam).ord, A' (e β) = A (e β) := fun β hβ => by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h' | h'
    · have hF : (A (e β)).carrier = (A' (e β)).carrier := eE β hβ h'
      exact hS.po.2.2.1 _ _
        (hS.le_of_sub (hleA' _ (eκ β hβ)) (hleA _ (eκ β hβ)) (le_of_eq hF.symm))
        (hS.le_of_sub (hleA _ (eκ β hβ)) (hleA' _ (eκ β hβ)) (le_of_eq hF))
    · rw [← h', e0, hA0, hA0']
  have chA := hS.comp_chain Ai Ac eκ em el
  have chB := hS.comp_chain Bi Bc eκ em el
  have chB' := hS.comp_chain Bi' Bc' eκ em el
  have uA := hMA.comp eκ em (hsA Ai)
  have uB := hMB.comp eκ em (hsA Bi)
  have uB' := hMB'.comp eκ em (hsA Bi')
  obtain ⟨hM₀K, leA⟩ := hS.le_union hκl chA.1 chA.2 uA
  obtain ⟨hM10K, leB⟩ := hS.le_union hκl chB.1 chB.2 uB
  obtain ⟨hM11K, leB'⟩ := hS.le_union hκl chB'.1 chB'.2 uB'
  obtain ⟨Ai2, Ac2⟩ := IsAEC.extend_union chA.1 chA.2 uA leA
  obtain ⟨Bi2, Bc2⟩ := IsAEC.extend_union chB.1 chB.2 uB leB
  obtain ⟨Bi2', Bc2'⟩ := IsAEC.extend_union chB'.1 chB'.2 uB' leB'
  let κ := (Order.succ lam).ord
  let X : Ordinal.{u} → Model U L := fun β => if β < κ then A (e β) else M₀
  let Y : Ordinal.{u} → Model U L := fun β => if β < κ then B (e β) else M₁₀
  let Y' : Ordinal.{u} → Model U L := fun β => if β < κ then B' (e β) else M₁₁
  have hXl : ∀ β < κ, X β = A (e β) := fun β h => if_pos h
  have hYl : ∀ β < κ, Y β = B (e β) := fun β h => if_pos h
  have hYl' : ∀ β < κ, Y' β = B' (e β) := fun β h => if_pos h
  have hXt : X κ = M₀ := if_neg (lt_irrefl _)
  have hYt : Y κ = M₁₀ := if_neg (lt_irrefl _)
  have hYt' : Y' κ = M₁₁ := if_neg (lt_irrefl _)
  have hstep : ∀ β < κ, s.NF lam (A (e β)) (A (e (β + 1))) (B (e β)) (B (e (β + 1))) := fun β hβ =>
    Frame.nf_symm hU hs (Frame.nf_interval hU hs Ai Ac Bi Bc hst
      (em β (β + 1) (Order.lt_add_one_iff.2 le_rfl) (hκl.add_one_lt hβ)) (eκ _ (hκl.add_one_lt hβ)))
  have hstep' : ∀ β < κ, s.NF lam (A (e β)) (A (e (β + 1))) (B' (e β)) (B' (e (β + 1))) := fun β hβ => by
    have h1 := Frame.nf_symm hU hs (Frame.nf_interval hU hs Ai' Ac' Bi' Bc' hst'
      (em β (β + 1) (Order.lt_add_one_iff.2 le_rfl) (hκl.add_one_lt hβ)) (eκ _ (hκl.add_one_lt hβ)))
    rwa [hAeq β hβ, hAeq _ (hκl.add_one_lt hβ)] at h1
  have hE : OtMinusE s.S lam (fun _ => s.NF lam) :=
    have hR := prop_5_4_8 lam hU s hs
    ⟨fun _ M₀ M₁ M₂ M₃ h => by
      obtain ⟨a, b, c', f⟩ := hR.1 _ _ _ _ h
      obtain ⟨g, i, j, k⟩ := hR.2.1 _ _ _ _ h
      exact ⟨a, b, c', f, g, i, j, k⟩,
      fun _ N₀ N₁' N₂ A B _ hA hB h1 h2 => hR.2.2.1 N₀ N₁' N₂ A B hA hB h1 h2,
      fun _ M₀ M₁ M₂ M₃ M₄ f h hf' hm => hR.2.2.2 M₀ M₁ M₂ M₃ M₄ f h hf' hm⟩
  haveI : Infinite U := hU.infinite
  have hexd : ∀ α, ∃ x : U, α < κ → x ∈ (X (α + 1)).carrier := fun α => by
    by_cases h : α < κ
    · have h1 := hκl.add_one_lt h
      have hc1 := (hstep _ h1 |>.1).2
      rw [← hXl _ h1] at hc1
      have hne : (X (α + 1)).carrier.Nonempty := by
        rw [Set.nonempty_iff_ne_empty]
        intro he
        have h2 : Model.card (X (α + 1)) = 0 := by unfold Model.card; rw [he]; simp
        rw [h2] at hc1
        exact absurd (hc1 ▸ hinf) (not_le.2 Cardinal.aleph0_pos)
      obtain ⟨x, hx⟩ := hne
      exact ⟨x, fun _ => hx⟩
    · exact ⟨Classical.arbitrary U, fun h' => absurd h' h⟩
  choose d hd using hexd
  have leXY : ∀ α ≤ κ, s.S.le (X α) (Y α) ∧ s.S.le (X α) (Y' α) := fun α hα => by
    rcases hα.lt_or_eq with h | h
    · rw [hXl α h, hYl α h, hYl' α h]
      exact ⟨(hstep α h).2.2.2.2.2.2.1, (hstep' α h).2.2.2.2.2.2.1⟩
    · rw [h, hXt, hYt, hYt']
      exact ⟨hS.smooth κ hκl _ M₁₀ chA.1 chA.2
          (fun β hβ => hS.trans (hstep β hβ).2.2.2.2.2.2.1 (leB β hβ)) M₀ uA hM₀K,
        hS.smooth κ hκl _ M₁₁ chA.1 chA.2
          (fun β hβ => hS.trans (hstep' β hβ).2.2.2.2.2.2.1 (leB' β hβ)) M₀ uA hM₀K⟩
  obtain ⟨Z, ga, gb, hga, hgb, e₁, hga0, hgb0, -⟩ := transit_weak (N₁ := X) (Na := Y) (Nb := Y')
    (fa := fun _ => id) (fb := fun _ => id) (d := d) hS hU hc.ax0b hinf hE le_rfl Bi2 Bc2 Bi2' Bc2'
    Ai2 Ac2 (by
      show Y 0 = Y' 0
      rw [hYl 0 h0κ, hYl' 0 h0κ, e0, hB0, hB0'])
    (fun α hα => ⟨IsEmb.of_le hS (leXY α hα).1, IsEmb.of_le hS (leXY α hα).2⟩)
    (fun _ _ => ⟨rfl, rfl⟩) (fun _ _ _ _ _ _ _ => rfl) (fun _ _ _ _ _ _ _ => rfl)
    (by rw [hYl 0 h0κ, e0, hB0]; exact k1) (fun α hα => hd α hα)
    (fun α hα => ⟨X α, X (α + 1), IsoOn.refl _, IsoOn.refl _, by
      have h1 := hκl.add_one_lt hα
      show s.NF lam (X α) (X (α + 1)) (Y α) (Y (α + 1))
      rw [hXl α hα, hXl _ h1, hYl α hα, hYl _ h1]; exact hstep α hα⟩)
    (fun α hα => ⟨X α, X (α + 1), IsoOn.refl _, IsoOn.refl _, by
      have h1 := hκl.add_one_lt hα
      show s.NF lam (X α) (X (α + 1)) (Y' α) (Y' (α + 1))
      rw [hXl α hα, hXl _ h1, hYl' α hα, hYl' _ h1]; exact hstep' α hα⟩)
  rw [hYt] at hga
  rw [hYt'] at hgb
  rw [hXt] at e₁
  have hY0 : Y 0 = N₁ := by rw [hYl 0 h0κ, e0, hB0]
  have hY0' : Y' 0 = N₁ := by rw [hYl' 0 h0κ, e0, hB0']
  rw [hY0] at hga0
  rw [hY0'] at hgb0
  obtain ⟨-, -, W, hW, hgaW⟩ := id hga
  obtain ⟨κ', hκ', hκg, -⟩ := hgaW.exists_inv
  have hsl : Order.succ lam < #U := hU.1.isSuccLimit.succ_lt hU.2
  obtain ⟨r, Z', hr, hrκ, hMZ, hZK, -⟩ := hS.rename hU.infinite (∅ : Set U) hW hκ' (by
    rw [Set.empty_union]; change M₁₀.card < #U; rw [kM10.2]; exact hsl)
  have hrg : ∀ x ∈ M₁₀.carrier, r (ga x) = x := fun x hx => by
    rw [hrκ _ (hgaW.mapsTo hx), hκg x hx]
  have hN₁10 : s.S.le N₁ M₁₀ := by have := leB 0 h0κ; rwa [e0, hB0] at this
  have hN₁11 : s.S.le N₁ M₁₁ := by have := leB' 0 h0κ; rwa [e0, hB0'] at this
  have hM010 : s.S.le M₀ M₁₀ := by have := (leXY κ le_rfl).1; rwa [hXt, hYt] at this
  have hM011 : s.S.le M₀ M₁₁ := by have := (leXY κ le_rfl).2; rwa [hXt, hYt'] at this
  have hsub0 : N₁.carrier ∪ M₀.carrier ⊆ M₁₀.carrier :=
    Set.union_subset (hS.sub hN₁10) (hS.sub hM010)
  have hsub1 : N₁.carrier ∪ M₀.carrier ⊆ M₁₁.carrier :=
    Set.union_subset (hS.sub hN₁11) (hS.sub hM011)
  have hfix : ∀ x ∈ N₁.carrier ∪ M₀.carrier, (r ∘ gb) x = x := by
    rintro x (hx | hx)
    · show r (gb x) = x
      have h1 := hrg x (hS.sub hN₁10 hx)
      rw [hga0 x hx] at h1
      rw [hgb0 x hx]; exact h1
    · show r (gb x) = x
      have h2 : ga x = gb x := e₁ x hx
      rw [← h2]; exact hrg x (hS.sub hM010 hx)
  exact ⟨Z', id, r ∘ gb, IsEmb.of_le hS hMZ, IsEmb.comp_iso hS hgb hr,
    ⟨fun x hx => ⟨hsub0 hx, hS.sub hMZ (hsub0 hx)⟩, fun _ _ => rfl⟩,
    ⟨fun x hx => ⟨hsub1 hx, hS.sub hMZ (hsub0 hx)⟩, hfix⟩⟩

/-- Thm 6.1.3(e), respecting the frame: `NF^(N₀, N₁, M₀, M₁)` and `tp(a, N₀, M₀) ∈ S^bs(N₀)`
imply that `tp(a, N₁, M₁)` does not fork over `N₀`. -/
theorem thm_6_1_3_e [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (N₀ N₁ M₀ M₁ : Model U L) (a : U) (h : s.NFhat lam N₀ N₁ M₀ M₁)
    (hb : tp s.S lam a N₀ M₀ ∈ s.Sbs N₀) : s.NotFork lam N₀ N₁ (tp s.S lam a N₁ M₁) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, hA0, hB0, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨hAK, hleA⟩ := hS.le_union hκl Ai Ac hMA
  obtain ⟨hBK, hleB⟩ := hS.le_union hκl Bi Bc hMB
  obtain ⟨N', a', hlt, hN', ha', heq⟩ := hc.ax2a N₀ k0 hb
  have hK : (N₀, M₀, a) ∈ s.S.K3 := (ERel.K3_iff (tp_eq_iff.1 heq)).2 ⟨k0.1, hN'.1, hlt.1, ha'.1⟩
  have haM : a ∈ M₀.carrier := hK.2.2.2
  rw [hMA.1] at haM
  obtain ⟨ε, hε, haε⟩ := Set.mem_iUnion₂.1 haM
  have hε1 := hκl.add_one_lt hε
  have haε1 : a ∈ (A (ε + 1)).carrier :=
    hS.sub (Ai ε hε _ hε1 (Order.lt_add_one_iff.2 le_rfl)) haε
  have hpos : (0 : Ordinal.{u}) < ε + 1 := lt_of_le_of_lt zero_le (Order.lt_add_one_iff.2 le_rfl)
  have hN := Frame.nf_symm hU hs (Frame.nf_interval hU hs Ai Ac Bi Bc hst hpos hε1)
  rw [hA0, hB0] at hN
  obtain ⟨-, -, -, -, l0A, lAB, l1, -, -⟩ := id hN
  have hle0 := hleA _ hε1
  have e1 : tp s.S lam a N₀ (A (ε + 1)) = tp s.S lam a N₀ M₀ :=
    tp_eq_of_le hS hK hle0 l0A haε1
  have hn := thm_5_4_10 lam hU s hs N₀ (A (ε + 1)) N₁ (B (ε + 1)) a hN (by rw [e1]; exact hb)
  have haB : a ∈ (B (ε + 1)).carrier := hS.sub lAB haε1
  have hleB1 := hleB _ hε1
  have hK2 : (N₁, M₁, a) ∈ s.S.K3 := ⟨k1.1, hBK, hS.trans
    hN.2.2.2.2.2.2.2.1 hleB1, hS.sub hleB1 haB⟩
  rwa [tp_eq_of_le hS hK2 hleB1 hN.2.2.2.2.2.2.2.1 haB] at hn

/-- Remark 6.1.5: `M₀ ≼^NF_{λ⁺} M₁ → M₀ ≼ M₁`. -/
theorem rem_6_1_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (M₀ M₁ : Model U L) (h : s.leNF lam M₀ M₁) : s.S.le M₀ M₁ := by
  exact h.2.2.1

/-- AUX: not in paper. `E` is unbounded and closed in `λ⁺` (the form used by `filt_club` and
`exists_club_enum`). -/
def ClubL (lam : Cardinal.{u}) (E : Set Ordinal.{u}) : Prop :=
  (∀ ξ < (Order.succ lam).ord, ∃ ε ∈ E, ξ < ε ∧ ε < (Order.succ lam).ord) ∧
  (∀ δ < (Order.succ lam).ord, Order.IsSuccLimit δ → (∀ ξ < δ, ∃ ε ∈ E, ξ < ε ∧ ε < δ) → δ ∈ E)

/-- AUX: not in paper. -/
theorem ClubL.of_isClub {lam : Cardinal.{u}} {E : Set Ordinal.{u}}
    (h : IsClubIn (Order.succ lam).ord E) : ClubL lam E :=
  ⟨fun ξ hξ => let ⟨β, hβ, h1⟩ := h.2.1 ξ hξ; ⟨β, hβ, h1, h.1 hβ⟩, fun δ hδ hl H => h.2.2 δ hδ hl H⟩

/-- AUX: not in paper. -/
theorem ClubL.isClub_inter {lam : Cardinal.{u}} {E : Set Ordinal.{u}} (h : ClubL lam E) :
    IsClubIn (Order.succ lam).ord (E ∩ Iio (Order.succ lam).ord) :=
  ⟨inter_subset_right, fun α hα => let ⟨ε, hε, h1, h2⟩ := h.1 α hα; ⟨ε, ⟨hε, h2⟩, h1⟩,
    fun δ hδ hl H => ⟨h.2 δ hδ hl (fun ξ hξ => let ⟨β, hβ, h1, h2⟩ := H ξ hξ; ⟨β, hβ.1, h1, h2⟩), hδ⟩⟩

/-- AUX: not in paper. Fewer than `λ⁺` ordinals below `λ⁺` are bounded below `λ⁺`. -/
theorem sup_bdd {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {ξ : Ordinal.{u}}
    (hξ : ξ < (Order.succ lam).ord) (f : Ordinal.{u} → Ordinal.{u})
    (hf : ∀ γ < ξ, f γ < (Order.succ lam).ord) :
    ∃ ζ < (Order.succ lam).ord, ∀ γ < ξ, f γ ≤ ζ := by
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hc : ξ.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hξ)
  let g : ξ.ToType → Ordinal.{u} := fun x => f (Ordinal.ToType.mk.symm x).1
  have hsup : iSup g < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
    (by rw [hreg.cof_ord, Cardinal.mk_toType]; exact Order.lt_succ_iff.2 hc)
    (fun x => hf _ (Ordinal.ToType.mk.symm x).2)
  refine ⟨iSup g, hsup, fun γ hγ => ?_⟩
  have := Ordinal.le_iSup g (Ordinal.ToType.mk ⟨γ, hγ⟩)
  simpa [g] using this

/-- AUX: not in paper. Diagonal intersection of clubs of `λ⁺` is a club. -/
theorem ClubL.diag {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {C : Ordinal.{u} → Set Ordinal.{u}}
    (hC : ∀ γ < (Order.succ lam).ord, ClubL lam (C γ)) :
    ClubL lam {ε | ∀ γ < ε, ε ∈ C γ} := by
  classical
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hnext : ∀ ξ, ∃ ζ, ξ < (Order.succ lam).ord → (ξ < ζ ∧ ζ < (Order.succ lam).ord ∧
      ∀ γ < ξ, ∃ ε ∈ C γ, ξ < ε ∧ ε < ζ) := fun ξ => by
    by_cases hξ : ξ < (Order.succ lam).ord
    · have hex : ∀ γ, ∃ ε, γ < ξ → ε ∈ C γ ∧ ξ < ε ∧ ε < (Order.succ lam).ord := fun γ => by
        by_cases hγ : γ < ξ
        · obtain ⟨ε, h1, h2, h3⟩ := (hC γ (lt_trans hγ hξ)).1 ξ hξ
          exact ⟨ε, fun _ => ⟨h1, h2, h3⟩⟩
        · exact ⟨0, fun h => absurd h hγ⟩
      choose f hf using hex
      obtain ⟨z, hz, hb⟩ := sup_bdd hinf hξ f (fun γ hγ => (hf γ hγ).2.2)
      have hm := max_lt hz hξ
      refine ⟨max z ξ + 1, fun _ => ⟨?_, hκl.add_one_lt hm, fun γ hγ => ⟨f γ, (hf γ hγ).1,
        (hf γ hγ).2.1, ?_⟩⟩⟩
      · exact lt_of_le_of_lt (le_max_right _ _) (Order.lt_add_one_iff.2 le_rfl)
      · exact lt_of_le_of_lt ((hb γ hγ).trans (le_max_left _ _)) (Order.lt_add_one_iff.2 le_rfl)
    · exact ⟨0, fun h => absurd h hξ⟩
  choose nxt hnxt using hnext
  refine ⟨fun ξ hξ => ?_, fun δ hδ hl H γ hγ => ?_⟩
  · let h : ℕ → Ordinal.{u} := fun n => Nat.rec ξ (fun _ x => nxt x) n
    have hlt : ∀ n, h n < (Order.succ lam).ord := fun n => by
      induction n with
      | zero => exact hξ
      | succ n ih => exact (hnxt _ ih).2.1
    have hs : ∀ n, h n < h (n + 1) := fun n => (hnxt _ (hlt n)).1
    have hmono : ∀ m n, m ≤ n → h m ≤ h n := fun m n hmn => by
      induction n, hmn using Nat.le_induction with
      | base => exact le_rfl
      | succ n _ ih => exact ih.trans (hs n).le
    let hu : ULift.{u} ℕ → Ordinal.{u} := fun n => h n.down
    have hsup : iSup hu < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
      (by
        have hc : #(ULift.{u} ℕ) = ℵ₀ := by simp
        rw [hreg.cof_ord, hc]
        exact lt_of_le_of_lt hinf (Order.lt_succ lam)) fun n => hlt n.down
    have hle : ∀ n, h n ≤ iSup hu := fun n => Ordinal.le_iSup hu ⟨n⟩
    have hlts : ∀ n, h n < iSup hu := fun n => lt_of_lt_of_le (hs n) (hle (n + 1))
    have hbelow : ∀ x < iSup hu, ∃ n, x < h n := fun x hx => by
      by_contra hno
      push Not at hno
      exact absurd hx (not_lt.2 (ciSup_le' fun n => hno n.down))
    have hl : Order.IsSuccLimit (iSup hu) := by
      rcases Ordinal.zero_or_succ_or_isSuccLimit (iSup hu) with h' | ⟨d, hd⟩ | h'
      · have := hlts 0; rw [h'] at this; exact absurd this (not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at hd
        obtain ⟨n, hn⟩ := hbelow d (by rw [← hd]; exact Order.lt_add_one_iff.2 le_rfl)
        have h2 := hlts n
        rw [← hd] at h2
        exact absurd h2 (not_lt.2 (Order.add_one_le_iff.2 hn))
      · exact h'
    refine ⟨iSup hu, fun γ hγ => ?_, hlts 0, hsup⟩
    obtain ⟨n, hn⟩ := hbelow γ hγ
    refine (hC γ (lt_trans hγ hsup)).2 _ hsup hl fun y hy => ?_
    obtain ⟨m, hm⟩ := hbelow y hy
    have hk : γ < h (max n m) := lt_of_lt_of_le hn (hmono _ _ (le_max_left _ _))
    obtain ⟨ε, h1, h2, h3⟩ := (hnxt _ (hlt (max n m))).2.2 γ hk
    exact ⟨ε, h1, lt_of_lt_of_le (lt_of_lt_of_le hm (hmono _ _ (le_max_right _ _))) h2.le |>.trans_le le_rfl,
      lt_of_lt_of_le h3 (hle (max n m + 1))⟩
  · refine (hC γ (lt_trans hγ hδ)).2 δ hδ hl fun ξ hξ => ?_
    obtain ⟨ε, h1, h2, h3⟩ := H (max ξ γ) (max_lt hξ hγ)
    exact ⟨ε, h1 γ (lt_of_le_of_lt (le_max_right _ _) h2), lt_of_le_of_lt (le_max_left _ _) h2, h3⟩

/-- AUX: not in paper. Two clubs intersect in a club. -/
theorem ClubL.inter {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {C D : Set Ordinal.{u}}
    (hC : ClubL lam C) (hD : ClubL lam D) : ClubL lam {ε | 1 < ε ∧ ε ∈ C ∧ ε ∈ D} := by
  classical
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have h1κ : (1 : Ordinal.{u}) < (Order.succ lam).ord := by
    simpa using hκl.add_one_lt hκl.bot_lt
  have hd := ClubL.diag hinf (C := fun γ => if γ = 0 then C else D) (fun γ _ => by
    by_cases h : γ = 0 <;> simp [h, hC, hD])
  have key : ∀ ε, 1 < ε → (∀ γ < ε, ε ∈ (if γ = 0 then C else D)) → ε ∈ C ∧ ε ∈ D := fun ε h1 h =>
    ⟨by simpa using h 0 (lt_trans zero_lt_one h1), by simpa using h 1 h1⟩
  refine ⟨fun ξ hξ => ?_, fun δ hδ hl H => ?_⟩
  · obtain ⟨ε, h1, h2, h3⟩ := hd.1 (max ξ 1) (max_lt hξ h1κ)
    have h4 : 1 < ε := lt_of_le_of_lt (le_max_right _ _) h2
    exact ⟨ε, ⟨h4, key ε h4 h1⟩, lt_of_le_of_lt (le_max_left _ _) h2, h3⟩
  · have hmem : δ ∈ {ε | ∀ γ < ε, ε ∈ (if γ = 0 then C else D)} := hd.2 δ hδ hl fun ξ hξ => by
      obtain ⟨ε, h1, h2, h3⟩ := H ξ hξ
      exact ⟨ε, fun γ _ => by
        by_cases h : γ = 0 <;> simp [h, h1.2.1, h1.2.2], h2, h3⟩
    have h1δ : 1 < δ := by
      obtain ⟨ε, h1, h2, h3⟩ := H 0 hl.bot_lt
      exact lt_trans h1.1 h3
    exact ⟨h1δ, key δ h1δ hmem⟩

/-- AUX: not in paper. Increasing continuous enumeration of a club of `λ⁺`, all of whose values
are in the club. -/
theorem exists_club_enum' {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) :
    ∃ e : Ordinal.{u} → Ordinal.{u}, (∀ β < (Order.succ lam).ord, e β < (Order.succ lam).ord) ∧
      (∀ a b, a < b → b < (Order.succ lam).ord → e a < e b) ∧
      (∀ β < (Order.succ lam).ord, e β ∈ E) ∧
      (∀ β < (Order.succ lam).ord, Order.IsSuccLimit β → Order.IsSuccLimit (e β) ∧
        ∀ ξ < e β, ∃ γ < β, ξ < e γ) := by
  obtain ⟨e, -, eκ, em, eE, el⟩ := exists_club_enum hinf hE.1 hE.2
  have hp := Ordinal.isPrincipal_add_ord (hinf.trans (Order.le_succ lam))
  have h1κ : (1 : Ordinal.{u}) < (Order.succ lam).ord := by
    have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
    simpa using hκl.add_one_lt hκl.bot_lt
  have hadd : ∀ β < (Order.succ lam).ord, 1 + β < (Order.succ lam).ord := fun β hβ => hp h1κ hβ
  have hle : ∀ β < (Order.succ lam).ord, e β ≤ e (1 + β) := fun β hβ => by
    rcases (show β ≤ 1 + β from le_add_self).lt_or_eq with h | h
    · exact (em _ _ h (hadd β hβ)).le
    · rw [← h]
  refine ⟨fun β => e (1 + β), fun β hβ => eκ _ (hadd β hβ),
    fun a b h hb => em _ _ ((add_lt_add_iff_left _).2 h) (hadd b hb),
    fun β hβ => eE _ (hadd β hβ) (lt_of_lt_of_le zero_lt_one le_self_add), fun β hβ hl => ?_⟩
  have hb : 1 + β = β := Ordinal.one_add_of_omega0_le (Ordinal.omega0_le_of_isSuccLimit hl)
  show Order.IsSuccLimit (e (1 + β)) ∧ ∀ ξ < e (1 + β), ∃ γ < β, ξ < e (1 + γ)
  rw [hb]
  refine ⟨(el β hβ hl).1, fun ξ hξ => ?_⟩
  obtain ⟨γ, hγ, h⟩ := (el β hβ hl).2 ξ hξ
  exact ⟨γ, hγ, lt_of_lt_of_le h (hle γ (lt_trans hγ hβ))⟩

/-- AUX: not in paper. `R` is a filtration of `M ∈ K_{λ⁺}` by models of `K_λ`. This is what
"representation" means in the paper: the union is the union of structures. -/
def IsFilt (S : KSys U L) (lam : Cardinal.{u}) (M : Model U L) (R : Ordinal.{u} → Model U L) : Prop :=
  IsIncreasing S.le R (Iio (Order.succ lam).ord) ∧ IsContinuous R (Iio (Order.succ lam).ord) ∧
    (∀ α < (Order.succ lam).ord, R α ∈ S.Kc lam) ∧ IsUnionOf R (Iio (Order.succ lam).ord) M

/-- AUX: not in paper. A representation (Def 1.0.29) of `M ∈ K_{λ⁺}` is a filtration. -/
theorem IsRepresentation.isFilt {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}}
    (hinf : ℵ₀ ≤ lam) {M : Model U L} {R : Ordinal.{u} → Model U L}
    (hM : M ∈ S.Kc (Order.succ lam)) (h : IsRepresentation S M R) : IsFilt S lam M R := by
  obtain ⟨hi, hc, hu, -, hk, hsub⟩ := h
  have hk' := hk lam hM.2
  have e : M.card.ord = (Order.succ lam).ord := by rw [hM.2]
  rw [e] at hi hc hu hk' hsub
  have hl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  exact ⟨hi, hc, fun α hα => ⟨hS.mem_left (hi α hα (α + 1) (hl.add_one_lt hα)
    (Order.lt_add_one_iff.2 le_rfl)), hk' α hα⟩, hu, hsub⟩

/-- AUX: not in paper. -/
theorem IsFilt.sub {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} {M : Model U L}
    {R : Ordinal.{u} → Model U L} (h : IsFilt S lam M R) {a b : Ordinal.{u}} (hab : a ≤ b)
    (hb : b < (Order.succ lam).ord) : (R a).carrier ⊆ (R b).carrier := by
  rcases hab.lt_or_eq with h' | h'
  · exact hS.sub (h.1 a (lt_trans h' hb) b hb h')
  · rw [h']

/-- AUX: not in paper. -/
theorem IsFilt.le {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {M : Model U L} {R : Ordinal.{u} → Model U L} (h : IsFilt S lam M R) {a : Ordinal.{u}}
    (ha : a < (Order.succ lam).ord) : S.le (R a) M :=
  (hS.le_union (Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))) h.1 h.2.1 h.2.2.2).2 a ha

/-- AUX: not in paper. Every model of `K_{λ⁺}` has a filtration. -/
theorem IsAEC.exists_filt {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}}
    (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {M : Model U L} (hM : M ∈ S.Kc (Order.succ lam)) :
    ∃ R, IsFilt S lam M R := by
  have hL : S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hlst
  have hc : lam ≤ #M.carrier := by
    have : #M.carrier = Order.succ lam := hM.2
    rw [this]; exact Order.le_succ lam
  obtain ⟨A, hA, hAc⟩ := Cardinal.le_mk_iff_exists_subset.1 hc
  obtain ⟨W, hW, hAW, hWM, hcW⟩ := hL M hM.1 A hA
  have hWc : W ∈ S.Kc lam := ⟨hW, le_antisymm (by
    refine hcW.trans ?_
    rw [hAc, Cardinal.add_eq_self hinf]) (by
    rw [← hAc]; exact Cardinal.mk_le_mk_of_subset hAW)⟩
  obtain ⟨R, -, hK, Ri, Rc, RU⟩ := hS.exists_filtration hlst hinf hM hWc hWM
  exact ⟨R, fun a ha b hb h => (Ri a ha b hb h).1, Rc, fun α hα => (hK α hα).1, RU⟩

/-- AUX: not in paper. A club-indexed family of `NF`-squares gives `NF^`, starting at a point of
the club. -/
theorem Frame.nfhat_of_club [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ M₁ : Model U L}
    (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam)) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) {A B : Ordinal.{u} → Model U L}
    (hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ))
    (Ac : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (A ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (A ε').carrier)
    (Bc : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (B ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (B ε').carrier)
    (AU : M₀.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (A ε).carrier)
    (BU : M₁.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (B ε).carrier)
    (As : ∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (A ε) M₀)
    (Bs : ∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (B ε) M₁) :
    ∃ ε₀ ∈ E, ε₀ < (Order.succ lam).ord ∧ s.NFhat lam (A ε₀) (B ε₀) M₀ M₁ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨e, eκ, em, eE, el⟩ := exists_club_enum' hinf hE
  have hid : ∀ β < (Order.succ lam).ord, β ≤ e β := by
    intro β
    induction β using Ordinal.lt_wf.induction with
    | ind β ih =>
    intro hβ
    by_contra hno
    have h1 : e β < β := not_le.1 hno
    exact absurd (em _ _ h1 hβ) (not_lt.2 (ih _ h1 (lt_trans h1 hβ)))
  have hN : ∀ a b, a < b → b < (Order.succ lam).ord →
      s.NF lam (A (e a)) (A (e b)) (B (e a)) (B (e b)) :=
    fun a b h hb => hNF _ (eE a (lt_trans h hb)) _ (eE b hb) (em a b h hb) (eκ b hb)
  have sA : ∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (A ε).carrier ⊆ (A ζ).carrier := by
    intro ε hε ζ hζ h hl
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hNF ε hε ζ hζ h' hl).2.2.2.2.1
    · rw [h']
  have sB : ∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (B ε).carrier ⊆ (B ζ).carrier := by
    intro ε hε ζ hζ h hl
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hNF ε hε ζ hζ h' hl).2.2.2.2.2.2.2.1
    · rw [h']
  have mkC : ∀ X : Ordinal.{u} → Model U L,
      (∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (X ε).carrier ⊆ (X ζ).carrier) →
      (∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (X ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (X ε').carrier) →
      IsContinuous (fun β => X (e β)) (Iio (Order.succ lam).ord) := by
    intro X Xs Xc b hb hl
    have hbκ : b < (Order.succ lam).ord := hb
    obtain ⟨l1, l2⟩ := el b hbκ hl
    show (X (e b)).carrier = _
    rw [Xc _ (eE b hbκ) (eκ b hbκ) l1 (fun ξ hξ => by
      obtain ⟨γ, hγ, h⟩ := l2 ξ hξ
      exact ⟨e γ, eE γ (lt_trans hγ hbκ), h, em γ b hγ hbκ⟩)]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, ⟨hξE, hξ⟩, hx⟩
      obtain ⟨γ, hγ, h⟩ := l2 ξ hξ
      have hγκ := lt_trans hγ hbκ
      exact ⟨γ, hγ, Xs ξ hξE _ (eE γ hγκ) h.le (eκ γ hγκ) hx⟩
    · rintro ⟨γ, hγ, hx⟩
      exact ⟨e γ, ⟨eE γ (lt_trans hγ hbκ), em γ b hγ hbκ⟩, hx⟩
  have mkU : ∀ (X : Ordinal.{u} → Model U L) (T : Model U L),
      (∀ ε ∈ E, ∀ ζ ∈ E, ε ≤ ζ → ζ < (Order.succ lam).ord → (X ε).carrier ⊆ (X ζ).carrier) →
      T.carrier = (⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (X ε).carrier) →
      (∀ ε ∈ E, ε < (Order.succ lam).ord → IsSubstr (X ε) T) →
      IsUnionOf (fun β => X (e β)) (Iio (Order.succ lam).ord) T := by
    intro X T Xs XU Xsub
    refine ⟨?_, fun β hβ => Xsub _ (eE β hβ) (eκ β hβ)⟩
    rw [XU]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, ⟨hξE, hξ⟩, hx⟩
      exact ⟨ξ, hξ, Xs ξ hξE _ (eE ξ hξ) (hid ξ hξ) (eκ ξ hξ) hx⟩
    · rintro ⟨β, hβ, hx⟩
      exact ⟨e β, ⟨eE β hβ, eκ β hβ⟩, hx⟩
  have h01κ : (1 : Ordinal.{u}) < (Order.succ lam).ord := by
    simpa using hκl.add_one_lt hκl.bot_lt
  have h0κ : (0 : Ordinal.{u}) < (Order.succ lam).ord := hκl.bot_lt
  have n01 := hN 0 1 zero_lt_one h01κ
  refine ⟨e 0, eE 0 h0κ, eκ 0 h0κ, n01.1, n01.2.2.1, h₀, h₁, fun β => A (e β), fun β => B (e β),
    fun a _ b hb h => (hN a b h hb).2.2.2.2.1, mkC A sA Ac,
    fun a _ b hb h => (hN a b h hb).2.2.2.2.2.2.2.1, mkC B sB Bc,
    fun α hα => Frame.nf_symm hU hs (hN α (α + 1) (Order.lt_add_one_iff.2 le_rfl) (hκl.add_one_lt hα)),
    rfl, rfl, mkU A M₀ sA AU As, mkU B M₁ sB BU Bs⟩

/-- AUX: not in paper. Version of `Frame.nfhat_of_club` for two filtrations. -/
theorem Frame.nfhat_of_club_filt [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ M₁ : Model U L}
    (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam)) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) {A B : Ordinal.{u} → Model U L}
    (hA : IsFilt s.S lam M₀ A) (hB : IsFilt s.S lam M₁ B)
    (hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ)) :
    ∃ ε₀ ∈ E, ε₀ < (Order.succ lam).ord ∧ s.NFhat lam (A ε₀) (B ε₀) M₀ M₁ := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  have mkC : ∀ {T : Model U L} {X : Ordinal.{u} → Model U L}, IsFilt s.S lam T X →
      ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
      (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
      (X ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (X ε').carrier := by
    intro T X hX ε _ hεκ hl hcof
    rw [hX.2.1 ε hεκ hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨ε', h1, h2, h3⟩ := hcof ξ hξ
      exact ⟨ε', ⟨h1, h3⟩, hX.sub hS h2.le (lt_trans h3 hεκ) hx⟩
    · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
      exact ⟨ξ, hξ, hx⟩
  have mkU : ∀ {T : Model U L} {X : Ordinal.{u} → Model U L}, IsFilt s.S lam T X →
      T.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (X ε).carrier := by
    intro T X hX
    rw [hX.2.2.2.1]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨ε', h1, h2, h3⟩ := hE.1 ξ hξ
      exact ⟨ε', ⟨h1, h3⟩, hX.sub hS h2.le h3 hx⟩
    · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
      exact ⟨ξ, hξ, hx⟩
  exact Frame.nfhat_of_club hU hs hinf h₀ h₁ hE hNF (mkC hA) (mkC hB) (mkU hA) (mkU hB)
    (fun ε _ hε => hA.2.2.2.2 ε hε) (fun ε _ hε => hB.2.2.2.2 ε hε)

/-- AUX: not in paper. Prop 6.1.6(a), `←`, for filtrations. -/
theorem Frame.leNF_of_club [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ M₁ : Model U L}
    (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam))
    (h01 : s.S.le M₀ M₁) {E : Set Ordinal.{u}}
    (hE : ClubL lam E) {A B : Ordinal.{u} → Model U L}
    (hA : IsFilt s.S lam M₀ A) (hB : IsFilt s.S lam M₁ B)
    (hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ)) : s.leNF lam M₀ M₁ := by
  obtain ⟨ε₀, -, hε₀, h⟩ := Frame.nfhat_of_club_filt hU hs hinf h₀ h₁ hE hA hB hNF
  exact ⟨h₀, h₁, h01, _, hA.2.2.1 ε₀ hε₀, _, hB.2.2.1 ε₀ hε₀, h⟩

/-- AUX: not in paper. A witness pair for `NF^` is a pair of filtrations. -/
theorem Frame.nfhat_filt {s : Frame U L} {lam : Cardinal.{u}} {A B : Ordinal.{u} → Model U L}
    {M₀ M₁ : Model U L}
    (Ai : IsIncreasing s.S.le A (Iio (Order.succ lam).ord))
    (Ac : IsContinuous A (Iio (Order.succ lam).ord))
    (Bi : IsIncreasing s.S.le B (Iio (Order.succ lam).ord))
    (Bc : IsContinuous B (Iio (Order.succ lam).ord))
    (hst : ∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)))
    (hMA : IsUnionOf A (Iio (Order.succ lam).ord) M₀)
    (hMB : IsUnionOf B (Iio (Order.succ lam).ord) M₁) :
    IsFilt s.S lam M₀ A ∧ IsFilt s.S lam M₁ B :=
  ⟨⟨Ai, Ac, fun α hα => (hst α hα).1, hMA⟩, ⟨Bi, Bc, fun α hα => (hst α hα).2.1, hMB⟩⟩

/-- AUX: not in paper. Prop 6.1.6(a), `→`, for filtrations. -/
theorem Frame.club_of_leNF [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {M₀ M₁ : Model U L} (h : s.leNF lam M₀ M₁)
    {R₀ R₁ : Ordinal.{u} → Model U L} (hR₀ : IsFilt s.S lam M₀ R₀) (hR₁ : IsFilt s.S lam M₁ R₁) :
    ∃ E, ClubL lam E ∧ ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (R₀ ε) (R₀ ζ) (R₁ ε) (R₁ ζ) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, N₀, hN₀, N₁, -, -, -, -, -, A, B, Ai, Ac, Bi, Bc, hst, -, -, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hN₀
  obtain ⟨hA, hB⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst hMA hMB
  have club : ∀ {T : Model U L} {X Y : Ordinal.{u} → Model U L}, IsFilt s.S lam T X →
      IsFilt s.S lam T Y → ∃ D, ClubL lam D ∧ ∀ ε ∈ D, ε < (Order.succ lam).ord → X ε = Y ε := by
    intro T X Y hX hY
    obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (X ε).carrier)
      (G := fun ε => (Y ε).carrier)
      (fun a b h hb => hX.sub hS h hb) (fun a b h hb => hY.sub hS h hb)
      (fun b hb hl => hX.2.1 b hb hl) (fun b hb hl => hY.2.1 b hb hl)
      (fun a ha => le_of_eq (hX.2.2.1 a ha).2) (fun a ha => le_of_eq (hY.2.2.1 a ha).2)
      (by rw [← hX.2.2.2.1, ← hY.2.2.2.1])
    refine ⟨_, ⟨hub, hcl⟩, fun ε hε hκ => ?_⟩
    have e : (X ε).carrier = (Y ε).carrier := hε
    exact hS.po.2.2.1 _ _ (hS.le_of_sub (hX.le hS hinf hκ) (hY.le hS hinf hκ) (le_of_eq e))
      (hS.le_of_sub (hY.le hS hinf hκ) (hX.le hS hinf hκ) (le_of_eq e.symm))
  obtain ⟨D₀, hD₀, e₀⟩ := club hA hR₀
  obtain ⟨D₁, hD₁, e₁⟩ := club hB hR₁
  refine ⟨_, ClubL.inter hinf hD₀ hD₁, fun ε hε ζ hζ h hl => ?_⟩
