    obtain ⟨i, hi, rfl⟩ := hen _ (inv α hα).2.1 p hp
    obtain ⟨ε, hε, hpε⟩ := hpr α hα i hi
    have hm : max ε α < (Order.succ lam).ord := max_lt hε hα
    refine ⟨max ε α + 1, hκl.add_one_lt hm, fun β hβ hle => ?_⟩
