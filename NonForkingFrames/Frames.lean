    have hα1 := hκl.add_one_lt hα
    obtain ⟨kA', hlt, -, hsub, hDB, -⟩ := h.2.2 α hα1
    obtain ⟨x, hx, -⟩ := hc.ax2c _ (inv α hα).1 _ kA' hlt
    have hxB : x ∉ (B α).carrier := fun hxB =>
      hx.2 (hDB ▸ (⟨hsub hx.1, hxB⟩ : x ∈ D α (fun i => A i) ∩ (B α).carrier))
    obtain ⟨-, -, -, -, -, -, -, l23, -⟩ := id (hstep α hα)
    have hx1 : x ∈ (B (α + 1)).carrier := hS.sub l23 hx.1
    rcases (hsucc hαβ).lt_or_eq with h' | h'
    · exact hxB (e ▸ hS.sub (Bi _ hα1 β hβ h') hx1)
    · exact hxB (e ▸ h' ▸ hx1)
  refine ⟨⟨⟨Ai, Ac, fun α hα => (inv α hα).1⟩, ⟨Bi, Bc, fun α hα => (inv α hα).2.1⟩, ?_,
    fun α hα => (out α hα).1, ⟨subset_rfl, fun α hα => ⟨α + 1, hκl.add_one_lt hα,
      Order.lt_add_one_iff.2 le_rfl⟩, fun γ hγ _ _ => hγ⟩, hM₀, hM₁,
    fun α hα => ⟨(inv α hα).2.2.1, (out α hα).2.1⟩, ?_, ?_⟩, hstep⟩
  · intro a ha b hb hab
    obtain ⟨-, -, -, -, n, -⟩ := out a ha
