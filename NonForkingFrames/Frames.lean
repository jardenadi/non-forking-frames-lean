        · exact hS.trans (((ih r hrt).2.2.2.1 r' h).1 ε hε) (l1Tb ε hεr)
        · rw [h]; exact l1Tb ε hεr
      · show s.S.le (c r').2.2 N1
        rcases hr'r.lt_or_eq with h | h
        · exact hS.trans ((ih r hrt).2.2.2.1 r' h).2 (hS.trans lTN lN1)
        · rw [h]; exact hS.trans lTN lN1
    · have he' : r' = r := (Order.succ_injective (show Order.succ r = Order.succ r' from hr')).symm
      rw [he']
      refine ⟨⟨f x, ?_, fun hin => ?_⟩, fun ε hε => ?_, fun ε hε => ?_, ?_, sub1 (Or.inr rfl)⟩
      · show f x ∈ (xa 0).carrier
        rw [xa1 0 zero_le]; exact (hb 0 zero_le).mapsTo hx0
      · have hin' : f x ∈ (a r).carrier := hin
        have hy := hfid (f x) hin'
        have hEq : f x = x := iPm.injOn (hS.sub l0r hin') (hsuba' 0 zero_le hx0) hy
        exact hxZ (hS.sub laT (hEq ▸ hin'))
      · obtain ⟨k, l, hreal, -⟩ := hcol ε hε
        have iC := hC' ε hε
        refine ⟨⟨hS.iso_mem k.1 iC, by rw [iC.card_eq]; exact k.2⟩,
          hS.iso_le l iC (fid _ (Order.add_one_le_of_lt hε)), fun ε' hε' hT => ?_, ?_⟩
        · obtain ⟨d, hd, hE⟩ := hreal ε' hε' hT
          refine ⟨f d, iC.mapsTo hd, ?_⟩
          rw [← hE]
          exact (tp_emb hS ⟨(A1 _ (Order.add_one_le_of_lt hε)).1.1, k.1, l, hd⟩
            (hS.iso_le l iC (fid _ (Order.add_one_le_of_lt hε)))
            ⟨k.1, hS.iso_mem k.1 iC, C' ε, hS.refl (hS.iso_mem k.1 iC), iC⟩
