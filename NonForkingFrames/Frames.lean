        have bc : IsContinuous b (Iic r) := by
          intro β hβ hl
          rw [(hb β hβ).carrier_eq, ac' β hβ hl, Set.image_iUnion₂]
          exact Set.iUnion₂_congr fun ζ hζ =>
            ((hb ζ (le_of_lt (lt_of_lt_of_le hζ hβ))).carrier_eq).symm
        have := Frame.nf_long hU hs5 hδ hδpos
          (Ma := fun i => a (ε + i)) (Mb := fun i => b (ε + i))
