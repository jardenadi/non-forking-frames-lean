/-- Prop 8.1.5 (LST for pairs): if `M₀ ≼ M₁`, `‖Mₙ‖ = λ⁺`, `Aₙ ⊆ Mₙ`, `|Aₙ| ≤ λ`, there are
`N₀, N₁ ∈ K_λ` with `Aₙ ⊆ Nₙ ≼ Mₙ` and `N₁ ∩ M₀ = N₀`. -/
-- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 6.1.6(b),(e),(f).
theorem prop_8_1_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_8_1_1 s lam)
    (hinf : ℵ₀ ≤ lam)
    (M₀ M₁ : Model U L) (h01 : s.S.le M₀ M₁) (hc₀ : M₀.card = Order.succ lam)
    (hc₁ : M₁.card = Order.succ lam) (A₀ A₁ : Set U) (hA₀ : A₀ ⊆ M₀.carrier)
    (hA₁ : A₁ ⊆ M₁.carrier) (hA₀c : #A₀ ≤ lam) (hA₁c : #A₁ ≤ lam) :
    ∃ N₀ ∈ s.S.Kc lam, ∃ N₁ ∈ s.S.Kc lam, A₀ ⊆ N₀.carrier ∧ s.S.le N₀ M₀ ∧ A₁ ⊆ N₁.carrier ∧
      s.S.le N₁ M₁ ∧ N₁.carrier ∩ M₀.carrier = N₀.carrier := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hL : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hc.ax0b
  have memM₀ := hS.mem_left h01
  have memM₁ := hS.mem_right h01
  have mkK : ∀ {T : Model U L} (hT : T ∈ s.S.K) (A : Set U), A ⊆ T.carrier → #A ≤ lam → lam ≤ #A →
      ∃ X ∈ s.S.Kc lam, A ⊆ X.carrier ∧ s.S.le X T := by
    intro T hT A hA h1 h2
    obtain ⟨X, hX, hAX, lX, hcd⟩ := hL T hT A hA
    exact ⟨X, ⟨hX, le_antisymm (hcd.trans (Cardinal.add_le_of_le hinf le_rfl h1))
      (h2.trans (Cardinal.mk_le_mk_of_subset hAX))⟩, hAX, lX⟩
  have hlM : lam ≤ #M₀.carrier := by
    have : #M₀.carrier = Order.succ lam := hc₀
    rw [this]; exact Order.le_succ lam
  obtain ⟨A', hA', hA'c⟩ := Cardinal.le_mk_iff_exists_subset.1 hlM
  obtain ⟨X₀, kX₀, s0, lX₀⟩ := mkK memM₀ (A₀ ∪ A') (Set.union_subset hA₀ hA')
    ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf hA₀c hA'c.le))
    (by rw [← hA'c]; exact Cardinal.mk_le_mk_of_subset Set.subset_union_right)
  have hX₀c : #X₀.carrier = lam := kX₀.2
  obtain ⟨Y₀, kY₀, s1, lY₀⟩ := mkK memM₁ (A₁ ∪ X₀.carrier)
    (Set.union_subset hA₁ ((hS.sub lX₀).trans (hS.sub h01)))
    ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf hA₁c hX₀c.le))
    (by rw [← hX₀c]; exact Cardinal.mk_le_mk_of_subset Set.subset_union_right)
  let St : Model U L × Model U L → Prop := fun p => p.1 ∈ s.S.Kc lam ∧ p.2 ∈ s.S.Kc lam ∧
    s.S.le p.1 M₀ ∧ s.S.le p.2 M₁ ∧ p.1.carrier ⊆ p.2.carrier
  have step : ∀ p : {p // St p}, ∃ q : {p // St p}, s.S.le p.1.1 q.1.1 ∧ s.S.le p.1.2 q.1.2 ∧
      p.1.2.carrier ∩ M₀.carrier ⊆ q.1.1.carrier := by
    rintro ⟨⟨X, Y⟩, kX, kY, lX, lY, hXY⟩
    have cX : #X.carrier = lam := kX.2
    have cY : #Y.carrier = lam := kY.2
    obtain ⟨X', kX', sX', lX'⟩ := mkK memM₀ (X.carrier ∪ (Y.carrier ∩ M₀.carrier))
      (Set.union_subset (hS.sub lX) Set.inter_subset_right)
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf cX.le
        ((Cardinal.mk_le_mk_of_subset Set.inter_subset_left).trans cY.le)))
      (by rw [← cX]; exact Cardinal.mk_le_mk_of_subset Set.subset_union_left)
    have cX' : #X'.carrier = lam := kX'.2
    obtain ⟨Y', kY', sY', lY'⟩ := mkK memM₁ (Y.carrier ∪ X'.carrier)
      (Set.union_subset (hS.sub lY) ((hS.sub lX').trans (hS.sub h01)))
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf cY.le cX'.le))
      (by rw [← cY]; exact Cardinal.mk_le_mk_of_subset Set.subset_union_left)
    exact ⟨⟨(X', Y'), kX', kY', lX', lY', Set.subset_union_right.trans sY'⟩,
      hS.le_of_sub lX lX' (Set.subset_union_left.trans sX'),
      hS.le_of_sub lY lY' (Set.subset_union_left.trans sY'),
      Set.subset_union_right.trans sX'⟩
  choose nxt h1 h2 h3 using step
  let z : ℕ → {p // St p} := fun n => Nat.rec ⟨(X₀, Y₀), kX₀, kY₀, lX₀, lY₀,
    Set.subset_union_right.trans s1⟩ (fun _ p => nxt p) n
  have zs : ∀ n, z (n + 1) = nxt (z n) := fun n => rfl
  let X : ℕ → Model U L := fun n => (z n).1.1
  let Y : ℕ → Model U L := fun n => (z n).1.2
  have lXs : ∀ n, s.S.le (X n) (X (n + 1)) := fun n => by
    show s.S.le (z n).1.1 (z (n + 1)).1.1
    rw [zs]; exact h1 (z n)
  have lYs : ∀ n, s.S.le (Y n) (Y (n + 1)) := fun n => by
    show s.S.le (z n).1.2 (z (n + 1)).1.2
    rw [zs]; exact h2 (z n)
  obtain ⟨Xω, -, kXω, cXω, lXω, lXωM, -⟩ := hS.nat_chain hinf (fun n => (z n).2.1) lXs
    (fun n => (z n).2.2.2.1)
  obtain ⟨Yω, -, kYω, cYω, lYω, lYωM, -⟩ := hS.nat_chain hinf (fun n => (z n).2.2.1) lYs
    (fun n => (z n).2.2.2.2.1)
  refine ⟨Xω, kXω, Yω, kYω, fun x hx => hS.sub (lXω 0) (s0 (Or.inl hx)), lXωM,
    fun x hx => hS.sub (lYω 0) (s1 (Or.inl hx)), lYωM, ?_⟩
  ext x
  constructor
  · rintro ⟨hx, hx0⟩
    rw [cYω] at hx
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hx
    have : x ∈ (X (n + 1)).carrier := by
      show x ∈ (z (n + 1)).1.1.carrier
      rw [zs]; exact h3 (z n) ⟨hn, hx0⟩
    exact hS.sub (lXω (n + 1)) this
  · intro hx
    refine ⟨?_, hS.sub lXωM hx⟩
    rw [cXω] at hx
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hx
    exact hS.sub (lYω n) ((z n).2.2.2.2.2 hn)

/-- AUX: not in paper. An injection on a small set extends to a permutation of `U`. -/
theorem exists_perm_ext (hinf : Infinite U) {f : U → U} {X : Set U} (hinj : InjOn f X)
    (hs : #X < #U) : ∃ σ : Equiv.Perm U, ∀ x ∈ X, σ x = f x := by
  classical
  have hs' : #(f '' X : Set U) < #U := lt_of_le_of_lt Cardinal.mk_image_le hs
  have hc : #(Xᶜ : Set U) = #((f '' X)ᶜ : Set U) := by
    rw [Cardinal.mk_compl_of_infinite _ hs, Cardinal.mk_compl_of_infinite _ hs']
  obtain ⟨e2⟩ := Cardinal.eq.1 hc
  let e1 := Equiv.Set.imageOfInjOn f X hinj
  refine ⟨(Equiv.Set.sumCompl X).symm.trans ((Equiv.sumCongr e1 e2).trans
    (Equiv.Set.sumCompl (f '' X))), fun x hx => ?_⟩
  simp [Equiv.Set.sumCompl_symm_apply_of_mem hx, e1]
  rfl

/-- AUX: not in paper. The image of a model under a permutation of `U`. -/
noncomputable def permModel (σ : Equiv.Perm U) (M : Model U L) : Model U L :=
  (exists_isoOn (M := M) (σ.injective.injOn)).choose

/-- AUX: not in paper. -/
theorem permModel_iso (σ : Equiv.Perm U) (M : Model U L) : IsoOn σ M (permModel σ M) :=
  (exists_isoOn (M := M) (σ.injective.injOn)).choose_spec

/-- AUX: not in paper. -/
theorem permModel_eq {σ : Equiv.Perm U} {M N : Model U L} (h : IsoOn σ M N) :
    permModel σ M = N :=
  (permModel_iso σ M).unique h

/-- AUX: not in paper. -/
theorem permModel_symm_iso (σ : Equiv.Perm U) (M : Model U L) :
    IsoOn (σ.symm : U → U) (permModel σ M) M := by
  obtain ⟨r, hr, -, r2⟩ := (permModel_iso σ M).exists_inv
  exact hr.congr fun y hy => (Equiv.eq_symm_apply σ).2 (r2 y hy)

/-- AUX: not in paper. -/
theorem permModel_symm (σ : Equiv.Perm U) (M : Model U L) :
    permModel σ.symm (permModel σ M) = M :=
  permModel_eq (permModel_symm_iso σ M)

/-- AUX: not in paper. -/
theorem permModel_symm' (σ : Equiv.Perm U) (M : Model U L) :
    permModel σ (permModel σ.symm M) = M := by
  simpa using permModel_symm σ.symm M

/-- AUX: not in paper. `E` is preserved by a permutation of `U`. -/
theorem ERel.perm {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (σ : Equiv.Perm U)
    {t t' : Tri U L} (h : ERel S lam t t') :
    ERel S lam (permModel σ t.1, permModel σ t.2.1, σ t.2.2)
      (permModel σ t'.1, permModel σ t'.2.1, σ t'.2.2) := by
  have hK : ∀ {t : Tri U L}, t ∈ S.K3 →
      ((permModel σ t.1, permModel σ t.2.1, σ t.2.2) : Tri U L) ∈ S.K3 := by
    rintro ⟨M, N, a⟩ ⟨h0, h1, h2, h3⟩
    exact ⟨hS.iso_mem h0 (permModel_iso σ M), hS.iso_mem h1 (permModel_iso σ N),
      hS.iso_le h2 (permModel_iso σ N) (permModel_iso σ M), (permModel_iso σ N).mapsTo h3⟩
  induction h with
  | rel x y hxy =>
    obtain ⟨hx, hy, e, N₂, hN₂, le, f, hf, hov, hfa⟩ := hxy
    refine Relation.EqvGen.rel _ _ ⟨hK hx, hK hy, by simp only [e], permModel σ N₂,
      hS.iso_mem hN₂ (permModel_iso σ N₂), hS.iso_le le (permModel_iso σ N₂) (permModel_iso σ _),
      fun z => σ (f (σ.symm z)), ?_, ?_, by simp [hfa]⟩
    · obtain ⟨h0, h1, M', hM', iso⟩ := hf
      refine ⟨hS.iso_mem h0 (permModel_iso σ _), hS.iso_mem h1 (permModel_iso σ N₂),
        permModel σ M', hS.iso_le hM' (permModel_iso σ N₂) (permModel_iso σ M'), ?_⟩
      exact ((permModel_symm_iso σ _).comp iso).comp (permModel_iso σ M')
    · obtain ⟨hsub, hfix⟩ := hov
      refine ⟨?_, ?_⟩
      · intro z hz
        rw [(permModel_iso σ x.1).carrier_eq] at hz
        obtain ⟨w, hw, rfl⟩ := hz
        have := hsub hw
        exact ⟨(permModel_iso σ _).mapsTo this.1, (permModel_iso σ _).mapsTo this.2⟩
      · intro z hz
        rw [(permModel_iso σ x.1).carrier_eq] at hz
        obtain ⟨w, hw, rfl⟩ := hz
        simp [hfix w hw]
  | refl x => exact Relation.EqvGen.refl _
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- AUX: not in paper. A witness of `≺⁺` is carried by a permutation of `U`. -/
theorem Frame.PlusWit.perm {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (σ : Equiv.Perm U) {M₀ M₁ M₀' M₁' : Model U L} {A B C : Ordinal.{u} → Model U L}
    {E : Set Ordinal.{u}} (h : s.PlusWit lam M₀ M₁ A B C E) (i₀ : IsoOn σ M₀ M₀')
    (i₁ : IsoOn σ M₁ M₁') :
    s.PlusWit lam M₀' M₁' (fun α => permModel σ (A α)) (fun α => permModel σ (B α))
      (fun α => permModel σ (C α)) E := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have iP := permModel_iso (L := L) σ
  obtain ⟨hA, hB, hCi, hCK, hE, h0, h1, hb, hcc, hd⟩ := h
  have tK : ∀ {κ : Cardinal.{u}} {X : Model U L}, X ∈ s.S.Kc κ → permModel σ X ∈ s.S.Kc κ :=
    fun hX => ⟨hS.iso_mem hX.1 (iP _), by rw [(iP _).card_eq]; exact hX.2⟩
  have tI : ∀ {X : Ordinal.{u} → Model U L} {I : Set Ordinal.{u}},
      IsIncreasing s.S.le X I → IsIncreasing s.S.le (fun α => permModel σ (X α)) I :=
    fun hX a ha b hb hab => hS.iso_le (hX a ha b hb hab) (iP _) (iP _)
  have tIC : ∀ {X : Ordinal.{u} → Model U L}, IsIncCont s.S X (Iio (Order.succ lam).ord) (s.S.Kc lam) →
      IsIncCont s.S (fun α => permModel σ (X α)) (Iio (Order.succ lam).ord) (s.S.Kc lam) := by
    intro X hX
    refine ⟨tI hX.1, fun β hβ hl => ?_, fun α hα => tK (hX.2.2 α hα)⟩
    show (permModel σ (X β)).carrier = _
    rw [(iP _).carrier_eq, hX.2.1 β hβ hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun a _ => ((iP (X a)).carrier_eq).symm
  have tU : ∀ {X : Ordinal.{u} → Model U L} {N N' : Model U L},
      IsUnionOf X (Iio (Order.succ lam).ord) N → IsoOn σ N N' →
      IsUnionOf (fun α => permModel σ (X α)) (Iio (Order.succ lam).ord) N' := by
    intro X N N' hX iN
    refine ⟨?_, fun α hα => hX.2 α hα |>.image iN (iP _)⟩
    rw [iN.carrier_eq, hX.1, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun a _ => ((iP (X a)).carrier_eq).symm
  refine ⟨tIC hA, tIC hB, tI hCi, fun α hα => tK (hCK α hα), hE, tU h0 i₀, tU h1 i₁,
    fun α hα => ⟨hS.iso_le (hb α hα).1 (iP _) (iP _), hS.iso_le (hb α hα).2 (iP _) (iP _)⟩,
    fun α hα β hβ hab => Frame.nf_iso hU hc (hcc α hα β hβ hab) (iP _) (iP _) (iP _) (iP _), ?_⟩
  intro α hα p' hp'
  have kB' : permModel σ (B α) ∈ s.S.Kc lam := tK (hB.2.2 α (hE.1 hα))
  obtain ⟨N', a', -, -, -, rfl⟩ := hc.ax2a _ kB' hp'
  have hp : tp s.S lam (σ.symm a') (B α) (permModel σ.symm N') ∈ s.Sbs (B α) :=
    hc.ax2b _ N' _ _ a' _ kB' hp' (permModel_iso σ.symm N') (permModel_symm_iso σ (B α))
  obtain ⟨γ, hγ, hall⟩ := hd α hα _ hp
  refine ⟨γ, hγ, fun β hβ hle => ?_⟩
  obtain ⟨q, hq, ⟨hnf, hres⟩, c, hcm, rfl⟩ := hall β hβ hle
  have kBβ := hB.2.2 β (hE.1 hβ)
  obtain ⟨-, -, -, -, -, -, -, -, lαβ, -, -, -⟩ := hnf.facts hc.ax3a
  have lBC := (hb β hβ).2
  refine ⟨tp s.S lam (σ c) (permModel σ (B β)) (permModel σ (C β)),
    hc.ax2b _ _ _ _ c _ kBβ hq (iP _) (iP _), ⟨Frame.notFork_iso hU hc hnf lBC hcm (iP _) (iP _) (iP _), ?_⟩,
    σ c, (iP _).mapsTo hcm, rfl⟩
  rw [res_tp hS (hS.iso_le lαβ (iP _) (iP _))]
  rw [res_tp hS lαβ] at hres
  have hE' := ERel.perm hS σ (tp_eq_iff.1 hres)
  simp only [permModel_symm', Equiv.apply_symm_apply] at hE'
  exact tp_eq_iff.2 hE'

/-- AUX: not in paper. `≺⁺` is invariant under isomorphisms. -/
theorem Frame.ltPlus_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {f : U → U} {M₀ M₁ M₀' M₁' : Model U L} (h : s.ltPlus lam M₀ M₁) (i₀ : IsoOn f M₀ M₀')
    (i₁ : IsoOn f M₁ M₁') (hsub : M₀.carrier ⊆ M₁.carrier) : s.ltPlus lam M₀' M₁' := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k₀, k₁, A, B, C, E, w⟩ := h
  have hsm : #M₁.carrier < #U := by
    have e : #M₁.carrier = Order.succ lam := k₁.2
    rw [e]
    exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.isStrongPrelimit hU.2)
  obtain ⟨σ, hσ⟩ := exists_perm_ext hU.infinite i₁.injOn hsm
  have j₁ : IsoOn σ M₁ M₁' := i₁.congr fun x hx => (hσ x hx).symm
  have j₀ : IsoOn σ M₀ M₀' := i₀.congr fun x hx => (hσ x (hsub hx)).symm
  exact ⟨⟨hS.iso_mem k₀.1 j₀, by rw [j₀.card_eq]; exact k₀.2⟩,
    ⟨hS.iso_mem k₁.1 j₁, by rw [j₁.card_eq]; exact k₁.2⟩, _, _, _, _, w.perm hU hc σ j₀ j₁⟩

/-- AUX: not in paper. A union of isomorphisms of chains is an isomorphism of the unions. -/
theorem IsoOn.union {S : KSys U L} (hS : IsAEC S) {δ : Ordinal.{u}} (hδ : Order.IsSuccLimit δ)
    {A B : Ordinal.{u} → Model U L} {PA PB : Model U L} {F : U → U}
    (hA : IsIncreasing S.le A (Iio δ)) (hB : IsIncreasing S.le B (Iio δ))
    (uA : IsUnionOf A (Iio δ) PA) (uB : IsUnionOf B (Iio δ) PB)
    (hF : ∀ i < δ, IsoOn F (A i) (B i)) : IsoOn F PA PB := by
  have hsA : ∀ α < δ, ∀ β < δ, α < β → (A α).carrier ⊆ (A β).carrier :=
    fun α hα β hβ h => hS.sub (hA α hα β hβ h)
  have hsB : ∀ α < δ, ∀ β < δ, α < β → (B α).carrier ⊆ (B β).carrier :=
    fun α hα β hβ h => hS.sub (hB α hα β hβ h)
  have hinj : InjOn F PA.carrier := by
    intro x hx y hy hxy
    rw [uA.1] at hx hy
    obtain ⟨i, hi, hx⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨j, hj, hy⟩ := Set.mem_iUnion₂.1 hy
    have hi' : i < δ := hi
    have hj' : j < δ := hj
    rcases lt_trichotomy i j with h | h | h
    · exact (hF j hj').injOn (hsA i hi' j hj' h hx) hy hxy
    · subst h; exact (hF i hi').injOn hx hy hxy
    · exact (hF i hi').injOn hx (hsA j hj' i hi' h hy) hxy
  obtain ⟨Q, hQ⟩ := exists_isoOn hinj
  have uQ : IsUnionOf B (Iio δ) Q := by
    refine ⟨?_, fun i hi => (uA.2 i hi).image hQ (hF i hi)⟩
    rw [hQ.carrier_eq, uA.1, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun i hi => ((hF i hi).carrier_eq).symm
  rw [← IsUnionOf.unique hδ hsB uQ uB]
  exact hQ

/-- AUX: not in paper. Below a union of a `≼^NF`-increasing continuous chain, every member is
`≼^NF` the union (Prop 6.1.6(d) applied to a final segment). -/
theorem Frame.leNF_of_union [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {θ : Ordinal.{u}} (hθ : Order.IsSuccLimit θ)
    (hθ' : θ < (plusN lam 2).ord) {N : Ordinal.{u} → Model U L}
    (hinc : IsIncreasing (s.leNF lam) N (Iio θ)) (hcont : IsContinuous N (Iio θ)) {P : Model U L}
    (hP : IsUnionOf N (Iio θ) P) {i : Ordinal.{u}} (hi : i < θ) : s.leNF lam (N i) P := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  let N' : Ordinal.{u} → Model U L := fun ξ => N (max i ξ)
  have hsub : ∀ a < θ, ∀ b < θ, a ≤ b → (N a).carrier ⊆ (N b).carrier := fun a ha b hb h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hinc a ha b hb h').2.2.1
    · rw [h']
  have hmax : ∀ ξ < θ, max i ξ < θ := fun ξ hξ => max_lt hi hξ
  have hN'inc : IsIncreasing (s.leNF lam) N' (Iio θ) := by
    intro a ha b hb hab
    have ha' : a < θ := ha
    have hb' : b < θ := hb
    rcases le_or_gt b i with h | h
    · have e1 : max i a = i := max_eq_left (hab.le.trans h)
      have e2 : max i b = i := max_eq_left h
      show s.leNF lam (N (max i a)) (N (max i b))
      rw [e1, e2]
      have h1 : i + 1 < θ := hθ.add_one_lt hi
      exact Frame.leNF_refl hU hs hinf (hinc i hi (i + 1) h1 (Order.lt_add_one_iff.2 le_rfl)).1
    · have e2 : max i b = b := max_eq_right h.le
      have hlt : max i a < b := max_lt h hab
      show s.leNF lam (N (max i a)) (N (max i b))
      rw [e2]
      exact hinc _ (hmax a ha') _ hb' hlt
  have hN'cont : IsContinuous N' (Iio θ) := by
    intro β hβ hl
    have hβ' : β < θ := hβ
    show (N (max i β)).carrier = _
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, N']
    constructor
    · intro hx
      rcases le_or_gt β i with h | h
      · rw [max_eq_left h] at hx
        refine ⟨0, hl.bot_lt, ?_⟩
        rw [max_eq_left zero_le]; exact hx
      · rw [max_eq_right h.le, hcont β hβ hl] at hx
        obtain ⟨α, hα, hx⟩ := Set.mem_iUnion₂.1 hx
        have hα' : α < β := hα
        exact ⟨α, hα', hsub α (hα'.trans hβ') _ (hmax α (hα'.trans hβ')) (le_max_right _ _) hx⟩
    · rintro ⟨α, hα, hx⟩
      exact hsub _ (hmax α (hα.trans hβ')) _ (hmax β hβ') (max_le_max le_rfl hα.le) hx
  obtain ⟨Q, hQ, -, hl⟩ := Frame.leNF_union hU hs hθ hθ' hN'inc hN'cont
  have hN0 : N' 0 = N i := by simp [N']
  have uP : IsUnionOf N' (Iio θ) P := by
    refine ⟨?_, fun ξ hξ => hP.2 _ (hmax ξ hξ)⟩
    rw [hP.1]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, N']
    constructor
    · rintro ⟨α, hα, hx⟩
      exact ⟨α, hα, hsub α hα _ (hmax α hα) (le_max_right _ _) hx⟩
    · rintro ⟨α, hα, hx⟩
      exact ⟨_, hmax α hα, hx⟩
  have hsub' : ∀ a < θ, ∀ b < θ, a < b → (N' a).carrier ⊆ (N' b).carrier :=
    fun a ha b hb h => hS.sub (hN'inc a ha b hb h).2.2.1
  rw [← IsUnionOf.unique hθ hsub' hQ uP, ← hN0]
  exact hl

/-- AUX: not in paper. A continuous `≼`-chain whose successor steps are `≼^NF` is `≼^NF`-increasing. -/
theorem Frame.leNF_chain [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {θ : Ordinal.{u}} (hθ' : θ < (plusN lam 2).ord)
    {N : Ordinal.{u} → Model U L} (hle : IsIncreasing s.S.le N (Iio θ))
    (hcont : IsContinuous N (Iio θ)) (hstep : ∀ i, i + 1 < θ → s.leNF lam (N i) (N (i + 1))) :
    IsIncreasing (s.leNF lam) N (Iio θ) := by
  classical
  have hS : IsAEC s.S := hs.1.1.ax0a
  have key : ∀ j, j < θ → ∀ i < j, s.leNF lam (N i) (N j) := by
    intro j
    induction j using Ordinal.lt_wf.induction with
    | _ j ih =>
      intro hj i hij
      rcases Ordinal.zero_or_succ_or_isSuccLimit j with h0 | ⟨k, hk⟩ | hlim
      · subst h0; exact absurd hij (not_lt.2 zero_le)
      · subst hk
        have hkj : k < Order.succ k := Order.lt_succ k
        have e : Order.succ k = k + 1 := rfl
        rcases (Order.lt_succ_iff.1 hij).lt_or_eq with h | h
        · exact Frame.leNF_trans hU hs (ih k hkj (hkj.trans hj) i h) (e ▸ hstep k (e ▸ hj))
        · rw [h]; exact e ▸ hstep k (e ▸ hj)
      · refine Frame.leNF_of_union hU hs hinf hlim (hj.trans hθ') (fun a ha b hb hab => ?_) ?_ ?_ hij
        · exact ih b hb (lt_trans hb hj) a hab
        · exact fun β hβ hl => hcont β (lt_trans hβ hj) hl
        · exact ⟨hcont j hj hlim, fun α hα => hS.incl _ _ (hle α (lt_trans hα hj) j hj hα)⟩
  exact fun a _ b hb hab => key b hb a hab

/-- AUX: not in paper. Two continuous `≺⁺`-chains over the same first model are isomorphic,
by a single function. -/
theorem Frame.plus_iso_chain [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_7_1_1 s lam) {θ : Ordinal.{u}}
    {A B : Ordinal.{u} → Model U L} (h0 : A 0 = B 0)
    (hAK : ∀ i < θ, A i ∈ s.S.Kc (Order.succ lam))
    (hAi : IsIncreasing s.S.le A (Iio θ)) (hBi : IsIncreasing s.S.le B (Iio θ))
    (hAc : IsContinuous A (Iio θ)) (hBc : IsContinuous B (Iio θ))
    (hAs : ∀ i, i + 1 < θ → s.ltPlus lam (A i) (A (i + 1)))
    (hBs : ∀ i, i + 1 < θ → s.ltPlus lam (B i) (B (i + 1))) :
    ∃ F : U → U, ∀ i < θ, IsoOn F (A i) (B i) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsmall : ∀ i < θ, #(A i).carrier < #U := fun i hi => by
    have e : #(A i).carrier = Order.succ lam := (hAK i hi).2
    rw [e]
    exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.isStrongPrelimit hU.2)
  have hsA : ∀ a < θ, ∀ b < θ, a ≤ b → (A a).carrier ⊆ (A b).carrier := fun a ha b hb h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hAi a ha b hb h')
    · rw [h']
  let Inv : Ordinal.{u} → (Ordinal.{u} → U → U) → Prop := fun i f =>
    i < θ → IsoOn (f i) (A i) (B i) ∧ ∀ j < i, ∀ x ∈ (A j).carrier, f i x = f j x
  have hloc : ∀ α (c c' : Ordinal.{u} → U → U), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' h hi hα
    obtain ⟨h1, h2⟩ := hi hα
    refine ⟨h α le_rfl ▸ h1, fun j hj x hx => ?_⟩
    rw [← h α le_rfl, ← h j hj.le]; exact h2 j hj x hx
  have : Nonempty (U → U) := ⟨id⟩
  obtain ⟨f, hf⟩ := transfinite_construction θ Inv hloc (by
    intro α hαθ c ih
    by_cases hα : α < θ
    swap
    · exact ⟨id, fun h => absurd h hα⟩
    have ih' : ∀ β < α, IsoOn (c β) (A β) (B β) ∧ ∀ j < β, ∀ x ∈ (A j).carrier, c β x = c j x :=
      fun β hβ => ih β hβ (hβ.trans hα)
    suffices hx : ∃ x : U → U, IsoOn x (A α) (B α) ∧ ∀ j < α, ∀ y ∈ (A j).carrier, x y = c j y by
      obtain ⟨x, h1, h2⟩ := hx
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, fun j hj y hy => ?_⟩
      simp only [hj, ite_true]
      exact h2 j hj y hy
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0α | ⟨k, hk⟩ | hlim
    · subst h0α
      exact ⟨id, h0 ▸ IsoOn.refl _, fun j hj => absurd hj (not_lt.2 zero_le)⟩
    · subst hk
      have e : Order.succ k = k + 1 := rfl
      have hkα : k < Order.succ k := Order.lt_succ k
      have hkθ : k < θ := hkα.trans hα
      obtain ⟨hk1, hk2⟩ := ih' k hkα
      obtain ⟨σ, hσ⟩ := exists_perm_ext hU.infinite hk1.injOn (hsmall k hkθ)
      have jk : IsoOn σ (A k) (B k) := hk1.congr fun x hx => (hσ x hx).symm
      have iP := permModel_iso σ (A (k + 1))
      have hpl : s.ltPlus lam (B k) (permModel σ (A (k + 1))) :=
        Frame.ltPlus_iso hU hc (hAs k (e ▸ hα)) jk iP (hsA k hkθ _ (e ▸ hα) (e ▸ hkα.le))
      obtain ⟨g, hg, -, hgo⟩ := thm_7_1_13_a lam hU s hs _ _ _ hpl (hBs k (e ▸ hα))
      refine ⟨g ∘ σ, e ▸ iP.comp hg, fun j hj y hy => ?_⟩
      have hjk : j ≤ k := Order.lt_succ_iff.1 hj
      have hyk : y ∈ (A k).carrier := hsA j (lt_of_le_of_lt hjk hkθ) k hkθ hjk hy
      have hgσ : g (σ y) = c k y := by
        rw [hσ y hyk]; exact hgo _ (hk1.mapsTo hyk)
      rcases hjk.lt_or_eq with h | h
      · show g (σ y) = c j y
        rw [hgσ]; exact hk2 j h y hy
      · rw [h]; exact hgσ
    · have hsAo : ∀ a < α, ∀ b < α, a ≤ b → (A a).carrier ⊆ (A b).carrier := fun a ha b hb h =>
        hsA a (ha.trans hα) b (hb.trans hα) h
      have uA : IsUnionOf A (Iio α) (A α) :=
        ⟨hAc α hα hlim, fun i hi => hS.incl _ _ (hAi i (lt_trans hi hα) α hα hi)⟩
      have uB : IsUnionOf B (Iio α) (B α) :=
        ⟨hBc α hα hlim, fun i hi => hS.incl _ _ (hBi i (lt_trans hi hα) α hα hi)⟩
      let G : U → U := fun x => if h : ∃ i < α, x ∈ (A i).carrier then c h.choose x else x
      have hG : ∀ i < α, ∀ x ∈ (A i).carrier, G x = c i x := by
        intro i hi x hx
        have h : ∃ i < α, x ∈ (A i).carrier := ⟨i, hi, hx⟩
        have hch := h.choose_spec
        simp only [G, h, dite_true]
        rcases lt_trichotomy h.choose i with hl | he | hl
        · exact ((ih' i hi).2 _ hl x hch.2).symm
        · rw [he]
        · exact (ih' _ hch.1).2 i hl x hx
      refine ⟨G, ?_, hG⟩
      refine IsoOn.union hS hlim (fun a ha b hb h => hAi a (lt_trans ha hα) b (lt_trans hb hα) h)
        (fun a ha b hb h => hBi a (lt_trans ha hα) b (lt_trans hb hα) h) uA uB fun i hi => ?_
      exact (ih' i hi).1.congr fun x hx => (hG i hi x hx).symm)
  let F : U → U := fun x => if h : ∃ i < θ, x ∈ (A i).carrier then f h.choose x else x
  have hF : ∀ i < θ, ∀ x ∈ (A i).carrier, F x = f i x := by
    intro i hi x hx
    have h : ∃ i < θ, x ∈ (A i).carrier := ⟨i, hi, hx⟩
    have hch := h.choose_spec
    simp only [F, h, dite_true]
    rcases lt_trichotomy h.choose i with hl | he | hl
    · exact ((hf i hi.le hi).2 _ hl x hch.2).symm
    · rw [he]
    · exact (hf _ hch.1.le hch.1).2 i hl x hx
  exact ⟨F, fun i hi => (hf i hi.le hi).1.congr fun x hx => (hF i hi x hx).symm⟩

/-- AUX: not in paper. The temporary column of one odd step of the construction of Prop 8.1.6:
above a row `⟨a_ε : ε ≤ t⟩` we build `⟨a'_ε : ε ≤ t⟩` and witnesses `C_ε`, with
`NF(a_ε, C_ε, a'_ε, a'_{ε+1})`, the model `C_ε` realizing the given tasks over `a_{ε+1}`. The universes
are controlled by `a'_ε ∩ Z = a_ε`, in place of the rule for player 0 in the game. -/
theorem Frame.col_build [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) (hinf : ℵ₀ ≤ lam) {t : Ordinal.{u}} (ht : t < (Order.succ lam).ord)
    {a : Ordinal.{u} → Model U L} (ka : ∀ ε ≤ t, a ε ∈ s.S.Kc lam)
    (ai : IsIncreasing s.S.le a (Iic t)) (ac : IsContinuous a (Iic t)) {Z : Set U}
    (hZ : ∀ ε ≤ t, (a ε).carrier ⊆ Z) (hZs : #Z ≤ lam) (T : Ordinal.{u} → Ordinal.{u} → Set (Tri U L))
    (θ : Ordinal.{u} → Ordinal.{u}) (hθ : ∀ ε < t, θ ε < (Order.succ lam).ord) :
    ∃ (a' C : Ordinal.{u} → Model U L) (x : U), (∀ ε ≤ t, a' ε ∈ s.S.Kc lam) ∧
      IsIncreasing s.S.le a' (Iic t) ∧ IsContinuous a' (Iic t) ∧
      (∀ ε ≤ t, s.S.le (a ε) (a' ε)) ∧ (∀ ε ≤ t, (a' ε).carrier ∩ Z = (a ε).carrier) ∧
      x ∈ (a' 0).carrier ∧ x ∉ Z ∧
      ∀ ε < t, C ε ∈ s.S.Kc lam ∧ s.S.le (a (ε + 1)) (C ε) ∧
        (∀ ε' < θ ε, T ε ε' ∈ s.Sbs (a (ε + 1)) → Realizes s.S lam (C ε) (a (ε + 1)) (T ε ε')) ∧
        s.NF lam (a ε) (C ε) (a' ε) (a' (ε + 1)) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hzero : (0 : Ordinal.{u}) ≤ t := zero_le
  have hZU : #Z < #U := hZs.trans_lt hU.2
  -- the fresh model above `a 0`
  obtain ⟨N, kN, hlt⟩ : ∃ N ∈ s.S.Kc lam, s.S.lt (a 0) N := by
    have hnm := hc.ax1c _ (ka 0 hzero)
    by_contra hcon
    exact hnm ⟨ka 0 hzero, fun ⟨N, hN, hl⟩ => hcon ⟨N, hN, hl.1.2.2, hl.2⟩⟩
  obtain ⟨x, hxN, hx0⟩ := hS.exists_diff_of_lt hlt
  have hsmall : #(Z ∪ (a 0).carrier : Set U) < #U :=
    lt_of_le_of_lt (Cardinal.mk_union_le _ _)
      (Cardinal.add_lt_of_lt hU.aleph0_le hZU (by rw [show #(a 0).carrier = lam from (ka 0 hzero).2]; exact hU.2))
  obtain ⟨h, M0, hM0, hid, l0, -, hout⟩ := hS.rename hU.infinite Z hlt.1 (IsoOn.refl (a 0)) hsmall
  have kM0 : M0 ∈ s.S.Kc lam := ⟨hS.iso_mem kN.1 hM0, by rw [hM0.card_eq]; exact kN.2⟩
  have hM0Z : M0.carrier ∩ Z = (a 0).carrier := by
    ext y
    constructor
    · rintro ⟨hy, hyZ⟩
      rw [hM0.carrier_eq] at hy
      obtain ⟨w, hw, rfl⟩ := hy
      by_contra hn
      have hw0 : w ∉ (a 0).carrier := fun hw0 => hn (by rw [hid w hw0]; exact hw0)
      exact (hout w ⟨hw, hw0⟩) (Or.inl hyZ)
    · intro hy
      refine ⟨hS.sub l0 hy, hZ 0 hzero hy⟩
  have hxout : h x ∉ Z := fun hz => hout x ⟨hxN, hx0⟩ (Or.inl hz)
  have hxM0 : h x ∈ M0.carrier := hM0.mapsTo hxN
  -- the recursion
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L × Model U L) → Prop := fun ε c =>
    ε ≤ t → (c ε).1 ∈ s.S.Kc lam ∧ (∀ ζ < ε, s.S.le (c ζ).1 (c ε).1) ∧
      (Order.IsSuccLimit ε → IsUnionOf (fun ζ => (c ζ).1) (Iio ε) (c ε).1) ∧
      s.S.le (a ε) (c ε).1 ∧ (c ε).1.carrier ∩ Z = (a ε).carrier ∧ (ε = 0 → (c ε).1 = M0) ∧
      ∀ η, ε = η + 1 → (c ε).2 ∈ s.S.Kc lam ∧ s.S.le (a (η + 1)) (c ε).2 ∧
        (∀ ε' < θ η, T η ε' ∈ s.Sbs (a (η + 1)) → Realizes s.S lam (c ε).2 (a (η + 1)) (T η ε')) ∧
        s.NF lam (a η) (c ε).2 (c η).1 (c ε).1
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L × Model U L), (∀ β ≤ α, c β = c' β) →
      Inv α c → Inv α c' := by
    intro α c c' e h hα
    obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := h hα
    have eα := e α le_rfl
    refine ⟨eα ▸ h1, fun ζ hζ => by rw [← eα, ← e ζ hζ.le]; exact h2 ζ hζ, fun hl => ?_, eα ▸ h4,
      eα ▸ h5, fun h0 => eα ▸ h6 h0, fun η hη => ?_⟩
    · rw [← eα]
      exact (h3 hl).congr' fun β hβ => by rw [e β (le_of_lt hβ)]
    · have eη := e η (hη ▸ (Order.le_succ η))
      rw [← eα, ← eη]; exact h7 η hη
  have hne : Nonempty (Model U L × Model U L) := ⟨(M0, M0)⟩
  obtain ⟨c, hcI⟩ := transfinite_construction t Inv hloc (by
    intro ε hεt c ih
    have ih' : ∀ ζ < ε, _ := fun ζ hζ => ih ζ hζ (hζ.le.trans hεt)
    suffices hx : ∃ y z : Model U L, y ∈ s.S.Kc lam ∧ (∀ ζ < ε, s.S.le (c ζ).1 y) ∧
        (Order.IsSuccLimit ε → IsUnionOf (fun ζ => (c ζ).1) (Iio ε) y) ∧ s.S.le (a ε) y ∧
        y.carrier ∩ Z = (a ε).carrier ∧ (ε = 0 → y = M0) ∧
        ∀ η, ε = η + 1 → z ∈ s.S.Kc lam ∧ s.S.le (a (η + 1)) z ∧
          (∀ ε' < θ η, T η ε' ∈ s.Sbs (a (η + 1)) → Realizes s.S lam z (a (η + 1)) (T η ε')) ∧
          s.NF lam (a η) z (c η).1 y by
      obtain ⟨y, z, h1, h2, h3, h4, h5, h6, h7⟩ := hx
      refine ⟨(y, z), fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, fun ζ hζ => ?_, fun hl => ?_, h4, h5, h6, fun η hη => ?_⟩
      · simp only [hζ, ite_true]; exact h2 ζ hζ
      · refine (h3 hl).congr' fun β hβ => ?_
        have : β < ε := hβ
        simp only [this, ite_true]
      · have hηε : η < ε := hη ▸ Order.lt_add_one_iff.2 le_rfl
        simp only [hηε, ite_true]; exact h7 η hη
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h0 | ⟨η, hη⟩ | hl
    · subst h0
      exact ⟨M0, M0, kM0, fun ζ hζ => absurd hζ (not_lt.2 zero_le),
        fun hl => absurd hl Order.not_isSuccLimit_bot, l0, hM0Z, fun _ => rfl,
        fun η h => absurd h.symm (by simp)⟩
    · have hη' : ε = η + 1 := hη.symm
      subst hη'
      have hηlt : η < η + 1 := Order.lt_add_one_iff.2 le_rfl
      have hηt : η < t := lt_of_lt_of_le hηlt hεt
      obtain ⟨k1, -, -, l4, l5, -, -⟩ := ih' η hηlt
      have kA := ka η hηt.le
      have kB := ka (η + 1) hεt
      have lAB : s.S.le (a η) (a (η + 1)) := ai η hηt.le _ hεt hηlt
      have hA'B : (c η).1.carrier ∩ (a (η + 1)).carrier = (a η).carrier := by
        ext y; constructor
        · rintro ⟨hy1, hy2⟩; rw [← l5]; exact ⟨hy1, hZ _ hεt hy2⟩
        · intro hy; exact ⟨hS.sub l4 hy, hS.sub lAB hy⟩
      let D : Set U := (c η).1.carrier ∪ (Z \ (a (η + 1)).carrier)
      have hDsize : #D < #U :=
        lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le
          (by rw [show #(c η).1.carrier = lam from k1.2]; exact hU.2)
          (lt_of_le_of_lt (Cardinal.mk_le_mk_of_subset Set.sdiff_subset) hZU))
      have hDB : D ∩ (a (η + 1)).carrier = (a η).carrier := by
        ext y; constructor
        · rintro ⟨hy | hy, hy2⟩
          · rw [← hA'B]; exact ⟨hy, hy2⟩
          · exact absurd hy2 hy.2
        · intro hy; exact ⟨Or.inl (hS.sub l4 hy), hS.sub lAB hy⟩
      obtain ⟨C, B', kC, lBC, hreal, kB', hNF, -, hB'D⟩ := Frame.plus_step hU hs kA k1 kB l4 lAB
        hDsize Set.subset_union_left hDB (hθ η hηt) (T η)
      obtain ⟨-, -, -, -, -, l13, -, l23, -⟩ := id hNF
      have hsubBB' : (a (η + 1)).carrier ⊆ B'.carrier := (hS.sub lBC).trans (hS.sub l13)
      refine ⟨B', C, kB', fun ζ hζ => ?_, fun hl' => absurd hl' fun hl' =>
        lt_irrefl _ (hl'.add_one_lt hηlt), hS.trans lBC l13, ?_, fun h => absurd h (by simp),
        fun η' he => ?_⟩
      · rcases (Order.lt_succ_iff.1 hζ).lt_or_eq with h | h
        · exact hS.trans ((ih' η hηlt).2.1 ζ h) l23
        · rw [h]; exact l23
      · ext y; constructor
        · rintro ⟨hy, hyZ⟩
          by_contra hn
          have hyD : y ∈ B'.carrier ∩ D := ⟨hy, Or.inr ⟨hyZ, hn⟩⟩
          rw [hB'D] at hyD
          have hyA : y ∈ (a η).carrier := by rw [← l5]; exact ⟨hyD, hyZ⟩
          exact hn (hS.sub lAB hyA)
        · intro hy; exact ⟨hsubBB' hy, hZ _ hεt hy⟩
      · have e' : η' = η := (Order.succ_injective (show Order.succ η = Order.succ η' from he)).symm
        subst e'
        exact ⟨kC, lBC, hreal, hNF⟩
    · have hl0 : (0 : Ordinal.{u}) < ε := hl.bot_lt
      have hi : IsIncreasing s.S.le (fun ζ => (c ζ).1) (Iio ε) := fun a' _ b' hb hab =>
        (ih' b' hb).2.1 a' hab
      have hcont : IsContinuous (fun ζ => (c ζ).1) (Iio ε) := fun β hβ hl' =>
        ((ih' β hβ).2.2.1 hl').1
      obtain ⟨y, ky, uy, hle⟩ := hS.union_Kc hinf hl (lt_of_le_of_lt hεt ht) hi hcont
        fun α hα => (ih' α hα).1
      have uA : IsUnionOf a (Iio ε) (a ε) :=
        ⟨ac ε hεt hl, fun i hi' => hS.incl _ _ (ai i (le_of_lt (lt_of_lt_of_le hi' hεt)) ε hεt hi')⟩
      have aio : IsIncreasing s.S.le a (Iio ε) := fun a' ha b' hb hab =>
        ai a' (le_of_lt (lt_of_lt_of_le ha hεt)) b' (le_of_lt (lt_of_lt_of_le hb hεt)) hab
      have aco : IsContinuous a (Iio ε) := fun β hβ hl' =>
        ac β (le_of_lt (lt_of_lt_of_le hβ hεt)) hl'
      refine ⟨y, y, ky, hle, fun _ => uy, ?_, ?_, fun h => by rw [h] at hl; exact absurd hl Order.not_isSuccLimit_bot,
        fun η h => absurd (h ▸ hl) fun hl' => lt_irrefl _ (hl'.add_one_lt (Order.lt_add_one_iff.2 le_rfl))⟩
      · exact hS.smooth ε hl a y aio aco (fun ζ hζ => hS.trans (ih' ζ hζ).2.2.2.1 (hle ζ hζ))
          (a ε) uA (ka ε hεt).1
      · ext z; constructor
        · rintro ⟨hz, hzZ⟩
          rw [uy.1] at hz
          obtain ⟨ζ, hζ, hz⟩ := Set.mem_iUnion₂.1 hz
          have hζ' : ζ < ε := hζ
          have : z ∈ (a ζ).carrier := by rw [← (ih' ζ hζ').2.2.2.2.1]; exact ⟨hz, hzZ⟩
          exact hS.sub (ai ζ (le_of_lt (lt_of_lt_of_le hζ' hεt)) ε hεt hζ') this
        · intro hz
          rw [uA.1] at hz
          obtain ⟨ζ, hζ, hz⟩ := Set.mem_iUnion₂.1 hz
          have hζ' : ζ < ε := hζ
          exact ⟨hS.sub (hle ζ hζ') (hS.sub (ih' ζ hζ').2.2.2.1 hz),
            hZ ζ (le_of_lt (lt_of_lt_of_le hζ' hεt)) hz⟩)
  have hI : ∀ ε ≤ t, _ := fun ε hε => hcI ε hε hε
  refine ⟨fun ε => (c ε).1, fun ε => (c (ε + 1)).2, h x, fun ε hε => (hI ε hε).1, ?_, ?_,
    fun ε hε => (hI ε hε).2.2.2.1, fun ε hε => (hI ε hε).2.2.2.2.1, ?_, hxout, fun ε hε => ?_⟩
  · intro a' _ b' hb hab
    exact (hI b' hb).2.1 a' hab
  · intro β hβ hl
    exact ((hI β hβ).2.2.1 hl).1
  · show h x ∈ (c 0).1.carrier
    rw [(hI 0 hzero).2.2.2.2.2.1 rfl]; exact hxM0
  · have hε1 : ε + 1 ≤ t := Order.add_one_le_of_lt hε
    exact (hI (ε + 1) hε1).2.2.2.2.2.2 ε rfl

/-- AUX: not in paper. The state of the construction of Prop 8.1.6 at one stage: a row, the
witnesses of the last step, the approximation of `M₂*`. -/
abbrev Ar816 (U : Type u) (L : Language.{u, u}) :=
  (Ordinal.{u} → Model U L) × (Ordinal.{u} → Model U L) × Model U L

/-- AUX: not in paper. The tasks of column `ε` at stage `r` of the construction of Prop 8.1.6. -/
noncomputable def Frame.task816 (s : Frame U L) (lam : Cardinal.{u})
    (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}) (en : Model U L → Ordinal.{u} → Set (Tri U L))
    (c : Ordinal.{u} → Ar816 U L) (r ε ε' : Ordinal.{u}) : Set (Tri U L) :=
  s.plusTask lam pr en (r - (ε + 1)) (fun i => (c (ε + 1 + (i : Ordinal.{u}))).1 (ε + 1)) ε'

/-- AUX: not in paper. The requirements on stage `t` of the construction of Prop 8.1.6 (with odd and
even steps of the paper merged into one step `t ↦ t + 1`). -/
def Frame.Ar (s : Frame U L) (lam : Cardinal.{u}) (M₁ M₂ : Model U L) (e : Ordinal.{u} → U)
    (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}) (en : Model U L → Ordinal.{u} → Set (Tri U L))
    (t : Ordinal.{u}) (c : Ordinal.{u} → Ar816 U L) (x : Ar816 U L) : Prop :=
  (∀ ε ≤ t, x.1 ε ∈ s.S.Kc lam ∧ s.S.le (x.1 ε) M₁) ∧
  (IsIncreasing s.S.le x.1 (Iic t) ∧ IsContinuous x.1 (Iic t)) ∧
  (x.2.2 ∈ s.S.Kc lam ∧ s.S.le x.2.2 M₂ ∧ s.S.le (x.1 t) x.2.2) ∧
  (∀ r < t, (∀ ε ≤ r, s.S.le ((c r).1 ε) (x.1 ε)) ∧ s.S.le (c r).2.2 x.2.2) ∧
  (Order.IsSuccLimit t → (∀ ε < t, IsUnionOf (fun r => (c (max r ε)).1 ε) (Iio t) (x.1 ε)) ∧
    IsUnionOf (fun r => (c r).2.2) (Iio t) x.2.2) ∧
  ∀ r, t = r + 1 → (∃ y ∈ (x.1 0).carrier, y ∉ ((c r).1 r).carrier) ∧
    (∀ ε < r, x.2.1 ε ∈ s.S.Kc lam ∧ s.S.le ((c r).1 (ε + 1)) (x.2.1 ε) ∧
      (∀ ε' < r - (ε + 1), s.task816 lam pr en c r ε ε' ∈ s.Sbs ((c r).1 (ε + 1)) →
        Realizes s.S lam (x.2.1 ε) ((c r).1 (ε + 1)) (s.task816 lam pr en c r ε ε')) ∧
      s.NF lam ((c r).1 ε) (x.2.1 ε) (x.1 ε) (x.1 (ε + 1))) ∧
    (∀ ε ≤ r, s.NF lam ((c r).1 ε) (c r).2.2 (x.1 ε) x.2.2) ∧
    x.2.2.carrier ∩ M₁.carrier = (x.1 t).carrier ∧ e r ∈ x.2.2.carrier

/-- AUX: not in paper. `Frame.Ar` depends only on the values of `c` below `t`. -/
theorem Frame.Ar.congr {s : Frame U L} {lam : Cardinal.{u}} {M₁ M₂ : Model U L}
    {e : Ordinal.{u} → U} {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}}
    {en : Model U L → Ordinal.{u} → Set (Tri U L)} {t : Ordinal.{u}}
    {c c' : Ordinal.{u} → Ar816 U L} {x : Ar816 U L} (h : s.Ar lam M₁ M₂ e pr en t c x)
    (hc : ∀ β < t, c β = c' β) : s.Ar lam M₁ M₂ e pr en t c' x := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
  refine ⟨h1, h2, h3, fun r hr => ?_, fun hl => ?_, fun r hr => ?_⟩
  · rw [← hc r hr]; exact h4 r hr
  · refine ⟨fun ε hε => (h5 hl).1 ε hε |>.congr' fun β hβ => ?_, (h5 hl).2.congr' fun β hβ => ?_⟩
    · show (c (max β ε)).1 ε = (c' (max β ε)).1 ε
      rw [hc _ (max_lt hβ hε)]
    · show (c β).2.2 = (c' β).2.2
      rw [hc β hβ]
  · subst hr
    have er : c r = c' r := hc r (Order.lt_add_one_iff.2 le_rfl)
    obtain ⟨a1, a2, a3, a4, a5⟩ := h6 r rfl
    rw [← er]
    have eT : ∀ ε, ε + 1 ≤ r → ∀ ε', s.task816 lam pr en c r ε ε' = s.task816 lam pr en c' r ε ε' := by
      intro ε hε ε'
      unfold Frame.task816
      congr 1
      funext i
      have hi : (ε + 1 + (i : Ordinal.{u})) ≤ r := by
        calc ε + 1 + (i : Ordinal.{u}) ≤ ε + 1 + (r - (ε + 1)) :=
              (add_le_add_iff_left _).2 (Set.mem_Iic.1 i.2)
          _ = r := Ordinal.add_sub_cancel_of_le hε
      rw [hc _ (lt_of_le_of_lt hi (Order.lt_add_one_iff.2 le_rfl))]
    refine ⟨a1, fun ε hε => ?_, a3, a4, a5⟩
    obtain ⟨b1, b2, b3, b4⟩ := a2 ε hε
    refine ⟨b1, b2, fun ε' hε' => ?_, b4⟩
    rw [← eT ε (Order.add_one_le_of_lt hε)]; exact b3 ε' hε'

/-- AUX: not in paper. One stage of the construction of Prop 8.1.6. -/
theorem Frame.ar_step [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_8_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₁ M₂ : Model U L} (hM : s.leOt lam M₁ M₂)
    {e : Ordinal.{u} → U} (he : ∀ i < (Order.succ lam).ord, e i ∈ M₂.carrier)
    (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}) (en : Model U L → Ordinal.{u} → Set (Tri U L))
    {t : Ordinal.{u}} (ht : t < (Order.succ lam).ord) {c : Ordinal.{u} → Ar816 U L}
    (ih : ∀ r < t, s.Ar lam M₁ M₂ e pr en r c (c r)) :
    ∃ x, s.Ar lam M₁ M₂ e pr en t c x := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k₁, k₂, lM, -⟩ := id hM
  have l12 : s.S.le M₁ M₂ := lM.1
  have c₁ : M₁.card = Order.succ lam := k₁.1.2
  have c₂ : M₂.card = Order.succ lam := k₂.1.2
  have hκ : Order.IsSuccLimit (Order.succ lam).ord :=
    Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have nlim : ∀ i : Ordinal.{u}, ¬ Order.IsSuccLimit (i + 1) := fun i hl =>
    lt_irrefl _ (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl))
  have hempty : #(∅ : Set U) ≤ lam := by simp
  rcases Ordinal.zero_or_succ_or_isSuccLimit t with h0 | ⟨r, hr⟩ | hl
  · subst h0
    obtain ⟨N₀, kN₀, N₁, kN₁, -, l0, -, l1, hint⟩ := prop_8_1_5 lam hU s hs hinf M₁ M₂ l12 c₁ c₂ ∅ ∅
      (by simp) (by simp) hempty hempty
    have l01 : s.S.le N₀ N₁ := hS.le_of_sub (hS.trans l0 l12) l1 (fun x hx => by
      rw [← hint] at hx; exact hx.1)
    refine ⟨(fun _ => N₀, fun _ => N₀, N₁), fun ε _ => ⟨kN₀, l0⟩, ⟨fun a ha b hb hab => ?_, ?_⟩,
      ⟨kN₁, l1, l01⟩, fun r hr => absurd hr (not_lt.2 zero_le),
      fun hl => absurd hl Order.not_isSuccLimit_bot, fun r hr => absurd hr.symm (by simp)⟩
    · exact absurd (lt_of_lt_of_le hab hb) (not_lt.2 zero_le)
    · intro β hβ hl
      have : β = 0 := le_antisymm hβ zero_le
      subst this
      exact absurd hl Order.not_isSuccLimit_bot
  · have hr' : t = r + 1 := hr.symm
    subst hr'
    have hrt : r < r + 1 := Order.lt_add_one_iff.2 le_rfl
    have hrκ : r < (Order.succ lam).ord := hrt.trans ht
    obtain ⟨A1, ⟨Ai, Ac⟩, ⟨kT, lT, laT⟩, -, -, -⟩ := ih r hrt
    set a := (c r).1 with ha
    set Tr := (c r).2.2 with hTr
    have hrI : r ∈ Iic r := Set.mem_Iic.2 le_rfl
    have : Nonempty (Model U L) := ⟨M₁⟩
    have laa : ∀ ε ≤ r, s.S.le (a ε) Tr := fun ε hε => by
      rcases hε.lt_or_eq with h | h
      · exact hS.trans (Ai ε hε r hrI h) laT
      · rw [h]; exact laT
    obtain ⟨a', C, x, ka', ai', ac', laa', hZ, hx0, hxZ, hcol⟩ := Frame.col_build hU hs5 hinf hrκ
      (a := a) (fun ε hε => (A1 ε hε).1) Ai Ac (Z := Tr.carrier) (fun ε hε => hS.sub (laa ε hε))
      (le_of_eq kT.2) (s.task816 lam pr en c r) (fun ε => r - (ε + 1))
      (fun ε hε => lt_of_le_of_lt (Ordinal.sub_le_self _ _) hrκ)
    have l0r : s.S.le (a r) (a' r) := laa' r le_rfl
    obtain ⟨N₁s, kN₁s, f, P, hf, hfid, iP, hNF, lN₁s⟩ := prop_8_1_4 lam hU s hs M₁ M₂ (a r) Tr (a' r)
      hM (A1 r le_rfl).1 kT (ka' r le_rfl) (A1 r le_rfl).2 l0r laT lT
    obtain ⟨-, -, Pm, lPm, iPm⟩ := id hf
    have ePm : Pm = P := iPm.unique iP
    subst ePm
    -- images of `a'` and `C` under `f`
    have hsuba' : ∀ ε ≤ r, (a' ε).carrier ⊆ (a' r).carrier := fun ε hε => by
      rcases hε.lt_or_eq with h | h
      · exact hS.sub (ai' ε hε r hrI h)
      · rw [h]
    have hb : ∀ ε, ε ≤ r → ∃ Q, IsoOn f (a' ε) Q := fun ε hε =>
      exists_isoOn (iPm.injOn.mono (hsuba' ε hε))
    choose! b hb using hb
    have hCs : ∀ ε, ε < r → ∃ Q, IsoOn f (C ε) Q := fun ε hε => by
      obtain ⟨-, -, -, n⟩ := hcol ε hε
      obtain ⟨-, -, -, -, -, l13, -, -, -⟩ := id n
      exact exists_isoOn (iPm.injOn.mono ((hS.sub l13).trans (hsuba' _ (Order.add_one_le_of_lt hε))))
    choose! C' hC' using hCs
    have ebr : b r = Pm := (hb r le_rfl).unique iPm
    have hsubar : ∀ ε ≤ r, (a ε).carrier ⊆ (a r).carrier := fun ε hε => by
      rcases hε.lt_or_eq with h | h
      · exact hS.sub (Ai ε hε r hrI h)
      · rw [h]
    have fid : ∀ ε ≤ r, IsoOn f (a ε) (a ε) := fun ε hε =>
      (IsoOn.refl (a ε)).congr fun y hy => (hfid y (hsubar ε hε hy)).symm
    have kb : ∀ ε ≤ r, b ε ∈ s.S.Kc lam := fun ε hε =>
      ⟨hS.iso_mem (ka' ε hε).1 (hb ε hε), by rw [(hb ε hε).card_eq]; exact (ka' ε hε).2⟩
    have lbP : ∀ ε ≤ r, s.S.le (b ε) Pm := fun ε hε => by
      rcases hε.lt_or_eq with h | h
      · exact hS.iso_le (ai' ε hε r hrI h) iPm (hb ε hε)
      · rw [h, ebr]; exact hS.refl (ebr ▸ (kb r le_rfl).1)
    have lbb : ∀ ζ ≤ r, ∀ ε ≤ r, ζ < ε → s.S.le (b ζ) (b ε) := fun ζ hζ ε hε h =>
      hS.iso_le (ai' ζ hζ ε hε h) (hb ε hε) (hb ζ hζ)
    have l1Tb : ∀ ε ≤ r, s.S.le (a ε) (b ε) := fun ε hε => hS.iso_le (laa' ε hε) (hb ε hε) (fid ε hε)
    have hA1Tcard : #(N₁s.carrier ∪ {e r} : Set U) ≤ lam := by
      refine (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kN₁s.2) ?_)
      simpa using hinf.trans' Cardinal.one_le_aleph0
    obtain ⟨N0, kN0, N1, kN1, sub0, l0N, sub1, l1N, hint⟩ := prop_8_1_5 lam hU s hs hinf M₁ M₂ l12 c₁ c₂
      Pm.carrier (N₁s.carrier ∪ {e r}) (hS.sub lPm)
      (Set.union_subset (hS.sub lN₁s) (Set.singleton_subset_iff.2 (he r hrκ)))
      (le_of_eq (by rw [← (by rw [iPm.card_eq]; exact (ka' r le_rfl).2 : Pm.card = lam)]; rfl))
      hA1Tcard
    have lPN : s.S.le Pm N0 := hS.le_of_sub lPm l0N sub0
    have lN1 : s.S.le N₁s N1 := hS.le_of_sub lN₁s l1N fun y hy => sub1 (Or.inl hy)
    have lN01 : s.S.le N0 N1 := hS.le_of_sub (hS.trans l0N l12) l1N fun y hy => by
      rw [← hint] at hy; exact hy.1
    obtain ⟨-, -, -, -, -, -, -, lTN, -⟩ := id hNF
    let xa : Ordinal.{u} → Model U L := fun ε => if ε ≤ r then b ε else N0
    have xa1 : ∀ ε ≤ r, xa ε = b ε := fun ε hε => by simp [xa, hε]
    have xa2 : xa (r + 1) = N0 := by simp [xa]
    have star : s.NF lam (a r) Pm Tr N1 := Frame.nf_top hU hs5 hNF kN1 lN1
    have colnf : ∀ ζ < r, s.NF lam (a ζ) (C' ζ) (b ζ) (b (ζ + 1)) := fun ζ hζ =>
      Frame.nf_iso hU hc (hcol ζ hζ).2.2.2 (hb _ (Order.add_one_le_of_lt hζ)) (fid ζ hζ.le)
        (hC' ζ hζ) (hb ζ hζ.le)
    have colstep : ∀ ζ < r, s.NF lam (a ζ) (a (ζ + 1)) (b ζ) (b (ζ + 1)) := fun ζ hζ => by
      have hζ1 : ζ + 1 ≤ r := Order.add_one_le_of_lt hζ
      have l1 : s.S.le (a ζ) (a (ζ + 1)) := Ai ζ hζ.le _ hζ1 (Order.lt_add_one_iff.2 le_rfl)
      have l2 : s.S.le (a (ζ + 1)) (C' ζ) :=
        hS.iso_le (hcol ζ hζ).2.1 (hC' ζ hζ) (fid _ hζ1)
      exact Frame.nf_symm hU hs5 (Frame.nf_mid hU hs5 (Frame.nf_symm hU hs5 (colnf ζ hζ))
        (A1 _ hζ1).1 l1 l2)
    have hlong : ∀ ε ≤ r, s.NF lam (a ε) Tr (b ε) N1 := by
      intro ε hε
      rcases hε.lt_or_eq with h | h
      · have hδpos : 0 < r - ε := by
          rcases (zero_le : (0 : Ordinal.{u}) ≤ r - ε).lt_or_eq with h' | h'
          · exact h'
          · have := Ordinal.add_sub_cancel_of_le hε
            rw [← h', add_zero] at this; exact absurd this h.ne
