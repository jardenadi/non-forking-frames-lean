    PART 8 : SECTION 8  (Relative saturation)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 8.1.1 (= Hypothesis 6.1.1). -/
def Hyp_8_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop := Hyp_6_1_1 s lam

/-- Def 8.1.2: `M₀ ≼^⊗_{λ⁺} M₁` iff `M₀, M₁ ∈ K^sat`, `M₀ ≺ M₁` and for all `N₀, N₁ ∈ K_λ` with
`N₀ ≼ M₀`, `N₀ ≼ N₁ ≼ M₁`, every `p ∈ S^bs(N₁)` not forking over `N₀` is `tp(d, N₁, M₁)` for some
`d ∈ M₀`. -/
def Frame.leOt (s : Frame U L) (lam : Cardinal.{u}) (M₀ M₁ : Model U L) : Prop :=
  M₀ ∈ s.Ksat lam ∧ M₁ ∈ s.Ksat lam ∧ s.S.lt M₀ M₁ ∧
    ∀ N₀ ∈ s.S.Kc lam, ∀ N₁ ∈ s.S.Kc lam, s.S.le N₀ M₀ → s.S.le N₀ N₁ → s.S.le N₁ M₁ →
      ∀ p ∈ s.Sbs N₁, s.NotFork lam N₀ N₁ p → ∃ d ∈ M₀.carrier, tp s.S lam d N₁ M₁ = p

/-- AUX: not in paper. The realization clause of Prop 8.1.3(a). -/
theorem Frame.ot_real [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_8_1_1 s lam)
    {M₀ M₁ N₀ N₁ : Model U L} (h₀ : M₀ ∈ s.Ksat lam) (h : s.leNF lam M₀ M₁) (k₀ : N₀ ∈ s.S.Kc lam)
    (k₁ : N₁ ∈ s.S.Kc lam) (h0M : s.S.le N₀ M₀) (h01 : s.S.le N₀ N₁) (h1M : s.S.le N₁ M₁)
    {p : Set (Tri U L)} (hp : p ∈ s.Sbs N₁) (hnf : s.NotFork lam N₀ N₁ p) :
    ∃ d ∈ M₀.carrier, tp s.S lam d N₁ M₁ = p := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k₀
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨Np, kp, Np1, kp1, hn, s0, s1⟩ := Frame.leNF_lst hU hs6 h (A₀ := N₀.carrier) (A₁ := N₁.carrier)
    (hS.sub h0M) (hS.sub h1M) (le_of_eq k₀.2) (le_of_eq k₁.2)
  have hn' := hn
  obtain ⟨-, -, kM₀, kM₁, A, B, Ai, Ac, Bi, Bc, hst, a0, b0, ua, ub⟩ := hn'
  obtain ⟨fA, fB⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst ua ub
  have lpM : s.S.le Np M₀ := a0 ▸ fA.le hS hinf hκl.bot_lt
  have lp1M : s.S.le Np1 M₁ := b0 ▸ fB.le hS hinf hκl.bot_lt
  have lNp : s.S.le N₀ Np := hS.le_of_sub h0M lpM s0
  have lNp1 : s.S.le N₁ Np1 := hS.le_of_sub h1M lp1M s1
  have lpp1 : s.S.le Np Np1 := by
    have := (hst 0 hκl.bot_lt).2.2.2.2.1
    rwa [a0, b0] at this
  obtain ⟨q, hq, hqnf, hqres⟩ : ∃ q ∈ s.Sbs Np1, s.NotFork lam N₀ Np1 q ∧ res s.S lam q N₁ = p := by
    by_cases he : N₁ = Np1
    · subst he
      obtain ⟨W, b, -, -, -, rfl⟩ := hc.ax2a _ k₁ hp
      exact ⟨_, hp, hnf, res_tp hS (hS.refl k₁.1)⟩
    · obtain ⟨q, hq, nf, hr⟩ := hc.ax3f _ k₁ _ kp1 p hp ⟨lNp1, he⟩
      refine ⟨q, hq, Frame.notFork_trans hc k₀ kp1 h01 lNp1 hq nf (by rw [hr]; exact hnf), hr⟩
  obtain ⟨b, W, eq, nfb⟩ := hqnf
  have nfp : s.nf Np Np1 b W := Frame.nf_mono hS hc.ax3a hc.ax3b nfb lNp lpp1 (hS.refl kp1.1)
  have F := hc.ax3a.1 _ _ _ _ nfp
  obtain ⟨d, hd, hdt⟩ := (h₀.2 Np kp lpM).2 _ ⟨W, b, ⟨kp.1, F.2.2.1.1, hS.trans lpp1 F.2.2.2.2.2.1,
    F.2.2.2.1.1⟩, rfl⟩
  have hb0 : tp s.S lam d Np M₀ ∈ s.Sbs Np := by rw [hdt]; exact F.2.2.2.2.2.2.1
  have hk := thm_6_1_3_e lam hU s hs6 _ _ _ _ d hn hb0
  obtain ⟨b', W', eq', hnf', -, -, -, -, -, -, -, hs2⟩ := hk.facts hc.ax3a
  have l01 := h.2.2.1
  have hsd : tp s.S lam d Np1 M₁ ∈ s.Sbs Np1 := eq' ▸ hs2
  have hdM₁ := hS.sub l01 hd
  have e : tp s.S lam d Np1 M₁ = q := by
    rw [eq]
    refine hc.ax3d _ kp _ kp1 lpp1 _ hsd _ (eq ▸ hq) hk ⟨b, W, rfl, nfp⟩ ?_
    rw [res_tp hS lpp1, res_tp hS lpp1, ← hdt]
    exact (tp_eq_of_le hS ⟨kp.1, kM₁.1, hS.trans lpM l01, hdM₁⟩ l01 lpM hd).symm
  refine ⟨d, hd, ?_⟩
  rw [← hqres, ← e, res_tp hS lNp1]

/-- AUX: not in paper. Filtrations of an `≼^NF`-chain of length `θ < λ⁺`, its union `N` and a model `T ≽ N`,
coherent on a club. -/
theorem Frame.double_filt [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {θ : Ordinal.{u}} (hθ : Order.IsSuccLimit θ)
    (hθκ : θ < (Order.succ lam).ord) {M : Ordinal.{u} → Model U L}
    (hM : IsIncreasing (s.leNF lam) M (Iio θ)) (MK : ∀ β < θ, M β ∈ s.S.Kc (Order.succ lam))
    (hc' : IsContinuous M (Iio θ)) {N : Model U L}
    (hN : IsUnionOf M (Iio θ) N) (hNK : N ∈ s.S.Kc (Order.succ lam)) :
    ∃ (Rr : Ordinal.{u} → Ordinal.{u} → Model U L) (E : Set Ordinal.{u}), ClubL lam E ∧
      (∀ γ < θ, IsFilt s.S lam (M γ) (Rr γ)) ∧ IsFilt s.S lam N (Rr θ) ∧
      (∀ ε ∈ E, θ < ε) ∧
      (∀ ε ∈ E, ε < (Order.succ lam).ord → ∀ β γ, β < γ → γ < θ → s.S.le (Rr β ε) (Rr γ ε)) ∧
      (∀ ξ ∈ E, ξ < (Order.succ lam).ord → ∀ b < θ, Order.IsSuccLimit b →
        (Rr b ξ).carrier = ⋃ β ∈ Iio b, (Rr β ξ).carrier) ∧
      (∀ ξ ∈ E, ξ < (Order.succ lam).ord → IsUnionOf (fun β => Rr β ξ) (Iio θ) (Rr θ ξ)) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have Mi : IsIncreasing s.S.le M (Iio θ) := fun a ha b hb h => (hM a ha b hb h).2.2.1
  obtain ⟨-, Mle⟩ := hS.le_union hθ Mi hc' hN
  have hex : ∀ γ, ∃ R, (γ < θ → IsFilt s.S lam (M γ) R) ∧ (γ = θ → IsFilt s.S lam N R) := fun γ => by
    by_cases hγ : γ < θ
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf (MK γ hγ)
      exact ⟨R, fun _ => hR, fun h => absurd h hγ.ne⟩
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf hNK
      exact ⟨R, fun h => absurd h hγ, fun _ => hR⟩
  choose Rr hF hFN using hex
  have hNfilt := hFN θ rfl
  have hP : ∀ β γ, ∃ P, ClubL lam P ∧ (β < γ → γ < θ → ∀ ε ∈ P, ∀ ζ ∈ P, ε < ζ →
      ζ < (Order.succ lam).ord → s.NF lam (Rr β ε) (Rr β ζ) (Rr γ ε) (Rr γ ζ)) := fun β γ => by
    by_cases hb : β < γ ∧ γ < θ
    · obtain ⟨E, hE, hn⟩ := Frame.club_of_leNF hU hs (hM β (lt_trans hb.1 hb.2) γ hb.2 hb.1)
        (hF β (lt_trans hb.1 hb.2)) (hF γ hb.2)
      exact ⟨E, hE, fun _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 => absurd ⟨h1, h2⟩ hb⟩
  choose P hPc hPn using hP
  have hL : ∀ γ, ∃ D, ClubL lam D ∧ (γ < (Order.succ lam).ord → Order.IsSuccLimit γ → γ ≤ θ →
      ∀ ε ∈ D, ε < (Order.succ lam).ord →
        (Rr γ ε).carrier = ⋃ β ∈ Iio γ, (Rr β ε).carrier) := fun γ => by
    by_cases hb : γ < (Order.succ lam).ord ∧ Order.IsSuccLimit γ ∧ γ ≤ θ
    · obtain ⟨hγ, hl, hle⟩ := hb
      rcases hle.lt_or_eq with h' | h'
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) hS hinf hγ (hF γ h')
          (fun β hβ => hF β (lt_trans hβ h')) (hc' γ h' hl)
        exact ⟨D, hD, fun _ _ _ => hn⟩
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) (T := N) hS hinf hγ (hFN γ h')
          (fun β hβ => hF β (by rw [← h']; exact hβ)) (by rw [h']; exact hN.1)
        exact ⟨D, hD, fun _ _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ hb⟩
  choose Ls hLc hLn using hL
  let C : Ordinal.{u} → Set Ordinal.{u} := fun γ =>
    if γ < (Order.succ lam).ord then
      {ε | 1 < ε ∧ ε ∈ {ε | γ < ε ∧ ∀ β < γ, ε ∈ P β γ} ∧ ε ∈ Ls γ} else Set.univ
  have hC : ∀ γ, ClubL lam (C γ) := fun γ => by
    by_cases h : γ < (Order.succ lam).ord
    · simp only [C, h, ite_true]
      exact ClubL.inter hinf (ClubL.bInter hinf h fun β => hPc β γ) (hLc γ)
    · simp only [C, h, ite_false]; exact ClubL.univ hinf
  let E : Set Ordinal.{u} := {ε | 1 < ε ∧ ε ∈ {ε | θ < ε ∧ ∀ γ < θ, ε ∈ C γ} ∧ ε ∈ Ls θ}
  have hE : ClubL lam E := ClubL.inter hinf (ClubL.bInter hinf hθκ hC) (hLc θ)
  have mC : ∀ ε ∈ E, ∀ γ < θ, 1 < ε ∧ (γ < ε ∧ ∀ β < γ, ε ∈ P β γ) ∧ ε ∈ Ls γ := by
    intro ε hε γ hγ
    have := hε.2.1.2 γ hγ
    simp only [C, lt_trans hγ hθκ, ite_true] at this
    exact this
  have hRN : ∀ γ ≤ θ, ∀ ξ < (Order.succ lam).ord, s.S.le (Rr γ ξ) N := by
    intro γ hγ ξ hξ
    rcases hγ.lt_or_eq with h' | h'
    · exact hS.trans ((hF γ h').le hS hinf hξ) (Mle γ h')
    · rw [h']; exact hNfilt.le hS hinf hξ
  refine ⟨Rr, E, hE, hF, hNfilt, fun ε hε => hε.2.1.1, ?_, fun ξ hξ hκ b hb hl =>
    hLn b (lt_trans hb hθκ) hl hb.le ξ (mC ξ hξ b hb).2.2 hκ, ?_⟩
  · intro ε hε hκ β γ hb hγ
    obtain ⟨ε', h1, h2, h3⟩ := (hPc β γ).1 ε hκ
    exact (hPn β γ hb hγ ε ((mC ε hε γ hγ).2.1.2 β hb) ε' h1 h2 h3).2.2.2.2.2.2.1
  · intro ξ hξ hκ
    have e := hLn θ hθκ hθ le_rfl ξ hξ.2.2 hκ
    refine ⟨e, fun β hβ => ?_⟩
    refine IsSubstr.of_sub (hS.incl _ _ (hRN β (le_of_lt hβ) ξ hκ)) (hS.incl _ _ (hRN θ le_rfl ξ hκ)) ?_
    rw [e]
    exact Set.subset_biUnion_of_mem (u := fun β => (Rr β ξ).carrier) hβ

/-- AUX: not in paper. The non-forking extension of `p ∈ S^bs(N₁)` to `B ≽ N₁`, remaining non-forking
over `N₀`. -/
theorem Frame.ext_nf {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) {N₀ N₁ B : Model U L}
    (k₀ : N₀ ∈ s.S.Kc lam) (k₁ : N₁ ∈ s.S.Kc lam) (kB : B ∈ s.S.Kc lam) (h01 : s.S.le N₀ N₁)
    (lB : s.S.le N₁ B) {p : Set (Tri U L)} (hp : p ∈ s.Sbs N₁) (hnf : s.NotFork lam N₀ N₁ p) :
    ∃ q ∈ s.Sbs B, s.NotFork lam N₀ B q ∧ res s.S lam q N₁ = p := by
  have hS : IsAEC s.S := hc.ax0a
  by_cases he : N₁ = B
  · subst he
    obtain ⟨W, b, -, -, -, rfl⟩ := hc.ax2a _ k₁ hp
    exact ⟨_, hp, hnf, res_tp hS (hS.refl k₁.1)⟩
  · obtain ⟨q, hq, nf, hr⟩ := hc.ax3f _ k₁ _ kB p hp ⟨lB, he⟩
    exact ⟨q, hq, Frame.notFork_trans hc k₀ kB h01 lB hq nf (by rw [hr]; exact hnf), hr⟩

/-- Prop 8.1.3(a): if `M₀ ∈ K^sat`, `M₁ ∈ K^sat`, `M₀ ≠ M₁` and `M₀ ≼^NF M₁`, then `M₀ ≼^⊗ M₁`.

Original text: "If `M₀ ∈ K^sat` and `M₀ ≼^NF_{λ⁺} M₁`, then `M₀ ≼^⊗_{λ⁺} M₁`." -/
-- DEVIATION (author-confirmed erratum): added `M₁ ∈ K^sat` and `M₀ ≠ M₁`. Def 8.1.2 requires both
-- (`M₀, M₁ ∈ K^sat`, `M₀ ≺ M₁`), and neither follows from `M₀ ≼^NF M₁`; the paper's proof proves
-- only the realization clause (`Frame.ot_real`).
theorem prop_8_1_3_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_8_1_1 s lam)
    (M₀ M₁ : Model U L) (h₀ : M₀ ∈ s.Ksat lam) (hk₁ : M₁ ∈ s.Ksat lam) (hne : M₀ ≠ M₁)
    (h : s.leNF lam M₀ M₁) : s.leOt lam M₀ M₁ :=
  ⟨h₀, hk₁, ⟨h.2.2.1, hne⟩, fun _ k₀ _ k₁ l0 l01 l1 _ hp hnf =>
    Frame.ot_real hU hs h₀ h k₀ k₁ l0 l01 l1 hp hnf⟩

/-- Prop 8.1.3(b): if `⟨M_ε : ε ≤ δ⟩` is `≼^NF`-increasing continuous in `K^sat`,
`M_{δ+1} ∈ K^sat`, `M_δ ≠ M_{δ+1}` and `M_ε ≼^NF M_{δ+1}` for every `ε < δ`, then
`M_δ ≼^⊗ M_{δ+1}`.

Original text: "If `⟨M_ε : ε ≤ δ⟩` is a `≼^NF_{λ⁺}`-increasing continuous sequence of models in
`K^sat` and for every `ε ∈ δ`, `M_ε ≼^NF_{λ⁺} M_{δ+1}`, then `M_δ ≼^⊗_{λ⁺} M_{δ+1}`." -/
theorem prop_8_1_3_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_8_1_1 s lam)
    (δ : Ordinal.{u}) (hδ : Order.IsSuccLimit δ) (M : Ordinal.{u} → Model U L)
    (hM : IsIncreasing (s.leNF lam) M (Iic δ) ∧ IsContinuous M (Iic δ) ∧
      ∀ ε ≤ δ, M ε ∈ s.Ksat lam)
    -- DEVIATION (author-confirmed erratum): added `M_{δ+1} ∈ K^sat` and `M_δ ≠ M_{δ+1}`, as in (a).
    (h : ∀ ε < δ, s.leNF lam (M ε) (M (δ + 1))) (hsat₁ : M (δ + 1) ∈ s.Ksat lam)
    (hne : M δ ≠ M (δ + 1)) : s.leOt lam (M δ) (M (δ + 1)) := by
  classical
  have hs6 : Hyp_6_1_1 s lam := hs
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hMi, hMc, hMs⟩ := hM
  have h0δ := hδ.bot_lt
  obtain ⟨-, -, -, W₀, hW₀, -⟩ := id (h 0 h0δ)
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW₀
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have δm : δ ∈ Iic δ := mem_Iic.2 le_rfl
  have Mle : ∀ α < δ, s.S.le (M α) (M δ) := fun α hα => (hMi α (mem_Iic.2 hα.le) δ δm hα).2.2.1
  have Mi : IsIncreasing s.S.le M (Iio δ) := fun a ha b hb hab =>
    (hMi a (mem_Iic.2 (le_of_lt ha)) b (mem_Iic.2 (le_of_lt hb)) hab).2.2.1
  have Mc : IsContinuous M (Iio δ) := fun b hb hl => hMc b (mem_Iic.2 (le_of_lt hb)) hl
  have hU' : IsUnionOf M (Iio δ) (M δ) := ⟨hMc δ δm hδ, fun β hβ => hS.incl _ _ (Mle β hβ)⟩
  have lδ : s.S.le (M δ) (M (δ + 1)) :=
    hS.smooth δ hδ M _ Mi Mc (fun α hα => (h α hα).2.2.1) _ hU' (hMs δ le_rfl).1.1
  refine ⟨hMs δ le_rfl, hsat₁, ⟨lδ, hne⟩, fun N₀ k₀ N₁ k₁ l0 l01 l1 p hp hnf => ?_⟩
  by_cases hcf : lam < δ.cof
  · have hex : ∀ x : N₀.carrier, ∃ ζ < δ, x.1 ∈ (M ζ).carrier := fun x => by
      have hx := hS.sub l0 x.2
      rw [hMc δ δm hδ] at hx
      obtain ⟨ζ, hζ, h'⟩ := Set.mem_iUnion₂.1 hx
      exact ⟨ζ, hζ, h'⟩
    choose f hf hfR using hex
    have hsup : iSup f < δ := Ordinal.iSup_lt_of_lt_cof
      (lt_of_le_of_lt (le_of_eq k₀.2) hcf) hf
    have hsub : N₀.carrier ⊆ (M (iSup f)).carrier := fun x hx => by
      have h1 := hfR ⟨x, hx⟩
      have hle : f ⟨x, hx⟩ ≤ iSup f := Ordinal.le_iSup f ⟨x, hx⟩
      rcases hle.lt_or_eq with h' | h'
      · exact hS.sub (Mi _ (hf _) _ hsup h') h1
      · rwa [h'] at h1
    obtain ⟨d, hd, ht⟩ := Frame.ot_real hU hs (hMs _ hsup.le) (h _ hsup) k₀ k₁
      (hS.le_of_sub l0 (Mle _ hsup) hsub) l01 l1 hp hnf
    exact ⟨d, hS.sub (Mle _ hsup) hd, ht⟩
  · have hcle : δ.cof ≤ lam := not_lt.1 hcf
    obtain ⟨θ, g, hθ, hθκ₀, gδ, gm, g0, gcof, gl, gsl, hθe⟩ :=
      exists_cof_seq hinf hδ (hcle.trans (Order.le_succ lam))
    have hθκ : θ < (Order.succ lam).ord := by
      rw [hθe]; exact Cardinal.ord_lt_ord.2 (lt_of_le_of_lt hcle (Order.lt_succ lam))
    have hsubM : ∀ a < δ, ∀ b < δ, a ≤ b → (M a).carrier ⊆ (M b).carrier := fun a _ b hb h' => by
      rcases h'.lt_or_eq with h2 | h2
      · exact hS.sub (Mi a (lt_trans h2 hb) b hb h2)
      · rw [h2]
    have hcm : IsContinuous (fun i => M (g i)) (Iio θ) := fun b hb hlb => by
      have hbθ : b < θ := hb
      show (M (g b)).carrier = _
      rw [Mc _ (gδ b hbθ) (gsl b hbθ hlb)]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨j, hj, h'⟩ := gl b hbθ hlb ξ hξ
        have hjθ := lt_trans hj hbθ
        exact ⟨j, hj, hsubM ξ (lt_trans h' (gδ j hjθ)) _ (gδ j hjθ) h'.le hx⟩
      · rintro ⟨j, hj, hx⟩
        exact ⟨g j, gm j b hj hbθ, hx⟩
    have hNm : IsUnionOf (fun i => M (g i)) (Iio θ) (M δ) := ⟨by
      rw [hU'.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨i, hi, h'⟩ := gcof ξ hξ
        exact ⟨i, hi, hsubM ξ hξ _ (gδ i hi) h'.le hx⟩
      · rintro ⟨i, hi, hx⟩
        exact ⟨g i, gδ i hi, hx⟩, fun i hi => hU'.2 _ (gδ i hi)⟩
    have hMg : IsIncreasing (s.leNF lam) (fun i => M (g i)) (Iio θ) := fun a ha b hb h' =>
      hMi _ (mem_Iic.2 (gδ a ha).le) _ (mem_Iic.2 (gδ b hb).le) (gm a b h' hb)
    obtain ⟨Rr, E, hE, hF, hNfilt, hgtE, pa, Rc, Ug⟩ := Frame.double_filt hU hs6 hinf hθ hθκ hMg
      (fun β hβ => (hMs _ (gδ β hβ).le).1) hcm hNm (hMs δ le_rfl).1
    obtain ⟨R1, hR1⟩ := hS.exists_filt hc.ax0b hinf hsat₁.1
    obtain ⟨E₂, hE₂, hs2⟩ := hNfilt.club_sub hS hinf hR1 (hS.sub lδ)
    obtain ⟨ζ₀, hζ₀, c0⟩ := hNfilt.cover hS hinf (hS.sub l0) (le_of_eq k₀.2)
    obtain ⟨ζ₁, hζ₁, c1⟩ := hR1.cover hS hinf (hS.sub l1) (le_of_eq k₁.2)
    have hEE := (ClubL.inter hinf hE hE₂)
    obtain ⟨ε, ⟨-, hεE, hεE₂⟩, hgt, hεκ⟩ := hEE.1 (max ζ₀ ζ₁) (max_lt hζ₀ hζ₁)
    have lAT : s.S.le (Rr θ ε) (M (δ + 1)) := hS.trans (hNfilt.le hS hinf hεκ) lδ
    have lBT : s.S.le (R1 ε) (M (δ + 1)) := hR1.le hS hinf hεκ
    have sAB := hs2 ε hεE₂ hεκ
    have lAB : s.S.le (Rr θ ε) (R1 ε) := hS.le_of_sub lAT lBT sAB
    have kA := hNfilt.2.2.1 ε hεκ
    have kB := hR1.2.2.1 ε hεκ
    have lN₀A : s.S.le N₀ (Rr θ ε) := hS.le_of_sub l0 (hNfilt.le hS hinf hεκ)
      (c0.trans (hNfilt.sub hS ((le_max_left _ _).trans hgt.le) hεκ))
    have lN₁B : s.S.le N₁ (R1 ε) := hS.le_of_sub l1 lBT
      (c1.trans (hR1.sub hS ((le_max_right _ _).trans hgt.le) hεκ))
    obtain ⟨q, hq, hqnf, hqr⟩ := Frame.ext_nf hc k₀ k₁ kB l01 lN₁B hp hnf
    obtain ⟨b, W, eq, nfb⟩ := hqnf
    have nfA : s.nf (Rr θ ε) (R1 ε) b W := Frame.nf_mono hS hc.ax3a hc.ax3b nfb lN₀A lAB (hS.refl kB.1)
    obtain ⟨-, -, kW, hbW, -, lBW, hsbs, -⟩ := hc.ax3a.1 _ _ _ _ nfA
    have hαs := hEE
    have ci : IsIncreasing s.S.le (fun β => Rr β ε) (Iio θ) := fun a _ b' hb' hab =>
      pa ε hεE hεκ a b' hab hb'
    have cc : IsContinuous (fun β => Rr β ε) (Iio θ) := fun b' hb' hl => Rc ε hεE hεκ b' hb' hl
    have Uε := Ug ε hεE hεκ
    have ule := (hS.le_union hθ ci cc Uε).2
    let Y : Ordinal.{u} → Model U L := fun β => if β ≤ θ then Rr β ε else W
    have Yl : ∀ β ≤ θ, Y β = Rr β ε := fun β h' => if_pos h'
    have Yt : Y (θ + 1) = W := if_neg (not_le.2 (Order.lt_add_one_iff.2 le_rfl))
    have hYk : ∀ β ≤ θ, Rr β ε ∈ s.S.Kc lam := fun β hβ => by
      rcases hβ.lt_or_eq with h' | h'
      · exact (hF β h').2.2.1 ε hεκ
      · rw [h']; exact kA
    have Yle : ∀ a ≤ θ, s.S.le (Rr a ε) (Rr θ ε) := fun a ha => by
      rcases ha.lt_or_eq with h' | h'
      · exact ule a h'
      · rw [h']; exact hS.refl kA.1
    have lAW := hS.trans lAB lBW
    have hYc : IsIncCont s.S Y (Iic (θ + 1)) (s.S.Kc lam) := by
      refine ⟨fun a ha b' hb' hab => ?_, fun b' hb' hl => ?_, fun β hβ => ?_⟩
      · have haθ : a ≤ θ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb')
        rw [Yl a haθ]
        rcases (show b' ≤ θ + 1 from hb').lt_or_eq with h' | h'
        · have hbθ := Order.lt_add_one_iff.1 h'
          rw [Yl b' hbθ]
          rcases hbθ.lt_or_eq with h2 | h2
          · exact pa ε hεE hεκ a b' hab h2
          · rw [h2]; exact ule a (h2 ▸ hab)
        · rw [h', Yt]; exact hS.trans (Yle a haθ) lAW
      · have hbθ : b' ≤ θ := by
          rcases (show b' ≤ θ + 1 from hb').lt_or_eq with h' | h'
          · exact Order.lt_add_one_iff.1 h'
          · rw [h'] at hl
            exact absurd (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl)) (lt_irrefl _)
        show (Y b').carrier = ⋃ c ∈ Iio b', (Y c).carrier
        rw [Yl b' hbθ, Set.iUnion₂_congr (fun c (hc1 : c ∈ Iio b') =>
          by rw [Yl c ((le_of_lt hc1).trans hbθ)])]
        rcases hbθ.lt_or_eq with h' | h'
        · exact Rc ε hεE hεκ b' h' hl
        · rw [h']; exact Uε.1
      · rcases (show β ≤ θ + 1 from hβ).lt_or_eq with h' | h'
        · have := Order.lt_add_one_iff.1 h'
          rw [Yl β this]; exact hYk β this
        · rw [h', Yt]; exact kW
    have hbas : tp s.S lam b (Y θ) (Y (θ + 1)) ∈ s.Sbs (Y θ) := by
      rw [Yl θ le_rfl, Yt]; exact hsbs
    obtain ⟨i, hi, hNFk⟩ := hs.1.2.2.2.2 θ hθ hθκ Y hYc b hbas
    rw [Yl i hi.le, Yl θ le_rfl, Yt] at hNFk
    have ki := (hF i hi).2.2.1 ε hεκ
    have liA := Yle i hi.le
    have hqnf2 : s.NotFork lam (Rr i ε) (R1 ε) q :=
      Frame.notFork_trans hc ki kB liA lAB hq ⟨b, W, eq, nfA⟩ (by
        rw [eq, res_tp hS lAB]; exact hNFk)
    obtain ⟨d, hd, ht⟩ := Frame.ot_real hU hs (hMs _ (gδ i hi).le) (h _ (gδ i hi)) ki kB
      ((hF i hi).le hS hinf hεκ) (hS.trans liA lAB) lBT hq hqnf2
    refine ⟨d, hS.sub (Mle _ (gδ i hi)) hd, ?_⟩
    rw [← hqr, ← ht, res_tp hS lN₁B]

/-- AUX: not in paper. The successor step ("Case a") of the proof of Prop 8.1.4. -/
theorem Frame.ot_step [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_8_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {M₀ M₁ A B C P : Model U L} {g : U → U} (h : s.leOt lam M₀ M₁)
    (kA : A ∈ s.S.Kc lam) (kB : B ∈ s.S.Kc lam) (kC : C ∈ s.S.Kc lam) (lAM : s.S.le A M₀)
    (lBM : s.S.le B M₁) (lAB : s.S.le A B) (hg : IsEmb s.S g A C) (lP : s.S.le P C) (iP : IsoOn g A P)
    (hne : P ≠ C) :
    ∃ (A' B' C' : Model U L) (g' : U → U) (a : U), A' ∈ s.S.Kc lam ∧ B' ∈ s.S.Kc lam ∧ C' ∈ s.S.Kc lam ∧
      s.S.le A' M₀ ∧ s.S.le B' M₁ ∧ s.S.le A A' ∧ s.S.le B B' ∧ s.S.le A' B' ∧ s.S.le C C' ∧
      IsEmb s.S g' A' C' ∧ (∀ x ∈ A.carrier, g' x = g x) ∧ a ∈ A'.carrier \ A.carrier ∧ g' a ∈ C.carrier ∧
      s.NF lam A A' B B' := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hL : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hc.ax0b
  obtain ⟨sat₀, sat₁, hlt01, hreal⟩ := h
  have l01 := hlt01.1
  have hnot : ¬ M₁.carrier ⊆ B.carrier := fun hsub => by
    have h1 : #M₁.carrier ≤ #B.carrier := Cardinal.mk_le_mk_of_subset hsub
    have e0 : #B.carrier = lam := kB.2
    have e2 : #M₁.carrier = Order.succ lam := sat₁.1.2
    rw [e0, e2] at h1
    exact absurd h1 (not_le.2 (Order.lt_succ lam))
  obtain ⟨x, hx1, hxB⟩ := Set.not_subset.1 hnot
  obtain ⟨Bp, kBp, hsubp, lBpM⟩ := hS.exists_small hc.ax0b hinf kB sat₁.1.1 (hS.sub lBM) hx1
  have lBBp : s.S.le B Bp := hS.le_of_sub lBM lBpM (Set.subset_union_left.trans hsubp)
  have lABp := hS.trans lAB lBBp
  have hltA : s.S.lt A Bp := ⟨lABp, fun e => hxB (hS.sub lAB (e ▸ hsubp (Or.inr rfl)))⟩
  have kP : P ∈ s.S.Kc lam := ⟨hS.mem_left lP, by rw [iP.card_eq]; exact kA.2⟩
  obtain ⟨b, hb, hbs⟩ := hc.ax2c P kP C kC ⟨lP, hne⟩
  obtain ⟨gi, hgi, gi1, -⟩ := iP.exists_inv
  have hsm : #(∅ ∪ A.carrier : Set U) < #U := by
    rw [Set.empty_union]
    have : #A.carrier = lam := kA.2
    rw [this]; exact hU.2
  obtain ⟨r, N', hr, hid, lAN', mem, -⟩ := hS.rename hU.infinite ∅ lP hgi hsm
  have hrP : IsoOn r P A := hgi.congr fun x hx => (hid x hx).symm
  have hbs' := hc.ax2b P _ N' _ b r kP hbs hr hrP
  have hrg : ∀ y ∈ A.carrier, r (g y) = y := fun y hy => by
    rw [hid _ (iP.mapsTo hy)]; exact gi1 y hy
  obtain ⟨q, hq, nfq, hqr⟩ := hc.ax3f _ kA _ kBp _ hbs' hltA
  obtain ⟨a, ha0, hat⟩ := hreal A kA Bp kBp lAM lABp lBpM q hq nfq
  have ha1 := hS.sub l01 ha0
  have e1 : tp s.S lam a A M₀ = tp s.S lam (r b) A N' := by
    have e := tp_eq_of_le (lam := lam) hS (M := A) (N := M₁) (W := M₀) (a := a)
      ⟨kA.1, sat₁.1.1, hS.trans lAM l01, ha1⟩ l01 lAM ha0
    rw [e, ← res_tp hS lABp, hat]; exact hqr
  obtain ⟨W₂, kW₂, hsW, lW₂⟩ := hS.exists_small hc.ax0b hinf kA sat₀.1.1 (hS.sub lAM) ha0
  have aW : a ∈ W₂.carrier := hsW (Or.inr rfl)
  have lAW : s.S.le A W₂ := hS.le_of_sub lAM lW₂ (Set.subset_union_left.trans hsW)
  have e2 : tp s.S lam a A W₂ = tp s.S lam (r b) A N' := by
    rw [tp_eq_of_le hS ⟨kA.1, sat₀.1.1, lAM, ha0⟩ lW₂ lAW aW]; exact e1
  obtain ⟨W, y, -, -, hy, hEq⟩ := hc.ax2a _ kA hbs'
  have haA : a ∉ A.carrier := fun hab => by
    have e : y = a := (ERel.alg (tp_eq_iff.1 (e2.trans hEq))).1 ((hsW (Or.inl hab) |> fun _ => hab))
    exact hy.2 (e ▸ hab)
  obtain ⟨Np, ap, ht, huq⟩ := hs.2.2 (A, W₂, a) ⟨kA, kW₂, ⟨aW, haA⟩, by
    show tp s.S lam a A W₂ ∈ s.Sbs A
    rw [e2]; exact hbs'⟩
  have hK3 := Frame.K3bs_K3 hc huq.1
  have kNp : Np ∈ s.S.Kc lam := huq.1.2.1
  obtain ⟨N₂, kN₂, lWN₂, u, hu, huo, hua⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf (M := A) (N := Np)
    (N' := W₂) (a := ap) (a' := a) ⟨kA, kNp, hK3.2.2.1, hK3.2.2.2⟩ ⟨kA, kW₂, lAW, aW⟩ ht
  obtain ⟨v, hv, hvo⟩ := ((CitedResults.prop_1_0_31 lam hU s.S hS hc.ax1b hc.ax0b M₀ sat₀.1).1 sat₀).2 W₂ kW₂ N₂ kN₂ lW₂ lWN₂
  have hvu : IsEmb s.S (v ∘ u) Np M₀ := hu.comp hS hv
  obtain ⟨-, -, A', lA', iA'⟩ := id hvu
  have kA' : A' ∈ s.S.Kc lam := ⟨hS.mem_left lA', by rw [iA'.card_eq]; exact kNp.2⟩
  have fixA : ∀ x ∈ A.carrier, (v ∘ u) x = x := fun x hx => by
    simp only [Function.comp, huo.2 x hx, hvo.2 x (hS.sub lAW hx)]
  have fa : (v ∘ u) ap = a := by simp only [Function.comp, hua, hvo.2 a aW]
  have huq' : (A, A', a) ∈ s.K3uq lam := by
    have := Frame.K3uq_isoClosed hU hc _ huq (v ∘ u) A A' iA'
      ((IsoOn.refl A).congr fun x hx => (fixA x hx).symm)
    simpa only [fa] using this
  have aA' : a ∈ A'.carrier := by
    have := iA'.mapsTo hK3.2.2.2
    rwa [fa] at this
  have lAA' : s.S.le A A' := hS.le_of_sub lAM lA' fun x hx => by
    have := iA'.mapsTo (hS.sub hK3.2.2.1 hx)
    rwa [fixA x hx] at this
  let Y : Set U := A'.carrier ∪ Bp.carrier
  have hYc : #Y ≤ lam := (Cardinal.mk_union_le _ _).trans
    (Cardinal.add_le_of_le hinf (le_of_eq kA'.2) (le_of_eq kBp.2))
  have hYM : Y ⊆ M₁.carrier := Set.union_subset ((hS.sub lA').trans (hS.sub l01)) (hS.sub lBpM)
  obtain ⟨B', hB', hYB', lB', hcd⟩ := hL M₁ sat₁.1.1 Y hYM
  have kB' : B' ∈ s.S.Kc lam := by
    refine ⟨hB', le_antisymm (hcd.trans (Cardinal.add_le_of_le hinf le_rfl hYc)) ?_⟩
    rw [← kBp.2]; exact Model.card_le_of_sub (Set.subset_union_right.trans hYB')
  have lBpB' : s.S.le Bp B' := hS.le_of_sub lBpM lB' (Set.subset_union_right.trans hYB')
  have lA'B' : s.S.le A' B' := hS.le_of_sub (hS.trans lA' l01) lB' (Set.subset_union_left.trans hYB')
  have aB' : a ∈ B'.carrier := hS.sub lA'B' aA'
  obtain ⟨b', W', eq', nfb⟩ := nfq
  have htpB : tp s.S lam a Bp B' = tp s.S lam b' Bp W' := by
    rw [← eq', ← hat]
    exact tp_eq_of_le hS ⟨kBp.1, sat₁.1.1, lBpM, ha1⟩ lB' lBpB' aB'
  have nfa : s.nf A Bp a B' := prop_2_1_2 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b _ _ _ _ _ _ kB' nfb htpB
  have nfB : s.nf A B a B' := Frame.nf_mono hS hc.ax3a hc.ax3b nfa (hS.refl kA.1) lAB lBBp
  have lBB' := hS.trans lBBp lBpB'
  obtain ⟨hk0, hk1, hk2, hk3, αs, X, Z, d, hw⟩ := Frame.nfstar_zero hU hc kA kB lAB
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨X', Z', d', hw', -⟩ := Frame.nfstarWit_snoc hc hw (hκl.add_one_lt hw.1) huq' lA'B' lBB'
    ⟨a, B', rfl, nfB⟩
  have hNF : s.NF lam A A' B B' := Frame.nfstar_nf hc ⟨kA, kA', kB, kB', _, X', Z', d', hw'⟩
  have hx' : tp s.S lam a A A' = tp s.S lam (r b) A N' := by
    rw [tp_eq_of_le hS ⟨kA.1, sat₀.1.1, lAM, ha0⟩ lA' lAA' aA']; exact e1
  obtain ⟨W₀, h₀, kW₀, lCW, em, ext, h0a⟩ := hS.star_gen hU hc.ax1b hc.ax0b hinf kA kA' kC lAA' hg hr lAN'
    hrg hb.1 aA' hx'
  exact ⟨A', B', W₀, h₀, a, kA', kB', kW₀, lA', lB', lAA', lBB', lA'B', lCW, em, ext, ⟨aA', haA⟩,
    by rw [h0a]; exact hb.1, hNF⟩

/-- AUX: not in paper. The state of the construction in the proof of Prop 8.1.4. -/
abbrev OtState (U : Type u) (L : Language.{u, u}) := Model U L × Model U L × Model U L × (U → U)

/-- AUX: not in paper. The invariant of the construction in the proof of Prop 8.1.4. -/
def Frame.OtInv (s : Frame U L) (lam : Cardinal.{u}) (M₀ M₁ N₀ N₁ N₂ : Model U L) (ε : Ordinal.{u})
    (c : Ordinal.{u} → OtState U L) : Prop :=
  (∀ β ≤ ε, (c β).1 ∈ s.S.Kc lam ∧ (c β).2.1 ∈ s.S.Kc lam ∧ (c β).2.2.1 ∈ s.S.Kc lam ∧
    s.S.le (c β).1 M₀ ∧ s.S.le (c β).2.1 M₁ ∧ s.S.le (c β).1 (c β).2.1 ∧
    IsEmb s.S (c β).2.2.2 (c β).1 (c β).2.2.1 ∧ ∀ x ∈ N₀.carrier, (c β).2.2.2 x = x) ∧
  (c 0).1 = N₀ ∧ (c 0).2.1 = N₁ ∧ (c 0).2.2.1 = N₂ ∧
  IsIncreasing s.S.le (fun β => (c β).1) (Iic ε) ∧ IsContinuous (fun β => (c β).1) (Iic ε) ∧
  IsIncreasing s.S.le (fun β => (c β).2.1) (Iic ε) ∧ IsContinuous (fun β => (c β).2.1) (Iic ε) ∧
  IsIncreasing s.S.le (fun β => (c β).2.2.1) (Iic ε) ∧ IsContinuous (fun β => (c β).2.2.1) (Iic ε) ∧
  FunIncreasing (fun β => (c β).2.2.2) (fun β => (c β).1) (Iic ε) ∧
  FunContinuous (fun β => (c β).2.2.2) (fun β => (c β).1) (Iic ε) ∧
  ∀ β, β + 1 ≤ ε → (∃ a ∈ (c (β + 1)).1.carrier \ (c β).1.carrier, (c (β + 1)).2.2.2 a ∈ (c β).2.2.1.carrier) ∧
    s.NF lam (c β).1 (c (β + 1)).1 (c β).2.1 (c (β + 1)).2.1

/-- AUX: not in paper. Union of an initial segment in `K_λ`, of limit length `δ < λ⁺`. -/
theorem IsAEC.union_Kc {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {δ : Ordinal.{u}} (hl : Order.IsSuccLimit δ) (hδ : δ < (Order.succ lam).ord)
    {X : Ordinal.{u} → Model U L} (hi : IsIncreasing S.le X (Iio δ)) (hc : IsContinuous X (Iio δ))
    (hK : ∀ β < δ, X β ∈ S.Kc lam) :
    ∃ V ∈ S.Kc lam, IsUnionOf X (Iio δ) V ∧ ∀ β < δ, S.le (X β) V := by
  obtain ⟨V, hV, -, -⟩ := hS.union δ hl X hi hc
  obtain ⟨hVK, hle⟩ := hS.le_union hl hi hc hV
  refine ⟨V, ⟨hVK, le_antisymm ?_ ?_⟩, hV, hle⟩
  · change #V.carrier ≤ lam
    rw [hV.1]
    exact card_biUnion_le hinf (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hδ))
      fun β hβ => le_of_eq (hK β hβ).2
  · rw [← (hK 0 hl.bot_lt).2]; exact Model.card_le_of_sub (hS.sub (hle 0 hl.bot_lt))

/-- Prop 8.1.4: suppose `M₀ ≼^⊗ M₁`, `Nₙ ∈ K_λ` (`n < 3`), `N₀ ≼ M₀`, `N₀ ≼ N₂`,
`N₀ ≼ N₁ ≼ M₁`. Then for some `N₁* ∈ K_λ` and embedding `f : N₂ → M₀`: (a) `f ↾ N₀ = id`,
(b) `NF(N₀, f[N₂], N₁, N₁*)`, (c) `N₁* ≼ M₁`. -/
theorem prop_8_1_4 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_8_1_1 s lam)
    (M₀ M₁ N₀ N₁ N₂ : Model U L) (h : s.leOt lam M₀ M₁) (h₀ : N₀ ∈ s.S.Kc lam)
    (h₁ : N₁ ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam) (h0M : s.S.le N₀ M₀) (h02 : s.S.le N₀ N₂)
    (h01 : s.S.le N₀ N₁) (h1M : s.S.le N₁ M₁) :
    ∃ N₁s ∈ s.S.Kc lam, ∃ (f : U → U) (P : Model U L), IsEmb s.S f N₂ M₀ ∧
      (∀ x ∈ N₀.carrier, f x = x) ∧ IsoOn f N₂ P ∧ s.NF lam N₀ P N₁ N₁s ∧ s.S.le N₁s M₁ := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₀
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  by_contra hno
  haveI : Nonempty (OtState U L) := ⟨(N₀, N₁, N₂, id)⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (Order.succ lam).ord
    (fun ε c => ε < (Order.succ lam).ord → s.OtInv lam M₀ M₁ N₀ N₁ N₂ ε c)
    (fun ε c c' h' hi hε => by
      obtain ⟨h1, h2, h3, h4, a1, a2, b1, b2, d1, d2, f1, f2, st⟩ := hi hε
      have e : ∀ β ≤ ε, c' β = c β := fun β hβ => (h' β hβ).symm
      have e0 := e 0 zero_le
      refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2, by rw [e0]; exact h3,
        by rw [e0]; exact h4, fun a ha b hb hab => ?_, fun b hb hl => ?_, fun a ha b hb hab => ?_,
        fun b hb hl => ?_, fun a ha b hb hab => ?_, fun b hb hl => ?_,
        fun a ha b hb hab y hy => ?_, fun b hb hl y hy => ?_, fun β hβ => ?_⟩
      · simp only [e a ha, e b hb]; exact a1 a ha b hb hab
      · simp only [e b hb]; rw [a2 b hb hl]
