theorem Frame.otMinusE_NFuq {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) : OtMinusE s.S lam (s.NFuqE lam) := by
  have hS : IsAEC s.S := hc.ax0a
  refine ⟨?_, ?_, ?_⟩
  · rintro a M₀ M₁ M₂ M₃ ⟨hu, h2, h3, h13, h02, h23, -⟩
    exact ⟨hu.1.1, hu.1.2.1, h2, h3, (Frame.K3bs_K3 hc hu.1).2.2.1, h13, h02, h23⟩
  · rintro a₀ N₀ N₁ N₂ A B ha₀ hA hB ⟨P, Q, hP, hQ, hu, hQc, hXc, hPX, h0Q, hQX, hnf⟩
      ⟨P', Q', hP', hQ', hu', hQ'c, hXc', hPX', h0Q', hQX', hnf'⟩
    obtain ⟨θ, hθ, hθA, -⟩ := hP.exists_inv
    have hovA := hA.1.2.2.1
    have hN₀N₁ : N₀.carrier ⊆ N₁.carrier := fun x hx => (hovA.1 hx).1
    have hAfix : IsoOn A.1 N₀ N₀ := (IsoOn.refl _).congr fun x hx => (hovA.2 x hx).symm
    have hθ0 : IsoOn θ N₀ N₀ := (IsoOn.refl _).congr fun x hx => by
      show x = θ x
      have := hθA x (hN₀N₁ hx); rw [hovA.2 x hx] at this; exact this.symm
    have hu₀ : (N₀, N₁, a₀) ∈ s.K3uq lam := by
      have h1 : (N₀, N₁, θ (A.1 a₀)) ∈ s.K3uq lam :=
        Frame.K3uq_isoClosed hU hc _ hu θ N₀ N₁ hθ hθ0
      rwa [hθA a₀ ha₀] at h1
    obtain ⟨θ₂, hθ₂, hθ₂A, -⟩ := hQ.exists_inv
    have hov2 := hA.1.2.2.2
    have hN₀N₂ : N₀.carrier ⊆ N₂.carrier := fun x hx => (hov2.1 hx).1
    have hθ₂0 : IsoOn θ₂ N₀ N₀ := (IsoOn.refl _).congr fun x hx => by
      show x = θ₂ x
      have := hθ₂A x (hN₀N₂ hx); rw [hov2.2 x hx] at this; exact this.symm
    have h02 : s.S.le N₀ N₂ := hS.iso_le h0Q hθ₂ hθ₂0
    have hN₂c : N₂ ∈ s.S.Kc lam := ⟨hS.mem_right h02, by rw [hθ₂.card_eq]; exact hQc.2⟩
    exact (hu₀.2 N₂ hN₂c h02).2 A B hA ⟨Q, hQ, hnf⟩ hB ⟨Q', hQ', hnf'⟩
  · rintro a M₀ M₁ M₂ M₃ M₄ f ⟨hu, h2, h3, h13, h02, h23, hnf⟩ hf h4
    obtain ⟨-, -, Q₂, hQ₂, hfQ⟩ := id hf
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h2
    have hQ₂c : Q₂ ∈ s.S.Kc lam := ⟨hS.mem_left hQ₂, by rw [hfQ.card_eq]; exact h2.2⟩
    obtain ⟨g₀, M₃', hg₀, hg₀f, hQM, hM'K, -⟩ := hS.rename hU.infinite (∅ : Set U) h23 hfQ (by
      rw [Set.empty_union]; change Q₂.card < #U; rw [hQ₂c.2]; exact hU.2)
    have hM'c : M₃' ∈ s.S.Kc lam := ⟨hM'K, by rw [hg₀.card_eq]; exact h3.2⟩
    obtain ⟨P, hfP⟩ := exists_isoOn (hfQ.injOn.mono (hS.sub h02))
    have hg₀P : IsoOn g₀ M₀ P := hfP.congr fun x hx => (hg₀f x (hS.sub h02 hx)).symm
    have hP0 : s.S.le P Q₂ := hS.iso_le h02 hfQ hfP
    have ha3 : a ∈ M₃.carrier := hS.sub h13 hu.1.2.2.1.1
    have hnfP := Frame.notFork_iso hU hc hnf h23 ha3 hg₀ hg₀P (hfQ.congr fun x hx => (hg₀f x hx).symm)
    have key : ∃ (Z : Model U L) (h : U → U) (c : U), Z ∈ s.S.Kc lam ∧ s.S.le M₄ Z ∧
        IsEmb s.S h M₃' Z ∧ (∀ x ∈ Q₂.carrier, h x = x) ∧ h (g₀ a) = c ∧
        s.NotFork lam P M₄ (tp s.S lam c M₄ Z) := by
      by_cases heq : Q₂ = M₄
      · refine ⟨M₃', id, g₀ a, hM'c, by rw [← heq]; exact hQM, IsEmb.of_le hS (hS.refl hM'K),
          fun _ _ => rfl, rfl, by rw [← heq]; exact hnfP⟩
      · have hn := Frame.nf_of_notFork hU hc hnfP hM'c
        have hpb := (hc.ax3a.1 _ _ _ _ hn).2.2.2.2.2.2.2
        obtain ⟨q, hq, hnq, hres⟩ := hc.ax3f Q₂ hQ₂c M₄ h4 _ hpb ⟨hQ₂, heq⟩
        obtain ⟨c, Y, rfl, hn'⟩ := hnq
        obtain ⟨-, -, hY, hcY, -, hM₄Y, -, -⟩ := hc.ax3a.1 _ _ _ _ hn'
        rw [res_tp hS hQ₂] at hres
        have hK1 : (Q₂, M₃', g₀ a) ∈ s.S.K3c lam := ⟨hQ₂c, hM'c, hQM, hg₀.mapsTo ha3⟩
        have hK2 : (Q₂, Y, c) ∈ s.S.K3c lam := ⟨hQ₂c, hY, hS.trans hQ₂ hM₄Y, hcY.1⟩
        obtain ⟨Z, hZ, hYZ, h, hh, hov, hhe⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf hK1 hK2
          hres.symm
        have hK3 : (M₄, Z, c) ∈ s.S.K3 := ⟨h4.1, hZ.1, hS.trans hM₄Y hYZ, hS.sub hYZ hcY.1⟩
        refine ⟨Z, h, c, hZ, hS.trans hM₄Y hYZ, hh, hov.2, hhe, ?_⟩
        rw [← tp_eq_of_le hS hK3 hYZ hM₄Y hcY.1]
        refine Frame.notFork_trans hc ⟨hS.mem_left hP0, by rw [hfP.card_eq]; exact hu.1.1.2⟩ h4 hP0
          hQ₂ hq ⟨c, Y, rfl, hn'⟩ ?_
        rw [res_tp hS hQ₂, hres]; exact hnfP
    obtain ⟨Z, h, c, hZ, h4Z, hh, hfix, hhe, hnfZ⟩ := key
    have hgE : IsEmb s.S (h ∘ g₀) M₃ Z := IsEmb.iso_comp hg₀ h3.1 hh
    obtain ⟨-, -, Y, hYZ, hgY⟩ := id hgE
    obtain ⟨Q, hgQ⟩ := exists_isoOn (hgY.injOn.mono (hS.sub h13))
    have hgf : ∀ x ∈ M₂.carrier, (h ∘ g₀) x = f x := fun x hx => by
      show h (g₀ x) = f x
