        rcases hyD with hy0 | hy2
        · have hx3 : y ∈ N₃.carrier := by rw [← hd34]; exact ⟨hx4, hS.sub n03.2.2.1 hy0⟩
          have hx0 : y ∈ N₀.carrier := by rw [← hd03]; exact ⟨hx3, hy0⟩
