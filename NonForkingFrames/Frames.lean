/-- AUX: not in paper. Two filtrations of a model of `K_{λ⁺}` agree on a club. -/
theorem IsFilt.agree {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {M : Model U L} {R R' : Ordinal.{u} → Model U L} (hR : IsFilt S lam M R)
    (hR' : IsFilt S lam M R') :
    ∃ E, ClubL lam E ∧ ∀ ε ∈ E, ε < (Order.succ lam).ord → R ε = R' ε := by
  obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (R ε).carrier)
    (G := fun ε => (R' ε).carrier) (fun a b h hb => hR.sub hS h hb) (fun a b h hb => hR'.sub hS h hb)
    (fun b hb hl => hR.2.1 b hb hl) (fun b hb hl => hR'.2.1 b hb hl)
    (fun a ha => le_of_eq (hR.2.2.1 a ha).2) (fun a ha => le_of_eq (hR'.2.2.1 a ha).2)
    (by rw [← hR.2.2.2.1, ← hR'.2.2.2.1])
  refine ⟨_, ⟨hub, hcl⟩, fun ε hε hκ => ?_⟩
  have e : (R ε).carrier = (R' ε).carrier := hε
  exact hS.po.2.2.1 _ _ (hS.le_of_sub (hR.le hS hinf hκ) (hR'.le hS hinf hκ) e.subset)
    (hS.le_of_sub (hR'.le hS hinf hκ) (hR.le hS hinf hκ) e.symm.subset)

/-- AUX: not in paper. Claim 7.1.14 (one sequence for `M₀ ≺⁺ M₁` and `M₀ ≺⁺ M₂`), with the additional
freedom of a club `Es` containing the starting point. -/
theorem Frame.uq_common {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) (hinf : ℵ₀ ≤ lam)
    {M₀ : Model U L} {M : Bool → Model U L} {A' : Bool → Ordinal.{u} → Model U L}
    {B' C' : Bool → Ordinal.{u} → Model U L} {E' : Bool → Set Ordinal.{u}}
    (hw : ∀ n, s.PlusWit lam M₀ (M n) (A' n) (B' n) (C' n) (E' n)) {Es : Set Ordinal.{u}}
    (hEs : ClubL lam Es) :
    ∃ (A : Ordinal.{u} → Model U L) (B C : Bool → Ordinal.{u} → Model U L) (ε₀ : Ordinal.{u}),
      (∀ n, s.PlusWit lam M₀ (M n) A (B n) (C n) (Iio (Order.succ lam).ord)) ∧
      ε₀ ∈ Es ∧ ε₀ < (Order.succ lam).ord ∧ (∀ n, A 0 = A' n ε₀) ∧ ∀ n, B n 0 = B' n ε₀ := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨Eg, hEg, hag⟩ := IsFilt.agree hS hinf (hw true).filt.1 (hw false).filt.1
  have hc1 : ∀ n, ClubL lam (E' n) := fun n => ClubL.of_isClub (hw n).2.2.2.2.1
  have hE := ClubL.inter hinf (ClubL.inter hinf hEs hEg) (ClubL.inter hinf (hc1 true) (hc1 false))
  obtain ⟨e, he1, he2, he3, he4⟩ := exists_club_enum' hinf hE
  have mem : ∀ β < (Order.succ lam).ord, e β ∈ Es ∧ e β ∈ Eg ∧ ∀ n, e β ∈ E' n := by
    intro β hβ
    obtain ⟨-, ⟨-, h1, h2⟩, -, h3, h4⟩ := he3 β hβ
    exact ⟨h1, h2, fun n => by cases n <;> assumption⟩
  have agr : ∀ β < (Order.succ lam).ord, A' false (e β) = A' true (e β) := fun β hβ =>
    (hag _ (mem β hβ).2.1 (he1 β hβ)).symm
  refine ⟨fun β => A' true (e β), fun n β => B' n (e β), fun n β => C' n (e β), e 0, fun n => ?_,
    (mem 0 hκl.bot_lt).1, he1 0 hκl.bot_lt, fun n => ?_, fun _ => rfl⟩
  · refine (hw n).reindex hc he1 he2 (fun β hβ => (mem β hβ).2.2 n) he4 fun β hβ => ⟨?_, rfl, rfl⟩
    cases n
    · exact (agr β hβ).symm
    · rfl
  · cases n
    · exact (agr 0 hκl.bot_lt).symm
    · rfl

/-- AUX: not in paper. From common witnesses and an amalgam of the starting models to an isomorphism. -/
theorem Frame.uq_finish [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_7_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {A : Ordinal.{u} → Model U L} {B C : Bool → Ordinal.{u} → Model U L}
    {M₀ : Model U L} {M : Bool → Model U L} (kM₀ : M₀ ∈ s.S.Kc (Order.succ lam))
    (hMk : ∀ n, M n ∈ s.S.Kc (Order.succ lam))
    (hw : ∀ n, s.PlusWit lam M₀ (M n) A (B n) (C n) (Iio (Order.succ lam).ord)) {X₀ : Model U L}
    {g : Bool → U → U} (kX₀ : X₀ ∈ s.S.Kc lam) (he : ∀ n, IsEmb s.S (g n) (B n 0) X₀)
    (hid : ∀ n, ∀ x ∈ (A 0).carrier, g n x = x) :
    ∃ f, IsoOn f (M true) (M false) ∧ Over f (M true) (M false) M₀.carrier ∧
      ∀ x ∈ (B true 0).carrier, ∀ y ∈ (B false 0).carrier, g true x = g false y → f x = y := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hM₀ : #M₀.carrier < #U := by
    have e : #M₀.carrier = Order.succ lam := kM₀.2
    rw [e]
    exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.two_power_lt hU.2)
  have kA0 : A 0 ∈ s.S.Kc lam := (hw true).1.2.2 0 hκl.bot_lt
  have lAB : s.S.le (A 0) (B true 0) := ((hw true).2.2.2.2.2.2.2.1 0 hκl.bot_lt).1
  have lAX : s.S.le (A 0) X₀ := by
    obtain ⟨-, -, P, lP, iP⟩ := he true
    obtain ⟨Q, hQ⟩ := exists_isoOn (iP.injOn.mono (hS.sub lAB))
    have e : Q = A 0 := hQ.unique ((IsoOn.refl _).congr fun x hx => (hid true x hx).symm)
    exact hS.trans (e ▸ hS.iso_le lAB iP hQ) lP
  have hsmall : #(M₀.carrier ∪ (A 0).carrier : Set U) < #U :=
    lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hM₀
      (by have : #(A 0).carrier = lam := kA0.2; rw [this]; exact hU.2))
  obtain ⟨ρ, X, hρ, hρid, lA, mem, hout⟩ := hS.rename hU.infinite M₀.carrier lAX (IsoOn.refl _) hsmall
  have hρA : ∀ x ∈ (A 0).carrier, ρ x = x := fun x hx => hρid x hx
  have kX : X ∈ s.S.Kc lam := ⟨mem, by rw [hρ.card_eq]; exact kX₀.2⟩
  have hXM : X.carrier ∩ M₀.carrier = (A 0).carrier := by
    ext x
    constructor
    · rintro ⟨hx, hx0⟩
      rw [hρ.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_cases hyA : y ∈ (A 0).carrier
      · rw [hρA y hyA]; exact hyA
      · exact absurd (Or.inl hx0) (hout y ⟨hy, hyA⟩)
    · intro hx
      exact ⟨hS.sub lA hx, hS.sub ((hw true).filt.1.le hS hinf hκl.bot_lt) hx⟩
  obtain ⟨k, N, hk, hk0, hkB⟩ := Frame.uq_core hU hs hinf hM₀ hMk hw kX
    (g0 := fun n => ρ ∘ g n) (fun n => (he n).comp_iso hS hρ)
    (fun n x hx => by simp only [Function.comp, hid n x hx, hρA x hx]) hXM
  obtain ⟨i, hi, i1, -⟩ := (hk false).exists_inv
  have hsubM : ∀ n, M₀.carrier ⊆ (M n).carrier := fun n x hx => by
    have := (hw n).filt
    obtain ⟨hA', hB', -, -, -, h0, h1, hb, -⟩ := id (hw n)
    rw [h0.1] at hx
    simp only [mem_iUnion, exists_prop] at hx
    obtain ⟨β, hβ, hxβ⟩ := hx
    exact hS.sub (this.2.le hS hinf hβ) (hS.sub (hb β hβ).1 hxβ)
  refine ⟨i ∘ k true, (hk true).comp hi, ⟨fun x hx => ⟨hsubM true hx, hsubM false hx⟩, fun x hx => ?_⟩,
    fun x hx y hy hxy => ?_⟩
  · have e := i1 x (hsubM false hx)
    rw [hk0 false x hx] at e
    simp only [Function.comp, hk0 true x hx, e]
  · have e := i1 y (hS.sub ((hw false).filt.2.le hS hinf hκl.bot_lt) hy)
    have ek : k true x = k false y := by
      rw [hkB true x hx, hkB false y hy]
      simp only [Function.comp, hxy]
    simp only [Function.comp, ek, e]

/-- Thm 7.1.13(a): if `M₀ ≺⁺ Mₙ` (`n = 1, 2`), then `M₁, M₂` are isomorphic over `M₀`. -/
theorem thm_7_1_13_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h₁ : s.ltPlus lam M₀ M₁) (h₂ : s.ltPlus lam M₀ M₂) :
    ∃ f, IsoOn f M₁ M₂ ∧ Over f M₁ M₂ M₀.carrier := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k₀, k₁, A₁, B₁, C₁, E₁, w₁⟩ := h₁
  obtain ⟨-, k₂, A₂, B₂, C₂, E₂, w₂⟩ := h₂
  obtain ⟨a0, ha0, -⟩ := w₁.2.2.2.2.1.2.1 0 (Cardinal.lt_ord.2 (by
    rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam)))
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (w₁.1.2.2 a0 (w₁.2.2.2.2.1.1 ha0))
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨A, B, C, ε₀, hw, -, -, -, -⟩ := Frame.uq_common hc hinf
    (M := fun n => cond n M₁ M₂) (A' := fun n => cond n A₁ A₂) (B' := fun n => cond n B₁ B₂)
    (C' := fun n => cond n C₁ C₂) (E' := fun n => cond n E₁ E₂)
    (by intro n; cases n; exacts [w₂, w₁]) (ClubL.gt hinf hκl.bot_lt)
  have kA0 : A 0 ∈ s.S.Kc lam := (hw true).1.2.2 0 hκl.bot_lt
  have kB : ∀ n, B n 0 ∈ s.S.Kc lam := fun n => (hw n).2.1.2.2 0 hκl.bot_lt
  have lb : ∀ n, s.S.le (A 0) (B n 0) := fun n => ((hw n).2.2.2.2.2.2.2.1 0 hκl.bot_lt).1
  obtain ⟨k, N₅, k5, l5, em, kid⟩ := hS.amalg_along hU hc.ax1b kA0 (kB false) (kB true) (lb false)
    (IsEmb.of_le hS (lb true))
  let g : Bool → U → U := fun n => cond n id k
  obtain ⟨f, h1, h2, -⟩ := Frame.uq_finish hU hs hinf (M := fun n => cond n M₁ M₂) k₀
    (by intro n; cases n; exacts [k₂, k₁]) hw k5 (g := g)
    (by intro n; cases n
        · exact em
        · simpa [g] using (IsEmb.of_le hS l5))
    (by intro n x hx; cases n
        · exact kid x hx
        · rfl)
  exact ⟨f, h1, h2⟩

/-- Thm 7.1.13(b): if `M₀ ≺⁺ Mₙ`, `a₁ ∈ M₁`, `a₂ ∈ M₂` and `tp(a₁, N, M₁) = tp(a₂, N, M₂)` for
every `N ∈ K_λ` with `N ≼ M₀`, then there is an isomorphism `f : M₁ → M₂` over `M₀` with
`f(a₁) = a₂`. -/
theorem thm_7_1_13_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h₁ : s.ltPlus lam M₀ M₁) (h₂ : s.ltPlus lam M₀ M₂) (a₁ a₂ : U)
    (ha₁ : a₁ ∈ M₁.carrier) (ha₂ : a₂ ∈ M₂.carrier)
    (htp : ∀ N ∈ s.S.Kc lam, s.S.le N M₀ → tp s.S lam a₁ N M₁ = tp s.S lam a₂ N M₂) :
    ∃ f, IsoOn f M₁ M₂ ∧ Over f M₁ M₂ M₀.carrier ∧ f a₁ = a₂ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k₀, k₁, A₁, B₁, C₁, E₁, w₁⟩ := h₁
  obtain ⟨-, k₂, A₂, B₂, C₂, E₂, w₂⟩ := h₂
  obtain ⟨a0, ha0, -⟩ := w₁.2.2.2.2.1.2.1 0 (Cardinal.lt_ord.2 (by
    rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam)))
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (w₁.1.2.2 a0 (w₁.2.2.2.2.1.1 ha0))
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hb1 := w₁.filt.2
  have hb2 := w₂.filt.2
  have m1 : a₁ ∈ ⋃ β ∈ Iio (Order.succ lam).ord, (B₁ β).carrier := hb1.2.2.2.1 ▸ ha₁
  have m2 : a₂ ∈ ⋃ β ∈ Iio (Order.succ lam).ord, (B₂ β).carrier := hb2.2.2.2.1 ▸ ha₂
  simp only [mem_iUnion, exists_prop] at m1 m2
  obtain ⟨α₁, hα₁, ma₁⟩ := m1
  obtain ⟨α₂, hα₂, ma₂⟩ := m2
  obtain ⟨A, B, C, ε₀, hw, hε, hεκ, -, hB0⟩ := Frame.uq_common hc hinf
    (M := fun n => cond n M₁ M₂) (A' := fun n => cond n A₁ A₂) (B' := fun n => cond n B₁ B₂)
    (C' := fun n => cond n C₁ C₂) (E' := fun n => cond n E₁ E₂)
    (by intro n; cases n; exacts [w₂, w₁]) (ClubL.gt hinf (max_lt hα₁ hα₂))
  have kA0 : A 0 ∈ s.S.Kc lam := (hw true).1.2.2 0 hκl.bot_lt
  have kB : ∀ n, B n 0 ∈ s.S.Kc lam := fun n => (hw n).2.1.2.2 0 hκl.bot_lt
  have lb : ∀ n, s.S.le (A 0) (B n 0) := fun n => ((hw n).2.2.2.2.2.2.2.1 0 hκl.bot_lt).1
  have hgt : max α₁ α₂ < ε₀ := hε
  have a1B : a₁ ∈ (B true 0).carrier := by
    rw [hB0 true]
    exact hS.sub (hb1.1 α₁ hα₁ ε₀ hεκ ((le_max_left _ _).trans_lt hgt)) ma₁
  have a2B : a₂ ∈ (B false 0).carrier := by
    rw [hB0 false]
    exact hS.sub (hb2.1 α₂ hα₂ ε₀ hεκ ((le_max_right _ _).trans_lt hgt)) ma₂
  have lBM : ∀ n, s.S.le (B n 0) (cond n M₁ M₂) := fun n => (hw n).filt.2.le hS hinf hκl.bot_lt
  have lAM : s.S.le (A 0) M₀ := (hw true).filt.1.le hS hinf hκl.bot_lt
  have e1 := tp_eq_of_le (lam := lam) hS (M := A 0) (N := M₁) (W := B true 0) (a := a₁)
    ⟨kA0.1, k₁.1, hS.trans (lb true) (lBM true), ha₁⟩ (lBM true) (lb true) a1B
  have e2 := tp_eq_of_le (lam := lam) hS (M := A 0) (N := M₂) (W := B false 0) (a := a₂)
    ⟨kA0.1, k₂.1, hS.trans (lb false) (lBM false), ha₂⟩ (lBM false) (lb false) a2B
  obtain ⟨N₂, kN₂, l, f, emf, ov, fa⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf (M := A 0)
    (N := B true 0) (N' := B false 0) (a := a₁) (a' := a₂) ⟨kA0, kB true, lb true, a1B⟩
    ⟨kA0, kB false, lb false, a2B⟩ (by rw [e1, e2]; exact htp _ kA0 lAM)
  let g : Bool → U → U := fun n => cond n f id
  obtain ⟨f', h1, h2, h3⟩ := Frame.uq_finish hU hs hinf (M := fun n => cond n M₁ M₂) k₀
    (by intro n; cases n; exacts [k₂, k₁]) hw kN₂ (g := g)
    (by intro n; cases n
        · simpa [g] using IsEmb.of_le hS l
        · exact emf)
    (by intro n x hx; cases n
        · rfl
        · exact ov.2 x hx)
  exact ⟨f', h1, h2, h3 a₁ a1B a₂ a2B fa⟩

/-- Thm 7.1.13(c): if `M₀ ≺⁺ Mₙ`, `N* ∈ K_λ`, `N₀ ≼ N*` and `NF^(N₀, N*, M₀, Mₙ)` (`n = 1, 2`),
then there is an isomorphism `f : M₁ → M₂` over `M₀ ∪ N*`. -/
theorem thm_7_1_13_c [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ M₂ N₀ Ns : Model U L) (h₁ : s.ltPlus lam M₀ M₁) (h₂ : s.ltPlus lam M₀ M₂)
    (hNs : Ns ∈ s.S.Kc lam) (h0s : s.S.le N₀ Ns) (hn₁ : s.NFhat lam N₀ Ns M₀ M₁)
    (hn₂ : s.NFhat lam N₀ Ns M₀ M₂) :
    ∃ f, IsoOn f M₁ M₂ ∧ Over f M₁ M₂ (M₀.carrier ∪ Ns.carrier) := by
  classical
  have hs' : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hNs
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨k₀, k₁, A₁, B₁, C₁, E₁, w₁⟩ := h₁
  obtain ⟨-, k₂, A₂, B₂, C₂, E₂, w₂⟩ := h₂
  obtain ⟨-, -, -, -, Aa, Ba, Ai, Ac, Bi, Bc, hst, a0, b0, ua, ub⟩ := hn₁
  obtain ⟨-, -, -, -, Aa', Ba', Ai', Ac', Bi', Bc', hst', a0', b0', ua', ub'⟩ := hn₂
  obtain ⟨fA, fB⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst ua ub
  obtain ⟨fA', fB'⟩ := Frame.nfhat_filt Ai' Ac' Bi' Bc' hst' ua' ub'
  obtain ⟨E₃, hE₃, e3⟩ := IsFilt.agree hS hinf fA w₁.filt.1
  obtain ⟨E₄, hE₄, e4⟩ := IsFilt.agree hS hinf fB w₁.filt.2
  obtain ⟨E₅, hE₅, e5⟩ := IsFilt.agree hS hinf fA' w₂.filt.1
  obtain ⟨E₆, hE₆, e6⟩ := IsFilt.agree hS hinf fB' w₂.filt.2
  obtain ⟨A, B, C, ε₀, hw, hε, hεκ, hA0, hB0⟩ := Frame.uq_common hc hinf
    (M := fun n => cond n M₁ M₂) (A' := fun n => cond n A₁ A₂) (B' := fun n => cond n B₁ B₂)
    (C' := fun n => cond n C₁ C₂) (E' := fun n => cond n E₁ E₂)
    (by intro n; cases n; exacts [w₂, w₁])
    (ClubL.inter hinf (ClubL.inter hinf hE₃ hE₄) (ClubL.inter hinf hE₅ hE₆))
  obtain ⟨h1lt, ⟨-, m3, m4⟩, -, m5, m6⟩ := hε
  have hpos : (0 : Ordinal.{u}) < ε₀ := lt_trans zero_lt_one h1lt
  have n1 : s.NF lam N₀ Ns (A 0) (B true 0) := by
    have h := Frame.nf_interval hU hs' Ai Ac Bi Bc hst hpos hεκ
    rw [a0, b0, e3 _ m3 hεκ, e4 _ m4 hεκ] at h
    rw [hA0 true, hB0 true]; exact h
  have n2 : s.NF lam N₀ Ns (A 0) (B false 0) := by
    have h := Frame.nf_interval hU hs' Ai' Ac' Bi' Bc' hst' hpos hεκ
    rw [a0', b0', e5 _ m5 hεκ, e6 _ m6 hεκ] at h
    rw [hA0 false, hB0 false]; exact h
  obtain ⟨W, ft, ff, kW, em1, em2, o1, o2⟩ := thm_5_4_7 lam hU s hs' N₀ Ns (A 0) (B true 0)
    (B false 0) n1 n2
  obtain ⟨-, -, -, -, -, l1, -, -, -⟩ := id n1
  obtain ⟨-, -, -, -, -, l2, -, -, -⟩ := id n2
  let g : Bool → U → U := fun n => cond n ft ff
  obtain ⟨f', h1, h2, h3⟩ := Frame.uq_finish hU hs hinf (M := fun n => cond n M₁ M₂) k₀
    (by intro n; cases n; exacts [k₂, k₁]) hw kW (g := g)
    (by intro n; cases n
        · exact em2
        · exact em1)
    (by intro n x hx; cases n
        · exact o2.2 x (Or.inr hx)
        · exact o1.2 x (Or.inr hx))
  have lBM : ∀ n, s.S.le (B n 0) (cond n M₁ M₂) := fun n => (hw n).filt.2.le hS hinf hκl.bot_lt
  have hNB : ∀ n, Ns.carrier ⊆ (B n 0).carrier := fun n x hx => by
    cases n
    · exact hS.sub l2 hx
    · exact hS.sub l1 hx
  refine ⟨f', h1, ⟨Set.union_subset h2.1 fun x hx =>
    ⟨hS.sub (lBM true) (hNB true hx), hS.sub (lBM false) (hNB false hx)⟩, fun x hx => ?_⟩⟩
  rcases hx with hx | hx
  · exact h2.2 x hx
  · exact h3 x (hNB true hx) x (hNB false hx) (by
      show ft x = ff x
      rw [o1.2 x (Or.inl hx), o2.2 x (Or.inl hx)])

/-- AUX: not in paper. Saturation is preserved by isomorphisms. -/
theorem Saturated.iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (hinf : ℵ₀ ≤ lam) {M M' : Model U L} {f : U → U} (hM : Saturated s.S lam M) (hf : IsoOn f M M') :
    Saturated s.S lam M' := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨kM, hfull⟩ := hM
  have kM' : M' ∈ s.S.Kc (Order.succ lam) := ⟨hS.iso_mem kM.1 hf, by rw [hf.card_eq]; exact kM.2⟩
  obtain ⟨f', hf', f1, f2⟩ := hf.exists_inv
  refine ⟨kM', fun N' kN' lN' => ⟨lN', ?_⟩⟩
  rintro p ⟨W, b, hK, rfl⟩
  obtain ⟨-, N, hN, lNM⟩ := hS.iso N' M' M f' kM'.1 lN' hf'
  have kN : N ∈ s.S.Kc lam := ⟨hS.mem_left lNM, by rw [hN.card_eq]; exact kN'.2⟩
  obtain ⟨W₁, kW₁, lN'W₁, lW₁W, hb, e1⟩ := hS.exists_small_tp hc.ax0b hinf kN' hK
  have hsm : ∀ {X : Model U L}, X ∈ s.S.Kc lam → #(∅ ∪ X.carrier : Set U) < #U := fun {X} hX => by
    rw [Set.empty_union]
    have : #X.carrier = lam := hX.2
    rw [this]; exact hU.2
  obtain ⟨r, W', hr, hrid, lNW', memW', -⟩ := hS.rename hU.infinite ∅ lN'W₁ hN (hsm kN)
  have kW' : W' ∈ s.S.Kc lam := ⟨memW', by rw [hr.card_eq]; exact kW₁.2⟩
  have hrb : r b ∈ W'.carrier := hr.mapsTo hb
  obtain ⟨a, ha, hat⟩ := (hfull N kN lNM).2 _ ⟨W', r b, ⟨kN.1, memW', lNW', hrb⟩, rfl⟩
  obtain ⟨M₁, kM₁, lNM₁, lM₁M, haM₁, e2⟩ := hS.exists_small_tp hc.ax0b hinf kN
    (show (N, M, a) ∈ s.S.K3 from ⟨kN.1, kM.1, lNM, ha⟩)
  obtain ⟨N₂, kN₂, lW'N₂, u, hu, huo, hua⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf
    (M := N) (N := M₁) (N' := W') (a := a) (a' := r b) ⟨kN, kM₁, lNM₁, haM₁⟩
    ⟨kN, kW', lNW', hrb⟩ (e2.trans hat)
  obtain ⟨-, -, Q, lQ, iQ⟩ := id hu
  obtain ⟨ui, hui, ui1, ui2⟩ := iQ.exists_inv
  obtain ⟨P', hP'⟩ := exists_isoOn (hf.injOn.mono (hS.sub lM₁M))
  have lP'M' : s.S.le P' M' := hS.iso_le lM₁M hf hP'
  have kP' : P' ∈ s.S.Kc lam := ⟨hS.mem_left lP'M', by rw [hP'.card_eq]; exact kM₁.2⟩
  obtain ⟨t, N₃, ht, htid, lP'N₃, memN₃, -⟩ := hS.rename hU.infinite ∅ lQ (hui.comp hP') (hsm kP')
  have hb' : (N', W₁, b) ∈ s.S.K3 := ⟨kN'.1, kW₁.1, lN'W₁, hb⟩
  have hu_x : ∀ x ∈ N.carrier, u x = x := huo.2
  have ht_on : ∀ y ∈ M₁.carrier, t (u y) = f y := fun y hy => by
    rw [htid _ (iQ.mapsTo hy)]
    simp only [Function.comp, ui1 y hy]
  have hk : IsEmb s.S (t ∘ r) W₁ N₃ := by
    have e : IsEmb s.S (t ∘ (id ∘ r)) W₁ N₃ :=
      ((IsEmb.iso_comp hr kW₁.1 (IsEmb.of_le hS lW'N₂)).comp_iso hS ht)
    exact e
  have hkov : ∀ x ∈ N'.carrier, (t ∘ r) x = x := fun x hx => by
    have hxW := hS.sub lN'W₁ hx
    have e1' : r x = f' x := hrid x hx
    have hxN : f' x ∈ N.carrier := hN.mapsTo hx
    have hxM₁ := hS.sub lNM₁ hxN
    simp only [Function.comp, e1']
    have := ht_on _ hxM₁
    rw [hu_x _ hxN] at this
    rw [this]
    exact f2 x (hS.sub lN' hx)
  have lN'P' : s.S.le N' P' := hS.le_of_sub lN' lP'M' (fun x hx => by
    have hx1 : f' x ∈ M₁.carrier := hS.sub lNM₁ (hN.mapsTo hx)
    have := hP'.mapsTo hx1
    rwa [f2 x (hS.sub lN' hx)] at this)
  have lN'N₃ : s.S.le N' N₃ := hS.trans lN'P' lP'N₃
  have e3 := tp_emb hS (lam := lam) hb' lN'N₃ hk hkov
  have hka : (t ∘ r) b = f a := by
    simp only [Function.comp, ← hua, ht_on a haM₁]
  have haP' : f a ∈ P'.carrier := hP'.mapsTo haM₁
  have e4 : tp s.S lam (f a) N' P' = tp s.S lam (f a) N' M' :=
    tp_eq_of_le hS ⟨kN'.1, kM'.1, lN', hS.sub lP'M' haP'⟩ lP'M' lN'P' haP'
  have e5 : tp s.S lam (f a) N' P' = tp s.S lam (f a) N' N₃ :=
    tp_eq_of_le hS ⟨kN'.1, memN₃, lN'N₃, hS.sub lP'N₃ haP'⟩ lP'N₃ lN'P' haP'
  rw [hka] at e3
  refine ⟨f a, hf.mapsTo ha, ?_⟩
  rw [← e4, e5, ← e3, e1]

/-- AUX: not in paper. `ERel` on a triple outside `K³` is equality. -/
theorem ERel.eq_of_not_K3 {S : KSys U L} {lam : Cardinal.{u}} {t t' : Tri U L}
    (h : ERel S lam t t') : t ∉ S.K3 → t = t' := by
  induction h with
  | rel x y hxy => exact fun hx => absurd hxy.1 hx
  | refl x => exact fun _ => rfl
  | symm x y h ih =>
    intro hy
    have hx : x ∉ S.K3 := fun hx => hy ((ERel.K3_iff h).1 hx)
    exact (ih hx).symm
  | trans x y z h1 h2 ih1 ih2 =>
    intro hx
    have e := ih1 hx
    subst e
    exact ih2 hx

/-- AUX: not in paper. The amalgam used for Cor 7.1.17(a). -/
theorem Frame.nf_amalg [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {M₀ M₁ M₂ : Model U L} (k₁ : M₁ ∈ s.S.Kc (Order.succ lam))
    (k₂ : M₂ ∈ s.S.Kc (Order.succ lam)) (h01 : s.leNF lam M₀ M₁) (h02 : s.leNF lam M₀ M₂) :
    ∃ (f : U → U) (P M₃ : Model U L), IsoOn f M₁ P ∧ s.leNF lam P M₃ ∧ s.leNF lam M₂ M₃ ∧
      (∀ x ∈ M₀.carrier, f x = x) ∧ M₀.carrier ⊆ M₃.carrier ∧ M₃ ∈ s.Ksat lam := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  obtain ⟨M₁', h1⟩ := prop_7_1_12_a lam hU s hs hinf M₁ k₁
  obtain ⟨M₂', h2⟩ := prop_7_1_12_a lam hU s hs hinf M₂ k₂
  obtain ⟨f, hf, hov⟩ := thm_7_1_13_a lam hU s hs M₀ M₁' M₂'
    (prop_7_1_10_c lam hU s hs M₀ M₁ M₁' h01 h1) (prop_7_1_10_c lam hU s hs M₀ M₂ M₂' h02 h2)
  obtain ⟨-, P, hP, lP⟩ := Frame.leNF_iso hU hs M₁ M₁' M₂' f h1.2.1
    (prop_7_1_10_a lam hU s hs M₁ M₁' h1).1 hf
  exact ⟨f, P, M₂', hP, lP, (prop_7_1_10_a lam hU s hs M₂ M₂' h2).1,
    fun x hx => hov.2 x hx, fun x hx => (hov.1 hx).2, prop_7_1_10_b lam hU s hs M₂ M₂' h2⟩

/-- Cor 7.1.17(a): `(K_{λ⁺}, ≼^NF)` satisfies the amalgamation property; so does
`(K^sat, ≼^NF ↾ K^sat)`. -/
theorem cor_7_1_17_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam) :
    AP (s.nfKSys lam) (Order.succ lam) ∧ AP (s.satKSys lam) (Order.succ lam) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinfOf : ∀ {M₀ M₁ : Model U L}, s.leNF lam M₀ M₁ → ℵ₀ ≤ lam := fun h => by
    obtain ⟨-, -, -, W, hW, -⟩ := h
    exact Frame.aleph0_le hc hW
  have hsub : ∀ {M N : Model U L}, s.leNF lam M N → M.carrier ⊆ N.carrier :=
    fun h => hS.sub h.2.2.1
  constructor
  · intro M₀ _ M₁ k₁ M₂ k₂ h01 h02
    obtain ⟨f, P, M₃, hP, lP, l2, hfix, h0, hsat⟩ :=
      Frame.nf_amalg lam hU s hs (hinfOf h01) k₁.1 k₂.1 h01 h02
    have hk₃ : M₃ ∈ s.S.Kc (Order.succ lam) := hsat.1
    refine ⟨f, id, M₃, ⟨⟨k₁.1, hk₃, P, lP, hP⟩, ⟨k₂.1, hk₃, M₂, l2, IsoOn.refl M₂⟩,
      ⟨fun x hx => ⟨hsub h01 hx, h0 hx⟩, hfix⟩, ⟨fun x hx => ⟨hsub h02 hx, h0 hx⟩, fun _ _ => rfl⟩⟩,
      hk₃, hk₃.2⟩
  · intro M₀ _ M₁ k₁ M₂ k₂ h01 h02
    have hinf := hinfOf h01.2.2
    obtain ⟨f, P, M₃, hP, lP, l2, hfix, h0, hsat⟩ :=
      Frame.nf_amalg lam hU s hs hinf k₁.1.1 k₂.1.1 h01.2.2 h02.2.2
    have hPs : P ∈ s.Ksat lam := Saturated.iso hU hc hinf k₁.1 hP
    refine ⟨f, id, M₃, ⟨⟨k₁.1, hsat, P, ⟨hPs, hsat, lP⟩, hP⟩,
      ⟨k₂.1, hsat, M₂, ⟨k₂.1, hsat, l2⟩, IsoOn.refl M₂⟩,
      ⟨fun x hx => ⟨hsub h01.2.2 hx, h0 hx⟩, hfix⟩, ⟨fun x hx => ⟨hsub h02.2.2 hx, h0 hx⟩, fun _ _ => rfl⟩⟩,
      hsat, hsat.1.2⟩

/-- Cor 7.1.17(b), tameness: for `M₀ ≼^NF M₁`, `M₀ ≼^NF M₂` in `K_{λ⁺}`, if
`tp(a₁, N, M₁) = tp(a₂, N, M₂)` for every `N ∈ K_λ` with `N ≼ M₀`, then
`tp(a₁, M₀, M₁) = tp(a₂, M₀, M₂)`. -/
theorem cor_7_1_17_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam))
    (h₂ : M₂ ∈ s.S.Kc (Order.succ lam)) (h01 : s.leNF lam M₀ M₁) (h02 : s.leNF lam M₀ M₂)
    (a₁ a₂ : U) (htp : ∀ N ∈ s.S.Kc lam, s.S.le N M₀ → tp s.S lam a₁ N M₁ = tp s.S lam a₂ N M₂) :
    tp s.S lam a₁ M₀ M₁ = tp s.S lam a₂ M₀ M₂ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := by
    obtain ⟨-, -, -, W, hW, -⟩ := h01
    exact Frame.aleph0_le hc hW
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf h₀
  have kR := hR.2.2.1 0 hκl.bot_lt
  have lR := hR.le hS hinf hκl.bot_lt
  have l1 := h01.2.2.1
  have l2 := h02.2.2.1
  have hE := tp_eq_iff.1 (htp _ kR lR)
  by_cases ha₁ : a₁ ∈ M₁.carrier
  swap
  · have hn : ((R 0, M₁, a₁) : Tri U L) ∉ s.S.K3 := fun h => ha₁ h.2.2.2
    have e := ERel.eq_of_not_K3 hE hn
    simp only [Prod.mk.injEq, true_and] at e
    rw [e.1, e.2]
  have ha₂ : a₂ ∈ M₂.carrier :=
    ((ERel.K3_iff hE).1 ⟨kR.1, h₁.1, hS.trans lR l1, ha₁⟩).2.2.2
  obtain ⟨M₁', p1⟩ := prop_7_1_12_a lam hU s hs hinf M₁ h₁
  obtain ⟨M₂', p2⟩ := prop_7_1_12_a lam hU s hs hinf M₂ h₂
  have l1' := (prop_7_1_10_a lam hU s hs M₁ M₁' p1).1.2.2.1
  have l2' := (prop_7_1_10_a lam hU s hs M₂ M₂' p2).1.2.2.1
  have up : ∀ {X X' : Model U L} {a : U} {N : Model U L}, s.S.le X X' → a ∈ X.carrier → N ∈ s.S.K →
      s.S.le N X → tp s.S lam a N X = tp s.S lam a N X' := fun {X X' a N} hl ha hN hNX =>
    tp_eq_of_le hS ⟨hN, hS.mem_right hl, hS.trans hNX hl, hS.sub hl ha⟩ hl hNX ha
  obtain ⟨f, hf, hov, hfa⟩ := thm_7_1_13_b lam hU s hs M₀ M₁' M₂'
    (prop_7_1_10_c lam hU s hs M₀ M₁ M₁' h01 p1) (prop_7_1_10_c lam hU s hs M₀ M₂ M₂' h02 p2) a₁ a₂
    (hS.sub l1' ha₁) (hS.sub l2' ha₂) (fun N kN lN => by
      rw [← up l1' ha₁ kN.1 (hS.trans lN l1), ← up l2' ha₂ kN.1 (hS.trans lN l2)]
      exact htp N kN lN)
  have hemb : IsEmb s.S f M₁' M₂' := ⟨hS.mem_right l1', hS.mem_right l2', M₂', hS.refl (hS.mem_right l2'), hf⟩
  have := tp_emb hS (lam := lam) (f := f) (a := a₁) (M := M₀) (N := M₁') (N' := M₂')
    ⟨h₀.1, hS.mem_right l1', hS.trans l1 l1', hS.sub l1' ha₁⟩ (hS.trans l2 l2') hemb hov.2
  rw [hfa] at this
  rw [up l1' ha₁ h₀.1 l1, this, ← up l2' ha₂ h₀.1 l2]

-- AGENT-CHOICE (reading): "does not fork over N₀" for a type over `M₀ ∈ K_{λ⁺}` is read in the
-- sense of Def 2.6.2 (`NotForkGe`).
/-- Cor 7.1.17(c): for `M₀ ≼^NF M₁`, `M₀ ≼^NF M₂` in `K_{λ⁺}`, if for some `N₀ ∈ K_λ` both
`tp(aₙ, M₀, Mₙ)` do not fork over `N₀` and `tp(a₁, N₀, M₁) = tp(a₂, N₀, M₂)`, then
`tp(a₁, M₀, M₁) = tp(a₂, M₀, M₂)`. -/
theorem cor_7_1_17_c [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam))
    (h₂ : M₂ ∈ s.S.Kc (Order.succ lam)) (h01 : s.leNF lam M₀ M₁) (h02 : s.leNF lam M₀ M₂)
    (a₁ a₂ : U)
    (hN : ∃ N₀ ∈ s.S.Kc lam, s.NotForkGe lam N₀ M₀ (tp s.S lam a₁ M₀ M₁) ∧
      s.NotForkGe lam N₀ M₀ (tp s.S lam a₂ M₀ M₂) ∧ tp s.S lam a₁ N₀ M₁ = tp s.S lam a₂ N₀ M₂) :
    tp s.S lam a₁ M₀ M₁ = tp s.S lam a₂ M₀ M₂ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨N₀, kN₀, hf1, hf2, hEq⟩ := hN
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc kN₀
  have l1 := h01.2.2.1
  have l2 := h02.2.2.1
  have hN₀ge : N₀ ∈ s.S.KGe lam := ⟨kN₀.1, le_of_eq kN₀.2.symm⟩
  have hM₀ge : M₀ ∈ s.S.KGe lam := ⟨h₀.1, by rw [h₀.2]; exact Order.le_succ lam⟩
  have lN₀ : s.S.le N₀ M₀ := hf1.2.2.1
  obtain ⟨-, -, -, -, -, ha₁, R₁, -, lR₁, H₁⟩ := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a
    hc.ax3b N₀ M₀ hN₀ge hM₀ge lN₀ _ hf1.2.2.2.1).1 hf1 M₁ a₁ (mem_tp_self _ _ _ _ _)
  obtain ⟨-, -, -, -, -, ha₂, R₂, -, lR₂, H₂⟩ := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a
    hc.ax3b N₀ M₀ hN₀ge hM₀ge lN₀ _ hf2.2.2.2.1).1 hf2 M₂ a₂ (mem_tp_self _ _ _ _ _)
  refine cor_7_1_17_b lam hU s hs M₀ M₁ M₂ h₀ h₁ h₂ h01 h02 a₁ a₂ fun N kN lN => ?_
  have hL : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hc.ax0b
  obtain ⟨W, hW, hAW, hWM, hcard⟩ := hL M₀ h₀.1 (N.carrier ∪ N₀.carrier)
    (Set.union_subset (hS.sub lN) (hS.sub lN₀))
  have kW : W ∈ s.S.Kc lam := by
    refine ⟨hW, le_antisymm (hcard.trans (Cardinal.add_le_of_le hinf le_rfl
      (card_union_le kN kN₀ hinf))) ?_⟩
    rw [← kN.2]; exact Model.card_le_of_sub (Set.subset_union_left.trans hAW)
  have lNW : s.S.le N W := hS.le_of_sub lN hWM (Set.subset_union_left.trans hAW)
  have lN₀W : s.S.le N₀ W := hS.le_of_sub lN₀ hWM (Set.subset_union_right.trans hAW)
  obtain ⟨W₁, kW₁, s1, lW₁⟩ := hS.exists_small hc.ax0b hinf kW h₁.1 ((hS.sub hWM).trans (hS.sub l1)) ha₁.1
  obtain ⟨W₂, kW₂, s2, lW₂⟩ := hS.exists_small hc.ax0b hinf kW h₂.1 ((hS.sub hWM).trans (hS.sub l2)) ha₂.1
  have Rsub : ∀ {R : Model U L}, s.S.le R N₀ → R.carrier ⊆ W.carrier := fun hl =>
    (hS.sub hl).trans (hS.sub lN₀W)
  have nf1 := Frame.nf_mono hS hc.ax3a hc.ax3b (H₁ W kW (Rsub lR₁) hWM W₁ kW₁ s1 lW₁) lR₁ lN₀W (hS.refl kW.1)
  have nf2 := Frame.nf_mono hS hc.ax3a hc.ax3b (H₂ W kW (Rsub lR₂) hWM W₂ kW₂ s2 lW₂) lR₂ lN₀W (hS.refl kW.1)
  have F1 := hc.ax3a.1 _ _ _ _ nf1
  have F2 := hc.ax3a.1 _ _ _ _ nf2
  have a1W : a₁ ∈ W₁.carrier := s1 (Or.inr rfl)
  have a2W : a₂ ∈ W₂.carrier := s2 (Or.inr rfl)
  have lWW₁ : s.S.le W W₁ := F1.2.2.2.2.2.1
  have lWW₂ : s.S.le W W₂ := F2.2.2.2.2.2.1
  have eN₀1 := tp_eq_of_le (lam := lam) hS (M := N₀) (N := M₁) (W := W₁) (a := a₁)
    ⟨kN₀.1, h₁.1, hS.trans lN₀ l1, ha₁.1⟩ lW₁ (hS.trans lN₀W lWW₁) a1W
  have eN₀2 := tp_eq_of_le (lam := lam) hS (M := N₀) (N := M₂) (W := W₂) (a := a₂)
    ⟨kN₀.1, h₂.1, hS.trans lN₀ l2, ha₂.1⟩ lW₂ (hS.trans lN₀W lWW₂) a2W
  have hW12 : tp s.S lam a₁ W W₁ = tp s.S lam a₂ W W₂ :=
    hc.ax3d N₀ kN₀ W kW lN₀W _ F1.2.2.2.2.2.2.2 _ F2.2.2.2.2.2.2.2 ⟨a₁, W₁, rfl, nf1⟩ ⟨a₂, W₂, rfl, nf2⟩
      (by rw [res_tp hS lN₀W, res_tp hS lN₀W, eN₀1, eN₀2]; exact hEq)
  have e := congrArg (fun p => res s.S lam p N) hW12
  simp only [res_tp hS lNW] at e
  have eN1 := tp_eq_of_le (lam := lam) hS (M := N) (N := M₁) (W := W₁) (a := a₁)
    ⟨kN.1, h₁.1, hS.trans lN l1, ha₁.1⟩ lW₁ (hS.trans lNW lWW₁) a1W
  have eN2 := tp_eq_of_le (lam := lam) hS (M := N) (N := M₂) (W := W₂) (a := a₂)
    ⟨kN.1, h₂.1, hS.trans lN l2, ha₂.1⟩ lW₂ (hS.trans lNW lWW₂) a2W
  rw [← eN1, ← eN2]; exact e

/-- AUX: not in paper. A continuous cofinal sequence of length `cf δ` in a limit `δ < λ^{+2}`. -/
theorem exists_cof_seq {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {δ : Ordinal.{u}}
    (hδ : Order.IsSuccLimit δ) (hδc : δ.cof ≤ Order.succ lam) :
    ∃ (θ : Ordinal.{u}) (g : Ordinal.{u} → Ordinal.{u}), Order.IsSuccLimit θ ∧
      θ ≤ (Order.succ lam).ord ∧ (∀ i < θ, g i < δ) ∧ (∀ a b, a < b → b < θ → g a < g b) ∧ g 0 = 0 ∧
      (∀ ξ < δ, ∃ i < θ, ξ < g i) ∧ (∀ i < θ, Order.IsSuccLimit i → ∀ ξ < g i, ∃ j < i, ξ < g j) ∧
      (∀ i < θ, Order.IsSuccLimit i → Order.IsSuccLimit (g i)) ∧ θ = δ.cof.ord := by
  obtain ⟨θ, hθdef⟩ : ∃ θ, δ.cof.ord = θ := ⟨_, rfl⟩
  obtain ⟨f, hf⟩ := Ordinal.exists_isFundamentalSeq hθdef
  have hθ : Order.IsSuccLimit θ := by
    rw [← hθdef]
    exact Cardinal.isSuccLimit_ord (Ordinal.aleph0_le_cof_iff.2 (Ordinal.one_lt_cof_iff.2 hδ))
  have hθκ : θ ≤ (Order.succ lam).ord := by
    rw [← hθdef]
    exact Cardinal.ord_le_ord.2 hδc
  let f' : Ordinal.{u} → Ordinal.{u} := fun j => if h : j < θ then (f ⟨j, h⟩).1 else 0
  have f'lt : ∀ j < θ, f' j < δ := fun j h => by
    simp only [f', h, ↓reduceDIte]; exact (f ⟨j, h⟩).2
  have f'm : ∀ i j, i < j → j < θ → f' i < f' j := fun i j h hj => by
    have hi := lt_trans h hj
    simp only [f', hi, hj, ↓reduceDIte]
    exact hf.strictMono (show (⟨i, hi⟩ : Iio θ) < ⟨j, hj⟩ from h)
  have f'c : ∀ ξ < δ, ∃ j < θ, ξ ≤ f' j := fun ξ hξ => by
    obtain ⟨_, ⟨c, rfl⟩, hc2⟩ := hf.isCofinal_range ⟨ξ, hξ⟩
    refine ⟨c.1, c.2, ?_⟩
    have hcθ : c.1 < θ := c.2
    simp only [f', hcθ, ↓reduceDIte]
    exact hc2
  let g : Ordinal.{u} → Ordinal.{u} := fun i => ⨆ j : i.ToType, f' (Ordinal.ToType.mk.symm j).1 + 1
  have gb : ∀ i, ∀ j < i, f' j + 1 ≤ g i := fun i j h => by
    have := Ordinal.le_iSup (fun j : i.ToType => f' (Ordinal.ToType.mk.symm j).1 + 1)
      (Ordinal.ToType.mk ⟨j, h⟩)
    simp only [OrderIso.symm_apply_apply] at this
    exact this
  have gle : ∀ i a, (∀ j < i, f' j + 1 ≤ a) → g i ≤ a := fun i a h =>
    ciSup_le' fun j => h _ (Ordinal.ToType.mk.symm j).2
  have gbelow : ∀ i, ∀ ξ < g i, ∃ j < i, ξ ≤ f' j := fun i ξ hξ => by
    by_contra hno
    push Not at hno
    exact absurd hξ (not_lt.2 (gle i ξ fun j hj => Order.add_one_le_iff.2 (hno j hj)))
  have gf : ∀ i < θ, g i ≤ f' i := fun i hi =>
    gle i _ fun j hj => Order.add_one_le_iff.2 (f'm j i hj hi)
  have gδ : ∀ i < θ, g i < δ := fun i hi => lt_of_le_of_lt (gf i hi) (f'lt i hi)
  have gm : ∀ a b, a < b → b < θ → g a < g b := fun a b h hb =>
    lt_of_le_of_lt (gf a (lt_trans h hb)) (Order.add_one_le_iff.1 (gb b a h))
  have g0 : g 0 = 0 := le_antisymm (gle 0 0 fun j hj => absurd hj (not_lt.2 zero_le)) zero_le
  have gcof : ∀ ξ < δ, ∃ i < θ, ξ < g i := fun ξ hξ => by
    obtain ⟨j, hj, h⟩ := f'c ξ hξ
    exact ⟨j + 1, hθ.add_one_lt hj, lt_of_le_of_lt h
      (Order.add_one_le_iff.1 (gb _ j (Order.lt_add_one_iff.2 le_rfl)))⟩
  have gl : ∀ i < θ, Order.IsSuccLimit i → ∀ ξ < g i, ∃ j < i, ξ < g j := fun i _ hl ξ hξ => by
    obtain ⟨j, hj, h⟩ := gbelow i ξ hξ
    exact ⟨j + 1, hl.add_one_lt hj, lt_of_le_of_lt h
      (Order.add_one_le_iff.1 (gb _ j (Order.lt_add_one_iff.2 le_rfl)))⟩
  have gsl : ∀ i < θ, Order.IsSuccLimit i → Order.IsSuccLimit (g i) := fun i hi hl => by
    rcases Ordinal.zero_or_succ_or_isSuccLimit (g i) with h' | ⟨d, hd⟩ | h'
    · have := gm 0 i hl.bot_lt hi
      rw [g0, h'] at this
      exact absurd this (lt_irrefl _)
    · rw [Order.succ_eq_add_one] at hd
      obtain ⟨j, hj, h⟩ := gl i hi hl d (by rw [← hd]; exact Order.lt_add_one_iff.2 le_rfl)
      have h2 := gm j i hj hi
      rw [← hd] at h2
      exact absurd h2 (not_lt.2 (Order.add_one_le_iff.2 h))
    · exact h'
  exact ⟨θ, g, hθ, hθκ, gδ, gm, g0, gcof, gl, gsl, hθdef.symm⟩

/-- AUX: not in paper. A filtration realizing all basic types at later stages gives saturation
(Thm 2.5.8(2)). -/
theorem IsFilt.saturated {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : s.IsSemiGood lam) (hinf : ℵ₀ ≤ lam) {M : Model U L} {R : Ordinal.{u} → Model U L}
    (hR : IsFilt s.S lam M R)
    (hreal : ∀ α < (Order.succ lam).ord, ∀ p ∈ s.Sbs (R α),
      ∃ β, α < β ∧ β < (Order.succ lam).ord ∧ Realizes s.S lam (R β) (R α) p) :
    Saturated s.S lam M := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  let κ := (Order.succ lam).ord
  let M' : Ordinal.{u} → Model U L := fun α => if α < κ then R α else M
  have e1 : ∀ α, α < κ → M' α = R α := fun α h => if_pos h
  have e2 : M' κ = M := if_neg (lt_irrefl _)
  have hinc : IsIncreasing s.S.le M' (Iic κ) := by
    intro α hα β hβ hlt
    have hακ : α < κ := hlt.trans_le hβ
    rw [e1 α hακ]
    rcases (show β ≤ κ from hβ).lt_or_eq with h | h
    · rw [e1 β h]; exact hR.1 α hακ β h hlt
    · rw [h, e2]; exact hR.le hS hinf hακ
  have hcont : IsContinuous M' (Iic κ) := by
    intro β hβ hl
    have hu : ∀ α ∈ Iio β, (M' α).carrier = (R α).carrier := fun α hα => by
      rw [e1 α (lt_of_lt_of_le hα hβ)]
    rw [Set.iUnion₂_congr hu]
    rcases (show β ≤ κ from hβ).lt_or_eq with h | h
    · rw [e1 β h]; exact hR.2.1 β h hl
    · subst h; rw [e2]; exact hR.2.2.2.1
  have := (thm_2_5_8_2 lam hU s ⟨hc.ax1a, hc.ax1b, hc.ax1c, hc.ax2a, hc.ax2b, hc.ax2c, hs.2.2.2.1⟩
    ⟨hc.ax0a, hc.ax0b⟩ M' ⟨hinc, hcont, fun α hα => by rw [e1 α hα]; exact hR.2.2.1 α hα⟩
    (fun α hα p hp => by
      rw [e1 α hα] at hp ⊢
      obtain ⟨β, h1, h2, h3⟩ := hreal α hα p hp
      exact ⟨β, h1, h2, by rw [e1 β h2]; exact h3⟩)).2
  rw [e2] at this
  exact this

/-- AUX: not in paper. Case b of the proof of Thm 7.1.18(a): the column inequalities. -/
theorem Frame.sat_union_b [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {θ : Ordinal.{u}} (hθ : Order.IsSuccLimit θ)
    (hθκ : θ < (Order.succ lam).ord) {M : Ordinal.{u} → Model U L}
    (hM : IsIncreasing (s.leNF lam) M (Iio θ)) (hsat : ∀ β < θ, M β ∈ s.Ksat lam)
    (hc' : IsContinuous M (Iio θ)) {N : Model U L}
    (hN : IsUnionOf M (Iio θ) N) (hNK : N ∈ s.S.Kc (Order.succ lam)) : N ∈ s.Ksat lam := by
  classical
  have hs5 : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have h0θ : (0 : Ordinal.{u}) < θ := hθ.bot_lt
  have Mi : IsIncreasing s.S.le M (Iio θ) := fun a ha b hb h => (hM a ha b hb h).2.2.1
  have MK : ∀ β < θ, M β ∈ s.S.Kc (Order.succ lam) := fun β hβ => (hsat β hβ).1
  obtain ⟨-, Mle⟩ := hS.le_union hθ Mi hc' hN
  have hex : ∀ γ, ∃ R, (γ < θ → IsFilt s.S lam (M γ) R) ∧ (γ = θ → IsFilt s.S lam N R) := fun γ => by
    by_cases hγ : γ < θ
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf (MK γ hγ)
      exact ⟨R, fun _ => hR, fun h => absurd h hγ.ne⟩
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf hNK
      exact ⟨R, fun h => absurd h hγ, fun _ => hR⟩
  choose Rr hF hFN using hex
  have hNfilt := hFN θ rfl
  have hP : ∀ β γ, ∃ P, ClubL lam P ∧ (β < γ → γ < θ → ∀ ε ∈ P, ∀ ζ ∈ P, ε < ζ →
      ζ < (Order.succ lam).ord → s.NF lam (Rr β ε) (Rr β ζ) (Rr γ ε) (Rr γ ζ)) := fun β γ => by
    by_cases hb : β < γ ∧ γ < θ
    · obtain ⟨E, hE, hn⟩ := Frame.club_of_leNF hU hs (hM β (lt_trans hb.1 hb.2) γ hb.2 hb.1)
        (hF β (lt_trans hb.1 hb.2)) (hF γ hb.2)
      exact ⟨E, hE, fun _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 => absurd ⟨h1, h2⟩ hb⟩
  choose P hPc hPn using hP
  have hL : ∀ γ, ∃ D, ClubL lam D ∧ (γ < (Order.succ lam).ord → Order.IsSuccLimit γ → γ ≤ θ →
      ∀ ε ∈ D, ε < (Order.succ lam).ord →
        (Rr γ ε).carrier = ⋃ β ∈ Iio γ, (Rr β ε).carrier) := fun γ => by
    by_cases hb : γ < (Order.succ lam).ord ∧ Order.IsSuccLimit γ ∧ γ ≤ θ
    · obtain ⟨hγ, hl, hle⟩ := hb
      rcases hle.lt_or_eq with h' | h'
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) hS hinf hγ (hF γ h')
          (fun β hβ => hF β (lt_trans hβ h')) (hc' γ h' hl)
        exact ⟨D, hD, fun _ _ _ => hn⟩
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) (T := N) hS hinf hγ (hFN γ h')
          (fun β hβ => hF β (by rw [← h']; exact hβ)) (by rw [h']; exact hN.1)
        exact ⟨D, hD, fun _ _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ hb⟩
  choose Ls hLc hLn using hL
  let C : Ordinal.{u} → Set Ordinal.{u} := fun γ =>
    if γ < (Order.succ lam).ord then
      {ε | 1 < ε ∧ ε ∈ {ε | γ < ε ∧ ∀ β < γ, ε ∈ P β γ} ∧ ε ∈ Ls γ} else Set.univ
  have hC : ∀ γ, ClubL lam (C γ) := fun γ => by
    by_cases h : γ < (Order.succ lam).ord
    · simp only [C, h, if_true]
      exact ClubL.inter hinf (ClubL.bInter hinf h fun β => hPc β γ) (hLc γ)
    · simp only [C, h, if_false]; exact ClubL.univ hinf
  let E : Set Ordinal.{u} := {ε | 1 < ε ∧ ε ∈ {ε | θ < ε ∧ ∀ γ < θ, ε ∈ C γ} ∧ ε ∈ Ls θ}
  have hE : ClubL lam E := ClubL.inter hinf (ClubL.bInter hinf hθκ hC) (hLc θ)
  have mC : ∀ ε ∈ E, ∀ γ < θ, 1 < ε ∧ (γ < ε ∧ ∀ β < γ, ε ∈ P β γ) ∧ ε ∈ Ls γ := by
    intro ε hε γ hγ
    have := hε.2.1.2 γ hγ
    simp only [C, lt_trans hγ hθκ, ite_true] at this
    exact this
  have pa : ∀ ε ∈ E, ε < (Order.succ lam).ord → ∀ β γ, β < γ → γ < θ →
      s.S.le (Rr β ε) (Rr γ ε) := by
    intro ε hε hκ β γ hb hγ
    obtain ⟨ε', h1, h2, h3⟩ := (hPc β γ).1 ε hκ
    exact (hPn β γ hb hγ ε ((mC ε hε γ hγ).2.1.2 β hb) ε' h1 h2 h3).2.2.2.2.2.2.1
  have hRN : ∀ γ ≤ θ, ∀ ξ < (Order.succ lam).ord, s.S.le (Rr γ ξ) N := by
    intro γ hγ ξ hξ
    rcases hγ.lt_or_eq with h' | h'
    · exact hS.trans ((hF γ h').le hS hinf hξ) (Mle γ h')
    · rw [h']; exact hNfilt.le hS hinf hξ
  have Rc : ∀ ξ ∈ E, ξ < (Order.succ lam).ord → ∀ b < θ, Order.IsSuccLimit b →
      (Rr b ξ).carrier = ⋃ β ∈ Iio b, (Rr β ξ).carrier := fun ξ hξ hκ b hb hl =>
    hLn b (lt_trans hb hθκ) hl hb.le ξ (mC ξ hξ b hb).2.2 hκ
  have Ug : ∀ ξ ∈ E, ξ < (Order.succ lam).ord → IsUnionOf (fun β => Rr β ξ) (Iio θ) (Rr θ ξ) := by
    intro ξ hξ hκ
    have e := hLn θ hθκ hθ le_rfl ξ hξ.2.2 hκ
    refine ⟨e, fun β hβ => ?_⟩
    refine IsSubstr.of_sub (hS.incl _ _ (hRN β (le_of_lt hβ) ξ hκ)) (hS.incl _ _ (hRN θ le_rfl ξ hκ)) ?_
    rw [e]
    exact Set.subset_biUnion_of_mem (u := fun β => (Rr β ξ).carrier) hβ
  have col : ∀ i < θ, ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (Rr i ε) (Rr θ ε) (Rr i ζ) (Rr θ ζ) := by
    intro i hi ε hε ζ hζ hlt hκ
    have hεκ := lt_trans hlt hκ
    set h := θ - i with hhdef
    have hsum : i + h = θ := Ordinal.add_sub_cancel_of_le hi.le
    have hl : Order.IsSuccLimit h := Ordinal.isSuccLimit_sub hθ.isSuccPrelimit hi
    have hin : ∀ β < h, i + β < θ := fun β hβ => by rw [← hsum]; exact (add_lt_add_iff_left i).2 hβ
    have hh : h < (Order.succ lam).ord := lt_of_le_of_lt (Ordinal.sub_le_self _ _) hθκ
    have tail : ∀ ξ ∈ E, ξ < (Order.succ lam).ord →
        IsIncreasing s.S.le (fun β => Rr (i + β) ξ) (Iio h) ∧
        IsContinuous (fun β => Rr (i + β) ξ) (Iio h) ∧ (∀ β < h, Rr (i + β) ξ ∈ s.S.Kc lam) ∧
        IsUnionOf (fun β => Rr (i + β) ξ) (Iio h) (Rr θ ξ) := by
      intro ξ hξ hκ'
      have mono : ∀ a b, a ≤ b → b < θ → (Rr a ξ).carrier ⊆ (Rr b ξ).carrier := fun a b hab hb => by
        rcases hab.lt_or_eq with h' | h'
        · exact hS.sub (pa ξ hξ hκ' a b h' hb)
        · rw [h']
      refine ⟨fun a ha b hb hab => pa ξ hξ hκ' _ _ ((add_lt_add_iff_left i).2 hab) (hin b hb),
        fun b hb hlb => ?_, fun β hβ => (hF _ (hin β hβ)).2.2.1 ξ hκ', ?_⟩
      · show (Rr (i + b) ξ).carrier = ⋃ c ∈ Iio b, (Rr (i + c) ξ).carrier
        rw [Rc ξ hξ hκ' _ (hin b hb) (Ordinal.isSuccLimit_add i hlb)]
        ext x
        simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
        constructor
        · rintro ⟨γ, hγ, hx⟩
          rcases le_or_gt i γ with hiγ | hiγ
          · refine ⟨γ - i, ?_, ?_⟩
            · rwa [Ordinal.sub_lt_of_le hiγ]
            · rw [Ordinal.add_sub_cancel_of_le hiγ]; exact hx
          · refine ⟨0, hlb.bot_lt, ?_⟩
            rw [add_zero]
            exact mono γ i hiγ.le hi hx
        · rintro ⟨c, hc1, hx⟩
          exact ⟨i + c, (add_lt_add_iff_left i).2 hc1, hx⟩
      · have U := Ug ξ hξ hκ'
        refine ⟨?_, fun β hβ => U.2 _ (hin β hβ)⟩
        rw [U.1]
        ext x
        simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
        constructor
        · rintro ⟨γ, hγ, hx⟩
          rcases le_or_gt i γ with hiγ | hiγ
          · refine ⟨γ - i, ?_, ?_⟩
            · rw [Ordinal.sub_lt_of_le hiγ, hsum]; exact hγ
            · rw [Ordinal.add_sub_cancel_of_le hiγ]; exact hx
          · refine ⟨0, hl.bot_lt, ?_⟩
            rw [add_zero]
            exact mono γ i hiγ.le hi hx
        · rintro ⟨c, hc1, hx⟩
          exact ⟨i + c, hin c hc1, hx⟩
    obtain ⟨x1, x2, x3, x4⟩ := tail ε hε hεκ
    obtain ⟨y1, y2, y3, y4⟩ := tail ζ hζ hκ
    have := Frame.nf_column (X := fun β => Rr (i + β) ε) (Y := fun β => Rr (i + β) ζ) hU hs hinf hl hh
      x1 x2 x3 y1 y2 y3 (fun β hβ => by
        have hb1 : i + β + 1 < θ := by
          have := hin (β + 1) (hl.add_one_lt hβ)
          rwa [← add_assoc] at this
        have hb2 : i + β < i + β + 1 := Order.lt_add_one_iff.2 le_rfl
        have hNF := hPn (i + β) (i + β + 1) hb2 hb1 ε ((mC ε hε _ hb1).2.1.2 _ hb2) ζ
          ((mC ζ hζ _ hb1).2.1.2 _ hb2) hlt hκ
        simpa only [add_assoc] using Frame.nf_symm hU hs5 hNF) x4 y4
    simpa only [add_zero] using this
  refine IsFilt.saturated hU hs.1 hinf hNfilt fun α hα p hp => ?_
  obtain ⟨αs, hαs, hααs, hαsκ⟩ := hE.1 α hα
  have kθ : ∀ ξ < (Order.succ lam).ord, Rr θ ξ ∈ s.S.Kc lam := fun ξ hξ => hNfilt.2.2.1 ξ hξ
  have kαs := kθ αs hαsκ
  have lαα : s.S.le (Rr θ α) (Rr θ αs) := hNfilt.1 α hα αs hαsκ hααs
  obtain ⟨ps, hps, hres⟩ : ∃ q ∈ s.Sbs (Rr θ αs), res s.S lam q (Rr θ α) = p := by
    by_cases heq : Rr θ α = Rr θ αs
    · refine ⟨p, heq ▸ hp, ?_⟩
      obtain ⟨N', b, hlt, kN', -, rfl⟩ := hc.ax2a _ (kθ α hα) hp
      exact res_tp hS (hS.refl (kθ α hα).1)
    · obtain ⟨q, hq, -, hr⟩ := hc.ax3f _ (kθ α hα) _ kαs p hp ⟨lαα, heq⟩
      exact ⟨q, hq, hr⟩
  obtain ⟨W, b, hlt, kW, hb, rfl⟩ := hc.ax2a _ kαs hps
  have Uαs := Ug αs hαs hαsκ
  have ci : IsIncreasing s.S.le (fun β => Rr β αs) (Iio θ) := fun a _ b hb' hab => pa αs hαs hαsκ a b hab hb'
  have cc : IsContinuous (fun β => Rr β αs) (Iio θ) := fun b hb' hl => Rc αs hαs hαsκ b hb' hl
  have ule := (hS.le_union hθ ci cc Uαs).2
  let Y : Ordinal.{u} → Model U L := fun β => if β ≤ θ then Rr β αs else W
  have Yl : ∀ β ≤ θ, Y β = Rr β αs := fun β h => if_pos h
  have Yt : Y (θ + 1) = W := if_neg (not_le.2 (Order.lt_add_one_iff.2 le_rfl))
  have hYk : ∀ β ≤ θ, Rr β αs ∈ s.S.Kc lam := fun β hβ => by
    rcases hβ.lt_or_eq with h | h
    · exact (hF β h).2.2.1 αs hαsκ
    · rw [h]; exact kαs
  have Yle : ∀ a ≤ θ, s.S.le (Rr a αs) (Rr θ αs) := fun a ha => by
    rcases ha.lt_or_eq with h | h
    · exact ule a h
    · rw [h]; exact hS.refl kαs.1
  have hYc : IsIncCont s.S Y (Iic (θ + 1)) (s.S.Kc lam) := by
    refine ⟨fun a ha b hb' hab => ?_, fun b hb' hl => ?_, fun β hβ => ?_⟩
    · have haθ : a ≤ θ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb')
      rw [Yl a haθ]
      rcases (show b ≤ θ + 1 from hb').lt_or_eq with h | h
      · have hbθ := Order.lt_add_one_iff.1 h
        rw [Yl b hbθ]
        rcases hbθ.lt_or_eq with h' | h'
        · exact pa αs hαs hαsκ a b hab h'
        · rw [h']; exact ule a (h' ▸ hab)
      · rw [h, Yt]; exact hS.trans (Yle a haθ) hlt.1
    · have hbθ : b ≤ θ := by
        rcases (show b ≤ θ + 1 from hb').lt_or_eq with h | h
        · exact Order.lt_add_one_iff.1 h
        · rw [h] at hl
          exact absurd (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl)) (lt_irrefl _)
      show (Y b).carrier = ⋃ c ∈ Iio b, (Y c).carrier
      rw [Yl b hbθ, Set.iUnion₂_congr (fun c (hc1 : c ∈ Iio b) =>
        by rw [Yl c ((le_of_lt hc1).trans hbθ)])]
      rcases hbθ.lt_or_eq with h | h
      · exact Rc αs hαs hαsκ b h hl
      · rw [h]; exact Uαs.1
    · rcases (show β ≤ θ + 1 from hβ).lt_or_eq with h | h
      · have := Order.lt_add_one_iff.1 h
        rw [Yl β this]; exact hYk β this
      · rw [h, Yt]; exact kW
  have hbas : tp s.S lam b (Y θ) (Y (θ + 1)) ∈ s.Sbs (Y θ) := by
    rw [Yl θ le_rfl, Yt]; exact hps
  obtain ⟨i, hi, hNFk⟩ := hs.1.2.2.2.2 θ hθ hθκ Y hYc b hbas
  rw [Yl i hi.le, Yl θ le_rfl, Yt] at hNFk
  obtain ⟨b', W', eq, -, ki, -, -, -, li, -, h1, -⟩ := hNFk.facts hc.ax3a
  have q₀def : tp s.S lam b (Rr i αs) W = res s.S lam (tp s.S lam b (Rr θ αs) W) (Rr i αs) :=
    (res_tp hS li).symm
  have hq₀ : tp s.S lam b (Rr i αs) W ∈ s.Sbs (Rr i αs) := by
    rw [q₀def, eq, res_tp hS li]; exact h1
  have lW : s.S.le (Rr i αs) W := hS.trans (ule i hi) hlt.1
  have hMi : M i ∈ s.Ksat lam := hsat i hi
  obtain ⟨a, ha, hat⟩ := (hMi.2 _ ki ((hF i hi).le hS hinf hαsκ)).2 _
    ⟨W, b, ⟨ki.1, kW.1, lW, hb.1⟩, rfl⟩
  have haU : a ∈ ⋃ β ∈ Iio (Order.succ lam).ord, (Rr i β).carrier := (hF i hi).2.2.2.1 ▸ ha
  simp only [mem_iUnion, exists_prop] at haU
  obtain ⟨β₀, hβ₀, haβ₀⟩ := haU
  obtain ⟨ζ, hζE, hgt, hζκ⟩ := hE.1 (max β₀ αs) (max_lt hβ₀ hαsκ)
  have hαζ : αs < ζ := (le_max_right _ _).trans_lt hgt
  have haζ : a ∈ (Rr i ζ).carrier :=
    (hF i hi).sub hS ((le_max_left _ _).trans hgt.le) hζκ haβ₀
  have nn := Frame.nf_symm hU hs5 (col i hi αs hαs ζ hζE hαζ hζκ)
  obtain ⟨-, kζ, -, kθζ, l1, l13, l02, l23, -⟩ := id nn
  have lRM : s.S.le (Rr i ζ) (M i) := (hF i hi).le hS hinf hζκ
  have e1 : tp s.S lam a (Rr i αs) (Rr i ζ) = tp s.S lam a (Rr i αs) (M i) :=
    tp_eq_of_le hS ⟨ki.1, hMi.1.1, hS.trans l1 lRM, ha⟩ lRM l1 haζ
  have hbasic : tp s.S lam a (Rr i αs) (Rr i ζ) ∈ s.Sbs (Rr i αs) := by rw [e1, hat]; exact hq₀
  have hNk := thm_5_4_10 lam hU s hs5 _ _ _ _ a nn hbasic
  obtain ⟨b₂, W₂, eq₂, -, -, -, -, -, -, -, -, h2⟩ := hNk.facts hc.ax3a
  have haθζ : a ∈ (Rr θ ζ).carrier := hS.sub l13 haζ
  have hps' : tp s.S lam a (Rr θ αs) (Rr θ ζ) ∈ s.Sbs (Rr θ αs) := eq₂ ▸ h2
  have heq : tp s.S lam a (Rr θ αs) (Rr θ ζ) = tp s.S lam b (Rr θ αs) W :=
    hc.ax3d _ ki _ kαs l02 _ hps' _ hps hNk hNFk (by
      rw [res_tp hS l02, res_tp hS l02, ← hat, ← e1]
      exact (tp_eq_of_le hS ⟨ki.1, kθζ.1, hS.trans l1 l13, haθζ⟩ l13 l1 haζ).symm)
  refine ⟨ζ, hααs.trans hαζ, hζκ, a, haθζ, ?_⟩
  rw [← hres, ← heq]
  exact (res_tp hS lαα).symm

/-- Thm 7.1.18(a): `(K^sat, ≼^NF ↾ K^sat)` satisfies Axiom c of AEC in `λ⁺`. -/
theorem thm_7_1_18_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam) :
    ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → δ < (plusN lam 2).ord → (s.satKSys lam).AxUnion δ := by
  classical
  intro δ hδ hδ' M hM hc'
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have h0δ : (0 : Ordinal.{u}) < δ := hδ.bot_lt
  have h1δ : (1 : Ordinal.{u}) < δ := by simpa using hδ.add_one_lt h0δ
  obtain ⟨-, -, -, -, -, W, hW, -⟩ := hM 0 h0δ 1 h1δ zero_lt_one
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hMn : IsIncreasing (s.leNF lam) M (Iio δ) := fun a ha b hb h => (hM a ha b hb h).2.2
  have hsat : ∀ β < δ, M β ∈ s.Ksat lam := fun β hβ =>
    (hM β hβ (β + 1) (hδ.add_one_lt hβ) (Order.lt_add_one_iff.2 le_rfl)).1
  obtain ⟨N, hN, hNc, hl⟩ := Frame.leNF_union hU hs hδ hδ' hMn hc'
  refine ⟨N, hN, ?_, ?_⟩
  all_goals
    obtain ⟨θ, g, hθ, hθκ, gδ, gm, g0, gcof, gl, gsl, -⟩ := exists_cof_seq hinf hδ
      ((Ordinal.cof_le_card δ).trans (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hδ')))
    have Mi : IsIncreasing s.S.le M (Iio δ) := fun a ha b hb h => (hMn a ha b hb h).2.2.1
    have hsubM : ∀ a < δ, ∀ b < δ, a ≤ b → (M a).carrier ⊆ (M b).carrier := fun a _ b hb h => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub (Mi a (lt_trans h' hb) b hb h')
      · rw [h']
    have hcm : IsContinuous (fun i => M (g i)) (Iio θ) := fun b hb hlb => by
      have hbθ : b < θ := hb
      show (M (g b)).carrier = _
      rw [hc' _ (gδ b hbθ) (gsl b hbθ hlb)]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨j, hj, h⟩ := gl b hbθ hlb ξ hξ
        have hjθ := lt_trans hj hbθ
        exact ⟨j, hj, hsubM ξ (lt_trans h (gδ j hjθ)) _ (gδ j hjθ) h.le hx⟩
      · rintro ⟨j, hj, hx⟩
        exact ⟨g j, gm j b hj hbθ, hx⟩
    have hNm : IsUnionOf (fun i => M (g i)) (Iio θ) N := ⟨by
      rw [hN.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨i, hi, h⟩ := gcof ξ hξ
        exact ⟨i, hi, hsubM ξ hξ _ (gδ i hi) h.le hx⟩
      · rintro ⟨i, hi, hx⟩
        exact ⟨g i, gδ i hi, hx⟩, fun i hi => hN.2 _ (gδ i hi)⟩
    have hMg : IsIncreasing (s.leNF lam) (fun i => M (g i)) (Iio θ) := fun a ha b hb h =>
      hMn _ (gδ a ha) _ (gδ b hb) (gm a b h hb)
    have hNsat : N ∈ s.Ksat lam := by
      rcases hθκ.lt_or_eq with hlt | heq
      · exact Frame.sat_union_b hU hs hinf hθ hlt hMg (fun β hβ => hsat _ (gδ β hβ)) hcm hNm hNc
      · refine ⟨hNc, fun N' kN' lN' => ⟨lN', fun p hp => ?_⟩⟩
        have hex : ∀ x : N'.carrier, ∃ ζ < (Order.succ lam).ord, x.1 ∈ (M (g ζ)).carrier := fun x => by
          have hx := hS.sub lN' x.2
          rw [hNm.1] at hx
          obtain ⟨ζ, hζ, h⟩ := Set.mem_iUnion₂.1 hx
          exact ⟨ζ, heq ▸ hζ, h⟩
        choose f hf hfR using hex
        have hcard : #N'.carrier ≤ lam := le_of_eq kN'.2
        have hsup : iSup f < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
          (by rw [hreg.cof_ord]; exact Order.lt_succ_iff.2 hcard) hf
        have hiθ : iSup f < θ := heq ▸ hsup
        have hsub' : N'.carrier ⊆ (M (g (iSup f))).carrier := fun x hx => by
          have h1 := hfR ⟨x, hx⟩
          have hle : f ⟨x, hx⟩ ≤ iSup f := Ordinal.le_iSup f ⟨x, hx⟩
          rcases hle.lt_or_eq with h' | h'
          · exact hsubM _ (gδ _ (lt_trans h' hiθ)) _ (gδ _ hiθ) (gm _ _ h' hiθ).le h1
          · rwa [h'] at h1
        have lMN : s.S.le (M (g (iSup f))) N := (hS.le_union hδ Mi hc' hN).2 _ (gδ _ hiθ)
        have lN'M : s.S.le N' (M (g (iSup f))) := hS.le_of_sub lN' lMN hsub'
        obtain ⟨a, ha, hat⟩ := ((hsat _ (gδ _ hiθ)).2 N' kN' lN'M).2 p hp
        refine ⟨a, hS.sub lMN ha, ?_⟩
        rw [← hat]
        exact (tp_eq_of_le hS ⟨kN'.1, hNc.1, lN', hS.sub lMN ha⟩ lMN lN'M ha).symm
  · exact hNsat
  · exact ⟨hsat 0 h0δ, hNsat, hl⟩

/-- Thm 7.1.18(b): if `(K^sat, ≼^NF ↾ K^sat)` satisfies smoothness, it is an AEC in `λ⁺`. -/
theorem thm_7_1_18_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, used by reflexivity (as in Prop 6.1.6(f)).
    (hinf : ℵ₀ ≤ lam)
    (hsm : ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ) :
    IsAECIn (s.satKSys lam) (Order.succ lam) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  refine ⟨fun M hM => hM.1.2, ?_,
    ⟨fun M N h => ⟨h.1, h.2.1⟩, fun M hM => ⟨hM, hM, Frame.leNF_refl hU hs hinf hM.1⟩,
      fun M N h h' => hS.po.2.2.1 _ _ h.2.2.2.2.1 h'.2.2.2.2.1,
      fun M N P h h' => ⟨h.1, h'.2.1, Frame.leNF_trans hU hs h.2.2 h'.2.2⟩⟩,
    fun M N h => hS.incl _ _ h.2.2.2.2.1, hsm,
    fun M₀ M₁ M₂ a b h h' => ⟨h.1, h'.1, Frame.leNF_mid hU hs
      (hS.coh _ _ _ a b h.2.2.2.2.1 h'.2.2.2.2.1) h'.2.2.2.2.1 h.2.2⟩,
    fun δ hδ hδ' => thm_7_1_18_a lam hU s hs δ hδ hδ'⟩
  intro M₀ M₁ N₁ f hM₁ h hf
  obtain ⟨-, P, hP, lP⟩ := Frame.leNF_iso hU hs M₀ M₁ N₁ f h.2.1.1 h.2.2 hf
  have hN₁ : N₁ ∈ s.Ksat lam := Saturated.iso hU hc hinf hM₁ hf
  exact ⟨hN₁, P, hP, Saturated.iso hU hc hinf h.1 hP, hN₁, lP⟩

/-- Thm 7.1.18(c): `(K^sat, ≼^NF ↾ K^sat)` satisfies the amalgamation property. -/
theorem thm_7_1_18_c [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam) :
    AP (s.satKSys lam) (Order.succ lam) :=
  (cor_7_1_17_a lam hU s hs).2

