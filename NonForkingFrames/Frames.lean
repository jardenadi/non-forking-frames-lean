        rw [hcl β' hβγ, p5 β' (Set.mem_Iic.2 hβγ) hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hβγ)]
      · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hβ')
