  · exact lt_of_le_of_lt (le_max_left t ξ) (Order.lt_add_one_iff.2 (le_refl _))
  · exact lt_of_le_of_lt (le_max_right t ξ) (Order.lt_add_one_iff.2 (le_refl _))
