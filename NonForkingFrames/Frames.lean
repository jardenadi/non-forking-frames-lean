theorem prop_7_1_12_b [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (M₀ N₀ N₁ : Model U L) (hM : M₀ ∈ s.S.Kc (Order.succ lam))
