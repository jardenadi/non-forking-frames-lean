    obtain ⟨q, hq, hnf, hres⟩ := hc.ax3f _ (inv α hα).2.1 _ (inv β hβ).2.1 _ hp (hstr α hα β hβ hαβ)
    have sp := Frame.plusTask_spec (s := s) (lam := lam) (pr := pr) (en := en) (α := β) (α' := α) (i := i)
      (ε := ε) (b := fun i => B i) (by rw [hpε]) (by rw [hpε]) hαβ.le ⟨q, hq, hnf, hres⟩
    exact ⟨_, sp.1, sp.2, (out β hβ).2.2.1 ε hεβ sp.1⟩

/-- AUX: not in paper. Cardinality of the union of a chain of length `λ⁺` in `K_λ`, above a model of
cardinality `λ⁺`. -/
theorem union_card_succ {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {B : Ordinal.{u} → Model U L}
    {M₀ M₁ : Model U L} (hB : ∀ α < (Order.succ lam).ord, #(B α).carrier ≤ lam)
    (hM₁ : M₁.carrier = ⋃ α ∈ Iio (Order.succ lam).ord, (B α).carrier)
    (hM₀ : #M₀.carrier = Order.succ lam) (hsub : M₀.carrier ⊆ M₁.carrier) :
    #M₁.carrier = Order.succ lam := by
  apply le_antisymm
  · rw [hM₁]
    exact card_bUnion_le (hinf.trans (Order.le_succ lam)) (by rw [Cardinal.card_ord]) _
      fun β hβ => (hB β hβ).trans (Order.le_succ lam)
  · rw [← hM₀]; exact Cardinal.mk_le_mk_of_subset hsub

