  obtain ⟨w, hst⟩ := Frame.run_wit hU hs' hinf hpr hen hG' hr hAU hM₁
  have Ai : IsIncreasing s.S.le A (Iio (Order.succ lam).ord) :=
    fun a ha b hb h => (hAlt a ha b hb h).1
  have h0c : c 0 = N₁ := (hcI 0 zero_le (lt_of_le_of_lt zero_le
    (hκl.add_one_lt (lt_of_le_of_lt zero_le hκl.bot_lt)))).1
  exact ⟨M₁, ⟨hM, k₁, A, c, _, _, w⟩,
    ⟨h₀, h₁, hM, k₁, A, c, Ai, hAc, Bi, Bc, hst, hA0, h0c, hAU, hM₁⟩⟩

-- PROOF-STAGE CHANGE: added `hinf : ℵ₀ ≤ λ`. For finite `λ` with `K_λ = ∅` the statement fails, since
-- witnesses live in `K_λ` (same change as Prop 6.1.6(b),(e),(f)). The proof is a direct run of the
-- corrected construction with `D = M₀`, not "by c" as in the paper (see docs/ERRATA.md).
/-- Prop 7.1.12(a): every `M₀ ∈ K_{λ⁺}` has some `M₁` with `M₀ ≺⁺ M₁`. -/
theorem prop_7_1_12_a [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (hinf : ℵ₀ ≤ lam) :
    ∀ M₀ ∈ s.S.Kc (Order.succ lam), ∃ M₁, s.ltPlus lam M₀ M₁ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  intro M₀ hM
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf hM
  have h0κ : (0 : Ordinal.{u}) < (Order.succ lam).ord := hκl.bot_lt
  have k₀ : R 0 ∈ s.S.Kc lam := hR.2.2.1 0 h0κ
  have h0M : s.S.lt (R 0) M₀ := ⟨hR.le hS hinf h0κ, fun e => by
    have h1 : #(R 0).carrier = lam := k₀.2
    have h2 : #M₀.carrier = Order.succ lam := hM.2
    rw [e, h2] at h1
    exact absurd h1 (Order.lt_succ lam).ne'⟩
  obtain ⟨X, hX, hlt⟩ := Frame.exists_strict hc k₀
  have hsmall : #(M₀.carrier ∪ (R 0).carrier : Set U) < #U := by
    have h2 : #M₀.carrier = Order.succ lam := hM.2
    have h3 : #(R 0).carrier = lam := k₀.2
    refine lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le ?_ ?_)
    · rw [h2]
      exact lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam)) (hU.1.two_power_lt hU.2)
    · rw [h3]; exact hU.2
  obtain ⟨h, N₁, hN₁, hid, l01, mem, hout⟩ :=
    hS.rename hU.infinite M₀.carrier hlt.1 (IsoOn.refl (R 0)) hsmall
  have hidR : ∀ x ∈ (R 0).carrier, h x = x := fun x hx => hid x hx
  have k₁ : N₁ ∈ s.S.Kc lam := ⟨mem, by rw [hN₁.card_eq]; exact hX.2⟩
  obtain ⟨x, hx, -⟩ := hc.ax2c _ k₀ X hX hlt
  have hxout := hout x hx
  have h01 : s.S.lt (R 0) N₁ := ⟨l01, fun e => by
    have : h x ∈ N₁.carrier := hN₁.mapsTo hx.1
    rw [← e] at this
    exact hxout (Or.inr this)⟩
  have hd : N₁.carrier ∩ M₀.carrier = (R 0).carrier := by
    ext z
    constructor
    · rintro ⟨hz, hz0⟩
      rw [hN₁.carrier_eq] at hz
      obtain ⟨y, hy, rfl⟩ := hz
      by_cases hyR : y ∈ (R 0).carrier
      · rw [hidR y hyR]; exact hyR
      · exact absurd (Or.inl hz0) (hout y ⟨hy, hyR⟩)
    · intro hz
      exact ⟨hS.sub l01 hz, hS.sub h0M.1 hz⟩
  obtain ⟨M₁, hM₁, -⟩ := prop_7_1_12_b lam hU s hs M₀ (R 0) N₁ hM k₀ k₁ h0M h01 hd
  exact ⟨M₁, hM₁⟩

/-- Prop 7.1.12(c): player 1 has a winning strategy in the `≺⁺_{λ⁺}`-game. -/
theorem prop_7_1_12_c [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) : ∃ F, s.Winning lam F := by
  classical
  have hs' : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  by_cases hne : ∃ M : Model U L, M ∈ s.S.Kc lam
  swap
  · have hκ0 : (0 : Ordinal.{u}) < (Order.succ lam).ord :=
      Cardinal.lt_ord.2 (by rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam))
    refine ⟨fun α a _ => a ⟨α, mem_self_succ α⟩, fun α _ A B h => ?_, fun A B h => ?_⟩
    · exact absurd ⟨A 0, (h.1 (lt_of_le_of_lt zero_le (Order.lt_add_one_iff.2 le_rfl))).1⟩ hne
    · exact absurd ⟨A 0, (h.1 hκ0).1⟩ hne
  obtain ⟨M, hM⟩ := hne
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨pr, hpr⟩ := exists_pair_ord hinf
  obtain ⟨en, hen⟩ := Frame.exists_en (s := s) (lam := lam) hs.1.2.2.2.1
  obtain ⟨G, hG⟩ := Frame.exists_plusG hU hs' pr en (Frame.gameD (U := U) (L := L))
  have hG' : s.IsPlusG lam pr en Frame.gameD G := hG
  have toRun : ∀ {γ : Ordinal.{u}} {A B : Ordinal.{u} → Model U L},
      s.IsPlay lam (fun α a b => (G α a b).2) γ A B → s.IsRun lam Frame.gameD G γ A B := by
    rintro γ A B ⟨h0, hL, hSt⟩
    refine ⟨h0, hL, fun α hα => ?_⟩
    obtain ⟨k, hlt, hd, hB⟩ := hSt α hα
    refine ⟨k, hlt, ?_, subset_rfl, hd, hB⟩
    show #(A (α + 1)).carrier < #U
    have : #(A (α + 1)).carrier = lam := k.2
    rw [this]; exact hU.2
  refine ⟨fun α a b => (G α a b).2, fun α hα A B h => ?_, fun A B h M₀ hM₀ k₀ => ?_⟩
  · have hα2 : α + 1 + 1 ≤ (Order.succ lam).ord :=
      Order.add_one_le_of_lt (hκl.add_one_lt hα)
    have hα1 : α + 1 < α + 1 + 1 := Order.lt_add_one_iff.2 le_rfl
    have hr := toRun h
    obtain ⟨-, g2, -, g4, g5, g6⟩ := Frame.run_step hU hs' hinf hG' hα2 hr hα1
    obtain ⟨-, -, -, -, -, l13, -, -, -⟩ := id g5
    exact ⟨g4, hS.trans g2 l13, g6⟩
  · have hr := toRun h
    have inv := Frame.run_inv hc hinf hG' le_rfl hr
    have Bi : IsIncreasing s.S.le B (Iio (Order.succ lam).ord) := fun a _ b hb hab =>
      (inv b hb).2.2.2.2.2.1 a (mem_Iic.2 hab.le) b (mem_Iic.2 le_rfl) hab
    have Bc : IsContinuous B (Iio (Order.succ lam).ord) := fun b hb hl =>
      (inv b hb).2.2.2.2.2.2 b (mem_Iic.2 le_rfl) hl
    obtain ⟨M₁, hM₁, memM₁, -⟩ := hS.union _ hκl B Bi Bc
    have hBle := (hS.le_union hκl Bi Bc hM₁).2
    have hsub : M₀.carrier ⊆ M₁.carrier := by
      rw [hM₀.1]
      intro x hx
      simp only [mem_iUnion, exists_prop] at hx
      obtain ⟨β, hβ, hxβ⟩ := hx
      exact hS.sub (hBle β hβ) (hS.sub (inv β hβ).2.2.1 hxβ)
    have k₁ : M₁ ∈ s.S.Kc (Order.succ lam) := ⟨memM₁, union_card_succ hinf
      (fun α hα => le_of_eq (inv α hα).2.1.2) hM₁.1 k₀.2 hsub⟩
    exact ⟨M₁, hM₁, k₀, k₁, A, B, _, _, (Frame.run_wit hU hs' hinf hpr hen hG' hr hM₀ hM₁).1⟩

/-- AUX: not in paper. Extending an embedding along `B ≼ C`, inside `K_λ`. -/
theorem IsAEC.ext_one {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hAP : AP S lam) {B C W : Model U L} {g : U → U} (kB : B ∈ S.Kc lam) (kC : C ∈ S.Kc lam)
    (kW : W ∈ S.Kc lam) (hBC : S.le B C) (hg : IsEmb S g B W) :
    ∃ (k : U → U) (W' : Model U L), W' ∈ S.Kc lam ∧ S.le W W' ∧ IsEmb S k C W' ∧
      ∀ x ∈ B.carrier, k x = g x :=
  hS.amalg_along hU hAP kB kC kW hBC hg

/-- AUX: not in paper. `(*)_{n,ε}` of the proof of Thm 7.1.13. -/
def StarUq (S : KSys U L) (lam : Cardinal.{u}) (N B C : Model U L) (g : U → U) : Prop :=
  ∃ (W₀ : Model U L) (h₀ : U → U), W₀ ∈ S.Kc lam ∧ S.le N W₀ ∧ IsEmb S h₀ C W₀ ∧
    (∀ x ∈ B.carrier, h₀ x = g x) ∧ ∃ a ∈ C.carrier \ B.carrier, h₀ a ∈ N.carrier

/-- AUX: not in paper. The successor step of the proof of Thm 7.1.13 (first half): `N_{2ε+1}`. -/
theorem Frame.uq_step₁ {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {A N : Model U L} {B C : Bool → Model U L} {g : Bool → U → U} {M₀ : Set U} (hM₀ : #M₀ < #U)
    (kN : N ∈ s.S.Kc lam) (kB : ∀ n, B n ∈ s.S.Kc lam) (kC : ∀ n, C n ∈ s.S.Kc lam)
    (lBC : ∀ n, s.S.le (B n) (C n)) (hg : ∀ n, IsEmb s.S (g n) (B n) N)
    (hNM : N.carrier ∩ M₀ = A.carrier) :
    ∃ (W : Model U L) (h : Bool → U → U), W ∈ s.S.Kc lam ∧ s.S.le N W ∧ W.carrier ∩ M₀ = A.carrier ∧
      (∀ n, IsEmb s.S (h n) (C n) W) ∧ (∀ n, ∀ x ∈ (B n).carrier, h n x = g n x) ∧
      ((∃ n, StarUq s.S lam N (B n) (C n) (g n)) →
        ∃ m, ∃ a ∈ (C m).carrier \ (B m).carrier, h m a ∈ N.carrier) := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have hAP := hc.ax1b
  have ofLe : ∀ {X Y Z : Model U L} {f : U → U}, IsEmb s.S f X Y → s.S.le Y Z → IsEmb s.S f X Z :=
    fun hf hl => by simpa using hf.comp hS (IsEmb.of_le hS hl)
  -- phase 1: embeddings into some `W₁`
  have H : ∃ (W₁ : Model U L) (h : Bool → U → U), W₁ ∈ s.S.Kc lam ∧ s.S.le N W₁ ∧
      (∀ n, IsEmb s.S (h n) (C n) W₁) ∧ (∀ n, ∀ x ∈ (B n).carrier, h n x = g n x) ∧
      ((∃ n, StarUq s.S lam N (B n) (C n) (g n)) →
        ∃ m, ∃ a ∈ (C m).carrier \ (B m).carrier, h m a ∈ N.carrier) := by
    by_cases hst : ∃ n, StarUq s.S lam N (B n) (C n) (g n)
    · obtain ⟨n, W₀, h₀, k0, l0, e0, x0, a, ha, haN⟩ := hst
      obtain ⟨k, W₁, k1, l1, e1, x1⟩ := hS.ext_one hU hAP (kB (!n)) (kC (!n)) k0 (lBC (!n))
        (ofLe (hg (!n)) l0)
      refine ⟨W₁, fun m => if m = n then h₀ else k, k1, hS.trans l0 l1, fun m => ?_, fun m x hx => ?_,
        fun _ => ⟨n, a, ha, by simpa using haN⟩⟩
      · by_cases hm : m = n
        · subst hm; simpa using ofLe e0 l1
        · have : m = !n := by cases m <;> cases n <;> simp_all
          subst this; simpa using e1
      · by_cases hm : m = n
        · subst hm; simpa using x0 x hx
        · have : m = !n := by cases m <;> cases n <;> simp_all
          subst this; simpa using x1 x hx
    · obtain ⟨k, W₀, k0, l0, e0, x0⟩ := hS.ext_one hU hAP (kB true) (kC true) kN (lBC true) (hg true)
      obtain ⟨k', W₁, k1, l1, e1, x1⟩ := hS.ext_one hU hAP (kB false) (kC false) k0 (lBC false)
        (ofLe (hg false) l0)
      refine ⟨W₁, fun m => if m then k else k', k1, hS.trans l0 l1, fun m => ?_, fun m x hx => ?_,
        fun h' => absurd h' hst⟩
      · cases m
        · simpa using e1
        · simpa using ofLe e0 l1
      · cases m
        · simpa using x1 x hx
        · simpa using x0 x hx
  obtain ⟨W₁, h, k1, l1, e1, x1, st⟩ := H
  have hsmall : #(M₀ ∪ N.carrier : Set U) < #U := by
    have : #N.carrier = lam := kN.2
    exact lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hM₀ (this ▸ hU.2))
  obtain ⟨r, W, hr, hid, lN, mem, hout⟩ := hS.rename hU.infinite M₀ l1 (IsoOn.refl N) hsmall
  have hidN : ∀ x ∈ N.carrier, r x = x := fun x hx => hid x hx
  have gN : ∀ n, ∀ x ∈ (B n).carrier, g n x ∈ N.carrier := fun n x hx => by
    obtain ⟨-, -, P, hP, hgP⟩ := hg n
    exact hS.sub hP (hgP.mapsTo hx)
  refine ⟨W, fun n => r ∘ h n, ⟨mem, by rw [hr.card_eq]; exact k1.2⟩, lN, ?_, fun n => (e1 n).comp_iso hS hr,
    fun n x hx => ?_, fun hs' => ?_⟩
  · ext x
    constructor
    · rintro ⟨hx, hxM⟩
      rw [hr.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_cases hyN : y ∈ N.carrier
      · rw [hidN y hyN] at hxM ⊢
        exact hNM ▸ (⟨hyN, hxM⟩ : y ∈ N.carrier ∩ M₀)
      · exact absurd (Or.inl hxM) (hout y ⟨hy, hyN⟩)
    · intro hx
      have h2 : x ∈ N.carrier ∩ M₀ := hNM ▸ hx
      exact ⟨hS.sub lN h2.1, h2.2⟩
  · simp only [Function.comp, x1 n x hx, hidN _ (gN n x hx)]
  · obtain ⟨m, a, ha, haN⟩ := st hs'
    exact ⟨m, a, ha, by simpa [Function.comp, hidN _ haN] using haN⟩

/-- AUX: not in paper. The successor step of the proof of Thm 7.1.13 (second half): `N_{2ε+2}`. -/
theorem Frame.uq_step₂ [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_7_1_1 s lam)
    {A A' W : Model U L} {C B' : Bool → Model U L} {h : Bool → U → U} {M₀ : Set U} (hM₀ : #M₀ < #U)
    (kA' : A' ∈ s.S.Kc lam) (kW : W ∈ s.S.Kc lam) (hA'M : A'.carrier ⊆ M₀)
    (hWM : W.carrier ∩ M₀ = A.carrier) (hNF : ∀ n, s.NF lam A (C n) A' (B' n))
    (he : ∀ n, IsEmb s.S (h n) (C n) W) (hid : ∀ n, ∀ x ∈ A.carrier, h n x = x) :
    ∃ (N' : Model U L) (g' : Bool → U → U), N' ∈ s.S.Kc lam ∧ s.S.le W N' ∧
      N'.carrier ∩ M₀ = A'.carrier ∧ ∀ n, IsEmb s.S (g' n) (B' n) N' ∧
        (∀ x ∈ (C n).carrier, g' n x = h n x) ∧ ∀ x ∈ A'.carrier, g' n x = x := by
  classical
  have hs' : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have H : ∀ n, ∃ (e : U → U) (P Q : Model U L), IsoOn e (B' n) Q ∧ IsoOn e (C n) P ∧ s.S.le P W ∧
      (∀ x ∈ (C n).carrier, e x = h n x) ∧ (∀ x ∈ A'.carrier, e x = x) ∧ s.NF lam A A' P Q := by
    intro n
    obtain ⟨-, -, P, lP, iP⟩ := he n
    obtain ⟨k0, kC, -, kB', l01, l13, l02, l23, -⟩ := id (hNF n)
    have hd := (prop_5_3_6 lam hU s hs' _ _ _ _).2 (hNF n)
    let h₀ : U → U := fun x => if x ∈ (C n).carrier then h n x else x
    have hW : ∀ x ∈ (C n).carrier, h n x ∈ W.carrier := fun x hx => hS.sub lP (iP.mapsTo hx)
    have hA'C : ∀ y ∈ A'.carrier, y ∉ (C n).carrier → ∀ x ∈ (C n).carrier, h n x ≠ y := by
      intro y hy hyC x hx e
      have : y ∈ W.carrier ∩ M₀ := ⟨e ▸ hW x hx, hA'M hy⟩
      rw [hWM] at this
      exact hyC (hS.sub l01 this)
    have hinj : InjOn h₀ ((C n).carrier ∪ A'.carrier) := by
      intro x hx y hy hxy
      by_cases hxC : x ∈ (C n).carrier <;> by_cases hyC : y ∈ (C n).carrier
      · simp only [h₀, hxC, hyC, if_true] at hxy
        exact iP.injOn hxC hyC hxy
      · simp only [h₀, hxC, hyC, if_true, if_false] at hxy
        exact absurd hxy (hA'C y (hy.resolve_left hyC) hyC x hxC)
      · simp only [h₀, hxC, hyC, if_true, if_false] at hxy
        exact absurd hxy.symm (hA'C x (hx.resolve_left hxC) hxC y hyC)
      · simpa only [h₀, hxC, hyC, if_false] using hxy
    have hsmall : #(∅ ∪ h₀ '' ((C n).carrier ∪ A'.carrier) : Set U) < #U := by
      rw [Set.empty_union]
      exact lt_of_le_of_lt Cardinal.mk_image_le (hU.small_union (le_of_eq kC.2) (le_of_eq kA'.2))
    obtain ⟨e, einj, eD, -⟩ := exists_rename hU.infinite (X := (B' n).carrier) h₀ hinj hsmall
    obtain ⟨Q, hQ⟩ := exists_isoOn einj
    have eC : ∀ x ∈ (C n).carrier, e x = h n x := fun x hx => by
      rw [eD x (Or.inl hx)]; exact if_pos hx
    have eA' : ∀ x ∈ A'.carrier, e x = x := fun x hx => by
      rw [eD x (Or.inr hx)]
      by_cases hxC : x ∈ (C n).carrier
      · have hxA : x ∈ A.carrier := hd ▸ (⟨hxC, hx⟩ : x ∈ (C n).carrier ∩ A'.carrier)
        simp only [h₀, hxC, if_true]; exact hid n x hxA
      · simp only [h₀, hxC, if_false]
    have hP : IsoOn e (C n) P := iP.congr fun x hx => (eC x hx).symm
    have fixI : ∀ {X : Model U L}, X.carrier ⊆ A'.carrier → IsoOn e X X := fun hX =>
      (IsoOn.refl _).congr fun x hx => (eA' x (hX hx)).symm
    exact ⟨e, P, Q, hQ, hP, lP, eC, eA', Frame.nf_iso hU hc (Frame.nf_symm hU hs' (hNF n)) hQ
      (fixI (hS.sub l02)) (fixI subset_rfl) hP⟩
  choose e P Q hQ hP lP eC eA' nf using H
  have hdW : W.carrier ∩ A'.carrier = A.carrier := by
    ext x
    constructor
    · intro hx; exact hWM ▸ (⟨hx.1, hA'M hx.2⟩ : x ∈ W.carrier ∩ M₀)
    · intro hx
      have h2 : x ∈ W.carrier ∩ M₀ := hWM ▸ hx
      obtain ⟨-, -, -, -, -, -, l02, -⟩ := id (nf true)
      obtain ⟨-, -, -, -, l01, -⟩ := id (nf true)
      exact ⟨h2.1, hS.sub l01 hx⟩
  obtain ⟨N₁, n1, ⟨f₁, -, m₁, o₁, -, -⟩, ⟨f₂, -, m₂, o₂, -, -⟩⟩ := prop_7_1_7 lam hU s hs A A'
    (P true) (Q true) (P false) (Q false) W kW ⟨nf true, nf false⟩ ⟨lP true, lP false⟩ hdW
  let f : Bool → U → U := fun n => if n then f₁ else f₂
  have fE : ∀ n, IsEmb s.S (f n) (Q n) N₁ ∧ Over (f n) (Q n) N₁ (A'.carrier ∪ (P n).carrier) := by
    intro n; cases n
    · exact ⟨by simpa [f] using m₂, by simpa [f] using o₂⟩
    · exact ⟨by simpa [f] using m₁, by simpa [f] using o₁⟩
  obtain ⟨-, -, -, kN₁, -, -, -, lWN, -⟩ := id n1
  have hsmall2 : #(M₀ ∪ id '' (W.carrier ∪ A'.carrier) : Set U) < #U := by
    rw [Set.image_id]
    exact lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hM₀
      (lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le
        (by have : #W.carrier = lam := kW.2; rw [this]; exact hU.2)
        (by have : #A'.carrier = lam := kA'.2; rw [this]; exact hU.2))))
  obtain ⟨ι, hinj, hιid, hιout⟩ := exists_rename hU.infinite (X := N₁.carrier) id (Set.injOn_id _) hsmall2
  have hfix : ∀ x ∈ W.carrier ∪ A'.carrier, ι x = x := fun x hx => hιid x hx
  obtain ⟨N', hN'⟩ := exists_isoOn hinj
  have fixW : IsoOn ι W W := (IsoOn.refl _).congr fun x hx => (hfix x (Or.inl hx)).symm
  have kN' : N' ∈ s.S.Kc lam := ⟨hS.iso_mem kN₁.1 hN', by rw [hN'.card_eq]; exact kN₁.2⟩
  have lA'N : s.S.le A' N₁ := n1.2.2.2.2.2.1
  refine ⟨N', fun n => ι ∘ (f n ∘ e n), kN', hS.iso_le lWN hN' fixW, ?_, fun n => ⟨?_, fun x hx => ?_,
    fun x hx => ?_⟩⟩
  · ext x
    constructor
    · rintro ⟨hx, hxM⟩
      rw [hN'.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_cases hyD : y ∈ W.carrier ∪ A'.carrier
      · rw [hfix y hyD] at hxM ⊢
        rcases hyD with h' | h'
        · have hyA : y ∈ A.carrier := hWM ▸ (⟨h', hxM⟩ : y ∈ W.carrier ∩ M₀)
          exact (hdW ▸ hyA : y ∈ W.carrier ∩ A'.carrier).2
        · exact h'
      · exact absurd (Or.inl hxM) (hιout y ⟨hy, hyD⟩)
    · intro hx
      refine ⟨?_, hA'M hx⟩
      have : ι x ∈ N'.carrier := hN'.mapsTo (hS.sub lA'N hx)
      rwa [hfix x (Or.inr hx)] at this
  · exact (IsEmb.iso_comp (hQ n) (hNF n).2.2.2.1.1 (fE n).1).comp_iso hS hN'
  · have hP' : h n x ∈ (P n).carrier := by
      have := (hP n).mapsTo hx
      rwa [eC n x hx] at this
    have hW' : h n x ∈ W.carrier := hS.sub (lP n) hP'
    simp only [Function.comp, eC n x hx, (fE n).2.2 _ (Or.inr hP'), hfix _ (Or.inl hW')]
  · simp only [Function.comp, eA' n x hx, (fE n).2.2 _ (Or.inl hx), hfix _ (Or.inr hx)]

/-- AUX: not in paper. The successor step of the proof of Thm 7.1.13. -/
theorem Frame.uq_step [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_7_1_1 s lam)
    {A A' N : Model U L} {B C B' : Bool → Model U L} {g : Bool → U → U} {M₀ : Set U} (hM₀ : #M₀ < #U)
    (kA' : A' ∈ s.S.Kc lam) (kN : N ∈ s.S.Kc lam) (kB : ∀ n, B n ∈ s.S.Kc lam)
    (kC : ∀ n, C n ∈ s.S.Kc lam) (lAB : ∀ n, s.S.le A (B n)) (lBC : ∀ n, s.S.le (B n) (C n))
    (hA'M : A'.carrier ⊆ M₀)
    (hNM : N.carrier ∩ M₀ = A.carrier) (hNF : ∀ n, s.NF lam A (C n) A' (B' n))
    (hg : ∀ n, IsEmb s.S (g n) (B n) N) (hid : ∀ n, ∀ x ∈ A.carrier, g n x = x) :
    ∃ (N' : Model U L) (g' : Bool → U → U), N' ∈ s.S.Kc lam ∧ s.S.le N N' ∧
      N'.carrier ∩ M₀ = A'.carrier ∧ (∀ n, IsEmb s.S (g' n) (B' n) N') ∧
      (∀ n, ∀ x ∈ (B n).carrier, g' n x = g n x) ∧ (∀ n, ∀ x ∈ A'.carrier, g' n x = x) ∧
      ((∃ n, StarUq s.S lam N (B n) (C n) (g n)) →
        ∃ m, ∃ a ∈ (C m).carrier \ (B m).carrier, g' m a ∈ N.carrier) := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  obtain ⟨W, h, kW, lNW, hWM, he, hx, st⟩ := Frame.uq_step₁ hU hs.1.1 hM₀ kN kB kC lBC hg hNM
  have hidh : ∀ n, ∀ x ∈ A.carrier, h n x = x := fun n x hxA => by
    rw [hx n x (hS.sub (lAB n) hxA)]; exact hid n x hxA
  obtain ⟨N', g', kN', lWN, hN'M, H⟩ := Frame.uq_step₂ hU hs hM₀ kA' kW hA'M hWM hNF he hidh
  refine ⟨N', g', kN', hS.trans lNW lWN, hN'M, fun n => (H n).1, fun n x hxB => ?_,
    fun n => (H n).2.2, fun hst => ?_⟩
  · rw [(H n).2.1 x (hS.sub (lBC n) hxB), hx n x hxB]
  · obtain ⟨m, a, ha, haN⟩ := st hst
    exact ⟨m, a, ha, by rw [(H m).2.1 a ha.1]; exact haN⟩

/-- AUX: not in paper. The invariant of the construction in the proof of Thm 7.1.13. -/
def Frame.UqInv (s : Frame U L) (lam : Cardinal.{u}) (A : Ordinal.{u} → Model U L)
    (B C : Bool → Ordinal.{u} → Model U L) (M₀ : Set U) (X : Model U L) (g0 : Bool → U → U)
    (α : Ordinal.{u}) (c : Ordinal.{u} → Model U L × (Bool → U → U)) : Prop :=
  (∀ β ≤ α, (c β).1 ∈ s.S.Kc lam ∧ (c β).1.carrier ∩ M₀ = (A β).carrier ∧
    (∀ n, IsEmb s.S ((c β).2 n) (B n β) (c β).1) ∧ ∀ n, ∀ x ∈ (A β).carrier, (c β).2 n x = x) ∧
  (c 0).1 = X ∧ (∀ n, ∀ x ∈ (B n 0).carrier, (c 0).2 n x = g0 n x) ∧
  IsIncreasing s.S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
  (∀ n, FunIncreasing (fun β => (c β).2 n) (B n) (Iic α)) ∧
  (∀ n, FunContinuous (fun β => (c β).2 n) (B n) (Iic α)) ∧
  ∀ β, β + 1 ≤ α → (∃ n, StarUq s.S lam (c β).1 (B n β) (C n β) ((c β).2 n)) →
    ∃ m, ∃ a ∈ (C m β).carrier \ (B m β).carrier, (c (β + 1)).2 m a ∈ (c β).1.carrier

/-- AUX: not in paper. The construction in the proof of Thm 7.1.13. -/
theorem Frame.uq_chain [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_7_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {A : Ordinal.{u} → Model U L} {B C : Bool → Ordinal.{u} → Model U L}
    {M₀ : Model U L} {M : Bool → Model U L} (hM₀ : #M₀.carrier < #U)
    (hw : ∀ n, s.PlusWit lam M₀ (M n) A (B n) (C n) (Iio (Order.succ lam).ord)) {X : Model U L}
    {g0 : Bool → U → U} (kX : X ∈ s.S.Kc lam) (he : ∀ n, IsEmb s.S (g0 n) (B n 0) X)
    (hid : ∀ n, ∀ x ∈ (A 0).carrier, g0 n x = x) (hXM : X.carrier ∩ M₀.carrier = (A 0).carrier) :
    ∃ c, ∀ α ≤ (Order.succ lam).ord, α < (Order.succ lam).ord →
      s.UqInv lam A B C M₀.carrier X g0 α c := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hAf := (hw true).filt.1
  obtain ⟨hA, -, -, -, -, -, -, -, -, -⟩ := id (hw true)
  have kA : ∀ β < (Order.succ lam).ord, A β ∈ s.S.Kc lam := fun β hβ => hA.2.2 β hβ
  have hB : ∀ n, IsIncCont s.S (B n) (Iio (Order.succ lam).ord) (s.S.Kc lam) := fun n => (hw n).2.1
  have kC : ∀ n, ∀ β < (Order.succ lam).ord, C n β ∈ s.S.Kc lam := fun n β hβ => (hw n).2.2.2.1 β hβ
  have lb : ∀ n, ∀ β < (Order.succ lam).ord, s.S.le (A β) (B n β) ∧ s.S.le (B n β) (C n β) :=
    fun n β hβ => (hw n).2.2.2.2.2.2.2.1 β hβ
  have nfs : ∀ n, ∀ β < (Order.succ lam).ord, s.NF lam (A β) (C n β) (A (β + 1)) (B n (β + 1)) :=
    fun n β hβ => (hw n).2.2.2.2.2.2.2.2.1 β hβ (β + 1) (hκl.add_one_lt hβ)
      (Order.lt_add_one_iff.2 le_rfl)
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  have hne : Nonempty (Model U L × (Bool → U → U)) := ⟨(X, g0)⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (Order.succ lam).ord
    (fun α c => α < (Order.succ lam).ord → s.UqInv lam A B C M₀.carrier X g0 α c)
    (fun α c c' h hi hα => by
      obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hi hα
      have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
      have e0 := e 0 zero_le
      refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2,
        by rw [e0]; exact h3, fun a ha b hb hl => ?_, fun b hb hl => ?_,
        fun n a ha b hb hl => ?_, fun n b hb hl y hy => ?_, fun β hβ => ?_⟩
      · simp only [e a ha, e b hb]; exact h4 a ha b hb hl
      · simp only [e b hb]; rw [h5 b hb hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hb)]
      · simp only [e a ha, e b hb]; exact h6 n a ha b hb hl
      · obtain ⟨ξ, hξ, hyξ, hx⟩ := h7 n b hb hl y hy
        refine ⟨ξ, hξ, hyξ, ?_⟩
        simp only [e b hb, e ξ (hξ.le.trans hb)]; exact hx
      · rw [e β ((lt1 β).le.trans hβ), e (β + 1) hβ]; exact h8 β hβ)
    (fun α hαle c prev => by
      by_cases hακ : α < (Order.succ lam).ord
      swap
      · exact ⟨(X, g0), fun h => absurd h hακ⟩
      rcases Ordinal.zero_or_succ_or_isSuccLimit α with rfl | ⟨γ, hγ⟩ | hl
      · refine ⟨(X, g0), fun _ => ?_⟩
        have hc0 : (fun b => if b < (0 : Ordinal.{u}) then c b else (X, g0)) = fun _ => (X, g0) :=
          funext fun b => if_neg (not_lt.2 zero_le)
        rw [hc0]
        have hz : ∀ b ≤ (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
        have hbad : ∀ {a b : Ordinal.{u}}, b ∈ Iic (0 : Ordinal.{u}) → a < b → False :=
          fun {a b} hb h => absurd (lt_of_lt_of_le h hb) (not_lt.2 zero_le)
        refine ⟨fun β hβ => ?_, rfl, fun _ _ _ => rfl, fun _ _ b hb h => (hbad hb h).elim,
          fun b hb hl => ?_, fun n _ _ b hb h => (hbad hb h).elim, fun n b hb hl => ?_, fun b hb => ?_⟩
        · rw [hz β hβ]; exact ⟨kX, hXM, he, hid⟩
        · rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
        · rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
        · exact absurd (lt_of_lt_of_le (lt1 b) hb) (not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at hγ
        subst hγ
        have hγκ : γ < (Order.succ lam).ord := (lt1 γ).trans hακ
        obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8⟩ := prev γ (lt1 γ) hγκ
        obtain ⟨kN, hNM, hg, hgid⟩ := p1 γ le_rfl
        obtain ⟨N', g', kN', lNN', hN'M, g1, g2, g3, g4⟩ := Frame.uq_step hU hs hM₀ (kA _ hακ) kN
          (fun n => (hB n).2.2 γ hγκ) (fun n => kC n γ hγκ) (fun n => (lb n γ hγκ).1)
          (fun n => (lb n γ hγκ).2) (hS.sub (hAf.le hS hinf hακ)) hNM (fun n => nfs n γ hγκ) hg hgid
        refine ⟨(N', g'), fun _ => ?_⟩
        set c' : Ordinal.{u} → Model U L × (Bool → U → U) :=
          fun b => if b < γ + 1 then c b else (N', g') with hc'def
        have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
        have hcx : c' (γ + 1) = (N', g') := if_neg (lt_irrefl _)
        have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
          rcases hb.lt_or_eq with h | h
          · exact Or.inl (Order.lt_add_one_iff.1 h)
          · exact Or.inr h
        have hle1 : ∀ b ≤ γ, s.S.le (c b).1 (c γ).1 := fun b hb => by
          rcases hb.lt_or_eq with h | h
          · exact p4 b (mem_Iic.2 hb) γ (mem_Iic.2 le_rfl) h
          · rw [h]; exact hS.refl kN.1
        refine ⟨fun b hb => ?_, by rw [hcl 0 zero_le]; exact p2, by rw [hcl 0 zero_le]; exact p3,
          fun a ha b hb hab => ?_, fun b hb hl => ?_, fun n a ha b hb hab y hy => ?_,
          fun n b hb hl y hy => ?_, fun b hb => ?_⟩
        · rcases hcases b hb with h | h
          · rw [hcl b h]; exact p1 b h
          · rw [h, hcx]; exact ⟨kN', hN'M, g1, g3⟩
        · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
          show s.S.le (c' a).1 (c' b).1
          rw [hcl a haγ]
          rcases hcases b hb with h | h
          · rw [hcl b h]; exact p4 a (mem_Iic.2 haγ) b (mem_Iic.2 h) hab
          · rw [h, hcx]; exact hS.trans (hle1 a haγ) lNN'
        · rcases hcases b hb with h | h
          · show (c' b).1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).1.carrier
            rw [hcl b h, p5 b (mem_Iic.2 h) hl]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (hξ.le.trans h)]
          · rw [h] at hl
            exact absurd (hl.add_one_lt (lt1 γ)) (lt_irrefl _)
        · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
          show (c' b).2 n y = (c' a).2 n y
          rw [hcl a haγ]
          rcases hcases b hb with h | h
          · rw [hcl b h]; exact p6 n a (mem_Iic.2 haγ) b (mem_Iic.2 h) hab y hy
          · rw [h, hcx]
            have hyγ : y ∈ (B n γ).carrier := by
              rcases haγ.lt_or_eq with h' | h'
              · exact hS.sub ((hB n).1 a (lt_of_le_of_lt haγ hγκ) γ hγκ h') hy
              · rw [← h']; exact hy
            show g' n y = _
            rw [g2 n y hyγ]
            rcases haγ.lt_or_eq with h' | h'
            · exact p6 n a (mem_Iic.2 haγ) γ (mem_Iic.2 le_rfl) h' y hy
            · rw [h']
        · rcases hcases b hb with h | h
          · obtain ⟨ξ, hξ, hyξ, hx⟩ := p7 n b (mem_Iic.2 h) hl y hy
            refine ⟨ξ, hξ, hyξ, ?_⟩
            show (c' b).2 n y = (c' ξ).2 n y
            rw [hcl b h, hcl ξ (hξ.le.trans h)]; exact hx
          · rw [h] at hl
            exact absurd (hl.add_one_lt (lt1 γ)) (lt_irrefl _)
        · have hbγ : b ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hb)
          rcases hbγ.lt_or_eq with h | h
          · have hb1 : b + 1 ≤ γ := Order.add_one_le_iff.2 h
            rw [hcl b hbγ, hcl (b + 1) hb1]; exact p8 b hb1
          · subst h
            rw [hcl b le_rfl, hcx]
            exact g4
      · have hp : ∀ β < α, s.UqInv lam A B C M₀.carrier X g0 β c := fun β hβ =>
          prev β hβ (lt_trans hβ hακ)
        have hp1 : ∀ β < α, (c β).1 ∈ s.S.Kc lam ∧ (c β).1.carrier ∩ M₀.carrier = (A β).carrier ∧
            (∀ n, IsEmb s.S ((c β).2 n) (B n β) (c β).1) ∧ ∀ n, ∀ x ∈ (A β).carrier, (c β).2 n x = x :=
          fun β hβ => (hp β hβ).1 β le_rfl
        have hinc : IsIncreasing s.S.le (fun β => (c β).1) (Iio α) := fun β _ β' hβ' h =>
          (hp β' hβ').2.2.2.1 β (mem_Iic.2 h.le) β' (mem_Iic.2 le_rfl) h
        have hcont : IsContinuous (fun β => (c β).1) (Iio α) := fun β hβ hl' =>
          (hp β hβ).2.2.2.2.1 β (mem_Iic.2 le_rfl) hl'
        obtain ⟨Nα, hNU, -, -⟩ := hS.union α hl _ hinc hcont
        obtain ⟨hNK, hleN⟩ := hS.le_union hl hinc hcont hNU
        have hαcard : α.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hακ)
        have kNα : Nα ∈ s.S.Kc lam := by
          refine ⟨hNK, le_antisymm ?_ ?_⟩
          · change #Nα.carrier ≤ lam
            rw [hNU.1]
            exact card_biUnion_le hinf hαcard fun β hβ => le_of_eq (hp1 β hβ).1.2
          · rw [← (hp1 0 hl.bot_lt).1.2]; exact Model.card_le_of_sub (hS.sub (hleN 0 hl.bot_lt))
        have hfi : ∀ n, ∀ a < α, ∀ b < α, a < b → ∀ y ∈ (B n a).carrier, (c b).2 n y = (c a).2 n y :=
          fun n a _ b hb h y hy =>
            (hp b hb).2.2.2.2.2.1 n a (mem_Iic.2 h.le) b (mem_Iic.2 le_rfl) h y hy
        let F : Bool → U → U := fun n x =>
          if h : ∃ β < α, x ∈ (B n β).carrier then (c h.choose).2 n x else x
        have hF : ∀ n, ∀ γ < α, ∀ y ∈ (B n γ).carrier, F n y = (c γ).2 n y := fun n γ hγ y hy => by
          have h : ∃ β < α, y ∈ (B n β).carrier := ⟨γ, hγ, hy⟩
          simp only [F, h, dite_true]
          obtain ⟨h1, h2⟩ := h.choose_spec
          rcases lt_trichotomy h.choose γ with h' | h' | h'
          · exact (hfi n _ h1 γ hγ h' y h2).symm
          · rw [h']
          · exact hfi n γ hγ _ h1 h' y hy
        refine ⟨(Nα, F), fun _ => ?_⟩
        set c' : Ordinal.{u} → Model U L × (Bool → U → U) :=
          fun b => if b < α then c b else (Nα, F) with hc'def
        have hcl : ∀ b < α, c' b = c b := fun b hb => if_pos hb
        have hcx : c' α = (Nα, F) := if_neg (lt_irrefl _)
        have hp0 := hp 0 hl.bot_lt
        have c4 : IsIncreasing s.S.le (fun β => (c' β).1) (Iic α) := by
          intro a ha b hb h'
          have haα : a < α := lt_of_lt_of_le h' hb
          show s.S.le (c' a).1 (c' b).1
          rw [hcl a haα]
          rcases (show b ≤ α from hb).lt_or_eq with h | h
          · rw [hcl b h]; exact hinc a haα b h h'
          · rw [h, hcx]; exact hleN a haα
        have c6 : ∀ n, FunIncreasing (fun β => (c' β).2 n) (B n) (Iic α) := by
          intro n a ha b hb h' y hy
          have haα : a < α := lt_of_lt_of_le h' hb
          show (c' b).2 n y = (c' a).2 n y
          rw [hcl a haα]
          rcases (show b ≤ α from hb).lt_or_eq with h | h
          · rw [hcl b h]; exact hfi n a haα b h h' y hy
          · rw [h, hcx]; exact hF n a haα y hy
        have hBi : ∀ n, IsIncreasing s.S.le (B n) (Iic α) := fun n a ha b hb h =>
          (hB n).1 a (lt_of_le_of_lt ha hακ) b (lt_of_le_of_lt hb hακ) h
        have hBc : ∀ n, IsContinuous (B n) (Iic α) := fun n b hb hl' =>
          (hB n).2.1 b (lt_of_le_of_lt hb hακ) hl'
        have hAc : (A α).carrier = ⋃ β ∈ Iio α, (A β).carrier := hA.2.1 α hακ hl
        have c1α : c' α = (Nα, F) ∧ Nα.carrier ∩ M₀.carrier = (A α).carrier := by
          refine ⟨hcx, ?_⟩
          ext x
          constructor
          · rintro ⟨hx, hx0⟩
            rw [hNU.1] at hx
            simp only [mem_iUnion, exists_prop] at hx
            obtain ⟨β, hβ, hxβ⟩ := hx
            have e := (hp1 β hβ).2.1
            exact hS.sub (hA.1 β (lt_trans hβ hακ) α hακ hβ)
              (e ▸ (⟨hxβ, hx0⟩ : x ∈ (c β).1.carrier ∩ M₀.carrier))
          · intro hx
            refine ⟨?_, hS.sub (hAf.le hS hinf hακ) hx⟩
            rw [hAc] at hx
            simp only [mem_iUnion, exists_prop] at hx
            obtain ⟨β, hβ, hxβ⟩ := hx
            have e := (hp1 β hβ).2.1
            have : x ∈ (c β).1.carrier := (e ▸ hxβ : x ∈ (c β).1.carrier ∩ M₀.carrier).1
            exact hS.sub (hleN β hβ) this
        refine ⟨fun b hb => ?_, by rw [hcl 0 hl.bot_lt]; exact hp0.2.1,
          by rw [hcl 0 hl.bot_lt]; exact hp0.2.2.1, c4, fun b hb hl' => ?_, c6,
          fun n b hb hl' y hy => ?_, fun b hb => ?_⟩
        · rcases hb.lt_or_eq with h | h
          · rw [hcl b h]; exact hp1 b h
          · rw [h, hcx]
            refine ⟨kNα, c1α.2, fun n => ?_, fun n x hx => ?_⟩
            · have := hS.emb_limit (f := fun β => (c' β).2 n) (N := fun β => (c' β).1)
                (M := B n) hl (hBi n) (hBc n) c4
                (fun β hβ => by simpa only [hcl β hβ] using (hp1 β hβ).2.2.1 n) (c6 n)
              simpa only [hcx] using this
            · rw [hAc] at hx
              simp only [mem_iUnion, exists_prop] at hx
              obtain ⟨β, hβ, hxβ⟩ := hx
              show F n x = x
              rw [hF n β hβ x (hS.sub (lb n β (lt_trans hβ hακ)).1 hxβ)]
              exact (hp1 β hβ).2.2.2 n x hxβ
        · show (c' b).1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).1.carrier
          rcases (show b ≤ α from hb).lt_or_eq with h | h
          · rw [hcl b h]
            have := hcont b h hl'
            simp only at this
            rw [this]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
          · rw [h, hcx, hNU.1]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
        · rcases (show b ≤ α from hb).lt_or_eq with h | h
          · obtain ⟨ξ, hξ, hyξ, hx⟩ := (hp b h).2.2.2.2.2.2.1 n b (mem_Iic.2 le_rfl) hl' y hy
            refine ⟨ξ, hξ, hyξ, ?_⟩
            show (c' b).2 n y = (c' ξ).2 n y
            rw [hcl b h, hcl ξ (lt_trans hξ h)]; exact hx
          · subst h
            have hy' := hy
            rw [(hB n).2.1 b hακ hl'] at hy'
            simp only [mem_iUnion, exists_prop] at hy'
            obtain ⟨ξ, hξ, hyξ⟩ := hy'
            refine ⟨ξ, hξ, hyξ, ?_⟩
            show (c' b).2 n y = (c' ξ).2 n y
            rw [hcx, hcl ξ hξ]; exact hF n ξ hξ y hyξ
        · have hb1 : b + 1 < α := lt_of_le_of_ne hb fun h => by
            have := hl.add_one_lt (show b < α from h ▸ lt1 b)
            exact absurd this (by rw [h]; exact lt_irrefl _)
          have hb' : b < α := lt_trans (lt1 b) hb1
          rw [hcl b hb', hcl (b + 1) hb1]
          exact (hp (b + 1) hb1).2.2.2.2.2.2.2 b le_rfl)
  exact ⟨c, hcI⟩

/-- AUX: not in paper. Pulling `N` back along an isomorphism `g : B → P`, `P ≼ N`. -/
theorem IsAEC.uq_pull {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    {B P N : Model U L} {g : U → U} (kB : B ∈ S.Kc lam) (lP : S.le P N) (iP : IsoOn g B P) :
    ∃ (r : U → U) (N' : Model U L), IsoOn r N N' ∧ S.le B N' ∧ ∀ y ∈ B.carrier, r (g y) = y := by
  obtain ⟨gi, hgi, h1, -⟩ := iP.exists_inv
  have hsmall : #(∅ ∪ B.carrier : Set U) < #U := by
    rw [Set.empty_union]
    have : #B.carrier = lam := kB.2
    rw [this]; exact hU.2
  obtain ⟨r, N', hr, hid, lB, -, -⟩ := hS.rename hU.infinite ∅ lP hgi hsmall
  exact ⟨r, N', hr, lB, fun y hy => by rw [hid _ (iP.mapsTo hy)]; exact h1 y hy⟩

/-- AUX: not in paper. -/
theorem iso_of_left_inv {g r : U → U} {B P : Model U L} (iP : IsoOn g B P)
    (h : ∀ y ∈ B.carrier, r (g y) = y) : IsoOn r P B := by
  obtain ⟨gi, hgi, h1, h2⟩ := iP.exists_inv
  refine hgi.congr fun x hx => ?_
  have hy := hgi.mapsTo hx
  have := h _ hy
  rw [h2 x hx] at this
  exact this.symm

/-- AUX: not in paper. The step of the proof of Claim 7.1.16 that gives `(*)_{n,ζ}`. -/
theorem Frame.uq_star {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (hinf : ℵ₀ ≤ lam) {B C N N' : Model U L} {g r : U → U} {a x' : U} (kB : B ∈ s.S.Kc lam)
    (kC : C ∈ s.S.Kc lam) (kN : N ∈ s.S.Kc lam) (lBC : s.S.le B C) (hg : IsEmb s.S g B N)
    (hr : IsoOn r N N') (lBN' : s.S.le B N') (hrg : ∀ y ∈ B.carrier, r (g y) = y)
    (ha : a ∈ N.carrier) (hx' : x' ∈ C.carrier) (hx'B : x' ∉ B.carrier)
    (htp : tp s.S lam x' B C = tp s.S lam (r a) B N') : StarUq s.S lam N B C g := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have kN' : N' ∈ s.S.Kc lam := ⟨hS.iso_mem kN.1 hr, by rw [hr.card_eq]; exact kN.2⟩
  obtain ⟨N₂, kN₂, lN'N₂, u, hu, huo, hux⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf
    (M := B) (N := C) (N' := N') (a := x') (a' := r a) ⟨kB, kC, lBC, hx'⟩
    ⟨kB, kN', lBN', hr.mapsTo ha⟩ htp
  obtain ⟨r', hr', h1, h2⟩ := hr.exists_inv
  have hsmall : #(∅ ∪ N.carrier : Set U) < #U := by
    rw [Set.empty_union]
    have : #N.carrier = lam := kN.2
    rw [this]; exact hU.2
  obtain ⟨ρ, W₀, hρ, hid, lN, memW, -⟩ := hS.rename hU.infinite ∅ lN'N₂ hr' hsmall
  have kW₀ : W₀ ∈ s.S.Kc lam := ⟨memW, by rw [hρ.card_eq]; exact kN₂.2⟩
  obtain ⟨-, -, P, lP, iP⟩ := id hg
  refine ⟨W₀, ρ ∘ u, kW₀, lN, hu.comp_iso hS hρ, fun x hx => ?_, x', ⟨hx', hx'B⟩, ?_⟩
  · have hgx : g x ∈ N.carrier := hS.sub lP (iP.mapsTo hx)
    have hxN' : x ∈ N'.carrier := hS.sub lBN' hx
    simp only [Function.comp, huo.2 x hx, hid x hxN']
    have := h1 _ hgx
    rwa [hrg x hx] at this
  · simp only [Function.comp, hux, hid _ (hr.mapsTo ha), h1 a ha]
    exact ha

/-- AUX: not in paper. The core of Thm 7.1.13: from common witnesses with `E = λ⁺` and an amalgam of
`N_{1,0}, N_{2,0}` over `N_{0,0}`, an amalgam of `M₁, M₂` over `M₀` onto both. -/
theorem Frame.uq_core [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_7_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {A : Ordinal.{u} → Model U L} {B C : Bool → Ordinal.{u} → Model U L}
    {M₀ : Model U L} {M : Bool → Model U L} (hM₀ : #M₀.carrier < #U)
    (hMk : ∀ n, M n ∈ s.S.Kc (Order.succ lam))
    (hw : ∀ n, s.PlusWit lam M₀ (M n) A (B n) (C n) (Iio (Order.succ lam).ord)) {X : Model U L}
    {g0 : Bool → U → U} (kX : X ∈ s.S.Kc lam) (he : ∀ n, IsEmb s.S (g0 n) (B n 0) X)
    (hid : ∀ n, ∀ x ∈ (A 0).carrier, g0 n x = x) (hXM : X.carrier ∩ M₀.carrier = (A 0).carrier) :
    ∃ (k : Bool → U → U) (N : Model U L), (∀ n, IsoOn (k n) (M n) N) ∧
      (∀ n, ∀ x ∈ M₀.carrier, k n x = x) ∧ ∀ n, ∀ x ∈ (B n 0).carrier, k n x = g0 n x := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨c, hcI⟩ := Frame.uq_chain hU hs hinf hM₀ hw kX he hid hXM
  have inv : ∀ α < (Order.succ lam).ord, s.UqInv lam A B C M₀.carrier X g0 α c :=
    fun α hα => hcI α hα.le hα
  have hd1 := fun β hβ => (inv β hβ).1 β le_rfl
  have hBf : ∀ n, IsFilt s.S lam (M n) (B n) := fun n => (hw n).filt.2
  have hAf : IsFilt s.S lam M₀ A := (hw true).filt.1
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  let N : Ordinal.{u} → Model U L := fun β => (c β).1
  have Ni : IsIncreasing s.S.le N (Iio (Order.succ lam).ord) := fun a _ b hb hab =>
    (inv b hb).2.2.2.1 a (mem_Iic.2 hab.le) b (mem_Iic.2 le_rfl) hab
  have Nc : IsContinuous N (Iio (Order.succ lam).ord) := fun b hb hl =>
    (inv b hb).2.2.2.2.1 b (mem_Iic.2 le_rfl) hl
  have kN : ∀ β < (Order.succ lam).ord, N β ∈ s.S.Kc lam := fun β hβ => (hd1 β hβ).1
  obtain ⟨Nκ, hNU, memNκ, -⟩ := hS.union _ hκl N Ni Nc
  have hleN := (hS.le_union hκl Ni Nc hNU).2
  have hfi : ∀ n, ∀ a < (Order.succ lam).ord, ∀ b < (Order.succ lam).ord, a < b →
      ∀ y ∈ (B n a).carrier, (c b).2 n y = (c a).2 n y := fun n a _ b hb h y hy =>
    (inv b hb).2.2.2.2.2.1 n a (mem_Iic.2 h.le) b (mem_Iic.2 le_rfl) h y hy
  let F : Bool → U → U := fun n x =>
    if h : ∃ β < (Order.succ lam).ord, x ∈ (B n β).carrier then (c h.choose).2 n x else x
  have hF : ∀ n, ∀ γ < (Order.succ lam).ord, ∀ y ∈ (B n γ).carrier, F n y = (c γ).2 n y := by
    intro n γ hγ y hy
    have h : ∃ β < (Order.succ lam).ord, y ∈ (B n β).carrier := ⟨γ, hγ, hy⟩
    simp only [F, h, dite_true]
    obtain ⟨h1, h2⟩ := h.choose_spec
    rcases lt_trichotomy h.choose γ with h' | h' | h'
    · exact (hfi n _ h1 γ hγ h' y h2).symm
    · rw [h']
    · exact hfi n γ hγ _ h1 h' y hy
  have hE : ∀ n, IsEmb s.S (F n) (M n) Nκ := by
    intro n
    let M' : Ordinal.{u} → Model U L := fun β => if β < (Order.succ lam).ord then B n β else M n
    let N' : Ordinal.{u} → Model U L := fun β => if β < (Order.succ lam).ord then N β else Nκ
    let f' : Ordinal.{u} → U → U := fun β => if β < (Order.succ lam).ord then (c β).2 n else F n
    obtain ⟨Mi, Mc⟩ := IsAEC.extend_union (hBf n).1 (hBf n).2.1 (hBf n).2.2.2
      (fun β hβ => (hBf n).le hS hinf hβ)
    obtain ⟨Ni', -⟩ := IsAEC.extend_union Ni Nc hNU hleN
    have := hS.emb_limit (f := f') (M := M') (N := N') hκl Mi Mc Ni'
      (fun β hβ => by
        simp only [M', N', f', if_pos hβ]
        exact (hd1 β hβ).2.2.1 n)
      (fun a _ b hb hab y hy => by
        have ha : a < (Order.succ lam).ord := lt_of_lt_of_le hab hb
        simp only [M', if_pos ha] at hy
        simp only [f', if_pos ha]
        rcases (show b ≤ (Order.succ lam).ord from hb).lt_or_eq with h | h
        · rw [if_pos h]; exact hfi n a ha b h hab y hy
        · rw [h, if_neg (lt_irrefl _)]; exact hF n a ha y hy)
    simpa only [M', N', f', if_neg (lt_irrefl _)] using this
  have hP : ∀ n, IsoOn (F n) (M n) Nκ := by
    intro n
    obtain ⟨-, -, P, lP, iP⟩ := id (hE n)
    suffices e : P = Nκ by rw [← e]; exact iP
    by_contra hne
    have hlt : s.S.lt P Nκ := ⟨lP, hne⟩
    have kP : P ∈ s.S.Kc (Order.succ lam) := ⟨hS.mem_left lP, by rw [iP.card_eq]; exact (hMk n).2⟩
    have hPge : P ∈ s.S.KGe lam := ⟨kP.1, by rw [kP.2]; exact Order.le_succ lam⟩
    obtain ⟨a, ha, htp⟩ := thm_2_6_8_1 lam hU s ⟨hc, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
      hs.1.2.2.2.2 hinf P Nκ hlt hPge
    rcases htp with ⟨e, -⟩ | ⟨-, -, hpall, R, kR, lRP, hnf⟩
    · rw [kP.2] at e
      exact absurd e (Order.lt_succ lam).ne'
    have kRge : R ∈ s.S.KGe lam := ⟨kR.1, le_of_eq kR.2.symm⟩
    obtain ⟨-, -, -, -, -, -, R₀, kR₀, lR₀, H⟩ := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a
      hc.ax3b R P kRge hPge lRP _ hpall).1 hnf Nκ a (mem_tp_self _ _ _ _ _)
    have lR₀P : s.S.le R₀ P := hS.trans lR₀ lRP
    obtain ⟨gi, hgi, gi1, gi2⟩ := iP.exists_inv
    obtain ⟨ε₀, hε₀, hcov⟩ := (hBf n).cover hS hinf (A := gi '' R₀.carrier)
      (Set.image_subset_iff.2 fun x hx => hgi.mapsTo (hS.sub lR₀P hx))
      (Cardinal.mk_image_le.trans (le_of_eq kR₀.2))
    have haU : a ∈ ⋃ β ∈ Iio (Order.succ lam).ord, (N β).carrier := hNU.1 ▸ ha.1
    simp only [mem_iUnion, exists_prop] at haU
    obtain ⟨β₀, hβ₀, haβ₀⟩ := haU
    set ε := max ε₀ β₀ with hεdef
    have hε : ε < (Order.succ lam).ord := max_lt hε₀ hβ₀
    have Bsub : ∀ {a b : Ordinal.{u}}, a ≤ b → b < (Order.succ lam).ord →
        (B n a).carrier ⊆ (B n b).carrier := fun {a b} h hb => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub ((hBf n).1 a (lt_of_lt_of_le h' hb.le) b hb h')
      · rw [h']
    have Nsub : ∀ {a b : Ordinal.{u}}, a ≤ b → b < (Order.succ lam).ord →
        (N a).carrier ⊆ (N b).carrier := fun {a b} h hb => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub (Ni a (lt_of_lt_of_le h' hb.le) b hb h')
      · rw [h']
    have kB : ∀ β < (Order.succ lam).ord, B n β ∈ s.S.Kc lam := fun β hβ => (hBf n).2.2.1 β hβ
    have hZ : ∀ ζ, ∃ Q : Model U L, ζ < (Order.succ lam).ord → s.S.le Q (N ζ) ∧
        IsoOn ((c ζ).2 n) (B n ζ) Q := fun ζ => by
      by_cases hζ : ζ < (Order.succ lam).ord
      · obtain ⟨-, -, Q, h1, h2⟩ := (hd1 ζ hζ).2.2.1 n
        exact ⟨Q, fun _ => ⟨h1, h2⟩⟩
      · exact ⟨P, fun h => absurd h hζ⟩
    choose Pz hPz using hZ
    have Pz_le : ∀ ζ (hζ : ζ < (Order.succ lam).ord), s.S.le (Pz ζ) P := fun ζ hζ => by
      refine hS.le_of_sub (hS.trans (hPz ζ hζ).1 (hleN ζ hζ)) lP fun x hx => ?_
      rw [(hPz ζ hζ).2.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      rw [← hF n ζ hζ y hy]
      exact iP.mapsTo (hS.sub ((hBf n).le hS hinf hζ) hy)
    have kPz : ∀ ζ (hζ : ζ < (Order.succ lam).ord), Pz ζ ∈ s.S.Kc lam := fun ζ hζ =>
      ⟨hS.mem_left (hPz ζ hζ).1, by rw [(hPz ζ hζ).2.card_eq]; exact (kB ζ hζ).2⟩
    have gcmp : ∀ {a b : Ordinal.{u}}, a ≤ b → b < (Order.succ lam).ord →
        ∀ y ∈ (B n a).carrier, (c b).2 n y = (c a).2 n y := fun {a b} h hb y hy => by
      rcases h.lt_or_eq with h' | h'
      · exact hfi n a (lt_of_lt_of_le h' hb.le) b hb h' y hy
      · rw [h']
    have R₀sub : ∀ ζ, ε ≤ ζ → ζ < (Order.succ lam).ord → R₀.carrier ⊆ (Pz ζ).carrier := by
      intro ζ hle hζ x hx
      have hy : gi x ∈ (B n ε₀).carrier := hcov ⟨x, hx, rfl⟩
      have hyζ := Bsub ((le_max_left ε₀ β₀).trans hle) hζ hy
      have : (c ζ).2 n (gi x) ∈ (Pz ζ).carrier := (hPz ζ hζ).2.mapsTo hyζ
      rwa [← hF n ζ hζ _ hyζ, gi2 x (hS.sub lR₀P hx)] at this
    have Psub : ∀ {a b : Ordinal.{u}}, a ≤ b → b < (Order.succ lam).ord →
        (Pz a).carrier ⊆ (Pz b).carrier := fun {a b} h hb x hx => by
      have ha : a < (Order.succ lam).ord := lt_of_le_of_lt h hb
      rw [(hPz a ha).2.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      rw [← gcmp h hb y hy]
      exact (hPz b hb).2.mapsTo (Bsub h hb hy)
    have lPε : s.S.le R₀ (Pz ε) := hS.le_of_sub lR₀P (Pz_le ε hε) (R₀sub ε le_rfl hε)
    have aN : ∀ ζ, ε ≤ ζ → ζ < (Order.succ lam).ord → a ∈ (N ζ).carrier := fun ζ hle hζ =>
      Nsub ((le_max_right ε₀ β₀).trans hle) hζ haβ₀
    have lPP : ∀ ζ, ε ≤ ζ → ζ < (Order.succ lam).ord → s.S.le (Pz ε) (Pz ζ) := fun ζ hle hζ =>
      hS.le_of_sub (Pz_le ε hε) (Pz_le ζ hζ) (Psub hle hζ)
    have nfm : ∀ ζ, ε ≤ ζ → (hζ : ζ < (Order.succ lam).ord) → s.nf (Pz ε) (Pz ζ) a (N ζ) := by
      intro ζ hle hζ
      have h1 := H (Pz ζ) (kPz ζ hζ) (R₀sub ζ hle hζ) (Pz_le ζ hζ) (N ζ) (kN ζ hζ)
        (Set.union_subset (hS.sub (hPz ζ hζ).1) (Set.singleton_subset_iff.2 (aN ζ hle hζ)))
        (hleN ζ hζ)
      exact Frame.nf_mono hS hc.ax3a hc.ax3b h1 lPε (lPP ζ hle hζ) (hS.refl (kPz ζ hζ).1)
    have hPl : ∀ ζ, ∃ (r : U → U) (N' : Model U L), ζ < (Order.succ lam).ord →
        IsoOn r (N ζ) N' ∧ s.S.le (B n ζ) N' ∧ ∀ y ∈ (B n ζ).carrier, r ((c ζ).2 n y) = y := fun ζ => by
      by_cases hζ : ζ < (Order.succ lam).ord
      · obtain ⟨r, N', h1, h2, h3⟩ := hS.uq_pull hU (kB ζ hζ) (hPz ζ hζ).1 (hPz ζ hζ).2
        exact ⟨r, N', fun _ => ⟨h1, h2, h3⟩⟩
      · exact ⟨id, P, fun h => absurd h hζ⟩
    choose r N' hr using hPl
    have kN' : ∀ ζ (hζ : ζ < (Order.succ lam).ord), N' ζ ∈ s.S.Kc lam := fun ζ hζ =>
      ⟨hS.iso_mem (kN ζ hζ).1 (hr ζ hζ).1, by rw [(hr ζ hζ).1.card_eq]; exact (kN ζ hζ).2⟩
    have nfk : ∀ ζ, ε ≤ ζ → (hζ : ζ < (Order.succ lam).ord) →
        s.NotFork lam (B n ε) (B n ζ) (tp s.S lam (r ζ a) (B n ζ) (N' ζ)) := by
      intro ζ hle hζ
      have hA : IsoOn (r ζ) (Pz ε) (B n ε) := iso_of_left_inv (hPz ε hε).2 fun y hy => by
        rw [← gcmp hle hζ y hy]; exact (hr ζ hζ).2.2 y (Bsub hle hζ hy)
      exact Frame.notFork_iso hU hc ⟨a, N ζ, rfl, nfm ζ hle hζ⟩ (hPz ζ hζ).1 (aN ζ hle hζ)
        (hr ζ hζ).1 hA (iso_of_left_inv (hPz ζ hζ).2 (hr ζ hζ).2.2)
    have hSbs : ∀ ζ, ε ≤ ζ → (hζ : ζ < (Order.succ lam).ord) →
        tp s.S lam (r ζ a) (B n ζ) (N' ζ) ∈ s.Sbs (B n ζ) ∧
          tp s.S lam (r ζ a) (B n ε) (N' ζ) ∈ s.Sbs (B n ε) := by
      intro ζ hle hζ
      obtain ⟨b, N'', eq, -, -, -, -, -, l1, -, h1, h2⟩ := (nfk ζ hle hζ).facts hc.ax3a
      refine ⟨eq ▸ h2, ?_⟩
      have e := congrArg (fun p => res s.S lam p (B n ε)) eq
      simp only [res_tp hS l1] at e
      rw [e]; exact h1
    have hκε : ε + 1 < (Order.succ lam).ord := hκl.add_one_lt hε
    set ζ₀ := ε + 1 with hζ₀
    have hεζ₀ : ε ≤ ζ₀ := (lt1 ε).le
    obtain ⟨r₀', hr₀', r1, r2⟩ := (hr ζ₀ hκε).1.exists_inv
    have hrelate : ∀ ζ, ζ₀ ≤ ζ → (hζ : ζ < (Order.succ lam).ord) →
        tp s.S lam (r ζ a) (B n ε) (N' ζ) = tp s.S lam (r ζ₀ a) (B n ε) (N' ζ₀) := by
      intro ζ hle hζ
      have hεζ : ε ≤ ζ := hεζ₀.trans hle
      have lNN : s.S.le (N ζ₀) (N ζ) ∨ ζ = ζ₀ := by
        rcases hle.lt_or_eq with h | h
        · exact Or.inl (Ni _ hκε ζ hζ h)
        · exact Or.inr h.symm
      rcases lNN with lNN | rfl
      swap
