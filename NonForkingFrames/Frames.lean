          fun β hβ hβl => (hprev β hβ (lt_trans hβ hακ)).2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl,
          fun β hβ β' hβ' h => (hprev β' hβ' (lt_trans hβ' hακ)).2.2.2.2.1 β
          (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h,
          fun β hβ hβl => (hprev β hβ (lt_trans hβ hακ)).2.2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl⟩
        have hb1 : β + 1 < α := hlim.add_one_lt hβ
        exact ((hprev (β + 1) hb1 (lt_trans hb1 hακ)).2.2.2.2.2.2 β le_rfl).1
      obtain ⟨Mu, Nu, hMuU, hNuU, hu, hleu, hleMN⟩ := Frame.bs_union (lam := lam) hU hc hcont3
        hlim hακ hbsc
      have hp0 := hprev 0 h0α (lt_trans h0α hακ)
      have hc0 : c 0 = (M, N) := hp0.2.1
      rw [hc0] at hleu
      refine ⟨(Mu, Nu), fun _ => ?_⟩
      set c' : Ordinal.{u} → Model U L × Model U L :=
