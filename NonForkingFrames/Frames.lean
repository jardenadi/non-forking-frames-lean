    hS.iso_le hN₁Ms hiso ((IsoOn.refl N₁).congr fun x hx => (hid x hx).symm), αs, A', B', _, hw,
    by show h (d 0) = a; rw [hd0, hid a ha.1]⟩

-- DEVIATION (author-confirmed erratum): part (c). The paper omits "`tp(a, N₀, N₁)` is basic" and
-- the passage from `N₁` to an extension `N₁* ≽ N₁`, which is what its proof via Thm 3.2.3(3)
-- produces. See docs/ERRATA.md.
/-- Thm 5.3.7 (existence theorem for `NF`): suppose `N₀ ≼ Nₙ` (`n = 1, 2`) and `N₁ ∩ N₂ = N₀`.
(a) For some `N₃ ∈ K_λ`, `NF(N₀, N₁, N₂, N₃)`. (b) If `N₁` is decomposable over `N₀` by
`K^{3,uq}`, then `NF*(N₀, N₁, N₂, N₃)` for some `N₃ ∈ K_λ`. (c), corrected: if `a ∈ N₁ - N₀` and
`tp(a, N₀, N₁)` is basic, then for some `N₃ ∈ K_λ` and `N₁* ≽ N₁` in `K_λ`,
`NF*(N₀, N₁*, N₂, N₃)` with `a` the first element of the first witness.
Original text of (c): "If `N₁` is decomposable over `N₀` by `K^{3,uq}` and `a ∈ N₁ - N₀`, then
for some `N₃ ∈ K_λ`, `NF*(N₀, N₁, N₂, N₃)`. Moreover, we can choose `a` as the first element in
the first witness for `NF*`." -/
theorem thm_5_3_7 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (N₀ N₁ N₂ : Model U L) (h₀ : N₀ ∈ s.S.Kc lam) (h₁ : N₁ ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam)
    (h01 : s.S.le N₀ N₁) (h02 : s.S.le N₀ N₂) (hdisj : N₁.carrier ∩ N₂.carrier = N₀.carrier) :
    (∃ N₃ ∈ s.S.Kc lam, s.NF lam N₀ N₁ N₂ N₃) ∧
    (Decomposable s.S lam (s.K3uq lam) N₀ N₁ → ∃ N₃ ∈ s.S.Kc lam, s.NFStar lam N₀ N₁ N₂ N₃) ∧
    (∀ a ∈ N₁.carrier \ N₀.carrier, tp s.S lam a N₀ N₁ ∈ s.Sbs N₀ →
      ∃ N₃ ∈ s.S.Kc lam, ∃ N₁s ∈ s.S.Kc lam, s.S.le N₁ N₁s ∧
        ∃ αs A B d, s.NFStarWit lam N₀ N₁s N₂ N₃ αs A B d ∧ d 0 = a) := by
  refine ⟨Frame.thm_5_3_7_a hU hs h₀ h₁ h₂ h01 h02 hdisj,
    fun hdec => Frame.thm_5_3_7_b hU hs h₀ h₁ h₂ h02 hdisj hdec,
    fun a ha hab => Frame.thm_5_3_7_c hU hs h₀ h₁ h₂ h01 h02 hdisj ha hab⟩

/-- Prop 5.3.8 (long transitivity for `NF*`). -/
-- DEVIATION (author-confirmed erratum): added `α* < λ⁺` and `M_{a,0}, M_{b,0} ∈ K_λ`. As written,
-- the statement is false for `α* ≥ λ⁺` with strictly increasing chains.
-- DEVIATION (author-confirmed: α* ≠ 0 omitted in the paper): added `0 < α*`.
-- Original text: for `x = a, b` let `⟨M_{x,α} : α ≤ α*⟩` be an increasing continuous sequence of
-- models; suppose `α < α* → NF*(M_{a,α}, M_{a,α+1}, M_{b,α}, M_{b,α+1})`; then
-- `NF*(M_{a,0}, M_{a,α*}, M_{b,0}, M_{b,α*})`.
theorem prop_5_3_8 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (αs : Ordinal.{u}) (hαs : αs < (Order.succ lam).ord) (Ma Mb : Ordinal.{u} → Model U L)
    (h0a : Ma 0 ∈ s.S.Kc lam) (h0b : Mb 0 ∈ s.S.Kc lam) (hpos : 0 < αs)
    (hMa : IsIncreasing s.S.le Ma (Iic αs) ∧ IsContinuous Ma (Iic αs))
    (hMb : IsIncreasing s.S.le Mb (Iic αs) ∧ IsContinuous Mb (Iic αs))
    (h : ∀ α < αs, s.NFStar lam (Ma α) (Ma (α + 1)) (Mb α) (Mb (α + 1))) :
    s.NFStar lam (Ma 0) (Ma αs) (Mb 0) (Mb αs) := by
  classical
  -- `M_{a,0} ≼ M_{b,0}` is read off from the definition of `NF*`
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨h0le, -⟩, -⟩ := id (h 0 hpos)
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h0a
  haveI : Infinite U := hU.infinite
  obtain ⟨hAi, hAc⟩ := hMa
  obtain ⟨hBi, hBc⟩ := hMb
  have hKa := hS.chain_mem_Kc hinf hαs hAi hAc h0a fun ε hε => (h ε hε).2.1
  have hKb := hS.chain_mem_Kc hinf hαs hBi hBc h0b fun ε hε => (h ε hε).2.2.2.1
  have hex : ∀ ε, ∃ p : Ordinal.{u} × (Ordinal.{u} → Model U L) × (Ordinal.{u} → Model U L) ×
      (Ordinal.{u} → U), ε < αs → s.NFStarWit lam (Ma ε) (Ma (ε + 1)) (Mb ε) (Mb (ε + 1))
        p.1 p.2.1 p.2.2.1 p.2.2.2 := fun ε => by
    by_cases hε : ε < αs
    · obtain ⟨-, -, -, -, b, A, B, d, hw⟩ := h ε hε
      exact ⟨(b, A, B, d), fun _ => hw⟩
    · exact ⟨(0, fun _ => Ma 0, fun _ => Ma 0, fun _ => Classical.arbitrary U),
        fun h' => absurd h' hε⟩
  choose p hp using hex
  obtain ⟨σ, h0, hsum, hm, hl⟩ := exists_ordSum fun ε => (p ε).1
  obtain ⟨GA, hGA, hGAD, hGAi, hGAc⟩ := hS.concat_chain (D := fun ε => (p ε).2.1) h0 hsum hm hl
    hAi hAc (fun ε hε => (hKa ε hε).1) (fun ε hε => (hp ε hε).2.1) (fun ε hε => (hp ε hε).2.2.1)
    (fun ε hε => (hp ε hε).2.2.2.2.2.2.2.2.1) (fun ε hε => (hp ε hε).2.2.2.2.2.2.2.2.2.1)
  obtain ⟨GB, hGB, hGBD, hGBi, hGBc⟩ := hS.concat_chain (D := fun ε => (p ε).2.2.1) h0 hsum hm hl
    hBi hBc (fun ε hε => (hKb ε hε).1) (fun ε hε => (hp ε hε).2.2.2.1)
    (fun ε hε => (hp ε hε).2.2.2.2.1) (fun ε hε => (hp ε hε).2.2.2.2.2.2.2.2.2.2.1)
    (fun ε hε => (hp ε hε).2.2.2.2.2.2.2.2.2.2.2.1)
  obtain ⟨E, hE⟩ := ordSum_fun hsum hm fun ε => (p ε).2.2.2
  have hcov := ordSum_cover h0 hsum hl αs
  have hAle : ∀ a ≤ αs, ∀ b ≤ αs, a ≤ b → s.S.le (Ma a) (Ma b) := fun a ha b hb h' => by
    rcases h'.lt_or_eq with h' | h'
    · exact hAi a ha b hb h'
    · rw [h']; exact hS.refl (hKa b hb).1
  have hBle : ∀ a ≤ αs, ∀ b ≤ αs, a ≤ b → s.S.le (Mb a) (Mb b) := fun a ha b hb h' => by
    rcases h'.lt_or_eq with h' | h'
    · exact hBi a ha b hb h'
    · rw [h']; exact hS.refl (hKb b hb).1
  have hab0 : ∀ ε < αs, s.S.le (Ma ε) (Mb ε) := fun ε hε =>
    (hp ε hε).2.2.2.2.2.2.2.1.1
  have hab : ∀ ε ≤ αs, s.S.le (Ma ε) (Mb ε) := by
    intro ε hε
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h' | ⟨c, hc'⟩ | hlim
    · rw [h']; exact h0le
    · rw [Order.succ_eq_add_one] at hc'
      subst hc'
      exact (hp c (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hε)).2.2.2.2.2.2.1.2
    · have hincI : IsIncreasing s.S.le Ma (Iio ε) := fun a ha b hb h' =>
        hAi a ((le_of_lt ha).trans hε) b ((le_of_lt hb).trans hε) h'
      have hcontI : IsContinuous Ma (Iio ε) := fun b hb hl' =>
        hAc b ((le_of_lt hb).trans hε) hl'
      exact hS.smooth ε hlim _ (Mb ε) hincI hcontI
        (fun β hβ => hS.trans (hab0 β (lt_of_lt_of_le hβ hε))
          (hBi β ((le_of_lt hβ).trans hε) ε hε hβ)) (Ma ε)
        ⟨hAc ε hε hlim, fun β hβ => hS.incl _ _ (hAi β ((le_of_lt hβ).trans hε) ε hε hβ)⟩
        (hKa ε hε).1
  have h3 := hab αs le_rfl
  have h1a := hAle 0 zero_le αs le_rfl zero_le
  have h1b := hBle 0 zero_le αs le_rfl zero_le
  have hG0 : ∀ {G : Ordinal.{u} → Model U L} {M : Ordinal.{u} → Model U L},
      (∀ ε ≤ αs, G (σ ε) = M ε) → G 0 = M 0 := fun {G M} hG => by
    have := hG 0 zero_le; rwa [h0] at this
  refine ⟨h0a, hKa αs le_rfl, h0b, hKb αs le_rfl, σ αs, GA, GB, E,
    ordSum_lt hinf h0 hsum hl hαs (fun ε hε => (hp ε hε).1), hGAi, hGAc, hGBi, hGBc,
    ⟨hS.refl h0a.1, hS.trans h1a h3⟩, ⟨h1a, h3⟩, ⟨h0le, h1b⟩, hG0 hGA, hGA αs le_rfl, hG0 hGB,
    hGB αs le_rfl, fun i hi => ?_, fun i hi => ?_, fun i hi => ?_, fun i hi => ?_⟩
  · rcases hi.lt_or_eq with h' | h'
    · obtain ⟨ε, hε, η, hη, e⟩ := hcov i h'
      rw [e, hGAD ε hε η hη.le, hGBD ε hε η hη.le]
      exact (hp ε hε).2.2.2.2.2.2.2.2.2.2.2.2.1 η hη.le
    · rw [h', hGA αs le_rfl, hGB αs le_rfl]; exact h3
  all_goals
    obtain ⟨ε, hε, η, hη, e⟩ := hcov i hi
    have hη1 : η + 1 ≤ (p ε).1 := Order.add_one_le_iff.2 hη
  · rw [e, add_assoc, hGAD ε hε η hη.le, hGAD ε hε (η + 1) hη1, hE ε η hη]
    exact (hp ε hε).2.2.2.2.2.2.2.2.2.2.2.2.2.1 η hη
  · rw [e, add_assoc, hGAD ε hε η hη.le, hGAD ε hε (η + 1) hη1, hE ε η hη]
    exact (hp ε hε).2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 η hη
  · rw [e, add_assoc, hGAD ε hε η hη.le, hGBD ε hε η hη.le, hGBD ε hε (η + 1) hη1, hE ε η hη]
    exact (hp ε hε).2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 η hη

/-- AUX: not in paper. Monotonicity of non-forking in the middle model, with an ambient model
not assumed to be in `K_λ`. -/
theorem Frame.notFork_mono {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {A M B C : Model U L} {x : U} (hU : Room U lam)
    (hnf : s.NotFork lam A B (tp s.S lam x B C)) (hAM : s.S.le A M) (hMB : s.S.le M B)
    (hBC : s.S.le B C) (hx : x ∈ C.carrier) : s.NotFork lam A M (tp s.S lam x M C) := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, -, hAc, hBc, -⟩ := hnf.facts hc.ax3a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hAc
  obtain ⟨W, hW, hsub, hWC⟩ := hS.exists_small hc.ax0b hinf hBc (hS.mem_right hBC)
    (hS.sub hBC) hx
  have hBW : s.S.le B W := hS.le_of_sub hBC hWC (Set.subset_union_left.trans hsub)
  have hxW : x ∈ W.carrier := hsub (Or.inr rfl)
  rw [← tp_eq_of_le hS (show (B, C, x) ∈ s.S.K3 from ⟨hBc.1, hS.mem_right hBC, hBC, hx⟩) hWC hBW
    hxW] at hnf
  have hn := Frame.nf_of_notFork hU hc hnf hW
  have hn' := hc.ax3b A A M B W W W x (hS.refl hAc.1) hAM hMB hBW (hS.refl hW.1)
    (Set.union_subset (hS.sub (hS.trans hMB hBW)) (Set.singleton_subset_iff.2 hxW))
    (hS.refl hW.1) hW hn
  have hMW := hS.trans hMB hBW
  have hK : (M, C, x) ∈ s.S.K3 := ⟨hS.mem_left hMB, hS.mem_right hBC, hS.trans hMB hBC, hx⟩
  exact ⟨x, W, (tp_eq_of_le hS hK hWC hMW hxW).symm, hn'⟩

/-- AUX: not in paper. One more step can be appended to a witness for `NF*` (the case of
Prop 5.3.8 used in Prop 5.3.9(3)). -/
theorem Frame.nfstarWit_snoc {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {N₀ N₁ N₂ N₃ P Q : Model U L} {c : U} {αs : Ordinal.{u}} {A B : Ordinal.{u} → Model U L}
    {d : Ordinal.{u} → U} (hw : s.NFStarWit lam N₀ N₁ N₂ N₃ αs A B d)
    (hκ : αs + 1 < (Order.succ lam).ord) (ht : (N₁, P, c) ∈ s.K3uq lam) (hPQ : s.S.le P Q)
    (h3Q : s.S.le N₃ Q) (hnf : s.NotFork lam N₁ N₃ (tp s.S lam c N₃ Q)) :
    ∃ A' B' d', s.NFStarWit lam N₀ P N₂ Q (αs + 1) A' B' d' ∧ ∀ i < αs, d' i = d i := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, hAinc, hAcont, hBinc, hBcont, ⟨-, h03⟩, ⟨h01, h13⟩, ⟨h02, h23⟩, hA0, hAα, hB0, hBα,
    hAB, hdm, huq, hn⟩ := hw
  have h1P : s.S.le N₁ P := (Frame.K3bs_K3 hc ht.1).2.2.1
  have hAle : ∀ β ≤ αs, s.S.le (A β) N₁ := fun β hβ => by
    rcases hβ.lt_or_eq with h | h
    · rw [← hAα]; exact hAinc β hβ αs (Set.mem_Iic.2 le_rfl) h
    · rw [h, hAα]; exact hS.refl (hS.mem_left h13)
  have hBle : ∀ β ≤ αs, s.S.le (B β) N₃ := fun β hβ => by
    rcases hβ.lt_or_eq with h | h
    · rw [← hBα]; exact hBinc β hβ αs (Set.mem_Iic.2 le_rfl) h
    · rw [h, hBα]; exact hS.refl (hS.mem_right h13)
  let A' : Ordinal.{u} → Model U L := fun β => if β ≤ αs then A β else P
  let B' : Ordinal.{u} → Model U L := fun β => if β ≤ αs then B β else Q
  have hA'l : ∀ β ≤ αs, A' β = A β := fun β h => if_pos h
  have hB'l : ∀ β ≤ αs, B' β = B β := fun β h => if_pos h
  have hnot : ¬ (αs + 1 ≤ αs) := not_le.2 (Order.lt_add_one_iff.2 le_rfl)
  have hA's : A' (αs + 1) = P := if_neg hnot
  have hB's : B' (αs + 1) = Q := if_neg hnot
  have hcases : ∀ β ≤ αs + 1, β ≤ αs ∨ β = αs + 1 := fun β hβ => by
    rcases hβ.lt_or_eq with h | h
    · exact Or.inl (Order.lt_add_one_iff.1 h)
    · exact Or.inr h
  have hnl : ∀ β ≤ αs + 1, Order.IsSuccLimit β → β ≤ αs := fun β hβ hl => by
    rcases hcases β hβ with h | h
    · exact h
    · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax αs)
  have hinc : ∀ (X X' : Ordinal.{u} → Model U L) (Y Z : Model U L),
      IsIncreasing s.S.le X (Iic αs) → (∀ β ≤ αs, X' β = X β) → X' (αs + 1) = Z →
      (∀ β ≤ αs, s.S.le (X β) Y) → s.S.le Y Z → IsIncreasing s.S.le X' (Iic (αs + 1)) := by
    intro X X' Y Z hX e es hl hYZ β hβ γ hγ h
    have hβa : β ≤ αs := Order.lt_add_one_iff.1 (lt_of_lt_of_le h hγ)
    rw [e β hβa]
    rcases hcases γ hγ with h' | h'
    · rw [e γ h']; exact hX β hβa γ h' h
    · rw [h', es]; exact hS.trans (hl β hβa) hYZ
  have hcont : ∀ (X X' : Ordinal.{u} → Model U L), IsContinuous X (Iic αs) →
      (∀ β ≤ αs, X' β = X β) → IsContinuous X' (Iic (αs + 1)) := by
    intro X X' hX e γ hγ hl
    have hγa := hnl γ hγ hl
    rw [e γ hγa, hX γ hγa hl]
    exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγa)]
  refine ⟨A', B', fun i => if i < αs then d i else c, ⟨hκ,
    hinc A A' N₁ P hAinc hA'l hA's hAle h1P, hcont A A' hAcont hA'l,
    hinc B B' N₃ Q hBinc hB'l hB's hBle h3Q, hcont B B' hBcont hB'l,
    ⟨hS.refl (hS.mem_left h01), hS.trans h03 h3Q⟩, ⟨hS.trans h01 h1P, hPQ⟩,
    ⟨h02, hS.trans h23 h3Q⟩, by rw [hA'l 0 zero_le]; exact hA0, hA's,
    by rw [hB'l 0 zero_le]; exact hB0, hB's, fun i hi => ?_, fun i hi => ?_, fun i hi => ?_,
    fun i hi => ?_⟩, fun i hi => if_pos hi⟩
  · rcases hcases i hi with h | h
    · rw [hA'l i h, hB'l i h]; exact hAB i h
    · rw [h, hA's, hB's]; exact hPQ
  all_goals
    have hile : i ≤ αs := Order.lt_add_one_iff.1 hi
    rcases hile.lt_or_eq with h | h
    swap
  · subst h
    simp only [if_neg (lt_irrefl i)]
    rw [hA's, hA'l i le_rfl, hAα]; exact ht.1.2.2.1
  · have h1 : i + 1 ≤ αs := Order.add_one_le_iff.2 h
    simp only [if_pos h]
    rw [hA'l (i + 1) h1, hA'l i hile]; exact hdm i h
  · subst h
    simp only [if_neg (lt_irrefl i)]
    rw [hA's, hA'l i le_rfl, hAα]; exact ht
  · have h1 : i + 1 ≤ αs := Order.add_one_le_iff.2 h
    simp only [if_pos h]
    rw [hA'l (i + 1) h1, hA'l i hile]; exact huq i h
  · subst h
    simp only [if_neg (lt_irrefl i)]
    rw [hB's, hB'l i le_rfl, hA'l i le_rfl, hAα, hBα]; exact hnf
  · have h1 : i + 1 ≤ αs := Order.add_one_le_iff.2 h
    simp only [if_pos h]
    rw [hB'l (i + 1) h1, hB'l i hile, hA'l i hile]; exact hn i h

/-- Prop 5.3.9(1) (monotonicity theorem): `NF*(N₀, N₁, N₂, N₃)` and `N₀ ≼ M₂ ≼ N₂` imply
`NF*(N₀, N₁, M₂, N₃)`. -/
theorem prop_5_3_9_1 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (N₀ N₁ N₂ N₃ M₂ : Model U L) (h : s.NFStar lam N₀ N₁ N₂ N₃) (h₁ : s.S.le N₀ M₂)
    (h₂ : s.S.le M₂ N₂)
    -- PROOF-STAGE CHANGE: added `hne`. For `N₁ = N₀` a witness has length `0`, which forces
    -- `M₂ = N₃`, so the statement is false when `M₂ ≠ N₂` (step: the paper's witness replaces
    -- `N_{2,0}` by `M₂`, and needs `0 < α*`).
    (hne : N₁ ≠ N₀ ∨ M₂ = N₂) : s.NFStar lam N₀ N₁ M₂ N₃ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  rcases hne with hne | hne
  swap
  · rw [hne]; exact h
  obtain ⟨k0, k1, k2, k3, αs, A, B, d, hαs, hAinc, hAcont, hBinc, hBcont, ⟨h00, h03⟩, ⟨h01, h13⟩,
    ⟨h02, h23⟩, hA0, hAα, hB0, hBα, hAB, hdm, huq, hnf⟩ := h
  have hpos : (0 : Ordinal.{u}) < αs := by
    rcases (show (0 : Ordinal.{u}) ≤ αs from zero_le).lt_or_eq with h | h
    · exact h
    · exact absurd (by rw [← hAα, ← h, hA0]) hne
  have hM₂c : M₂ ∈ s.S.Kc lam := ⟨hS.mem_left h₂, le_antisymm
    (by rw [← k2.2]; exact Model.card_le_of_sub (hS.sub h₂))
    (by rw [← k0.2]; exact Model.card_le_of_sub (hS.sub h₁))⟩
  let B' : Ordinal.{u} → Model U L := fun β => if β = 0 then M₂ else B β
  have hB0' : B' 0 = M₂ := if_pos rfl
  have hBn : ∀ β, β ≠ 0 → B' β = B β := fun β h => if_neg h
  have hsucc : ∀ i : Ordinal.{u}, i + 1 ≠ 0 := fun i h =>
    absurd (h ▸ Order.lt_add_one_iff.2 (le_refl i)) (not_lt.2 zero_le)
  have hM₂B : ∀ γ ≤ αs, γ ≠ 0 → s.S.le M₂ (B γ) := fun γ hγ h0 => by
    have : (0 : Ordinal.{u}) < γ := pos_iff_ne_zero.2 h0
    exact hS.trans h₂ (by rw [← hB0]; exact hBinc 0 (Set.mem_Iic.2 zero_le) γ hγ this)
  have h1α : (0 : Ordinal.{u}) + 1 ≤ αs := Order.add_one_le_iff.2 hpos
  refine ⟨k0, k1, hM₂c, k3, αs, A, B', d, hαs, hAinc, hAcont, fun β hβ γ hγ hl => ?_,
    fun γ hγ hl => ?_, ⟨h00, h03⟩, ⟨h01, h13⟩, ⟨h₁, hS.trans h₂ h23⟩, hA0, hAα, hB0',
    by rw [hBn αs hpos.ne']; exact hBα, fun i hi => ?_, hdm, huq, fun i hi => ?_⟩
  · have hγ0 : γ ≠ 0 := fun h => absurd (h ▸ hl) (not_lt.2 zero_le)
    show s.S.le (B' β) (B' γ)
    rw [hBn γ hγ0]
    by_cases hβ0 : β = 0
    · rw [hβ0, hB0']; exact hM₂B γ hγ hγ0
    · rw [hBn β hβ0]; exact hBinc β hβ γ hγ hl
  · have hγ0 : γ ≠ 0 := by
      rintro rfl; exact absurd hl Order.not_isSuccLimit_bot
    show (B' γ).carrier = ⋃ ξ ∈ Iio γ, (B' ξ).carrier
    rw [hBn γ hγ0, hBcont γ hγ hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · have h1γ : (0 : Ordinal.{u}) + 1 < γ := hl.add_one_lt (pos_iff_ne_zero.2 hγ0)
        refine ⟨0 + 1, h1γ, ?_⟩
        rw [hBn _ (hsucc 0)]
        rw [hξ0] at hx
        exact hS.sub (hBinc 0 (Set.mem_Iic.2 zero_le) (0 + 1) ((le_of_lt h1γ).trans hγ)
          (Order.lt_add_one_iff.2 le_rfl)) hx
      · exact ⟨ξ, hξ, by rw [hBn ξ hξ0]; exact hx⟩
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · rw [hξ0, hB0'] at hx
        exact ⟨0, pos_iff_ne_zero.2 hγ0, by rw [hB0]; exact hS.sub h₂ hx⟩
      · exact ⟨ξ, hξ, by rw [hBn ξ hξ0] at hx; exact hx⟩
  · by_cases hi0 : i = 0
    · rw [hi0, hA0, hB0']; exact h₁
    · rw [hBn i hi0]; exact hAB i hi
  · have hi1 := hBn (i + 1) (hsucc i)
    by_cases hi0 : i = 0
    · subst hi0
      rw [hi1, hB0']
      refine Frame.notFork_mono hc hU (hnf 0 hpos) ?_ ?_ ?_ ?_
      · rw [hA0]; exact h₁
      · rw [hB0]; exact h₂
      · exact hBinc 0 (Set.mem_Iic.2 zero_le) (0 + 1) h1α (Order.lt_add_one_iff.2 le_rfl)
      · exact hS.sub (hAB (0 + 1) h1α) (hdm 0 hpos).1
    · rw [hi1, hBn i hi0]; exact hnf i hi

-- DEVIATION (typo fixed to evident intent): the paper's `NF*(M₁, N₁, M₂, N₃)` has base `M₁`;
-- fixed to base `M₀`.
/-- Prop 5.3.9(2): if `NF(M₀, M₁, M₂, M₃)`, then there are `N₁, N₃` with `NF*(M₁, N₁, M₂, N₃)`
[typo: `NF*(M₀, N₁, M₂, N₃)`] and `M₁ ≼ N₁ ≼ N₃ ∧ M₃ ≼ N₃`. -/
theorem prop_5_3_9_2 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (M₀ M₁ M₂ M₃ : Model U L) (h : s.NF lam M₀ M₁ M₂ M₃) :
    ∃ N₁ N₃, s.NFStar lam M₀ N₁ M₂ N₃ ∧ s.S.le M₁ N₁ ∧ s.S.le N₁ N₃ ∧ s.S.le M₃ N₃ := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, N₀', N₁', N₂', N₃', hN0, -, m1, m2, m3, hNF⟩ := h
  rw [hN0] at hNF
  obtain ⟨-, -, n2, -, αs, A, B, d, -, hAinc, -, -, -, -, ⟨-, h13⟩, ⟨h02, h23⟩, hA0, hAα, hB0, hBα,
    -, hdm, -, -⟩ := id hNF
  by_cases hne : N₁' = M₀
  swap
  · exact ⟨N₁', N₃', prop_5_3_9_1 lam hU s hs M₀ N₁' N₂' N₃' M₂ hNF l02 m2 (Or.inl hne), m1, h13,
      m3⟩
  -- `N₁' = M₀`: the witness is trivial, so `N₂' = N₃'`; enlarge the first model
  have hα0 : αs = 0 := by
    by_contra h0
    have hpos : (0 : Ordinal.{u}) < αs := pos_iff_ne_zero.2 h0
    have h1 : (0 : Ordinal.{u}) + 1 ≤ αs := Order.add_one_le_iff.2 hpos
    have hd : d 0 ∈ (A αs).carrier := by
      rcases h1.lt_or_eq with h | h
      · exact hS.sub (hAinc (0 + 1) h1 αs (Set.mem_Iic.2 le_rfl) h) (hdm 0 hpos).1
      · rw [← h]; exact (hdm 0 hpos).1
    rw [hAα, hne, ← hA0] at hd
    exact (hdm 0 hpos).2 hd
  have e : N₂' = N₃' := by rw [← hB0, ← hBα, hα0]
  obtain ⟨X, hX, hlt⟩ := Frame.exists_strict hc k0
  obtain ⟨Ms, hMs, hXMs, -, β, A₂, d₂, hd⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩
    (s.K3uq lam) (fun _ h => h.1) (Frame.K3uq_isoClosed hU hc) hex M₀ X k0 hX hlt).1
  obtain ⟨a, ha, -⟩ := hc.ax2c M₀ k0 X hX hlt
  obtain ⟨h, P, Q, hiso, hid, hQ, hPc, A', B', hw⟩ := Frame.nfstar_core hU hs k0 hMs n2 h02
    (N₁ := M₀) (hS.sub (hS.trans hlt.1 hXMs)) (Set.inter_eq_left.2 (hS.sub h02)) hd
  have hPne : P ≠ M₀ := by
    intro eP
    have haMs : a ∈ Ms.carrier := hS.sub hXMs ha.1
    have hha : h a ∈ M₀.carrier := by rw [← eP]; exact hiso.mapsTo haMs
    have := hiso.injOn (hS.sub (hS.trans hlt.1 hXMs) hha) haMs (hid _ hha)
    exact ha.2 (this ▸ hha)
  obtain ⟨-, -, -, -, -, -, ⟨h0P, hPQ⟩, ⟨-, h2Q⟩, -⟩ := id hw
  have hNFP : s.NFStar lam M₀ P N₂' Q := ⟨k0, hPc, n2, hQ, β, A', B', _, hw⟩
  rw [hne] at m1
  exact ⟨P, Q, prop_5_3_9_1 lam hU s hs M₀ P N₂' Q M₂ hNFP l02 m2 (Or.inl hPne),
    hS.trans m1 h0P, hPQ, hS.trans m3 (by rw [← e]; exact h2Q)⟩

/-- Prop 5.3.9(3): `NF*(M₀, M₁, M₂, M₃) ∧ M₃ ≼ M₃* → NF(M₀, M₁, M₂, M₃*)`. -/
theorem prop_5_3_9_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (M₀ M₁ M₂ M₃ M₃s : Model U L) (h : s.NFStar lam M₀ M₁ M₂ M₃) (h' : s.S.le M₃ M₃s)
    -- PROOF-STAGE CHANGE: added `M₃* ∈ K_λ`; `NF` is a relation on `K_λ` (Def 5.3.2), so the
    -- statement is false otherwise.
    (hK : M₃s ∈ s.S.Kc lam) : s.NF lam M₀ M₁ M₂ M₃s := by
  obtain ⟨⟨hc, -, -, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, αs, A, B, d, hw⟩ := id h
  obtain ⟨hαs, -, -, -, -, -, ⟨h01, h13⟩, ⟨h02, h23⟩, -⟩ := id hw
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  have hM₁s : s.S.le M₁ M₃s := hS.trans h13 h'
  by_cases heq : M₁ = M₃s
  · have e : M₃ = M₃s := hS.po.2.2.1 M₃ M₃s h' (by rw [← heq]; exact h13)
    rw [← e]
    exact ⟨k0, k1, k2, k3, h01, h13, h02, h23, M₀, M₁, M₂, M₃, rfl, hS.refl k0.1, hS.refl k1.1,
      hS.refl k2.1, hS.refl k3.1, h⟩
  obtain ⟨X, hX, hltX⟩ := Frame.exists_strict hc k1
  obtain ⟨b, hb, hbb⟩ := hc.ax2c M₁ k1 X hX hltX
  obtain ⟨M₁s, a, htp, hT⟩ := hex (M₁, X, b) ⟨k1, hX, hb, hbb⟩
  simp only at htp hT
  obtain ⟨q, -, hnq, hres⟩ := hc.ax3f M₁ k1 M₃s hK _ hbb ⟨hM₁s, heq⟩
  obtain ⟨c, Y, rfl, hn⟩ := hnq
  obtain ⟨-, -, hY, hcY, -, hM₃sY, -, -⟩ := hc.ax3a.1 _ _ _ _ hn
  rw [res_tp hS hM₁s] at hres
  have hKa : (M₁, M₁s, a) ∈ s.S.K3c lam :=
    ⟨k1, hT.1.2.1, (Frame.K3bs_K3 hc hT.1).2.2.1, hT.1.2.2.1.1⟩
  have hKc' : (M₁, Y, c) ∈ s.S.K3c lam := ⟨k1, hY, hS.trans hM₁s hM₃sY, hcY.1⟩
  obtain ⟨Q, hQ, hYQ, f, hf, hov, hfa⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf hKa hKc'
    (htp.trans hres.symm)
  obtain ⟨-, -, P, hPQ, hfP⟩ := hf
  have hfix : IsoOn f M₁ M₁ := (IsoOn.refl _).congr fun x hx => (hov.2 x hx).symm
  have hTP : (M₁, P, c) ∈ s.K3uq lam := by
    have h1 : (M₁, P, f a) ∈ s.K3uq lam := Frame.K3uq_isoClosed hU hc _ hT f M₁ P hfP hfix
    rwa [hfa] at h1
  have hcQ : c ∈ Q.carrier := hS.sub hYQ hcY.1
  have hK3 : (M₃s, Q, c) ∈ s.S.K3 := ⟨hK.1, hQ.1, hS.trans hM₃sY hYQ, hcQ⟩
  have hnf0 : s.NotFork lam M₁ M₃s (tp s.S lam c M₃s Q) := by
    rw [← tp_eq_of_le hS hK3 hYQ hM₃sY hcY.1]; exact ⟨c, Y, rfl, hn⟩
  have hnf1 := Frame.notFork_mono hc hU hnf0 h13 h' hK3.2.2.1 hcQ
  have hM₃sQ : s.S.le M₃s Q := hS.trans hM₃sY hYQ
  obtain ⟨A', B', d', hw', -⟩ := Frame.nfstarWit_snoc hc hw
    ((Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))).add_one_lt hαs) hTP hPQ
    (hS.trans h' hM₃sQ) hnf1
  exact ⟨k0, k1, k2, hK, h01, hM₁s, h02, hS.trans h23 h', M₀, P, M₂, Q, rfl, hS.refl k0.1,
    (Frame.K3bs_K3 hc hTP.1).2.2.1, hS.refl k2.1, hM₃sQ, k0, hTP.1.2.1, k2, hQ, _, A', B', d', hw'⟩

/-- Prop 5.3.9(4): `NF` satisfies monotonicity (Def 5.2.1(b)). -/
theorem prop_5_3_9_4 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    OtB s.S lam (s.NF lam) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  rintro M₀ k0 M₁ k1 M₂ k2 M₃ k3 N₀ n0 N₁ n1 N₂ n2 N₃ n3 hR hN0 ⟨-, -, -⟩ ⟨l11, l01, l13⟩
    ⟨l22, l02, l23⟩ ⟨Ns, hM₃Ns, hN₃Ns⟩
  rw [hN0] at l01 l02 ⊢
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  obtain ⟨P₁, P₃, hNFP, m1, -, m3⟩ := prop_5_3_9_2 lam hU s hs M₀ M₁ M₂ M₃ hR
  obtain ⟨-, -, -, -, -, a13, -, a23, -⟩ := id hR
  have hP₃c : P₃ ∈ s.S.Kc lam := hNFP.2.2.2.1
  obtain ⟨W, hW, hsub, hWNs⟩ := hS.exists_hull hc.ax0b hinf (M := M₃) k3 (hS.mem_right hM₃Ns)
    Set.subset_union_left (Set.union_subset (hS.sub hM₃Ns) (hS.sub hN₃Ns))
    (card_union_le k3 n3 hinf)
  have hM₃W : s.S.le M₃ W := hS.le_of_sub hM₃Ns hWNs (Set.subset_union_left.trans hsub)
  have hN₃W : s.S.le N₃ W := hS.le_of_sub hN₃Ns hWNs (Set.subset_union_right.trans hsub)
  obtain ⟨k, N₅, hN₅, hP₃N₅, hk, hkid⟩ := hS.amalg_along hU hc.ax1b k3 hW hP₃c hM₃W
    (IsEmb.of_le hS m3)
  obtain ⟨-, -, -, -, -, -, -, -, Q₀, Q₁, Q₂, Q₃, hQ0, -, q1, q2, q3, hQNF⟩ :=
    prop_5_3_9_3 lam hU s hs M₀ P₁ M₂ P₃ N₅ hNFP hP₃N₅ hN₅
  obtain ⟨-, -, R, hRN₅, hkR⟩ := hk
  obtain ⟨N₃', hkN₃⟩ := exists_isoOn (hkR.injOn.mono (hS.sub hN₃W))
  have hN₃'N₅ : s.S.le N₃' N₅ := hS.trans (hS.iso_le hN₃W hkR hkN₃) hRN₅
  have hk1 : ∀ x ∈ M₃.carrier, k x = x := hkid
  obtain ⟨g, hg, hgk, -⟩ := hkN₃.exists_inv
  have hfixk : ∀ {X : Model U L}, X.carrier ⊆ M₃.carrier → IsoOn k X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hk1 x (hX hx)).symm
  have hfixg : ∀ {X : Model U L}, X.carrier ⊆ M₃.carrier → X.carrier ⊆ N₃.carrier → IsoOn g X X :=
    fun hX hY => (IsoOn.refl _).congr fun x hx => by
      show x = g x
      have := hgk x (hY hx); rw [hk1 x (hX hx)] at this; exact this.symm
  have s1 : N₁.carrier ⊆ M₃.carrier := (hS.sub l11).trans (hS.sub a13)
  have s2 : N₂.carrier ⊆ M₃.carrier := (hS.sub l22).trans (hS.sub a23)
  have s0 : M₀.carrier ⊆ M₃.carrier := (hS.sub l01).trans s1
  have hNF' : s.NF lam M₀ N₁ N₂ N₃' :=
    ⟨k0, n1, n2, ⟨hS.mem_left hN₃'N₅, by rw [hkN₃.card_eq]; exact n3.2⟩, l01,
      hS.iso_le l13 hkN₃ (hfixk s1), l02, hS.iso_le l23 hkN₃ (hfixk s2), Q₀, Q₁, Q₂, Q₃, hQ0,
      by rw [hQ0]; exact hS.refl k0.1, hS.trans l11 (hS.trans m1 q1), hS.trans l22 q2,
      hS.trans hN₃'N₅ q3, hQNF⟩
  exact (prop_5_3_3 lam hU s hs M₀ N₁ N₂ N₃' M₀ N₁ N₂ N₃ g hg
    (hfixg s0 ((hS.sub l01).trans (hS.sub l13))) (hfixg s1 (hS.sub l13)) (hfixg s2 (hS.sub l23))).2
    hNF'

/-! ## 5.4 Weak uniqueness -/

/-- Def 5.4.1: `⊗⁻_R` for `R ⊆ ⁴(K_λ)`: (1) `R(M₀, M₁, M₂, M₃) → M₀ ≼ Mₙ ≼ M₃` (`n = 1, 2`);
(2) weak uniqueness: amalgamations `(f₁ˣ, f₂ˣ, N₃ˣ)` of `N₁, N₂` over `N₀` with
`R(N₀, f₁ˣ[N₁], f₂ˣ[N₂], N₃ˣ)` are `E_{N₀}`-equivalent; (3) if `R(M₀, M₁, M₂, M₃)` and
`f : M₂ → M₄` is an embedding, there is an amalgamation `(g, id_{M₄}, M₅)` of `M₃, M₄` over
`M₂` with `R(f[M₀], g[M₁], M₄, M₅)`. -/
def OtMinus (S : KSys U L) (lam : Cardinal.{u}) (R : QRel U L) : Prop :=
  OtDom S lam R ∧
  (∀ M₀ M₁ M₂ M₃, R M₀ M₁ M₂ M₃ → S.le M₀ M₁ ∧ S.le M₁ M₃ ∧ S.le M₀ M₂ ∧ S.le M₂ M₃) ∧
  (∀ (N₀ N₁ N₂ : Model U L) (A B : Amalg U L),
    IsAmalgIn S lam A.1 A.2.1 A.2.2 N₀ N₁ N₂ → IsAmalgIn S lam B.1 B.2.1 B.2.2 N₀ N₁ N₂ →
    (∃ P Q, IsoOn A.1 N₁ P ∧ IsoOn A.2.1 N₂ Q ∧ R N₀ P Q A.2.2) →
    (∃ P Q, IsoOn B.1 N₁ P ∧ IsoOn B.2.1 N₂ Q ∧ R N₀ P Q B.2.2) →
      AmalgEquiv S lam N₀ N₁ N₂ A B) ∧
  ∀ (M₀ M₁ M₂ M₃ M₄ : Model U L) (f : U → U), R M₀ M₁ M₂ M₃ → IsEmb S f M₂ M₄ →
    -- PROOF-STAGE CHANGE: added `M₄ ∈ K_λ` (`R ⊆ ⁴(K_λ)` in the paper); without it clause (3) is
    -- false for every nonempty `R`, since `M₄ ≼ M₅ ∈ K_λ` fails for `M₄` larger than `λ`.
    M₄ ∈ S.Kc lam →
    -- AGENT-CHOICE: "(g, id_{M₄}, M₅) is an amalgamation of M₃, M₄ over M₂" is read along `f`
    -- (`g ⊇ f`, `M₄ ≼ M₅`); read over `M₂` literally it would force `M₂ ⊆ M₄`.
    ∃ (g : U → U) (M₅ P Q : Model U L), M₅ ∈ S.Kc lam ∧ IsEmb S g M₃ M₅ ∧
      (∀ x ∈ M₂.carrier, g x = f x) ∧ S.le M₄ M₅ ∧
      IsoOn f M₀ P ∧ IsoOn g M₁ Q ∧ R P Q M₄ M₅

/-- AUX: not in paper. `⊗⁻` for a relation with a distinguished element: the form of Def 5.4.1
in which weak uniqueness compares amalgamations that move the *same* element of `N₁`. -/
def OtMinusE (S : KSys U L) (lam : Cardinal.{u}) (R : U → QRel U L) : Prop :=
  (∀ a M₀ M₁ M₂ M₃, R a M₀ M₁ M₂ M₃ → M₀ ∈ S.Kc lam ∧ M₁ ∈ S.Kc lam ∧ M₂ ∈ S.Kc lam ∧
    M₃ ∈ S.Kc lam ∧ S.le M₀ M₁ ∧ S.le M₁ M₃ ∧ S.le M₀ M₂ ∧ S.le M₂ M₃) ∧
  (∀ (a₀ : U) (N₀ N₁ N₂ : Model U L) (A B : Amalg U L), a₀ ∈ N₁.carrier →
    IsAmalgIn S lam A.1 A.2.1 A.2.2 N₀ N₁ N₂ → IsAmalgIn S lam B.1 B.2.1 B.2.2 N₀ N₁ N₂ →
    (∃ P Q, IsoOn A.1 N₁ P ∧ IsoOn A.2.1 N₂ Q ∧ R (A.1 a₀) N₀ P Q A.2.2) →
    (∃ P Q, IsoOn B.1 N₁ P ∧ IsoOn B.2.1 N₂ Q ∧ R (B.1 a₀) N₀ P Q B.2.2) →
      AmalgEquiv S lam N₀ N₁ N₂ A B) ∧
  ∀ (a : U) (M₀ M₁ M₂ M₃ M₄ : Model U L) (f : U → U), R a M₀ M₁ M₂ M₃ → IsEmb S f M₂ M₄ →
    M₄ ∈ S.Kc lam → ∃ (g : U → U) (M₅ P Q : Model U L), M₅ ∈ S.Kc lam ∧ IsEmb S g M₃ M₅ ∧
      (∀ x ∈ M₂.carrier, g x = f x) ∧ S.le M₄ M₅ ∧ IsoOn f M₀ P ∧ IsoOn g M₁ Q ∧
      R (g a) P Q M₄ M₅

/-- AUX: not in paper. The invariant of the construction in Prop 5.4.4. -/
def TransInv (S : KSys U L) (lam : Cardinal.{u}) (N₁ Na Nb : Ordinal.{u} → Model U L)
    (fa fb : Ordinal.{u} → U → U) (α : Ordinal.{u})
    (c : Ordinal.{u} → Model U L × (U → U) × (U → U)) : Prop :=
  (∀ β ≤ α, (c β).1 ∈ S.K ∧ (β < (Order.succ lam).ord → (c β).1 ∈ S.Kc lam)) ∧
  (c 0).1 = Na 0 ∧ (∀ x ∈ (Na 0).carrier, (c 0).2.1 x = x ∧ (c 0).2.2 x = x) ∧
  IsIncreasing S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
  (∀ β ≤ α, IsEmb S (c β).2.1 (Na β) (c β).1 ∧ IsEmb S (c β).2.2 (Nb β) (c β).1) ∧
  (∀ β ≤ α, ∀ x ∈ (N₁ β).carrier, (c β).2.1 (fa β x) = (c β).2.2 (fb β x)) ∧
  FunIncreasing (fun β => (c β).2.1) Na (Iic α) ∧ FunIncreasing (fun β => (c β).2.2) Nb (Iic α)

/-- AUX: not in paper. The construction in the proof of Prop 5.4.4, for a relation with a
distinguished element (`d_α` is the element of step `α`). -/
theorem transit_weak {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {R : U → QRel U L} (hR : OtMinusE S lam R)
    {αs : Ordinal.{u}} (hαs : αs ≤ (Order.succ lam).ord)
    {N₁ Na Nb : Ordinal.{u} → Model U L}
    (hNai : IsIncreasing S.le Na (Iic αs)) (hNac : IsContinuous Na (Iic αs))
    (hNbi : IsIncreasing S.le Nb (Iic αs)) (hNbc : IsContinuous Nb (Iic αs))
    (hN₁i : IsIncreasing S.le N₁ (Iic αs)) (hN₁c : IsContinuous N₁ (Iic αs)) (h0 : Na 0 = Nb 0)
    {fa fb : Ordinal.{u} → U → U}
    (hf : ∀ α ≤ αs, IsEmb S (fa α) (N₁ α) (Na α) ∧ IsEmb S (fb α) (N₁ α) (Nb α))
    (hf0 : ∀ x ∈ (N₁ 0).carrier, fa 0 x = x ∧ fb 0 x = x)
    (hfai : FunIncreasing fa N₁ (Iic αs)) (hfbi : FunIncreasing fb N₁ (Iic αs))
    (hK0 : Na 0 ∈ S.Kc lam) {d : Ordinal.{u} → U}
    (hdm : ∀ α < αs, d α ∈ (N₁ (α + 1)).carrier)
    (hRa : ∀ α < αs, ∃ P Q, IsoOn (fa α) (N₁ α) P ∧ IsoOn (fa (α + 1)) (N₁ (α + 1)) Q ∧
      R (fa (α + 1) (d α)) P Q (Na α) (Na (α + 1)))
    (hRb : ∀ α < αs, ∃ P Q, IsoOn (fb α) (N₁ α) P ∧ IsoOn (fb (α + 1)) (N₁ (α + 1)) Q ∧
      R (fb (α + 1) (d α)) P Q (Nb α) (Nb (α + 1))) :
    ∃ (Z : Model U L) (ga gb : U → U), IsEmb S ga (Na αs) Z ∧ IsEmb S gb (Nb αs) Z ∧
      (∀ x ∈ (N₁ αs).carrier, ga (fa αs x) = gb (fb αs x)) ∧ (∀ x ∈ (Na 0).carrier, ga x = x) ∧
      (∀ x ∈ (Nb 0).carrier, gb x = x) ∧ (αs < (Order.succ lam).ord → Z ∈ S.Kc lam) := by
  classical
  obtain ⟨hdom, huq, hext⟩ := hR
  have hne : Nonempty (Model U L × (U → U) × (U → U)) := ⟨(Na 0, id, id)⟩
  suffices H : ∃ c, ∀ α ≤ αs, TransInv S lam N₁ Na Nb fa fb α c by
    obtain ⟨c, hc⟩ := H
    obtain ⟨h1, h2, h3, -, -, h6, h7, h8, h9⟩ := hc αs le_rfl
    have hfix : ∀ {G : Ordinal.{u} → U → U} {M : Ordinal.{u} → Model U L},
        FunIncreasing G M (Iic αs) → (∀ x ∈ (M 0).carrier, G 0 x = x) →
        ∀ x ∈ (M 0).carrier, G αs x = x := fun {G M} hi h0' x hx => by
      rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h | h
      · rw [hi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) h x hx]; exact h0' x hx
      · rw [← h]; exact h0' x hx
