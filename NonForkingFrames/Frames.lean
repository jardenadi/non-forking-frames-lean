/-- AUX: not in paper. A run depends only on its values below its length. -/
theorem Frame.IsRun.congr {s : Frame U L} {lam : Cardinal.{u}}
    {D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U}
    {G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L}
    {γ : Ordinal.{u}} {A B B' : Ordinal.{u} → Model U L} (h : s.IsRun lam D G γ A B)
    (e : ∀ β < γ, B β = B' β) : s.IsRun lam D G γ A B' := by
  obtain ⟨h0, hL, hSt⟩ := h
  refine ⟨fun hp => ?_, fun α hα hl => ?_, fun α hα => ?_⟩
  · rw [← e 0 hp]; exact h0 hp
  · obtain ⟨u1, u2⟩ := hL α hα hl
    refine ⟨u1, ?_⟩
    rw [← e α hα]
    exact u2.congr' fun β hβ => e β (lt_trans hβ hα)
  · have hα1 : α < γ := (Order.lt_add_one_iff.2 le_rfl).trans hα
    obtain ⟨k, hlt, hd, hsub, hDB, hB⟩ := hSt α hα
    refine ⟨k, hlt, hd, hsub, by rw [← e α hα1]; exact hDB, ?_⟩
    rw [← e _ hα, hB]
    congr 2
    funext i
    exact e _ (lt_of_le_of_lt (mem_Iic.1 i.2) hα1)

