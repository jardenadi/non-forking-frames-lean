  haveI : Nonempty (Model U L) := ⟨N₁⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (Order.succ lam).ord Inv
    (fun α c c' h hi hα => by
      obtain ⟨a, b, d⟩ := hi hα
      exact ⟨by rw [← h 0 zero_le]; exact a,
        b.congr fun β hβ => h β (Order.lt_add_one_iff.1 hβ), by rw [← h α le_rfl]; exact d⟩)
    (fun α hαle c prev => by
      by_cases hακ : α < (Order.succ lam).ord
      swap
      · exact ⟨N₁, fun h => absurd h hακ⟩
      rcases Ordinal.zero_or_succ_or_isSuccLimit α with rfl | ⟨ξ, hξ⟩ | hl
      · refine ⟨N₁, fun _ => ?_⟩
        have e : (fun β => if β < (0 : Ordinal.{u}) then c β else N₁) 0 = N₁ := if_neg (lt_irrefl _)
        refine ⟨e, ⟨fun _ => ?_, fun β hβ hl' => ?_, fun β hβ => ?_⟩, ?_⟩
        · rw [e, hA0]; exact ⟨h₀, h₁, h01.1⟩
        · have : β = 0 := le_antisymm (Order.lt_add_one_iff.1 hβ) zero_le
