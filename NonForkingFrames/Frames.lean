import NonForkingFrames.AEC
import Mathlib.SetTheory.Cardinal.Pigeonhole

/-!
# Semi-good frames: statements

Formalization of: A. Jarden and S. Shelah, Non-forking frames in abstract elementary
classes, Ann. Pure Appl. Logic 164 (2013), no. 3, 135-191. Text formalized: arXiv:0901.0852v2.

Statements (Stage 1) of Jarden–Shelah, "Non-forking frames in abstract elementary classes".
The general infrastructure (models, AECs, Galois types, …) is in
`NonForkingFrames.AEC`; see the module comment there for the numbering and
encoding conventions.
-/

open FirstOrder FirstOrder.Language Cardinal Set

universe u

namespace SemiGoodFrames

noncomputable section

variable {U : Type u} {L : Language.{u, u}}

/-! ════════════════════════════════════════════════════════════════════════════
    PART 1 : SECTION 1  — statements (the definitions of Section 1 are in AEC.lean)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Remark 1.0.4(1): "If `K` is any class of models for a fixed vocabulary, then `(K, ⊆)`
satisfies Axioms b, d, e of AEC (Definition 1.0.3.1)." -/
theorem rem_1_0_4_1 (K : Set (Model U L)) :
    (subKSys K).AxPO ∧ (subKSys K).AxIncl ∧
      (∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (subKSys K).AxSmooth δ) ∧ (subKSys K).AxCoh := by
  refine ⟨⟨fun M N h => ⟨h.1, h.2.1⟩, fun M hM => ⟨hM, hM, IsSubstr.refl M⟩,
    fun M N h h' => h.2.2.eq_of_carrier h'.2.2.sub,
    fun M N P h h' => ⟨h.1, h'.2.1, h.2.2.trans h'.2.2⟩⟩, fun M N h => h.2.2, ?_,
    fun M₀ M₁ M₂ h01 _ h02 h12 => ⟨h02.1, h12.1, h01⟩⟩
  intro δ hδ M N hinc _ hle N' hU hN'
  have h0 : (0 : Ordinal.{u}) < δ := by simpa using hδ.bot_lt
  refine ⟨hN', (hle 0 h0).2.1, IsSubstr.of_union (I := Iio δ) (M := M) ?_
    (fun α hα => hU.2 α hα) (fun α hα => (hle α hα).2.2) ?_⟩
  · rw [hU.1]; exact Set.iUnion₂_subset fun α hα => (hle α hα).2.2.sub
  · intro n x hx
    obtain ⟨α, hα, h⟩ := exists_mem_chain hδ
      (fun α hα β hβ hαβ => (hinc α hα β hβ hαβ).2.2.sub) x (fun i => hU.1 ▸ hx i)
    exact ⟨α, hα, h⟩

/-- Remark 1.0.4(2): "Suppose `(K, ≼)` is an AEC. If `(K, ⊆)` satisfies Axiom 1.0.3.1.c, then
`(K, ⊆)` is an AEC." -/
theorem rem_1_0_4_2 (S : KSys U L) (hS : IsAEC S)
    (hc : ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (subKSys S.K).AxUnion δ) :
    IsAEC (subKSys S.K) := by
  obtain ⟨po, incl, smooth, coh⟩ := rem_1_0_4_1 S.K
  refine ⟨?_, po, incl, hc, smooth, coh, ?_⟩
  · intro M₀ M₁ N₁ f hM₁ h01 hf
    have hN₁ := hS.iso_mem hM₁ hf
    obtain ⟨M₀', hM₀'⟩ := exists_isoOn (hf.injOn.mono h01.2.2.sub)
    exact ⟨hN₁, M₀', hM₀', hS.iso_mem h01.1 hM₀', hN₁, h01.2.2.image hf hM₀'⟩
  · obtain ⟨κ, hκ⟩ := hS.lst
    refine ⟨κ, fun N hN A hA => ?_⟩
    obtain ⟨M, hM, hAM, hMN, hc⟩ := hκ N hN A hA
    exact ⟨M, hM, hAM, ⟨hM, hN, hS.incl M N hMN⟩, hc⟩

/-- Remark 1.0.4(3): "If `(K, ≼)` is an AEC and `K' ⊆ K` then `(K', ≼ ↾ K')` satisfies Axioms
b, d, e of AEC (Definition 1.0.3.1)." -/
theorem rem_1_0_4_3 (S : KSys U L) (hS : IsAEC S) (K' : Set (Model U L)) (hK' : K' ⊆ S.K) :
    (S.restrict K').AxPO ∧ (S.restrict K').AxIncl ∧
      (∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (S.restrict K').AxSmooth δ) ∧
        (S.restrict K').AxCoh := by
  refine ⟨⟨fun M N h => ⟨h.1, h.2.1⟩, fun M hM => ⟨hM, hM, hS.refl (hK' hM)⟩,
    fun M N h h' => hS.po.2.2.1 M N h.2.2 h'.2.2,
    fun M N P h h' => ⟨h.1, h'.2.1, hS.trans h.2.2 h'.2.2⟩⟩, fun M N h => hS.incl M N h.2.2, ?_,
    fun M₀ M₁ M₂ h01 h12 h02 h12' => ⟨h02.1, h12'.1, hS.coh _ _ _ h01 h12 h02.2.2 h12'.2.2⟩⟩
  intro δ hδ M N hinc hcont hle N' hU hN'
  have h0 : (0 : Ordinal.{u}) < δ := by simpa using hδ.bot_lt
  exact ⟨hN', (hle 0 h0).2.1, hS.smooth δ hδ M N (fun α hα β hβ h => (hinc α hα β hβ h).2.2)
    hcont (fun α hα => (hle α hα).2.2) N' hU (hK' hN')⟩

/-- Fact 1.0.18 ([Sh:h].II Lemma 1.23, cited, not proved in the paper): "Let `(K, ≼)` be an AEC
in `λ`. Then (1) `(K, ≼)^up` is an AEC. (2) `(K^up)_λ = K`. (3) `≼^up ↾ K` is `≼`.
(4) `LST(K, ≼)^up = λ`." -/
-- CITED: [Sh:h].II Lemma 1.23.
-- AGENT-CHOICE (statement false as written): if `K = ∅` then `LST(K^up) = 0 ≠ λ`; we add
-- `K ≠ ∅` (`hne`).
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.fact_1_0_18`.
def Fact_1_0_18 : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAECIn S lam)
    (hne : S.K.Nonempty),
    IsAEC S.up ∧ S.up.Kc lam = S.K ∧ (∀ M ∈ S.K, ∀ N ∈ S.K, (S.up.le M N ↔ S.le M N)) ∧
      S.up.LST = lam

/-- Fact 1.0.18, clauses widened by the author ([Sh:h].II Lemma 1.23, cited, not proved in the
paper). Original text of Fact 1.0.18: "Let `(K, ≼)` be an AEC in `λ`. Then (1) `(K, ≼)^up` is an
AEC. (2) `(K^up)_λ = K`. (3) `≼^up ↾ K` is `≼`. (4) `LST(K, ≼)^up = λ`." Clauses added (confirmed
by the author to be part of the source): for an AEC `(K, ≼)`, (i) a `≼`-directed union of models of
`K` is a model of `K`, each member `≼` the union (so `K^up ⊆ K`); (ii) `≼^up ⊆ ≼` (the extended
relation agrees with the original one), for models of `K^up` of any size. Used in the paper's
Section 2.1 ("`K⁺ ⊆ K`") and in Cor 11.1.6, Thm 11.1.7, Thm 1.0.2. -/
-- CITED: [Sh:h].II Lemma 1.23 (clauses (i), (ii) confirmed by the author; see docs/METHOD.md).
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.fact_1_0_18_up`.
def Fact_1_0_18_up : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (S : KSys U L) (hS : IsAEC S),
    (∀ M, InUp S M → M ∈ S.K ∧ ∀ (I : Type u) (r : I → I → Prop) (Ms : I → Model U L),
      IsPreorder I r → Nonempty I → (∀ s t, ∃ w, r s w ∧ r t w) →
      M.carrier = (⋃ s, (Ms s).carrier) → (∀ s, IsSubstr (Ms s) M) →
      (∀ s t, r s t → S.le (Ms s) (Ms t)) → ∀ s, S.le (Ms s) M) ∧
    (∀ M N, LeUp S M N → S.le M N)

/-- AUX: not in paper. `(·)^up` is monotone: a system for a smaller relation is a system for a
larger one. -/
theorem InUp.mono {S S' : KSys U L} (hle : ∀ M N, S.le M N → S'.le M N) {M : Model U L}
    (h : InUp S M) : InUp S' M := by
  obtain ⟨I, r, hr, hne, hdir, Ms, hU, hsub, hle'⟩ := h
  exact ⟨I, r, hr, hne, hdir, Ms, hU, hsub, fun s t h => hle _ _ (hle' s t h)⟩

/-- AUX: not in paper. -/
theorem LeUp.mono {S S' : KSys U L} (hle : ∀ M N, S.le M N → S'.le M N) {M N : Model U L}
    (h : LeUp S M N) : LeUp S' M N := by
  obtain ⟨hM, hN, J, r, hr, hne, hdir, I, hI, hIdir, Ms, Ns, hMU, hMs, hNU, hNs, hNle, hMle⟩ := h
  exact ⟨hM.mono hle, hN.mono hle, J, r, hr, hne, hdir, I, hI, hIdir, Ms, Ns, hMU, hMs, hNU, hNs,
    fun s t h => hle _ _ (hNle s t h), fun s hs t ht h => ⟨hle _ _ (hMle s hs t ht h).1,
      hle _ _ (hMle s hs t ht h).2⟩⟩


-- AGENT-CHOICE (added hypothesis): `(K, ≼)` is an AEC (`hS`), the ambient assumption of Section 1;
-- the same holds for Prop 1.0.23(2),(3), Prop 1.0.30, Thm 1.0.32 and Remark 2.5.4.
/-- Prop 1.0.23(1): "For every `M, N₀, N₁ ∈ K_λ`, `a ∈ N₀ - M` and `b ∈ N₁ - M`,
`(M, N₀, a) E* (M, N₁, b)` iff there is an amalgamation `(f₀, f₁, N)` of `N₀, N₁` over `M` such
that `f₀(a) = f₁(b)`." (Ambient assumption: `(K, ≼)` is an AEC, see docs/METHOD.md.) -/
-- AGENT-CHOICE: the amalgam `N` is only required to be in `K` (no `LST ≤ λ` is assumed, so an
-- amalgam in `K_λ` cannot be obtained from the `N₂ ∈ K` of `E*`).
theorem prop_1_0_23_1 (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (M N₀ N₁ : Model U L) (a b : U) (hM : M ∈ S.Kc lam) (hN₀ : N₀ ∈ S.Kc lam)
    (hN₁ : N₁ ∈ S.Kc lam) (hMN₀ : S.le M N₀) (hMN₁ : S.le M N₁)
    (ha : a ∈ N₀.carrier \ M.carrier) (hb : b ∈ N₁.carrier \ M.carrier) :
    EStar S lam (M, N₀, a) (M, N₁, b) ↔
      ∃ (f₀ f₁ : U → U) (N : Model U L), IsAmalg S f₀ f₁ N M N₀ N₁ ∧ f₀ a = f₁ b := by
  constructor
  · rintro ⟨-, -, -, N₂, -, hle, f, hf, hover, hfa⟩
    exact ⟨f, id, N₂, ⟨hf, IsEmb.of_le hS hle, hover,
      ⟨fun x hx => ⟨hS.sub hMN₁ hx, (hover.1 hx).2⟩, fun _ _ => rfl⟩⟩, hfa⟩
  · rintro ⟨f₀, f₁, N, ⟨hf₀, hf₁, ho₀, ho₁⟩, hab⟩
    obtain ⟨-, -, P, hPN, hf₁P⟩ := hf₁
    obtain ⟨g, hg, hgf, -⟩ := hf₁P.exists_inv
    obtain ⟨h, N₂, hN₂, hhg, hN₁N₂, hN₂K, -⟩ := hS.rename hU.infinite ∅ hPN hg
      (by rw [Set.empty_union]; change N₁.card < #U; rw [hN₁.2]; exact hU.2)
    have key : ∀ y ∈ N₁.carrier, h (f₁ y) = y := fun y hy => by
      rw [hhg _ (hf₁P.mapsTo hy), hgf y hy]
    refine ⟨⟨hS.mem_left hMN₀, hN₀.1, hMN₀, ha.1⟩, ⟨hS.mem_left hMN₁, hN₁.1, hMN₁, hb.1⟩, rfl, N₂,
      hN₂K, hN₁N₂, h ∘ f₀, hf₀.comp_iso hS hN₂,
      ⟨fun x hx => ⟨(ho₀.1 hx).1, hS.sub hN₁N₂ (ho₁.1 hx).1⟩, fun x hx => ?_⟩, ?_⟩
    · have hx1 : x ∈ N₁.carrier := (ho₁.1 hx).1
      change h (f₀ x) = x
      rw [ho₀.2 x hx]
      have := key x hx1
      rwa [ho₁.2 x hx] at this
    · change h (f₀ a) = b
      rw [hab, key b hb.1]

-- PROOF-STAGE CHANGE: symmetry is stated for triples `t = (M, N₀, a)` with `‖N₀‖ < #U`. The
-- proof renames the amalgam around `N₀` inside `U`, which needs room outside `N₀`; for a model
-- as large as `U` itself symmetry can fail in the encoding (step: renaming `N₂` along `f⁻¹`).
/-- Prop 1.0.23(2): "`E*` is a reflexive, symmetric relation" (on `K³`). -/
theorem prop_1_0_23_2 (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S) :
    (∀ t ∈ S.K3, EStar S lam t t) ∧
      (∀ t t', t.2.1.card < #U → EStar S lam t t' → EStar S lam t' t) := by
  refine ⟨fun t ht => ?_, fun t t' hsmall ht => ?_⟩
  · refine ⟨ht, ht, rfl, t.2.1, ht.2.1, hS.refl ht.2.1, id, IsEmb.of_le hS (hS.refl ht.2.1),
      ⟨fun x hx => ⟨hS.sub ht.2.2.1 hx, hS.sub ht.2.2.1 hx⟩, fun _ _ => rfl⟩, rfl⟩
  · obtain ⟨ht, ht', h1, N₂, -, hle, f, hf, hover, hfa⟩ := ht
    obtain ⟨-, -, P, hPN₂, hfP⟩ := hf
    obtain ⟨g, hg, hgf, -⟩ := hfP.exists_inv
    obtain ⟨h, N₂', hN₂', hhg, hN₀N₂', hN₂'K, -⟩ := hS.rename hU.infinite ∅ hPN₂ hg
      (by rw [Set.empty_union]; exact hsmall)
    have key : ∀ y ∈ t.2.1.carrier, h (f y) = y := fun y hy => by
      rw [hhg _ (hfP.mapsTo hy), hgf y hy]
    refine ⟨ht', ht, h1.symm, N₂', hN₂'K, hN₀N₂', h,
      ((IsEmb.of_le hS hle).comp_iso hS hN₂').congr (fun _ _ => rfl), ⟨fun x hx => ?_, ?_⟩, ?_⟩
    · have hx0 : x ∈ t.2.1.carrier := hS.sub ht.2.2.1 (h1 ▸ hx)
      exact ⟨hS.sub ht'.2.2.1 hx, hS.sub hN₀N₂' hx0⟩
    · intro x hx
      have hx0 : x ∈ t.2.1.carrier := hS.sub ht.2.2.1 (h1 ▸ hx)
      have := key x hx0
      rwa [hover.2 x (h1 ▸ hx)] at this
    · rw [← hfa, key _ ht.2.2.2]

-- AGENT-CHOICE: `E*_λ` (not defined separately) is read as `E*` computed in the AEC
-- `(K_λ, ≼ ↾ K_λ)` on `K³_λ`; the alternative (`E*` of `K` on `K³_λ`) would need `LST ≤ λ`.
/-- Prop 1.0.23(3): "If `(K_λ, ≼ ↾ K_λ)` satisfies the amalgamation property, then `E*_λ` is an
equivalence relation" (`E*_λ` = `E*` of `(K_λ, ≼ ↾ K_λ)`). -/
theorem prop_1_0_23_3 (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (hAP : AP S lam) :
    let E := EStar (S.restrict (S.Kc lam)) lam
    (∀ t ∈ S.K3c lam, E t t) ∧
      (∀ t ∈ S.K3c lam, ∀ t' ∈ S.K3c lam, E t t' → E t' t) ∧
      (∀ t ∈ S.K3c lam, ∀ t' ∈ S.K3c lam, ∀ t'' ∈ S.K3c lam, E t t' → E t' t'' → E t t'') := by
  intro E
  have toR : ∀ {f : U → U} {M N : Model U L}, IsEmb S f M N → M ∈ S.Kc lam → N ∈ S.Kc lam →
      IsEmb (S.restrict (S.Kc lam)) f M N := by
    intro f M N hf hM hN
    obtain ⟨-, -, M', hle, hiso⟩ := hf
    exact ⟨hM, hN, M', ⟨⟨hS.mem_left hle, by rw [Model.card, ← Model.card, hiso.card_eq, hM.2]⟩,
      hN, hle⟩, hiso⟩
  have ofR : ∀ {f : U → U} {M N : Model U L}, IsEmb (S.restrict (S.Kc lam)) f M N →
      IsEmb S f M N := by
    rintro f M N ⟨hM, hN, M', hle, hiso⟩; exact ⟨hM.1, hN.1, M', hle.2.2, hiso⟩
  have K3R : ∀ t ∈ S.K3c lam, t ∈ (S.restrict (S.Kc lam)).K3 := fun t ht =>
    ⟨ht.1, ht.2.1, ⟨ht.1, ht.2.1, ht.2.2.1⟩, ht.2.2.2⟩
  refine ⟨fun t ht => ?_, fun t ht t' ht' h => ?_, fun t ht t' ht' t'' ht'' h h' => ?_⟩
  · exact ⟨K3R t ht, K3R t ht, rfl, t.2.1, ht.2.1, ⟨ht.2.1, ht.2.1, hS.refl ht.2.1.1⟩, id,
      toR (IsEmb.of_le hS (hS.refl ht.2.1.1)) ht.2.1 ht.2.1,
      ⟨fun x hx => ⟨hS.sub ht.2.2.1 hx, hS.sub ht.2.2.1 hx⟩, fun _ _ => rfl⟩, rfl⟩
  · obtain ⟨-, -, h1, N₂, hN₂, hle, f, hf, hover, hfa⟩ := h
    obtain ⟨-, -, P, hPN₂, hfP⟩ := ofR hf
    obtain ⟨g, hg, hgf, -⟩ := hfP.exists_inv
    obtain ⟨h, N₂', hN₂', hhg, hN₀N₂', hN₂'K, -⟩ := hS.rename hU.infinite ∅ hPN₂ hg
      (by rw [Set.empty_union]; change t.2.1.card < #U; rw [ht.2.1.2]; exact hU.2)
    have hN₂'c : N₂' ∈ S.Kc lam := ⟨hN₂'K, by rw [hN₂'.card_eq]; exact hN₂.2⟩
    have key : ∀ y ∈ t.2.1.carrier, h (f y) = y := fun y hy => by
      rw [hhg _ (hfP.mapsTo hy), hgf y hy]
    refine ⟨K3R t' ht', K3R t ht, h1.symm, N₂', hN₂'c, ⟨ht.2.1, hN₂'c, hN₀N₂'⟩, h,
      toR (((IsEmb.of_le hS hle.2.2).comp_iso hS hN₂').congr (fun _ _ => rfl)) ht'.2.1 hN₂'c,
      ⟨fun x hx => ?_, ?_⟩, ?_⟩
    · have hx0 : x ∈ t.2.1.carrier := hS.sub ht.2.2.1 (h1 ▸ hx)
      exact ⟨hS.sub ht'.2.2.1 hx, hS.sub hN₀N₂' hx0⟩
    · intro x hx
      have hx0 : x ∈ t.2.1.carrier := hS.sub ht.2.2.1 (h1 ▸ hx)
      have := key x hx0
      rwa [hover.2 x (h1 ▸ hx)] at this
    · rw [← hfa, key _ ht.2.2.2]
  · obtain ⟨-, -, h1, N₂, hN₂, hle, f, hf, hover, hfa⟩ := h
    obtain ⟨-, -, h1', N₄, hN₄, hle', g, hg, hover', hgb⟩ := h'
    obtain ⟨k, N₅, hN₅, hN₄N₅, hk, hkg⟩ :=
      hS.amalg_along hU hAP ht'.2.1 hN₂ hN₄ hle.2.2 (ofR hg)
    have hkf : IsEmb S (k ∘ f) t.2.1 N₅ := (ofR hf).comp hS hk
    refine ⟨K3R t ht, K3R t'' ht'', h1'.trans h1, N₅, hN₅,
      ⟨ht''.2.1, hN₅, hS.trans hle'.2.2 hN₄N₅⟩, k ∘ f, toR hkf ht.2.1 hN₅,
      ⟨fun x hx => ?_, fun x hx => ?_⟩, ?_⟩
    · have hx' : x ∈ t'.1.carrier := h1 ▸ hx
      exact ⟨(hover.1 hx).1, hS.sub hN₄N₅ (hover'.1 hx').2⟩
    · have hx' : x ∈ t'.1.carrier := h1 ▸ hx
      have hx1 : x ∈ t'.2.1.carrier := (hover'.1 hx').1
      change k (f x) = x
      rw [hover.2 x hx, hkg x hx1, hover'.2 x hx']
    · change k (f t.2.2) = t''.2.2
      rw [hfa, hkg _ ht'.2.2.2, hgb]

/-- AUX: not in paper. Equal types of triples in `K³_λ` are realized by an amalgam in `K_λ`:
the `E`-chain (through models of any size) reduces to one `E*`-step of `(K_λ, ≼ ↾ K_λ)`. -/
theorem tp_eq_small {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hAP : AP S lam) (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {M N N' : Model U L} {a a' : U}
    (hK : (M, N, a) ∈ S.K3c lam) (hK' : (M, N', a') ∈ S.K3c lam)
    (h : tp S lam a M N = tp S lam a' M N') :
    ∃ N₂ ∈ S.Kc lam, S.le N' N₂ ∧ ∃ f : U → U, IsEmb S f N N₂ ∧ Over f N N₂ M.carrier ∧
      f a = a' := by
  obtain ⟨Erefl, Esymm, Etrans⟩ := prop_1_0_23_3 lam hU S hS hAP
  set R := S.restrict (S.Kc lam)
  have hM : M ∈ S.Kc lam := hK.1
  let small : Tri U L → Model U L → Prop := fun t W =>
    W ∈ S.Kc lam ∧ S.le t.1 W ∧ S.le W t.2.1 ∧ t.2.2 ∈ W.carrier
  have K3of : ∀ {W x}, W ∈ S.Kc lam → S.le M W → x ∈ W.carrier → (M, W, x) ∈ S.K3c lam :=
    fun hW hMW hx => ⟨hM, hW, hMW, hx⟩
  have K3ofR : ∀ {W x}, W ∈ S.Kc lam → S.le M W → x ∈ W.carrier → (M, W, x) ∈ R.K3 :=
    fun hW hMW hx => ⟨hM, hW, ⟨hM, hW, hMW⟩, hx⟩
  have embR : ∀ {f : U → U} {X Y : Model U L}, IsEmb S f X Y → X ∈ S.Kc lam → Y ∈ S.Kc lam →
      IsEmb R f X Y := by
    intro f X Y hf hX hY
    obtain ⟨-, -, P, hP, hfP⟩ := hf
    exact ⟨hX, hY, P, ⟨⟨hS.mem_left hP, by rw [hfP.card_eq]; exact hX.2⟩, hY, hP⟩, hfP⟩
  have key : ∀ t t' : Tri U L, ERel S lam t t' → t.1 = M → t ∈ S.K3 →
      ∀ W W', small t W → small t' W' → EStar R lam (M, W, t.2.2) (M, W', t'.2.2) := by
    intro t t' hE
    induction hE with
    | rel x y hxy =>
      intro hx _ W W' hW hW'
      obtain ⟨-, -, h1, N₂, -, hle, f, hf, hover, hfa⟩ := hxy
      have hy : y.1 = M := h1.trans hx
      obtain ⟨-, -, P, hPN₂, hfP⟩ := hf.restrict hS hW.2.2.1
      have hPc : P ∈ S.Kc lam := ⟨hS.mem_left hPN₂, by rw [hfP.card_eq]; exact hW.1.2⟩
      obtain ⟨V, hV, hsubV, hVN₂⟩ := hS.exists_hull hlst hinf hW'.1 (hS.mem_right hle)
        Set.subset_union_right
        (Set.union_subset (hS.sub hPN₂) ((hS.sub hW'.2.2.1).trans (hS.sub hle)))
        (card_union_le hPc hW'.1 hinf)
      have hPV : S.le P V := hS.le_of_sub hPN₂ hVN₂ (Set.subset_union_left.trans hsubV)
      have hW'V : S.le W' V :=
        hS.le_of_sub (hS.trans hW'.2.2.1 hle) hVN₂ (Set.subset_union_right.trans hsubV)
      have hMW : M.carrier ⊆ W.carrier := hS.sub (hx ▸ hW.2.1)
      refine ⟨K3ofR hW.1 (hx ▸ hW.2.1) hW.2.2.2, K3ofR hW'.1 (hy ▸ hW'.2.1) hW'.2.2.2, rfl, V, hV,
        ⟨hW'.1, hV, hW'V⟩, f, ⟨hW.1, hV, P, ⟨hPc, hV, hPV⟩, hfP⟩,
        ⟨fun z hz => ⟨hMW hz, ?_⟩, fun z hz => hover.2 z (hx ▸ hz)⟩, hfa⟩
      have := hfP.mapsTo (hMW hz)
      rw [hover.2 z (hx ▸ hz)] at this
      exact Set.subset_union_left.trans hsubV this
    | refl x =>
      intro hx hK3 W W' hW hW'
      obtain ⟨V, hV, hsubV, hVN⟩ := hS.exists_hull hlst hinf hW'.1 hK3.2.1
        Set.subset_union_right (Set.union_subset (hS.sub hW.2.2.1) (hS.sub hW'.2.2.1))
        (card_union_le hW.1 hW'.1 hinf)
      have hWV : S.le W V := hS.le_of_sub hW.2.2.1 hVN (Set.subset_union_left.trans hsubV)
      have hW'V : S.le W' V := hS.le_of_sub hW'.2.2.1 hVN (Set.subset_union_right.trans hsubV)
      exact ⟨K3ofR hW.1 (hx ▸ hW.2.1) hW.2.2.2, K3ofR hW'.1 (hx ▸ hW'.2.1) hW'.2.2.2, rfl, V, hV,
        ⟨hW'.1, hV, hW'V⟩, id, embR (IsEmb.of_le hS hWV) hW.1 hV,
        ⟨fun z hz => ⟨hS.sub (hx ▸ hW.2.1) hz, hS.sub (hS.trans (hx ▸ hW.2.1) hWV) hz⟩,
          fun _ _ => rfl⟩, rfl⟩
    | symm x y hxy ih =>
      intro hy hK3 W W' hW hW'
      have hx : x.1 = M := (ERel.fst hxy).symm.trans hy
      have := ih hx ((ERel.K3_iff hxy).2 hK3) W' W hW' hW
      exact Esymm _ (K3of hW'.1 (hx ▸ hW'.2.1) hW'.2.2.2) _
        (K3of hW.1 (hy ▸ hW.2.1) hW.2.2.2) this
    | trans x y z hxy hyz ih₁ ih₂ =>
      intro hx hK3 W W' hW hW'
      have hy : y.1 = M := (ERel.fst hxy).trans hx
      have hyK : y ∈ S.K3 := (ERel.K3_iff hxy).1 hK3
      obtain ⟨Y, hY, hMY, hYy, hyY, -⟩ := hS.exists_small_tp hlst hinf hM
        (show (M, y.2.1, y.2.2) ∈ S.K3 from hy ▸ hyK)
      have hsY : small y Y := ⟨hY, hy ▸ hMY, hYy, hyY⟩
      have hz : z.1 = M := (ERel.fst hyz).trans hy
      exact Etrans _ (K3of hW.1 (hx ▸ hW.2.1) hW.2.2.2) _ (K3of hY hMY hyY) _
        (K3of hW'.1 (hz ▸ hW'.2.1) hW'.2.2.2) (ih₁ hx hK3 W Y hW hsY)
        (ih₂ hy hyK Y W' hsY hW')
  have hE := key (M, N, a) (M, N', a') (tp_eq_iff.1 h) rfl ⟨hM.1, hK.2.1.1, hK.2.2.1, hK.2.2.2⟩
    N N' ⟨hK.2.1, hK.2.2.1, hS.refl hK.2.1.1, hK.2.2.2⟩
    ⟨hK'.2.1, hK'.2.2.1, hS.refl hK'.2.1.1, hK'.2.2.2⟩
  obtain ⟨-, -, -, N₂, hN₂, hle, f, ⟨-, -, P, hP, hfP⟩, hover, hfa⟩ := hE
  exact ⟨N₂, hN₂, hle.2.2, f, ⟨hK.2.1.1, hN₂.1, P, hP.2.2, hfP⟩, hover, hfa⟩

/-- Prop 1.0.30 (a version of Fodor's Lemma): there are no `⟨M_α⟩, ⟨N_α⟩, ⟨f_α⟩` (`α < λ⁺`)
and `S` such that (1) both sequences are `≼`-increasing continuous in `K_λ`, (2) each
`f_α : M_α → N_α` is a `≼`-embedding, (3) `⟨f_α⟩` is increasing continuous, (4) `S` is a
stationary subset of `λ⁺`, (5) for every `α ∈ S` there is `a ∈ M_{α+1} - M_α` with
`f_{α+1}(a) ∈ N_α`. -/
-- PROOF-STAGE CHANGE: hypothesis `ℵ₀ ≤ λ` added. For finite `λ` the ordinal `λ⁺` has no club, so
-- every subset (e.g. `∅`) is stationary and constant sequences are a counterexample (step: the
-- club of closure points needs `λ⁺` regular and infinite).
theorem prop_1_0_30 (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (hinf : ℵ₀ ≤ lam) :
    ¬ ∃ (M N : Ordinal.{u} → Model U L) (f : Ordinal.{u} → U → U) (T : Set Ordinal.{u}),
      IsIncCont S M (Iio (Order.succ lam).ord) (S.Kc lam) ∧
      IsIncCont S N (Iio (Order.succ lam).ord) (S.Kc lam) ∧
      (∀ α < (Order.succ lam).ord, IsEmb S (f α) (M α) (N α)) ∧
      FunIncreasing f M (Iio (Order.succ lam).ord) ∧
      FunContinuous f M (Iio (Order.succ lam).ord) ∧
      IsStationaryIn (Order.succ lam).ord T ∧
      ∀ α ∈ T, ∃ a ∈ (M (α + 1)).carrier \ (M α).carrier, f (α + 1) a ∈ (N α).carrier := by
  rintro ⟨M, N, f, T, ⟨hMinc, -, -⟩, ⟨hNinc, hNcont, hNK⟩, hemb, hfinc, -, hT, h5⟩
  classical
  set κ := (Order.succ lam).ord with hκ
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hcof : κ.cof = Order.succ lam := hreg.cof_ord
  have hκlim : Order.IsSuccLimit κ :=
    Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  let A : Ordinal.{u} → Set U := fun α => f α '' (M α).carrier
  have hAmono : ∀ α β, α ≤ β → β < κ → A α ⊆ A β := by
    intro α β hαβ hβ
    rcases hαβ.lt_or_eq with h | h
    · rintro _ ⟨x, hx, rfl⟩
      refine ⟨x, hS.sub (hMinc α (lt_trans h hβ) β hβ h) hx, ?_⟩
      exact hfinc α (lt_trans h hβ) β hβ h x hx
    · rw [h]
  let Ms : Set U := ⋃ α ∈ Iio κ, A α
  have hg : ∀ δ < κ, ∃ γ < κ, (N δ).carrier ∩ Ms ⊆ A γ := by
    intro δ hδ
    have hx : ∀ x : ↥((N δ).carrier ∩ Ms), ∃ γ < κ, (x : U) ∈ A γ := fun x => by
      obtain ⟨γ, hγ, h⟩ := Set.mem_iUnion₂.1 x.2.2; exact ⟨γ, hγ, h⟩
    choose c hc hcx using hx
    refine ⟨⨆ x, c x, Ordinal.iSup_lt_of_lt_cof ?_ hc, fun y hy => ?_⟩
    · rw [hcof]
      refine lt_of_le_of_lt (Cardinal.mk_le_mk_of_subset Set.inter_subset_left) ?_
      change (N δ).card < Order.succ lam
      rw [(hNK δ hδ).2]; exact Order.lt_succ lam
    · exact hAmono _ _ (Ordinal.le_iSup c ⟨y, hy⟩) (Ordinal.iSup_lt_of_lt_cof (by
        rw [hcof]
        refine lt_of_le_of_lt (Cardinal.mk_le_mk_of_subset Set.inter_subset_left) ?_
        change (N δ).card < Order.succ lam
        rw [(hNK δ hδ).2]; exact Order.lt_succ lam) hc) (hcx ⟨y, hy⟩)
  let G : Ordinal.{u} → Ordinal.{u} := fun δ => if h : δ < κ then (hg δ h).choose else 0
  have hG : ∀ δ < κ, G δ < κ ∧ (N δ).carrier ∩ Ms ⊆ A (G δ) := fun δ h => by
    simp only [G, h, dite_true]; exact (hg δ h).choose_spec
  -- the club of closure points
  let C : Set Ordinal.{u} :=
    {γ | γ < κ ∧ Order.IsSuccLimit γ ∧ ∀ β < γ, (N β).carrier ∩ Ms ⊆ A γ}
  have hNmono : ∀ β δ, β ≤ δ → δ < κ → (N β).carrier ⊆ (N δ).carrier := fun β δ h hδ => by
    rcases h.lt_or_eq with h | h
    · exact hS.sub (hNinc β (lt_trans h hδ) δ hδ h)
    · rw [h]
  have hclub : IsClubIn κ C := by
    refine ⟨fun γ hγ => hγ.1, fun α hα => ?_, fun γ hγ hγl hcof' => ?_⟩
    · let sq : ℕ → Ordinal.{u} := fun n => Nat.rec (α + 1) (fun _ x => max x (G x) + 1) n
      have hsq0 : sq 0 = α + 1 := rfl
      have hsqS : ∀ n, sq (n + 1) = max (sq n) (G (sq n)) + 1 := fun n => rfl
      have hsqκ : ∀ n, sq n < κ := by
        intro n
        induction n with
        | zero => exact hκlim.add_one_lt hα
        | succ n ih => rw [hsqS]; exact hκlim.add_one_lt (max_lt ih (hG _ ih).1)
      have hsqlt : ∀ n, sq n < sq (n + 1) := fun n => by
        rw [hsqS]; exact Order.lt_add_one_iff.2 (le_max_left _ _)
      let sq' : ULift.{u} ℕ → Ordinal.{u} := fun n => sq n.down
      let γ := ⨆ n, sq' n
      have hγκ : γ < κ := by
        refine Ordinal.iSup_lt_of_lt_cof ?_ (fun n => hsqκ n.down)
        rw [hcof, Cardinal.mk_uLift, Cardinal.mk_nat, Cardinal.lift_aleph0]
        exact lt_of_le_of_lt hinf (Order.lt_succ lam)
      have hle : ∀ n, sq n ≤ γ := fun n => Ordinal.le_iSup sq' ⟨n⟩
      have hexists : ∀ β < γ, ∃ n, β < sq n := fun β hβ => by
        obtain ⟨n, hn⟩ := (Ordinal.lt_iSup_iff).1 hβ
        exact ⟨n.down, hn⟩
      refine ⟨γ, ⟨hγκ, ?_, ?_⟩, lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) (hle 0)⟩
      · refine Ordinal.isSuccLimit_iff.2 ⟨?_, Order.isSuccPrelimit_of_succ_lt fun b hb => ?_⟩
        · exact (lt_of_lt_of_le (lt_of_le_of_lt (show (0 : Ordinal.{u}) ≤ α from zero_le) (Order.lt_add_one_iff.2 le_rfl))
            (hle 0)).ne'
        · obtain ⟨n, hn⟩ := hexists b hb
          rw [Order.succ_eq_add_one]
          exact lt_of_le_of_lt (Order.add_one_le_iff.2 hn) (lt_of_lt_of_le (hsqlt n) (hle (n + 1)))
      · intro β hβ
        obtain ⟨n, hn⟩ := hexists β hβ
        refine (Set.inter_subset_inter_left _ (hNmono β (sq n) hn.le (hsqκ n))).trans ?_
        refine (hG _ (hsqκ n)).2.trans (hAmono _ _ ?_ hγκ)
        exact (le_max_right _ _).trans ((Order.lt_add_one_iff.2 le_rfl).le.trans
          ((hsqS n) ▸ hle (n + 1)))
    · refine ⟨hγ, hγl, fun β hβ => ?_⟩
      obtain ⟨γ', hγ'C, hβγ', hγ'γ⟩ := hcof' β hβ
      exact (hγ'C.2.2 β hβγ').trans (hAmono _ _ hγ'γ.le hγ)
  obtain ⟨γ, hγT, hγC⟩ := hT.2 C hclub
  obtain ⟨hγκ, hγl, hγcl⟩ := hγC
  obtain ⟨a, ha, hfa⟩ := h5 γ hγT
  have hγ1 : γ + 1 < κ := hκlim.add_one_lt hγκ
  have hγγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
  have hfaMs : f (γ + 1) a ∈ Ms := Set.mem_iUnion₂.2 ⟨γ + 1, hγ1, a, ha.1, rfl⟩
  have hfaA : f (γ + 1) a ∈ A γ := by
    rw [hNcont γ hγκ hγl] at hfa
    obtain ⟨β, hβ, hfaβ⟩ := Set.mem_iUnion₂.1 hfa
    exact hγcl β hβ ⟨hfaβ, hfaMs⟩
  obtain ⟨y, hy, hfy⟩ := hfaA
  have hfy' : f (γ + 1) y = f (γ + 1) a := by
    rw [← hfy]; exact hfinc γ hγκ (γ + 1) hγ1 hγγ1 y hy
  have hyM : y ∈ (M (γ + 1)).carrier := hS.sub (hMinc γ hγκ (γ + 1) hγ1 hγγ1) hy
  have := (hemb (γ + 1) hγ1).injOn hyM ha.1 hfy'
  exact ha.2 (this ▸ hy)

/-- AUX: not in paper. Consequence of Prop 1.0.30 with `f_α = id` and `S = λ⁺`: there are no
increasing continuous `⟨M_α⟩, ⟨N_α⟩` (`α < λ⁺`) in `K_λ` with `M_α ≼ N_α` and some element of
`M_{α+1} − M_α` in `N_α` for every `α`. -/
theorem no_long_chain (lam : Cardinal.{u}) (hU : Room U lam) {S : KSys U L} (hS : IsAEC S)
    (hinf : ℵ₀ ≤ lam) {M N : Ordinal.{u} → Model U L}
    (hM : IsIncCont S M (Iio (Order.succ lam).ord) (S.Kc lam))
    (hN : IsIncCont S N (Iio (Order.succ lam).ord) (S.Kc lam))
    (hMN : ∀ α < (Order.succ lam).ord, S.le (M α) (N α))
    (hstep : ∀ α < (Order.succ lam).ord,
      ∃ x ∈ (M (α + 1)).carrier \ (M α).carrier, x ∈ (N α).carrier) : False := by
  refine prop_1_0_30 lam hU S hS hinf ⟨M, N, fun _ => id, Iio (Order.succ lam).ord, hM, hN,
    fun α hα => IsEmb.of_le hS (hMN α hα), fun _ _ _ _ _ _ _ => rfl, ?_,
    ⟨subset_rfl, fun C hC => ?_⟩, fun α hα => hstep α hα⟩
  · intro β hβ hβl x hx
    rw [hM.2.1 β hβ hβl] at hx
    obtain ⟨α, hα, hxα⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨α, hα, hxα, rfl⟩
  · obtain ⟨β, hβC, -⟩ := hC.2.1 0 (Cardinal.isSuccLimit_ord
      (hinf.trans (Order.le_succ lam))).bot_lt
    exact ⟨β, hC.1 hβC, hβC⟩

/-- Prop 1.0.31 (saturativity = model homogeneity; by [Sh:h].II Lemma 1.14): "Let `(K, ≼)` be an
AEC such that `K_λ` satisfies the amalgamation property, and `LST(K, ≼) ≤ λ`. Let
`M ∈ K_{λ⁺}`. Then `M` is saturated in `λ⁺` over `λ` iff `M` is homogenous in `λ⁺` over
`λ`." -/
-- CITED: proved in the paper only by reference to the literature.
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.prop_1_0_31`.
def Prop_1_0_31 : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (hAP : AP S lam) (hLST : S.LST ≤ lam) (M : Model U L) (hM : M ∈ S.Kc (Order.succ lam)),
    Saturated S lam M ↔ Homogeneous S lam M

/-- Thm 1.0.32(1) (uniqueness of the saturated model; [Sh:h].II Lemma 1.14): "Suppose
`(K_λ, ≼ ↾ K_λ)` satisfies the amalgamation property and `LST(K, ≼) ≤ λ`. Suppose `N ∈ K_λ`
and for `n = 1, 2`, `N ≼ Mₙ`, and `Mₙ` is saturated in `λ⁺` over `λ`. Then `M₁, M₂` are
isomorphic over `N`." -/
-- CITED: proved in the paper only by reference to the literature.
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.thm_1_0_32_1`.
def Thm_1_0_32_1 : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (hAP : AP S lam) (hLST : S.LST ≤ lam) (N M₁ M₂ : Model U L) (hN : N ∈ S.Kc lam)
    (h₁ : S.le N M₁) (h₂ : S.le N M₂) (hs₁ : Saturated S lam M₁) (hs₂ : Saturated S lam M₂),
    ∃ f : U → U, IsoOn f M₁ M₂ ∧ Over f M₁ M₂ N.carrier

/-- Thm 1.0.32(2): "If `M₁, M₂` are saturated in `λ⁺` over `λ` and `(K_λ, ≼ ↾ K_λ)` satisfies
the joint embedding property, then `M₁, M₂` are isomorphic" (same standing hypotheses as (1)). -/
-- CITED: proved in the paper only by reference to the literature.
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.thm_1_0_32_2`.
def Thm_1_0_32_2 : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (hS : IsAEC S)
    (hAP : AP S lam) (hLST : S.LST ≤ lam) (M₁ M₂ : Model U L) (hs₁ : Saturated S lam M₁)
    (hs₂ : Saturated S lam M₂) (hJEP : JEP S lam),
    ∃ f : U → U, IsoOn f M₁ M₂

/-! ════════════════════════════════════════════════════════════════════════════
    PART 2 : SECTION 2  (Non-forking frames)
    ════════════════════════════════════════════════════════════════════════════ -/

/-! ## 2.1 The plan -/

/-- Def 2.1.1 / 2.1.3: the data of a frame `s = (K, ≼, S^bs, ⨿)`. `Sbs M` is `S^bs(M)` (a set of
Galois types); `nf M₀ M₁ a M₃` is `⨿(M₀, M₁, a, M₃)`. -/
structure Frame (U : Type u) (L : Language.{u, u}) where
  /-- the pair `(K, ≼)` -/
  S : KSys U L
  /-- `S^bs` -/
  Sbs : Model U L → Set (Set (Tri U L))
  /-- `⨿` -/
  nf : Model U L → Model U L → U → Model U L → Prop

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

/-- Def 2.1.1(3)(b), interpretation: "`p ∈ S^bs(N)` does not fork over `M`" means "for some
`a, N⁺` we have `p = tp(a, N, N⁺)` and `⨿(M, N, a, N⁺)`". -/
def NotFork (M N : Model U L) (p : Set (Tri U L)) : Prop :=
  ∃ (a : U) (N' : Model U L), p = tp s.S lam a N N' ∧ s.nf M N a N'

/-- `p₂` is the non-forking extension of `p₁` (used in Def 2.5.5, 7.1.4): `p₂` does not fork
over `M₁` and `p₂ ↾ M₁ = p₁`. -/
def IsNFExt (M₁ M₂ : Model U L) (p₂ p₁ : Set (Tri U L)) : Prop :=
  s.NotFork lam M₁ M₂ p₂ ∧ res s.S lam p₂ M₁ = p₁

/-- Def 2.1.1(0)(a): `(K, ≼)` is an AEC. -/
def Ax0a : Prop := IsAEC s.S

/-- Def 2.1.1(0)(b): `LST(K, ≼) ≤ λ`. -/
def Ax0b : Prop := s.S.LST ≤ lam

/-- Def 2.1.1(1)(a): `(K_λ, ≼ ↾ K_λ)` satisfies the joint embedding property. -/
def Ax1a : Prop := JEP s.S lam

/-- Def 2.1.1(1)(b): `(K_λ, ≼ ↾ K_λ)` satisfies the amalgamation property. -/
def Ax1b : Prop := AP s.S lam

-- AGENT-CHOICE (reading): "no ≼-maximal model in K_λ" is maximality inside `(K_λ, ≼ ↾ K_λ)`.
/-- Def 2.1.1(1)(c): there is no `≼`-maximal model in `K_λ` (maximality inside
`(K_λ, ≼ ↾ K_λ)`, see docs/METHOD.md). -/
def Ax1c : Prop := ∀ M ∈ s.S.Kc lam, ¬ IsMaximal (s.S.restrict (s.S.Kc lam)) M

/-- Def 2.1.1(2)(a): `S^bs(M) ⊆ S^na(M) = {tp(a, M, N) : M ≺ N ∈ K_λ, a ∈ N - M}`. -/
def Ax2a : Prop :=
  ∀ M ∈ s.S.Kc lam, s.Sbs M ⊆
    {p | ∃ (N : Model U L) (a : U), s.S.lt M N ∧ N ∈ s.S.Kc lam ∧
      a ∈ N.carrier \ M.carrier ∧ p = tp s.S lam a M N}

-- AGENT-CHOICE (added hypothesis): `M ∈ K_λ`, since `S^bs` is a function with domain `K_λ`; the
-- image `f[M]` is any `M'` with `IsoOn f M M'` (it is unique).
/-- Def 2.1.1(2)(b): `S^bs` respects isomorphisms. -/
def Ax2b : Prop :=
  ∀ (M N N' M' : Model U L) (a : U) (f : U → U), M ∈ s.S.Kc lam →
    tp s.S lam a M N ∈ s.Sbs M → IsoOn f N N' → IsoOn f M M' →
      tp s.S lam (f a) M' N' ∈ s.Sbs M'

/-- Def 2.1.1(2)(c): density of the basic types. -/
def Ax2c : Prop :=
  ∀ M ∈ s.S.Kc lam, ∀ N ∈ s.S.Kc lam, s.S.lt M N →
    ∃ a ∈ N.carrier \ M.carrier, tp s.S lam a M N ∈ s.Sbs M

/-- Def 2.1.1(2)(d) with bound `μ`: `|S^bs(M)| ≤ μ` for `M ∈ K_λ`. Basic stability is
`μ = λ`; basic almost stability (Def 2.1.3) is `μ = λ⁺`. -/
def BasicStab (μ : Cardinal.{u}) : Prop := ∀ M ∈ s.S.Kc lam, #(s.Sbs M) ≤ μ

-- PROOF-STAGE CHANGE: the presupposition `M₀ ≼ M₁ ≼ M₃` (needed for `tp(a, Mₙ, M₃)` to be a
-- type over `Mₙ`, and used in every application of monotonicity) is made explicit (step: Prop
-- 2.1.2, applying 3(b) needs `M₀ ≼ M₁` and `M₁ ≼ M₃`).
/-- Def 2.1.1(3)(a): `⨿` is a set of quadruples `(M₀, M₁, a, M₃)` with `M₀, M₁, M₃ ∈ K_λ`,
`a ∈ M₃ - M₁`, `tp(a, Mₙ, M₃) ∈ S^bs(Mₙ)` (`n = 0, 1`), and it respects isomorphisms. -/
def Ax3a : Prop :=
  (∀ M₀ M₁ a M₃, s.nf M₀ M₁ a M₃ →
    M₀ ∈ s.S.Kc lam ∧ M₁ ∈ s.S.Kc lam ∧ M₃ ∈ s.S.Kc lam ∧ a ∈ M₃.carrier \ M₁.carrier ∧
      s.S.le M₀ M₁ ∧ s.S.le M₁ M₃ ∧
      tp s.S lam a M₀ M₃ ∈ s.Sbs M₀ ∧ tp s.S lam a M₁ M₃ ∈ s.Sbs M₁) ∧
  (∀ (M₀ M₁ M₃ M₀' M₁' M₃' : Model U L) (a : U) (f : U → U), s.nf M₀ M₁ a M₃ →
    IsoOn f M₃ M₃' → IsoOn f M₀ M₀' → IsoOn f M₁ M₁' → s.nf M₀' M₁' (f a) M₃')

/-- Def 2.1.1(3)(b), monotonicity: if `M₀ ≼ M₀* ≼ M₁* ≼ M₁ ≼ M₃ ≼ M₃*` and
`M₁* ∪ {a} ⊆ M₃** ≼ M₃*`, then `⨿(M₀, M₁, a, M₃) → ⨿(M₀*, M₁*, a, M₃**)`. -/
-- PROOF-STAGE CHANGE: added `M₃** ∈ K_λ`. Without it 3(b) contradicts 3(a) (which puts every
-- ⨿-quadruple in `K_λ`) as soon as `K` has a model larger than `λ` above `M₃`, so no frame
-- could satisfy both (step: Prop 2.1.2, monotonicity into the amalgam).
def Ax3b : Prop :=
  ∀ (M₀ M₀s M₁s M₁ M₃ M₃s M₃ss : Model U L) (a : U),
    s.S.le M₀ M₀s → s.S.le M₀s M₁s → s.S.le M₁s M₁ → s.S.le M₁ M₃ → s.S.le M₃ M₃s →
    M₁s.carrier ∪ {a} ⊆ M₃ss.carrier → s.S.le M₃ss M₃s → M₃ss ∈ s.S.Kc lam →
    s.nf M₀ M₁ a M₃ → s.nf M₀s M₁s a M₃ss

/-- Def 2.1.1(3)(c), local character: for every limit `δ < λ⁺`, if `⟨M_α : α ≤ δ+1⟩` is an
increasing continuous sequence in `K_λ` and `tp(a, M_δ, M_{δ+1}) ∈ S^bs(M_δ)`, then for some
`α < δ`, `tp(a, M_δ, M_{δ+1})` does not fork over `M_α`. -/
def Ax3c : Prop :=
  ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → δ < (Order.succ lam).ord →
    ∀ M : Ordinal.{u} → Model U L, IsIncCont s.S M (Iic (δ + 1)) (s.S.Kc lam) →
      ∀ a : U, tp s.S lam a (M δ) (M (δ + 1)) ∈ s.Sbs (M δ) →
        ∃ α < δ, s.NotFork lam (M α) (M δ) (tp s.S lam a (M δ) (M (δ + 1)))

/-- Def 2.1.1(3)(d), uniqueness of the non-forking extension. -/
def Ax3d : Prop :=
  ∀ M ∈ s.S.Kc lam, ∀ N ∈ s.S.Kc lam, s.S.le M N → ∀ p ∈ s.Sbs N, ∀ q ∈ s.Sbs N,
    s.NotFork lam M N p → s.NotFork lam M N q → res s.S lam p M = res s.S lam q M → p = q

/-- Def 2.1.1(3)(e), symmetry. -/
def Ax3e : Prop :=
  ∀ M₀ ∈ s.S.Kc lam, ∀ M₁ ∈ s.S.Kc lam, ∀ M₃ ∈ s.S.Kc lam, ∀ a₁ a₂ : U,
    s.S.le M₀ M₁ → s.S.le M₁ M₃ → a₁ ∈ M₁.carrier → tp s.S lam a₁ M₀ M₃ ∈ s.Sbs M₀ →
    s.NotFork lam M₀ M₁ (tp s.S lam a₂ M₁ M₃) →
      ∃ M₂ ∈ s.S.Kc lam, ∃ M₃s ∈ s.S.Kc lam, a₂ ∈ M₂.carrier ∧ s.S.le M₀ M₂ ∧
        s.S.le M₂ M₃s ∧ s.S.le M₃ M₃s ∧ s.NotFork lam M₀ M₂ (tp s.S lam a₁ M₂ M₃s)

/-- Def 2.1.1(3)(f), existence of a non-forking extension. -/
def Ax3f : Prop :=
  ∀ M ∈ s.S.Kc lam, ∀ N ∈ s.S.Kc lam, ∀ p ∈ s.Sbs M, s.S.lt M N →
    ∃ q ∈ s.Sbs N, s.NotFork lam M N q ∧ res s.S lam q M = p

/-- Def 2.1.1(3)(g), continuity (`δ` limit by the convention on the letter `δ`). -/
def Ax3g : Prop :=
  ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → δ < (Order.succ lam).ord →
    ∀ M : Ordinal.{u} → Model U L, IsIncCont s.S M (Iic δ) (s.S.Kc lam) →
      ∀ p ∈ SAll s.S lam (M δ),
        (∀ α < δ, s.NotFork lam (M 0) (M α) (res s.S lam p (M α))) →
          p ∈ s.Sbs (M δ) ∧ s.NotFork lam (M 0) (M δ) p

/-- ENCODING. The axioms of Def 2.1.1 shared by all variants of frames in the paper: all of them
except (2)(d) basic stability, (3)(c) local character, (3)(e) symmetry, (3)(g) continuity. -/
structure Core : Prop where
  ax0a : s.Ax0a
  ax0b : s.Ax0b lam
  ax1a : s.Ax1a lam
  ax1b : s.Ax1b lam
  ax1c : s.Ax1c lam
  ax2a : s.Ax2a lam
  ax2b : s.Ax2b lam
  ax2c : s.Ax2c lam
  ax3a : s.Ax3a lam
  ax3b : s.Ax3b lam
  ax3d : s.Ax3d lam
  ax3f : s.Ax3f lam

/-- Def 2.1.1: `s` is a good `λ`-frame. -/
def IsGood : Prop :=
  s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam ∧ s.BasicStab lam lam ∧ s.Ax3c lam

/-- Def 2.1.3: `s` is a semi-good `λ`-frame: the axioms of a good `λ`-frame with basic
stability replaced by basic almost stability `|S^bs(M)| ≤ λ⁺`. -/
def IsSemiGood : Prop :=
  s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam ∧ s.BasicStab lam (Order.succ lam) ∧ s.Ax3c lam

/-- Def 2.1.3: `s` is a semi-good frame: a semi-good `λ`-frame for some `λ`. -/
def IsSemiGoodSome : Prop := ∃ lam : Cardinal.{u}, s.IsSemiGood lam

/-- "Semi-good `λ`-frame, except local character" (Def 2.6.5, 2.6.6, Thm 2.6.8). -/
def IsSemiGoodExceptLC : Prop :=
  s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam ∧ s.BasicStab lam (Order.succ lam)

end Frame

/-- AUX: not in paper. The invariant used in the proof of Prop 2.1.2: some `W ∈ K_λ` with
`M₁ ∪ {x} ⊆ W ≼ N` has `⨿(M₀, M₁, x, W)`. -/
def Frame.NfWit (s : Frame U L) (lam : Cardinal.{u}) (M₀ M₁ N : Model U L) (x : U) : Prop :=
  ∃ W ∈ s.S.Kc lam, M₁.carrier ∪ {x} ⊆ W.carrier ∧ s.S.le W N ∧ s.nf M₀ M₁ x W

/-- AUX: not in paper. An isomorphism fixing `M₁` pointwise transports `⨿(M₀, M₁, x, W)`. -/
theorem Frame.nf_iso_fix {s : Frame U L} {lam : Cardinal.{u}} (hS : IsAEC s.S)
    (h3a : s.Ax3a lam) {M₀ M₁ W W' : Model U L} {x : U} {f : U → U} (hnf : s.nf M₀ M₁ x W)
    (hf : IsoOn f W W') (hfix : ∀ y ∈ M₁.carrier, f y = y) : s.nf M₀ M₁ (f x) W' := by
  have h01 := (h3a.1 _ _ _ _ hnf).2.2.2.2.1
  exact h3a.2 M₀ M₁ W M₀ M₁ W' x f hnf hf
    ((IsoOn.refl M₀).congr fun y hy => (hfix y (hS.sub h01 hy)).symm)
    ((IsoOn.refl M₁).congr fun y hy => (hfix y hy).symm)

/-- AUX: not in paper. The invariant `NfWit` is preserved by one `E*`-step, in both directions. -/
theorem Frame.nfWit_step {s : Frame U L} {lam : Cardinal.{u}} (hS : IsAEC s.S)
    (h0b : s.Ax0b lam) (h3a : s.Ax3a lam) (h3b : s.Ax3b lam) {M₀ M₁ N N' : Model U L}
    {x y : U} (hE : EStar s.S lam (M₁, N, x) (M₁, N', y)) :
    s.NfWit lam M₀ M₁ N x ↔ s.NfWit lam M₀ M₁ N' y := by
  obtain ⟨hK, hK', -, N₂, -, hN'N₂, f, hf, hover, hfx0⟩ := hE
  have hfx : f x = y := hfx0
  obtain ⟨-, -, P, hPN₂, hfP⟩ := hf
  have hfix : ∀ z ∈ M₁.carrier, f z = z := hover.2
  constructor
  · rintro ⟨W, hW, hMW, hWN, hnf⟩
    have h3 := h3a.1 _ _ _ _ hnf
    have hinf := aleph0_le_of_ssubset h3.2.1.2 hW.2 (hS.sub h3.2.2.2.2.2.1) h3.2.2.2.1.1
      h3.2.2.2.1.2
    obtain ⟨W', hW'⟩ := exists_isoOn (hfP.injOn.mono (hS.sub hWN))
    have hW'N₂ := hS.trans (hS.iso_le hWN hfP hW') hPN₂
    have hnf' : s.nf M₀ M₁ y W' := hfx ▸ Frame.nf_iso_fix hS h3a hnf hW' hfix
    obtain ⟨W'', hW'', hsubW'', hW''N'⟩ :=
      hS.exists_small h0b hinf h3.2.1 hK'.2.1 (hS.sub hK'.2.2.1) hK'.2.2.2
    refine ⟨W'', hW'', hsubW'', hW''N', ?_⟩
    have h3' := h3a.1 _ _ _ _ hnf'
    exact h3b M₀ M₀ M₁ M₁ W' N₂ W'' y (hS.refl h3'.1.1) h3'.2.2.2.2.1 (hS.refl h3'.2.1.1)
      h3'.2.2.2.2.2.1 hW'N₂ hsubW'' (hS.trans hW''N' hN'N₂) hW'' hnf'
  · rintro ⟨W', hW', hMW', hW'N', hnf'⟩
    have h3' := h3a.1 _ _ _ _ hnf'
    have hinf := aleph0_le_of_ssubset h3'.2.1.2 hW'.2 (hS.sub h3'.2.2.2.2.2.1) h3'.2.2.2.1.1
      h3'.2.2.2.1.2
    obtain ⟨W, hW, hsubW, hWN⟩ :=
      hS.exists_small h0b hinf h3'.2.1 hK.2.1 (hS.sub hK.2.2.1) hK.2.2.2
    obtain ⟨V, hV⟩ := exists_isoOn (hfP.injOn.mono (hS.sub hWN))
    have hVN₂ : s.S.le V N₂ := hS.trans (hS.iso_le hWN hfP hV) hPN₂
    have hVc : V ∈ s.S.Kc lam := ⟨hS.iso_mem hW.1 hV, by rw [hV.card_eq]; exact hW.2⟩
    have hsubV : M₁.carrier ∪ {y} ⊆ V.carrier := by
      refine Set.union_subset (fun z hz => ?_) (Set.singleton_subset_iff.2 ?_)
      · rw [← hfix z hz]; exact hV.mapsTo (hsubW (Or.inl hz))
      · rw [← hfx]; exact hV.mapsTo (hsubW (Or.inr rfl))
    have hnfV : s.nf M₀ M₁ y V :=
      h3b M₀ M₀ M₁ M₁ W' N₂ V y (hS.refl h3'.1.1) h3'.2.2.2.2.1 (hS.refl h3'.2.1.1)
        h3'.2.2.2.2.2.1 (hS.trans hW'N' hN'N₂) hsubV hVN₂ hVc hnf'
    obtain ⟨g, hg, hgf, -⟩ := hV.exists_inv
    have hgfix : ∀ z ∈ M₁.carrier, g z = z := fun z hz => by
      have := hgf z (hsubW (Or.inl hz)); rwa [hfix z hz] at this
    have := Frame.nf_iso_fix hS h3a hnfV hg hgfix
    rw [← hfx, hgf x (hsubW (Or.inr rfl))] at this
    exact ⟨W, hW, hsubW, hWN, this⟩

/-- AUX: not in paper. `NfWit` is invariant under `E`. -/
theorem Frame.nfWit_of_ERel {s : Frame U L} {lam : Cardinal.{u}} (hS : IsAEC s.S)
    (h0b : s.Ax0b lam) (h3a : s.Ax3a lam) (h3b : s.Ax3b lam) {M₀ M₁ : Model U L}
    {t t' : Tri U L} (h : ERel s.S lam t t') :
    t.1 = M₁ → (s.NfWit lam M₀ M₁ t.2.1 t.2.2 ↔ s.NfWit lam M₀ M₁ t'.2.1 t'.2.2) := by
  induction h with
  | rel x y hxy =>
    intro hx
    obtain ⟨X1, X2, X3⟩ := x
    obtain ⟨Y1, Y2, Y3⟩ := y
    simp only at hx
    subst hx
    have hy : Y1 = X1 := hxy.2.2.1
    subst hy
    exact Frame.nfWit_step hS h0b h3a h3b hxy
  | refl => intro _; exact Iff.rfl
  | symm x y hxy ih =>
    intro hy
    exact (ih ((ERel.fst hxy).symm.trans hy)).symm
  | trans x y z hxy hyz ih₁ ih₂ =>
    intro hx
    exact (ih₁ hx).trans (ih₂ ((ERel.fst hxy).trans hx))

-- Original context: wherever non-forking is discussed, the paper's standing assumption is a
-- semi-good frame. Only the axioms used by the proof are assumed here.
-- DEVIATION (author decision Q3): hypotheses (0)(a) AEC, (1)(b) AP, (3)(a), (3)(b).
-- AGENT-CHOICE: also (0)(b) `LST ≤ λ`: after the erratum in Def 1.0.22 the models in a chain of
-- `E*`-steps may be outside `K_λ`, and `LST ≤ λ` is needed to come back to `K_λ`.
-- AGENT-CHOICE (Q3 part B): `M₃* ∈ K_λ`; without it the conclusion is false by (3)(a).
/-- Prop 2.1.2: "If `⨿(M₀, M₁, a, M₃)` and `tp(b, M₁, M₃*) = tp(a, M₁, M₃)`, then by
Definition 2.1.1.3.b (the monotonicity axiom) `⨿(M₀, M₁, b, M₃*)`." The paper states no
hypothesis on `s`; see docs/FIDELITY_REVIEW.md. -/
theorem prop_2_1_2 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (h0a : s.Ax0a)
    (h0b : s.Ax0b lam) (h1b : s.Ax1b lam) (h3a : s.Ax3a lam) (h3b : s.Ax3b lam)
    (M₀ M₁ M₃ M₃s : Model U L) (a b : U) (hM₃s : M₃s ∈ s.S.Kc lam) (h : s.nf M₀ M₁ a M₃)
    (htp : tp s.S lam b M₁ M₃s = tp s.S lam a M₁ M₃) :
    s.nf M₀ M₁ b M₃s := by
  have hS : IsAEC s.S := h0a
  have h3 := h3a.1 _ _ _ _ h
  have hw : s.NfWit lam M₀ M₁ M₃ a :=
    ⟨M₃, h3.2.2.1, Set.union_subset (hS.sub h3.2.2.2.2.2.1)
      (Set.singleton_subset_iff.2 h3.2.2.2.1.1), hS.refl h3.2.2.1.1, h⟩
  have hE : ERel s.S lam (M₁, M₃, a) (M₁, M₃s, b) := tp_eq_iff.1 htp.symm
  obtain ⟨W, -, hsub, hWN, hnfW⟩ := (Frame.nfWit_of_ERel hS h0b h3a h3b hE rfl).1 hw
  have h3' := h3a.1 _ _ _ _ hnfW
  exact h3b M₀ M₀ M₁ M₁ W M₃s M₃s b (hS.refl h3'.1.1) h3'.2.2.2.2.1 (hS.refl h3'.2.1.1)
    h3'.2.2.2.2.2.1 hWN (hsub.trans (hS.sub hWN)) (hS.refl hM₃s.1) hM₃s hnfW

/-- AUX: not in paper. Unfolding `NotFork` together with the facts given by axiom 3(a). -/
theorem Frame.NotFork.facts {s : Frame U L} {lam : Cardinal.{u}} (h3a : s.Ax3a lam)
    {M N : Model U L} {p : Set (Tri U L)} (h : s.NotFork lam M N p) :
    ∃ (a : U) (N' : Model U L), p = tp s.S lam a N N' ∧ s.nf M N a N' ∧ M ∈ s.S.Kc lam ∧
      N ∈ s.S.Kc lam ∧ N' ∈ s.S.Kc lam ∧ a ∈ N'.carrier \ N.carrier ∧ s.S.le M N ∧
      s.S.le N N' ∧ tp s.S lam a M N' ∈ s.Sbs M ∧ tp s.S lam a N N' ∈ s.Sbs N := by
  obtain ⟨a, N', rfl, hnf⟩ := h
  exact ⟨a, N', rfl, hnf, h3a.1 _ _ _ _ hnf⟩

/-- AUX: not in paper. Monotonicity of `⨿` in the base and in the middle model (Def 2.1.1(3)(b)
with `M₃** = M₃*`). -/
theorem Frame.nf_mono {s : Frame U L} {lam : Cardinal.{u}} (hS : IsAEC s.S) (h3a : s.Ax3a lam)
    (h3b : s.Ax3b lam) {M₀ M₀' M₁' M₁ M₃ : Model U L} {a : U} (h : s.nf M₀ M₁ a M₃)
    (h1 : s.S.le M₀ M₀') (h2 : s.S.le M₀' M₁') (h3 : s.S.le M₁' M₁) : s.nf M₀' M₁' a M₃ := by
  have f := h3a.1 _ _ _ _ h
  exact h3b M₀ M₀' M₁' M₁ M₃ M₃ M₃ a h1 h2 h3 f.2.2.2.2.2.1 (hS.refl f.2.2.1.1)
    (Set.union_subset ((hS.sub h3).trans (hS.sub f.2.2.2.2.2.1))
      (Set.singleton_subset_iff.2 f.2.2.2.1.1)) (hS.refl f.2.2.1.1) f.2.2.1 h

/-- AUX: not in paper. Transitivity of non-forking from the axioms in `Core` (existence,
uniqueness, monotonicity); this is the argument of [Sh:h].II Claim 2.18 (= Prop 2.5.6, which is
cited and assumes a full semi-good frame). -/
theorem Frame.notFork_trans {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M₀ M₁ M₂ : Model U L} (h₀ : M₀ ∈ s.S.Kc lam) (h₂ : M₂ ∈ s.S.Kc lam)
    (h01 : s.S.le M₀ M₁) (h12 : s.S.le M₁ M₂) {p : Set (Tri U L)} (hp : p ∈ s.Sbs M₂)
    (hnf : s.NotFork lam M₁ M₂ p) (hnf' : s.NotFork lam M₀ M₁ (res s.S lam p M₁)) :
    s.NotFork lam M₀ M₂ p := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨a, N', rfl, -, h₁, -, -, -, -, hM₂N', -, -⟩ := hnf.facts hc.ax3a
  by_cases he : M₀ = M₂
  · subst he
    have : M₁ = M₀ := hS.po.2.2.1 _ _ (hS.trans h12 (hS.refl h₀.1)) h01
    rw [this] at hnf; exact hnf
  have hlt : s.S.lt M₀ M₂ := ⟨hS.trans h01 h12, he⟩
  rw [res_tp hS h12] at hnf'
  obtain ⟨b, N, hEq, hnfb, -, -, -, -, -, -, hb0, -⟩ := hnf'.facts hc.ax3a
  -- `p ↾ M₀` is basic
  have hp0 : tp s.S lam a M₀ N' = tp s.S lam b M₀ N := by
    have := ERel.restrict hS (tp_eq_iff.1 hEq) M₀ h01
    exact tp_eq_iff.2 this
  obtain ⟨q, hq, hqnf, hqres⟩ := hc.ax3f M₀ h₀ M₂ h₂ _ (hp0 ▸ hb0) hlt
  obtain ⟨c, N'', rfl, hnfc, -, -, -, -, -, -, -, -⟩ := hqnf.facts hc.ax3a
  have hq1 : s.nf M₁ M₂ c N'' := Frame.nf_mono hS hc.ax3a hc.ax3b hnfc h01 h12 (hS.refl h₂.1)
  have hq2 : s.nf M₀ M₁ c N'' := Frame.nf_mono hS hc.ax3a hc.ax3b hnfc (hS.refl h₀.1) h01 h12
  have hq2b := (hc.ax3a.1 _ _ _ _ hq2).2.2.2.2.2.2.2
  have hb1 := (hc.ax3a.1 _ _ _ _ hnfb).2.2.2.2.2.2.2
  -- uniqueness over `M₀` in `M₁`
  have hu1 : tp s.S lam c M₁ N'' = tp s.S lam a M₁ N' := by
    refine hc.ax3d M₀ h₀ M₁ h₁ h01 _ hq2b _ (hEq ▸ hb1) ⟨c, N'', rfl, hq2⟩ ?_ ?_
    · rw [hEq]; exact ⟨b, N, rfl, hnfb⟩
    · rw [res_tp hS h01, res_tp hS h01]
      rw [res_tp hS (hS.trans h01 h12)] at hqres
      exact hqres
  -- uniqueness over `M₁` in `M₂`
  have hu2 : tp s.S lam c M₂ N'' = tp s.S lam a M₂ N' := by
    refine hc.ax3d M₁ h₁ M₂ h₂ h12 _ hq _ hp ⟨c, N'', rfl, hq1⟩ hnf ?_
    rw [res_tp hS h12, res_tp hS h12, hu1]
  rw [← hu2]; exact ⟨c, N'', rfl, hnfc⟩

-- Original context: semi-good frame. AGENT-CHOICE: the other axioms of a semi-good λ-frame
-- (Core, symmetry, almost stability) are kept: the argument goes through the transitivity
-- proposition 2.5.6, whose proof ([Sh:h].II 2.18) uses existence, uniqueness and monotonicity.
/-- Remark 2.1.4: "If for each `M ∈ K_λ` `S^bs(M) = S^na(M)`, then the continuity axiom is an
easy consequence of the local character" (for a frame satisfying the other axioms of a
semi-good `λ`-frame). -/
theorem rem_2_1_4 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : s.Core lam)
    (hsym : s.Ax3e lam) (hstab : s.BasicStab lam (Order.succ lam)) (hlc : s.Ax3c lam)
    (hna : ∀ M ∈ s.S.Kc lam, s.Sbs M = Sna s.S lam M) :
    s.Ax3g lam := by
  classical
  have hS : IsAEC s.S := hs.ax0a
  intro δ hδ hδlt M hM p hp hnfα
  obtain ⟨hinc, hcont, hmem⟩ := hM
  obtain ⟨N, a, hK3, rfl⟩ := hp
  have hδmem : δ ∈ Iic δ := Set.mem_Iic.2 le_rfl
  have hle : ∀ α < δ, s.S.le (M α) (M δ) := fun α hα =>
    hinc α (Set.mem_Iic.2 hα.le) δ hδmem hα
  have h0δ : (0 : Ordinal.{u}) < δ := by simpa using hδ.bot_lt
  have hle0 : ∀ α < δ, s.S.le (M 0) (M α) := fun α hα => by
    rcases (show (0 : Ordinal.{u}) ≤ α from zero_le).lt_or_eq with h | h
    · exact hinc 0 (Set.mem_Iic.2 h0δ.le) α (Set.mem_Iic.2 hα.le) h
    · rw [← h]; exact hS.refl (hmem 0 (Set.mem_Iic.2 h0δ.le)).1
  -- `a ∉ M_δ`
  have haα : ∀ α < δ, a ∉ (M α).carrier := fun α hα haM => by
    have h1 := hnfα α hα
    rw [res_tp hS (hle α hα)] at h1
    obtain ⟨b, N', hEq, -, -, -, -, hb, -⟩ := h1.facts hs.ax3a
    have e : b = a := (ERel.alg (tp_eq_iff.1 hEq)).1 haM
    exact hb.2 (e ▸ haM)
  have haδ : a ∉ (M δ).carrier := by
    rw [hcont δ hδmem hδ]
    intro h
    obtain ⟨α, hα, h'⟩ := Set.mem_iUnion₂.1 h
    exact haα α hα h'
  have hMδ := hmem δ hδmem
  have hpbs : tp s.S lam a (M δ) N ∈ s.Sbs (M δ) := by
    rw [hna _ hMδ]; exact ⟨N, a, hK3, haδ, rfl⟩
  refine ⟨hpbs, ?_⟩
  -- `λ` is infinite
  have hinf : ℵ₀ ≤ lam := by
    have h1 := hnfα 0 h0δ
    obtain ⟨b, N', -, -, -, hc1, hc', hb, -, hle', -⟩ := h1.facts hs.ax3a
    exact aleph0_le_of_ssubset hc1.2 hc'.2 (hS.sub hle') hb.1 hb.2
  obtain ⟨W, hW, hsubW, hWN⟩ := hS.exists_small hs.ax0b hinf hMδ hK3.2.1 (hS.sub hK3.2.2.1)
    hK3.2.2.2
  have hδW : s.S.le (M δ) W :=
    hS.le_of_sub hK3.2.2.1 hWN (Set.subset_union_left.trans hsubW)
  have htpW : tp s.S lam a (M δ) W = tp s.S lam a (M δ) N := by
    apply tp_eq_iff.2
    exact Relation.EqvGen.rel _ _ ⟨⟨hMδ.1, hW.1, hδW, hsubW (Or.inr rfl)⟩, hK3, rfl, N, hK3.2.1,
      hS.refl hK3.2.1, id, IsEmb.of_le hS hWN,
      ⟨fun x hx => ⟨hS.sub hδW hx, hS.sub hK3.2.2.1 hx⟩, fun _ _ => rfl⟩, rfl⟩
  let M' : Ordinal.{u} → Model U L := fun α => if α = δ + 1 then W else M α
  have hM'δ : ∀ α ≤ δ, M' α = M α := fun α hα => by
    have : α ≠ δ + 1 := fun h => by
      rw [h] at hα; exact absurd hα (not_le.2 (Order.lt_add_one_iff.2 le_rfl))
    simp [M', this]
  have hM'1 : M' (δ + 1) = W := by simp [M']
  have hinc' : IsIncCont s.S M' (Iic (δ + 1)) (s.S.Kc lam) := by
    refine ⟨fun α hα β hβ hαβ => ?_, fun β hβ hβl => ?_, fun α hα => ?_⟩
    · have hαδ : α ≤ δ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hαβ hβ)
      rw [hM'δ α hαδ]
      rcases (show β ≤ δ + 1 from hβ).lt_or_eq with hβ' | hβ'
      · rw [hM'δ β (Order.lt_add_one_iff.1 hβ')]
        exact hinc α (Set.mem_Iic.2 hαδ) β (Set.mem_Iic.2 (Order.lt_add_one_iff.1 hβ')) hαβ
      · rw [hβ', hM'1]
        rcases hαδ.lt_or_eq with h | h
        · exact hS.trans (hle α h) hδW
        · rw [h]; exact hδW
    · have hβδ : β ≤ δ := by
        rcases (show β ≤ δ + 1 from hβ).lt_or_eq with h | h
        · exact Order.lt_add_one_iff.1 h
        · rw [h, ← Order.succ_eq_add_one] at hβl; exact absurd hβl.isMax (not_isMax δ)
      rw [hM'δ β hβδ, hcont β (Set.mem_Iic.2 hβδ) hβl]
      refine Set.iUnion₂_congr fun α hα => ?_
      rw [hM'δ α (le_of_lt (lt_of_lt_of_le hα hβδ))]
    · rcases (show α ≤ δ + 1 from hα).lt_or_eq with h | h
      · rw [hM'δ α (Order.lt_add_one_iff.1 h)]
        exact hmem α (Set.mem_Iic.2 (Order.lt_add_one_iff.1 h))
      · rw [h, hM'1]; exact hW
  have hlcp : tp s.S lam a (M' δ) (M' (δ + 1)) ∈ s.Sbs (M' δ) := by
    rw [hM'δ δ le_rfl, hM'1, htpW]; exact hpbs
  obtain ⟨α, hα, hnf⟩ := hlc δ hδ hδlt M' hinc' a hlcp
  rw [hM'δ α hα.le, hM'δ δ le_rfl, hM'1, htpW] at hnf
  have h0 := hmem 0 (Set.mem_Iic.2 h0δ.le)
  exact Frame.notFork_trans hs h0 hMδ (hle0 α hα) (hle α hα) hpbs hnf (hnfα α hα)

/-! ## 2.2 Examples -/

/-- Def 2.2.2: the trivial `λ`-frame of `(K, ≼)`: `S^bs = S^na` and
`⨿ = {(M₀, M₁, a, M₃) : M₀, M₁, M₃ ∈ K_λ, a ∈ M₃ - M₁}`. -/
-- PROOF-STAGE CHANGE: the quadruples of the trivial ⨿ also satisfy `M₀ ≼ M₁ ≼ M₃` (the
-- presupposition of every ⨿, see Def 2.1.1(3)(a)); without it the trivial frame violates 3(a)
-- and Prop 2.2.3 is false (step: Prop 2.2.3, axiom 3(a)).
def trivialFrame (S : KSys U L) (lam : Cardinal.{u}) : Frame U L where
  S := S
  Sbs := Sna S lam
  nf M₀ M₁ a M₃ := M₀ ∈ S.Kc lam ∧ M₁ ∈ S.Kc lam ∧ M₃ ∈ S.Kc lam ∧ a ∈ M₃.carrier \ M₁.carrier ∧
    S.le M₀ M₁ ∧ S.le M₁ M₃

-- AGENT-CHOICE (reading): in (5), "p ⊂ q" (q extends p) is read as `q ↾ M = p`.
/-- Prop 2.2.3: under (1) `(K, ≼)` AEC, (2) `LST ≤ λ`, (3) JEP, AP, no maximal model in `K_λ`,
(4) `1 ≤ |S(M)| ≤ λ⁺` for `M ∈ K_λ`, (5) for `M ≼ N` in `K_λ` and `p ∈ S^na(M)` there is
exactly one `q ∈ S^na(N)` with `p ⊂ q` (read: `q ↾ M = p`), the trivial `λ`-frame satisfies
the axioms of a semi-good `λ`-frame except maybe symmetry. -/
theorem prop_2_2_3 (lam : Cardinal.{u}) (hU : Room U lam) (S : KSys U L) (h1 : IsAEC S)
    (h2 : S.LST ≤ lam) (h3 : JEP S lam ∧ AP S lam ∧
      ∀ M ∈ S.Kc lam, ¬ IsMaximal (S.restrict (S.Kc lam)) M)
    (h4 : ∀ M ∈ S.Kc lam, 1 ≤ #(SAll S lam M) ∧ #(SAll S lam M) ≤ Order.succ lam)
    (h5 : ∀ M ∈ S.Kc lam, ∀ N ∈ S.Kc lam, S.le M N → ∀ p ∈ Sna S lam M,
      ∃! q, q ∈ Sna S lam N ∧ res S lam q M = p) :
    (trivialFrame S lam).Core lam ∧ (trivialFrame S lam).Ax3g lam ∧
      (trivialFrame S lam).BasicStab lam (Order.succ lam) ∧ (trivialFrame S lam).Ax3c lam := by
  have hS := h1
  have hinf : ∀ M ∈ S.Kc lam, ℵ₀ ≤ lam := fun M hM => by
    have hnm := h3.2.2 M hM
    unfold IsMaximal at hnm
    push Not at hnm
    obtain ⟨N, hN, hlt⟩ := hnm hM
    obtain ⟨a, ha, haM⟩ := hS.exists_diff_of_lt ⟨hlt.1.2.2, hlt.2⟩
    exact aleph0_le_of_ssubset hM.2 hN.2 (hS.sub hlt.1.2.2) ha haM
  have nfT : ∀ {M N N₁ : Model U L} {c : U}, M ∈ S.Kc lam → N ∈ S.Kc lam → S.le M N →
      (N, N₁, c) ∈ S.K3 → c ∉ N.carrier →
        (trivialFrame S lam).NotFork lam M N (tp S lam c N N₁) := by
    intro M N N₁ c hM hN hMN hK hc
    obtain ⟨W, hW, hNW, -, hcW, htp⟩ := hS.exists_small_tp h2 (hinf N hN) hN hK
    exact ⟨c, W, htp.symm, hM, hN, hW, ⟨hcW, hc⟩, hMN, hNW⟩
  have cardK : ∀ {A B C : Model U L}, A ∈ S.Kc lam → C ∈ S.Kc lam → S.le A B → S.le B C →
      B ∈ S.Kc lam := by
    intro A B C hA hC hAB hBC
    refine ⟨hS.mem_right hAB, le_antisymm ?_ ?_⟩
    · rw [← hC.2]; exact Model.card_le_of_sub (hS.sub hBC)
    · rw [← hA.2]; exact Model.card_le_of_sub (hS.sub hAB)
  refine ⟨⟨h1, h2, h3.1, h3.2.1, h3.2.2, ?_, ?_, ?_, ⟨?_, ?_⟩, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · -- (2)(a)
    intro M hM p hp
    obtain ⟨N, a, hK, ha, rfl⟩ := hp
    obtain ⟨W, hW, hMW, -, haW, htp⟩ := hS.exists_small_tp h2 (hinf M hM) hM hK
    exact ⟨W, a, ⟨hMW, fun h => ha (by rw [h]; exact haW)⟩, hW, ⟨haW, ha⟩, htp.symm⟩
  · -- (2)(b)
    intro M N N' M' a f hM hp hfN hfM
    obtain ⟨hK, ha⟩ := mem_Sna hp
    refine ⟨N', f a, ⟨hS.iso_mem hK.1 hfM, hS.iso_mem hK.2.1 hfN, hS.iso_le hK.2.2.1 hfN hfM,
      hfN.mapsTo hK.2.2.2⟩, ?_, rfl⟩
    rw [hfM.carrier_eq]
    rintro ⟨x, hx, hfx⟩
    have e : x = a := hfN.injOn (hS.sub hK.2.2.1 hx) hK.2.2.2 hfx
    exact ha (e ▸ hx)
  · -- (2)(c)
    intro M hM N hN hlt
    obtain ⟨a, ha, haM⟩ := hS.exists_diff_of_lt hlt
    exact ⟨a, ⟨ha, haM⟩, N, a, ⟨hM.1, hN.1, hlt.1, ha⟩, haM, rfl⟩
  · -- (3)(a), first part
    intro M₀ M₁ a M₃ h
    obtain ⟨h0, h1', h3', ha, h01, h13⟩ := h
    exact ⟨h0, h1', h3', ha, h01, h13,
      ⟨M₃, a, ⟨h0.1, h3'.1, hS.trans h01 h13, ha.1⟩, fun h => ha.2 (hS.sub h01 h), rfl⟩,
      ⟨M₃, a, ⟨h1'.1, h3'.1, h13, ha.1⟩, ha.2, rfl⟩⟩
  · -- (3)(a), isomorphisms
    intro M₀ M₁ M₃ M₀' M₁' M₃' a f h hf3 hf0 hf1
    obtain ⟨h0, h1', h3', ha, h01, h13⟩ := h
    refine ⟨⟨hS.iso_mem h0.1 hf0, by rw [hf0.card_eq]; exact h0.2⟩,
      ⟨hS.iso_mem h1'.1 hf1, by rw [hf1.card_eq]; exact h1'.2⟩,
      ⟨hS.iso_mem h3'.1 hf3, by rw [hf3.card_eq]; exact h3'.2⟩, ⟨hf3.mapsTo ha.1, ?_⟩,
      hS.iso_le h01 hf1 hf0, hS.iso_le h13 hf3 hf1⟩
    rw [hf1.carrier_eq]
    rintro ⟨x, hx, hfx⟩
    exact ha.2 ((hf3.injOn (hS.sub h13 hx) ha.1 hfx) ▸ hx)
  · -- (3)(b)
    intro M₀ M₀s M₁s M₁ M₃ M₃s M₃ss a h00 h01 h11 h13 h33 hsub hle hM₃ss h
    obtain ⟨hc0, hc1, -, ha, -, -⟩ := h
    exact ⟨cardK hc0 hc1 h00 (hS.trans h01 h11), cardK hc0 hc1 (hS.trans h00 h01) h11, hM₃ss,
      ⟨hsub (Or.inr rfl), fun h => ha.2 (hS.sub h11 h)⟩, h01,
      hS.le_of_sub (hS.trans h11 (hS.trans h13 h33)) hle (Set.subset_union_left.trans hsub)⟩
  · -- (3)(d)
    intro M hM N hN hMN p hp q hq hnp hnq hres
    obtain ⟨c, N', rfl, -, -, hN', hc, -, hNN'⟩ := hnp
    have hp0 : res S lam (tp S lam c N N') M ∈ Sna S lam M := by
      rw [res_tp hS hMN]
      exact ⟨N', c, ⟨hM.1, hN'.1, hS.trans hMN hNN', hc.1⟩, fun h => hc.2 (hS.sub hMN h), rfl⟩
    obtain ⟨q₀, -, huniq⟩ := h5 M hM N hN hMN _ hp0
    exact (huniq _ ⟨hp, rfl⟩).trans (huniq q ⟨hq, hres.symm⟩).symm
  · -- (3)(f)
    intro M hM N hN p hp hlt
    obtain ⟨q, ⟨hq, hres⟩, -⟩ := h5 M hM N hN hlt.1 p hp
    obtain ⟨N₁, c, hK, hc, rfl⟩ := hq
    exact ⟨_, ⟨N₁, c, hK, hc, rfl⟩, nfT hM hN hlt.1 hK hc, hres⟩
  · -- (3)(g)
    intro δ hδ hδlt M hM p hp hnfα
    obtain ⟨hinc, hcont, hmem⟩ := hM
    obtain ⟨N, a, hK, rfl⟩ := hp
    have hδmem : δ ∈ Iic δ := Set.mem_Iic.2 le_rfl
    have h0δ : (0 : Ordinal.{u}) < δ := by simpa using hδ.bot_lt
    have haα : ∀ α < δ, a ∉ (M α).carrier := fun α hα haM => by
      have h1 : (trivialFrame S lam).NotFork lam (M 0) (M α)
          (res S lam (tp S lam a (M δ) N) (M α)) := hnfα α hα
      rw [res_tp hS (hinc α (Set.mem_Iic.2 hα.le) δ hδmem hα)] at h1
      obtain ⟨b, N', hEq, -, -, -, hb, -⟩ := h1
      have e : b = a := (ERel.alg (tp_eq_iff.1 hEq)).1 haM
      exact hb.2 (e ▸ haM)
    have haδ : a ∉ (M δ).carrier := by
      rw [hcont δ hδmem hδ]
      intro h
      obtain ⟨α, hα, h'⟩ := Set.mem_iUnion₂.1 h
      exact haα α hα h'
    exact ⟨⟨N, a, hK, haδ, rfl⟩, nfT (hmem 0 (Set.mem_Iic.2 h0δ.le)) (hmem δ hδmem)
      (hinc 0 (Set.mem_Iic.2 h0δ.le) δ hδmem h0δ) hK haδ⟩
  · -- (2)(d) with `λ⁺`
    intro M hM
    refine (Cardinal.mk_le_mk_of_subset fun p hp => ?_).trans (h4 M hM).2
    obtain ⟨N, a, hK, -, rfl⟩ := hp
    exact ⟨N, a, hK, rfl⟩
  · -- (3)(c)
    intro δ hδ hδlt M hM a hp
    obtain ⟨hinc, -, hmem⟩ := hM
    obtain ⟨hK, ha⟩ := mem_Sna hp
    have h0δ : (0 : Ordinal.{u}) < δ := by simpa using hδ.bot_lt
    have hδ1 : δ ∈ Iic (δ + 1) := Set.mem_Iic.2 (Order.lt_add_one_iff.2 le_rfl).le
    exact ⟨0, h0δ, nfT (hmem 0 (Set.mem_Iic.2 (h0δ.le.trans (Set.mem_Iic.1 hδ1))))
      (hmem δ hδ1) (hinc 0 (Set.mem_Iic.2 (h0δ.le.trans (Set.mem_Iic.1 hδ1))) δ hδ1 h0δ) hK ha⟩

/-- ENCODING for Def 2.2.5: relation symbols of the vocabulary `{E}`. -/
inductive EqRelSym : ℕ → Type u
  | E : EqRelSym 2

/-- ENCODING for Def 2.2.5: the vocabulary `{E}` with one binary predicate. -/
def LEq : Language.{u, u} := ⟨fun _ => PEmpty, EqRelSym⟩

/-- ENCODING for Def 2.2.5: the vocabulary `τ ∪ {E}`. -/
abbrev LBox (L : Language.{u, u}) : Language.{u, u} := L.sum LEq

/-- `x E^M y` for a `τ ∪ {E}`-model `M`. -/
def Eb (M : Model U (LBox L)) (x y : M.carrier) : Prop :=
  Structure.RelMap (L := LBox L) (Sum.inr (EqRelSym.E : LEq.Relations 2)) ![x, y]

/-- The class `a E^M` of `a`. -/
def eClass (M : Model U (LBox L)) (a : M.carrier) : Set M.carrier := {b | Eb M a b}

/-- Def 2.2.5, the class `K'`: `M` is a `τ ∪ {E}`-model with (1) `E^M` an equivalence relation,
(2) every class `aE^M` (as a `τ`-structure) isomorphic to some model in `K`, (3) every
`τ`-relation holds only on tuples inside one `E^M`-class. -/
def InBoxK (Kτ : Set (Model U L)) (M : Model U (LBox L)) : Prop :=
  Equivalence (Eb M) ∧
  (∀ a : M.carrier, ∃ N ∈ Kτ, ∃ g : eClass M a ≃ N.carrier,
    ∀ (n : ℕ) (R : L.Relations n) (x : Fin n → eClass M a),
      Structure.RelMap (L := LBox L) (Sum.inl R) (fun i => (x i : M.carrier)) ↔
        Structure.RelMap R (fun i => g (x i))) ∧
  ∀ (n : ℕ) (R : L.Relations n) (x : Fin n → M.carrier),
    Structure.RelMap (L := LBox L) (Sum.inl R) x → ∀ i j, Eb M (x i) (x j)

/-- Def 2.2.5: `(K', ≼')`, where `M ≼' N` iff `M ⊆ N` and no `a ∈ N - M` is `E^N`-equivalent to
some `b ∈ M`. (The assumptions of Def 2.2.5 on `τ` and `K` are hypotheses of Prop 2.2.6.) -/
def boxKSys (Kτ : Set (Model U L)) : KSys U (LBox L) :=
  ⟨{M | InBoxK Kτ M}, fun M N => InBoxK Kτ M ∧ InBoxK Kτ N ∧ IsSubstr M N ∧
    ∀ a b : N.carrier, (a : U) ∉ M.carrier → (b : U) ∈ M.carrier → ¬ Eb N a b⟩

/-- ENCODING: the number of isomorphism classes of a class of models. -/
def numIsoClasses (K : Set (Model U L)) : Cardinal.{u} :=
  #(Quotient (⟨fun M N => Nonempty (M.1.carrier ≃[L] N.1.carrier),
    ⟨fun _ => ⟨Language.Equiv.refl L _⟩, fun ⟨f⟩ => ⟨f.symm⟩, fun ⟨f⟩ ⟨g⟩ => ⟨g.comp f⟩⟩⟩ :
      Setoid {M // M ∈ K}))

-- DEVIATION (encoding): `χ`-tameness and stability are external notions ([GrVa]); we give our
-- own standard rendering.
/-- External notion used in Prop 2.2.6 (Def 1.11 of [GrVa]): `(K, ≼)` is `χ`-tame: types over
any `M ∈ K` are determined by their restrictions to submodels of cardinality `≤ χ`. -/
def IsTame (S : KSys U L) (lam χ : Cardinal.{u}) : Prop :=
  ∀ M ∈ S.K, ∀ p ∈ SAll S lam M, ∀ q ∈ SAll S lam M,
    (∀ N ∈ S.K, S.le N M → N.card ≤ χ → res S lam p N = res S lam q N) → p = q

/-- External notion used in Prop 2.2.6: `(K, ≼)` is stable in `μ`: `|S(M)| ≤ μ` for `M ∈ K_μ`. -/
def IsStableIn (S : KSys U L) (lam μ : Cardinal.{u}) : Prop :=
  ∀ M ∈ S.Kc μ, #(SAll S lam M) ≤ μ

/-! ## 2.3 A family of examples

Infinitary logic (`L_{∞,ω}`, `L_{ω₁,ω}`, fragments, `PC` classes) and Shelah's definable types
are not in Mathlib. They enter only through the uninterpreted data `ExtLogic` below, so the
statements of 2.3 (and the `PC_{ℵ₀}` part of Prop 2.4.5) are schematic; see docs/METHOD.md. -/

-- DEVIATION (encoding): infinitary logic, PC classes, fragments and Shelah's definable types
-- are uninterpreted parameters; the statements of 2.3 are schematic (docs/METHOD.md).
/-- ENCODING: uninterpreted external notions used in Subsections 2.3–2.4. -/
structure ExtLogic (U : Type u) (L : Language.{u, u}) where
  /-- `N ≡_{L_{∞,ω}} M` -/
  eqInf : Model U L → Model U L → Prop
  /-- `N₁ ≼_{L_{∞,ω}} N₂` -/
  leInf : Model U L → Model U L → Prop
  /-- `N ≼_{L_{ω₁,ω}} M` -/
  leOmega1 : Model U L → Model U L → Prop
  /-- `(K, ≼)` is `PC_{ℵ₀}` (Def 2.3.2, stated informally in the paper) -/
  IsPCAleph0 : KSys U L → Prop
  /-- `K` is a `PC_δ` class over `L_{ω₁,ω}` -/
  IsPCDelta : Set (Model U L) → Prop
  /-- fragments of `L_{ω₁,ω}` -/
  Frag : Type u
  /-- `L*` is a countable fragment -/
  IsCountableFrag : Frag → Prop
  /-- the fragment `L_{ω₁,ω}` itself -/
  full : Frag
  /-- number of `L*(τ)`-types over `∅` realized in a model -/
  numTypes : Frag → Model U L → Cardinal.{u}
  /-- `tp(a, M₁, M₂)` is definable over `A` in the sense of Defs 5.5, 5.7 of [Sh:h].I -/
  Definable : Model U L → Model U L → U → Set U → Prop

/-- Def 2.3.1: `K_M = {N ∈ K : N ≡_{L_{∞,ω}} M}` and
`≼_M = {(N₁, N₂) : N₁, N₂ ∈ K_M, N₁ ≼ N₂, N₁ ≼_{L_{∞,ω}} N₂}` (for `M ∈ K_{ℵ₀}`). -/
def KMSys (E : ExtLogic U L) (S : KSys U L) (M : Model U L) : KSys U L :=
  ⟨{N | N ∈ S.K ∧ E.eqInf N M}, fun N₁ N₂ => (N₁ ∈ S.K ∧ E.eqInf N₁ M) ∧
    (N₂ ∈ S.K ∧ E.eqInf N₂ M) ∧ S.le N₁ N₂ ∧ E.leInf N₁ N₂⟩

/-- `(K_M, ≺_M)`, the strict version of `≼_M`, as written in Props 2.3.4, 2.3.10 (not used in the
statements, see the AGENT-CHOICE at Prop 2.3.4). -/
def KMSysLt (E : ExtLogic U L) (S : KSys U L) (M : Model U L) : KSys U L :=
  ⟨(KMSys E S M).K, (KMSys E S M).lt⟩

/-- Def 2.3.2: `(K, ≼)` is `PC_{ℵ₀}` (uninterpreted, `ExtLogic.IsPCAleph0`). -/
def IsPCAleph0 (E : ExtLogic U L) (S : KSys U L) : Prop := E.IsPCAleph0 S

/-- Def 2.3.3: the finitely definable `λ`-frame of `(K, ≼)`: `(K, ≼, S^na, ⨿)` with
`⨿ = {(M₀, M₁, a, M₂) : M₀, M₁, M₂ ∈ K, ‖M₀‖ = ‖M₁‖ = λ, M₀ ≼ M₁ ≺ M₂, tp(a, M₁, M₂) definable
over some finite `A ⊆ M₀`}`. -/
def finDefFrame (E : ExtLogic U L) (S : KSys U L) (lam : Cardinal.{u}) : Frame U L where
  S := S
  Sbs := Sna S lam
  nf M₀ M₁ a M₂ := M₀ ∈ S.K ∧ M₁ ∈ S.K ∧ M₂ ∈ S.K ∧ M₀.card = lam ∧ M₁.card = lam ∧
    S.le M₀ M₁ ∧ S.lt M₁ M₂ ∧ ∃ A : Set U, A.Finite ∧ A ⊆ M₀.carrier ∧ E.Definable M₁ M₂ a A

/-- The common hypotheses of Props 2.3.4, 2.3.5, 2.3.10: `(K, ≼)` is an AEC with a countable
vocabulary, `LST = ℵ₀`, `PC_{ℵ₀}`, `0 < I(ℵ₁, K) < 2^{ℵ₁}` and `2^{ℵ₀} < 2^{ℵ₁}`. -/
def Hyp23 (E : ExtLogic U L) (S : KSys U L) : Prop :=
  IsAEC S ∧ L.card ≤ ℵ₀ ∧ S.LST = ℵ₀ ∧ IsPCAleph0 E S ∧ 0 < numModels S (ℵ_ 1) ∧
    numModels S (ℵ_ 1) < 2 ^ (ℵ_ 1) ∧ (2 : Cardinal.{u}) ^ ℵ₀ < 2 ^ (ℵ_ 1)

/-- Def 2.3.6: a model is `L*`-small if it realizes only countably many `L*(τ)`-types over `∅`. -/
def IsSmall (E : ExtLogic U L) (F : E.Frag) (M : Model U L) : Prop := E.numTypes F M ≤ ℵ₀

