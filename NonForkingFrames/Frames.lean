  have hNF02 : s.NFhat lam N₀ N₂ M₀ M₂ := by
    have := Frame.nfhat_perm hU hc σ hNF02z; rwa [eN₀, eN₂, eM₀] at this
  have hd24 : N₄.carrier ∩ M₂.carrier = N₂.carrier := by
    ext x; constructor
    · rintro ⟨hx4, hx2⟩
      rw [iM₂.carrier_eq] at hx2
      obtain ⟨y, hy, rfl⟩ := hx2
      by_cases hyD : y ∈ M₀.carrier ∪ N₂.carrier
