-- AGENT-CHOICE (reading): "q does not fork over N" for `q ∈ S^{bs,+}(M)` and `N ∈ K_λ` is read as:
-- for some representation `q = tp⁺(a, M, M')`, `tp(a, M, M')` does not fork over `N` in the
-- sense of Def 2.6.2. "Extension of p to S^{bs,+}(M₁)" in (2) is read as `q ↾ M₀ = p` with the
-- restriction of types of `((K^sat)^up, …)`.
/-- Prop 10.1.13 (inside the proof of Thm 10.1.9): (1) if `N ≼ M ∈ K^sat`, `N ∈ K_λ`,
`p ∈ S^bs(N)`, there is `q ∈ S^{bs,+}(M)` with `q ↾ N = p` not forking over `N`; (2) if
`M₀ ≼^NF M₁` in `K^sat` and `p ∈ S^{bs,+}(M₀)`, `p` has an extension in `S^{bs,+}(M₁)`. -/
theorem prop_10_1_13 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_10_1_2 s lam) :
    (∀ N M : Model U L, s.S.le N M → M ∈ s.Ksat lam → N ∈ s.S.Kc lam → ∀ p ∈ s.Sbs N,
      ∃ q ∈ s.SbsPlus lam M, s.resPlus lam q N = p ∧
        ∃ (a : U) (M' : Model U L), q = s.tpPlus lam a M M' ∧
          s.NotForkGe lam N M (tp s.S lam a M M')) ∧
    (∀ M₀ M₁ : Model U L, M₀ ∈ s.Ksat lam → M₁ ∈ s.Ksat lam → s.leNF lam M₀ M₁ →
      ∀ p ∈ s.SbsPlus lam M₀, ∃ q ∈ s.SbsPlus lam M₁,
        res (s.upKSys lam) (Order.succ lam) q M₀ = p) := by
  classical
  obtain ⟨hinf, hKs⟩ := Frame.hyp10_facts hU hs hs.2.2.kc_nonempty
  have hS : IsAEC s.S := hs.1.1.ax0a
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hKs
  have kc : ∀ X, X ∈ s.Ksat lam → X ∈ (s.upKSys lam).Kc (Order.succ lam) := fun X hX => by
    rw [hK]; exact hX
  refine ⟨fun N M lNM kM kN p hp => ?_, fun M₀ M₁ k0 k1 n01 p hp => ?_⟩
  · obtain ⟨b, M', kM', nMM', hnf, htp⟩ := Frame.ext_one hU hs hinf lNM kM kN hp
    have hK3b := (Frame.mem_of_notForkGe hnf).1
    have hgt : lam < M.card := by rw [kM.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
    refine ⟨s.tpPlus lam b M M', ⟨kM, M', b, kM', nMM', ⟨⟨kM.1.1, hgt⟩, ⟨M', b, hK3b, rfl⟩, N, kN,
      lNM, hnf⟩, rfl⟩, ?_, b, M', rfl, hnf⟩
    rw [← htp]
    ext t
    constructor
    · rintro ⟨M₀', M₁', a', kM₁', hmem, ht⟩
      have hE : ERel (s.upKSys lam) (Order.succ lam) (M, M', b) (M₀', M₁', a') := hmem
      have e1 : M₀' = M := ERel.fst hE
      subst e1
      have hK3u : (M₀', M', b) ∈ (s.upKSys lam).K3 :=
        ⟨(kc _ kM).1, (kc _ kM').1, (hle _ kM _ kM').2 ⟨kM, kM', nMM'⟩, hK3b.2.2.2⟩
      have hK3' := (ERel.K3_iff hE).1 hK3u
      have n1 : s.leNF lam M₀' M₁' := ((hle _ kM _ kM₁').1 hK3'.2.2.1).2.2
      have e := Frame.tp_of_tpPlus hU hs hinf kM kM' kM₁' nMM' n1 (tp_eq_iff.2 hE)
      have hr : tp s.S lam b N M' = tp s.S lam a' N M₁' :=
        tp_eq_iff.2 (ERel.restrict hS (tp_eq_iff.1 e) N lNM)
      rw [hr]; exact ht
    · intro ht
      exact ⟨M, M', b, kM', mem_tp_self _ _ _ _ _, ht⟩
  · by_cases he : M₀ = M₁
    · subst he
      obtain ⟨-, N, a, kN, lN, -, rfl⟩ := id hp
      refine ⟨_, hp, ?_⟩
      exact res_tp (lam := Order.succ lam) (a := a) (N := N) hA (hA.refl (kc _ k0).1)
    · obtain ⟨q, hq, -, hr⟩ := (Frame.splus_ax3df hU hs hinf hKs).2 M₀ (kc _ k0) M₁ (kc _ k1) p hp
        ⟨(hle _ k0 _ k1).2 ⟨k0, k1, n01⟩, he⟩
      exact ⟨q, hq, hr⟩

