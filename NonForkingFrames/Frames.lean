        rw [ebr] at this
        exact Frame.nf_symm hU hs5 (Frame.nf_trans2 hU hs5 (Frame.nf_symm hU hs5 this) star)
      · rw [h, ebr]; exact Frame.nf_symm hU hs5 star
    refine ⟨(xa, C', N1), fun ε hε => ?_, ⟨fun a' ha' b' hb' hab => ?_, ?_⟩, ⟨kN1, l1N, ?_⟩,
      fun r' hr' => ?_, fun hl => absurd hl (nlim r), fun r' hr' => ?_⟩
    · rcases (Set.mem_Iic.1 (Set.mem_Iic.2 hε)).lt_or_eq with h | h
      · have h' : ε ≤ r := Order.lt_add_one_iff.1 h
        show xa ε ∈ _ ∧ s.S.le (xa ε) _
        rw [xa1 ε h']; exact ⟨kb ε h', hS.trans (lbP ε h') lPm⟩
      · show xa ε ∈ _ ∧ s.S.le (xa ε) _
        rw [h, xa2]; exact ⟨kN0, l0N⟩
    · show s.S.le (xa a') (xa b')
      have ha'r : a' ≤ r := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb')
      rw [xa1 a' ha'r]
