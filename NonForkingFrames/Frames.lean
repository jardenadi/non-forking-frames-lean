  exact prop_5_3_9_4 lam hU s hs M₀ k0 M₁ k1 M₂ k2 M₃ k3 M₀ k0 M₁ k1 M₂ k2 N hN h rfl
    ⟨hS.refl k0.1, hS.refl k0.1, hS.trans (hS.trans l01 l13) hle⟩
    ⟨hS.refl k1.1, l01, hS.trans l13 hle⟩ ⟨hS.refl k2.1, l02, hS.trans l23 hle⟩
    ⟨N, hle, hS.refl hN.1⟩

/-- AUX: not in paper. One side of Prop 7.1.7. -/
theorem Frame.prop_7_1_7_side [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀₀ M₀₁ M₁₀ M₁₁ N₀ : Model U L} (hN₀ : N₀ ∈ s.S.Kc lam)
    (ha : s.NF lam M₀₀ M₀₁ M₁₀ M₁₁) (hb : s.S.le M₁₀ N₀)
    (hd : N₀.carrier ∩ M₀₁.carrier = M₀₀.carrier) :
    ∃ (g : U → U) (P Q : Model U L), IsoOn g M₁₁ P ∧ (∀ x ∈ M₀₁.carrier ∪ M₁₀.carrier, g x = x) ∧
      Q ∈ s.S.Kc lam ∧ s.NF lam M₁₀ P N₀ Q ∧ s.NF lam M₀₀ M₀₁ N₀ Q := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, -⟩ := id ha
  have hsmall : #(N₀.carrier ∪ id '' (M₀₁.carrier ∪ M₁₀.carrier) : Set U) < #U := by
    rw [Set.image_id]
    have h1 : #(M₀₁.carrier ∪ M₁₀.carrier : Set U) ≤ lam :=
      (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le (Frame.aleph0_le hc k0)
        (le_of_eq k1.2) (le_of_eq k2.2))
    exact hU.small_union (le_of_eq hN₀.2) h1
  obtain ⟨g, hinj, hid, hout⟩ := exists_rename hU.infinite (X := M₁₁.carrier) id (Set.injOn_id _) hsmall
  have hfix : ∀ x ∈ M₀₁.carrier ∪ M₁₀.carrier, g x = x := fun x hx => hid x hx
  obtain ⟨P, hP⟩ := exists_isoOn hinj
  have fixI : ∀ {X : Model U L}, X.carrier ⊆ M₀₁.carrier ∪ M₁₀.carrier → IsoOn g X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hfix x (hX hx)).symm
  have i0 : IsoOn g M₀₀ M₀₀ := fixI fun x hx => Or.inl (hS.sub l01 hx)
  have i1 : IsoOn g M₀₁ M₀₁ := fixI fun x hx => Or.inl hx
  have i2 : IsoOn g M₁₀ M₁₀ := fixI fun x hx => Or.inr hx
  have nfP : s.NF lam M₀₀ M₀₁ M₁₀ P := Frame.nf_iso hU hc ha hP i0 i1 i2
  obtain ⟨-, -, -, kP, -, -, -, l2P, -⟩ := id nfP
  have hdisj : P.carrier ∩ N₀.carrier = M₁₀.carrier := by
    ext x
    constructor
    · rintro ⟨hxP, hxN⟩
      rw [hP.carrier_eq] at hxP
      obtain ⟨y, hy, rfl⟩ := hxP
      by_cases hyD : y ∈ M₀₁.carrier ∪ M₁₀.carrier
      · rw [hfix y hyD] at hxN ⊢
        rcases hyD with h | h
        · exact hS.sub l02 (hd ▸ (⟨hxN, h⟩ : y ∈ N₀.carrier ∩ M₀₁.carrier))
        · exact h
      · exact absurd (Or.inl hxN) (hout y ⟨hy, hyD⟩)
    · intro hx
      exact ⟨hS.sub l2P hx, hS.sub hb hx⟩
  obtain ⟨Q, hQ, hNF⟩ := Frame.thm_5_3_7_a hU hs k2 kP hN₀ l2P hb hdisj
  exact ⟨g, P, Q, hP, hfix, hQ, hNF, Frame.nf_trans2 hU hs nfP hNF⟩

/-- AUX: not in paper. Prop 7.1.7, the final step for one side. -/
theorem Frame.prop_7_1_7_fin [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀₀ M₀₁ M₁₀ M₁₁ N₀ P Q N : Model U L} {g h : U → U}
    (hN : N ∈ s.S.Kc lam) (hg : IsoOn g M₁₁ P) (hgid : ∀ x ∈ M₀₁.carrier ∪ M₁₀.carrier, g x = x)
    (h1 : s.NF lam M₁₀ P N₀ Q) (h2 : s.NF lam M₀₀ M₀₁ N₀ Q) (h01 : s.S.le M₀₁ M₁₁)
    (h11 : s.S.le M₁₀ M₁₁) (hb : s.S.le M₁₀ N₀) (hem : IsEmb s.S h Q N)
    (hov : Over h Q N (M₀₁.carrier ∪ N₀.carrier)) :
    s.NF lam M₀₀ M₀₁ N₀ N ∧ ∃ (f : U → U) (P₁ : Model U L), IsEmb s.S f M₁₁ N ∧
      Over f M₁₁ N (M₀₁.carrier ∪ M₁₀.carrier) ∧ IsoOn f M₁₁ P₁ ∧ s.NF lam M₁₀ P₁ N₀ N := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, Q', hQ'N, hQ'⟩ := id hem
  obtain ⟨k0, kP, kN₀, kQ, l01, lPQ, l02, lNQ, -⟩ := id h1
  obtain ⟨c0, c1, -, -, cl01, cl13, -, -, -⟩ := id h2
  have kQ' : Q' ∈ s.S.Kc lam := ⟨hS.iso_mem kQ.1 hQ', by rw [hQ'.card_eq]; exact kQ.2⟩
  have fixI : ∀ {X : Model U L}, X.carrier ⊆ M₀₁.carrier ∪ N₀.carrier → IsoOn h X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hov.2 x (hX hx)).symm
  have n1 : s.NF lam M₀₀ M₀₁ N₀ Q' := Frame.nf_iso hU hc h2 hQ'
    (fixI fun x hx => Or.inl (hS.sub cl01 hx)) (fixI fun x hx => Or.inl hx) (fixI fun x hx => Or.inr hx)
  obtain ⟨P₁, hP₁⟩ := exists_isoOn (hQ'.injOn.mono (hS.sub lPQ))
  have n2 : s.NF lam M₁₀ P₁ N₀ Q' := Frame.nf_iso hU hc h1 hQ'
    (fixI fun x hx => Or.inr (hS.sub hb hx)) hP₁ (fixI fun x hx => Or.inr hx)
  have hemb : IsEmb s.S g M₁₁ Q := ⟨hS.mem_right h01, kQ.1, P, lPQ, hg⟩
  refine ⟨Frame.nf_top hU hs n1 hN hQ'N, h ∘ g, P₁, hemb.comp hS hem, ⟨fun x hx => ?_, fun x hx => ?_⟩,
    hg.comp hP₁, Frame.nf_top hU hs n2 hN hQ'N⟩
  · have hx' : x ∈ M₀₁.carrier ∪ N₀.carrier := hx.elim Or.inl fun h' => Or.inr (hS.sub hb h')
    exact ⟨hx.elim (fun h' => hS.sub h01 h') (fun h' => hS.sub h11 h'), (hov.1 hx').2⟩
  · have hx' : x ∈ M₀₁.carrier ∪ N₀.carrier := hx.elim Or.inl fun h' => Or.inr (hS.sub hb h')
    simp only [Function.comp, hgid x hx, hov.2 x hx']

-- PROOF-STAGE CHANGE: added `N₀ ∈ K_λ` (`hN₀`, author-approved). The paper leaves it implicit; the
-- conclusion `NF(M_{0,0}, M_{0,1}, N₀, N₁)` is a relation on `K_λ`, so it is false without it.
/-- Prop 7.1.7: suppose (a) `NF(M_{0,0}, M_{0,1}, M_{n,0}, M_{n,1})` for `n = 1, 2`,
(b) `M_{1,0}, M_{2,0} ≼ N₀`, (c) `N₀ ∩ M_{0,1} = M_{0,0}`. Then for some `N₁` with
`NF(M_{0,0}, M_{0,1}, N₀, N₁)` there are embeddings `fₙ : M_{n,1} → N₁` over `M_{0,1} ∪ M_{n,0}`
with `NF(M_{n,0}, fₙ[M_{n,1}], N₀, N₁)`. -/
theorem prop_7_1_7 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀₀ M₀₁ M₁₀ M₁₁ M₂₀ M₂₁ N₀ : Model U L) (hN₀ : N₀ ∈ s.S.Kc lam)
    (ha : s.NF lam M₀₀ M₀₁ M₁₀ M₁₁ ∧ s.NF lam M₀₀ M₀₁ M₂₀ M₂₁)
    (hb : s.S.le M₁₀ N₀ ∧ s.S.le M₂₀ N₀) (hc : N₀.carrier ∩ M₀₁.carrier = M₀₀.carrier) :
    ∃ N₁, s.NF lam M₀₀ M₀₁ N₀ N₁ ∧
      (∃ (f₁ : U → U) (P₁ : Model U L), IsEmb s.S f₁ M₁₁ N₁ ∧
        Over f₁ M₁₁ N₁ (M₀₁.carrier ∪ M₁₀.carrier) ∧ IsoOn f₁ M₁₁ P₁ ∧ s.NF lam M₁₀ P₁ N₀ N₁) ∧
      (∃ (f₂ : U → U) (P₂ : Model U L), IsEmb s.S f₂ M₂₁ N₁ ∧
        Over f₂ M₂₁ N₁ (M₀₁.carrier ∪ M₂₀.carrier) ∧ IsoOn f₂ M₂₁ P₂ ∧ s.NF lam M₂₀ P₂ N₀ N₁) := by
  have hs' : Hyp_5_1_1 s lam := hs
  obtain ⟨g₁, P₁, Q₁, hg₁, hid₁, kQ₁, h1₁, h2₁⟩ := Frame.prop_7_1_7_side hU hs' hN₀ ha.1 hb.1 hc
  obtain ⟨g₂, P₂, Q₂, hg₂, hid₂, kQ₂, h1₂, h2₂⟩ := Frame.prop_7_1_7_side hU hs' hN₀ ha.2 hb.2 hc
  obtain ⟨N, h₁, h₂, kN, em₁, em₂, ov₁, ov₂⟩ := thm_5_4_7 lam hU s hs' M₀₀ M₀₁ N₀ Q₁ Q₂ h2₁ h2₂
  obtain ⟨-, -, -, -, -, l1, -, l2, -⟩ := id ha.1
  obtain ⟨-, -, -, -, -, l1', -, l2', -⟩ := id ha.2
  obtain ⟨n, e₁⟩ := Frame.prop_7_1_7_fin hU hs' kN hg₁ hid₁ h1₁ h2₁ l1 l2 hb.1 em₁ ov₁
  obtain ⟨-, e₂⟩ := Frame.prop_7_1_7_fin hU hs' kN hg₂ hid₂ h1₂ h2₂ l1' l2' hb.2 em₂ ov₂
  exact ⟨N, n, e₁, e₂⟩

