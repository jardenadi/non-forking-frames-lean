/-- "`s` satisfies conditions 1 and 2 of a semi-good `λ`-frame" (Thm 2.5.8). -/
def Frame.Cond12 (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.Ax1a lam ∧ s.Ax1b lam ∧ s.Ax1c lam ∧ s.Ax2a lam ∧ s.Ax2b lam ∧ s.Ax2c lam ∧
