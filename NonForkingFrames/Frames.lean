        show s.S.le (c' β).1 (c' β').1
        rw [hcl β hβα]
        rcases (show β' ≤ α from hβ').lt_or_eq with h | h
        · rw [hcl β' h]; exact hbsc.2.1 β hβα β' h hl
        · rw [h, hcx]; exact (hleMN β hβα).1
      · show (c' β').1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).1.carrier
        rcases (show β' ≤ α from hβ').lt_or_eq with h | h
        · rw [hcl β' h, hbsc.2.2.1 β' h hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
        · rw [h, hcx, hMuU.1]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
      · have hβα : β < α := lt_of_lt_of_le hl hβ'
        show s.S.le (c' β).2 (c' β').2
        rw [hcl β hβα]
        rcases (show β' ≤ α from hβ').lt_or_eq with h | h
        · rw [hcl β' h]; exact hbsc.2.2.2.1 β hβα β' h hl
        · rw [h, hcx]; exact (hleMN β hβα).2
      · show (c' β').2.carrier = ⋃ ξ ∈ Iio β', (c' ξ).2.carrier
        rcases (show β' ≤ α from hβ').lt_or_eq with h | h
        · rw [hcl β' h, hbsc.2.2.2.2 β' h hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
        · rw [h, hcx, hNuU.1]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
      · have hb1 : β + 1 < α := lt_of_le_of_ne hβ fun h => by
          rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax β)
        have hb : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
        rw [hcl β hb, hcl (β + 1) hb1]
        exact (hprev (β + 1) hb1 (lt_trans hb1 hακ)).2.2.2.2.2.2 β le_rfl)
  -- the two chains contradict Prop 1.0.30
  have hI := fun α (hα : α < κ) => hcI α hα.le hα
  refine no_long_chain lam hU hS hinf (M := fun β => (c β).1) (N := fun β => (c β).2)
    ⟨fun β hβ β' hβ' h => (hI β' hβ').2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h,
      fun β hβ hl => (hI β hβ).2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl,
      fun β hβ => ((hI β hβ).1 β le_rfl).2.1.1⟩
    ⟨fun β hβ β' hβ' h => (hI β' hβ').2.2.2.2.1 β (Set.mem_Iic.2 h.le) β'
        (Set.mem_Iic.2 le_rfl) h,
      fun β hβ hl => (hI β hβ).2.2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl,
      fun β hβ => ((hI β hβ).1 β le_rfl).2.1.2.1⟩
    (fun β hβ => (Frame.K3bs_K3 hc ((hI β hβ).1 β le_rfl).2.1).2.2.1) (fun β hβ => ?_)
  have hβ1 : β + 1 < κ := hκlim.add_one_lt hβ
  exact ((hI (β + 1) hβ1).2.2.2.2.2.2 β le_rfl).2

/-- AUX: not in paper. `K^{3,bs}` is closed under isomorphisms (by Def 2.1.1(2)(b)). -/
theorem Frame.K3bs_iso {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M N M' N' : Model U L} {a : U} {f : U → U} (ht : (M, N, a) ∈ s.K3bs lam)
    (hfN : IsoOn f N N') (hfM : IsoOn f M M') : (M', N', f a) ∈ s.K3bs lam := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hM, hN, ha, hp⟩ := ht
  have hMN : s.S.le M N :=
    (Frame.K3bs_K3 hc (show (M, N, a) ∈ s.K3bs lam from ⟨hM, hN, ha, hp⟩)).2.2.1
  refine ⟨⟨hS.iso_mem hM.1 hfM, by rw [hfM.card_eq]; exact hM.2⟩,
    ⟨hS.iso_mem hN.1 hfN, by rw [hfN.card_eq]; exact hN.2⟩, ⟨hfN.mapsTo ha.1, fun h => ha.2 ?_⟩,
    hc.ax2b M N N' M' a f hM hp hfN hfM⟩
  rw [hfM.carrier_eq] at h
  obtain ⟨y, hy, hya⟩ := h
  rw [hfN.injOn (hS.sub hMN hy) ha.1 hya] at hy; exact hy

/-- AUX: not in paper. The reduced triples are closed under isomorphisms (part of
Remark 3.3.3). -/
theorem Frame.K3r_isoClosed {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) : IsoClosedTri (s.K3r lam) := by
  have hS : IsAEC s.S := hc.ax0a
  rintro ⟨M, N, a⟩ ⟨hbs, hred⟩ f M' N' hfN hfM
  simp only at hbs hred hfN hfM ⊢
  refine ⟨Frame.K3bs_iso hc hbs hfN hfM, fun Ms Ns hle => ?_⟩
  obtain ⟨hbs1, hbs', hM'Ms, hN'Ns, -, hnf⟩ := hle
  simp only at hbs1 hbs' hM'Ms hN'Ns hnf
  have hMN : s.S.le M N := (Frame.K3bs_K3 hc hbs).2.2.1
  have hM'N' : s.S.le M' N' := (Frame.K3bs_K3 hc hbs1).2.2.1
  have ha : a ∈ N.carrier := hbs.2.2.1.1
  obtain ⟨ψ, hψ, hψf, hfψ⟩ := hfN.exists_inv
  have hψM : IsoOn ψ M' M := by
    obtain ⟨ψ', hψ', hψ'f, -⟩ := hfM.exists_inv
    refine hψ'.congr fun y hy => ?_
    rw [hfM.carrier_eq] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    rw [hψ'f x hx, hψf x (hS.sub hMN hx)]
  obtain ⟨ρ, Ns'', hρ, hρψ, hNNs, -, -⟩ := hS.rename hU.infinite (∅ : Set U) hN'Ns hψ
    (by rw [Set.empty_union]; change N.card < #U; rw [hbs.2.1.2]; exact hU.2)
  obtain ⟨Ms'', hρMs⟩ := exists_isoOn (hρ.injOn.mono (hS.sub (Frame.K3bs_K3 hc hbs').2.2.1))
  have hρM : IsoOn ρ M' M := hψM.congr fun x hx => (hρψ x (hS.sub hM'N' hx)).symm
  have hρa : ρ (f a) = a := by rw [hρψ _ (hfN.mapsTo ha), hψf a ha]
  have hbs'' := Frame.K3bs_iso hc hbs' hρ hρMs
  rw [hρa] at hbs''
  have hn := Frame.nf_of_notFork hU hc hnf hbs'.2.1
  have hn'' := hc.ax3a.2 _ _ _ _ _ _ _ _ hn hρ hρM hρMs
  rw [hρa] at hn''
  have hr := hred Ms'' Ns'' ⟨hbs, hbs'', hS.iso_le hM'Ms hρMs hρM, hNNs, rfl, a, Ns'', rfl, hn''⟩
  ext y
  refine ⟨fun hy => ?_, fun hy => ⟨hS.sub hM'Ms hy, hS.sub hM'N' hy⟩⟩
  have h1 : ψ y ∈ Ms''.carrier ∩ N.carrier := ⟨by rw [← hρψ y hy.2]; exact hρMs.mapsTo hy.1,
    hψ.mapsTo hy.2⟩
  rw [hr] at h1
  rw [← hfψ y hy.2]; exact hfM.mapsTo h1

/-- AUX: not in paper. The use of reducedness in the proof of Thm 3.3.5: if `(A₀, A₁, d)` is
reduced, `A₀ ≼ B₀ ≼ B₁`, `A₁ ≼ B₁` and `tp(d, B₀, B₁)` does not fork over `A₀`, then
`B₀ ∩ A₁ ⊆ A₀`. -/
theorem Frame.reduced_step {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {A₀ A₁ B₀ B₁ : Model U L} {d : U} (ht : (A₀, A₁, d) ∈ s.K3r lam)
    (hAB : s.S.le A₀ B₀) (hA1B : s.S.le A₁ B₁) (hB : s.S.le B₀ B₁)
    (hnf : s.NotFork lam A₀ B₀ (tp s.S lam d B₀ B₁)) : B₀.carrier ∩ A₁.carrier ⊆ A₀.carrier := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, -, hA₀c, hB₀c, -⟩ := hnf.facts hc.ax3a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hA₀c
  obtain ⟨W, hW, hsub, hWB₁⟩ := hS.exists_hull hc.ax0b hinf (M := B₀) hB₀c (hS.mem_right hB)
    Set.subset_union_left (Set.union_subset (hS.sub hB) (hS.sub hA1B))
    (card_union_le hB₀c ht.1.2.1 hinf)
  have hB₀W : s.S.le B₀ W := hS.le_of_sub hB hWB₁ (Set.subset_union_left.trans hsub)
  have hA₁W : s.S.le A₁ W := hS.le_of_sub hA1B hWB₁ (Set.subset_union_right.trans hsub)
  have hdA : d ∈ A₁.carrier := ht.1.2.2.1.1
  have hdW : d ∈ W.carrier := hsub (Or.inr hdA)
  have hK : (B₀, B₁, d) ∈ s.S.K3 := ⟨hB₀c.1, hS.mem_right hB, hB, hS.sub hA1B hdA⟩
  have htp : tp s.S lam d B₀ W = tp s.S lam d B₀ B₁ := tp_eq_of_le hS hK hWB₁ hB₀W hdW
  rw [← htp] at hnf
  have hn := Frame.nf_of_notFork hU hc hnf hW
  have hfacts := hc.ax3a.1 _ _ _ _ hn
  have hr := ht.2 B₀ W ⟨ht.1, ⟨hB₀c, hW, hfacts.2.2.2.1, hfacts.2.2.2.2.2.2.2⟩, hAB, hA₁W, rfl, hnf⟩
  rw [hr]

/-- AUX: not in paper. The argument of Thm 3.3.5 and Prop 5.3.6: along a chain of reduced
triples `(A_β, A_{β+1}, d_β)` with `A_β ≼ B_β` and `tp(d_β, B_β, B_{β+1})` not forking over
`A_β`, `B₀ ∩ A_β ⊆ A₀` (take the first `β` containing a given element). -/
theorem Frame.disj_chain {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {αs : Ordinal.{u}} {A B : Ordinal.{u} → Model U L} {d : Ordinal.{u} → U}
    (hAcont : IsContinuous A (Iic αs)) (hBinc : IsIncreasing s.S.le B (Iic αs))
    (hAB : ∀ β ≤ αs, s.S.le (A β) (B β))
    (hred : ∀ β < αs, (A β, A (β + 1), d β) ∈ s.K3r lam)
    (hnf : ∀ β < αs, s.NotFork lam (A β) (B β) (tp s.S lam (d β) (B β) (B (β + 1)))) :
    ∀ β ≤ αs, (B 0).carrier ∩ (A β).carrier ⊆ (A 0).carrier := by
  have hS : IsAEC s.S := hc.ax0a
  have hBle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (B β) (B γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hBinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hS.mem_right (hAB γ hγ))
  intro β
  induction β using Ordinal.lt_wf.induction with
  | ind β ih =>
  rintro hβ x ⟨hxB, hxA⟩
  rcases Ordinal.zero_or_succ_or_isSuccLimit β with h0 | ⟨γ, hγ⟩ | hlim
  · subst h0; exact hxA
  · rw [Order.succ_eq_add_one] at hγ
    subst hγ
    have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
    have hγαs : γ < αs := lt_of_lt_of_le hγ1 hβ
    have hxBγ : x ∈ (B γ).carrier := hS.sub (hBle 0 zero_le γ hγαs.le zero_le) hxB
    have := Frame.reduced_step hU hc (hred γ hγαs) (hAB γ hγαs.le) (hAB (γ + 1) hβ)
      (hBle γ hγαs.le (γ + 1) hβ hγ1.le) (hnf γ hγαs) ⟨hxBγ, hxA⟩
    exact ih γ hγ1 hγαs.le ⟨hxB, this⟩
  · rw [hAcont β (Set.mem_Iic.2 hβ) hlim] at hxA
    obtain ⟨γ, hγ, hxγ⟩ := Set.mem_iUnion₂.1 hxA
    exact ih γ hγ (le_of_lt (lt_of_lt_of_le hγ hβ)) ⟨hxB, hxγ⟩

/-- Thm 3.3.5 (disjoint amalgamation existence): assume the conjugation property; for
`M₀ ≼ M₁, M₂` in `K_λ` there are `M₃, f` with `f : M₂ → M₃` an embedding over `M₀`,
`M₁ ≼ M₃` and `f[M₂] ∩ M₁ = M₀`; moreover, if `a ∈ M₁ - M₀` and `tp(a, M₀, M₁)` is basic, we
can add that `tp(a, f[M₂], M₃)` does not fork over `M₀`. -/
theorem thm_3_3_5 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (hconj : ConjProp s lam) (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.Kc lam)
    (h₁ : M₁ ∈ s.S.Kc lam) (h₂ : M₂ ∈ s.S.Kc lam) (h01 : s.S.le M₀ M₁) (h02 : s.S.le M₀ M₂) :
    (∃ (M₃ : Model U L) (f : U → U), IsEmb s.S f M₂ M₃ ∧ Over f M₂ M₃ M₀.carrier ∧
      s.S.le M₁ M₃ ∧ f '' M₂.carrier ∩ M₁.carrier = M₀.carrier) ∧
    ∀ a ∈ M₁.carrier \ M₀.carrier, tp s.S lam a M₀ M₁ ∈ s.Sbs M₀ →
      ∃ (M₃ M₂' : Model U L) (f : U → U), IsEmb s.S f M₂ M₃ ∧ Over f M₂ M₃ M₀.carrier ∧
        s.S.le M₁ M₃ ∧ f '' M₂.carrier ∩ M₁.carrier = M₀.carrier ∧ IsoOn f M₂ M₂' ∧
        s.NotFork lam M₀ M₂' (tp s.S lam a M₂' M₃) := by
  obtain ⟨hc, hcont3, hsym⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hd : s.Dense lam (s.K3r lam) := fun t ht => by
    obtain ⟨Ms, Ns, hr, hle⟩ := prop_3_3_4 lam hU s ⟨hc, hcont3, hsym⟩ t ht
    exact ⟨_, hr, hle⟩
  have he := thm_3_2_3_1 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3r lam) (fun _ h => h.1)
    (Frame.K3r_isoClosed hU hc) hconj hd
  have hmore : ∀ a ∈ M₁.carrier \ M₀.carrier, tp s.S lam a M₀ M₁ ∈ s.Sbs M₀ →
      ∃ (M₃ M₂' : Model U L) (f : U → U), IsEmb s.S f M₂ M₃ ∧ Over f M₂ M₃ M₀.carrier ∧
        s.S.le M₁ M₃ ∧ f '' M₂.carrier ∩ M₁.carrier = M₀.carrier ∧ IsoOn f M₂ M₂' ∧
        s.NotFork lam M₀ M₂' (tp s.S lam a M₂' M₃) := by
    intro a ha hab
    have hlt : s.S.lt M₀ M₁ := ⟨h01, fun h => ha.2 (by rw [h]; exact ha.1)⟩
    by_cases h02eq : M₀ = M₂
    · subst h02eq
      exact ⟨M₁, M₀, id, IsEmb.of_le hS h01, ⟨fun x hx => ⟨hx, hS.sub h01 hx⟩, fun _ _ => rfl⟩,
        hS.refl h₁.1, by rw [Set.image_id]; exact Set.inter_eq_left.2 (hS.sub h01),
        IsoOn.refl _, Frame.notFork_self hc h₀ hab⟩
    have hlt2 : s.S.lt M₀ M₂ := ⟨h02, h02eq⟩
    obtain ⟨b, hb, hbb⟩ := hc.ax2c M₀ h₀ M₂ h₂ hlt2
    obtain ⟨Ms, hMs, hM₁Ms, αs, A, d, hdec, hd0⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩
      (s.K3r lam) (fun _ h => h.1) (Frame.K3r_isoClosed hU hc) he M₀ M₁ h₀ h₁ hlt).2 a ha hab
    obtain ⟨-, hAK, hAinc, hAcont, hA0, hAT, hAαs⟩ := hdec
    have hAK' : ∀ α ∈ Iic αs, A α ∈ s.S.Kc lam := fun α hα => by
      rcases (show α ≤ αs from hα).lt_or_eq with h | h
      · exact hAK α h
      · rw [h, hAαs]; exact hMs
    have hαpos : (0 : Ordinal.{u}) < αs := by
      rcases (show (0 : Ordinal.{u}) ≤ αs from zero_le).lt_or_eq with h | h
      · exact h
      · exfalso; apply ha.2
        have e : M₀ = Ms := by rw [← hA0, ← hAαs, h]
        rw [e]; exact hS.sub hM₁Ms ha.1
    obtain ⟨f, Bs, hfB, hfov, hBinc, -, hAB, hnfd, -⟩ := prop_3_1_8 lam hU s
      ⟨hc, hcont3, hsym⟩ αs A ⟨hAinc, hAcont, hAK'⟩ M₂ h₂ (by rw [hA0]; exact hlt2) d
      (fun α hα => ⟨(hAT α hα).1.2.2.1, (hAT α hα).1⟩) b (by rw [hA0]; exact hb)
      (by rw [hA0]; exact ⟨h₀, h₂, hb, hbb⟩)
    rw [hA0] at hfov
    have hBK : ∀ β ≤ αs, Bs β ∈ s.S.K := fun β hβ => hS.mem_right (hAB β hβ)
    have hBle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (Bs β) (Bs γ) := fun β hβ γ hγ h => by
      rcases h.lt_or_eq with h | h
      · exact hBinc β hβ γ hγ h
      · rw [h]; exact hS.refl (hBK γ hγ)
    have hAle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (A β) (A γ) := fun β hβ γ hγ h => by
      rcases h.lt_or_eq with h | h
      · exact hAinc β hβ γ hγ h
      · rw [h]; exact hS.refl (hAK' γ hγ).1
    have hdisj : ∀ β ≤ αs, (Bs 0).carrier ∩ (A β).carrier ⊆ (A 0).carrier := by
      intro β
      induction β using Ordinal.lt_wf.induction with
      | ind β ih =>
      rintro hβ x ⟨hxB, hxA⟩
      rcases Ordinal.zero_or_succ_or_isSuccLimit β with h0 | ⟨γ, hγ⟩ | hlim
      · subst h0; exact hxA
      · rw [Order.succ_eq_add_one] at hγ
        subst hγ
        have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
        have hγαs : γ < αs := lt_of_lt_of_le hγ1 hβ
        have hxBγ : x ∈ (Bs γ).carrier := hS.sub (hBle 0 zero_le γ hγαs.le zero_le) hxB
        have := Frame.reduced_step hU hc (hAT γ hγαs) (hAB γ hγαs.le) (hAB (γ + 1) hβ)
          (hBle γ hγαs.le (γ + 1) hβ hγ1.le) (hnfd γ hγαs) ⟨hxBγ, hxA⟩
        exact ih γ hγ1 hγαs.le ⟨hxB, this⟩
      · rw [hAcont β (Set.mem_Iic.2 hβ) hlim] at hxA
        obtain ⟨γ, hγ, hxγ⟩ := Set.mem_iUnion₂.1 hxA
        exact ih γ hγ (le_of_lt (lt_of_lt_of_le hγ hβ)) ⟨hxB, hxγ⟩
    have h1 : (0 : Ordinal.{u}) + 1 ≤ αs := Order.add_one_le_iff.2 hαpos
    have hB0αs := hBle 0 zero_le αs le_rfl zero_le
    refine ⟨Bs αs, Bs 0, f, ⟨h₂.1, hBK αs le_rfl, Bs 0, hB0αs, hfB⟩,
      ⟨fun x hx => ⟨(hfov.1 hx).1, hS.sub hB0αs (hfov.1 hx).2⟩, hfov.2⟩,
      hS.trans hM₁Ms (hAαs ▸ hAB αs le_rfl), ?_, hfB, ?_⟩
    · rw [← hfB.carrier_eq]
      ext x
      refine ⟨fun hx => ?_, fun hx => ⟨(hfov.1 hx).2, hS.sub h01 hx⟩⟩
      have := hdisj αs le_rfl ⟨hx.1, by rw [hAαs]; exact hS.sub hM₁Ms hx.2⟩
      rwa [hA0] at this
    · have hn := hnfd 0 hαpos
      rw [hd0, hA0] at hn
      have ha1 : a ∈ (Bs (0 + 1)).carrier := by
        have : d 0 ∈ (A (0 + 1)).carrier := (hAT 0 hαpos).1.2.2.1.1
        rw [hd0] at this; exact hS.sub (hAB (0 + 1) h1) this
      have hK : (Bs 0, Bs αs, a) ∈ s.S.K3 := ⟨hBK 0 zero_le, hBK αs le_rfl, hB0αs,
        hS.sub (hBle (0 + 1) h1 αs le_rfl h1) ha1⟩
      rwa [tp_eq_of_le hS hK (hBle (0 + 1) h1 αs le_rfl h1)
        (hBle 0 zero_le (0 + 1) h1 zero_le) ha1] at hn
  refine ⟨?_, hmore⟩
  by_cases h01eq : M₀ = M₁
  · subst h01eq
    exact ⟨M₂, id, IsEmb.of_le hS (hS.refl h₂.1), ⟨fun x hx => ⟨hS.sub h02 hx, hS.sub h02 hx⟩,
      fun _ _ => rfl⟩, h02, by rw [Set.image_id]; exact Set.inter_eq_right.2 (hS.sub h02)⟩
  · obtain ⟨a, ha, hab⟩ := hc.ax2c M₀ h₀ M₁ h₁ ⟨h01, h01eq⟩
    obtain ⟨M₃, M₂', f, h1, h2, h3, h4, -, -⟩ := hmore a ha hab
    exact ⟨M₃, f, h1, h2, h3, h4⟩

/-! ════════════════════════════════════════════════════════════════════════════
    PART 4 : SECTION 4  (Uniqueness triples)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 4.1.1: `s` is a semi-good `λ`-frame. -/
def Hyp_4_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop := s.IsSemiGood lam

/-- ENCODING: an amalgamation `(f₁, f₂, M₃)`. -/
abbrev Amalg (U : Type u) (L : Language.{u, u}) := (U → U) × (U → U) × Model U L

/-- Def 4.1.2: for `M₀ ≼ M₁, M₂` in `K_λ` and amalgamations `A = (f₁ᵃ, f₂ᵃ, M₃ᵃ)`,
`B = (f₁ᵇ, f₂ᵇ, M₃ᵇ)` of `M₁, M₂` over `M₀`, `A E_{M₀} B` iff there are `fᵃ, fᵇ, M₃^{ab}` with
`fᵃ : M₃ᵃ → M₃^{ab}`, `fᵇ : M₃ᵇ → M₃^{ab}`, `fᵇ ∘ f₁ᵇ = fᵃ ∘ f₁ᵃ`, `fᵇ ∘ f₂ᵇ = fᵃ ∘ f₂ᵃ`. -/
def AmalgEquiv (S : KSys U L) (lam : Cardinal.{u}) (M₀ M₁ M₂ : Model U L) (A B : Amalg U L) :
    Prop :=
  M₀ ∈ S.Kc lam ∧ M₁ ∈ S.Kc lam ∧ M₂ ∈ S.Kc lam ∧ S.le M₀ M₁ ∧ S.le M₀ M₂ ∧
    IsAmalgIn S lam A.1 A.2.1 A.2.2 M₀ M₁ M₂ ∧ IsAmalgIn S lam B.1 B.2.1 B.2.2 M₀ M₁ M₂ ∧
    ∃ (fa fb : U → U) (Mab : Model U L), IsEmb S fa A.2.2 Mab ∧ IsEmb S fb B.2.2 Mab ∧
      (∀ x ∈ M₁.carrier, fb (B.1 x) = fa (A.1 x)) ∧ ∀ x ∈ M₂.carrier, fb (B.2.1 x) = fa (A.2.1 x)

/-- Prop 4.1.3: `E_{M₀}` is an equivalence relation (on amalgamations of `M₁, M₂` over `M₀`). -/
theorem prop_4_1_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_4_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.Kc lam) (h₁ : M₁ ∈ s.S.Kc lam) (h₂ : M₂ ∈ s.S.Kc lam)
    (h01 : s.S.le M₀ M₁) (h02 : s.S.le M₀ M₂) :
    (∀ A : Amalg U L, IsAmalgIn s.S lam A.1 A.2.1 A.2.2 M₀ M₁ M₂ →
      AmalgEquiv s.S lam M₀ M₁ M₂ A A) ∧
    (∀ A B, AmalgEquiv s.S lam M₀ M₁ M₂ A B → AmalgEquiv s.S lam M₀ M₁ M₂ B A) ∧
    (∀ A B C, AmalgEquiv s.S lam M₀ M₁ M₂ A B → AmalgEquiv s.S lam M₀ M₁ M₂ B C →
      AmalgEquiv s.S lam M₀ M₁ M₂ A C) := by
  have hc := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₀
  have imgc : ∀ {f : U → U} {X P : Model U L}, IsoOn f X P → X ∈ s.S.Kc lam → s.S.le P P →
      P ∈ s.S.Kc lam := fun hf hX hP => ⟨hS.mem_left hP, by rw [hf.card_eq]; exact hX.2⟩
  refine ⟨fun A hA => ⟨h₀, h₁, h₂, h01, h02, hA, hA, id, id, A.2.2,
    IsEmb.of_le hS (hS.refl hA.2.1), IsEmb.of_le hS (hS.refl hA.2.1), fun _ _ => rfl,
    fun _ _ => rfl⟩, fun A B h => ?_, fun A B C h h' => ?_⟩
  · obtain ⟨-, -, -, -, -, hA, hB, fa, fb, Mab, hfa, hfb, e1, e2⟩ := h
    exact ⟨h₀, h₁, h₂, h01, h02, hB, hA, fb, fa, Mab, hfb, hfa, fun x hx => (e1 x hx).symm,
      fun x hx => (e2 x hx).symm⟩
  · obtain ⟨-, -, -, -, -, hA, hB, fa, fb, Mab, hfa, hfb, e1, e2⟩ := h
    obtain ⟨-, -, -, -, -, -, hC, gb, gc, Mbc, hgb, hgc, e1', e2'⟩ := h'
    obtain ⟨-, hMab, Pa, hPa, hfaP⟩ := hfa
    obtain ⟨-, -, Pb, hPb, hfbP⟩ := hfb
    obtain ⟨-, hMbc, Qb, hQb, hgbQ⟩ := hgb
    obtain ⟨-, -, Qc, hQc, hgcQ⟩ := hgc
    have hPac := imgc hfaP hA.2 (hS.refl (hS.mem_left hPa))
    have hPbc := imgc hfbP hB.2 (hS.refl (hS.mem_left hPb))
    have hQbc := imgc hgbQ hB.2 (hS.refl (hS.mem_left hQb))
    have hQcc := imgc hgcQ hC.2 (hS.refl (hS.mem_left hQc))
    obtain ⟨W1, hW1, hsub1, hW1M⟩ := hS.exists_hull hc.ax0b hinf hPbc hMab Set.subset_union_right
      (Set.union_subset (hS.sub hPa) (hS.sub hPb)) (card_union_le hPac hPbc hinf)
    obtain ⟨W2, hW2, hsub2, hW2M⟩ := hS.exists_hull hc.ax0b hinf hQcc hMbc Set.subset_union_right
      (Set.union_subset (hS.sub hQb) (hS.sub hQc)) (card_union_le hQbc hQcc hinf)
    have hPaW1 : s.S.le Pa W1 := hS.le_of_sub hPa hW1M (Set.subset_union_left.trans hsub1)
    have hPbW1 : s.S.le Pb W1 := hS.le_of_sub hPb hW1M (Set.subset_union_right.trans hsub1)
    have hQbW2 : s.S.le Qb W2 := hS.le_of_sub hQb hW2M (Set.subset_union_left.trans hsub2)
    have hQcW2 : s.S.le Qc W2 := hS.le_of_sub hQc hW2M (Set.subset_union_right.trans hsub2)
    obtain ⟨fbi, hfbi, hfbi1, -⟩ := hfbP.exists_inv
    have hg : IsEmb s.S (gb ∘ fbi) Pb W2 :=
      IsEmb.iso_comp hfbi hPbc.1 ⟨hB.2.1, hW2.1, Qb, hQbW2, hgbQ⟩
    obtain ⟨k, N5, hN5, hW2N5, hk, hkg⟩ := hS.amalg_along hU hc.ax1b hPbc hW1 hW2 hPbW1 hg
    have key : ∀ y ∈ B.2.2.carrier, k (fb y) = gb y := fun y hy => by
      rw [hkg _ (hfbP.mapsTo hy)]; simp only [Function.comp_apply]; rw [hfbi1 y hy]
    refine ⟨h₀, h₁, h₂, h01, h02, hA, hC, k ∘ fa, gc, N5,
      (show IsEmb s.S fa A.2.2 W1 from ⟨hA.2.1, hW1.1, Pa, hPaW1, hfaP⟩).comp hS hk,
      ⟨hC.2.1, hN5.1, Qc, hS.trans hQcW2 hW2N5, hgcQ⟩, fun x hx => ?_, fun x hx => ?_⟩
    · rw [e1' x hx, Function.comp_apply, ← e1 x hx, key _ (hB.1.1.mapsTo hS hx)]
    · rw [e2' x hx, Function.comp_apply, ← e2 x hx, key _ (hB.1.2.1.mapsTo hS hx)]

/-- The condition in Def 4.1.5 on an amalgamation `(f₁, f₂, N₁)` of `N` and `M₁` over `M`:
`tp(f₁(a), f₂[M₁], N₁)` does not fork over `M`. -/
def Frame.UqCond (s : Frame U L) (lam : Cardinal.{u}) (M M₁ : Model U L) (a : U)
    (A : Amalg U L) : Prop :=
  ∃ M₁' : Model U L, IsoOn A.2.1 M₁ M₁' ∧ s.NotFork lam M M₁' (tp s.S lam (A.1 a) M₁' A.2.2)

/-- Def 4.1.5: `K^{3,uq}`: triples `(M, N, a) ∈ K^{3,bs}` such that for every `M₁ ∈ K_λ` with
`M ≼ M₁`, up to `E_M` there is a unique amalgamation `(f₁, f₂, N₁)` of `N` and `M₁` over `M`
such that `tp(f₁(a), f₂[M₁], N₁)` does not fork over `M`. -/
def Frame.K3uq (s : Frame U L) (lam : Cardinal.{u}) : Set (Tri U L) :=
  {t | t ∈ s.K3bs lam ∧ ∀ M₁ ∈ s.S.Kc lam, s.S.le t.1 M₁ →
    (∃ A : Amalg U L, IsAmalgIn s.S lam A.1 A.2.1 A.2.2 t.1 t.2.1 M₁ ∧
      s.UqCond lam t.1 M₁ t.2.2 A) ∧
    ∀ A B : Amalg U L, IsAmalgIn s.S lam A.1 A.2.1 A.2.2 t.1 t.2.1 M₁ →
      s.UqCond lam t.1 M₁ t.2.2 A → IsAmalgIn s.S lam B.1 B.2.1 B.2.2 t.1 t.2.1 M₁ →
      s.UqCond lam t.1 M₁ t.2.2 B → AmalgEquiv s.S lam t.1 t.2.1 M₁ A B}

/-- AUX: not in paper. Transport of an amalgamation along isomorphisms: an amalgamation
`(g₁, g₂, X)` of `M₁', M₂'` over `M₀'` and isomorphisms `φₙ : Mₙ → Mₙ'` agreeing on `M₀` (with
`φ₁[M₀] = M₀'`) give, after renaming `X` along `φ₁⁻¹ ↾ M₀'`, an amalgamation of `M₁, M₂` over
`M₀`. -/
theorem amalg_transport {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    {M₀ M₁ M₂ M₀' M₁' M₂' X : Model U L} {φ₁ φ₂ g₁ g₂ : U → U}
    (h01 : S.le M₀ M₁) (h02 : S.le M₀ M₂) (h01' : S.le M₀' M₁')
    (hφ₁ : IsoOn φ₁ M₁ M₁') (hφ₂ : IsoOn φ₂ M₂ M₂') (hφ₀ : IsoOn φ₁ M₀ M₀')
    (hφe : ∀ x ∈ M₀.carrier, φ₂ x = φ₁ x) (hA : IsAmalgIn S lam g₁ g₂ X M₀' M₁' M₂') :
    ∃ (χ : U → U) (X' : Model U L), IsoOn χ X X' ∧ IsoOn χ M₀' M₀ ∧
      (∀ x ∈ M₀.carrier, χ (φ₁ x) = x) ∧
      IsAmalgIn S lam (χ ∘ g₁ ∘ φ₁) (χ ∘ g₂ ∘ φ₂) X' M₀ M₁ M₂ := by
  obtain ⟨⟨hg₁, hg₂, hov₁, hov₂⟩, hXc⟩ := hA
  obtain ⟨-, -, P, hPX, hg₁P⟩ := id hg₁
  have hM0'X : S.le M₀' X := hS.trans (hS.iso_le h01' hg₁P
    ((IsoOn.refl M₀').congr fun x hx => (hov₁.2 x hx).symm)) hPX
  obtain ⟨θ, hθ, hθφ, -⟩ := hφ₀.exists_inv
  obtain ⟨χ, X', hχ, hχθ, -, hX'K, -⟩ := hS.rename hU.infinite (∅ : Set U) hM0'X hθ (by
    rw [Set.empty_union]
    refine lt_of_le_of_lt ?_ hU.2
    have h1 : #M₀.carrier = #M₀'.carrier := (hφ₀.card_eq).symm
    rw [h1, ← hXc.2]; exact Cardinal.mk_le_mk_of_subset (hS.sub hM0'X))
  have hfix : ∀ x ∈ M₀.carrier, χ (φ₁ x) = x := fun x hx => by
    rw [hχθ _ (hφ₀.mapsTo hx), hθφ x hx]
  have hχ0 : IsoOn χ M₀' M₀ := hθ.congr fun x hx => (hχθ x hx).symm
  refine ⟨χ, X', hχ, hχ0, hfix, ⟨⟨?_, ?_, ⟨fun x hx => ⟨hS.sub h01 hx, ?_⟩, fun x hx => ?_⟩,
    ⟨fun x hx => ⟨hS.sub h02 hx, ?_⟩, fun x hx => ?_⟩⟩, hX'K, by rw [hχ.card_eq]; exact hXc.2⟩⟩
  · exact IsEmb.comp_iso hS (IsEmb.iso_comp hφ₁ (hS.mem_right h01) hg₁) hχ
  · exact IsEmb.comp_iso hS (IsEmb.iso_comp hφ₂ (hS.mem_right h02) hg₂) hχ
  · rw [← hfix x hx]; exact hχ.mapsTo (hS.sub hM0'X (hφ₀.mapsTo hx))
  · show χ (g₁ (φ₁ x)) = x
    rw [hov₁.2 _ (hφ₀.mapsTo hx)]; exact hfix x hx
  · rw [← hfix x hx]; exact hχ.mapsTo (hS.sub hM0'X (hφ₀.mapsTo hx))
  · show χ (g₂ (φ₂ x)) = x
    rw [hφe x hx, hov₂.2 _ (hφ₀.mapsTo hx)]; exact hfix x hx

/-- AUX: not in paper. The condition of Def 4.1.5 is preserved by `amalg_transport`. -/
theorem Frame.uqCond_transport {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {M₀ M₂ M₀' M₁' M₂' X X' : Model U L} {g₁ g₂ φ₁ φ₂ χ : U → U} {a : U}
    (hA : IsAmalgIn s.S lam g₁ g₂ X M₀' M₁' M₂') (hχ : IsoOn χ X X') (hχ0 : IsoOn χ M₀' M₀)
    (hφ₂ : IsoOn φ₂ M₂ M₂') (huq : s.UqCond lam M₀' M₂' (φ₁ a) (g₁, g₂, X)) :
    s.UqCond lam M₀ M₂ a (χ ∘ g₁ ∘ φ₁, χ ∘ g₂ ∘ φ₂, X') := by
  obtain ⟨P, hP, hnf⟩ := huq
  have hn := Frame.nf_of_notFork hU hc hnf hA.2
  have hPX : s.S.le P X := (hc.ax3a.1 _ _ _ _ hn).2.2.2.2.2.1
  obtain ⟨P', hχP⟩ := exists_isoOn (hχ.injOn.mono (hc.ax0a.sub hPX))
  exact ⟨P', hφ₂.comp (hP.comp hχP), χ (g₁ (φ₁ a)), X', rfl,
    hc.ax3a.2 _ _ _ _ _ _ _ _ hn hχ hχ0 hχP⟩

/-- AUX: not in paper. `K^{3,uq}` is closed under isomorphisms (used, e.g., in the proof of
Prop 4.1.11(1): "`K, ≼` are closed under isomorphisms, so it is easy to prove ..."). -/
theorem Frame.K3uq_isoClosed {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) : IsoClosedTri (s.K3uq lam) := by
  have hS : IsAEC s.S := hc.ax0a
  rintro ⟨M, N, a⟩ ⟨hbs, huq⟩ f M' N' hfN hfM
  obtain ⟨hM, hN, ha, hp⟩ := hbs
  simp only at hM hN ha hp hfN hfM huq ⊢
  have hMN : s.S.le M N :=
    (Frame.K3bs_K3 hc (show (M, N, a) ∈ s.K3bs lam from ⟨hM, hN, ha, hp⟩)).2.2.1
  have hM'c : M' ∈ s.S.Kc lam := ⟨hS.iso_mem hM.1 hfM, by rw [hfM.card_eq]; exact hM.2⟩
  have hN'c : N' ∈ s.S.Kc lam := ⟨hS.iso_mem hN.1 hfN, by rw [hfN.card_eq]; exact hN.2⟩
  have hM'N' : s.S.le M' N' := hS.iso_le hMN hfN hfM
  refine ⟨⟨hM'c, hN'c, ⟨hfN.mapsTo ha.1, fun h => ha.2 ?_⟩, hc.ax2b M N N' M' a f hM hp hfN hfM⟩,
    fun M₁' hM₁' hM'M₁' => ?_⟩
  · rw [hfM.carrier_eq] at h
    obtain ⟨y, hy, hya⟩ := h
    rw [hfN.injOn (hS.sub hMN hy) ha.1 hya] at hy; exact hy
  obtain ⟨ψ, hψ, hψf, hfψ⟩ := hfN.exists_inv
  have hψM : IsoOn ψ M' M := by
    obtain ⟨ψ', hψ', hψ'f, -⟩ := hfM.exists_inv
    refine hψ'.congr fun y hy => ?_
    rw [hfM.carrier_eq] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    rw [hψ'f x hx, hψf x (hS.sub hMN hx)]
  obtain ⟨ρ, M₁, hρ, hρψ, hMM₁, hM₁K, -⟩ := hS.rename hU.infinite (∅ : Set U) hM'M₁' hψM
    (by rw [Set.empty_union]; change M.card < #U; rw [hM.2]; exact hU.2)
  have hM₁c : M₁ ∈ s.S.Kc lam := ⟨hM₁K, by rw [hρ.card_eq]; exact hM₁'.2⟩
  obtain ⟨⟨A, hA, hAuq⟩, huniq⟩ := huq M₁ hM₁c hMM₁
  have hψa : ∀ x ∈ N.carrier, ψ (f x) = x := hψf
  refine ⟨?_, ?_⟩
  · -- existence: push `A` forward
    obtain ⟨χ, X', hχ, hχ0, -, hA'⟩ := amalg_transport hS hU (M₀' := M) (X := A.2.2) (g₁ := A.1)
      (g₂ := A.2.1) hM'N' hM'M₁' hMN hψ hρ hψM (fun x hx => hρψ x hx) hA
    refine ⟨(χ ∘ A.1 ∘ ψ, χ ∘ A.2.1 ∘ ρ, X'), hA', ?_⟩
    have := Frame.uqCond_transport hU hc (φ₁ := ψ) (a := f a) hA hχ hχ0 hρ
      (by rw [hψa a ha.1]; exact hAuq)
    exact this
  · -- uniqueness: pull `A'`, `B'` back
    intro A' B' hA' hA'uq hB' hB'uq
    obtain ⟨σ, hσ, hσρ, hρσ⟩ := hρ.exists_inv
    have hσe : ∀ x ∈ M.carrier, σ x = f x := fun x hx => by
      have hfx : f x ∈ M'.carrier := hfM.mapsTo hx
      have : ρ (f x) = x := by rw [hρψ _ hfx, hψf x (hS.sub hMN hx)]
      have h2 := hσρ _ (hS.sub hM'M₁' hfx)
      rw [this] at h2; exact h2
    have pull : ∀ B : Amalg U L, IsAmalgIn s.S lam B.1 B.2.1 B.2.2 M' N' M₁' →
        s.UqCond lam M' M₁' (f a) B → ∃ (χ : U → U) (X : Model U L), IsoOn χ B.2.2 X ∧
          IsAmalgIn s.S lam (χ ∘ B.1 ∘ f) (χ ∘ B.2.1 ∘ σ) X M N M₁ ∧
          s.UqCond lam M M₁ a (χ ∘ B.1 ∘ f, χ ∘ B.2.1 ∘ σ, X) := by
      intro B hB hBuq
      obtain ⟨χ, X, hχ, hχ0, -, hB'⟩ := amalg_transport hS hU (X := B.2.2) (g₁ := B.1)
        (g₂ := B.2.1) hMN hMM₁ hM'N' hfN hσ hfM hσe hB
      exact ⟨χ, X, hχ, hB', Frame.uqCond_transport hU hc (φ₁ := f) (a := a) hB hχ hχ0 hσ hBuq⟩
    obtain ⟨χA, XA, hχA, hAm, hAu⟩ := pull A' hA' hA'uq
    obtain ⟨χB, XB, hχB, hBm, hBu⟩ := pull B' hB' hB'uq
    obtain ⟨-, -, -, -, -, -, -, fa, fb, Mab, hfa, hfb, e1, e2⟩ :=
      huniq (χA ∘ A'.1 ∘ f, χA ∘ A'.2.1 ∘ σ, XA) (χB ∘ B'.1 ∘ f, χB ∘ B'.2.1 ∘ σ, XB)
        hAm hAu hBm hBu
    refine ⟨hM'c, hN'c, hM₁', hM'N', hM'M₁', hA', hB', fa ∘ χA, fb ∘ χB, Mab,
      IsEmb.iso_comp hχA hA'.1.1.2.1 hfa, IsEmb.iso_comp hχB hB'.1.1.2.1 hfb,
      fun y hy => ?_, fun y hy => ?_⟩
    · have := e1 (ψ y) (hψ.mapsTo hy)
      simp only [Function.comp_apply, hfψ y hy] at this
      exact this
    · have := e2 (ρ y) (hρ.mapsTo hy)
      simp only [Function.comp_apply, hσρ y hy] at this
      exact this

/-- Def 4.1.6: `a ∈ N - M` dominates `N` over `M`: for all `M₁, N₁ ∈ K_λ` with
`M ≼ M₁ ≼ N₁`, `N ≼ N₁` and `b ∈ M₁` with `tp(b, M, M₁)` basic, if `tp(a, M₁, N₁)` does not
fork over `M` then `tp(b, N, N₁)` does not fork over `M`. -/
def Frame.Dominates (s : Frame U L) (lam : Cardinal.{u}) (M N : Model U L) (a : U) : Prop :=
  M ∈ s.S.Kc lam ∧ N ∈ s.S.Kc lam ∧ s.S.le M N ∧ a ∈ N.carrier \ M.carrier ∧
    ∀ M₁ ∈ s.S.Kc lam, ∀ N₁ ∈ s.S.Kc lam, s.S.le M M₁ → s.S.le M₁ N₁ → s.S.le N N₁ →
      ∀ b ∈ M₁.carrier, tp s.S lam b M M₁ ∈ s.Sbs M →
        s.NotFork lam M M₁ (tp s.S lam a M₁ N₁) → s.NotFork lam M N (tp s.S lam b N N₁)

/-- Prop 4.1.12(1): if `K^{3,uq}` is dense and `s` has the conjugation property, then
`K^{3,uq}` satisfies the existence property. -/
theorem prop_4_1_12_1 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_4_1_1 s lam) (hd : s.Dense lam (s.K3uq lam)) (hconj : ConjProp s lam) :
    s.ExistProp lam (s.K3uq lam) := by
  exact thm_3_2_3_1 lam hU s ⟨hs.1, hs.2.1, hs.2.2.1⟩ (s.K3uq lam) (fun _ h => h.1)
    (Frame.K3uq_isoClosed hU hs.1) hconj hd

/-- Prop 4.1.12(2): if `K^{3,uq}` satisfies the existence property and
`p = tp(a, M, N) ∈ S^bs(M)`, then `(M, N*, a) ∈ K^{3,uq} ∩ p` for some `N*`. -/
theorem prop_4_1_12_2 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_4_1_1 s lam) (he : s.ExistProp lam (s.K3uq lam)) (M N : Model U L) (a : U)
    -- PROOF-STAGE CHANGE: added `hM : M ∈ K_λ` (implicit in the paper, where `S^bs(M)` is only
    -- defined for `M ∈ K_λ`); without it `S^bs(M)` is unconstrained and the statement is false.
    (hM : M ∈ s.S.Kc lam) (hp : tp s.S lam a M N ∈ s.Sbs M) :
    ∃ Ns : Model U L, (M, Ns, a) ∈ s.K3uq lam ∧ (M, Ns, a) ∈ tp s.S lam a M N := by
  have hc := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  obtain ⟨N₁, a₁, hlt, hN₁, ha₁, heq⟩ := hc.ax2a M hM hp
  have hK : (M, N, a) ∈ s.S.K3 :=
    (ERel.K3_iff (tp_eq_iff.1 heq)).2 ⟨hM.1, hN₁.1, hlt.1, ha₁.1⟩
  obtain ⟨W, hW, hMW, hWN, haW, htpW⟩ := hS.exists_small_tp hc.ax0b hinf hM hK
  obtain ⟨Ns, -, hT, hmem, -, -⟩ := thm_3_2_3_2 lam hU s ⟨hs.1, hs.2.1, hs.2.2.1⟩ (s.K3uq lam)
    (fun _ h => h.1) (Frame.K3uq_isoClosed hU hs.1) he M W a hM hW (by rw [htpW]; exact hp)
  exact ⟨Ns, hT, by rw [← htpW]; exact hmem⟩

/-! ════════════════════════════════════════════════════════════════════════════
    PART 5 : SECTION 5  (Non-forking amalgamation)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 5.1.1: (1) `s` is a semi-good `λ`-frame, (2) with the conjugation property,
(3) `K^{3,uq}` satisfies the existence property. -/
def Hyp_5_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.IsSemiGood lam ∧ ConjProp s lam ∧ s.ExistProp lam (s.K3uq lam)

/-- ENCODING: a 4-place relation on models. -/
abbrev QRel (U : Type u) (L : Language.{u, u}) :=
  Model U L → Model U L → Model U L → Model U L → Prop

section Otimes

variable (S : KSys U L) (lam : Cardinal.{u}) (R : QRel U L)

/-- Def 5.2.1 (precondition): `R ⊆ ⁴(K_λ)`. -/
def OtDom : Prop :=
  ∀ M₀ M₁ M₂ M₃, R M₀ M₁ M₂ M₃ → M₀ ∈ S.Kc lam ∧ M₁ ∈ S.Kc lam ∧ M₂ ∈ S.Kc lam ∧ M₃ ∈ S.Kc lam

/-- Def 5.2.1(a): `R(M₀, M₁, M₂, M₃) → M₀ ≼ Mₙ ≼ M₃` (`n = 1, 2`) and `M₁ ∩ M₂ = M₀`. -/
def OtA : Prop :=
  ∀ M₀ M₁ M₂ M₃, R M₀ M₁ M₂ M₃ → S.le M₀ M₁ ∧ S.le M₁ M₃ ∧ S.le M₀ M₂ ∧ S.le M₂ M₃ ∧
    M₁.carrier ∩ M₂.carrier = M₀.carrier

/-- Def 5.2.1(b), monotonicity: if `R(M₀, M₁, M₂, M₃)`, `N₀ = M₀`, `Nₙ ≼ Mₙ ∧ N₀ ≼ Nₙ ≼ N₃`
(`n < 3`) and `M₃, N₃ ≼ N*` for some `N*`, then `R(N₀, N₁, N₂, N₃)` (all models in `K_λ`). -/
def OtB : Prop :=
  ∀ M₀ ∈ S.Kc lam, ∀ M₁ ∈ S.Kc lam, ∀ M₂ ∈ S.Kc lam, ∀ M₃ ∈ S.Kc lam,
  ∀ N₀ ∈ S.Kc lam, ∀ N₁ ∈ S.Kc lam, ∀ N₂ ∈ S.Kc lam, ∀ N₃ ∈ S.Kc lam,
    R M₀ M₁ M₂ M₃ → N₀ = M₀ →
    (S.le N₀ M₀ ∧ S.le N₀ N₀ ∧ S.le N₀ N₃) → (S.le N₁ M₁ ∧ S.le N₀ N₁ ∧ S.le N₁ N₃) →
    (S.le N₂ M₂ ∧ S.le N₀ N₂ ∧ S.le N₂ N₃) → (∃ Ns, S.le M₃ Ns ∧ S.le N₃ Ns) →
      R N₀ N₁ N₂ N₃

/-- Def 5.2.1(c), existence. -/
def OtC : Prop :=
  ∀ N₀ ∈ S.Kc lam, ∀ N₁ ∈ S.Kc lam, ∀ N₂ ∈ S.Kc lam, S.le N₀ N₁ → S.le N₀ N₂ →
    N₁.carrier ∩ N₂.carrier = N₀.carrier → ∃ N₃, R N₀ N₁ N₂ N₃

/-- A joint embedding of `M, M'` over `A`, into a model of `K_λ` (Def 1.0.20(2)). -/
def JointEmbOver (M M' : Model U L) (A : Set U) : Prop :=
  ∃ (N : Model U L) (f g : U → U), N ∈ S.Kc lam ∧ IsEmb S f M N ∧ IsEmb S g M' N ∧
    Over f M N A ∧ Over g M' N A

/-- Def 5.2.1(d), weak uniqueness: if `R(N₀, N₁, N₂, N₃ˣ)` (`x = a, b`) then there is a joint
embedding of `N₃ᵃ, N₃ᵇ` over `N₁ ∪ N₂`. -/
def OtD : Prop :=
  ∀ N₀ N₁ N₂ Na Nb, R N₀ N₁ N₂ Na → R N₀ N₁ N₂ Nb →
    JointEmbOver S lam Na Nb (N₁.carrier ∪ N₂.carrier)

/-- Def 5.2.1(e), symmetry. -/
def OtE : Prop := ∀ N₀ N₁ N₂ N₃, R N₀ N₁ N₂ N₃ ↔ R N₀ N₂ N₁ N₃

/-- Def 5.2.1(f), long transitivity. -/
def OtF : Prop :=
  ∀ (αs : Ordinal.{u}) (Ma Mb : Ordinal.{u} → Model U L),
    IsIncCont S Ma (Iic αs) (S.Kc lam) → IsIncCont S Mb (Iic αs) (S.Kc lam) →
    (∀ i < αs, R (Ma i) (Ma (i + 1)) (Mb i) (Mb (i + 1))) → R (Ma 0) (Ma αs) (Mb 0) (Mb αs)

end Otimes

/-- Def 5.2.1: `⊗_R` for `R ⊆ ⁴(K_λ)`. -/
structure Otimes (S : KSys U L) (lam : Cardinal.{u}) (R : QRel U L) : Prop where
  dom : OtDom S lam R
  a : OtA S R
  b : OtB S lam R
  c : OtC S lam R
  d : OtD S lam R
  e : OtE R
  f : OtF S lam R

/-- Prop 5.2.2: item (b) of Def 5.2.1 can be replaced by the conjunction of (1) `R(M₀, M₁, M₂, M₃)`
and `M₀ ≼ N₁ ≼ M₁` imply `R(M₀, N₁, M₂, M₃)`; (2) if `M₁ ∪ M₂ ⊆ N₃ ≼ M₃` then
`R(M₀, M₁, M₂, M₃) ↔ R(M₀, M₁, M₂, N₃)`. -/
theorem prop_5_2_2 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (R : QRel U L) :
    Otimes s.S lam R ↔
      OtDom s.S lam R ∧ OtA s.S R ∧
      (∀ M₀ M₁ M₂ M₃ N₁, N₁ ∈ s.S.Kc lam → R M₀ M₁ M₂ M₃ → s.S.le M₀ N₁ → s.S.le N₁ M₁ →
        R M₀ N₁ M₂ M₃) ∧
      -- PROOF-STAGE CHANGE: added `M₃ ∈ K_λ` in item (2). Without it the direction `⊗_R → (2)`
      -- is false: for `M₃ ∉ K_λ`, `R(M₀, M₁, M₂, M₃)` fails by (dom) while `R(M₀, M₁, M₂, N₃)` may
      -- hold. The paper works inside `K_λ`.
      (∀ M₀ M₁ M₂ M₃ N₃, N₃ ∈ s.S.Kc lam → M₃ ∈ s.S.Kc lam →
        M₁.carrier ∪ M₂.carrier ⊆ N₃.carrier →
        s.S.le N₃ M₃ → (R M₀ M₁ M₂ M₃ ↔ R M₀ M₁ M₂ N₃)) ∧
      OtC s.S lam R ∧ OtD s.S lam R ∧ OtE R ∧ OtF s.S lam R := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  constructor
  · intro ot
    refine ⟨ot.dom, ot.a, fun M₀ M₁ M₂ M₃ N₁ hN₁ hR h0 h1 => ?_,
      fun M₀ M₁ M₂ M₃ N₃ hN₃ hM₃ hsub hle => ⟨fun hR => ?_, fun hR => ?_⟩,
      ot.c, ot.d, ot.e, ot.f⟩
    · obtain ⟨k0, k1, k2, k3⟩ := ot.dom _ _ _ _ hR
      obtain ⟨a01, a13, a02, a23, -⟩ := ot.a _ _ _ _ hR
      exact ot.b M₀ k0 M₁ k1 M₂ k2 M₃ k3 M₀ k0 N₁ hN₁ M₂ k2 M₃ k3 hR rfl
        ⟨hS.refl k0.1, hS.refl k0.1, hS.trans a01 a13⟩ ⟨h1, h0, hS.trans h1 a13⟩
        ⟨hS.refl k2.1, a02, a23⟩ ⟨M₃, hS.refl k3.1, hS.refl k3.1⟩
    · obtain ⟨k0, k1, k2, k3⟩ := ot.dom _ _ _ _ hR
      obtain ⟨a01, a13, a02, a23, -⟩ := ot.a _ _ _ _ hR
      have h1N : s.S.le M₁ N₃ := hS.le_of_sub a13 hle (Set.subset_union_left.trans hsub)
      have h2N : s.S.le M₂ N₃ := hS.le_of_sub a23 hle (Set.subset_union_right.trans hsub)
      exact ot.b M₀ k0 M₁ k1 M₂ k2 M₃ k3 M₀ k0 M₁ k1 M₂ k2 N₃ hN₃ hR rfl
        ⟨hS.refl k0.1, hS.refl k0.1, hS.trans a01 h1N⟩ ⟨hS.refl k1.1, a01, h1N⟩
        ⟨hS.refl k2.1, a02, h2N⟩ ⟨M₃, hS.refl k3.1, hle⟩
    · obtain ⟨k0, k1, k2, -⟩ := ot.dom _ _ _ _ hR
      obtain ⟨a01, a13, a02, a23, -⟩ := ot.a _ _ _ _ hR
      exact ot.b M₀ k0 M₁ k1 M₂ k2 N₃ hN₃ M₀ k0 M₁ k1 M₂ k2 M₃ hM₃ hR rfl
        ⟨hS.refl k0.1, hS.refl k0.1, hS.trans a01 (hS.trans a13 hle)⟩
        ⟨hS.refl k1.1, a01, hS.trans a13 hle⟩ ⟨hS.refl k2.1, a02, hS.trans a23 hle⟩
        ⟨M₃, hle, hS.refl hM₃.1⟩
  · rintro ⟨hdom, ha, i1, i2, hc', hd, he, hf⟩
    refine ⟨hdom, ha, ?_, hc', hd, he, hf⟩
    rintro M₀ k0 M₁ k1 M₂ k2 M₃ k3 N₀ n0 N₁ n1 N₂ n2 N₃ n3 hR hN0 ⟨-, -, -⟩ ⟨l11, l01, l13⟩
      ⟨l22, l02, l23⟩ ⟨Ns, hM₃Ns, hN₃Ns⟩
    rw [hN0] at l01 l02 ⊢
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
    obtain ⟨-, a13, -, a23, -⟩ := ha _ _ _ _ hR
    have r1 : R M₀ N₁ M₂ M₃ := i1 M₀ M₁ M₂ M₃ N₁ n1 hR l01 l11
    have r2 : R M₀ N₁ N₂ M₃ :=
      (he _ _ _ _).2 (i1 M₀ M₂ N₁ M₃ N₂ n2 ((he _ _ _ _).1 r1) l02 l22)
    obtain ⟨W, hW, hsub, hWNs⟩ := hS.exists_hull hc.ax0b hinf (M := M₃) k3 (hS.mem_right hM₃Ns)
      Set.subset_union_left (Set.union_subset (hS.sub hM₃Ns) (hS.sub hN₃Ns))
      (card_union_le k3 n3 hinf)
    have hM₃W : s.S.le M₃ W := hS.le_of_sub hM₃Ns hWNs (Set.subset_union_left.trans hsub)
    have hN₃W : s.S.le N₃ W := hS.le_of_sub hN₃Ns hWNs (Set.subset_union_right.trans hsub)
    have r3 : R M₀ N₁ N₂ W := (i2 M₀ N₁ N₂ W M₃ k3 hW
      (Set.union_subset ((hS.sub l11).trans (hS.sub a13)) ((hS.sub l22).trans (hS.sub a23)))
      hM₃W).2 r2
    exact (i2 M₀ N₁ N₂ W N₃ n3 hW (Set.union_subset (hS.sub l13) (hS.sub l23)) hN₃W).1 r3

/-- The function `G` of Prop 5.2.5(1): it assigns to each `(M₀, M₁, M₂) ∈ D` an amalgamation
`(f₁, f₂, M₃)` of `M₁, M₂` over `M₀` with `R(M₀, f₁[M₁], f₂[M₂], M₃)`. -/
def IsGFor (S : KSys U L) (lam : Cardinal.{u}) (R : QRel U L)
    (G : Model U L → Model U L → Model U L → Amalg U L) : Prop :=
  ∀ M₀ ∈ S.Kc lam, ∀ M₁ ∈ S.Kc lam, ∀ M₂ ∈ S.Kc lam, S.le M₀ M₁ → S.le M₀ M₂ →
    IsAmalgIn S lam (G M₀ M₁ M₂).1 (G M₀ M₁ M₂).2.1 (G M₀ M₁ M₂).2.2 M₀ M₁ M₂ ∧
    ∃ P Q : Model U L, IsoOn (G M₀ M₁ M₂).1 M₁ P ∧ IsoOn (G M₀ M₁ M₂).2.1 M₂ Q ∧
      R M₀ P Q (G M₀ M₁ M₂).2.2

/-- Def 5.2.6: `R` respects the frame `s`: if `R(M₀, M₁, M₂, M₃)` and `tp(a, M₀, M₁)` is basic,
then `tp(a, M₂, M₃)` does not fork over `M₀`. -/
def Respects (s : Frame U L) (lam : Cardinal.{u}) (R : QRel U L) : Prop :=
  ∀ M₀ M₁ M₂ M₃ a, R M₀ M₁ M₂ M₃ → tp s.S lam a M₀ M₁ ∈ s.Sbs M₀ →
    s.NotFork lam M₀ M₂ (tp s.S lam a M₂ M₃)

/-! ## 5.3 The relation `NF` -/

/-- Def 5.3.1: `⟨N_{1,i}, d_i : i < α*⟩⌢⟨N_{1,α*}⟩` (first witness) and `⟨N_{2,i} : i ≤ α*⟩`
(second witness) witness `NF*(N₀, N₁, N₂, N₃)`: `α* < λ⁺`, both sequences increasing continuous,
(a) `N₀ ≼ Nₙ ≼ N₃` (`n < 3`), (b) `N_{1,0} = N₀`, `N_{1,α*} = N₁`, `N_{2,0} = N₂`,
`N_{2,α*} = N₃`, (c) `N_{1,i} ≼ N_{2,i}`, (d) `dᵢ ∈ N_{1,i+1} - N_{1,i}`,
(e) `(N_{1,i}, N_{1,i+1}, dᵢ) ∈ K^{3,uq}`, (f) `tp(dᵢ, N_{2,i}, N_{2,i+1})` does not fork over
`N_{1,i}`. -/
def Frame.NFStarWit (s : Frame U L) (lam : Cardinal.{u}) (N₀ N₁ N₂ N₃ : Model U L)
    (αs : Ordinal.{u}) (A B : Ordinal.{u} → Model U L) (d : Ordinal.{u} → U) : Prop :=
  αs < (Order.succ lam).ord ∧
  IsIncreasing s.S.le A (Iic αs) ∧ IsContinuous A (Iic αs) ∧
  IsIncreasing s.S.le B (Iic αs) ∧ IsContinuous B (Iic αs) ∧
  (s.S.le N₀ N₀ ∧ s.S.le N₀ N₃) ∧ (s.S.le N₀ N₁ ∧ s.S.le N₁ N₃) ∧ (s.S.le N₀ N₂ ∧ s.S.le N₂ N₃) ∧
  A 0 = N₀ ∧ A αs = N₁ ∧ B 0 = N₂ ∧ B αs = N₃ ∧
  (∀ i ≤ αs, s.S.le (A i) (B i)) ∧
  (∀ i < αs, d i ∈ (A (i + 1)).carrier \ (A i).carrier) ∧
  (∀ i < αs, (A i, A (i + 1), d i) ∈ s.K3uq lam) ∧
  ∀ i < αs, s.NotFork lam (A i) (B i) (tp s.S lam (d i) (B i) (B (i + 1)))

/-- Def 5.3.1: the relation `NF* = NF*_λ` on `⁴(K_λ)`. -/
def Frame.NFStar (s : Frame U L) (lam : Cardinal.{u}) : QRel U L := fun N₀ N₁ N₂ N₃ =>
  N₀ ∈ s.S.Kc lam ∧ N₁ ∈ s.S.Kc lam ∧ N₂ ∈ s.S.Kc lam ∧ N₃ ∈ s.S.Kc lam ∧
    ∃ αs A B d, s.NFStarWit lam N₀ N₁ N₂ N₃ αs A B d

/-- Def 5.3.2: `NF = NF_λ`: quadruples of models in `K_λ` with `M₀ ≼ M₁ ≼ M₃`, `M₀ ≼ M₂ ≼ M₃`
and `N₀ = M₀`, `M_l ≼ N_l` (`l < 4`), `NF*(N₀, N₁, N₂, N₃)` for some `N₀, …, N₃`. -/
def Frame.NF (s : Frame U L) (lam : Cardinal.{u}) : QRel U L := fun M₀ M₁ M₂ M₃ =>
  M₀ ∈ s.S.Kc lam ∧ M₁ ∈ s.S.Kc lam ∧ M₂ ∈ s.S.Kc lam ∧ M₃ ∈ s.S.Kc lam ∧
    s.S.le M₀ M₁ ∧ s.S.le M₁ M₃ ∧ s.S.le M₀ M₂ ∧ s.S.le M₂ M₃ ∧
    ∃ N₀ N₁ N₂ N₃, N₀ = M₀ ∧ s.S.le M₀ N₀ ∧ s.S.le M₁ N₁ ∧ s.S.le M₂ N₂ ∧ s.S.le M₃ N₃ ∧
      s.NFStar lam N₀ N₁ N₂ N₃

/-- AUX: not in paper. Non-forking of `tp(x, B, C)` over `A` is preserved by an isomorphism of
`C` (the ambient `C` need not be in `K_λ`). -/
theorem Frame.notFork_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {A B C A' B' C' : Model U L} {x : U} {f : U → U}
    (hnf : s.NotFork lam A B (tp s.S lam x B C)) (hBC : s.S.le B C) (hx : x ∈ C.carrier)
    (hfC : IsoOn f C C') (hfA : IsoOn f A A') (hfB : IsoOn f B B') :
    s.NotFork lam A' B' (tp s.S lam (f x) B' C') := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, -, hAc, hBc, -⟩ := hnf.facts hc.ax3a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hAc
  obtain ⟨W, hW, hsub, hWC⟩ := hS.exists_small hc.ax0b hinf hBc (hS.mem_right hBC)
    (hS.sub hBC) hx
  have hBW : s.S.le B W := hS.le_of_sub hBC hWC (Set.subset_union_left.trans hsub)
  have hxW : x ∈ W.carrier := hsub (Or.inr rfl)
  have hK : (B, C, x) ∈ s.S.K3 := ⟨hBc.1, hS.mem_right hBC, hBC, hx⟩
  rw [← tp_eq_of_le hS hK hWC hBW hxW] at hnf
  have hn := Frame.nf_of_notFork hU hc hnf hW
  obtain ⟨W', hfW⟩ := exists_isoOn (hfC.injOn.mono (hS.sub hWC))
  have hn' := hc.ax3a.2 _ _ _ _ _ _ _ _ hn hfW hfA hfB
  have hW'C' : s.S.le W' C' := hS.iso_le hWC hfC hfW
  have hB'W' : s.S.le B' W' := hS.iso_le hBW hfW hfB
  have hxW' : f x ∈ W'.carrier := hfW.mapsTo hxW
  have hK' : (B', C', f x) ∈ s.S.K3 :=
    ⟨hS.mem_left hB'W', hS.mem_right hW'C', hS.trans hB'W' hW'C', hS.sub hW'C' hxW'⟩
  exact ⟨f x, W', (tp_eq_of_le hS hK' hW'C' hB'W' hxW').symm, hn'⟩

/-- AUX: not in paper. A witness for `NF*` is carried by an isomorphism to a witness for the
image, with first witness elements `f(d_i)` (the content of Prop 5.3.3). -/
theorem Frame.nfstarWit_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' : Model U L} {f : U → U}
    (h₃ : IsoOn f M₃ M₃') (h₀ : IsoOn f M₀ M₀') (h₁ : IsoOn f M₁ M₁') (h₂ : IsoOn f M₂ M₂')
    {αs : Ordinal.{u}} {A B : Ordinal.{u} → Model U L} {d : Ordinal.{u} → U}
    (hw : s.NFStarWit lam M₀ M₁ M₂ M₃ αs A B d) :
    ∃ A' B', s.NFStarWit lam M₀' M₁' M₂' M₃' αs A' B' (fun i => f (d i)) ∧
      ∀ β ≤ αs, IsoOn f (A β) (A' β) := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hαs, hAinc, hAcont, hBinc, hBcont, ⟨h00, h03⟩, ⟨h01, h13⟩, ⟨h02, h23⟩, hA0, hAα, hB0,
    hBα, hAB, hdm, huq, hnf⟩ := hw
  have hBle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (B β) (B γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hBinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hS.mem_right (hAB γ hγ))
  have hBsub : ∀ β ≤ αs, (B β).carrier ⊆ M₃.carrier := fun β hβ => by
    rw [← hBα]; exact hS.sub (hBle β hβ αs le_rfl hβ)
  have hAsub : ∀ β ≤ αs, (A β).carrier ⊆ M₃.carrier := fun β hβ =>
    (hS.sub (hAB β hβ)).trans (hBsub β hβ)
  have hAex : ∀ β ≤ αs, ∃ X, IsoOn f (A β) X := fun β hβ =>
    exists_isoOn (h₃.injOn.mono (hAsub β hβ))
  have hBex : ∀ β ≤ αs, ∃ X, IsoOn f (B β) X := fun β hβ =>
    exists_isoOn (h₃.injOn.mono (hBsub β hβ))
  let A' : Ordinal.{u} → Model U L := fun β => if h : β ≤ αs then (hAex β h).choose else A β
  let B' : Ordinal.{u} → Model U L := fun β => if h : β ≤ αs then (hBex β h).choose else B β
  have hA' : ∀ β ≤ αs, IsoOn f (A β) (A' β) := fun β hβ => by
    simp only [A', hβ, dite_true]; exact (hAex β hβ).choose_spec
  have hB' : ∀ β ≤ αs, IsoOn f (B β) (B' β) := fun β hβ => by
    simp only [B', hβ, dite_true]; exact (hBex β hβ).choose_spec
  have hcont : ∀ (X X' : Ordinal.{u} → Model U L), IsContinuous X (Iic αs) →
      (∀ β ≤ αs, IsoOn f (X β) (X' β)) → IsContinuous X' (Iic αs) := by
    intro X X' hX hX' β hβ hl
    have hβ' : β ≤ αs := hβ
    rw [(hX' β hβ').carrier_eq, hX β hβ hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ξ hξ => ((hX' ξ ((le_of_lt hξ).trans hβ')).carrier_eq).symm
  refine ⟨A', B', ⟨hαs,
    fun β hβ γ hγ h => hS.iso_le (hAinc β hβ γ hγ h) (hA' γ hγ) (hA' β hβ),
    hcont A A' hAcont hA', fun β hβ γ hγ h => hS.iso_le (hBinc β hβ γ hγ h) (hB' γ hγ) (hB' β hβ),
    hcont B B' hBcont hB', ⟨hS.iso_le h00 h₀ h₀, hS.iso_le h03 h₃ h₀⟩,
    ⟨hS.iso_le h01 h₁ h₀, hS.iso_le h13 h₃ h₁⟩, ⟨hS.iso_le h02 h₂ h₀, hS.iso_le h23 h₃ h₂⟩,
    (hA' 0 zero_le).unique (by rw [hA0]; exact h₀),
    (hA' αs le_rfl).unique (by rw [hAα]; exact h₁),
    (hB' 0 zero_le).unique (by rw [hB0]; exact h₂),
    (hB' αs le_rfl).unique (by rw [hBα]; exact h₃),
    fun i hi => hS.iso_le (hAB i hi) (hB' i hi) (hA' i hi), fun i hi => ?_, fun i hi => ?_,
    fun i hi => ?_⟩, hA'⟩
  · have hi1 : i + 1 ≤ αs := Order.add_one_le_iff.2 hi
    refine ⟨(hA' (i + 1) hi1).mapsTo (hdm i hi).1, fun hmem => (hdm i hi).2 ?_⟩
    rw [(hA' i hi.le).carrier_eq] at hmem
    obtain ⟨y, hy, hyd⟩ := hmem
    rw [← h₃.injOn (hAsub i hi.le hy) (hAsub (i + 1) hi1 (hdm i hi).1) hyd]; exact hy
  · have hi1 : i + 1 ≤ αs := Order.add_one_le_iff.2 hi
    exact Frame.K3uq_isoClosed hU hc _ (huq i hi) f (A' i) (A' (i + 1)) (hA' (i + 1) hi1)
      (hA' i hi.le)
  · have hi1 : i + 1 ≤ αs := Order.add_one_le_iff.2 hi
    have hdB : d i ∈ (B (i + 1)).carrier := hS.sub (hAB (i + 1) hi1) (hdm i hi).1
    exact Frame.notFork_iso hU hc (hnf i hi) (hBle i hi.le (i + 1) hi1
      (Order.lt_add_one_iff.2 le_rfl).le) hdB (hB' (i + 1) hi1) (hA' i hi.le) (hB' i hi.le)

/-- Prop 5.3.3: `NF*` and `NF` are closed under isomorphisms. -/
theorem prop_5_3_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' : Model U L) (f : U → U) (h₃ : IsoOn f M₃ M₃')
    (h₀ : IsoOn f M₀ M₀') (h₁ : IsoOn f M₁ M₁') (h₂ : IsoOn f M₂ M₂') :
    (s.NFStar lam M₀ M₁ M₂ M₃ → s.NFStar lam M₀' M₁' M₂' M₃') ∧
      (s.NF lam M₀ M₁ M₂ M₃ → s.NF lam M₀' M₁' M₂' M₃') := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hKc : ∀ {X X' : Model U L} {g : U → U}, X ∈ s.S.Kc lam → IsoOn g X X' →
      X' ∈ s.S.Kc lam := fun hX hg => ⟨hS.iso_mem hX.1 hg, by rw [hg.card_eq]; exact hX.2⟩
  have h1 : ∀ (M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' : Model U L) (f : U → U), IsoOn f M₃ M₃' →
      IsoOn f M₀ M₀' → IsoOn f M₁ M₁' → IsoOn f M₂ M₂' → s.NFStar lam M₀ M₁ M₂ M₃ →
      s.NFStar lam M₀' M₁' M₂' M₃' := by
    intro M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' f h₃ h₀ h₁ h₂ hN
    obtain ⟨k0, k1, k2, k3, αs, A, B, d, hw⟩ := hN
    obtain ⟨A', B', hw', -⟩ := Frame.nfstarWit_iso hU hc h₃ h₀ h₁ h₂ hw
    exact ⟨hKc k0 h₀, hKc k1 h₁, hKc k2 h₂, hKc k3 h₃, αs, A', B', _, hw'⟩
  refine ⟨h1 _ _ _ _ _ _ _ _ f h₃ h₀ h₁ h₂, fun h => ?_⟩
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, N₀, N₁, N₂, N₃, hN0, -, m1, m2, m3, hNF⟩ := h
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨n01, n13⟩, ⟨n02, n23⟩, -⟩ := id hNF
  have hM₃'c := hKc k3 h₃
  obtain ⟨g, N₃', hg, hgf, hM₃N₃', -, -⟩ := hS.rename hU.infinite (∅ : Set U) m3 h₃
    (by rw [Set.empty_union]; change M₃'.card < #U; rw [hM₃'c.2]; exact hU.2)
  have hgM : ∀ {X X' : Model U L}, X.carrier ⊆ M₃.carrier → IsoOn f X X' → IsoOn g X X' :=
    fun hX hf => hf.congr fun x hx => (hgf x (hX hx)).symm
  have hM₀₃ : M₀.carrier ⊆ M₃.carrier := hS.sub (hS.trans l01 l13)
  obtain ⟨N₁', hN₁'⟩ := exists_isoOn (hg.injOn.mono (hS.sub n13))
  obtain ⟨N₂', hN₂'⟩ := exists_isoOn (hg.injOn.mono (hS.sub n23))
  have hg0 : IsoOn g N₀ M₀' := by rw [hN0]; exact hgM hM₀₃ h₀
  have hNF' := h1 N₀ N₁ N₂ N₃ M₀' N₁' N₂' N₃' g hg hg0 hN₁' hN₂' hNF
  refine ⟨hKc k0 h₀, hKc k1 h₁, hKc k2 h₂, hM₃'c, hS.iso_le l01 h₁ h₀, hS.iso_le l13 h₃ h₁,
    hS.iso_le l02 h₂ h₀, hS.iso_le l23 h₃ h₂, M₀', N₁', N₂', N₃', rfl, hS.refl (hKc k0 h₀).1,
    hS.iso_le m1 hN₁' (hgM (hS.sub l13) h₁), hS.iso_le m2 hN₂' (hgM (hS.sub l23) h₂),
    hM₃N₃', hNF'⟩

/-- Prop 5.3.5: every triple in `K^{3,uq}` is reduced. -/
theorem prop_5_3_5 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    s.K3uq lam ⊆ s.K3r lam := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, hconj, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  rintro ⟨N₀, N₁, d⟩ ⟨hbs, huq⟩
  refine ⟨hbs, fun N₂ N₃ hle => ?_⟩
  obtain ⟨-, hbs', h02, h13, -, hnf⟩ := hle
  simp only at hbs hbs' h02 h13 hnf huq ⊢
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hbs.1
  have h01 : s.S.le N₀ N₁ := (Frame.K3bs_K3 hc hbs).2.2.1
  have h23 : s.S.le N₂ N₃ := (Frame.K3bs_K3 hc hbs').2.2.1
  obtain ⟨M₃, M₂', f, hf, hov, h1M₃, hdisj, hfM₂', hnf'⟩ := (thm_3_3_5 lam hU s
    ⟨hc, hcont3, hsym⟩ hconj N₀ N₁ N₂ hbs.1 hbs.2.1 hbs'.1 h01 h02).2 d hbs.2.2.1 hbs.2.2.2
  obtain ⟨-, -, Q, hQM₃, hfQ⟩ := hf
  have hQ : Q = M₂' := hfQ.unique hfM₂'
  subst hQ
  have hQc : Q ∈ s.S.Kc lam := ⟨hS.mem_left hQM₃, by rw [hfQ.card_eq]; exact hbs'.1.2⟩
  obtain ⟨W, hW, hsub, hWM₃⟩ := hS.exists_hull hc.ax0b hinf (M := N₁) hbs.2.1
    (hS.mem_right h1M₃) Set.subset_union_left
    (Set.union_subset (hS.sub h1M₃) (hS.sub hQM₃)) (card_union_le hbs.2.1 hQc hinf)
  have h1W : s.S.le N₁ W := hS.le_of_sub h1M₃ hWM₃ (Set.subset_union_left.trans hsub)
  have hQW : s.S.le Q W := hS.le_of_sub hQM₃ hWM₃ (Set.subset_union_right.trans hsub)
  have hdW : d ∈ W.carrier := hS.sub h1W hbs.2.2.1.1
  have hK : (Q, M₃, d) ∈ s.S.K3 := ⟨hQc.1, hS.mem_right hQM₃, hQM₃, hS.sub hWM₃ hdW⟩
  have htp : tp s.S lam d Q W = tp s.S lam d Q M₃ := tp_eq_of_le hS hK hWM₃ hQW hdW
  have hAm : IsAmalgIn s.S lam id f W N₀ N₁ N₂ :=
    ⟨⟨IsEmb.of_le hS h1W, ⟨hbs'.1.1, hW.1, Q, hQW, hfQ⟩,
      ⟨fun x hx => ⟨hS.sub h01 hx, hS.sub h1W (hS.sub h01 hx)⟩, fun _ _ => rfl⟩,
      ⟨fun x hx => ⟨hS.sub h02 hx, hS.sub h1W (hS.sub h01 hx)⟩, hov.2⟩⟩, hW⟩
  have hAu : s.UqCond lam N₀ N₂ d (id, f, W) := ⟨Q, hfQ, by
    show s.NotFork lam N₀ Q (tp s.S lam d Q W); rw [htp]; exact hnf'⟩
  have hBm : IsAmalgIn s.S lam id id N₃ N₀ N₁ N₂ :=
    ⟨⟨IsEmb.of_le hS h13, IsEmb.of_le hS h23,
      ⟨fun x hx => ⟨hS.sub h01 hx, hS.sub h13 (hS.sub h01 hx)⟩, fun _ _ => rfl⟩,
      ⟨fun x hx => ⟨hS.sub h02 hx, hS.sub h23 (hS.sub h02 hx)⟩, fun _ _ => rfl⟩⟩, hbs'.2.1⟩
  have hBu : s.UqCond lam N₀ N₂ d (id, id, N₃) := ⟨N₂, IsoOn.refl _, hnf⟩
  obtain ⟨-, -, -, -, -, -, -, fa, fb, Mab, hfa, -, e1, e2⟩ :=
    (huq N₂ hbs'.1 h02).2 (id, f, W) (id, id, N₃) hAm hAu hBm hBu
  ext x
  refine ⟨fun hx => ?_, fun hx => ⟨hS.sub h02 hx, hS.sub h01 hx⟩⟩
  have ex1 := e1 x hx.2
  have ex2 := e2 x hx.1
  simp only [id] at ex1 ex2
  have hfx : f x = x := hfa.injOn (hS.sub hQW (hfQ.mapsTo hx.1)) (hS.sub h1W hx.2)
    (by rw [← ex2, ex1])
  rw [← hdisj]
  exact ⟨⟨x, hx.1, hfx⟩, hx.2⟩

/-- Prop 5.3.6: (1) `NF*(N₀, N₁, N₂, N₃) → N₁ ∩ N₂ = N₀`; (2) `NF(N₀, N₁, N₂, N₃) → N₁ ∩ N₂ = N₀`. -/
theorem prop_5_3_6 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (N₀ N₁ N₂ N₃ : Model U L) :
    (s.NFStar lam N₀ N₁ N₂ N₃ → N₁.carrier ∩ N₂.carrier = N₀.carrier) ∧
      (s.NF lam N₀ N₁ N₂ N₃ → N₁.carrier ∩ N₂.carrier = N₀.carrier) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have h1 : ∀ {N₀ N₁ N₂ N₃ : Model U L}, s.NFStar lam N₀ N₁ N₂ N₃ →
      N₁.carrier ∩ N₂.carrier = N₀.carrier := by
    intro N₀ N₁ N₂ N₃ h
    obtain ⟨-, -, -, -, αs, A, B, d, -, -, hAcont, hBinc, -, -, ⟨h01, -⟩, ⟨h02, -⟩, hA0, hAα,
      hB0, -, hAB, -, huq, hnf⟩ := h
    have hdisj := Frame.disj_chain hU hc hAcont hBinc hAB
      (fun β hβ => prop_5_3_5 lam hU s hs (huq β hβ)) hnf αs le_rfl
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub h01 hx, hS.sub h02 hx⟩⟩
    have := hdisj ⟨by rw [hB0]; exact hx.2, by rw [hAα]; exact hx.1⟩
    rwa [hA0] at this
  refine ⟨h1, fun h => ?_⟩
  obtain ⟨-, -, -, -, h01, -, h02, -, N₀', N₁', N₂', N₃', hN0, -, hle1, hle2, -, hNF⟩ := h
  have := h1 hNF
  ext x
  refine ⟨fun hx => ?_, fun hx => ⟨hS.sub h01 hx, hS.sub h02 hx⟩⟩
  have hx' : x ∈ N₁'.carrier ∩ N₂'.carrier := ⟨hS.sub hle1 hx.1, hS.sub hle2 hx.2⟩
  rw [this, hN0] at hx'
  exact hx'

/-- AUX: not in paper. The core of the proof of Thm 5.3.7: from a decomposition of `N₁*` over
`N₀` by `K^{3,uq}` and `N₂ ≽ N₀` with `N₁ ∩ N₂ = N₀` for some `N₁ ⊆ N₁*`, Prop 3.1.8 gives
`NF*(N₀, N₁*, f[N₂], N₃)`; then (Prop 5.3.6 and Prop 5.3.3) the copy `f[N₂]` is moved back onto
`N₂` by an isomorphism fixing `N₁` pointwise. -/
theorem Frame.nfstar_core [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {N₀ N₁ N₁s N₂ : Model U L} (h₀ : N₀ ∈ s.S.Kc lam)
    (h₁s : N₁s ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam) (h02 : s.S.le N₀ N₂)
    (h1 : N₁.carrier ⊆ N₁s.carrier) (hdisj : N₁.carrier ∩ N₂.carrier = N₀.carrier)
    {αs : Ordinal.{u}} {A : Ordinal.{u} → Model U L} {d : Ordinal.{u} → U}
    (hdec : IsDecomp s.S lam (s.K3uq lam) N₀ N₁s αs A d) :
    ∃ (h : U → U) (N₁' N₃ : Model U L), IsoOn h N₁s N₁' ∧ (∀ x ∈ N₁.carrier, h x = x) ∧
      N₃ ∈ s.S.Kc lam ∧ N₁' ∈ s.S.Kc lam ∧
        ∃ A' B', s.NFStarWit lam N₀ N₁' N₂ N₃ αs A' B' (fun i => h (d i)) := by
  classical
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, -⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₀
  obtain ⟨hαs, hAK, hAinc, hAcont, hA0, hAT, hAα⟩ := hdec
  have hAK' : ∀ α ∈ Iic αs, A α ∈ s.S.Kc lam := fun α hα => by
    rcases (show α ≤ αs from hα).lt_or_eq with h | h
    · exact hAK α h
    · rw [h, hAα]; exact h₁s
  have hAle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (A β) (A γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hAinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hAK' γ hγ).1
  have h01s : s.S.le N₀ N₁s := by
    have := hAle 0 zero_le αs le_rfl zero_le; rwa [hA0, hAα] at this
  have hdm : ∀ i < αs, d i ∈ (A (i + 1)).carrier \ (A i).carrier := fun i hi =>
    (hAT i hi).1.2.2.1
  by_cases h02eq : N₀ = N₂
  · subst h02eq
    refine ⟨id, N₁s, N₁s, IsoOn.refl _, fun _ _ => rfl, h₁s, h₁s, A, A, hαs,
      hAinc, hAcont, hAinc, hAcont, ⟨hS.refl h₀.1, h01s⟩, ⟨h01s, hS.refl h₁s.1⟩,
      ⟨hS.refl h₀.1, h01s⟩, hA0, hAα, hA0, hAα, fun i hi => hS.refl (hAK' i hi).1, hdm, hAT,
      fun i hi => Frame.notFork_self hc (hAK i hi) (hAT i hi).1.2.2.2⟩
  obtain ⟨b, hb, hbb⟩ := hc.ax2c N₀ h₀ N₂ h₂ ⟨h02, h02eq⟩
  obtain ⟨f, Bs, hBK, hfB, hfov, hBinc, hBcont, hAB, hnfd, -⟩ := Frame.prop_3_1_8_strong lam hU s
    ⟨hc, hcont3, hsym⟩ αs A ⟨hAinc, hAcont, hAK'⟩ N₂ h₂ (by rw [hA0]; exact ⟨h02, h02eq⟩) d
    (fun α hα => ⟨hdm α hα, (hAT α hα).1⟩) b (by rw [hA0]; exact hb)
    (by rw [hA0]; exact ⟨h₀, h₂, hb, hbb⟩)
  rw [hA0] at hfov
  have hBle : ∀ β ≤ αs, ∀ γ ≤ αs, β ≤ γ → s.S.le (Bs β) (Bs γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hBinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hBK γ hγ).1
  have hB0αs := hBle 0 zero_le αs le_rfl zero_le
  have h0B0 : s.S.le N₀ (Bs 0) := by have := hAB 0 zero_le; rwa [hA0] at this
  have hw : s.NFStarWit lam N₀ N₁s (Bs 0) (Bs αs) αs A Bs d :=
    ⟨hαs, hAinc, hAcont, hBinc, hBcont,
      ⟨hS.refl h₀.1, hS.trans h0B0 hB0αs⟩, ⟨h01s, by rw [← hAα]; exact hAB αs le_rfl⟩,
      ⟨h0B0, hB0αs⟩, hA0, hAα, rfl, rfl, hAB, hdm, hAT, hnfd⟩
  have hNFs : s.NFStar lam N₀ N₁s (Bs 0) (Bs αs) :=
    ⟨h₀, h₁s, hBK 0 zero_le, hBK αs le_rfl, αs, A, Bs, d, hw⟩
  have hdisj' := (prop_5_3_6 lam hU s hs N₀ N₁s (Bs 0) (Bs αs)).1 hNFs
  have hN0B0 : N₀.carrier ⊆ (Bs 0).carrier := hS.sub h0B0
  obtain ⟨g, hgB, hgf, -⟩ := hfB.exists_inv
  have hgN0 : ∀ x ∈ N₀.carrier, g x = x := fun x hx => by
    have := hgf x (hS.sub h02 hx); rwa [hfov.2 x hx] at this
  let h₀ : U → U := fun x => if x ∈ (Bs 0).carrier then g x else x
  have hN₁B0 : ∀ x ∈ N₁.carrier, x ∈ (Bs 0).carrier → x ∈ N₀.carrier := fun x hx hxB => by
    rw [← hdisj']; exact ⟨h1 hx, hxB⟩
  have hinj : InjOn h₀ ((Bs 0).carrier ∪ N₁.carrier) := by
    intro x hx y hy hxy
    by_cases hxB : x ∈ (Bs 0).carrier <;> by_cases hyB : y ∈ (Bs 0).carrier
    · simp only [h₀, hxB, hyB, if_true] at hxy; exact hgB.injOn hxB hyB hxy
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hyN₁ : y ∈ N₁.carrier := hy.resolve_left hyB
      have hyN₂ : y ∈ N₂.carrier := by rw [← hxy]; exact hgB.mapsTo hxB
      exact absurd (hN0B0 (by rw [← hdisj]; exact ⟨hyN₁, hyN₂⟩)) hyB
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hxN₁ : x ∈ N₁.carrier := hx.resolve_left hxB
      have hxN₂ : x ∈ N₂.carrier := by rw [hxy]; exact hgB.mapsTo hyB
      exact absurd (hN0B0 (by rw [← hdisj]; exact ⟨hxN₁, hxN₂⟩)) hxB
    · simp only [h₀, hxB, hyB, if_false] at hxy; exact hxy
  have hsmall : #(∅ ∪ h₀ '' ((Bs 0).carrier ∪ N₁.carrier) : Set U) < #U := by
    rw [Set.empty_union]
    refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset ?_)
      (card_union_le h₂ h₁s hinf)) hU.2
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxB : x ∈ (Bs 0).carrier
    · left; simp only [h₀, hxB, if_true]; exact hgB.mapsTo hxB
    · right; simp only [h₀, hxB, if_false]; exact h1 (hx.resolve_left hxB)
  obtain ⟨h, hhinj, hhD, -⟩ := exists_rename hU.infinite h₀ hinj (X := (Bs αs).carrier) hsmall
  have hhB0 : ∀ x ∈ (Bs 0).carrier, h x = g x := fun x hx => by
    rw [hhD x (Or.inl hx)]; simp only [h₀, hx, if_true]
  have hhN₁ : ∀ x ∈ N₁.carrier, h x = x := fun x hx => by
    rw [hhD x (Or.inr hx)]
    by_cases hxB : x ∈ (Bs 0).carrier
    · simp only [h₀, hxB, if_true]; exact hgN0 x (hN₁B0 x hx hxB)
    · simp only [h₀, hxB, if_false]
  obtain ⟨N₃, hN₃⟩ := exists_isoOn hhinj
  have h1sB : s.S.le N₁s (Bs αs) := by rw [← hAα]; exact hAB αs le_rfl
  obtain ⟨N₁', hN₁'⟩ := exists_isoOn (hhinj.mono (hS.sub h1sB))
  have hN0iso : IsoOn h N₀ N₀ := (IsoOn.refl _).congr fun x hx =>
    ((hhB0 x (hN0B0 hx)).trans (hgN0 x hx)).symm
  have hB0iso : IsoOn h (Bs 0) N₂ := hgB.congr fun x hx => (hhB0 x hx).symm
  obtain ⟨A', B', hw', -⟩ := Frame.nfstarWit_iso hU hc hN₃ hN0iso hN₁' hB0iso hw
  exact ⟨h, N₁', N₃, hN₁', hhN₁, ⟨hS.iso_mem (hBK αs le_rfl).1 hN₃,
    by rw [hN₃.card_eq]; exact (hBK αs le_rfl).2⟩,
    ⟨hS.iso_mem h₁s.1 hN₁', by rw [hN₁'.card_eq]; exact h₁s.2⟩, A', B', hw'⟩

/-- AUX: not in paper. Thm 5.3.7(b), proved separately (see the note at Thm 5.3.7(c)). -/
theorem Frame.thm_5_3_7_b [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {N₀ N₁ N₂ : Model U L} (h₀ : N₀ ∈ s.S.Kc lam)
    (h₁ : N₁ ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam) (h02 : s.S.le N₀ N₂)
    (hdisj : N₁.carrier ∩ N₂.carrier = N₀.carrier)
    (hdec : Decomposable s.S lam (s.K3uq lam) N₀ N₁) :
    ∃ N₃ ∈ s.S.Kc lam, s.NFStar lam N₀ N₁ N₂ N₃ := by
  obtain ⟨-, αs, A, d, hd⟩ := hdec
  obtain ⟨h, N₁', N₃, hiso, hid, hN₃, hN₁'c, A', B', hw⟩ := Frame.nfstar_core hU hs h₀ h₁ h₂ h02
    subset_rfl hdisj hd
  have hNF : s.NFStar lam N₀ N₁' N₂ N₃ := ⟨h₀, hN₁'c, h₂, hN₃, αs, A', B', _, hw⟩
  have e : N₁' = N₁ := hiso.unique ((IsoOn.refl N₁).congr fun x hx => (hid x hx).symm)
  exact ⟨N₃, hN₃, e ▸ hNF⟩

/-- AUX: not in paper. Thm 5.3.7(a), proved separately (see the note at Thm 5.3.7(c)). -/
theorem Frame.thm_5_3_7_a [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {N₀ N₁ N₂ : Model U L} (h₀ : N₀ ∈ s.S.Kc lam)
    (h₁ : N₁ ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam) (h01 : s.S.le N₀ N₁) (h02 : s.S.le N₀ N₂)
    (hdisj : N₁.carrier ∩ N₂.carrier = N₀.carrier) :
    ∃ N₃ ∈ s.S.Kc lam, s.NF lam N₀ N₁ N₂ N₃ := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc h₀
  have hdec : ∃ Ms ∈ s.S.Kc lam, s.S.le N₁ Ms ∧ ∃ αs A d,
      IsDecomp s.S lam (s.K3uq lam) N₀ Ms αs A d := by
    by_cases h01eq : N₀ = N₁
    · haveI : Infinite U := hU.infinite
      refine ⟨N₁, h₁, hS.refl h₁.1, 0, fun _ => N₀, fun _ => Classical.arbitrary U,
        (Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))).bot_lt,
        fun ε hε => absurd hε (not_lt.2 zero_le),
        fun β _ γ hγ h => absurd (lt_of_lt_of_le h hγ) (not_lt.2 zero_le),
        fun γ hγ hl => by
          rw [le_antisymm (show γ ≤ 0 from hγ) zero_le] at hl
          exact absurd hl Order.not_isSuccLimit_bot,
        rfl, fun ε hε => absurd hε (not_lt.2 zero_le), h01eq⟩
    · obtain ⟨Ms, hMs, hN₁Ms, -, αs, A, d, hd⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩
        (s.K3uq lam) (fun _ h => h.1) (Frame.K3uq_isoClosed hU hc) hex N₀ N₁ h₀ h₁
        ⟨h01, h01eq⟩).1
      exact ⟨Ms, hMs, hN₁Ms, αs, A, d, hd⟩
  obtain ⟨Ms, hMs, hN₁Ms, αs, A, d, hd⟩ := hdec
  obtain ⟨h, N₁', N₃, hiso, hid, hN₃, hN₁'c, A', B', hw⟩ := Frame.nfstar_core hU hs h₀ hMs h₂ h02
    (hS.sub hN₁Ms) hdisj hd
  have hNF : s.NFStar lam N₀ N₁' N₂ N₃ := ⟨h₀, hN₁'c, h₂, hN₃, αs, A', B', _, hw⟩
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨-, l13⟩, ⟨-, l23⟩, -⟩ := id hNF
  have hN₁N₁' : s.S.le N₁ N₁' :=
    hS.iso_le hN₁Ms hiso ((IsoOn.refl N₁).congr fun x hx => (hid x hx).symm)
  exact ⟨N₃, hN₃, h₀, h₁, h₂, hN₃, h01, hS.trans hN₁N₁' l13, h02, l23, N₀, N₁', N₂, N₃, rfl,
    hS.refl h₀.1, hN₁N₁', hS.refl h₂.1, hS.refl hN₃.1, hNF⟩

/-- AUX: not in paper. Thm 5.3.7(c) in its corrected form (see the erratum at Thm 5.3.7). -/
theorem Frame.thm_5_3_7_c [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {N₀ N₁ N₂ : Model U L} (h₀ : N₀ ∈ s.S.Kc lam)
    (h₁ : N₁ ∈ s.S.Kc lam) (h₂ : N₂ ∈ s.S.Kc lam) (h01 : s.S.le N₀ N₁) (h02 : s.S.le N₀ N₂)
    (hdisj : N₁.carrier ∩ N₂.carrier = N₀.carrier) {a : U} (ha : a ∈ N₁.carrier \ N₀.carrier)
    (hab : tp s.S lam a N₀ N₁ ∈ s.Sbs N₀) :
    ∃ N₃ ∈ s.S.Kc lam, ∃ N₁s ∈ s.S.Kc lam, s.S.le N₁ N₁s ∧
      ∃ αs A B d, s.NFStarWit lam N₀ N₁s N₂ N₃ αs A B d ∧ d 0 = a := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨Ms, hMs, hN₁Ms, αs, A, d, hd, hd0⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩
    (s.K3uq lam) (fun _ h => h.1) (Frame.K3uq_isoClosed hU hc) hex N₀ N₁ h₀ h₁
    ⟨h01, fun h => ha.2 (by rw [h]; exact ha.1)⟩).2 a ha hab
  obtain ⟨h, N₁', N₃, hiso, hid, hN₃, hN₁'c, A', B', hw⟩ := Frame.nfstar_core hU hs h₀ hMs h₂ h02
    (hS.sub hN₁Ms) hdisj hd
