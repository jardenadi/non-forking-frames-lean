      · rw [xa1 b' (Order.lt_add_one_iff.1 h)]; exact lbb _ ha'r _ (Order.lt_add_one_iff.1 h) hab
      · rw [h, xa2]; exact hS.trans (lbP a' ha'r) lPN
    · intro β hβ hl
      have hβr : β ≤ r := by
