theorem Frame.IsRun.ext_lim {s : Frame U L} {lam : Cardinal.{u}}
    {D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U}
    {G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L}
    {δ : Ordinal.{u}} {A B : Ordinal.{u} → Model U L} (hl : Order.IsSuccLimit δ)
