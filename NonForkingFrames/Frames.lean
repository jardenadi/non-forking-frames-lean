        have hle : ∀ i ≤ r - ε, ε + i ≤ r := fun i hi => by
          rw [← hbase]; exact (add_le_add_iff_left _).2 hi
        have hδ : r - ε < (Order.succ lam).ord := lt_of_le_of_lt (Ordinal.sub_le_self _ _) hrκ
        have mkC : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing s.S.le X (Iic r) →
