    (inv b hb).2.2.2.2.2.2 b (mem_Iic.2 le_rfl) hl
  have hstep : ∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)) :=
    fun α hα => (out α hα).2.2.2.2.2
  have hsucc : ∀ {a b : Ordinal.{u}}, a < b → a + 1 ≤ b := fun h => Order.add_one_le_of_lt h
  have hstr : ∀ α < (Order.succ lam).ord, ∀ β < (Order.succ lam).ord, α < β → s.S.lt (B α) (B β) := by
    intro α hα β hβ hαβ
