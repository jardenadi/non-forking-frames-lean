/-! ## 2.6 Non-forking with larger models -/

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

-- DEVIATION (author-confirmed erratum): clause (3) as written ("for each `N ∈ K_λ`,
-- `N₀ ∪ {a} ⊆ N ≼ M₁ → ⨿(N₀, a, N, M₂)`") is vacuous since `a ∉ M₁`. Repaired (universal
-- version): for every `N ∈ K_λ` with `N₀ ⊆ N ≼ M₁` and every `N' ∈ K_λ` with
-- `N ∪ {a} ⊆ N' ≼ M₂`, `⨿(N₀, N, a, N')` (argument order of Def 2.1.1).
/-- Def 2.6.1: `⨿^{≥λ}(M₀, a, M₁, M₂)` iff (1) `λ ≤ ‖Mᵢ‖`, (2) `M₀ ≼ M₁ ≼ M₂`, `a ∈ M₂ - M₁`,
(3) original text: "for some model `N₀ ∈ K_λ` with `N₀ ≼ M₀` for each model `N ∈ K_λ`,
`N₀ ∪ {a} ⊆ N ≼ M₁ ⇒ ⨿(N₀, a, N, M₂)`". Erratum (confirmed by the author): for some
`N₀ ∈ K_λ`, `N₀ ≼ M₀`, for every `N ∈ K_λ` with `N₀ ⊆ N ≼ M₁` and every `N' ∈ K_λ` with
`N ∪ {a} ⊆ N' ≼ M₂`, `⨿(N₀, N, a, N')`. -/
def nfGe (M₀ : Model U L) (a : U) (M₁ M₂ : Model U L) : Prop :=
  lam ≤ M₀.card ∧ lam ≤ M₁.card ∧ lam ≤ M₂.card ∧ s.S.le M₀ M₁ ∧ s.S.le M₁ M₂ ∧
    a ∈ M₂.carrier \ M₁.carrier ∧
    ∃ N₀ ∈ s.S.Kc lam, s.S.le N₀ M₀ ∧
      ∀ N ∈ s.S.Kc lam, N₀.carrier ⊆ N.carrier → s.S.le N M₁ →
        ∀ N' ∈ s.S.Kc lam, N.carrier ∪ {a} ⊆ N'.carrier → s.S.le N' M₂ → s.nf N₀ N a N'

-- AGENT-CHOICE (reading): the undefined symbol `⨿^{≤λ}` is read as `⨿^{≥λ}` (Def 2.6.1).
/-- Def 2.6.2: for `M₀ ≼ M₁` in `K_{≥λ}` and `p ∈ S(M₁)`, `p` does not fork over `M₀` when for
some triple `(M₁, M₂, a) ∈ p`, `⨿^{≤λ}(M₀, a, M₁, M₂)` (read as `⨿^{≥λ}`, docs/METHOD.md). -/
def NotForkGe (M₀ M₁ : Model U L) (p : Set (Tri U L)) : Prop :=
  M₀ ∈ s.S.KGe lam ∧ M₁ ∈ s.S.KGe lam ∧ s.S.le M₀ M₁ ∧ p ∈ SAll s.S lam M₁ ∧
    ∃ (M₂ : Model U L) (a : U), (M₁, M₂, a) ∈ p ∧ s.nfGe lam M₀ a M₁ M₂

/-- Def 2.6.4: for `M ∈ K_{>λ}`, `S^bs_{>λ}(M)`: types `p ∈ S(M)` that do not fork over some
`N ∈ K_λ` with `N ≼ M`. -/
def SbsGt (M : Model U L) : Set (Set (Tri U L)) :=
  {p | M ∈ s.S.KGt lam ∧ p ∈ SAll s.S lam M ∧ ∃ N ∈ s.S.Kc lam, s.S.le N M ∧ s.NotForkGe lam N M p}

/-- Def 2.6.4: `S^bs_{≥λ}(M)`: `S^bs(M)` if `‖M‖ = λ`, `S^bs_{>λ}(M)` if `‖M‖ > λ`. -/
def SbsGe (M : Model U L) : Set (Set (Tri U L)) :=
  {p | (M.card = lam ∧ p ∈ s.Sbs M) ∨ (lam < M.card ∧ p ∈ s.SbsGt lam M)}

-- AGENT-CHOICE: `α*` ranges over limit ordinals (as `δ` in local character, Def 2.1.1(3)(c)); for
-- `α* = 0` the conclusion "for some α < α*" is impossible and the notion would be unsatisfiable.
/-- Def 2.6.5: weak local character for `R`-increasing sequences (`R` is `≺*_λ`): if
`α* < λ⁺` and `⟨M_α : α ≤ α*+1⟩` is `R`-increasing continuous, then for some
`a ∈ M_{α*+1} - M_{α*}` and `α < α*`, `tp(a, M_{α*}, M_{α*+1})` does not fork over `M_α`. -/
def WLCFor (R : Model U L → Model U L → Prop) : Prop :=
  ∀ αs < (Order.succ lam).ord, Order.IsSuccLimit αs → ∀ M : Ordinal.{u} → Model U L,
    IsIncreasing R M (Iic (αs + 1)) → IsContinuous M (Iic (αs + 1)) →
      ∃ a ∈ (M (αs + 1)).carrier \ (M αs).carrier, ∃ α < αs,
        s.NotFork lam (M α) (M αs) (tp s.S lam a (M αs) (M (αs + 1)))

-- AGENT-CHOICE (reading): clause (4) "local character for ≺*-increasing sequences" is read as
-- Def 2.6.5 (weak local character for ≺*-increasing sequences); cf. Remark 2.6.7.
/-- Def 2.6.6: weak local character: for some relation `R = ≺*_λ`, (1) `R` is a relation on
`K_λ`, (2) `R ⊆ ≺`, (3) `M₀ R M₁ ≼ M₂ ∈ K_λ → M₀ R M₂`, (4) local character for `R`-increasing
sequences (read as Def 2.6.5; see docs/ERRATA.md, A.1.11), (5) if `M₀ ∈ K_λ`, `M₀ ≺ M₂ ∈ K_{λ⁺}` then
`M₀ R M₁ ≼ M₂` for some `M₁ ∈ K_λ`. -/
def WeakLC : Prop :=
  ∃ R : Model U L → Model U L → Prop,
    (∀ M N, R M N → M ∈ s.S.Kc lam ∧ N ∈ s.S.Kc lam) ∧ (∀ M N, R M N → s.S.lt M N) ∧
    (∀ M₀ M₁ M₂, R M₀ M₁ → s.S.le M₁ M₂ → M₂ ∈ s.S.Kc lam → R M₀ M₂) ∧ s.WLCFor lam R ∧
    ∀ M₀ ∈ s.S.Kc lam, ∀ M₂ ∈ s.S.Kc (Order.succ lam), s.S.lt M₀ M₂ →
      ∃ M₁ ∈ s.S.Kc lam, R M₀ M₁ ∧ s.S.le M₁ M₂

end Frame

-- Original context: semi-good frame. AGENT-CHOICE (added hypothesis): only the axioms used
-- (independence of the representative, as in Prop 2.1.2): (0)(a), (0)(b), (1)(b), (3)(a), (3)(b).
/-- Remark 2.6.3: in Def 2.6.2 "for some triple" can be replaced by "for each triple". -/
theorem rem_2_6_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (h0a : s.Ax0a)
    (h0b : s.Ax0b lam) (h1b : s.Ax1b lam) (h3a : s.Ax3a lam) (h3b : s.Ax3b lam)
    (M₀ M₁ : Model U L) (h₀ : M₀ ∈ s.S.KGe lam) (h₁ : M₁ ∈ s.S.KGe lam) (h01 : s.S.le M₀ M₁)
    (p : Set (Tri U L)) (hp : p ∈ SAll s.S lam M₁) :
    s.NotForkGe lam M₀ M₁ p ↔ ∀ (M₂ : Model U L) (a : U), (M₁, M₂, a) ∈ p → s.nfGe lam M₀ a M₁ M₂ := by
  have hS : IsAEC s.S := h0a
  obtain ⟨M₃, c, hc3, rfl⟩ := hp
  constructor
  · rintro ⟨-, -, -, -, M₂, a, hmem, hge⟩ M₂' b hmem'
    obtain ⟨hc0, hc1, -, hle01, hle12, ha, N₀, hN₀, hN₀M₀, huniv⟩ := hge
    have hm : ERel s.S lam (M₁, M₃, c) (M₁, M₂, a) := hmem
    have hm' : ERel s.S lam (M₁, M₃, c) (M₁, M₂', b) := hmem'
    have hE : ERel s.S lam (M₁, M₂, a) (M₁, M₂', b) :=
      Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ hm) hm'
    have hK3 : (M₁, M₂', b) ∈ s.S.K3 := (ERel.K3_iff hm').1 hc3
    have hbM₁ : b ∉ M₁.carrier := fun hb => by
      have e : a = b := (ERel.alg hE).2 hb
      exact ha.2 (e ▸ hb)
    refine ⟨hc0, hc1, hc1.trans (Model.card_le_of_sub (hS.sub hK3.2.2.1)), hle01, hK3.2.2.1,
      ⟨hK3.2.2.2, hbM₁⟩, N₀, hN₀, hN₀M₀, ?_⟩
    intro N hN hN₀N hNM₁ N' hN' hsubN' hN'M₂'
    have hbN : b ∉ N.carrier := fun hb => hbM₁ (hS.sub hNM₁ hb)
    have hinf := aleph0_le_of_ssubset hN.2 hN'.2 (Set.subset_union_left.trans hsubN')
      (hsubN' (Or.inr rfl)) hbN
    obtain ⟨W, hW, hsubW, hWM₂⟩ := hS.exists_small h0b hinf hN (hS.mem_right hle12)
      (hS.sub (hS.trans hNM₁ hle12)) ha.1
    have hnfW := huniv N hN hN₀N hNM₁ W hW hsubW hWM₂
    have hEN : ERel s.S lam (N, M₂, a) (N, M₂', b) := ERel.restrict hS hE N hNM₁
    obtain ⟨V, -, -, hVM₂', hnfV⟩ :=
      (Frame.nfWit_of_ERel hS h0b h3a h3b hEN rfl).1 ⟨W, hW, hsubW, hWM₂, hnfW⟩
    have h3 := h3a.1 _ _ _ _ hnfV
    exact h3b N₀ N₀ N N V M₂' N' b (hS.refl h3.1.1) h3.2.2.2.2.1 (hS.refl h3.2.1.1)
      h3.2.2.2.2.2.1 hVM₂' hsubN' hN'M₂' hN' hnfV
  · intro h
    exact ⟨h₀, h₁, h01, ⟨M₃, c, hc3, rfl⟩, M₃, c, mem_tp_self _ _ _ _ _,
      h M₃ c (mem_tp_self _ _ _ _ _)⟩

-- PROOF-STAGE CHANGE: hypothesis `R ⊆ ≼` strengthened to `R ⊆ ≺` (as in Def 2.6.6(2)). With
-- `R ⊆ ≼` the remark is false: for `R` = equality on `K_λ` a constant chain has no
-- `a ∈ M_{α*+1} − M_{α*}` (step: applying density needs `M_{α*} ≺ M_{α*+1}`).
/-- Remark 2.6.7: if `s` is a semi-good `λ`-frame and `R ⊆ ≼` is a relation on `K_λ`, then `s`
satisfies weak local character for `R`-increasing sequences. -/
theorem rem_2_6_7 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : s.IsSemiGood lam)
    (R : Model U L → Model U L → Prop) (hR : ∀ M N, R M N → M ∈ s.S.Kc lam ∧ N ∈ s.S.Kc lam)
    (hRle : ∀ M N, R M N → s.S.lt M N) :
    s.WLCFor lam R := by
  intro αs hαs hlim M hinc hcont
  have hlt : αs < αs + 1 := Order.lt_add_one_iff.2 le_rfl
  have hR1 : R (M αs) (M (αs + 1)) := hinc αs (Set.mem_Iic.2 (le_of_lt hlt)) (αs + 1) (Set.mem_Iic.2 le_rfl) hlt
  obtain ⟨hMc, hM1c⟩ := hR _ _ hR1
  obtain ⟨a, ha, hbs⟩ := hs.1.ax2c (M αs) hMc (M (αs + 1)) hM1c (hRle _ _ hR1)
  have hmem : ∀ α ∈ Iic (αs + 1), M α ∈ s.S.Kc lam := fun α hα => by
    rcases (show α ≤ αs + 1 from hα).lt_or_eq with h | h
    · exact (hR _ _ (hinc α (Set.mem_Iic.2 (le_of_lt h)) (αs + 1) (Set.mem_Iic.2 le_rfl) h)).1
    · rw [h]; exact hM1c
  obtain ⟨α, hα, hnf⟩ := hs.2.2.2.2 αs hlim hαs M
    ⟨fun x hx y hy hxy => (hRle _ _ (hinc x hx y hy hxy)).1, hcont, hmem⟩ a hbs
  exact ⟨a, ha, α, hα, hnf⟩

/-- Thm 2.6.8(2), monotonicity: `M₀ ≼ M₁ ≼ M₂` in `K_{≥λ}`, `‖M₂‖ > λ`; if
`p ∈ S^bs_{≥λ}(M₂)` does not fork over `M₀`, then (a) `p` does not fork over `M₁` and
(b) `p ↾ M₁` does not fork over `M₀`. -/
theorem thm_2_6_8_2 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.IsSemiGoodExceptLC lam) (M₀ M₁ M₂ : Model U L) (h01 : s.S.le M₀ M₁)
    (h12 : s.S.le M₁ M₂) (h₀ : M₀ ∈ s.S.KGe lam) (h₁ : M₁ ∈ s.S.KGe lam)
    (h₂ : M₂ ∈ s.S.KGe lam) (hgt : lam < M₂.card) (p : Set (Tri U L)) (hp : p ∈ s.SbsGe lam M₂)
    (hnf : s.NotForkGe lam M₀ M₂ p) :
    s.NotForkGe lam M₁ M₂ p ∧ s.NotForkGe lam M₀ M₁ (res s.S lam p M₁) := by
  have hS : IsAEC s.S := hs.1.ax0a
  obtain ⟨-, -, -, hpS, M₃, a, hmem, hge⟩ := hnf
  obtain ⟨hc0, hc2, hc3, -, h23, ha, N₀, hN₀, hN₀M₀, huniv⟩ := hge
  obtain ⟨X, c, hK, rfl⟩ := hpS
  refine ⟨⟨h₁, h₂, h12, ⟨X, c, hK, rfl⟩, M₃, a, hmem, h₁.2, hc2, hc3, h12, h23, ha, N₀, hN₀,
    hS.trans hN₀M₀ h01, huniv⟩, ?_⟩
  have hE : tp s.S lam a M₂ M₃ = tp s.S lam c M₂ X := mem_tp_iff.1 hmem
  rw [← hE, res_tp hS h12]
  refine ⟨h₀, h₁, h01, ⟨M₃, a, ⟨h₁.1, hS.mem_right h23, hS.trans h12 h23, ha.1⟩, rfl⟩, M₃, a,
    mem_tp_self _ _ _ _ _, hc0, h₁.2, hc3, h01, hS.trans h12 h23,
    ⟨ha.1, fun h => ha.2 (hS.sub h12 h)⟩, N₀, hN₀, hN₀M₀,
    fun N hN hN₀N hNM₁ => huniv N hN hN₀N (hS.trans hNM₁ h12)⟩

/-- Thm 2.6.8(3), transitivity: `M₀ ≼ M₁ ≼ M₂` in `K_{≥λ}`; if `p ∈ S^bs_{≥λ}(M₂)` does not fork
over `M₁` and `p ↾ M₁` does not fork over `M₀`, then `p` does not fork over `M₀`. -/
theorem thm_2_6_8_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.IsSemiGoodExceptLC lam) (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.KGe lam)
    (h₁ : M₁ ∈ s.S.KGe lam) (h₂ : M₂ ∈ s.S.KGe lam) (h01 : s.S.le M₀ M₁) (h12 : s.S.le M₁ M₂)
    (p : Set (Tri U L)) (hp : p ∈ s.SbsGe lam M₂) (hnf : s.NotForkGe lam M₁ M₂ p)
    (hnf' : s.NotForkGe lam M₀ M₁ (res s.S lam p M₁)) :
    s.NotForkGe lam M₀ M₂ p := by
  have hc := hs.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, -, -, hpS, M₃, a, hmem, hge⟩ := hnf
  obtain ⟨-, hc2, hc3, -, h23, ha, N₁, hN₁, hN₁M₁, huniv₁⟩ := hge
  obtain ⟨X, c, hK, rfl⟩ := hpS
  have hE : tp s.S lam a M₂ M₃ = tp s.S lam c M₂ X := mem_tp_iff.1 hmem
  rw [← hE, res_tp hS h12] at hnf'
  have hK13 : (M₁, M₃, a) ∈ s.S.K3 := ⟨h₁.1, hS.mem_right h23, hS.trans h12 h23, ha.1⟩
  have hge0 := (rem_2_6_3 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b M₀ M₁ h₀ h₁ h01 _
    ⟨M₃, a, hK13, rfl⟩).1 hnf' M₃ a (mem_tp_self _ _ _ _ _)
  obtain ⟨-, -, -, -, -, -, N₀, hN₀, hN₀M₀, huniv₀⟩ := hge0
  refine ⟨h₀, h₂, hS.trans h01 h12, ⟨X, c, hK, rfl⟩, M₃, a, hmem, h₀.2, hc2, hc3,
    hS.trans h01 h12, h23, ha, N₀, hN₀, hN₀M₀, ?_⟩
  intro N hN hN₀N hNM₂ N' hN' hsubN' hN'M₃
  have haN : a ∉ N.carrier := fun h => ha.2 (hS.sub hNM₂ h)
  have hinf := aleph0_le_of_ssubset hN.2 hN'.2 (Set.subset_union_left.trans hsubN')
    (hsubN' (Or.inr rfl)) haN
  obtain ⟨B, hB, hsubB, hBM₁⟩ := hS.exists_hull hc.ax0b hinf hN₁ h₁.1 Set.subset_union_right
    (Set.union_subset (hS.sub (hS.trans hN₀M₀ h01)) (hS.sub hN₁M₁)) (card_union_le hN₀ hN₁ hinf)
  obtain ⟨C, hC, hsubC, hCM₂⟩ := hS.exists_hull hc.ax0b hinf hN h₂.1 Set.subset_union_right
    (Set.union_subset ((hS.sub hBM₁).trans (hS.sub h12)) (hS.sub hNM₂)) (card_union_le hB hN hinf)
  obtain ⟨C'', hC'', hsubC'', hC''M₃⟩ := hS.exists_hull hc.ax0b hinf hN' (hS.mem_right h23)
    Set.subset_union_right
    (Set.union_subset ((hS.sub hCM₂).trans (hS.sub h23)) (hS.sub hN'M₃))
    (card_union_le hC hN' hinf)
  have haC'' : a ∈ C''.carrier := hsubC'' (Or.inr (hsubN' (Or.inr rfl)))
  have hBCs : B.carrier ⊆ C.carrier := Set.subset_union_left.trans hsubC
  have hCC''s : C.carrier ⊆ C''.carrier := Set.subset_union_left.trans hsubC''
  have hBC : s.S.le B C := hS.le_of_sub (hS.trans hBM₁ h12) hCM₂ hBCs
  have hN₁B : s.S.le N₁ B := hS.le_of_sub hN₁M₁ hBM₁ (Set.subset_union_right.trans hsubB)
  have hN₀B : s.S.le N₀ B :=
    hS.le_of_sub (hS.trans hN₀M₀ h01) hBM₁ (Set.subset_union_left.trans hsubB)
  have hnf1 : s.nf N₁ C a C'' := huniv₁ C hC ((hS.sub hN₁B).trans hBCs) hCM₂ C'' hC''
    (Set.union_subset hCC''s (Set.singleton_subset_iff.2 haC'')) hC''M₃
  have hnf0 : s.nf N₀ B a C'' := huniv₀ B hB (Set.subset_union_left.trans hsubB) hBM₁ C'' hC''
    (Set.union_subset (hBCs.trans hCC''s) (Set.singleton_subset_iff.2 haC'')) hC''M₃
  have hnfBC : s.nf B C a C'' := Frame.nf_mono hS hc.ax3a hc.ax3b hnf1 hN₁B hBC (hS.refl hC.1)
  have h3BC := hc.ax3a.1 _ _ _ _ hnfBC
  have htr := Frame.notFork_trans hc hN₀ hC hN₀B hBC h3BC.2.2.2.2.2.2.2 ⟨a, C'', rfl, hnfBC⟩
    (by rw [res_tp hS hBC]; exact ⟨a, C'', rfl, hnf0⟩)
  obtain ⟨d, Y, hEq, hnfd⟩ := htr
  have hnfC : s.nf N₀ C a C'' :=
    prop_2_1_2 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b N₀ C Y C'' d a hC'' hnfd hEq
  have hN₀N : s.S.le N₀ N := hS.le_of_sub (hS.trans hN₀M₀ (hS.trans h01 h12)) hNM₂ hN₀N
  have hNC : s.S.le N C := hS.le_of_sub hNM₂ hCM₂ (Set.subset_union_right.trans hsubC)
  have hnfN : s.nf N₀ N a C'' := Frame.nf_mono hS hc.ax3a hc.ax3b hnfC (hS.refl hN₀.1) hN₀N hNC
  have h3N := hc.ax3a.1 _ _ _ _ hnfN
  exact hc.ax3b N₀ N₀ N N C'' M₃ N' a (hS.refl hN₀.1) h3N.2.2.2.2.1 (hS.refl hN.1)
    h3N.2.2.2.2.2.1 hC''M₃ hsubN' hN'M₃ hN' hnfN

/-! ════════════════════════════════════════════════════════════════════════════
    PART 3 : SECTION 3  (The decomposition and amalgamation method)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 3.0.1: `s` is a semi-good `λ`-frame, except basic almost stability and local
character. -/
def Hyp_3_0_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

/-- Def 3.1.1(1): `K^{3,bs} = {(M, N, a) : M, N ∈ K_λ, a ∈ N - M, tp(a, M, N) ∈ S^bs(M)}`. -/
def K3bs : Set (Tri U L) :=
  {t | t.1 ∈ s.S.Kc lam ∧ t.2.1 ∈ s.S.Kc lam ∧ t.2.2 ∈ t.2.1.carrier \ t.1.carrier ∧
    tp s.S lam t.2.2 t.1 t.2.1 ∈ s.Sbs t.1}

/-- Def 3.1.1(2): `(M, N, a) ≼_bs (M*, N*, a*)` iff `M ≼ M*`, `N ≼ N*`, `a* = a` and
`tp(a, M*, N*)` does not fork over `M` (a relation on `K^{3,bs}`). -/
def leBs (t t' : Tri U L) : Prop :=
  t ∈ s.K3bs lam ∧ t' ∈ s.K3bs lam ∧ s.S.le t.1 t'.1 ∧ s.S.le t.2.1 t'.2.1 ∧ t'.2.2 = t.2.2 ∧
    s.NotFork lam t.1 t'.1 (tp s.S lam t.2.2 t'.1 t'.2.1)

/-- Def 3.1.3: `(M₀, N₀, a) ≼_bs^disjoint (M₁, N₁, a)` iff `(M₀, N₀, a) ≼_bs (M₁, N₁, a)` and
`N₀ ∩ M₁ = M₀`. -/
def leBsDisj (t t' : Tri U L) : Prop :=
  s.leBs lam t t' ∧ t.2.1.carrier ∩ t'.1.carrier = t.1.carrier

end Frame

/-- ENCODING for Def 3.1.2: the constant symbol `c`. -/
inductive TriFun : ℕ → Type u
  | c : TriFun 0

/-- ENCODING for Def 3.1.2: the unary predicate `P`. -/
inductive TriRel : ℕ → Type u
  | P : TriRel 1

/-- Def 3.1.2: the symbols added in the vocabulary of triples, `{P, c}`. -/
def LTri : Language.{u, u} := ⟨TriFun, TriRel⟩

/-- Def 3.1.2: the interpretation of `P, c` for a triple `(M, N, a)`: `P = M`, `c = a`. -/
@[instance_reducible] def triStr (M N : Model U L) (a : U) (ha : a ∈ N.carrier) : LTri.Structure N.carrier where
  funMap := fun {n} f _ => match n, (f : TriFun n) with
    | _, TriFun.c => ⟨a, ha⟩
  RelMap := fun {n} r x => match n, (r : TriRel n), x with
    | _, TriRel.P, x => ((x 0 : N.carrier) : U) ∈ M.carrier

/-- Def 3.1.2: the triple `(M, N, a)` as a model for the vocabulary of triples `τ ∪ {P, c}`. -/
def triModel (t : Tri U L) (h : t.2.2 ∈ t.2.1.carrier) : Model U (L.sum LTri) where
  carrier := t.2.1.carrier
  str := @Language.sumStructure L LTri _ t.2.1.str (triStr t.1 t.2.1 t.2.2 h)

/-- ENCODING: a class of triples `T` with a relation `R` on it, as a `KSys` for the vocabulary
of triples. -/
def triKSys (T : Set (Tri U L)) (R : Tri U L → Tri U L → Prop) : KSys U (L.sum LTri) :=
  ⟨{X | ∃ t h, t ∈ T ∧ X = triModel t h}, fun X Y => ∃ t h t' h', t ∈ T ∧ t' ∈ T ∧
    X = triModel t h ∧ Y = triModel t' h' ∧ R t t'⟩

/-- Def 3.1.5: `⟨(M_α, N_α, a) : α < θ⟩` is `≼_bs`-increasing continuous: each step is
`≼_bs` and `⟨M_α⟩, ⟨N_α⟩` are (increasing and) continuous. -/
def Frame.BsIncCont (s : Frame U L) (lam : Cardinal.{u}) (M N : Ordinal.{u} → Model U L) (a : U)
    (θ : Ordinal.{u}) : Prop :=
  (∀ α < θ, s.leBs lam (M α, N α, a) (M (α + 1), N (α + 1), a)) ∧
    IsIncreasing s.S.le M (Iio θ) ∧ IsContinuous M (Iio θ) ∧
    IsIncreasing s.S.le N (Iio θ) ∧ IsContinuous N (Iio θ)

/-- ENCODING: `(M, N, a) ⊆ (M', N', a')` for the vocabulary of triples. -/
def TriSub (t t' : Tri U L) : Prop :=
  IsSubstr t.2.1 t'.2.1 ∧ t.2.2 = t'.2.2 ∧ t.1.carrier = t'.1.carrier ∩ t.2.1.carrier

/-- AUX: not in paper. In a frame with `K_λ ≠ ∅`, `λ` is infinite (no maximal models). -/
theorem Frame.aleph0_le {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) {M : Model U L}
    (hM : M ∈ s.S.Kc lam) : ℵ₀ ≤ lam := by
  have hnm := hc.ax1c M hM
  unfold IsMaximal at hnm
  push Not at hnm
  obtain ⟨N, hN, hlt⟩ := hnm hM
  obtain ⟨a, ha, haM⟩ := hc.ax0a.exists_diff_of_lt ⟨hlt.1.2.2, hlt.2⟩
  exact aleph0_le_of_ssubset hM.2 hN.2 (hc.ax0a.sub hlt.1.2.2) ha haM

/-- AUX: not in paper. A basic type does not fork over its own domain (existence + monotonicity). -/
theorem Frame.notFork_self {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M : Model U L} (hM : M ∈ s.S.Kc lam) {p : Set (Tri U L)} (hp : p ∈ s.Sbs M) :
    s.NotFork lam M M p := by
  have hS := hc.ax0a
  have hnm := hc.ax1c M hM
  unfold IsMaximal at hnm
  push Not at hnm
  obtain ⟨N, hN, hlt⟩ := hnm hM
  have hle : s.S.le M N := hlt.1.2.2
  obtain ⟨q, -, hnq, hres⟩ := hc.ax3f M hM N hN p hp ⟨hle, hlt.2⟩
  obtain ⟨c, X, rfl, hnf⟩ := hnq
  have hnf' := Frame.nf_mono hS hc.ax3a hc.ax3b hnf (hS.refl hM.1) (hS.refl hM.1) hle
  refine ⟨c, X, ?_, hnf'⟩
  rw [← hres, res_tp hS hle]

/-- AUX: not in paper. "`tp(x, N, X)` does not fork over `M`" gives `⨿(M, N, x, X)` when
`X ∈ K_λ` (Prop 2.1.2). -/
theorem Frame.nf_of_notFork {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hc : s.Core lam) {M N X : Model U L} {x : U} (h : s.NotFork lam M N (tp s.S lam x N X))
    (hX : X ∈ s.S.Kc lam) : s.nf M N x X := by
  obtain ⟨c, Y, hEq, hnf⟩ := h
  exact prop_2_1_2 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b M N Y X c x hX hnf hEq

/-- AUX: not in paper. The invariant of the construction in the proof of Prop 3.1.8 up to stage
`α`, where `c β = (N*_β, f_β)` (notation of the paper's proof): `N*` increasing continuous in
`K_λ` starting at `N`; `f_β : M_β → N*_β` increasing embeddings with `f₀ = id_{M₀}`; (vi)
`tp(f_{β+1}(a_β), N*_β, N*_{β+1})` does not fork over `f_β[M_β]`; (vii) `tp(b, f_β[M_β], N*_β)`
does not fork over `M₀`. -/
def Frame.Inv318 (s : Frame U L) (lam : Cardinal.{u}) (M : Ordinal.{u} → Model U L)
    (N : Model U L) (a : Ordinal.{u} → U) (b : U) (α : Ordinal.{u})
    (c : Ordinal.{u} → Model U L × (U → U)) : Prop :=
  (∀ β ≤ α, (c β).1 ∈ s.S.Kc lam) ∧ (c 0).1 = N ∧ (∀ x ∈ (M 0).carrier, (c 0).2 x = x) ∧
  IsIncreasing s.S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
  (∀ β ≤ α, IsEmb s.S (c β).2 (M β) (c β).1) ∧ FunIncreasing (fun β => (c β).2) M (Iic α) ∧
  (∀ β, β + 1 ≤ α → ∃ P, IsoOn (c β).2 (M β) P ∧
    s.NotFork lam P (c β).1 (tp s.S lam ((c (β + 1)).2 (a β)) (c β).1 (c (β + 1)).1)) ∧
  (∀ β ≤ α, ∃ P, IsoOn (c β).2 (M β) P ∧ s.NotFork lam (M 0) P (tp s.S lam b P (c β).1))

/-- AUX: not in paper. `Inv318 α c` depends only on `c ↾ [0, α]`. -/
theorem Frame.inv318_loc {s : Frame U L} {lam : Cardinal.{u}} {M : Ordinal.{u} → Model U L}
    {N : Model U L} {a : Ordinal.{u} → U} {b : U} (α : Ordinal.{u})
    (c c' : Ordinal.{u} → Model U L × (U → U)) (h : ∀ β ≤ α, c β = c' β)
    (hi : s.Inv318 lam M N a b α c) : s.Inv318 lam M N a b α c' := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hi
  have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
  have e0 : c' 0 = c 0 := e 0 zero_le
  refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2,
    fun x hx => by rw [e0]; exact h3 x hx, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_,
    fun β hβ => by rw [e β hβ]; exact h6 β hβ, fun β hβ γ hγ hl x hx => ?_,
    fun β hβ => ?_, fun β hβ => by rw [e β hβ]; exact h9 β hβ⟩
  · simp only [e β hβ, e γ hγ]; exact h4 β hβ γ hγ hl
  · simp only [e γ hγ]
    rw [h5 γ hγ hl]
    exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγ)]
  · simp only [e β hβ, e γ hγ]; exact h7 β hβ γ hγ hl x hx
  · have hβ' : β ≤ α := (Order.lt_add_one_iff.2 le_rfl).le.trans hβ
    rw [e β hβ', e (β + 1) hβ]; exact h8 β hβ

/-- AUX: not in paper. The construction in the proof of Prop 3.1.8 (with the cited Prop 2.5.7 at
successor steps and the continuity axiom at limit steps). -/
theorem Frame.construction_318 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam) {θ : Ordinal.{u}} {M : Ordinal.{u} → Model U L}
    (hMinc : IsIncreasing s.S.le M (Iic θ)) (hMcont : IsContinuous M (Iic θ))
    (hMK : ∀ α ∈ Iic θ, M α ∈ s.S.Kc lam) {N : Model U L} (hN : N ∈ s.S.Kc lam)
    (hMN : s.S.le (M 0) N) {a : Ordinal.{u} → U}
    (ha : ∀ α < θ, a α ∈ (M (α + 1)).carrier \ (M α).carrier ∧
      (M α, M (α + 1), a α) ∈ s.K3bs lam)
    {b : U} (hbs : (M 0, N, b) ∈ s.K3bs lam) (hθ : θ.card ≤ lam) :
    ∃ c, s.Inv318 lam M N a b θ c := by
  classical
  obtain ⟨hc, hcont3, hsym⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hM0 : M 0 ∈ s.S.Kc lam := hMK 0 (Set.mem_Iic.2 zero_le)
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM0
  have hMle : ∀ β ≤ θ, ∀ γ ≤ θ, β ≤ γ → s.S.le (M β) (M γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hMinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hMK γ hγ).1
  have : Nonempty (Model U L × (U → U)) := ⟨(N, id)⟩
  suffices H : ∃ c, ∀ α ≤ θ, s.Inv318 lam M N a b α c by
    obtain ⟨c, hc'⟩ := H; exact ⟨c, hc' θ le_rfl⟩
  refine transfinite_construction θ (s.Inv318 lam M N a b) (fun α c c' h hi =>
    Frame.inv318_loc α c c' h hi) ?_
  intro α hα c hprev
  rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨γ, hγ⟩ | hlim
  · -- stage 0
    subst h0
    refine ⟨(N, id), ?_⟩
    have hz : ∀ β ≤ (0 : Ordinal.{u}), β = 0 := fun β hβ => le_antisymm hβ zero_le
    have hfalse : ∀ β : Ordinal.{u}, ¬ β < 0 := fun β => not_lt.2 zero_le
    have hc0 : (fun β => if β < (0 : Ordinal.{u}) then c β else (N, id)) = fun _ => (N, id) :=
      funext fun β => if_neg (hfalse β)
    rw [hc0]
    refine ⟨fun β _ => hN, rfl, fun x _ => rfl, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_,
      fun β hβ => ?_, fun β hβ γ hγ hl => ?_, fun β hβ => ?_, fun β hβ => ?_⟩
    · exact absurd (hz γ hγ ▸ hl) (hfalse β)
    · exact absurd (hz γ hγ ▸ hl) Order.not_isSuccLimit_bot
    · rw [hz β hβ]; exact IsEmb.of_le hS hMN
    · exact absurd (hz γ hγ ▸ hl) (hfalse β)
    · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hβ) (hfalse β)
    · rw [hz β hβ]
      exact ⟨M 0, IsoOn.refl _, Frame.notFork_self hc hM0 hbs.2.2.2⟩
  · -- successor stage `α = γ + 1`
    rw [Order.succ_eq_add_one] at hγ
    subst hγ
    have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
    have hγθ : γ < θ := lt_of_lt_of_le hγ1 hα
    obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8, p9⟩ := hprev γ hγ1
    set Nγ := (c γ).1 with hNγdef
    set fγ := (c γ).2 with hfγdef
    have hMγ : M γ ∈ s.S.Kc lam := hMK γ (Set.mem_Iic.2 hγθ.le)
    have hMγ1 : M (γ + 1) ∈ s.S.Kc lam := hMK (γ + 1) (Set.mem_Iic.2 hα)
    have hleγ : s.S.le (M γ) (M (γ + 1)) :=
      hMinc γ (Set.mem_Iic.2 hγθ.le) (γ + 1) (Set.mem_Iic.2 hα) hγ1
    have hNγ : Nγ ∈ s.S.Kc lam := p1 γ le_rfl
    obtain ⟨P, hPiso, hPnf⟩ := p9 γ le_rfl
    obtain ⟨cb, Xb, hEqb, -, -, hPK, -, hcb, h0P, -, -, hbsP⟩ := hPnf.facts hc.ax3a
    have hb₂ : tp s.S lam b P Nγ ∈ s.Sbs P := by rw [hEqb]; exact hbsP
    have hbP : b ∉ P.carrier := fun h => hcb.2 (by
      have e : cb = b := (ERel.alg (tp_eq_iff.1 hEqb)).1 h
      rw [e]; exact h)
    have hPNγ : s.S.le P Nγ := by
      obtain ⟨-, -, P', hP'le, hP'iso⟩ := p6 γ le_rfl
      rwa [hPiso.unique hP'iso]
    have hbNγ : b ∈ Nγ.carrier := by
      have hbN : b ∈ N.carrier := hbs.2.2.1.1
      rw [← p2] at hbN
      rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with h | h
      · exact hS.sub (p4 0 (Set.mem_Iic.2 zero_le) γ (Set.mem_Iic.2 le_rfl) h) hbN
      · have e : Nγ = (c 0).1 := by rw [hNγdef, ← h]
        rw [e]; exact hbN
    -- a copy `Q` of `M_{γ+1}` extending `f_γ`
    obtain ⟨g, Q, hgQ, hgfγ, hPQ, hQK, -⟩ := hS.rename hU.infinite ∅ hleγ hPiso
      (by rw [Set.empty_union]; change P.card < #U; rw [hPK.2]; exact hU.2)
    have hQc : Q ∈ s.S.Kc lam := ⟨hQK, by rw [hgQ.card_eq]; exact hMγ1.2⟩
    have hgP : IsoOn g (M γ) P := hPiso.congr fun y hy => (hgfγ y hy).symm
    have haγ := ha γ hγθ
    have hb₁ : tp s.S lam (g (a γ)) P Q ∈ s.Sbs P :=
      hc.ax2b (M γ) (M (γ + 1)) Q P (a γ) g hMγ haγ.2.2.2.2 hgQ hgP
    have ha₁ : g (a γ) ∈ Q.carrier \ P.carrier := by
      refine ⟨hgQ.mapsTo haγ.1.1, fun h => ?_⟩
      rw [hgP.carrier_eq] at h
      obtain ⟨y, hy, hgy⟩ := h
      have e : y = a γ := hgQ.injOn (hS.sub hleγ hy) haγ.1.1 hgy
      exact haγ.1.2 (e ▸ hy)
    -- the cited two-sided independent amalgamation
    obtain ⟨f₁, f₂, M₃, M₁', M₂', ⟨⟨hf₁, hf₂, ho₁, ho₂⟩, hM₃⟩, hf₁iso, hf₂iso, hnfA, hnfB⟩ :=
      C.prop_2_5_7 lam hU s ⟨hc, hcont3, hsym⟩ P Q Nγ hPK hQc hNγ hPQ hPNγ (g (a γ)) b ha₁
        ⟨hbNγ, hbP⟩ hb₁ hb₂
    have hM₂'M₃ : s.S.le M₂' M₃ := by
      obtain ⟨-, -, R, hR, hRiso⟩ := hf₂; rwa [hf₂iso.unique hRiso]
    have hM₁'M₃ : s.S.le M₁' M₃ := by
      obtain ⟨-, -, R, hR, hRiso⟩ := hf₁; rwa [hf₁iso.unique hRiso]
    obtain ⟨k, hk, hkf, -⟩ := hf₂iso.exists_inv
    obtain ⟨r, M₃', hr, hrk, hNγM₃', hM₃'K, -⟩ := hS.rename hU.infinite ∅ hM₂'M₃ hk
      (by rw [Set.empty_union]; change Nγ.card < #U; rw [hNγ.2]; exact hU.2)
    have hM₃'c : M₃' ∈ s.S.Kc lam := ⟨hM₃'K, by rw [hr.card_eq]; exact hM₃.2⟩
    have hrP : ∀ x ∈ P.carrier, r x = x := fun x hx => by
      have h1 : f₂ x = x := ho₂.2 x hx
      have hxN : x ∈ Nγ.carrier := hS.sub hPNγ hx
      have hx2 : f₂ x ∈ M₂'.carrier := hf₂iso.mapsTo hxN
      rw [h1] at hx2
      rw [hrk x hx2]
      conv_lhs => rw [← h1]
      exact hkf x hxN
    have hrfg : ∀ y ∈ (M γ).carrier, r (f₁ (g y)) = fγ y := fun y hy => by
      have hyP : fγ y ∈ P.carrier := hPiso.mapsTo hy
      rw [hgfγ y hy, ho₁.2 _ hyP, hrP _ hyP]
    have hrPP : IsoOn r P P := (IsoOn.refl P).congr fun x hx => (hrP x hx).symm
    have hrM₂' : IsoOn r M₂' Nγ := hk.congr fun x hx => (hrk x hx).symm
    -- (vi) at `γ`
    have hvi : s.nf P Nγ (r (f₁ (g (a γ)))) M₃' :=
      hc.ax3a.2 P M₂' M₃ P Nγ M₃' _ r (Frame.nf_of_notFork hU hc hnfA hM₃) hr hrPP hrM₂'
    -- (vii) at `γ + 1`
    obtain ⟨P', hP'⟩ := exists_isoOn (hr.injOn.mono (hS.sub hM₁'M₃))
    have hrb : r (f₂ b) = b := by
      rw [hrk _ (hf₂iso.mapsTo hbNγ), hkf b hbNγ]
    have hnfB' : s.nf P P' b M₃' := by
      have := hc.ax3a.2 P M₁' M₃ P P' M₃' _ r (Frame.nf_of_notFork hU hc hnfB hM₃) hr hrPP hP'
      rwa [hrb] at this
    have h3B := hc.ax3a.1 _ _ _ _ hnfB'
    have hvii : s.NotFork lam (M 0) P' (tp s.S lam b P' M₃') := by
      refine Frame.notFork_trans hc hM0 h3B.2.1 h0P h3B.2.2.2.2.1 h3B.2.2.2.2.2.2.2
        ⟨b, M₃', rfl, hnfB'⟩ ?_
      rw [res_tp hS h3B.2.2.2.2.1,
        ← tp_eq_of_le hS ⟨hPK.1, hM₃'K, hS.trans hPNγ hNγM₃', hS.sub hNγM₃' hbNγ⟩ hNγM₃' hPNγ
          hbNγ]
      exact hPnf
    have hfiso : IsoOn (r ∘ f₁ ∘ g) (M (γ + 1)) P' := (hgQ.comp hf₁iso).comp hP'
    have hemb : IsEmb s.S (r ∘ f₁ ∘ g) (M (γ + 1)) M₃' :=
      ⟨hMγ1.1, hM₃'K, P', hS.iso_le hM₁'M₃ hr hP', hfiso⟩
    -- the new stage
    refine ⟨(M₃', r ∘ f₁ ∘ g), ?_⟩
    set c' : Ordinal.{u} → Model U L × (U → U) :=
      fun β => if β < γ + 1 then c β else (M₃', r ∘ f₁ ∘ g) with hc'def
    have hcl : ∀ β ≤ γ, c' β = c β := fun β hβ => if_pos (Order.lt_add_one_iff.2 hβ)
    have hcx : c' (γ + 1) = (M₃', r ∘ f₁ ∘ g) := if_neg (lt_irrefl _)
    have hcases : ∀ β ≤ γ + 1, β ≤ γ ∨ β = γ + 1 := fun β hβ => by
      rcases hβ.lt_or_eq with h | h
      · exact Or.inl (Order.lt_add_one_iff.1 h)
      · exact Or.inr h
    have hNle : ∀ β ≤ γ, s.S.le (c β).1 Nγ := fun β hβ => by
      rcases hβ.lt_or_eq with h | h
      · exact p4 β (Set.mem_Iic.2 hβ) γ (Set.mem_Iic.2 le_rfl) h
      · rw [h]; exact hS.refl hNγ.1
    have hfeq : ∀ β ≤ γ, ∀ y ∈ (M β).carrier, (c β).2 y = fγ y := fun β hβ y hy => by
      rcases hβ.lt_or_eq with h | h
      · exact (p7 β (Set.mem_Iic.2 hβ) γ (Set.mem_Iic.2 le_rfl) h y hy).symm
      · rw [h]
    refine ⟨fun β hβ => ?_, by rw [hcl 0 zero_le]; exact p2,
      fun x hx => by rw [hcl 0 zero_le]; exact p3 x hx, fun β hβ β' hβ' hl => ?_,
      fun β' hβ' hl => ?_, fun β hβ => ?_, fun β hβ β' hβ' hl y hy => ?_, fun β hβ => ?_,
      fun β hβ => ?_⟩
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact p1 β h
      · rw [h, hcx]; exact hM₃'c
    · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hβ')
      show s.S.le (c' β).1 (c' β').1
      rw [hcl β hβγ]
      rcases hcases β' hβ' with h | h
      · rw [hcl β' h]; exact p4 β (Set.mem_Iic.2 hβγ) β' (Set.mem_Iic.2 h) hl
      · rw [h, hcx]; exact hS.trans (hNle β hβγ) hNγM₃'
    · have hβγ : β' ≤ γ := by
        rcases hcases β' hβ' with h | h
        · exact h
        · rw [h, ← Order.succ_eq_add_one] at hl
          exact absurd hl.isMax (not_isMax γ)
      show (c' β').1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).1.carrier
      rw [hcl β' hβγ, p5 β' (Set.mem_Iic.2 hβγ) hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hβγ)]
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact p6 β h
      · rw [h, hcx]; exact hemb
    · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hβ')
      show (c' β').2 y = (c' β).2 y
      rw [hcl β hβγ]
      rcases hcases β' hβ' with h | h
      · rw [hcl β' h]; exact p7 β (Set.mem_Iic.2 hβγ) β' (Set.mem_Iic.2 h) hl y hy
      · rw [h, hcx]
        have hyγ : y ∈ (M γ).carrier := by
          rcases hβγ.lt_or_eq with h' | h'
          · exact hS.sub (hMinc β (Set.mem_Iic.2 (hβγ.trans hγθ.le)) γ
              (Set.mem_Iic.2 hγθ.le) h') hy
          · rw [← h']; exact hy
        show r (f₁ (g y)) = (c β).2 y
        rw [hrfg y hyγ, hfeq β hβγ y hy]
    · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hβ)
      rcases hβγ.lt_or_eq with h | h
      · have hb1 : β + 1 ≤ γ := Order.add_one_le_iff.2 h
        rw [hcl β hβγ, hcl (β + 1) hb1]; exact p8 β hb1
      · subst h
        rw [hcl β le_rfl, hcx]
        exact ⟨P, hPiso, ⟨_, M₃', rfl, hvi⟩⟩
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact p9 β h
      · rw [h, hcx]; exact ⟨P', hfiso, hvii⟩
  · -- limit stage
    have h0α : (0 : Ordinal.{u}) < α := by simpa using hlim.bot_lt
    have hαcard : α.card ≤ lam := (Ordinal.card_le_card hα).trans hθ
    -- facts about `c` below `α`
    have hK : ∀ β < α, (c β).1 ∈ s.S.Kc lam := fun β hβ => (hprev β hβ).1 β le_rfl
    have hinc : ∀ β < α, ∀ β' < α, β < β' → s.S.le (c β).1 (c β').1 := fun β hβ β' hβ' h =>
      (hprev β' hβ').2.2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h
    have hfi : ∀ β < α, ∀ β' < α, β < β' → ∀ y ∈ (M β).carrier, (c β').2 y = (c β).2 y :=
      fun β hβ β' hβ' h y hy =>
        (hprev β' hβ').2.2.2.2.2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h y hy
    have hcoh : ∀ β < α, ∀ β' < α, ∀ y ∈ (M β).carrier, y ∈ (M β').carrier →
        (c β).2 y = (c β').2 y := fun β hβ β' hβ' y hy hy' => by
      rcases lt_trichotomy β β' with h | h | h
      · exact (hfi β hβ β' hβ' h y hy).symm
      · rw [h]
      · exact hfi β' hβ' β hβ h y hy'
    -- the union `N*_α`
    obtain ⟨Nα, hNαU, -, -⟩ := hS.union α hlim (fun β => (c β).1)
      (fun β hβ β' hβ' h => hinc β hβ β' hβ' h)
      (fun β hβ hβl => (hprev β hβ).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl)
    obtain ⟨hNαK, hleNα⟩ := hS.le_union hlim (fun β hβ β' hβ' h => hinc β hβ β' hβ' h)
      (fun β hβ hβl => (hprev β hβ).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl) hNαU
    have hNαc : Nα ∈ s.S.Kc lam := by
      refine ⟨hNαK, le_antisymm ?_ ?_⟩
      · change #Nα.carrier ≤ lam
        rw [hNαU.1]
        exact card_biUnion_le hinf hαcard fun β hβ => le_of_eq (hK β hβ).2
      · rw [← (hK 0 h0α).2]; exact Model.card_le_of_sub (hS.sub (hleNα 0 h0α))
    -- the union `f_α`
    let fα : U → U := fun x => if h : ∃ β < α, x ∈ (M β).carrier then (c h.choose).2 x else x
    have hfα : ∀ β < α, ∀ y ∈ (M β).carrier, fα y = (c β).2 y := fun β hβ y hy => by
      have h : ∃ β < α, y ∈ (M β).carrier := ⟨β, hβ, hy⟩
      simp only [fα, h, dite_true]
      exact hcoh _ h.choose_spec.1 β hβ y h.choose_spec.2 hy
    refine ⟨(Nα, fα), ?_⟩
    set c' : Ordinal.{u} → Model U L × (U → U) :=
      fun β => if β < α then c β else (Nα, fα) with hc'def
    have hcl : ∀ β < α, c' β = c β := fun β hβ => if_pos hβ
    have hcx : c' α = (Nα, fα) := if_neg (lt_irrefl _)
    have hcases : ∀ β ≤ α, β < α ∨ β = α := fun β hβ => hβ.lt_or_eq
    have hMinc' : IsIncreasing s.S.le M (Iic α) := fun β hβ β' hβ' h =>
      hMinc β (Set.mem_Iic.2 ((show β ≤ α from hβ).trans hα)) β'
        (Set.mem_Iic.2 ((show β' ≤ α from hβ').trans hα)) h
    have hMcont' : IsContinuous M (Iic α) := fun β hβ hβl =>
      hMcont β (Set.mem_Iic.2 ((show β ≤ α from hβ).trans hα)) hβl
    have c4 : IsIncreasing s.S.le (fun β => (c' β).1) (Iic α) := by
      intro β hβ β' hβ' h
      have hβα : β < α := lt_of_lt_of_le h hβ'
      show s.S.le (c' β).1 (c' β').1
      rw [hcl β hβα]
      rcases hcases β' hβ' with h' | h'
      · rw [hcl β' h']; exact hinc β hβα β' h' h
      · rw [h', hcx]; exact hleNα β hβα
    have c7 : FunIncreasing (fun β => (c' β).2) M (Iic α) := by
      intro β hβ β' hβ' h y hy
      have hβα : β < α := lt_of_lt_of_le h hβ'
      show (c' β').2 y = (c' β).2 y
      rw [hcl β hβα]
      rcases hcases β' hβ' with h' | h'
      · rw [hcl β' h']; exact hfi β hβα β' h' h y hy
      · rw [h', hcx]; exact hfα β hβα y hy
    have c6 : ∀ β ≤ α, IsEmb s.S (c' β).2 (M β) (c' β).1 := by
      have hlt : ∀ β < α, IsEmb s.S (c' β).2 (M β) (c' β).1 := fun β hβ => by
        rw [hcl β hβ]; exact (hprev β hβ).2.2.2.2.2.1 β le_rfl
      intro β hβ
      rcases hcases β hβ with h | h
      · exact hlt β h
      · rw [h]
        exact hS.emb_limit (f := fun β => (c' β).2) (N := fun β => (c' β).1) hlim hMinc'
          hMcont' c4 hlt c7
    obtain ⟨P, hP, hPinc, hPcont⟩ := hS.image_chain (f := fun β => (c' β).2)
      (N := fun β => (c' β).1) hMinc' hMcont' c4 c6 c7
    refine ⟨fun β hβ => ?_, by rw [hcl 0 h0α]; exact (hprev 0 h0α).2.1,
      fun x hx => by rw [hcl 0 h0α]; exact (hprev 0 h0α).2.2.1 x hx, c4, fun β hβ hβl => ?_,
      c6, c7, fun β hβ => ?_, fun β hβ => ?_⟩
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact hK β h
      · rw [h, hcx]; exact hNαc
    · show (c' β).1.carrier = ⋃ ξ ∈ Iio β, (c' ξ).1.carrier
      rcases hcases β hβ with h | h
      · rw [hcl β h, (hprev β h).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
      · rw [h, hcx, hNαU.1]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
    · have hb1 : β + 1 < α := lt_of_le_of_ne hβ fun h => by
        rw [h.symm, ← Order.succ_eq_add_one] at hlim
        exact absurd hlim.isMax (not_isMax β)
      have hb : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
      rw [hcl β hb, hcl (β + 1) hb1]
      exact (hprev (β + 1) hb1).2.2.2.2.2.2.2.1 β le_rfl
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact (hprev β h).2.2.2.2.2.2.2.2 β le_rfl
      · subst h
        rw [hcx]
        have hPα := hP β le_rfl
        rw [hcx] at hPα
        -- `P 0 = M 0`
        have hP0 : P 0 = M 0 := by
          have h1 := (hP 0 zero_le).1
          rw [hcl 0 h0α] at h1
          exact (Model.eq_of_isoOn_id (h1.congr fun x hx => (hprev 0 h0α).2.2.1 x hx)).symm
        have hPK : ∀ γ ∈ Iic β, P γ ∈ s.S.Kc lam := fun γ hγ =>
          ⟨hS.mem_left (hP γ hγ).2, by rw [(hP γ hγ).1.card_eq]; exact (hMK γ
            (Set.mem_Iic.2 ((show γ ≤ β from hγ).trans hα))).2⟩
        have hbNα : b ∈ Nα.carrier := by
          have hbN : b ∈ N.carrier := hbs.2.2.1.1
          rw [← (hprev 0 h0α).2.1] at hbN
          exact hS.sub (hleNα 0 h0α) hbN
        have hβlt : β < (Order.succ lam).ord :=
          Cardinal.lt_ord.2 (lt_of_le_of_lt hαcard (Order.lt_succ lam))
        have hK3 : (P β, Nα, b) ∈ s.S.K3 := ⟨(hPK β (Set.mem_Iic.2 le_rfl)).1, hNαK, hPα.2, hbNα⟩
        have := hcont3 β hlim hβlt P ⟨hPinc, hPcont, hPK⟩ (tp s.S lam b (P β) Nα)
          ⟨Nα, b, hK3, rfl⟩ (fun γ hγ => by
            have hPγβ : s.S.le (P γ) (P β) :=
              hPinc γ (Set.mem_Iic.2 hγ.le) β (Set.mem_Iic.2 le_rfl) hγ
            have hPγ := hP γ hγ.le
            rw [hcl γ hγ] at hPγ
            rw [res_tp hS hPγβ, hP0,
              ← tp_eq_of_le hS ⟨(hPK γ hγ.le).1, hNαK, hS.trans hPγβ hPα.2,
                hbNα⟩ (hleNα γ hγ) hPγ.2 (by
                  have hbN : b ∈ N.carrier := hbs.2.2.1.1
                  rw [← (hprev 0 h0α).2.1] at hbN
                  rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with h | h
                  · exact hS.sub (hinc 0 h0α γ hγ h) hbN
                  · rw [← h]; exact hbN)]
            obtain ⟨Q, hQ, hQnf⟩ := (hprev γ hγ).2.2.2.2.2.2.2.2 γ le_rfl
            rwa [hQ.unique hPγ.1] at hQnf)
        rw [hP0] at this
        exact ⟨P β, hPα.1, this.2⟩

/-- AUX: not in paper. Prop 3.1.8 with the additional conclusion `N_α ∈ K_λ` (`α ≤ θ`), which
its proof gives (used in Thm 5.3.7: `NF*` requires its models to be in `K_λ`). -/
theorem Frame.prop_3_1_8_strong [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (θ : Ordinal.{u}) (M : Ordinal.{u} → Model U L) (hM : IsIncCont s.S M (Iic θ) (s.S.Kc lam))
    (N : Model U L) (hN : N ∈ s.S.Kc lam) (hMN : s.S.lt (M 0) N) (a : Ordinal.{u} → U)
    (ha : ∀ α < θ, a α ∈ (M (α + 1)).carrier \ (M α).carrier ∧
      (M α, M (α + 1), a α) ∈ s.K3bs lam)
    (b : U) (hb : b ∈ N.carrier \ (M 0).carrier) (hbs : (M 0, N, b) ∈ s.K3bs lam) :
    ∃ (f : U → U) (Ns : Ordinal.{u} → Model U L), (∀ α ≤ θ, Ns α ∈ s.S.Kc lam) ∧
      IsoOn f N (Ns 0) ∧ Over f N (Ns 0) (M 0).carrier ∧
      IsIncreasing s.S.le Ns (Iic θ) ∧ IsContinuous Ns (Iic θ) ∧
      (∀ α ≤ θ, s.S.le (M α) (Ns α)) ∧
      (∀ α < θ, s.NotFork lam (M α) (Ns α) (tp s.S lam (a α) (Ns α) (Ns (α + 1)))) ∧
      ∀ α ≤ θ, s.NotFork lam (M 0) (M α) (tp s.S lam (f b) (M α) (Ns α)) := by
  classical
  obtain ⟨hc, hcont3, hsym⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hMinc, hMcont, hMK⟩ := hM
  have hsubθ : ∀ γ ≤ θ, (M γ).carrier ⊆ (M θ).carrier := fun γ hγ => by
    rcases hγ.lt_or_eq with h | h
    · exact hS.sub (hMinc γ (Set.mem_Iic.2 hγ) θ (Set.mem_Iic.2 le_rfl) h)
    · rw [h]
  -- `θ` has cardinality `≤ λ`: the `a_α` are pairwise distinct elements of `M_θ`
  have hθ : θ.card ≤ lam := by
    have hmem : ∀ x : Iio θ, a x.1 ∈ (M θ).carrier := fun x =>
      hsubθ (x.1 + 1) (Order.add_one_le_iff.2 x.2) (ha x.1 x.2).1.1
    let g : Iio θ → (M θ).carrier := fun x => ⟨a x.1, hmem x⟩
    have hg : Function.Injective g := by
      have key : ∀ x y : Iio θ, x.1 < y.1 → a x.1 ≠ a y.1 := fun x y hxy e => by
        have h1 : a x.1 ∈ (M y.1).carrier := by
          have := (ha x.1 x.2).1.1
          rcases (Order.add_one_le_iff.2 hxy).lt_or_eq with h | h
          · exact hS.sub (hMinc (x.1 + 1) (Set.mem_Iic.2 (Order.add_one_le_iff.2 x.2)) y.1
              (Set.mem_Iic.2 y.2.le) h) this
          · rw [← h]; exact this
        exact (ha y.1 y.2).1.2 (e ▸ h1)
      intro x y hxy
      have e : a x.1 = a y.1 := congrArg Subtype.val hxy
      rcases lt_trichotomy x.1 y.1 with h | h | h
      · exact absurd e (key x y h)
      · exact Subtype.ext h
      · exact absurd e.symm (key y x h)
    have h1 := Cardinal.lift_mk_le_lift_mk_of_injective hg
    rw [Cardinal.mk_Iio_ordinal, Cardinal.lift_lift] at h1
    have h2 : θ.card ≤ #(M θ).carrier := Cardinal.lift_le.1 h1
    exact h2.trans (le_of_eq (hMK θ (Set.mem_Iic.2 le_rfl)).2)
  obtain ⟨c, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := Frame.construction_318 hU ⟨hc, hcont3, hsym⟩
    hMinc hMcont hMK hN hMN.1 ha hbs hθ
  -- rename `N*_θ` along `f_θ⁻¹`
  obtain ⟨-, -, Pθ, hPθle, hPθiso⟩ := h6 θ le_rfl
  obtain ⟨k, hk, hkf, -⟩ := hPθiso.exists_inv
  obtain ⟨g, Nθ', hg, hgk, -, -, -⟩ := hS.rename hU.infinite ∅ hPθle hk
    (by rw [Set.empty_union]; change (M θ).card < #U
        rw [(hMK θ (Set.mem_Iic.2 le_rfl)).2]; exact hU.2)
  have hsubN : ∀ β ≤ θ, (c β).1.carrier ⊆ (c θ).1.carrier := fun β hβ => by
    rcases hβ.lt_or_eq with h | h
    · exact hS.sub (h4 β (Set.mem_Iic.2 hβ) θ (Set.mem_Iic.2 le_rfl) h)
    · rw [h]
  have hfθ : ∀ β ≤ θ, ∀ y ∈ (M β).carrier, (c β).2 y = (c θ).2 y := fun β hβ y hy => by
    rcases hβ.lt_or_eq with h | h
    · exact (h7 β (Set.mem_Iic.2 hβ) θ (Set.mem_Iic.2 le_rfl) h y hy).symm
    · rw [h]
  have hgf : ∀ β ≤ θ, ∀ y ∈ (M β).carrier, g ((c β).2 y) = y := fun β hβ y hy => by
    have hyθ := hsubθ β hβ hy
    rw [hfθ β hβ y hy, hgk _ (hPθiso.mapsTo hyθ), hkf y hyθ]
  have hgimg : ∀ β ≤ θ, ∀ P, IsoOn (c β).2 (M β) P → IsoOn g P (M β) := fun β hβ P hP => by
    obtain ⟨k', hk', hk'f, -⟩ := hP.exists_inv
    refine hk'.congr fun z hz => ?_
    rw [hP.carrier_eq] at hz
    obtain ⟨y, hy, rfl⟩ := hz
    rw [hk'f y hy, hgf β hβ y hy]
  have hgM0 : ∀ x ∈ (M 0).carrier, g x = x := fun x hx => by
    have := hgf 0 zero_le x hx; rwa [h3 x hx] at this
  have hNs : ∀ β ≤ θ, ∃ Q, IsoOn g (c β).1 Q := fun β hβ =>
    exists_isoOn (hg.injOn.mono (hsubN β hβ))
  let Ns : Ordinal.{u} → Model U L := fun β =>
    if h : β ≤ θ then (hNs β h).choose else (c β).1
  have hNsiso : ∀ β ≤ θ, IsoOn g (c β).1 (Ns β) := fun β hβ => by
    simp only [Ns, hβ, dite_true]; exact (hNs β hβ).choose_spec
  have hKc : ∀ β ≤ θ, (c β).1 ∈ s.S.Kc lam := h1
  have hnfT : ∀ {A B X : Model U L} {x : U} {A' B' X' : Model U L}, s.nf A B x X →
      IsoOn g X X' → IsoOn g A A' → IsoOn g B B' → s.nf A' B' (g x) X' :=
    fun hnf hX hA hB => hc.ax3a.2 _ _ _ _ _ _ _ g hnf hX hA hB
  have hM0iso : IsoOn g (M 0) (M 0) := (IsoOn.refl _).congr fun x hx => (hgM0 x hx).symm
  refine ⟨g, Ns, fun β hβ => ⟨hS.iso_mem (hKc β hβ).1 (hNsiso β hβ),
    by rw [(hNsiso β hβ).card_eq]; exact (hKc β hβ).2⟩, ?_, ⟨fun x hx => ⟨?_, ?_⟩, hgM0⟩, fun β hβ β' hβ' h => ?_,
    fun β' hβ' hl => ?_, fun β hβ => ?_, fun β hβ => ?_, fun β hβ => ?_⟩
  · have := hNsiso 0 zero_le; rwa [h2] at this
  · exact hS.sub hMN.1 hx
  · rw [← hgM0 x hx]
    have := (hNsiso 0 zero_le).mapsTo (show x ∈ (c 0).1.carrier by rw [h2]; exact hS.sub hMN.1 hx)
    exact this
  · exact hS.iso_le (h4 β hβ β' hβ' h) (hNsiso β' hβ') (hNsiso β (le_trans h.le hβ'))
  · have hβ'θ : β' ≤ θ := hβ'
    rw [(hNsiso β' hβ'θ).carrier_eq, h5 β' hβ' hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ξ hξ =>
      ((hNsiso ξ ((le_of_lt hξ).trans hβ'θ)).carrier_eq).symm
  · obtain ⟨-, -, P, hP, hPiso⟩ := h6 β hβ
    exact hS.iso_le hP (hNsiso β hβ) (hgimg β hβ P hPiso)
  · have hβθ : β ≤ θ := (Order.lt_add_one_iff.2 le_rfl).le.trans (Order.add_one_le_iff.2 hβ)
    have hb1 : β + 1 ≤ θ := Order.add_one_le_iff.2 hβ
    obtain ⟨P, hPiso, hnf⟩ := h8 β hb1
    have hnf' := hnfT (Frame.nf_of_notFork hU hc hnf (hKc (β + 1) hb1)) (hNsiso (β + 1) hb1)
      (hgimg β hβθ P hPiso) (hNsiso β hβθ)
    rw [hgf (β + 1) hb1 (a β) (ha β hβ).1.1] at hnf'
    exact ⟨a β, Ns (β + 1), rfl, hnf'⟩
  · obtain ⟨P, hPiso, hnf⟩ := h9 β hβ
    have hnf' := hnfT (Frame.nf_of_notFork hU hc hnf (hKc β hβ)) (hNsiso β hβ) hM0iso
      (hgimg β hβ P hPiso)
    exact ⟨g b, Ns β, rfl, hnf'⟩

/-- Prop 3.1.8: let `⟨M_α : α ≤ θ⟩` be increasing continuous in `K_λ`, `N ∈ K_λ` with `M₀ ≺ N`,
`a_α ∈ M_{α+1} - M_α` with `(M_α, M_{α+1}, a_α) ∈ K^{3,bs}` (`α < θ`), and `b ∈ N - M₀` with
`(M₀, N, b) ∈ K^{3,bs}`. Then there are `f, ⟨N_α : α ≤ θ⟩` with (1) `f : N → N₀` an isomorphism
over `M₀`, (2) `⟨N_α⟩` increasing continuous, (3) `M_α ≼ N_α`, (4) `tp(a_α, N_α, N_{α+1})` does
not fork over `M_α`, (5) `tp(f(b), M_α, N_α)` does not fork over `M₀`. -/
theorem prop_3_1_8 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (θ : Ordinal.{u}) (M : Ordinal.{u} → Model U L) (hM : IsIncCont s.S M (Iic θ) (s.S.Kc lam))
    (N : Model U L) (hN : N ∈ s.S.Kc lam) (hMN : s.S.lt (M 0) N) (a : Ordinal.{u} → U)
    (ha : ∀ α < θ, a α ∈ (M (α + 1)).carrier \ (M α).carrier ∧
      (M α, M (α + 1), a α) ∈ s.K3bs lam)
    (b : U) (hb : b ∈ N.carrier \ (M 0).carrier) (hbs : (M 0, N, b) ∈ s.K3bs lam) :
    ∃ (f : U → U) (Ns : Ordinal.{u} → Model U L),
      IsoOn f N (Ns 0) ∧ Over f N (Ns 0) (M 0).carrier ∧
      IsIncreasing s.S.le Ns (Iic θ) ∧ IsContinuous Ns (Iic θ) ∧
      (∀ α ≤ θ, s.S.le (M α) (Ns α)) ∧
      (∀ α < θ, s.NotFork lam (M α) (Ns α) (tp s.S lam (a α) (Ns α) (Ns (α + 1)))) ∧
      ∀ α ≤ θ, s.NotFork lam (M 0) (M α) (tp s.S lam (f b) (M α) (Ns α)) := by
  obtain ⟨f, Ns, -, h⟩ := Frame.prop_3_1_8_strong lam hU s hs θ M hM N hN hMN a ha b hb hbs
  exact ⟨f, Ns, h⟩


/-! ## 3.2 Decomposition -/

/-- Def 3.2.1 (precondition): `K^{3,*}` is closed under isomorphisms. -/
def IsoClosedTri (T : Set (Tri U L)) : Prop :=
  ∀ t ∈ T, ∀ (f : U → U) (M' N' : Model U L), IsoOn f t.2.1 N' → IsoOn f t.1 M' →
    (M', N', f t.2.2) ∈ T

/-- Def 3.2.1(1): `K^{3,*}` is dense with respect to `≼_bs`. -/
def Frame.Dense (s : Frame U L) (lam : Cardinal.{u}) (T : Set (Tri U L)) : Prop :=
  ∀ t ∈ s.K3bs lam, ∃ t' ∈ T, s.leBs lam t t'

/-- Def 3.2.1(2): `K^{3,*}` satisfies the existence property: for every `(M, N, a) ∈ K^{3,bs}`
there are `N*, a*` with `tp(a*, M, N*) = tp(a, M, N)` and `(M, N*, a*) ∈ K^{3,*}`. -/
def Frame.ExistProp (s : Frame U L) (lam : Cardinal.{u}) (T : Set (Tri U L)) : Prop :=
  ∀ t ∈ s.K3bs lam, ∃ (N' : Model U L) (a' : U),
    tp s.S lam a' t.1 N' = tp s.S lam t.2.2 t.1 t.2.1 ∧ (t.1, N', a') ∈ T

-- AGENT-CHOICE (reading): the paper's condition "N_{α*} = ⋃{N_ε : ε < α}" has a free `α` and the
-- decomposed model `M*` is never mentioned; we read it as `N_{α*} = M*` (and `ε ⪯ α*` as
-- `ε ≤ α*`). See docs/METHOD.md.
/-- Def 3.2.2: `⟨d_ε, N_ε : ε < α*⟩⌢⟨N_{α*}⟩` is a decomposition of `M*` over `M` by `K^{3,*}`:
(1) `α* < λ⁺`, `N_ε ∈ K_λ` (`ε < α*`), (2) `⟨N_ε : ε ≤ α*⟩` increasing continuous,
(3) `N₀ = M`, (4) `(N_ε, N_{ε+1}, d_ε) ∈ K^{3,*}`. -/
def IsDecomp (S : KSys U L) (lam : Cardinal.{u}) (T : Set (Tri U L)) (M Ms : Model U L)
    (αs : Ordinal.{u}) (N : Ordinal.{u} → Model U L) (d : Ordinal.{u} → U) : Prop :=
  αs < (Order.succ lam).ord ∧ (∀ ε < αs, N ε ∈ S.Kc lam) ∧ IsIncreasing S.le N (Iic αs) ∧
    IsContinuous N (Iic αs) ∧ N 0 = M ∧ (∀ ε < αs, (N ε, N (ε + 1), d ε) ∈ T) ∧ N αs = Ms

/-- Def 3.2.2: `M*` is decomposable by `K^{3,*}` over `M`. -/
def Decomposable (S : KSys U L) (lam : Cardinal.{u}) (T : Set (Tri U L)) (M Ms : Model U L) :
    Prop :=
  Ms ∈ S.Kc lam ∧ ∃ αs N d, IsDecomp S lam T M Ms αs N d

/-- AUX: not in paper. A triple in `K^{3,bs}` is in `K³` (by Def 2.1.1(2)(a)). -/
theorem Frame.K3bs_K3 {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) {t : Tri U L}
    (ht : t ∈ s.K3bs lam) : t ∈ s.S.K3 := by
  obtain ⟨N', a', hlt, hN', ha', heq⟩ := hc.ax2a t.1 ht.1 ht.2.2.2
  have hK : (t.1, N', a') ∈ s.S.K3 := ⟨ht.1.1, hN'.1, hlt.1, ha'.1⟩
  have := (ERel.K3_iff (tp_eq_iff.1 heq)).2 hK
  exact this

/-- AUX: not in paper. Transport of a triple in an isomorphism-closed `K^{3,*}` along a
conjugation: if `p, p'` are conjugate (over `M, M' ∈ K_λ`), `p` is realized by a triple in `K³`,
and `p'` contains a triple of `K^{3,*} ∩ K³_λ`, then `p` contains a triple of `K^{3,*}` with base
`M`. -/
theorem conj_transport {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hAP : AP S lam) (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {T : Set (Tri U L)}
    (hiso : IsoClosedTri T) {M M' : Model U L} (hM : M ∈ S.Kc lam)
    {p p' : Set (Tri U L)} (hcj : Conjugate S lam M p M' p') {N : Model U L} {a : U}
    (hK : (M, N, a) ∈ S.K3) (hpa : tp S lam a M N = p) {N' : Model U L} {b : U}
    (hK' : (M', N', b) ∈ S.K3c lam) (hp' : tp S lam b M' N' = p') (hT : (M', N', b) ∈ T) :
    ∃ (N'' : Model U L) (b'' : U), (M, N'', b'') ∈ T ∧ tp S lam b'' M N'' = p := by
  obtain ⟨a₀, M₀p, a₁, M₁p, f, hp0, hp1, hfN, hfM, hfa⟩ := hcj
  have hK0 : (M, M₀p, a₀) ∈ S.K3 :=
    (ERel.K3_iff (tp_eq_iff.1 (hpa.trans hp0.symm))).1 hK
  obtain ⟨W, hW, hMW, hWM₀, ha₀W, htpW⟩ := hS.exists_small_tp hlst hinf hM hK0
  obtain ⟨W', hfW⟩ := exists_isoOn (hfN.injOn.mono (hS.sub hWM₀))
  have hW'M₁ : S.le W' M₁p := hS.iso_le hWM₀ hfN hfW
  have hM'W' : S.le M' W' := hS.iso_le hMW hfW hfM
  have hW'c : W' ∈ S.Kc lam := ⟨hS.mem_left hW'M₁, by rw [hfW.card_eq]; exact hW.2⟩
  have ha₁W' : a₁ ∈ W'.carrier := hfa ▸ hfW.mapsTo ha₀W
  have hM'M₁ : S.le M' M₁p := hS.trans hM'W' hW'M₁
  have hK1 : (M', M₁p, a₁) ∈ S.K3 := ⟨hS.mem_left hM'W', hS.mem_right hW'M₁, hM'M₁, hS.sub hW'M₁ ha₁W'⟩
  have htp1 : tp S lam b M' N' = tp S lam a₁ M' W' := by
    rw [hp', tp_eq_of_le hS hK1 hW'M₁ hM'W' ha₁W', hp1]
  obtain ⟨N₂, hN₂, hW'N₂, h, hh, hover, hhb⟩ :=
    tp_eq_small hS hU hAP hlst hinf hK'
      (show (M', W', a₁) ∈ S.K3c lam from ⟨hK'.1, hW'c, hM'W', ha₁W'⟩) htp1
  obtain ⟨g, hgW, hgf, hfg⟩ := hfW.exists_inv
  obtain ⟨k, N₂', hk, hkg, hWN₂', -, -⟩ := hS.rename hU.infinite (∅ : Set U) hW'N₂ hgW
    (by rw [Set.empty_union]; exact lt_of_le_of_lt (le_of_eq hW.2) hU.2)
  obtain ⟨-, -, Q, hQN₂, hhQ⟩ := hh
  obtain ⟨Q', hkQ⟩ := exists_isoOn (hk.injOn.mono (hS.sub hQN₂))
  have hM'sub : M'.carrier ⊆ W'.carrier := hS.sub hM'W'
  obtain ⟨g', hg'M, hg'f, -⟩ := hfM.exists_inv
  have hgM : IsoOn (k ∘ h) M' M := hg'M.congr fun y hy => by
    obtain ⟨x, hx, rfl⟩ := (hfM.carrier_eq ▸ hy : y ∈ f '' M.carrier)
    have hxW : x ∈ W.carrier := hS.sub hMW hx
    show g' (f x) = k (h (f x))
    rw [hover.2 _ hy, hkg _ (hM'sub hy), hgf x hxW, hg'f x hx]
  have hT' := hiso _ hT (k ∘ h) M Q' (hhQ.comp hkQ) hgM
  have hb'' : (k ∘ h) b = a₀ := by
    show k (h b) = a₀
    rw [hhb, hkg _ ha₁W', ← hfa, hgf a₀ ha₀W]
  rw [hb''] at hT'
  refine ⟨Q', a₀, hT', ?_⟩
  have hQ'N₂' : S.le Q' N₂' := hS.iso_le hQN₂ hk hkQ
  have hM'Q : S.le M' Q := hS.iso_le hK'.2.2.1 hhQ
    ((IsoOn.refl M').congr fun x hx => (hover.2 x hx).symm)
  have hMQ' : S.le M Q' := hS.iso_le hM'Q hkQ
    (hgM.congr fun x hx => by show k (h x) = k x; rw [hover.2 x hx])
  have ha₀Q' : a₀ ∈ Q'.carrier := by
    rw [← hb'']; exact (hhQ.comp hkQ).mapsTo hK'.2.2.2
  have hKN : (M, N₂', a₀) ∈ S.K3 :=
    ⟨hM.1, hS.mem_right hQ'N₂', hS.trans hMQ' hQ'N₂', hS.sub hQ'N₂' ha₀Q'⟩
  rw [tp_eq_of_le hS hKN hQ'N₂' hMQ' ha₀Q', ← tp_eq_of_le hS hKN hWN₂' hMW ha₀W, htpW, hp0]

/-- Thm 3.2.3(1) (extensions decomposition theorem): for `K^{3,*} ⊆ K^{3,bs}` closed under
isomorphisms, if `s` satisfies the conjugation property and `K^{3,*}` is dense, then it
satisfies the existence property. -/
theorem thm_3_2_3_1 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (T : Set (Tri U L)) (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T)
    (hconj : ConjProp s lam) (hd : s.Dense lam T) : s.ExistProp lam T := by
  obtain ⟨hc, -, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  rintro ⟨M, N, a⟩ ht
  have hM : M ∈ s.S.Kc lam := ht.1
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  obtain ⟨⟨Ms, Ns, b⟩, hT', hle⟩ := hd _ ht
  obtain ⟨-, ht', hMMs, hNNs, hba, hnf⟩ := hle
  simp only at hba hMMs hNNs hnf
  subst hba
  have hK : (M, N, b) ∈ s.S.K3 := Frame.K3bs_K3 hc ht
  have hKs : (Ms, Ns, b) ∈ s.S.K3c lam := ⟨ht'.1, ht'.2.1, (Frame.K3bs_K3 hc ht').2.2.1, ht'.2.2.1.1⟩
  have hres : res s.S lam (tp s.S lam b Ms Ns) M = tp s.S lam b M N := by
    rw [res_tp hS hMMs, tp_eq_of_le hS ⟨hM.1, hKs.2.1.1, hS.trans hMMs hKs.2.2.1, hKs.2.2.2⟩ hNNs
      hK.2.2.1 ht.2.2.1.1]
  have hcj := hconj.2 M hM Ms ht'.1 hMMs _ ht.2.2.2 _ ht'.2.2.2 ⟨hnf, hres⟩
  obtain ⟨N'', b'', hT'', htp⟩ := conj_transport hS hU hc.ax1b hc.ax0b hinf hiso hM hcj hK rfl hKs
    rfl hT'
  exact ⟨N'', b'', htp, hT''⟩

/-- Thm 3.2.3(2): if `K^{3,*}` has the existence property, `N ∈ K_λ` and
`p = tp(a, M, N) ∈ S^bs(M)`, then there are `N*, N⁺` with `(M, N*, a) ∈ K^{3,*} ∩ p`,
`N ≼ N⁺`, `N* ≼ N⁺`. -/
theorem thm_3_2_3_2 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (T : Set (Tri U L)) (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T) (he : s.ExistProp lam T)
    (M N : Model U L) (a : U)
    -- PROOF-STAGE CHANGE: added `hM : M ∈ K_λ` (implicit in the paper, where `S^bs(M)` is only
    -- defined for `M ∈ K_λ`); without it `S^bs(M)` is unconstrained and the statement is false.
    (hM : M ∈ s.S.Kc lam) (hN : N ∈ s.S.Kc lam) (hp : tp s.S lam a M N ∈ s.Sbs M) :
    ∃ Ns Np : Model U L, (M, Ns, a) ∈ T ∧ (M, Ns, a) ∈ tp s.S lam a M N ∧ s.S.le N Np ∧
      s.S.le Ns Np := by
  obtain ⟨hc, -, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  obtain ⟨N₁, a₁, hlt, hN₁, ha₁, heq⟩ := hc.ax2a M hM hp
  have hK1 : (M, N₁, a₁) ∈ s.S.K3 := ⟨hM.1, hN₁.1, hlt.1, ha₁.1⟩
  have hK : (M, N, a) ∈ s.S.K3 := (ERel.K3_iff (tp_eq_iff.1 heq)).2 hK1
  have hna : a ∉ M.carrier := fun haM =>
    ha₁.2 (by
      have h := (ERel.alg (tp_eq_iff.1 heq)).1 haM
      simp only at h; rw [h]; exact haM)
  have ht : (M, N, a) ∈ s.K3bs lam := ⟨hM, hN, ⟨hK.2.2.2, hna⟩, hp⟩
  obtain ⟨N', a', htp, hT'⟩ := he _ ht
  have hT'bs := hT hT'
  have hK' : (M, N', a') ∈ s.S.K3c lam :=
    ⟨hM, hT'bs.2.1, (Frame.K3bs_K3 hc hT'bs).2.2.1, hT'bs.2.2.1.1⟩
  obtain ⟨N₂, hN₂, hNN₂, f, hf, hover, hfa⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf hK'
    ⟨hM, hN, hK.2.2.1, hK.2.2.2⟩ htp
  obtain ⟨-, -, P, hPN₂, hfP⟩ := hf
  have hfix : IsoOn f M M := (IsoOn.refl _).congr fun x hx => (hover.2 x hx).symm
  have hTP : (M, P, a) ∈ T := by
    have h' : (M, P, f a') ∈ T := hiso _ hT' f M P hfP hfix
    rwa [hfa] at h'
  refine ⟨P, N₂, hTP, ?_, hNN₂, hPN₂⟩
  have hMP : s.S.le M P := hS.iso_le hK'.2.2.1 hfP hfix
  have haP : a ∈ P.carrier := hfa ▸ hfP.mapsTo hK'.2.2.2
  have hKN₂ : (M, N₂, a) ∈ s.S.K3 := ⟨hM.1, hN₂.1, hS.trans hMP hPN₂, hS.sub hPN₂ haP⟩
  show ERel s.S lam (M, N, a) (M, P, a)
  apply tp_eq_iff.1
  rw [tp_eq_of_le hS hKN₂ hPN₂ hMP haP, ← tp_eq_of_le hS hKN₂ hNN₂ hK.2.2.1 hK.2.2.2]

/-- Thm 3.2.3(3): if `K^{3,*}` has the existence property and `M ≺ N` in `K_λ`, then there is
`M* ∈ K_λ`, `M* ≽ N`, decomposable over `M` by `K^{3,*}`; moreover for `a ∈ N - M` with
`tp(a, M, N)` basic we can choose `d₀ = a`. -/
theorem thm_3_2_3_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (T : Set (Tri U L)) (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T) (he : s.ExistProp lam T)
    (M N : Model U L) (hM : M ∈ s.S.Kc lam) (hN : N ∈ s.S.Kc lam) (hMN : s.S.lt M N) :
    (∃ Ms ∈ s.S.Kc lam, s.S.le N Ms ∧ Decomposable s.S lam T M Ms) ∧
      ∀ a ∈ N.carrier \ M.carrier, tp s.S lam a M N ∈ s.Sbs M →
        ∃ Ms ∈ s.S.Kc lam, s.S.le N Ms ∧ ∃ αs Ns d, IsDecomp s.S lam T M Ms αs Ns d ∧ d 0 = a := by
  classical
  obtain ⟨hc, -, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  set κ := (Order.succ lam).ord with hκ
  have hκlim : Order.IsSuccLimit κ := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have hcardlt : ∀ α < κ, α.card ≤ lam := fun α hα => Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hα)
  have hmore : ∀ a ∈ N.carrier \ M.carrier, tp s.S lam a M N ∈ s.Sbs M →
      ∃ Ms ∈ s.S.Kc lam, s.S.le N Ms ∧ ∃ αs Ns d, IsDecomp s.S lam T M Ms αs Ns d ∧ d 0 = a := by
    intro a ha hab
    by_contra H
    have : Nonempty (Model U L × Model U L × U) := ⟨(M, N, a)⟩
    let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L × Model U L × U) → Prop := fun α c =>
      α < κ →
      (∀ β ≤ α, (c β).1 ∈ s.S.Kc lam ∧ (c β).2.1 ∈ s.S.Kc lam ∧ s.S.le (c β).1 (c β).2.1) ∧
      (c 0).1 = M ∧ (c 0).2.1 = N ∧
      IsIncreasing s.S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
      IsIncreasing s.S.le (fun β => (c β).2.1) (Iic α) ∧
      IsContinuous (fun β => (c β).2.1) (Iic α) ∧
      (∀ β, β + 1 ≤ α → ((c β).1, (c (β + 1)).1, (c (β + 1)).2.2) ∈ T ∧
        (c (β + 1)).2.2 ∈ (c β).2.1.carrier) ∧
      ((0 : Ordinal.{u}) + 1 ≤ α → (c (0 + 1)).2.2 = a)
    have hloc : ∀ α (c c' : Ordinal.{u} → Model U L × Model U L × U), (∀ β ≤ α, c β = c' β) →
        Inv α c → Inv α c' := by
      intro α c c' h hi hα
      obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hi hα
      have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
      have e0 : c' 0 = c 0 := e 0 zero_le
      refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2,
        by rw [e0]; exact h3, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_,
        fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_, fun β hβ => ?_, fun h01 => ?_⟩
      · simp only [e β hβ, e γ hγ]; exact h4 β hβ γ hγ hl
      · simp only [e γ hγ]; rw [h5 γ hγ hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγ)]
      · simp only [e β hβ, e γ hγ]; exact h6 β hβ γ hγ hl
      · simp only [e γ hγ]; rw [h7 γ hγ hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγ)]
      · have hβ' : β ≤ α := (Order.lt_add_one_iff.2 le_rfl).le.trans hβ
        rw [e β hβ', e (β + 1) hβ]; exact h8 β hβ
      · rw [e (0 + 1) h01]; exact h9 h01
    obtain ⟨c, hcI⟩ := transfinite_construction κ Inv hloc (by
      intro α hα c hprev
      rcases hα.lt_or_eq with hακ | hακ
      swap
      · exact ⟨(M, N, a), fun h => absurd h (by rw [hακ]; exact lt_irrefl _)⟩
      rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨γ, hγ⟩ | hlim
      · subst h0
        have hc0 : (fun β => if β < (0 : Ordinal.{u}) then c β else (M, N, a)) =
            fun _ => (M, N, a) := funext fun β => if_neg (not_lt.2 zero_le)
        refine ⟨(M, N, a), ?_⟩
        rw [hc0]
        intro _
        have hz : ∀ β ≤ (0 : Ordinal.{u}), β = 0 := fun β hβ => le_antisymm hβ zero_le
        refine ⟨fun β _ => ⟨hM, hN, hMN.1⟩, rfl, rfl, fun β hβ γ hγ hl => ?_,
          fun γ hγ hl => ?_, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_, fun β hβ => ?_,
          fun h => ?_⟩
        · exact absurd (hz γ hγ ▸ hl) (not_lt.2 zero_le)
        · exact absurd (hz γ hγ ▸ hl) Order.not_isSuccLimit_bot
        · exact absurd (hz γ hγ ▸ hl) (not_lt.2 zero_le)
        · exact absurd (hz γ hγ ▸ hl) Order.not_isSuccLimit_bot
        · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hβ) (not_lt.2 zero_le)
        · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) h) (not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at hγ
        subst hγ
        have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
        have hγκ : γ < κ := lt_trans hγ1 hακ
        obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8, p9⟩ := hprev γ hγ1 hγκ
        obtain ⟨hMγ, hNγ, hMNγ⟩ := p1 γ le_rfl
        -- `M_γ ≠ N_γ`, otherwise `N_γ` is a decomposition of `N_γ ⊇ N` over `M`
        have hne : (c γ).1 ≠ (c γ).2.1 := by
          intro heq
          apply H
          rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with hγ0 | hγ0
          · refine ⟨(c γ).1, hMγ, ?_, γ, fun β => (c β).1, fun β => (c (β + 1)).2.2,
              ⟨hγκ, fun ε hε => (p1 ε hε.le).1, p4, p5, p2, fun ε hε => (p8 ε
                (Order.add_one_le_iff.2 hε)).1, rfl⟩, p9 (Order.add_one_le_iff.2 hγ0)⟩
            rw [heq, ← p3]
            exact p6 0 (Set.mem_Iic.2 zero_le) γ (Set.mem_Iic.2 le_rfl) hγ0
          · subst hγ0
            exact absurd (by rw [← p2, ← p3]; exact heq) hMN.2
        -- the new element `d`
        have hd : ∃ d ∈ (c γ).2.1.carrier \ (c γ).1.carrier,
            tp s.S lam d (c γ).1 (c γ).2.1 ∈ s.Sbs (c γ).1 ∧ (γ = 0 → d = a) := by
          rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with hγ0 | hγ0
          · obtain ⟨d, hd, hdb⟩ := hc.ax2c _ hMγ _ hNγ ⟨hMNγ, hne⟩
            exact ⟨d, hd, hdb, fun h => absurd h hγ0.ne'⟩
          · subst hγ0
            rw [p2, p3]
            exact ⟨a, ha, hab, fun _ => rfl⟩
        obtain ⟨d, hdd, hdb, hd0⟩ := hd
        obtain ⟨N', d', htp, hT'⟩ := he ((c γ).1, (c γ).2.1, d) ⟨hMγ, hNγ, hdd, hdb⟩
        have hT'bs := hT hT'
        have hK' : ((c γ).1, N', d') ∈ s.S.K3c lam :=
          ⟨hMγ, hT'bs.2.1, (Frame.K3bs_K3 hc hT'bs).2.2.1, hT'bs.2.2.1.1⟩
        obtain ⟨N₂, hN₂, hNγN₂, f, hf, hover, hfd⟩ := tp_eq_small hS hU hc.ax1b hc.ax0b hinf hK'
          (show ((c γ).1, (c γ).2.1, d) ∈ s.S.K3c lam from ⟨hMγ, hNγ, hMNγ, hdd.1⟩) htp
        obtain ⟨-, -, P, hPN₂, hfP⟩ := hf
        have hfix : IsoOn f (c γ).1 (c γ).1 := (IsoOn.refl _).congr fun x hx => (hover.2 x hx).symm
        have hTP : ((c γ).1, P, d) ∈ T := by
          have h' : ((c γ).1, P, f d') ∈ T := hiso _ hT' f (c γ).1 P hfP hfix
          rwa [hfd] at h'
        have hMP : s.S.le (c γ).1 P := hS.iso_le hK'.2.2.1 hfP hfix
        have hPc : P ∈ s.S.Kc lam := ⟨hS.mem_left hPN₂, by rw [hfP.card_eq]; exact hT'bs.2.1.2⟩
        refine ⟨(P, N₂, d), fun _ => ?_⟩
        set c' : Ordinal.{u} → Model U L × Model U L × U :=
          fun β => if β < γ + 1 then c β else (P, N₂, d) with hc'def
        have hcl : ∀ β ≤ γ, c' β = c β := fun β hβ => if_pos (Order.lt_add_one_iff.2 hβ)
        have hcx : c' (γ + 1) = (P, N₂, d) := if_neg (lt_irrefl _)
        have hcases : ∀ β ≤ γ + 1, β ≤ γ ∨ β = γ + 1 := fun β hβ => by
          rcases hβ.lt_or_eq with h | h
          · exact Or.inl (Order.lt_add_one_iff.1 h)
          · exact Or.inr h
        have hle1 : ∀ β ≤ γ, s.S.le (c β).1 (c γ).1 := fun β hβ => by
          rcases hβ.lt_or_eq with h | h
          · exact p4 β (Set.mem_Iic.2 hβ) γ (Set.mem_Iic.2 le_rfl) h
          · rw [h]; exact hS.refl hMγ.1
        have hle2 : ∀ β ≤ γ, s.S.le (c β).2.1 (c γ).2.1 := fun β hβ => by
          rcases hβ.lt_or_eq with h | h
          · exact p6 β (Set.mem_Iic.2 hβ) γ (Set.mem_Iic.2 le_rfl) h
          · rw [h]; exact hS.refl hNγ.1
        have hnotlim : ∀ β ≤ γ + 1, Order.IsSuccLimit β → β ≤ γ := fun β hβ hl => by
          rcases hcases β hβ with h | h
          · exact h
          · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax γ)
        refine ⟨fun β hβ => ?_, by rw [hcl 0 zero_le]; exact p2, by rw [hcl 0 zero_le]; exact p3,
          fun β hβ β' hβ' hl => ?_, fun β' hβ' hl => ?_, fun β hβ β' hβ' hl => ?_,
          fun β' hβ' hl => ?_, fun β hβ => ?_, fun h01 => ?_⟩
        · rcases hcases β hβ with h | h
          · rw [hcl β h]; exact p1 β h
          · rw [h, hcx]; exact ⟨hPc, hN₂, hPN₂⟩
        · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hβ')
          show s.S.le (c' β).1 (c' β').1
          rw [hcl β hβγ]
          rcases hcases β' hβ' with h | h
          · rw [hcl β' h]; exact p4 β (Set.mem_Iic.2 hβγ) β' (Set.mem_Iic.2 h) hl
          · rw [h, hcx]; exact hS.trans (hle1 β hβγ) hMP
        · have hβγ := hnotlim β' hβ' hl
          show (c' β').1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).1.carrier
          rw [hcl β' hβγ, p5 β' (Set.mem_Iic.2 hβγ) hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hβγ)]
        · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hβ')
          show s.S.le (c' β).2.1 (c' β').2.1
          rw [hcl β hβγ]
          rcases hcases β' hβ' with h | h
          · rw [hcl β' h]; exact p6 β (Set.mem_Iic.2 hβγ) β' (Set.mem_Iic.2 h) hl
          · rw [h, hcx]; exact hS.trans (hle2 β hβγ) hNγN₂
        · have hβγ := hnotlim β' hβ' hl
          show (c' β').2.1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).2.1.carrier
          rw [hcl β' hβγ, p7 β' (Set.mem_Iic.2 hβγ) hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hβγ)]
        · have hβγ : β ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hβ)
          rcases hβγ.lt_or_eq with h | h
          · have hb1 : β + 1 ≤ γ := Order.add_one_le_iff.2 h
            rw [hcl β hβγ, hcl (β + 1) hb1]; exact p8 β hb1
          · subst h
            rw [hcl β le_rfl, hcx]; exact ⟨hTP, hdd.1⟩
        · rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with hγ0 | hγ0
          · have h01' : (0 : Ordinal.{u}) + 1 ≤ γ := Order.add_one_le_iff.2 hγ0
            rw [hcl (0 + 1) h01']; exact p9 h01'
          · subst hγ0
            rw [hcx]; exact hd0 rfl
      · -- limit stage
        have h0α : (0 : Ordinal.{u}) < α := by simpa using hlim.bot_lt
        have hK : ∀ β < α, (c β).1 ∈ s.S.Kc lam ∧ (c β).2.1 ∈ s.S.Kc lam ∧
            s.S.le (c β).1 (c β).2.1 := fun β hβ => (hprev β hβ (lt_trans hβ hακ)).1 β le_rfl
        have hinc1 : IsIncreasing s.S.le (fun β => (c β).1) (Iio α) := fun β hβ β' hβ' h =>
          (hprev β' hβ' (lt_trans hβ' hακ)).2.2.2.1 β (Set.mem_Iic.2 h.le) β'
            (Set.mem_Iic.2 le_rfl) h
        have hinc2 : IsIncreasing s.S.le (fun β => (c β).2.1) (Iio α) := fun β hβ β' hβ' h =>
          (hprev β' hβ' (lt_trans hβ' hακ)).2.2.2.2.2.1 β (Set.mem_Iic.2 h.le) β'
            (Set.mem_Iic.2 le_rfl) h
        have hcont1 : IsContinuous (fun β => (c β).1) (Iio α) := fun β hβ hβl =>
          (hprev β hβ (lt_trans hβ hακ)).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl
        have hcont2 : IsContinuous (fun β => (c β).2.1) (Iio α) := fun β hβ hβl =>
          (hprev β hβ (lt_trans hβ hακ)).2.2.2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl
        obtain ⟨Mα, hMαU, -, -⟩ := hS.union α hlim _ hinc1 hcont1
        obtain ⟨Nα, hNαU, -, -⟩ := hS.union α hlim _ hinc2 hcont2
        obtain ⟨hMαK, hleM⟩ := hS.le_union hlim hinc1 hcont1 hMαU
        obtain ⟨hNαK, hleN⟩ := hS.le_union hlim hinc2 hcont2 hNαU
        have hcard : ∀ (X : Model U L) (F : Ordinal.{u} → Model U L),
            IsUnionOf F (Iio α) X → (∀ β < α, F β ∈ s.S.Kc lam) → X ∈ s.S.K →
            (∀ β < α, s.S.le (F β) X) → X ∈ s.S.Kc lam := fun X F hXU hF hXK hle =>
          ⟨hXK, le_antisymm (by
            change #X.carrier ≤ lam; rw [hXU.1]
            exact card_biUnion_le hinf (hcardlt α hακ) fun β hβ => le_of_eq (hF β hβ).2) (by
            rw [← (hF 0 h0α).2]; exact Model.card_le_of_sub (hS.sub (hle 0 h0α)))⟩
        have hMαc := hcard Mα _ hMαU (fun β hβ => (hK β hβ).1) hMαK hleM
        have hNαc := hcard Nα _ hNαU (fun β hβ => (hK β hβ).2.1) hNαK hleN
        have hMN' : s.S.le Mα Nα := hS.smooth α hlim _ Nα hinc1 hcont1
          (fun β hβ => hS.trans (hK β hβ).2.2 (hleN β hβ)) Mα hMαU hMαK
        refine ⟨(Mα, Nα, a), fun _ => ?_⟩
        set c' : Ordinal.{u} → Model U L × Model U L × U :=
          fun β => if β < α then c β else (Mα, Nα, a) with hc'def
        have hcl : ∀ β < α, c' β = c β := fun β hβ => if_pos hβ
        have hcx : c' α = (Mα, Nα, a) := if_neg (lt_irrefl _)
        have hp0 := hprev 0 h0α (lt_trans h0α hακ)
        refine ⟨fun β hβ => ?_, by rw [hcl 0 h0α]; exact hp0.2.1,
          by rw [hcl 0 h0α]; exact hp0.2.2.1, fun β hβ β' hβ' hl => ?_, fun β' hβ' hl => ?_,
          fun β hβ β' hβ' hl => ?_, fun β' hβ' hl => ?_, fun β hβ => ?_, fun h01 => ?_⟩
        · rcases (show β ≤ α from hβ).lt_or_eq with h | h
          · rw [hcl β h]; exact hK β h
          · rw [h, hcx]; exact ⟨hMαc, hNαc, hMN'⟩
        · have hβα : β < α := lt_of_lt_of_le hl hβ'
          show s.S.le (c' β).1 (c' β').1
          rw [hcl β hβα]
          rcases (show β' ≤ α from hβ').lt_or_eq with h | h
          · rw [hcl β' h]; exact hinc1 β hβα β' h hl
          · rw [h, hcx]; exact hleM β hβα
        · show (c' β').1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).1.carrier
          rcases (show β' ≤ α from hβ').lt_or_eq with h | h
          · rw [hcl β' h, hcont1 β' h hl]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
          · rw [h, hcx, hMαU.1]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
        · have hβα : β < α := lt_of_lt_of_le hl hβ'
          show s.S.le (c' β).2.1 (c' β').2.1
          rw [hcl β hβα]
          rcases (show β' ≤ α from hβ').lt_or_eq with h | h
          · rw [hcl β' h]; exact hinc2 β hβα β' h hl
          · rw [h, hcx]; exact hleN β hβα
        · show (c' β').2.1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).2.1.carrier
          rcases (show β' ≤ α from hβ').lt_or_eq with h | h
          · rw [hcl β' h, hcont2 β' h hl]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
          · rw [h, hcx, hNαU.1]
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
        · have hb1 : β + 1 < α := lt_of_le_of_ne hβ fun h => by
            rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax β)
          have hb : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
          rw [hcl β hb, hcl (β + 1) hb1]
          exact (hprev (β + 1) hb1 (lt_trans hb1 hακ)).2.2.2.2.2.2.2.1 β le_rfl
        · have h1α : (0 : Ordinal.{u}) + 1 < α := lt_of_le_of_ne h01 fun h => by
            rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax 0)
          rw [hcl (0 + 1) h1α]
          exact (hprev (0 + 1) h1α (lt_trans h1α hακ)).2.2.2.2.2.2.2.2 le_rfl)
    -- the chains contradict Prop 1.0.30
    have hI := fun α (hα : α < κ) => hcI α hα.le hα
    refine no_long_chain lam hU hS hinf (M := fun β => (c β).1) (N := fun β => (c β).2.1)
      ⟨fun β hβ β' hβ' h => (hI β' hβ').2.2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h,
        fun β hβ hl => (hI β hβ).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl,
        fun β hβ => ((hI β hβ).1 β le_rfl).1⟩
      ⟨fun β hβ β' hβ' h => (hI β' hβ').2.2.2.2.2.1 β (Set.mem_Iic.2 h.le) β'
          (Set.mem_Iic.2 le_rfl) h,
        fun β hβ hl => (hI β hβ).2.2.2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl,
        fun β hβ => ((hI β hβ).1 β le_rfl).2.1⟩
      (fun β hβ => ((hI β hβ).1 β le_rfl).2.2) (fun β hβ => ?_)
    have hβ1 : β + 1 < κ := hκlim.add_one_lt hβ
    obtain ⟨hTβ, hdN⟩ := (hI (β + 1) hβ1).2.2.2.2.2.2.2.1 β le_rfl
    exact ⟨_, (hT hTβ).2.2.1, hdN⟩
  refine ⟨?_, hmore⟩
  obtain ⟨a, ha, hab⟩ := hc.ax2c M hM N hN hMN
  obtain ⟨Ms, hMs, hNMs, αs, Ns, d, hdec, -⟩ := hmore a ha hab
  exact ⟨Ms, hMs, hNMs, hMs, αs, Ns, d, hdec⟩

/-- AUX: not in paper. Every model of `K_λ` has a proper `≼`-extension in `K_λ` (Ax 1(c)). -/
theorem Frame.exists_strict {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M : Model U L} (hM : M ∈ s.S.Kc lam) : ∃ X ∈ s.S.Kc lam, s.S.lt M X := by
  have hnm := hc.ax1c M hM
  unfold IsMaximal at hnm
  push Not at hnm
  obtain ⟨N, hN, hlt⟩ := hnm hM
  exact ⟨N, hN, hlt.1.2.2, hlt.2⟩

/-- AUX: not in paper. A chain of length `≤ λ⁺` starting in `K_λ`, whose successor stages are in
`K_λ`, stays in `K_λ`. -/
theorem IsAEC.chain_mem_Kc {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {M : Ordinal.{u} → Model U L} {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord)
    (hinc : IsIncreasing S.le M (Iic αs)) (hcont : IsContinuous M (Iic αs))
    (h0 : M 0 ∈ S.Kc lam) (hst : ∀ ε < αs, M (ε + 1) ∈ S.Kc lam) :
    ∀ ε ≤ αs, M ε ∈ S.Kc lam := by
  intro ε
  induction ε using Ordinal.lt_wf.induction with
  | ind ε ih =>
  intro hε
  rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h | ⟨c, hc⟩ | hlim
  · subst h; exact h0
  · rw [Order.succ_eq_add_one] at hc
    subst hc
    exact hst c (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hε)
  · have h0ε : (0 : Ordinal.{u}) < ε := hlim.bot_lt
    have hle0 := hinc 0 (Set.mem_Iic.2 zero_le) ε hε h0ε
    refine ⟨hS.mem_right hle0, le_antisymm ?_ ?_⟩
    · change #(M ε).carrier ≤ lam
      rw [hcont ε hε hlim]
      exact card_biUnion_le hinf (Order.lt_succ_iff.1 (Cardinal.lt_ord.1
        (lt_of_le_of_lt hε hαs))) fun β hβ => le_of_eq (ih β hβ (hβ.le.trans hε)).2
    · rw [← h0.2]; exact Model.card_le_of_sub (hS.sub hle0)

/-- AUX: not in paper. A sequence given block by block, along the partial sums `σ`. -/
theorem ordSum_fun {X : Type*} [Nonempty X] {β σ : Ordinal.{u} → Ordinal.{u}}
    (hs : ∀ ε, σ (ε + 1) = σ ε + β ε) (hm : Monotone σ) (e : Ordinal.{u} → Ordinal.{u} → X) :
    ∃ E : Ordinal.{u} → X, ∀ ε, ∀ η < β ε, E (σ ε + η) = e ε η := by
  classical
  refine ⟨fun ξ => if h : ∃ ε, ∃ η < β ε, ξ = σ ε + η then e h.choose (ξ - σ h.choose)
    else Classical.arbitrary X, fun ε η hη => ?_⟩
  have hex : ∃ ε', ∃ η' < β ε', σ ε + η = σ ε' + η' := ⟨ε, η, hη, rfl⟩
  simp only [dif_pos hex]
  obtain ⟨η', hη', e'⟩ := hex.choose_spec
  have key : ∀ {a b x y : Ordinal.{u}}, x < β a → a < b → σ a + x ≠ σ b + y := by
    intro a b x y hx hab h
    have h2 : σ a + x < σ (a + 1) := by rw [hs]; exact (add_lt_add_iff_left _).2 hx
    exact absurd (h ▸ h2) (not_lt.2 ((hm (Order.add_one_le_iff.2 hab)).trans le_self_add))
  have hc : hex.choose = ε := by
    rcases lt_trichotomy hex.choose ε with h | h | h
    · exact absurd e'.symm (key hη' h)
    · exact h
    · exact absurd e' (key hη h)
  rw [hc, Ordinal.add_sub_cancel]

-- AGENT-CHOICE (added hypothesis): as in Prop 3.2.4, `K^{3,*}` is an arbitrary class of basic
-- triples closed under isomorphisms (the paper leaves it implicit).
-- DEVIATION (author-confirmed erratum): added `α* < λ⁺` and `M₀ ∈ K_λ`. As written, the statement
-- is false for `α* ≥ λ⁺` with a strictly increasing chain (the top model is not in `K_λ`) and for
-- `α* = 0` with `M₀ ∉ K_λ`.
/-- Prop 3.2.5 (decomposable extensions transitivity), corrected: if `α* < λ⁺`, `M₀ ∈ K_λ`,
`⟨M_ε : ε ≤ α*⟩` is increasing continuous and each `M_{ε+1}` is decomposable over `M_ε`, then
`M_{α*}` is decomposable over `M₀`. Original text: "Let `⟨M_ε : ε ≤ α*⟩` be an increasing
continuous sequence of models, such that for every `ε < α*`, `M_{ε+1}` is decomposable over
`M_ε`. Then `M_{α*}` is decomposable over `M₀`." -/
theorem prop_3_2_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (T : Set (Tri U L)) (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T)
    (αs : Ordinal.{u}) (hαs : αs < (Order.succ lam).ord) (M : Ordinal.{u} → Model U L)
    (hM0 : M 0 ∈ s.S.Kc lam)
    (hM : IsIncreasing s.S.le M (Iic αs) ∧ IsContinuous M (Iic αs))
    (hdec : ∀ ε < αs, Decomposable s.S lam T (M ε) (M (ε + 1))) :
    Decomposable s.S lam T (M 0) (M αs) := by
  classical
  obtain ⟨hc, -, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM0
  haveI : Infinite U := hU.infinite
  obtain ⟨hMinc, hMcont⟩ := hM
  have hMK := hS.chain_mem_Kc hinf hαs hMinc hMcont hM0 fun ε hε => (hdec ε hε).1
  have hex : ∀ ε, ∃ p : Ordinal.{u} × (Ordinal.{u} → Model U L) × (Ordinal.{u} → U),
      ε < αs → IsDecomp s.S lam T (M ε) (M (ε + 1)) p.1 p.2.1 p.2.2 := fun ε => by
    by_cases h : ε < αs
    · obtain ⟨-, b, D, e, hd⟩ := hdec ε h
      exact ⟨(b, D, e), fun _ => hd⟩
    · exact ⟨(0, fun _ => M 0, fun _ => Classical.arbitrary U), fun h' => absurd h' h⟩
  choose p hp using hex
  obtain ⟨σ, h0, hs, hm, hl⟩ := exists_ordSum fun ε => (p ε).1
  obtain ⟨G, hGM, hGD, hGinc, hGcont⟩ := hS.concat_chain (D := fun ε => (p ε).2.1) h0 hs hm hl
    hMinc hMcont (fun ε hε => (hMK ε hε).1) (fun ε hε => (hp ε hε).2.2.1)
    (fun ε hε => (hp ε hε).2.2.2.1) (fun ε hε => (hp ε hε).2.2.2.2.1)
    (fun ε hε => (hp ε hε).2.2.2.2.2.2)
  obtain ⟨E, hE⟩ := ordSum_fun hs hm fun ε => (p ε).2.2
  have hcov := ordSum_cover h0 hs hl αs
  refine ⟨hMK αs le_rfl, σ αs, G, E, ordSum_lt hinf h0 hs hl hαs fun ε hε => (hp ε hε).1,
    fun ξ hξ => ?_, hGinc, hGcont, ?_, fun ξ hξ => ?_, hGM αs le_rfl⟩
  · obtain ⟨ε, hε, η, hη, e⟩ := hcov ξ hξ
    rw [e, hGD ε hε η hη.le]; exact (hp ε hε).2.1 η hη
  · have := hGM 0 zero_le; rwa [h0] at this
  · obtain ⟨ε, hε, η, hη, e⟩ := hcov ξ hξ
    rw [e, add_assoc, hGD ε hε η hη.le, hGD ε hε (η + 1) (Order.add_one_le_iff.2 hη), hE ε η hη]
    exact (hp ε hε).2.2.2.2.2.1 η hη

/-- AUX: not in paper. The union of an `ω`-chain. -/
theorem IsAEC.exists_union_nat {S : KSys U L} (hS : IsAEC S) {X : ℕ → Model U L}
    (hK : ∀ n, X n ∈ S.K) (hst : ∀ n, S.le (X n) (X (n + 1))) :
    ∃ V ∈ S.K, V.carrier = (⋃ n, (X n).carrier) ∧ ∀ n, S.le (X n) V := by
  classical
  have hmono : ∀ m n, m ≤ n → S.le (X m) (X n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hS.refl (hK m)
    | succ n _ ih => exact hS.trans ih (hst n)
  let F : Ordinal.{u} → Model U L := fun ε =>
    if h : ε < Ordinal.omega0 then X (Classical.choose (Ordinal.lt_omega0.1 h)) else X 0
  have hF : ∀ n : ℕ, F n = X n := fun n => by
    have h : (n : Ordinal.{u}) < Ordinal.omega0 := Ordinal.lt_omega0.2 ⟨n, rfl⟩
    simp only [F, dif_pos h]
    congr 1
    exact (Nat.cast_inj.1 (Classical.choose_spec (Ordinal.lt_omega0.1 h))).symm
  have hinc : IsIncreasing S.le F (Iio Ordinal.omega0) := by
    intro a ha b hb h
    obtain ⟨m, rfl⟩ := Ordinal.lt_omega0.1 ha
    obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hb
    rw [hF, hF]; exact hmono m n (Nat.cast_lt.1 h).le
  have hcont : IsContinuous F (Iio Ordinal.omega0) := by
    intro b hb hl
    obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hb
    cases n with
    | zero => simp only [Nat.cast_zero] at hl; exact absurd hl Order.not_isSuccLimit_bot
    | succ n =>
      rw [Nat.cast_succ, ← Order.succ_eq_add_one] at hl
      exact absurd hl.isMax (not_isMax _)
  obtain ⟨V, hV, -, -⟩ := hS.union Ordinal.omega0 Ordinal.isSuccLimit_omega0 _ hinc hcont
  obtain ⟨hVK, hle⟩ := hS.le_union Ordinal.isSuccLimit_omega0 hinc hcont hV
  refine ⟨V, hVK, ?_, fun n => ?_⟩
  · rw [hV.1]
    ext x
    simp only [Set.mem_iUnion, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hξ
      exact ⟨n, by rw [← hF]; exact hx⟩
    · rintro ⟨n, hx⟩
      exact ⟨n, Ordinal.lt_omega0.2 ⟨n, rfl⟩, by rw [hF]; exact hx⟩
  · have := hle n (Ordinal.lt_omega0.2 ⟨n, rfl⟩); rwa [hF] at this

/-- AUX: not in paper. Prop 3.2.5 for `α* = ω`, for a chain given by natural numbers. -/
theorem Frame.decomp_omega {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_3_0_1 s lam) {T : Set (Tri U L)} (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T)
    {P V : Model U L} {Y : ℕ → Model U L} (hP : P ∈ s.S.Kc lam) (hPY : s.S.le P (Y 0))
    (hst : ∀ n, s.S.le (Y n) (Y (n + 1))) (hd0 : Decomposable s.S lam T P (Y 0))
    (hd : ∀ n, Decomposable s.S lam T (Y n) (Y (n + 1)))
    (hVc : V.carrier = ⋃ n, (Y n).carrier) (hle : ∀ n, s.S.le (Y n) V) :
    Decomposable s.S lam T P V := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hP
  let c : ℕ → Model U L := fun n => Nat.casesOn n P Y
  have hcs : ∀ n, s.S.le (c n) (c (n + 1)) := fun n => by
    cases n with
    | zero => exact hPY
    | succ n => exact hst n
  have hcV : ∀ n, s.S.le (c n) V := fun n => by
    cases n with
    | zero => exact hS.trans hPY (hle 0)
    | succ n => exact hle n
  have hmono : ∀ m n, m < n → s.S.le (c m) (c n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hcs m
    | succ n _ ih => exact hS.trans ih (hcs n)
  let C : Ordinal.{u} → Model U L := fun ε =>
    if h : ε < Ordinal.omega0 then c (Classical.choose (Ordinal.lt_omega0.1 h)) else V
  have hC : ∀ n : ℕ, C n = c n := fun n => by
    have h : (n : Ordinal.{u}) < Ordinal.omega0 := Ordinal.lt_omega0.2 ⟨n, rfl⟩
    simp only [C, dif_pos h]
    congr 1
    exact (Nat.cast_inj.1 (Classical.choose_spec (Ordinal.lt_omega0.1 h))).symm
  have hCω : C Ordinal.omega0 = V := dif_neg (lt_irrefl _)
  have hω : (Ordinal.omega0 : Ordinal.{u}) < (Order.succ lam).ord := by
    rw [Cardinal.lt_ord, Ordinal.card_omega0]; exact Order.lt_succ_iff.2 hinf
  have hC0 : C 0 = P := by have := hC 0; simpa [c] using this
  have := prop_3_2_5 lam hU s hs T hT hiso Ordinal.omega0 hω C (by rw [hC0]; exact hP)
    ⟨fun a ha b hb h => ?_, fun b hb hl => ?_⟩ fun ε hε => ?_
  · rwa [hC0, hCω] at this
  · obtain ⟨m, rfl⟩ := Ordinal.lt_omega0.1 (lt_of_lt_of_le h hb)
    rw [hC]
    rcases (show b ≤ Ordinal.omega0 from hb).lt_or_eq with h' | h'
    · obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 h'
      rw [hC]; exact hmono m n (Nat.cast_lt.1 h)
    · rw [h', hCω]; exact hcV m
  · rcases (show b ≤ Ordinal.omega0 from hb).lt_or_eq with h' | h'
    · obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 h'
      cases n with
      | zero => simp only [Nat.cast_zero] at hl; exact absurd hl Order.not_isSuccLimit_bot
      | succ n =>
        rw [Nat.cast_succ, ← Order.succ_eq_add_one] at hl
        exact absurd hl.isMax (not_isMax _)
    · subst h'
      rw [hCω, hVc]
      ext x
      simp only [Set.mem_iUnion, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨n, hx⟩
        exact ⟨((n + 1 : ℕ) : Ordinal.{u}), Ordinal.lt_omega0.2 ⟨_, rfl⟩, by rw [hC]; exact hx⟩
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨m, rfl⟩ := Ordinal.lt_omega0.1 hξ
        rw [hC] at hx
        cases m with
        | zero => exact ⟨0, hS.sub hPY hx⟩
        | succ n => exact ⟨n, hx⟩
  · obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hε
    have e : ((n : Ordinal.{u}) + 1) = ((n + 1 : ℕ) : Ordinal.{u}) := by rw [Nat.cast_succ]
    rw [e, hC, hC]
    cases n with
    | zero => exact hd0
    | succ n => exact hd n

-- AGENT-CHOICE (added hypothesis): the paper does not say by which `K^{3,*}` the models are
-- decomposable; we take any `K^{3,*} ⊆ K^{3,bs}` closed under isomorphisms with the existence
-- property (the setting of Thm 3.2.3, which the proof uses).
/-- Prop 3.2.4 (existence of decomposition over two models): if `M₀, M₁, N ∈ K_λ` and
`Mₙ ≼ N` (`n < 2`), then there is `M* ∈ K_λ` with `N ≼ M*`, decomposable over `M₀` and over
`M₁`. -/
theorem prop_3_2_4 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (T : Set (Tri U L)) (hT : T ⊆ s.K3bs lam) (hiso : IsoClosedTri T) (he : s.ExistProp lam T)
    (M₀ M₁ N : Model U L) (h₀ : M₀ ∈ s.S.Kc lam) (h₁ : M₁ ∈ s.S.Kc lam) (hN : N ∈ s.S.Kc lam)
    (h0N : s.S.le M₀ N) (h1N : s.S.le M₁ N) :
    ∃ Ms ∈ s.S.Kc lam, s.S.le N Ms ∧ Decomposable s.S lam T M₀ Ms ∧
      Decomposable s.S lam T M₁ Ms := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have hstep : ∀ X ∈ s.S.Kc lam, ∀ Y ∈ s.S.Kc lam, s.S.le X Y →
      ∃ Z ∈ s.S.Kc lam, s.S.le Y Z ∧ Decomposable s.S lam T X Z := by
    intro X hX Y hY hXY
    obtain ⟨Y', hY', hlt⟩ := Frame.exists_strict hc hY
    obtain ⟨Ms, hMs, hY'Ms, hdec⟩ := (thm_3_2_3_3 lam hU s hs T hT hiso he X Y' hX hY'
      ⟨hS.trans hXY hlt.1, fun e => hlt.2 (hS.po.2.2.1 _ _ hlt.1 (by rw [← e]; exact hXY))⟩).1
    exact ⟨Ms, hMs, hS.trans hlt.1 hY'Ms, hdec⟩
  obtain ⟨Z₂, hZ₂, hNZ₂, hd₂⟩ := hstep M₀ h₀ N hN h0N
  obtain ⟨Z₃, hZ₃, hZ₂₃, hd₃⟩ := hstep M₁ h₁ Z₂ hZ₂ (hS.trans h1N hNZ₂)
  let St := {p : Model U L × Model U L // p.1 ∈ s.S.Kc lam ∧ p.2 ∈ s.S.Kc lam ∧ s.S.le p.1 p.2}
  have hnext : ∀ p : St, ∃ q : St, q.1.1 = p.1.2 ∧ Decomposable s.S lam T p.1.1 q.1.2 := by
    rintro ⟨⟨P, Q⟩, hP, hQ, hPQ⟩
    obtain ⟨Z, hZ, hQZ, hd⟩ := hstep P hP Q hQ hPQ
    exact ⟨⟨(Q, Z), hQ, hZ, hQZ⟩, rfl, hd⟩
  choose next hn1 hn2 using hnext
  let st : ℕ → St := fun n => Nat.rec ⟨(Z₂, Z₃), hZ₂, hZ₃, hZ₂₃⟩ (fun _ p => next p) n
  have hst : ∀ n, st (n + 1) = next (st n) := fun _ => rfl
  let X : ℕ → Model U L := fun n => (st n).1.1
  have hXK : ∀ n, X n ∈ s.S.Kc lam := fun n => (st n).2.1
  have hX1 : ∀ n, (st n).1.2 = X (n + 1) := fun n => by
    show _ = (st (n + 1)).1.1
    rw [hst, hn1]
  have hXs : ∀ n, s.S.le (X n) (X (n + 1)) := fun n => by
    rw [← hX1]; exact (st n).2.2.2
  have hXd : ∀ n, Decomposable s.S lam T (X n) (X (n + 2)) := fun n => by
    have h := hn2 (st n)
    rw [← hst, hX1 (n + 1)] at h
    exact h
  have hmono : ∀ m n, m ≤ n → s.S.le (X m) (X n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hS.refl (hXK m).1
    | succ n _ ih => exact hS.trans ih (hXs n)
  obtain ⟨V, hVK, hVc, hle⟩ := hS.exists_union_nat (fun n => (hXK n).1) hXs
  have h2s : ∀ n, s.S.le (X (2 * n)) (X (2 * (n + 1))) := fun n =>
    hmono (2 * n) (2 * (n + 1)) (by omega)
  have h2d : ∀ n, s.S.le (X (2 * n + 1)) (X (2 * (n + 1) + 1)) := fun n =>
    hmono (2 * n + 1) (2 * (n + 1) + 1) (by omega)
  have hsub : ∀ {g : ℕ → ℕ}, (∀ n, n ≤ g n) → V.carrier = ⋃ n, (X (g n)).carrier := by
    intro g hg
    rw [hVc]
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨n, hx⟩; exact ⟨n, hS.sub (hmono _ _ (hg n)) hx⟩
    · rintro ⟨n, hx⟩; exact ⟨_, hx⟩
  have hX0 : X 0 = Z₂ := rfl
  have hX1' : X 1 = Z₃ := (hX1 0).symm
  have hD0 : Decomposable s.S lam T M₀ V :=
    Frame.decomp_omega hU hs hT hiso (Y := fun n => X (2 * n)) h₀ (hS.trans h0N hNZ₂) h2s hd₂
      (fun n => hXd (2 * n)) (hsub (g := fun n => 2 * n) fun n => by omega) fun n => hle (2 * n)
  have hD1 : Decomposable s.S lam T M₁ V :=
    Frame.decomp_omega hU hs hT hiso (Y := fun n => X (2 * n + 1)) h₁
      (by show s.S.le M₁ (X (2 * 0 + 1)); rw [show 2 * 0 + 1 = 1 from rfl, hX1']
          exact hS.trans h1N (hS.trans hNZ₂ hZ₂₃)) h2d
      (by show Decomposable s.S lam T M₁ (X (2 * 0 + 1))
          rw [show 2 * 0 + 1 = 1 from rfl, hX1']; exact hd₃)
      (fun n => hXd (2 * n + 1)) (hsub (g := fun n => 2 * n + 1) fun n => by omega) fun n => hle (2 * n + 1)
  exact ⟨V, hD0.1, hS.trans hNZ₂ (by rw [← hX0]; exact hle 0), hD0, hD1⟩


/-! ## 3.3 A disjoint amalgamation -/

/-- Def 3.3.1: the amalgamation `(f₁, f₂, M₃)` of `M₁, M₂` over `M₀` is disjoint when
`f₁[M₁] ∩ f₂[M₂] = M₀`. -/
def IsDisjointAmalg (S : KSys U L) (f₁ f₂ : U → U) (M₃ M₀ M₁ M₂ : Model U L) : Prop :=
  IsAmalg S f₁ f₂ M₃ M₀ M₁ M₂ ∧ f₁ '' M₁.carrier ∩ f₂ '' M₂.carrier = M₀.carrier

/-- Def 3.3.2: `(M, N, a) ∈ K^{3,bs}_λ` is reduced if `(M, N, a) ≼_bs (M*, N*, a)` implies
`M* ∩ N = M`; `K^{3,r}` is the class of reduced triples. -/
def Frame.K3r (s : Frame U L) (lam : Cardinal.{u}) : Set (Tri U L) :=
  {t | t ∈ s.K3bs lam ∧ ∀ Ms Ns : Model U L, s.leBs lam t (Ms, Ns, t.2.2) →
    Ms.carrier ∩ t.2.1.carrier = t.1.carrier}

/-- AUX: not in paper. Extending an increasing continuous chain on `[0, δ)` by its union at
`δ` gives an increasing continuous chain on `[0, δ]`. -/
theorem IsAEC.extend_union {S : KSys U L} {δ : Ordinal.{u}}
    {M : Ordinal.{u} → Model U L} (hinc : IsIncreasing S.le M (Iio δ))
    (hcont : IsContinuous M (Iio δ)) {Mu : Model U L} (hMu : IsUnionOf M (Iio δ) Mu)
    (hle : ∀ β < δ, S.le (M β) Mu) :
    IsIncreasing S.le (fun β => if β < δ then M β else Mu) (Iic δ) ∧
      IsContinuous (fun β => if β < δ then M β else Mu) (Iic δ) := by
  refine ⟨fun β hβ γ hγ h => ?_, fun γ hγ hl => ?_⟩
  · have hβδ : β < δ := lt_of_lt_of_le h hγ
    simp only [if_pos hβδ]
    rcases (show γ ≤ δ from hγ).lt_or_eq with h' | h'
    · simp only [if_pos h']; exact hinc β hβδ γ h' h
    · simp only [h', lt_irrefl, if_false]; exact hle β hβδ
  · rcases (show γ ≤ δ from hγ).lt_or_eq with h' | h'
    · simp only [if_pos h']
      rw [hcont γ h' hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [if_pos (lt_trans (show ξ < γ from hξ) h')]
    · subst h'
      simp only [lt_irrefl, if_false]
      rw [hMu.1]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [if_pos (show ξ < γ from hξ)]

/-- AUX: not in paper. Along a `≼_bs`-increasing continuous chain, every triple is `≼_bs`-above
the first one (transitivity of non-forking at successors, Ax 3(g) at limits). -/
theorem Frame.bs_chain {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (hcont3 : s.Ax3g lam) {δ : Ordinal.{u}} (hδ : δ ≤ (Order.succ lam).ord)
    {M N : Ordinal.{u} → Model U L} {a : U} (h : s.BsIncCont lam M N a δ) :
    ∀ α < δ, s.leBs lam (M 0, N 0, a) (M α, N α, a) := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hstep, hMinc, hMcont, hNinc, hNcont⟩ := h
  have hbs : ∀ α < δ, (M α, N α, a) ∈ s.K3bs lam := fun α hα => (hstep α hα).1
  have hMle : ∀ β < δ, ∀ γ < δ, β ≤ γ → s.S.le (M β) (M γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hMinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hbs γ hγ).1.1
  have hNle : ∀ β < δ, ∀ γ < δ, β ≤ γ → s.S.le (N β) (N γ) := fun β hβ γ hγ h => by
    rcases h.lt_or_eq with h | h
    · exact hNinc β hβ γ hγ h
    · rw [h]; exact hS.refl (hbs γ hγ).2.1.1
  -- types restrict along the chain
  have hres : ∀ β < δ, ∀ γ < δ, β ≤ γ →
      res s.S lam (tp s.S lam a (M γ) (N γ)) (M β) = tp s.S lam a (M β) (N β) := by
    intro β hβ γ hγ hβγ
    have hK : (M β, N γ, a) ∈ s.S.K3 := ⟨(hbs β hβ).1.1, (hbs γ hγ).2.1.1,
      hS.trans (hMle β hβ γ hγ hβγ) (Frame.K3bs_K3 hc (hbs γ hγ)).2.2.1, (hbs γ hγ).2.2.1.1⟩
    rw [res_tp hS (hMle β hβ γ hγ hβγ), ← tp_eq_of_le hS hK (hNle β hβ γ hγ hβγ)
      (Frame.K3bs_K3 hc (hbs β hβ)).2.2.1 (hbs β hβ).2.2.1.1]
  intro α hα
  have h0 : (0 : Ordinal.{u}) < δ := lt_of_le_of_lt zero_le hα
  refine ⟨hbs 0 h0, hbs α hα, hMle 0 h0 α hα zero_le, hNle 0 h0 α hα zero_le, rfl, ?_⟩
  show s.NotFork lam (M 0) (M α) (tp s.S lam a (M α) (N α))
  induction α using Ordinal.lt_wf.induction with
  | ind α ih =>
  rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0' | ⟨γ, hγ⟩ | hlim
  · subst h0'; exact Frame.notFork_self hc (hbs 0 h0).1 (hbs 0 h0).2.2.2
  · rw [Order.succ_eq_add_one] at hγ
    subst hγ
    have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
    have hγδ : γ < δ := lt_trans hγ1 hα
    have hIH := ih γ hγ1 hγδ
    refine Frame.notFork_trans hc (hbs 0 h0).1 (hbs (γ + 1) hα).1 (hMle 0 h0 γ hγδ zero_le)
      (hMle γ hγδ (γ + 1) hα hγ1.le) (hbs (γ + 1) hα).2.2.2 (hstep γ hγδ).2.2.2.2.2 ?_
    rw [hres γ hγδ (γ + 1) hα hγ1.le]; exact hIH
  · have hαlt : α < (Order.succ lam).ord := lt_of_lt_of_le hα hδ
    have := hcont3 α hlim hαlt M ⟨fun β hβ γ hγ h => hMinc β (lt_of_le_of_lt hβ hα) γ
        (lt_of_le_of_lt hγ hα) h, fun β hβ hl => hMcont β (lt_of_le_of_lt hβ hα) hl,
        fun β hβ => (hbs β (lt_of_le_of_lt hβ hα)).1⟩
      (tp s.S lam a (M α) (N α)) ⟨N α, a, Frame.K3bs_K3 hc (hbs α hα), rfl⟩ (fun γ hγ => by
        rw [hres γ (lt_trans hγ hα) α hα hγ.le]; exact ih γ hγ (lt_trans hγ hα))
    exact this.2

/-- AUX: not in paper. Prop 3.1.6(c) in the form used: the union of a `≼_bs`-increasing
continuous chain of length `δ < λ⁺` (`δ` limit) is a basic triple `≼_bs`-above the first one. -/
theorem Frame.bs_union {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    (hcont3 : s.Ax3g lam) {δ : Ordinal.{u}} (hlim : Order.IsSuccLimit δ)
    (hδ : δ < (Order.succ lam).ord) {M N : Ordinal.{u} → Model U L} {a : U}
    (h : s.BsIncCont lam M N a δ) :
    ∃ Mu Nu, IsUnionOf M (Iio δ) Mu ∧ IsUnionOf N (Iio δ) Nu ∧ (Mu, Nu, a) ∈ s.K3bs lam ∧
      s.leBs lam (M 0, N 0, a) (Mu, Nu, a) ∧ (∀ β < δ, s.S.le (M β) Mu ∧ s.S.le (N β) Nu) := by
  have hS : IsAEC s.S := hc.ax0a
  have hch := Frame.bs_chain hU hc hcont3 hδ.le h
  obtain ⟨hstep, hMinc, hMcont, hNinc, hNcont⟩ := h
  have hbs : ∀ α < δ, (M α, N α, a) ∈ s.K3bs lam := fun α hα => (hstep α hα).1
  have h0 : (0 : Ordinal.{u}) < δ := hlim.bot_lt
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (hbs 0 h0).1
  have hδc : δ.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hδ)
  obtain ⟨Mu, hMuU, -, -⟩ := hS.union δ hlim _ hMinc hMcont
  obtain ⟨Nu, hNuU, -, -⟩ := hS.union δ hlim _ hNinc hNcont
  obtain ⟨hMuK, hleM⟩ := hS.le_union hlim hMinc hMcont hMuU
  obtain ⟨hNuK, hleN⟩ := hS.le_union hlim hNinc hNcont hNuU
  have hcard : ∀ (X : Model U L) (F : Ordinal.{u} → Model U L),
      IsUnionOf F (Iio δ) X → (∀ β < δ, F β ∈ s.S.Kc lam) → X ∈ s.S.K →
      (∀ β < δ, s.S.le (F β) X) → X ∈ s.S.Kc lam := fun X F hXU hF hXK hle =>
    ⟨hXK, le_antisymm (by
      change #X.carrier ≤ lam; rw [hXU.1]
      exact card_biUnion_le hinf hδc fun β hβ => le_of_eq (hF β hβ).2) (by
      rw [← (hF 0 h0).2]; exact Model.card_le_of_sub (hS.sub (hle 0 h0)))⟩
  have hMuc := hcard Mu M hMuU (fun β hβ => (hbs β hβ).1) hMuK hleM
  have hNuc := hcard Nu N hNuU (fun β hβ => (hbs β hβ).2.1) hNuK hleN
  have hMN : s.S.le Mu Nu := hS.smooth δ hlim _ Nu hMinc hMcont
    (fun β hβ => hS.trans (Frame.K3bs_K3 hc (hbs β hβ)).2.2.1 (hleN β hβ)) Mu hMuU hMuK
  have haN : a ∈ Nu.carrier := hS.sub (hleN 0 h0) (hbs 0 h0).2.2.1.1
  obtain ⟨hext, hextc⟩ := IsAEC.extend_union hMinc hMcont hMuU hleM
  set M' : Ordinal.{u} → Model U L := fun β => if β < δ then M β else Mu with hM'
  have hM'l : ∀ β < δ, M' β = M β := fun β hβ => if_pos hβ
  have hM'δ : M' δ = Mu := if_neg (lt_irrefl _)
  have hK3 : (Mu, Nu, a) ∈ s.S.K3 := ⟨hMuK, hNuK, hMN, haN⟩
  have hc3 := hcont3 δ hlim hδ M' ⟨hext, hextc, fun β hβ => by
      rcases (show β ≤ δ from hβ).lt_or_eq with h' | h'
      · rw [hM'l β h']; exact (hbs β h').1
      · rw [h', hM'δ]; exact hMuc⟩
    (tp s.S lam a (M' δ) Nu) ⟨Nu, a, by rw [hM'δ]; exact hK3, rfl⟩ (fun γ hγ => by
      rw [hM'l γ hγ, hM'δ, hM'l 0 h0, res_tp hS (hleM γ hγ),
        ← tp_eq_of_le hS (show (M γ, Nu, a) ∈ s.S.K3 from
          ⟨(hbs γ hγ).1.1, hNuK, hS.trans (hleM γ hγ) hMN, haN⟩) (hleN γ hγ)
          (Frame.K3bs_K3 hc (hbs γ hγ)).2.2.1 (hbs γ hγ).2.2.1.1]
      exact (hch γ hγ).2.2.2.2.2)
  rw [hM'δ, hM'l 0 h0] at hc3
  obtain ⟨hpbs, hnf⟩ := hc3
  have hn := Frame.nf_of_notFork hU hc hnf hNuc
  have haMu : a ∉ Mu.carrier := ((hc.ax3a.1 _ _ _ _ hn).2.2.2.1).2
  have hu : (Mu, Nu, a) ∈ s.K3bs lam := ⟨hMuc, hNuc, ⟨haN, haMu⟩, hpbs⟩
  exact ⟨Mu, Nu, hMuU, hNuU, hu, ⟨hbs 0 h0, hu, hleM 0 h0, hleN 0 h0, rfl, hnf⟩,
    fun β hβ => ⟨hleM β hβ, hleN β hβ⟩⟩

/-- AUX: not in paper. `≼_bs` is transitive (part of Prop 3.1.6(b)). -/
theorem Frame.leBs_trans {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {t t' t'' : Tri U L} (h : s.leBs lam t t') (h' : s.leBs lam t' t'') : s.leBs lam t t'' := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨M, N, a⟩ := t
  obtain ⟨M', N', a'⟩ := t'
  obtain ⟨M'', N'', a''⟩ := t''
  obtain ⟨ht, ht', hMM', hNN', ha', hnf⟩ := h
  obtain ⟨-, ht'', hM'M'', hN'N'', ha'', hnf'⟩ := h'
  simp only at ha' ha'' hMM' hNN' hM'M'' hN'N'' hnf hnf' ⊢
  subst ha' ha''
  refine ⟨ht, ht'', hS.trans hMM' hM'M'', hS.trans hNN' hN'N'', rfl, ?_⟩
  refine Frame.notFork_trans hc ht.1 ht''.1 hMM' hM'M'' ht''.2.2.2 hnf' ?_
  have hK : (M', N'', a'') ∈ s.S.K3 := ⟨ht'.1.1, ht''.2.1.1,
    hS.trans hM'M'' (Frame.K3bs_K3 hc ht'').2.2.1, ht''.2.2.1.1⟩
  show s.NotFork lam M M' (res s.S lam (tp s.S lam a'' M'' N'') M')
  rw [res_tp hS hM'M'', ← tp_eq_of_le hS hK hN'N'' (Frame.K3bs_K3 hc ht').2.2.1 ht'.2.2.1.1]
  exact hnf

/-- Prop 3.3.4: the reduced triples are dense with respect to `≼_bs`. -/
theorem prop_3_3_4 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam) :
    ∀ t ∈ s.K3bs lam, ∃ Ms Ns : Model U L, (Ms, Ns, t.2.2) ∈ s.K3r lam ∧
      s.leBs lam t (Ms, Ns, t.2.2) := by
  classical
  obtain ⟨hc, hcont3, -⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  rintro ⟨M, N, a⟩ ht
  simp only
  by_contra H
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc ht.1
  set κ := (Order.succ lam).ord with hκ
  have hκlim : Order.IsSuccLimit κ := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have : Nonempty (Model U L × Model U L) := ⟨(M, N)⟩
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L × Model U L) → Prop := fun α c =>
      α < κ →
      (∀ β ≤ α, s.leBs lam (M, N, a) ((c β).1, (c β).2, a)) ∧ c 0 = (M, N) ∧
      IsIncreasing s.S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
      IsIncreasing s.S.le (fun β => (c β).2) (Iic α) ∧ IsContinuous (fun β => (c β).2) (Iic α) ∧
      (∀ β, β + 1 ≤ α → s.leBs lam ((c β).1, (c β).2, a) ((c (β + 1)).1, (c (β + 1)).2, a) ∧
        ∃ x ∈ (c (β + 1)).1.carrier \ (c β).1.carrier, x ∈ (c β).2.carrier)
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L × Model U L), (∀ β ≤ α, c β = c' β) →
      Inv α c → Inv α c' := by
    intro α c c' h hi hα
    obtain ⟨h1, h2, h4, h5, h6, h7, h8⟩ := hi hα
    have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
    refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e 0 zero_le]; exact h2,
      fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_,
      fun β hβ => ?_⟩
    · simp only [e β hβ, e γ hγ]; exact h4 β hβ γ hγ hl
    · simp only [e γ hγ]; rw [h5 γ hγ hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγ)]
    · simp only [e β hβ, e γ hγ]; exact h6 β hβ γ hγ hl
    · simp only [e γ hγ]; rw [h7 γ hγ hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hγ)]
    · have hβ' : β ≤ α := (Order.lt_add_one_iff.2 le_rfl).le.trans hβ
      rw [e β hβ', e (β + 1) hβ]; exact h8 β hβ
  obtain ⟨c, hcI⟩ := transfinite_construction κ Inv hloc (by
    intro α hα c hprev
    rcases hα.lt_or_eq with hακ | hακ
    swap
    · exact ⟨(M, N), fun h => absurd h (by rw [hακ]; exact lt_irrefl _)⟩
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨γ, hγ⟩ | hlim
    · subst h0
      have hc0 : (fun β => if β < (0 : Ordinal.{u}) then c β else (M, N)) =
          fun _ => (M, N) := funext fun β => if_neg (not_lt.2 zero_le)
      refine ⟨(M, N), ?_⟩
      rw [hc0]
      intro _
      have hz : ∀ β ≤ (0 : Ordinal.{u}), β = 0 := fun β hβ => le_antisymm hβ zero_le
      refine ⟨fun β _ => ⟨ht, ht, hS.refl ht.1.1, hS.refl ht.2.1.1, rfl,
          Frame.notFork_self hc ht.1 ht.2.2.2⟩, rfl, fun β hβ γ hγ hl => ?_,
        fun γ hγ hl => ?_, fun β hβ γ hγ hl => ?_, fun γ hγ hl => ?_, fun β hβ => ?_⟩
      · exact absurd (hz γ hγ ▸ hl) (not_lt.2 zero_le)
      · exact absurd (hz γ hγ ▸ hl) Order.not_isSuccLimit_bot
