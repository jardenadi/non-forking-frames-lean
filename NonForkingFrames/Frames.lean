/-- AUX: not in paper. A witness of `≺⁺` from explicit data (the content of `Frame.run_wit`). -/
theorem Frame.wit_of_data [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) (hinf : ℵ₀ ≤ lam)
    {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}} {en : Model U L → Ordinal.{u} → Set (Tri U L)}
    (hpr : ∀ γ < (Order.succ lam).ord, ∀ i < (Order.succ lam).ord,
      ∃ ε < (Order.succ lam).ord, pr ε = (γ, i))
    (hen : ∀ M ∈ s.S.Kc lam, ∀ p ∈ s.Sbs M, ∃ i < (Order.succ lam).ord, en M i = p)
    {A B C : Ordinal.{u} → Model U L} {M₀ M₁ : Model U L}
    (hA : IsIncCont s.S A (Iio (Order.succ lam).ord) (s.S.Kc lam))
    (hB : IsIncCont s.S B (Iio (Order.succ lam).ord) (s.S.Kc lam))
    (hstr : ∀ α < (Order.succ lam).ord, ∀ β < (Order.succ lam).ord, α < β → s.S.lt (B α) (B β))
    (hAB : ∀ α < (Order.succ lam).ord, s.S.le (A α) (B α))
    (hCK : ∀ α < (Order.succ lam).ord, C α ∈ s.S.Kc lam ∧ s.S.le (B α) (C α))
    (hNF : ∀ α < (Order.succ lam).ord, s.NF lam (A α) (C α) (A (α + 1)) (B (α + 1)))
    (hreal : ∀ α < (Order.succ lam).ord, ∀ ε < α,
      s.plusTask lam pr en α (fun i => B i) ε ∈ s.Sbs (B α) →
      Realizes s.S lam (C α) (B α) (s.plusTask lam pr en α (fun i => B i) ε))
    (hM₀ : IsUnionOf A (Iio (Order.succ lam).ord) M₀)
    (hM₁ : IsUnionOf B (Iio (Order.succ lam).ord) M₁) :
    s.PlusWit lam M₀ M₁ A B C (Iio (Order.succ lam).ord) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨Ai, Ac, AK⟩ := hA
  obtain ⟨Bi, Bc, BK⟩ := hB
  have hstep : ∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)) := by
    intro α hα
    have n := hNF α hα
    exact Frame.nf_symm hU hs (Frame.nf_mid hU hs (Frame.nf_symm hU hs n) (BK α hα) (hAB α hα)
      (hCK α hα).2)
  have hsucc : ∀ {a b : Ordinal.{u}}, a < b → a + 1 ≤ b := fun h => Order.add_one_le_of_lt h
  refine ⟨⟨Ai, Ac, AK⟩, ⟨Bi, Bc, BK⟩, ?_, fun α hα => (hCK α hα).1,
    ⟨subset_rfl, fun α hα => ⟨α + 1, hκl.add_one_lt hα, Order.lt_add_one_iff.2 le_rfl⟩,
      fun γ hγ _ _ => hγ⟩, hM₀, hM₁, fun α hα => ⟨hAB α hα, (hCK α hα).2⟩, ?_, ?_⟩
  · intro a ha b hb hab
    obtain ⟨-, -, -, -, -, l13, -, -, -⟩ := id (hNF a ha)
    have hb2 := (hCK b hb).2
    rcases (hsucc hab).lt_or_eq with h' | h'
    · exact hS.trans (hS.trans l13 (Bi _ (hκl.add_one_lt ha) b hb h')) hb2
    · have eb : B (a + 1) = B b := congrArg B h'
      rw [eb] at l13; exact hS.trans l13 hb2
  · intro α hα β hβ hab
    have n := hNF α hα
    rcases (hsucc hab).lt_or_eq with h' | h'
    · exact Frame.nf_trans2 hU hs n (Frame.nf_interval hU hs Ai Ac Bi Bc hstep h' hβ)
    · have ea : A (α + 1) = A β := congrArg A h'
      have eb : B (α + 1) = B β := congrArg B h'
      rw [ea, eb] at n; exact n
  · intro α hα p hp
    obtain ⟨i, hi, rfl⟩ := hen _ (BK α hα) p hp
    obtain ⟨ε, hε, hpε⟩ := hpr α hα i hi
    have hm : max ε α < (Order.succ lam).ord := max_lt hε hα
    refine ⟨max ε α + 1, hκl.add_one_lt hm, fun β hβ hle => ?_⟩
    have hlt : max ε α < β := Order.add_one_le_iff.1 hle
    have hεβ : ε < β := (le_max_left _ _).trans_lt hlt
    have hαβ : α < β := (le_max_right _ _).trans_lt hlt
    obtain ⟨q, hq, hnf, hres⟩ := hc.ax3f _ (BK α hα) _ (BK β hβ) _ hp (hstr α hα β hβ hαβ)
    have sp := Frame.plusTask_spec (s := s) (lam := lam) (pr := pr) (en := en) (α := β) (α' := α)
      (i := i) (ε := ε) (b := fun i => B i) (by rw [hpε]) (by rw [hpε]) hαβ.le ⟨q, hq, hnf, hres⟩
    exact ⟨_, sp.1, sp.2, hreal β hβ ε hεβ sp.1⟩

/-- Prop 8.1.6: if `M₁* ≼^⊗ M₂*`, there is an increasing continuous `⟨M_ε : ε ≤ λ⁺+1⟩` in
`K^sat` with (a) `M_{λ⁺} = M₁*`, `M_{λ⁺+1} = M₂*`, (b) `M_ε ≺⁺ M_{ε+1}`, (c) `M_ε ≼^NF M₂*`
(`ε < λ⁺`). -/
theorem prop_8_1_6 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_8_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, as in Prop 8.1.5.
    (hinf : ℵ₀ ≤ lam)
