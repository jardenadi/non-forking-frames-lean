  refine ⟨b, hb, ?_⟩
  have e1 := congrArg (fun p => res s.S lam p N') hbt
  simp only [res_tp hS lN'M] at e1
  rw [e1, ← e]
  have hfix : ∀ x ∈ N'.carrier, (ρ ∘ id) x = x := fun x hx => by
    have hxM := hsub hx
    have hkx : k x = x := kid x hx
    have := ki1 x hxM
    rw [hkx] at this
    have hxQ : x ∈ Q.carrier := by
      have := iQ.mapsTo hxM
      rwa [hkx] at this
    simp only [Function.comp, id, hid x hxQ, this]
  have hem : IsEmb s.S (ρ ∘ id) W₁ W' := (IsEmb.of_le hS l5).comp_iso hS hρ
  exact (tp_emb hS (lam := lam) ⟨kN'.1, kW₁.1, l1, ha⟩ (hS.trans lN'M lMW) hem hfix).symm

/-- AUX: not in paper. A union over `Y` of sets of size `≤ λ`, with `|Y| ≤ λ`. -/
theorem card_iUnion_small {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {ι : Type u} (hι : #ι ≤ lam)
    (f : ι → Set U) (hf : ∀ i, #(f i) ≤ lam) : #(⋃ i, f i : Set U) ≤ lam := by
  refine Cardinal.mk_iUnion_le_sum_mk.trans ((Cardinal.sum_le_sum _ (fun _ => lam) hf).trans ?_)
  simpa using Cardinal.mul_le_of_le hinf hι le_rfl

/-- AUX: not in paper. An `ω`-chain in `K_λ` below `T`, extended to an ordinal-indexed chain of length
`ω + 1` ending in its union `V` and then `T`. -/
theorem IsAEC.nat_chain {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {X : ℕ → Model U L} {T : Model U L} (kX : ∀ n, X n ∈ S.Kc lam) (hst : ∀ n, S.le (X n) (X (n + 1)))
    (lT : ∀ n, S.le (X n) T) :
    ∃ (V : Model U L) (Y : Ordinal.{u} → Model U L), V ∈ S.Kc lam ∧ V.carrier = (⋃ n, (X n).carrier) ∧
      (∀ n, S.le (X n) V) ∧ S.le V T ∧ (∀ n : ℕ, Y n = X n) ∧ Y Ordinal.omega0 = V ∧
      Y (Ordinal.omega0 + 1) = T ∧ IsIncreasing S.le Y (Iic Ordinal.omega0) ∧
      IsContinuous Y (Iic (Ordinal.omega0 + 1)) := by
  classical
  have hmono : ∀ m n, m ≤ n → S.le (X m) (X n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hS.refl (kX m).1
    | succ n _ ih => exact hS.trans ih (hst n)
  let F : Ordinal.{u} → Model U L := fun ε =>
    if h : ε < Ordinal.omega0 then X (Classical.choose (Ordinal.lt_omega0.1 h)) else X 0
  have hF : ∀ n : ℕ, F n = X n := fun n => by
    have h : (n : Ordinal.{u}) < Ordinal.omega0 := Ordinal.lt_omega0.2 ⟨n, rfl⟩
    simp only [F, dif_pos h]
    congr 1
    exact (Nat.cast_inj.1 (Classical.choose_spec (Ordinal.lt_omega0.1 h))).symm
  have hinc : IsIncreasing S.le F (Iio Ordinal.omega0) := by
    intro a ha b hb h
    obtain ⟨m, rfl⟩ := Ordinal.lt_omega0.1 ha
    obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hb
    rw [hF, hF]; exact hmono m n (Nat.cast_lt.1 h).le
  have hcont : IsContinuous F (Iio Ordinal.omega0) := by
    intro b hb hl
    obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hb
    cases n with
    | zero => simp only [Nat.cast_zero] at hl; exact absurd hl Order.not_isSuccLimit_bot
    | succ n =>
      rw [Nat.cast_succ, ← Order.succ_eq_add_one] at hl
      exact absurd hl.isMax (not_isMax _)
  have hω := Ordinal.isSuccLimit_omega0
  obtain ⟨V, hV, -, -⟩ := hS.union Ordinal.omega0 hω _ hinc hcont
  obtain ⟨hVK, hle⟩ := hS.le_union hω hinc hcont hV
  have hcar : V.carrier = (⋃ n, (X n).carrier) := by
    rw [hV.1]
    ext x
    simp only [Set.mem_iUnion, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hξ
      exact ⟨n, by rw [← hF]; exact hx⟩
    · rintro ⟨n, hx⟩
      exact ⟨n, Ordinal.lt_omega0.2 ⟨n, rfl⟩, by rw [hF]; exact hx⟩
  have hXV : ∀ n, S.le (X n) V := fun n => by
    have := hle n (Ordinal.lt_omega0.2 ⟨n, rfl⟩); rwa [hF] at this
  have hVT : S.le V T := hS.smooth _ hω F T hinc hcont (fun α hα => by
    obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hα
    rw [hF]; exact lT n) V hV hVK
  have kV : V ∈ S.Kc lam := by
    refine ⟨hVK, le_antisymm ?_ ?_⟩
    · change #V.carrier ≤ lam
      rw [hcar]
      have e : (⋃ n, (X n).carrier) = ⋃ i : ULift.{u} ℕ, (X i.down).carrier := by
        ext x; simp [ULift.exists]
      rw [e]
      exact card_iUnion_small hinf (by simpa using hinf) _ fun i => le_of_eq (kX _).2
    · rw [← (kX 0).2]; exact Model.card_le_of_sub (hS.sub (hXV 0))
  let Y : Ordinal.{u} → Model U L := fun β =>
    if β < Ordinal.omega0 then F β else if β = Ordinal.omega0 then V else T
  have Y1 : ∀ β < Ordinal.omega0, Y β = F β := fun β h => if_pos h
  have Y2 : Y Ordinal.omega0 = V := by simp only [Y, lt_irrefl, if_false, if_true]
  have Y3 : Y (Ordinal.omega0 + 1) = T := by
    have h1 : ¬ (Ordinal.omega0 + 1 : Ordinal.{u}) < Ordinal.omega0 :=
      not_lt.2 (Order.lt_add_one_iff.2 le_rfl).le
    have h2 : (Ordinal.omega0 + 1 : Ordinal.{u}) ≠ Ordinal.omega0 := (Order.lt_add_one_iff.2 le_rfl).ne'
    simp only [Y, h1, h2, if_false]
  refine ⟨V, Y, kV, hcar, hXV, hVT, fun n => ?_, Y2, Y3, fun a ha b hb h => ?_, fun b hb hl => ?_⟩
  · rw [Y1 _ (Ordinal.lt_omega0.2 ⟨n, rfl⟩), hF]
  · have haω : a < Ordinal.omega0 := lt_of_lt_of_le h hb
    rw [Y1 a haω]
    rcases (show b ≤ Ordinal.omega0 from hb).lt_or_eq with h' | h'
    · rw [Y1 b h']; exact hinc a haω b h' h
    · rw [h', Y2]; exact hle a haω
  · have hbω : b ≤ Ordinal.omega0 := by
      rcases (show b ≤ Ordinal.omega0 + 1 from hb).lt_or_eq with h | h
      · exact Order.lt_add_one_iff.1 h
      · rw [h] at hl
        exact absurd (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl)) (lt_irrefl _)
    rcases hbω.lt_or_eq with h | h
    · obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 h
      cases n with
      | zero => simp only [Nat.cast_zero] at hl; exact absurd hl Order.not_isSuccLimit_bot
      | succ n =>
        rw [Nat.cast_succ, ← Order.succ_eq_add_one] at hl
        exact absurd hl.isMax (not_isMax _)
    · show (Y b).carrier = ⋃ a ∈ Iio b, (Y a).carrier
      rw [h, Y2, hV.1]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [Y1 ξ hξ]

-- PROOF-STAGE CHANGE: hypothesis `s.WeakLC lam` replaced by local character `s.Ax3c lam`, and `ℵ₀ ≤ λ` added.
-- Reason: the paper's proof applies local character to `⟨M_n⟩⌢⟨M_ω⟩⌢⟨N_ω⟩`, which for weak local character
-- needs `M_ω ≺* N_ω`, not provided. The proof also adds `N_n ∩ M ⊆ M_{n+1}` (so that `c ∉ M`).
-- See docs/METHOD.md. (The theorem was moved here because the proof uses later lemmas.)
/-- Thm 2.6.8(1), density: if `s` satisfies local character (original: "weak local character"),
`M ≺ N`, `M ∈ K_{≥λ}`, then there is `a ∈ N - M` with `tp(a, M, N) ∈ S^bs_{≥λ}(M)`. (Standing hypothesis
of 2.6.8: `s` is a semi-good `λ`-frame except local character.) -/
theorem thm_2_6_8_1 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.IsSemiGoodExceptLC lam) (hlc : s.Ax3c lam) (hinf : ℵ₀ ≤ lam) (M N : Model U L)
    (hMN : s.S.lt M N) (hM : M ∈ s.S.KGe lam) :
    ∃ a ∈ N.carrier \ M.carrier, tp s.S lam a M N ∈ s.SbsGe lam M := by
  classical
  have hc : s.Core lam := hs.1
  have hS : IsAEC s.S := hc.ax0a
  have hL : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hc.ax0b
  have memN : N ∈ s.S.K := hS.mem_right hMN.1
  obtain ⟨a₀, ha₀, ha₀M⟩ := hS.exists_diff_of_lt hMN
  rcases hM.2.lt_or_eq with hgt | heq
  swap
  · have kM : M ∈ s.S.Kc lam := ⟨hM.1, heq.symm⟩
    obtain ⟨W, hW, hsub, hWN⟩ := hS.exists_small hc.ax0b hinf kM memN (hS.sub hMN.1) ha₀
    have lMW : s.S.le M W := hS.le_of_sub hMN.1 hWN (Set.subset_union_left.trans hsub)
    have hltW : s.S.lt M W := ⟨lMW, fun e => ha₀M (e ▸ hsub (Or.inr rfl))⟩
    obtain ⟨c, hc1, hb⟩ := hc.ax2c M kM W hW hltW
    refine ⟨c, ⟨hS.sub hWN hc1.1, hc1.2⟩, Or.inl ⟨heq.symm, ?_⟩⟩
    rw [← tp_eq_of_le hS ⟨kM.1, memN, hMN.1, hS.sub hWN hc1.1⟩ hWN lMW hc1.1]
    exact hb
  let Good : Model U L → U → Prop := fun X c => ∀ W ∈ s.S.Kc lam, X.carrier ⊆ W.carrier → s.S.le W M →
    ∀ W' ∈ s.S.Kc lam, W.carrier ∪ {c} ⊆ W'.carrier → s.S.le W' N → s.nf X W c W'
  let St : Model U L × Model U L → Prop := fun p => p.1 ∈ s.S.Kc lam ∧ p.2 ∈ s.S.Kc lam ∧
    s.S.le p.1 M ∧ s.S.le p.2 N ∧ p.1.carrier ⊆ p.2.carrier
  have kOf : ∀ {T : Model U L} {A : Set U} {X : Model U L}, T ∈ s.S.K → A ⊆ T.carrier → T.card ≤ lam + #A →
      #A ≤ lam → X ∈ s.S.Kc lam → X.carrier ⊆ A → T ∈ s.S.Kc lam := by
    intro T A X hT hA hcd hAc kX hXA
    refine ⟨hT, le_antisymm (hcd.trans (Cardinal.add_le_of_le hinf le_rfl hAc)) ?_⟩
    rw [← kX.2]; exact Model.card_le_of_sub (hXA.trans hA)
  have step : ∀ p : {p // St p}, ∃ q : {p // St p}, s.S.le p.1.1 q.1.1 ∧ s.S.le p.1.2 q.1.2 ∧
      p.1.2.carrier ∩ M.carrier ⊆ q.1.1.carrier ∧
      ∀ c ∈ p.1.2.carrier, Good p.1.1 c ∨ ∃ W ∈ s.S.Kc lam, ∃ W' ∈ s.S.Kc lam, p.1.1.carrier ⊆ W.carrier ∧
        s.S.le W M ∧ W.carrier ∪ {c} ⊆ W'.carrier ∧ s.S.le W' N ∧ ¬ s.nf p.1.1 W c W' ∧
        W.carrier ⊆ q.1.1.carrier ∧ W'.carrier ⊆ q.1.2.carrier := by
    rintro ⟨⟨X, Y⟩, kX, kY, lXM, lYN, hXY⟩
    have hw : ∀ c : Y.carrier, ∃ W ∈ s.S.Kc lam, ∃ W' ∈ s.S.Kc lam, s.S.le W M ∧ s.S.le W' N ∧
        (Good X c.1 ∨ X.carrier ⊆ W.carrier ∧ W.carrier ∪ {c.1} ⊆ W'.carrier ∧ ¬ s.nf X W c.1 W') := by
      intro c
      by_cases hg : Good X c.1
      · exact ⟨X, kX, Y, kY, lXM, lYN, Or.inl hg⟩
      · simp only [Good] at hg
        push Not at hg
        obtain ⟨W, hW, h1, h2, W', hW', h3, h4, h5⟩ := hg
        exact ⟨W, hW, W', hW', h2, h4, Or.inr ⟨h1, h3, h5⟩⟩
    choose W kW W' kW' lW lW' hg using hw
    have hYc : #Y.carrier ≤ lam := le_of_eq kY.2
    have hXc : #X.carrier ≤ lam := le_of_eq kX.2
    let A : Set U := X.carrier ∪ ((Y.carrier ∩ M.carrier) ∪ ⋃ c, (W c).carrier)
    have hAc : #A ≤ lam := (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf hXc
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf
        ((Cardinal.mk_le_mk_of_subset Set.inter_subset_left).trans hYc)
        (card_iUnion_small hinf hYc _ fun c => le_of_eq (kW c).2))))
    have hAM : A ⊆ M.carrier := Set.union_subset (hS.sub lXM) (Set.union_subset Set.inter_subset_right
      (Set.iUnion_subset fun c => hS.sub (lW c)))
    obtain ⟨X', hX', hAX', lX', hcd⟩ := hL M hM.1 A hAM
    have kX' : X' ∈ s.S.Kc lam := kOf hX' hAX' hcd hAc kX Set.subset_union_left
    let B : Set U := Y.carrier ∪ (X'.carrier ∪ ⋃ c, (W' c).carrier)
    have hBc : #B ≤ lam := (Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf hYc
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf (le_of_eq kX'.2)
        (card_iUnion_small hinf hYc _ fun c => le_of_eq (kW' c).2))))
    have hBN : B ⊆ N.carrier := Set.union_subset (hS.sub lYN) (Set.union_subset
      ((hS.sub lX').trans (hS.sub hMN.1)) (Set.iUnion_subset fun c => hS.sub (lW' c)))
    obtain ⟨Y', hY', hBY', lY', hcd'⟩ := hL N memN B hBN
    have kY' : Y' ∈ s.S.Kc lam := kOf hY' hBY' hcd' hBc kY Set.subset_union_left
    have hX'Y' : X'.carrier ⊆ Y'.carrier := fun x hx => hBY' (Or.inr (Or.inl hx))
    refine ⟨⟨(X', Y'), kX', kY', lX', lY', hX'Y'⟩,
      hS.le_of_sub lXM lX' (Set.subset_union_left.trans hAX'),
      hS.le_of_sub lYN lY' (Set.subset_union_left.trans hBY'),
      fun x hx => hAX' (Or.inr (Or.inl hx)), fun c hc' => ?_⟩
    rcases hg ⟨c, hc'⟩ with h | ⟨h1, h2, h3⟩
    · exact Or.inl h
    · exact Or.inr ⟨W ⟨c, hc'⟩, kW _, W' ⟨c, hc'⟩, kW' _, h1, lW _, h2, lW' _, h3,
        fun x hx => hAX' (Or.inr (Or.inr (Set.mem_iUnion.2 ⟨⟨c, hc'⟩, hx⟩))),
        fun x hx => hBY' (Or.inr (Or.inr (Set.mem_iUnion.2 ⟨⟨c, hc'⟩, hx⟩)))⟩
  choose nxt h1 h2 h3 h4 using step
  have hlM : lam ≤ #M.carrier := hM.2
  obtain ⟨A₀, hA₀, hA₀c⟩ := Cardinal.le_mk_iff_exists_subset.1 hlM
  obtain ⟨X₀, hX₀, hsub₀, lX₀, hcd₀⟩ := hL M hM.1 A₀ hA₀
  have kX₀ : X₀ ∈ s.S.Kc lam := by
    refine ⟨hX₀, le_antisymm (hcd₀.trans (Cardinal.add_le_of_le hinf le_rfl hA₀c.le)) ?_⟩
    rw [← hA₀c]; exact Cardinal.mk_le_mk_of_subset hsub₀
  obtain ⟨Y₀, kY₀, hsubY, lY₀⟩ := hS.exists_small hc.ax0b hinf kX₀ memN
    ((hS.sub lX₀).trans (hS.sub hMN.1)) ha₀
  let z : ℕ → {p // St p} := fun n => Nat.rec ⟨(X₀, Y₀), kX₀, kY₀, lX₀, lY₀,
    Set.subset_union_left.trans hsubY⟩ (fun _ p => nxt p) n
  have zs : ∀ n, z (n + 1) = nxt (z n) := fun n => rfl
  let X : ℕ → Model U L := fun n => (z n).1.1
  let Y : ℕ → Model U L := fun n => (z n).1.2
  have kX : ∀ n, X n ∈ s.S.Kc lam := fun n => (z n).2.1
  have kY : ∀ n, Y n ∈ s.S.Kc lam := fun n => (z n).2.2.1
  have lXs : ∀ n, s.S.le (X n) (X (n + 1)) := fun n => by
    show s.S.le (z n).1.1 (z (n + 1)).1.1
    rw [zs]; exact h1 (z n)
  have lYs : ∀ n, s.S.le (Y n) (Y (n + 1)) := fun n => by
    show s.S.le (z n).1.2 (z (n + 1)).1.2
    rw [zs]; exact h2 (z n)
  have lXM : ∀ n, s.S.le (X n) M := fun n => (z n).2.2.2.1
  have lYN : ∀ n, s.S.le (Y n) N := fun n => (z n).2.2.2.2.1
  have hXY : ∀ n, (X n).carrier ⊆ (Y n).carrier := fun n => (z n).2.2.2.2.2
  have hXmono : ∀ m n, m ≤ n → s.S.le (X m) (X n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hS.refl (kX m).1
    | succ n _ ih => exact hS.trans ih (lXs n)
  have hYmono : ∀ m n, m ≤ n → s.S.le (Y m) (Y n) := fun m n h => by
    induction n, h using Nat.le_induction with
    | base => exact hS.refl (kY m).1
    | succ n _ ih => exact hS.trans ih (lYs n)
  obtain ⟨Xω, -, kXω, cXω, lXω, lXωM, -, -, -, -, -⟩ := hS.nat_chain hinf kX lXs lXM
  obtain ⟨Yω, -, kYω, cYω, lYω, lYωN, -, -, -, -, -⟩ := hS.nat_chain hinf kY lYs lYN
  have subXY : Xω.carrier ⊆ Yω.carrier := by
    rw [cXω, cYω]
    exact Set.iUnion_mono hXY
  have lXY : s.S.le Xω Yω := hS.le_of_sub (hS.trans lXωM hMN.1) lYωN subXY
  have a₀Y : a₀ ∈ Yω.carrier := hS.sub (lYω 0) (hsubY (Or.inr rfl))
  have a₀X : a₀ ∉ Xω.carrier := fun h => ha₀M (hS.sub lXωM h)
  have hltXY : s.S.lt Xω Yω := ⟨lXY, fun e => a₀X (e ▸ a₀Y)⟩
  obtain ⟨c, hc1, hbs⟩ := hc.ax2c _ kXω _ kYω hltXY
  obtain ⟨V, Z, -, cV, lV, lVT, hZn, hZω, hZt, Zi, Zc⟩ := hS.nat_chain hinf kX lXs
    (fun n => hS.trans (lXω n) lXY)
  have eV : V = Xω := hS.po.2.2.1 _ _
    (hS.le_of_sub (hS.trans lXωM hMN.1 |> fun _ => lVT) lXY (by rw [cV, cXω]))
    (hS.le_of_sub lXY lVT (by rw [cV, cXω]))
  subst eV
  have hωκ : Ordinal.omega0 < (Order.succ lam).ord := by
    rw [Cardinal.lt_ord, Ordinal.card_omega0]
    exact lt_of_le_of_lt hinf (Order.lt_succ lam)
  have hZ : IsIncCont s.S Z (Iic (Ordinal.omega0 + 1)) (s.S.Kc lam) := by
    refine ⟨fun a ha b hb h => ?_, Zc, fun β hβ => ?_⟩
    · have haω : a ≤ Ordinal.omega0 := Order.lt_add_one_iff.1 (lt_of_lt_of_le h hb)
      rcases (show b ≤ Ordinal.omega0 + 1 from hb).lt_or_eq with h' | h'
      · exact Zi a (mem_Iic.2 haω) b (mem_Iic.2 (Order.lt_add_one_iff.1 h')) h
      · rw [h', hZt]
        rcases haω.lt_or_eq with h2' | h2'
        · exact hS.trans (Zi a (mem_Iic.2 haω) _ (mem_Iic.2 le_rfl) h2') (by rw [hZω]; exact lVT)
        · rw [h2', hZω]; exact lVT
    · rcases (show β ≤ Ordinal.omega0 + 1 from hβ).lt_or_eq with h | h
      · rcases (Order.lt_add_one_iff.1 h).lt_or_eq with h' | h'
        · obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 h'
          rw [hZn]; exact kX n
        · rw [h', hZω]; exact kXω
      · rw [h, hZt]; exact kYω
  obtain ⟨α, hα, hnf⟩ := hlc Ordinal.omega0 Ordinal.isSuccLimit_omega0 hωκ Z hZ c
    (by rw [hZω, hZt]; exact hbs)
  obtain ⟨n, rfl⟩ := Ordinal.lt_omega0.1 hα
  rw [hZn, hZω, hZt] at hnf
  obtain ⟨b, W₃, eq, hb⟩ := hnf
  have nfc : s.nf (X n) V c Yω := prop_2_1_2 lam hU s hc.ax0a hc.ax0b hc.ax1b hc.ax3a hc.ax3b _ _ _ _ _ _
    kYω hb eq
  have hcY : c ∈ ⋃ k, (Y k).carrier := cYω ▸ hc1.1
  obtain ⟨k, hk⟩ := Set.mem_iUnion.1 hcY
  set K := max n k with hK
  have hcK : c ∈ (Y K).carrier := hS.sub (hYmono k K (le_max_right _ _)) hk
  have nfK : s.nf (X K) V c Yω := Frame.nf_mono hS hc.ax3a hc.ax3b nfc (hXmono n K (le_max_left _ _))
    (lV K) (hS.refl kXω.1)
  have hcM : c ∉ M.carrier := fun hm => by
    have : c ∈ (X (K + 1)).carrier := by
      show c ∈ (z (K + 1)).1.1.carrier
      rw [zs]
      exact h3 (z K) ⟨hcK, hm⟩
    exact hc1.2 (hS.sub (lV (K + 1)) this)
  have hgood : Good (X K) c := by
    rcases h4 (z K) c hcK with g | ⟨W, hW, W', hW', hs1, l1, hs2, l2, hnot, hsub1, -⟩
    · exact g
    · exfalso
      have hsubW : W.carrier ⊆ V.carrier := fun x hx => by
        have : x ∈ (X (K + 1)).carrier := by
          show x ∈ (z (K + 1)).1.1.carrier
          rw [zs]; exact hsub1 hx
        exact hS.sub (lV (K + 1)) this
      exact hnot (hc.ax3b _ _ W V Yω N W' c (hS.refl (kX K).1) (hS.le_of_sub (lXM K) l1 hs1)
        (hS.le_of_sub l1 lXωM hsubW) lXY lYωN hs2 l2 hW' nfK)
  have hcN : c ∈ N.carrier := hS.sub lYωN hc1.1
  have hNge : lam ≤ N.card := hM.2.trans (Model.card_le_of_sub (hS.sub hMN.1))
  refine ⟨c, ⟨hcN, hcM⟩, Or.inr ⟨hgt, ⟨hM.1, hgt⟩, ⟨N, c, ⟨hM.1, memN, hMN.1, hcN⟩, rfl⟩, X K, kX K, lXM K, ?_⟩⟩
  refine ⟨⟨(kX K).1, (kX K).2.ge⟩, hM, lXM K, ⟨N, c, ⟨hM.1, memN, hMN.1, hcN⟩, rfl⟩, N, c,
    mem_tp_self _ _ _ _ _, ?_⟩
  exact ⟨(kX K).2.ge, hM.2, hNge, lXM K, hMN.1, ⟨hcN, hcM⟩, X K, kX K, hS.refl (kX K).1, hgood⟩

/-! ════════════════════════════════════════════════════════════════════════════
    PART 7 : SECTION 7  (≺⁺_{λ⁺} and saturated models)
    ════════════════════════════════════════════════════════════════════════════ -/

/-- Hypothesis 7.1.1 (= Hypothesis 6.1.1). -/
def Hyp_7_1_1 (s : Frame U L) (lam : Cardinal.{u}) : Prop := Hyp_6_1_1 s lam

namespace Frame

variable (s : Frame U L) (lam : Cardinal.{u})

/-- Def 7.1.2: `K^sat`, the class of saturated models in `λ⁺` over `λ`. -/
def Ksat : Set (Model U L) := {M | Saturated s.S lam M}

/-- `(K^sat, ≼^NF_{λ⁺} ↾ K^sat)`. -/
def satKSys : KSys U L :=
  ⟨s.Ksat lam, fun M N => M ∈ s.Ksat lam ∧ N ∈ s.Ksat lam ∧ s.leNF lam M N⟩

-- AGENT-CHOICE (reading): in (d), "realizes the non-forking extension of p" = the non-forking
-- extension exists and is realized; the end segment `S` is `[γ, λ⁺)`.
-- PROOF-STAGE CHANGE: continuity is required only of `⟨N_{0,α}⟩` and `⟨N_{1,α}⟩`; `⟨N^⊕_{1,α}⟩` is
-- only increasing in `K_λ`.
-- DEVIATION (author-confirmed erratum): the paper requires all three sequences to be increasing
-- continuous. Then the definition is unsatisfiable: at a limit point `δ ∈ E` of `E`, clauses (b),
-- (c) and continuity give `N_{1,δ} = N^⊕_{1,δ}`, contradicting (d). See docs/ERRATA.md.
/-- Def 7.1.4: witnesses `⟨N_{0,α}⟩, ⟨N_{1,α}⟩` (`α < λ⁺`, increasing continuous in `K_λ`),
`⟨N^⊕_{1,α}⟩` (`α < λ⁺`, increasing in `K_λ`) and a club `E` for `M₀ ≺⁺_{λ⁺} M₁`:
(a) `Mₙ = ⋃ N_{n,α}`, (b) `α ∈ E → N_{0,α} ≼ N_{1,α} ≼ N^⊕_{1,α}`, (c) `α < β` in `E` →
`NF(N_{0,α}, N^⊕_{1,α}, N_{0,β}, N_{1,β})`, (d) for `α ∈ E` and `p ∈ S^bs(N_{1,α})` there is an
end segment `S` of `λ⁺` such that for `β ∈ S ∩ E`, `N^⊕_{1,β}` realizes the non-forking extension
of `p` to `N_{1,β}`.

Original text of the paper: "there are increasing continuous sequences of models in `K_λ`,
`⟨N_{0,α} : α < λ⁺⟩`, `⟨N_{1,α} : α < λ⁺⟩`, `⟨N^⊕_{1,α} : α < λ⁺⟩`, and there is a club `E` of
`λ⁺` such that ...". -/
def PlusWit (M₀ M₁ : Model U L) (A B C : Ordinal.{u} → Model U L) (E : Set Ordinal.{u}) :
    Prop :=
  IsIncCont s.S A (Iio (Order.succ lam).ord) (s.S.Kc lam) ∧
  IsIncCont s.S B (Iio (Order.succ lam).ord) (s.S.Kc lam) ∧
  IsIncreasing s.S.le C (Iio (Order.succ lam).ord) ∧ (∀ α ∈ Iio (Order.succ lam).ord, C α ∈ s.S.Kc lam) ∧
  IsClubIn (Order.succ lam).ord E ∧
  -- PROOF-STAGE CHANGE: ENCODING (clarification, author-confirmed; not an erratum): clause (a)
  -- `Mₙ = ⋃ N_{n,α}` of the paper is the union of structures, hence `IsUnionOf` (it was the equality
  -- of universes `Mₙ.carrier = ⋃ (N_{n,α}).carrier`, which does not determine the structure of `Mₙ`).
  IsUnionOf A (Iio (Order.succ lam).ord) M₀ ∧
  IsUnionOf B (Iio (Order.succ lam).ord) M₁ ∧
  (∀ α ∈ E, s.S.le (A α) (B α) ∧ s.S.le (B α) (C α)) ∧
  (∀ α ∈ E, ∀ β ∈ E, α < β → s.NF lam (A α) (C α) (A β) (B β)) ∧
  ∀ α ∈ E, ∀ p ∈ s.Sbs (B α), ∃ γ < (Order.succ lam).ord, ∀ β ∈ E, γ ≤ β →
    ∃ q ∈ s.Sbs (B β), s.IsNFExt lam (B α) (B β) q p ∧ Realizes s.S lam (C β) (B β) q

/-- Def 7.1.4: `M₀ ≺⁺_{λ⁺} M₁` (a relation on `K_{λ⁺}`). -/
def ltPlus (M₀ M₁ : Model U L) : Prop :=
  M₀ ∈ s.S.Kc (Order.succ lam) ∧ M₁ ∈ s.S.Kc (Order.succ lam) ∧ ∃ A B C E, s.PlusWit lam M₀ M₁ A B C E

end Frame

/-- AUX: not in paper. Prop 7.1.5 for any increasing continuous enumeration `e` of a club inside `E`. -/
theorem Frame.PlusWit.reindex {s : Frame U L} {lam : Cardinal.{u}} {M₀ M₁ : Model U L}
    {A B C A' B' C' : Ordinal.{u} → Model U L} {E : Set Ordinal.{u}} (hc : s.Core lam)
    (hw : s.PlusWit lam M₀ M₁ A B C E) {e : Ordinal.{u} → Ordinal.{u}}
    (he1 : ∀ β < (Order.succ lam).ord, e β < (Order.succ lam).ord)
    (he2 : ∀ a b, a < b → b < (Order.succ lam).ord → e a < e b)
    (he3 : ∀ β < (Order.succ lam).ord, e β ∈ E)
    (he4 : ∀ β < (Order.succ lam).ord, Order.IsSuccLimit β → Order.IsSuccLimit (e β) ∧
      ∀ ξ < e β, ∃ γ < β, ξ < e γ)
    (hre : ∀ β < (Order.succ lam).ord, A' β = A (e β) ∧ B' β = B (e β) ∧ C' β = C (e β)) :
    s.PlusWit lam M₀ M₁ A' B' C' (Iio (Order.succ lam).ord) := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hA, hB, hCi, hCK, hE, h0, h1, hb, hcc, hd⟩ := hw
  have idle : ∀ α, α < (Order.succ lam).ord → α ≤ e α := by
    intro α
    induction α using Ordinal.lt_wf.induction with
    | ind α ih =>
    intro hα
    by_contra hcon
    have hlt : e α < α := not_le.1 hcon
    exact absurd (he2 _ _ hlt hα) (not_lt.2 (ih _ hlt (lt_trans hlt hα)))
  have hκl : Order.IsSuccLimit (Order.succ lam).ord := by
    have h00 := he1 0
    by_cases hinf : ℵ₀ ≤ lam
    · exact Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
    · obtain ⟨α, hα, -⟩ := hE.2.1 0 (Cardinal.lt_ord.2 (by
        rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam)))
      exact absurd (Frame.aleph0_le hc (hA.2.2 α (hE.1 hα))) hinf
  have tr : ∀ {X X' : Ordinal.{u} → Model U L}, IsIncCont s.S X (Iio (Order.succ lam).ord) (s.S.Kc lam) →
      (∀ β < (Order.succ lam).ord, X' β = X (e β)) →
      IsIncCont s.S X' (Iio (Order.succ lam).ord) (s.S.Kc lam) ∧
        ∀ M, IsUnionOf X (Iio (Order.succ lam).ord) M → IsUnionOf X' (Iio (Order.succ lam).ord) M := by
    intro X X' hX hX'
    refine ⟨⟨fun a ha b hb h => ?_, fun b hb hl => ?_, fun a ha => ?_⟩, fun M hM => ⟨?_, fun β hβ => ?_⟩⟩
    · rw [hX' a ha, hX' b hb]
      exact hX.1 _ (he1 a ha) _ (he1 b hb) (he2 a b h hb)
    · rw [hX' b hb, hX.2.1 _ (he1 b hb) (he4 b hb hl).1]
      ext x
      simp only [mem_iUnion, exists_prop, mem_Iio]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨γ, hγ, hlt⟩ := (he4 b hb hl).2 ξ hξ
        have hγκ : γ < (Order.succ lam).ord := lt_trans hγ hb
        refine ⟨γ, hγ, ?_⟩
        rw [hX' γ hγκ]
        exact hS.sub (hX.1 ξ (lt_trans hlt (he1 γ hγκ)) _ (he1 γ hγκ) hlt) hx
      · rintro ⟨γ, hγ, hx⟩
        have hγκ : γ < (Order.succ lam).ord := lt_trans hγ hb
        rw [hX' γ hγκ] at hx
        exact ⟨e γ, he2 γ b hγ hb, hx⟩
    · rw [hX' a ha]; exact hX.2.2 _ (he1 a ha)
    · rw [hM.1]
      ext x
      simp only [mem_iUnion, exists_prop, mem_Iio]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        refine ⟨ξ, hξ, ?_⟩
        rw [hX' ξ hξ]
        rcases (idle ξ hξ).lt_or_eq with h | h
        · exact hS.sub (hX.1 ξ hξ _ (he1 ξ hξ) h) hx
        · rw [← h]; exact hx
      · rintro ⟨γ, hγ, hx⟩
        rw [hX' γ hγ] at hx
        exact ⟨e γ, he1 γ hγ, hx⟩
    · rw [hX' β hβ]; exact hM.2 _ (he1 β hβ)
  obtain ⟨tA, uA⟩ := tr hA fun β hβ => (hre β hβ).1
  obtain ⟨tB, uB⟩ := tr hB fun β hβ => (hre β hβ).2.1
  refine ⟨tA, tB, fun a ha b hb h => ?_, fun a ha => ?_,
    ⟨subset_rfl, fun α hα => ⟨α + 1, hκl.add_one_lt hα, Order.lt_add_one_iff.2 le_rfl⟩, fun γ hγ _ _ => hγ⟩,
    uA _ h0, uB _ h1, fun α hα => ?_, fun α hα β hβ h => ?_, fun α hα p hp => ?_⟩
  · rw [(hre a ha).2.2, (hre b hb).2.2]
    exact hCi _ (he1 a ha) _ (he1 b hb) (he2 a b h hb)
  · rw [(hre a ha).2.2]; exact hCK _ (he1 a ha)
  · obtain ⟨e1, e2, e3⟩ := hre α hα
    rw [e1, e2, e3]; exact hb _ (he3 α hα)
  · obtain ⟨e1, -, e3⟩ := hre α hα
    obtain ⟨e4, e5, -⟩ := hre β hβ
    rw [e1, e3, e4, e5]
    exact hcc _ (he3 α hα) _ (he3 β hβ) (he2 α β h hβ)
  · have hp' : p ∈ s.Sbs (B (e α)) := (hre α hα).2.1 ▸ hp
    obtain ⟨γ, hγ, H⟩ := hd _ (he3 α hα) p hp'
    refine ⟨γ, hγ, fun β hβ hle => ?_⟩
    rw [(hre α hα).2.1, (hre β hβ).2.1, (hre β hβ).2.2]
    exact H _ (he3 β hβ) (hle.trans (idle β hβ))

/-- AUX: not in paper. `enumOrd E` below `λ⁺`, for a club `E` of `λ⁺`. -/
theorem enumOrd_club {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {E : Set Ordinal.{u}}
    (hE : IsClubIn (Order.succ lam).ord E) :
    ∀ β, β < (Order.succ lam).ord → Ordinal.enumOrd E β ∈ E ∧
      ∀ c < β, Ordinal.enumOrd E c < Ordinal.enumOrd E β := by
  intro β
  induction β using Ordinal.lt_wf.induction with
  | ind β ih =>
  intro hβ
  obtain ⟨ζ, hζ, hb⟩ := sup_bdd hinf hβ (Ordinal.enumOrd E)
    (fun γ hγ => hE.1 (ih γ hγ (lt_trans hγ hβ)).1)
  obtain ⟨x, hxE, hx⟩ := hE.2.1 ζ hζ
  have hS : (E ∩ {b | ∀ c, c < β → Ordinal.enumOrd E c < b}).Nonempty :=
    ⟨x, hxE, fun c hc => (hb c hc).trans_lt hx⟩
  have hm := csInf_mem hS
  have e : Ordinal.enumOrd E β = sInf (E ∩ {b | ∀ c, c < β → Ordinal.enumOrd E c < b}) := by
    rw [Ordinal.enumOrd]
  rw [e]
  exact ⟨hm.1, fun c hc => hm.2 c hc⟩

/-- AUX: not in paper. `enumOrd E` is continuous at limits below `λ⁺`. -/
theorem enumOrd_club_lim {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {E : Set Ordinal.{u}}
    (hE : IsClubIn (Order.succ lam).ord E) {β : Ordinal.{u}} (hβ : β < (Order.succ lam).ord)
    (hl : Order.IsSuccLimit β) :
    Order.IsSuccLimit (Ordinal.enumOrd E β) ∧
      ∀ ξ < Ordinal.enumOrd E β, ∃ γ < β, ξ < Ordinal.enumOrd E γ := by
  classical
  have P := enumOrd_club hinf hE
  have main : ∀ ξ < Ordinal.enumOrd E β, ∃ γ < β, ξ < Ordinal.enumOrd E γ := by
    intro ξ hξ
    by_contra hcon
    push Not at hcon
    have hne : {a | ∀ c, c < β → Ordinal.enumOrd E c ≤ a}.Nonempty := ⟨ξ, hcon⟩
    set δ := sInf {a | ∀ c, c < β → Ordinal.enumOrd E c ≤ a} with hδ
    have hup : ∀ c, c < β → Ordinal.enumOrd E c ≤ δ := csInf_mem hne
    have hδξ : δ ≤ ξ := csInf_le' hcon
    have hlt : ∀ c < β, Ordinal.enumOrd E c < δ := fun c hc =>
      lt_of_lt_of_le ((P _ (lt_trans (hl.add_one_lt hc) hβ)).2 c (Order.lt_add_one_iff.2 le_rfl))
        (hup _ (hl.add_one_lt hc))
    have hbel : ∀ a < δ, ∃ c < β, a < Ordinal.enumOrd E c := by
      intro a ha
      by_contra h
      push Not at h
      exact absurd (csInf_le' (show a ∈ {a | ∀ c, c < β → Ordinal.enumOrd E c ≤ a} from h)) (not_le.2 ha)
    have hδκ : δ < (Order.succ lam).ord :=
      lt_of_le_of_lt hδξ (hξ.trans (hE.1 (P β hβ).1))
    have hδl : Order.IsSuccLimit δ := by
      rcases Ordinal.zero_or_succ_or_isSuccLimit δ with h | ⟨a, ha⟩ | h
      · exact absurd (hlt 0 hl.bot_lt) (by rw [h]; exact not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at ha
        obtain ⟨c, hc, h1⟩ := hbel a (by rw [← ha]; exact Order.lt_add_one_iff.2 le_rfl)
        have := hlt c hc
        rw [← ha] at this
        exact absurd (Order.lt_add_one_iff.1 this) (not_le.2 h1)
      · exact h
    have hδE : δ ∈ E := hE.2.2 δ hδκ hδl fun ξ' h' => by
      obtain ⟨c, hc, h1⟩ := hbel ξ' h'
      exact ⟨_, (P c (lt_trans hc hβ)).1, h1, hlt c hc⟩
    exact absurd (Ordinal.enumOrd_le_of_forall_lt hδE hlt) (not_le.2 (lt_of_le_of_lt hδξ hξ))
  refine ⟨?_, main⟩
  rcases Ordinal.zero_or_succ_or_isSuccLimit (Ordinal.enumOrd E β) with h | ⟨a, ha⟩ | h
  · have := (P β hβ).2 0 hl.bot_lt
    rw [h] at this
    exact absurd this (not_lt.2 zero_le)
  · rw [Order.succ_eq_add_one] at ha
    obtain ⟨γ, hγ, h1⟩ := main a (by rw [← ha]; exact Order.lt_add_one_iff.2 le_rfl)
    have := (P β hβ).2 γ hγ
    rw [← ha] at this
    exact absurd (Order.lt_add_one_iff.1 this) (not_le.2 h1)
  · exact h

-- DEVIATION (encoding): "M_{0, otp(α ∩ E)} = N_{0,α}" is encoded with the enumeration of `E`:
-- `M_{0,β} = N_{0, enumOrd E β}` for `β < λ⁺`.
/-- Prop 7.1.5: if `⟨N_{0,α}⟩, ⟨N_{1,α}⟩, ⟨N^⊕_{1,α}⟩, E` witness `M₀ ≺⁺ M₁` and the sequences
`M` are the re-indexing of the `N` along `E`, then they witness `M₀ ≺⁺ M₁` with `E = λ⁺`. -/
theorem prop_7_1_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ : Model U L) (A B C A' B' C' : Ordinal.{u} → Model U L) (E : Set Ordinal.{u})
    (hw : s.PlusWit lam M₀ M₁ A B C E)
    (hre : ∀ β < (Order.succ lam).ord, A' β = A (Ordinal.enumOrd E β) ∧
      B' β = B (Ordinal.enumOrd E β) ∧ C' β = C (Ordinal.enumOrd E β)) :
    s.PlusWit lam M₀ M₁ A' B' C' (Iio (Order.succ lam).ord) := by
  have hc : s.Core lam := hs.1.1
  obtain ⟨hA, -, -, -, hE, -⟩ := id hw
  obtain ⟨a0, ha0, -⟩ := hE.2.1 0 (Cardinal.lt_ord.2 (by
    rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam)))
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (hA.2.2 a0 (hE.1 ha0))
  have P := enumOrd_club hinf hE
  exact hw.reindex hc (fun β hβ => hE.1 (P β hβ).1) (fun a b hab hb => (P b hb).2 a hab)
    (fun β hβ => (P β hβ).1) (fun β hβ hl => enumOrd_club_lim hinf hE hβ hl) hre

/-- Prop 7.1.6: witnesses with club `E` remain witnesses for any club `E⁻ ⊆ E`. -/
theorem prop_7_1_6 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_7_1_1 s lam)
    (M₀ M₁ : Model U L) (A B C : Ordinal.{u} → Model U L) (E E' : Set Ordinal.{u})
    (hw : s.PlusWit lam M₀ M₁ A B C E) (hE' : IsClubIn (Order.succ lam).ord E') (hsub : E' ⊆ E) :
    s.PlusWit lam M₀ M₁ A B C E' := by
  obtain ⟨hA, hB, hCi, hCK, -, h0, h1, hb, hc, hd⟩ := hw
  refine ⟨hA, hB, hCi, hCK, hE', h0, h1, fun α hα => hb α (hsub hα),
    fun α hα β hβ h => hc α (hsub hα) β (hsub hβ) h, fun α hα p hp => ?_⟩
  obtain ⟨γ, hγ, h⟩ := hd α (hsub hα) p hp
  exact ⟨γ, hγ, fun β hβ => h β (hsub hβ)⟩

/-- AUX: not in paper. `NF` is preserved by isomorphisms. -/
theorem Frame.nf_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' : Model U L} {f : U → U} (h : s.NF lam M₀ M₁ M₂ M₃)
    (h₃ : IsoOn f M₃ M₃') (h₀ : IsoOn f M₀ M₀') (h₁ : IsoOn f M₁ M₁') (h₂ : IsoOn f M₂ M₂') :
    s.NF lam M₀' M₁' M₂' M₃' := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, N0, N1, N2, N3, e, -, n1, n2, n3, m0, m1, m2, m3,
    αs, A, B, d, hw⟩ := h
  have tK : ∀ {X X' : Model U L}, X ∈ s.S.Kc lam → IsoOn f X X' → X' ∈ s.S.Kc lam := fun hX hi =>
    ⟨hS.iso_mem hX.1 hi, by rw [hi.card_eq]; exact hX.2⟩
  have hl13 := hS.iso_le l13 h₃ h₁
  have hl23 := hS.iso_le l23 h₃ h₂
  have hl01 := hS.iso_le l01 h₁ h₀
  have hl02 := hS.iso_le l02 h₂ h₀
  have hsmall : #(∅ ∪ M₃'.carrier : Set U) < #U := by
    rw [Set.empty_union]
    have : #M₃'.carrier = lam := (tK k3 h₃).2
    rw [this]; exact hU.2
  obtain ⟨g, N3', hN3, hgf, hle, -, -⟩ := hS.rename hU.infinite ∅ n3 h₃ hsmall
  have fg : ∀ {X X' : Model U L}, s.S.le X M₃ → IsoOn f X X' → IsoOn g X X' := fun hX hi =>
    hi.congr fun x hx => (hgf x (hS.sub hX hx)).symm
  obtain ⟨-, -, -, -, -, -, ⟨-, a13⟩, ⟨-, a23⟩, -⟩ := id hw
  obtain ⟨N1', hN1'⟩ := exists_isoOn (hN3.injOn.mono (hS.sub a13))
  obtain ⟨N2', hN2'⟩ := exists_isoOn (hN3.injOn.mono (hS.sub a23))
  have g0 : IsoOn g M₀ M₀' := fg (hS.trans l01 l13) h₀
  have g1 : IsoOn g M₁ M₁' := fg l13 h₁
  have g2 : IsoOn g M₂ M₂' := fg l23 h₂
  have tKg : ∀ {X X' : Model U L}, X ∈ s.S.Kc lam → IsoOn g X X' → X' ∈ s.S.Kc lam := fun hX hi =>
    ⟨hS.iso_mem hX.1 hi, by rw [hi.card_eq]; exact hX.2⟩
  rw [e] at hw m0
  obtain ⟨A', B', hw', -⟩ := Frame.nfstarWit_iso hU hc hN3 g0 hN1' hN2' hw
  exact ⟨tK k0 h₀, tK k1 h₁, tK k2 h₂, tK k3 h₃, hl01, hl13, hl02, hl23, M₀', N1', N2', N3', rfl,
    hS.refl (tK k0 h₀).1, hS.iso_le n1 hN1' g1, hS.iso_le n2 hN2' g2, hle, tK k0 h₀, tKg m1 hN1',
    tKg m2 hN2', tKg m3 hN3, αs, A', B', _, hw'⟩

/-- AUX: not in paper. `NF` is preserved by enlarging the top model inside `K_λ`. -/
theorem Frame.nf_top [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀ M₁ M₂ M₃ N : Model U L} (h : s.NF lam M₀ M₁ M₂ M₃)
