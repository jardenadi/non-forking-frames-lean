      rw [xa1 β hβr, (hb β hβr).carrier_eq, ac' β hβr hl, Set.image_iUnion₂]
      refine Set.iUnion₂_congr fun ζ hζ => ?_
      have hζ' : ζ ≤ r := le_of_lt (lt_of_lt_of_le hζ hβr)
