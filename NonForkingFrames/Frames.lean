        exact (hprev β' h').2.2.2.2.2.2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h y hy
      · rw [h', hcx]; exact hFa β hβα y hy
    have c9 : FunIncreasing (fun β => (c' β).2.2) Nb (Iic α) := by
      intro β hβ β' hβ' h y hy
      have hβα : β < α := lt_of_lt_of_le h hβ'
      show (c' β').2.2 y = (c' β).2.2 y
      rw [hcl β hβα]
      rcases (show β' ≤ α from hβ').lt_or_eq with h' | h'
      · rw [hcl β' h']
        exact (hprev β' h').2.2.2.2.2.2.2.2 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h y hy
      · rw [h', hcx]; exact hFb β hβα y hy
    have hre : ∀ {X : Ordinal.{u} → Model U L}, IsIncreasing S.le X (Iic αs) →
        IsIncreasing S.le X (Iic α) := fun hX β hβ β' hβ' h =>
      hX β ((show β ≤ α from hβ).trans hα) β' ((show β' ≤ α from hβ').trans hα) h
    have hrc : ∀ {X : Ordinal.{u} → Model U L}, IsContinuous X (Iic αs) →
        IsContinuous X (Iic α) := fun hX β hβ hl => hX β ((show β ≤ α from hβ).trans hα) hl
    have c6 : ∀ β ≤ α, IsEmb S (c' β).2.1 (Na β) (c' β).1 ∧ IsEmb S (c' β).2.2 (Nb β) (c' β).1 := by
      have hlt : ∀ β < α, IsEmb S (c' β).2.1 (Na β) (c' β).1 ∧
          IsEmb S (c' β).2.2 (Nb β) (c' β).1 := fun β hβ => by
        rw [hcl β hβ]; exact (hprev β hβ).2.2.2.2.2.1 β le_rfl
      intro β hβ
      rcases hβ.lt_or_eq with h | h
      · exact hlt β h
      · subst h
        exact ⟨hS.emb_limit (f := fun β => (c' β).2.1) (N := fun β => (c' β).1) hlim (hre hNai)
            (hrc hNac) c4 (fun β hβ => (hlt β hβ).1) c8,
          hS.emb_limit (f := fun β => (c' β).2.2) (N := fun β => (c' β).1) hlim (hre hNbi)
            (hrc hNbc) c4 (fun β hβ => (hlt β hβ).2) c9⟩
    refine ⟨fun β hβ => ?_, by rw [hcl 0 h0α]; exact hp0.2.1,
      fun x hx => by rw [hcl 0 h0α]; exact hp0.2.2.1 x hx, c4, fun β' hβ' hl => ?_, c6,
      fun β hβ x hx => ?_, c8, c9⟩
    · rcases hβ.lt_or_eq with h | h
      · rw [hcl β h]; exact (hprev β h).1 β le_rfl
      · rw [h, hcx]; exact ⟨hNαK, hNαc⟩
    · show (c' β').1.carrier = ⋃ ξ ∈ Iio β', (c' ξ).1.carrier
      rcases (show β' ≤ α from hβ').lt_or_eq with h | h
      · rw [hcl β' h, hcont β' h hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
      · rw [h, hcx, hNαU.1]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
    · rcases hβ.lt_or_eq with h | h
      · rw [hcl β h]; exact (hprev β h).2.2.2.2.2.2.1 β le_rfl x hx
      · subst h
        rw [hcx]
        rw [hN₁c β hα hlim] at hx
        obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
        have hξβ : ξ < β := hξ
        have hξα : ξ ≤ αs := hξβ.le.trans hα
        show Fa (fa β x) = Fb (fb β x)
        rw [hfai ξ hξα β hα hξβ x hxξ, hfbi ξ hξα β hα hξβ x hxξ,
          hFa ξ hξβ _ ((hf ξ hξα).1.mapsTo hS hxξ), hFb ξ hξβ _ ((hf ξ hξα).2.mapsTo hS hxξ)]
        exact (hprev ξ hξβ).2.2.2.2.2.2.1 ξ le_rfl x hxξ

-- DEVIATION (author-confirmed erratum): the element `a` is explicit and the conditions of Def
-- 5.4.1(1) are included. See docs/ERRATA.md.
/-- Def 5.4.2, corrected. Original text: `NF^uq = {(M₀, M₁, M₂, M₃) : ∃ a ∈ M₁ - M₀,
(M₀, M₁, a) ∈ K^{3,uq} and tp(a, M₂, M₃) does not fork over M₀}`. -/
def Frame.NFuqE (s : Frame U L) (lam : Cardinal.{u}) : U → QRel U L := fun a M₀ M₁ M₂ M₃ =>
  (M₀, M₁, a) ∈ s.K3uq lam ∧ M₂ ∈ s.S.Kc lam ∧ M₃ ∈ s.S.Kc lam ∧ s.S.le M₁ M₃ ∧ s.S.le M₀ M₂ ∧
    s.S.le M₂ M₃ ∧ s.NotFork lam M₀ M₂ (tp s.S lam a M₂ M₃)

