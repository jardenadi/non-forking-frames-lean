    · show (c' β).1.carrier = ⋃ ξ ∈ Iio β, (c' ξ).1.carrier
      rcases hcases β hβ with h | h
      · rw [hcl β h, (hprev β h).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hβl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
      · rw [h, hcx, hNαU.1]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
    · have hb1 : β + 1 < α := lt_of_le_of_ne hβ fun h => by
        rw [h.symm, ← Order.succ_eq_add_one] at hlim
        exact absurd hlim.isMax (not_isMax β)
      have hb : β < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
      rw [hcl β hb, hcl (β + 1) hb1]
      exact (hprev (β + 1) hb1).2.2.2.2.2.2.2.1 β le_rfl
    · rcases hcases β hβ with h | h
      · rw [hcl β h]; exact (hprev β h).2.2.2.2.2.2.2.2 β le_rfl
      · subst h
        rw [hcx]
        have hPα := hP β le_rfl
        rw [hcx] at hPα
        -- `P 0 = M 0`
        have hP0 : P 0 = M 0 := by
          have h1 := (hP 0 zero_le).1
          rw [hcl 0 h0α] at h1
          exact (Model.eq_of_isoOn_id (h1.congr fun x hx => (hprev 0 h0α).2.2.1 x hx)).symm
        have hPK : ∀ γ ∈ Iic β, P γ ∈ s.S.Kc lam := fun γ hγ =>
          ⟨hS.mem_left (hP γ hγ).2, by rw [(hP γ hγ).1.card_eq]; exact (hMK γ
            (Set.mem_Iic.2 ((show γ ≤ β from hγ).trans hα))).2⟩
        have hbNα : b ∈ Nα.carrier := by
          have hbN : b ∈ N.carrier := hbs.2.2.1.1
          rw [← (hprev 0 h0α).2.1] at hbN
          exact hS.sub (hleNα 0 h0α) hbN
        have hβlt : β < (Order.succ lam).ord :=
          Cardinal.lt_ord.2 (lt_of_le_of_lt hαcard (Order.lt_succ lam))
        have hK3 : (P β, Nα, b) ∈ s.S.K3 := ⟨(hPK β (Set.mem_Iic.2 le_rfl)).1, hNαK, hPα.2, hbNα⟩
        have := hcont3 β hlim hβlt P ⟨hPinc, hPcont, hPK⟩ (tp s.S lam b (P β) Nα)
          ⟨Nα, b, hK3, rfl⟩ (fun γ hγ => by
            have hPγβ : s.S.le (P γ) (P β) :=
              hPinc γ (Set.mem_Iic.2 hγ.le) β (Set.mem_Iic.2 le_rfl) hγ
            have hPγ := hP γ hγ.le
            rw [hcl γ hγ] at hPγ
            rw [res_tp hS hPγβ, hP0,
              ← tp_eq_of_le hS ⟨(hPK γ hγ.le).1, hNαK, hS.trans hPγβ hPα.2,
                hbNα⟩ (hleNα γ hγ) hPγ.2 (by
                  have hbN : b ∈ N.carrier := hbs.2.2.1.1
                  rw [← (hprev 0 h0α).2.1] at hbN
                  rcases (show (0 : Ordinal.{u}) ≤ γ from zero_le).lt_or_eq with h | h
                  · exact hS.sub (hinc 0 h0α γ hγ h) hbN
                  · rw [← h]; exact hbN)]
            obtain ⟨Q, hQ, hQnf⟩ := (hprev γ hγ).2.2.2.2.2.2.2.2 γ le_rfl
            rwa [hQ.unique hPγ.1] at hQnf)
        rw [hP0] at this
        exact ⟨P β, hPα.1, this.2⟩)
  exact ⟨c, fun α hα => hc' α hα.le hα⟩

/-- AUX: not in paper. Prop 3.1.9(1), second half: no `≼`-maximal model in `K_{λ⁺}` (the paper's
proof, with Prop 3.1.8 along a representation: `Frame.construction_318_long`). -/
theorem Frame.noMax_succ [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_3_0_1 s lam)
    {M : Model U L} (hM : M ∈ s.S.Kc (Order.succ lam)) (hne : (s.S.Kc lam).Nonempty) :
    ∃ N ∈ s.S.K, s.S.lt M N := by
  classical
  obtain ⟨hc, hcont3, hsym⟩ := hs
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hne.some_mem
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl := Cardinal.isSuccLimit_ord hinf₁
  have hκ0 := hκl.bot_lt
  have hsmM : #M.carrier < #U := by
    rw [show #M.carrier = Order.succ lam from hM.2]; exact hU.succ.2
  -- a starting model and a strict filtration
  obtain ⟨A0, hA0, hcA0⟩ : ∃ A0 : Set U, A0 ⊆ M.carrier ∧ #A0 = lam :=
    Cardinal.le_mk_iff_exists_subset.1 (show lam ≤ #M.carrier by
      rw [show #M.carrier = Order.succ lam from hM.2]; exact Order.le_succ lam)
  have hLS : s.S.HasLST lam := (KSys.hasLST_LST hS.lst).mono hc.ax0b
  obtain ⟨N₀, kN₀', hAN, lN₀, hcN₀⟩ := hLS M hM.1 A0 hA0
  have kN₀ : N₀ ∈ s.S.Kc lam := ⟨kN₀', le_antisymm
    (hcN₀.trans (Cardinal.add_le_of_le hinf le_rfl (le_of_eq hcA0)))
    (by rw [← hcA0]; exact Cardinal.mk_le_mk_of_subset hAN)⟩
  obtain ⟨A, hA0', hAK, hAlt, hAc, hAU⟩ := hS.exists_filtration hc.ax0b hinf hM kN₀ lN₀
  have hAi : IsIncreasing s.S.le A (Iio (Order.succ lam).ord) := fun x hx y hy h => (hAlt x hx y hy h).1
  have ha : ∀ α, α < (Order.succ lam).ord → ∃ x, x ∈ (A (α + 1)).carrier \ (A α).carrier ∧
      (A α, A (α + 1), x) ∈ s.K3bs lam := fun α hα => by
    have hα1 := hκl.add_one_lt hα
    obtain ⟨x, hx, hb⟩ := hc.ax2c _ (hAK α hα).1 _ (hAK _ hα1).1
      (hAlt α hα _ hα1 (Order.lt_add_one_iff.2 le_rfl))
    exact ⟨x, hx, (hAK α hα).1, (hAK _ hα1).1, hx, hb⟩
  have : Infinite U := hU.infinite
  choose! a ha' using ha
  -- the model `N` over `A 0`, disjoint from `M`
  have kA0 := (hAK 0 hκ0).1
  obtain ⟨N₁, kN₁, lt1⟩ : ∃ N ∈ s.S.Kc lam, s.S.lt (A 0) N := by
    have hnm := hc.ax1c _ kA0
    by_contra hcon
    exact hnm ⟨kA0, fun ⟨N, hN, hl⟩ => hcon ⟨N, hN, hl.1.2.2, hl.2⟩⟩
  have hsm1 : #(M.carrier ∪ (A 0).carrier : Set U) < #U :=
    lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hsmM
      (by rw [show #(A 0).carrier = lam from kA0.2]; exact hU.2))
  obtain ⟨h, N, iN, hid, lAN, memN, hout⟩ := hS.rename hU.infinite M.carrier lt1.1 (IsoOn.refl _) hsm1
  have kN : N ∈ s.S.Kc lam := ⟨memN, by rw [iN.card_eq]; exact kN₁.2⟩
  have ltAN : s.S.lt (A 0) N := ⟨lAN, fun e => by
    obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt lt1
    have := iN.mapsTo hy
    rw [← e] at this
    exact hout y ⟨hy, hyn⟩ (Or.inl (hS.sub (hAK 0 hκ0).2 this))⟩
  obtain ⟨b, hb, hbb⟩ := hc.ax2c _ kA0 _ kN ltAN
  have hbs : (A 0, N, b) ∈ s.K3bs lam := ⟨kA0, kN, hb, hbb⟩
  have hbM : b ∉ M.carrier := by
    intro hbM
    have hbN := hb.1
    rw [iN.carrier_eq] at hbN
    obtain ⟨y, hy, rfl⟩ := hbN
    by_cases hy0 : y ∈ (A 0).carrier
    · rw [hid y hy0] at hb; exact hb.2 hy0
    · exact hout y ⟨hy, hy0⟩ (Or.inl hbM)
  obtain ⟨c, hcI⟩ := Frame.construction_318_long hU ⟨hc, hcont3, hsym⟩ hAi hAc
    (fun α hα => (hAK α hα).1) kN lAN (fun α hα => ha' α hα) hbs
  have : Nonempty (Model U L) := ⟨N⟩
  let Y : Ordinal.{u} → Model U L := fun α => (c α).1
  have Yi : IsIncreasing s.S.le Y (Iio (Order.succ lam).ord) := fun x _ y hy h =>
    (hcI y hy).2.2.2.1 x (Set.mem_Iic.2 h.le) y (Set.mem_Iic.2 le_rfl) h
  have Yc : IsContinuous Y (Iio (Order.succ lam).ord) := fun β hβ hl =>
    (hcI β hβ).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl
  obtain ⟨Ys, uYs, kYs, -⟩ := hS.union _ hκl Y Yi Yc
  have lY := (hS.le_union hκl Yi Yc uYs).2
  have fi : ∀ α < (Order.succ lam).ord, ∀ β < (Order.succ lam).ord, α < β →
      ∀ x ∈ (A α).carrier, (c β).2 x = (c α).2 x := fun α _ β hβ h x hx =>
    (hcI β hβ).2.2.2.2.2.2.1 α (Set.mem_Iic.2 h.le) β (Set.mem_Iic.2 le_rfl) h x hx
  have hP : ∀ α, α < (Order.succ lam).ord → ∃ P, IsoOn (c α).2 (A α) P ∧ s.S.le P (Y α) ∧
      s.NotFork lam (A 0) P (tp s.S lam b P (Y α)) := fun α hα => by
    obtain ⟨P, hPi, hPn⟩ := (hcI α hα).2.2.2.2.2.2.2.2 α le_rfl
    obtain ⟨-, -, P', lP', iP'⟩ := (hcI α hα).2.2.2.2.2.1 α le_rfl
    rw [hPi.unique iP'] at hPn
    exact ⟨P', iP', lP', hPn⟩
  choose! P hPi hPl hPn using hP
  let F : U → U := fun x =>
    if h : ∃ α < (Order.succ lam).ord, x ∈ (A α).carrier then (c h.choose).2 x else x
  have hF : ∀ α < (Order.succ lam).ord, ∀ x ∈ (A α).carrier, F x = (c α).2 x := by
    intro α hα x hx
    have h : ∃ α < (Order.succ lam).ord, x ∈ (A α).carrier := ⟨α, hα, hx⟩
    have hch := h.choose_spec
    simp only [F, h, dite_true]
    rcases lt_trichotomy h.choose α with hl | he | hl
    · exact (fi _ hch.1 α hα hl x hch.2).symm
    · rw [he]
    · exact fi α hα _ hch.1 hl x hx
  have iF : ∀ α < (Order.succ lam).ord, IsoOn F (A α) (P α) := fun α hα =>
    (hPi α hα).congr fun x hx => (hF α hα x hx).symm
  have hsubA : ∀ x < (Order.succ lam).ord, ∀ y < (Order.succ lam).ord, x ≤ y →
      (A x).carrier ⊆ (A y).carrier := fun x hx y hy h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (hAi x hx y hy h')
    · rw [h']
  have Pi : IsIncreasing s.S.le P (Iio (Order.succ lam).ord) := by
    intro x hx y hy h
    have hsub : (P x).carrier ⊆ (P y).carrier := by
      rw [(iF x hx).carrier_eq, (iF y hy).carrier_eq]
      exact Set.image_mono (hsubA x hx y hy h.le)
    exact hS.le_of_sub (hS.trans (hPl x hx) (Yi x hx y hy h)) (hPl y hy) hsub
  have Pc : IsContinuous P (Iio (Order.succ lam).ord) := by
    intro β hβ hl
    have hβ' : β < (Order.succ lam).ord := hβ
    rw [(iF β hβ').carrier_eq, hAc β hβ hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ζ hζ => ((iF ζ (lt_trans hζ hβ')).carrier_eq).symm
  obtain ⟨Ps, uPs, kPs, -⟩ := hS.union _ hκl P Pi Pc
  have iFM : IsoOn F M Ps := IsoOn.union hS hκl hAi Pi hAU uPs iF
  have lPY : s.S.le Ps Ys := hS.smooth _ hκl P Ys Pi Pc
    (fun α hα => hS.trans (hPl α hα) (lY α hα)) Ps uPs kPs
  have hbY : b ∈ Ys.carrier := by
    have : b ∈ (Y 0).carrier := by
      show b ∈ (c 0).1.carrier
      rw [(hcI 0 hκ0).2.1]; exact hb.1
    exact hS.sub (lY 0 hκ0) this
  have hbP : b ∉ Ps.carrier := by
    intro hin
    rw [uPs.1] at hin
    obtain ⟨α, hα, hin⟩ := Set.mem_iUnion₂.1 hin
    obtain ⟨cb, Xb, hEqb, -, -, -, -, hcb, -⟩ := (hPn α hα).facts hc.ax3a
    have e : cb = b := (ERel.alg (tp_eq_iff.1 hEqb)).1 hin
    exact hcb.2 (e ▸ hin)
  obtain ⟨g, ig, -, -⟩ := iFM.exists_inv
  obtain ⟨h', N', iN', -, lMN', memN', hout'⟩ := hS.rename hU.infinite ∅ lPY ig
    (by rw [Set.empty_union]; exact hsmM)
  refine ⟨N', memN', lMN', fun e => ?_⟩
  have h1 := iN'.mapsTo hbY
  rw [← e] at h1
  exact hout' b ⟨hbY, hbP⟩ (Or.inr h1)

/-- AUX: not in paper. If `K_λ ≠ ∅` and `K_{λ⁺}` has no `≼`-maximal model, there is a model of
cardinality `λ^{+2}` (Prop 3.1.9(2): a strictly increasing continuous chain in `K_{λ⁺}`). -/
theorem Frame.exists_Kc_plus2_of_noMax {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    (hne : (s.S.Kc lam).Nonempty) (hnm : ∀ M ∈ s.S.Kc (Order.succ lam), ∃ N ∈ s.S.K, s.S.lt M N) :
    (s.S.Kc (plusN lam 2)).Nonempty := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hne.some_mem
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hinf₂ : ℵ₀ ≤ plusN lam 2 := hinf₁.trans (Order.le_succ _)
  have hκ₂l : Order.IsSuccLimit (plusN lam 2).ord := Cardinal.isSuccLimit_ord hinf₂
  have hlst : s.S.LST ≤ Order.succ lam := hc.ax0b.trans (Order.le_succ lam)
  obtain ⟨M₀, kM₀⟩ := Frame.exists_Kc_succ hc hne
  -- strict extensions inside `K_{λ⁺}`
  have hgo : ∀ M ∈ s.S.Kc (Order.succ lam), ∃ W ∈ s.S.Kc (Order.succ lam), s.S.lt M W := by
    intro M hM
    obtain ⟨N, kN, hlt⟩ := hnm M hM
    obtain ⟨x, hx, hxM⟩ := hS.exists_diff_of_lt hlt
    obtain ⟨W, kW, hAW, lW⟩ := hS.exists_hull hlst hinf₁ hM kN Set.subset_union_left
      (Set.union_subset (hS.sub hlt.1) (Set.singleton_subset_iff.2 hx))
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf₁ (le_of_eq hM.2)
        (by rw [Cardinal.mk_singleton]; exact Cardinal.one_le_aleph0.trans hinf₁)))
    exact ⟨W, kW, hS.le_of_sub hlt.1 lW (Set.subset_union_left.trans hAW),
      fun e => hxM (e ▸ hAW (Or.inr rfl))⟩
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c =>
    α < (plusN lam 2).ord → c α ∈ s.S.Kc (Order.succ lam) ∧ (∀ β < α, s.S.lt (c β) (c α)) ∧
      (Order.IsSuccLimit α → IsUnionOf c (Iio α) (c α))
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' e h hα
    obtain ⟨h1, h2, h3⟩ := h hα
    have eα := e α le_rfl
    refine ⟨eα ▸ h1, fun β hβ => by rw [← eα, ← e β hβ.le]; exact h2 β hβ, fun hl => ?_⟩
    rw [← eα]; exact (h3 hl).congr' fun β hβ => e β (le_of_lt hβ)
  have : Nonempty (Model U L) := ⟨M₀⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (plusN lam 2).ord Inv hloc (by
    intro α hαθ c ih
    by_cases hα : α < (plusN lam 2).ord
    swap
    · exact ⟨M₀, fun h => absurd h hα⟩
    have ih' : ∀ β < α, _ := fun β hβ => ih β hβ (hβ.trans hα)
    suffices hx : ∃ x : Model U L, x ∈ s.S.Kc (Order.succ lam) ∧ (∀ β < α, s.S.lt (c β) x) ∧
        (Order.IsSuccLimit α → IsUnionOf c (Iio α) x) by
      obtain ⟨x, h1, h2, h3⟩ := hx
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, fun β hβ => ?_, fun hl => (h3 hl).congr' fun β hβ => ?_⟩
      · simp only [hβ, ite_true]; exact h2 β hβ
      · have : β < α := hβ
        simp only [this, ite_true]
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨η, hη⟩ | hl
    · subst h0
      exact ⟨M₀, kM₀, fun β hβ => absurd hβ (not_lt.2 zero_le),
        fun hl => absurd hl Order.not_isSuccLimit_bot⟩
    · have hη' : α = η + 1 := hη.symm
      subst hη'
      have hηlt : η < η + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨kη, ltη, -⟩ := ih' η hηlt
      obtain ⟨x, kx, lx⟩ := hgo _ kη
      refine ⟨x, kx, fun β hβ => ?_, fun hl => absurd hl fun hl' =>
        lt_irrefl _ (hl'.add_one_lt hηlt)⟩
      rcases (Order.lt_succ_iff.1 hβ).lt_or_eq with h | h
      · exact ⟨hS.trans (ltη β h).1 lx.1, fun e => by
          obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt lx
          exact hyn (hS.sub (ltη β h).1 (e ▸ hy))⟩
      · rw [h]; exact lx
    · have hi : IsIncreasing s.S.le c (Iio α) := fun a' _ b' hb h' => ((ih' b' hb).2.1 a' h').1
      have hco : IsContinuous c (Iio α) := fun β hβ hl' => ((ih' β hβ).2.2 hl').1
      obtain ⟨V, uV, kV, -⟩ := hS.union α hl c hi hco
      have lV := (hS.le_union hl hi hco uV).2
      have h0α : (0 : Ordinal.{u}) < α := hl.bot_lt
      refine ⟨V, ⟨kV, le_antisymm ?_ ?_⟩, fun β hβ => ⟨lV β hβ, fun e => ?_⟩, fun _ => uV⟩
      · show #V.carrier ≤ _
        rw [uV.1]
        exact card_biUnion_le hinf₁ (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hα))
          fun β hβ => le_of_eq (ih' β hβ).1.2
      · rw [← (ih' 0 h0α).1.2]; exact Model.card_le_of_sub (hS.sub (lV 0 h0α))
      · have hβ1 : β + 1 < α := hl.add_one_lt hβ
        obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt ((ih' (β + 1) hβ1).2.1 β (Order.lt_add_one_iff.2 le_rfl))
        exact hyn (e ▸ hS.sub (lV _ hβ1) hy))
  have hI : ∀ α < (plusN lam 2).ord, _ := fun α hα => hcI α hα.le hα
  have hi : IsIncreasing s.S.le c (Iio (plusN lam 2).ord) := fun a' _ b' hb h' => ((hI b' hb).2.1 a' h').1
  have hco : IsContinuous c (Iio (plusN lam 2).ord) := fun β hβ hl' => ((hI β hβ).2.2 hl').1
  obtain ⟨N, hN, kN, -⟩ := hS.union _ hκ₂l c hi hco
  refine ⟨N, kN, le_antisymm ?_ ?_⟩
  · show #N.carrier ≤ _
    rw [hN.1]
    exact card_biUnion_le hinf₂ (by rw [Cardinal.card_ord]) fun β hβ =>
      (le_of_eq (hI β hβ).1.2).trans (Order.le_succ _)
  · have hdiff : ∀ β, β < (plusN lam 2).ord → ∃ y ∈ (c (β + 1)).carrier, y ∉ (c β).carrier :=
      fun β hβ => hS.exists_diff_of_lt ((hI (β + 1) (hκ₂l.add_one_lt hβ)).2.1 β
        (Order.lt_add_one_iff.2 le_rfl))
    choose y hy1 hy2 using hdiff
    let E := Ordinal.ToType.mk (o := (plusN lam 2).ord)
    have hsubc : ∀ a < (plusN lam 2).ord, ∀ b < (plusN lam 2).ord, a ≤ b →
        (c a).carrier ⊆ (c b).carrier := fun a ha b hb h => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub (hi a ha b hb h')
      · rw [h']
    let g : (plusN lam 2).ord.ToType → N.carrier := fun i =>
      ⟨y (E.symm i) (E.symm i).2, by
        rw [hN.1]
        exact Set.mem_iUnion₂.2 ⟨_, hκ₂l.add_one_lt (E.symm i).2, hy1 _ _⟩⟩
    have hg : Function.Injective g := by
      intro i j hij
      have hij' := congrArg Subtype.val hij
      simp only [g] at hij'
      by_contra hne'
      have hne'' : (E.symm i : Ordinal.{u}) ≠ E.symm j := fun e =>
        hne' (E.symm.injective (Subtype.ext e))
      have key : ∀ i' j' : (plusN lam 2).ord.ToType, (E.symm i' : Ordinal.{u}) < E.symm j' →
          y (E.symm i') (E.symm i').2 ≠ y (E.symm j') (E.symm j').2 := by
        intro i' j' hlt he
        have h1 := hsubc _ (hκ₂l.add_one_lt (E.symm i').2) _ (E.symm j').2
          (Order.add_one_le_of_lt hlt) (hy1 _ (E.symm i').2)
        exact hy2 _ _ (he ▸ h1)
      rcases lt_or_gt_of_ne hne'' with h | h
      · exact key i j h hij'
      · exact key j i h hij'.symm
    have := Cardinal.mk_le_of_injective hg
    rw [Cardinal.mk_toType, Cardinal.card_ord] at this
    exact this

