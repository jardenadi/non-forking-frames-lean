/-! ## 2.4 Specific examples -/

/-- ENCODING for 2.4: the relation symbol `<`. -/
inductive OrdRelSym : ℕ → Type u
  | lt : OrdRelSym 2

/-- ENCODING for 2.4: the vocabulary `{<}`. -/
def LOrd : Language.{u, u} := ⟨fun _ => PEmpty, OrdRelSym⟩

/-- `x <^M y`. -/
def ltO (M : Model U LOrd) (x y : M.carrier) : Prop :=
  Structure.RelMap (L := LOrd) (OrdRelSym.lt : LOrd.Relations 2) ![x, y]

/-- Def 2.4.1: `M` is a transitive linear order: a (strict) linear order such that for all
`a, b ∈ M` some automorphism `f` of `M` has `f(a) = b`. -/
def IsTLO (M : Model U LOrd) : Prop :=
  (∀ x, ¬ ltO M x x) ∧ (∀ x y z, ltO M x y → ltO M y z → ltO M x z) ∧
    (∀ x y, x ≠ y → ltO M x y ∨ ltO M y x) ∧
    ∀ a b : M.carrier, ∃ f : M.carrier ≃[LOrd] M.carrier, f a = b

-- CITED, not used by any proof (removed): Lemma 2.4.2 ([Rosenstein] Cor. 8.6(2), p. 123); see docs/UNPROVED_STATEMENTS.md

/-- The connectedness component of `a` (Def 2.4.3, literally `{b ∈ M : b < a ∨ a < b}`). -/
def comp (M : Model U LOrd) (a : M.carrier) : Set M.carrier := {b | ltO M b a ∨ ltO M a b}

-- DEVIATION (encoding): for a component (not a model) "automorphism" is an order-preserving
-- bijection of the component onto itself.
/-- `C ⊆ M`, with the induced order, is a transitive linear order. -/
def IsTLOOn (M : Model U LOrd) (C : Set M.carrier) : Prop :=
  (∀ x ∈ C, ∀ y ∈ C, x ≠ y → ltO M x y ∨ ltO M y x) ∧
    ∀ x y : C, ∃ f : C ≃ C, (∀ z w : C, ltO M z w ↔ ltO M (f z) (f w)) ∧ f x = y

/-- Def 2.4.3: `M` is a transitive partial order: a (strict) partial order such that the
connectedness component of every element is a transitive linear order. -/
def IsTPO (M : Model U LOrd) : Prop :=
  (∀ x, ¬ ltO M x x) ∧ (∀ x y z, ltO M x y → ltO M y z → ltO M x z) ∧
    ∀ a, IsTLOOn M (comp M a)

/-- Def 2.4.4: the AEC of transitive partial orders: `K` = transitive partial orders whose
components are countable; `M ≼ N` iff `M ⊆ N` and no element of `M` is comparable with an
element of `N - M`. -/
def tpoKSys : KSys U LOrd :=
  ⟨{M | IsTPO M ∧ ∀ a, (comp M a).Countable}, fun M N =>
    (IsTPO M ∧ ∀ a, (comp M a).Countable) ∧ (IsTPO N ∧ ∀ a, (comp N a).Countable) ∧
    IsSubstr M N ∧ ∀ a b : N.carrier, (a : U) ∈ M.carrier → (b : U) ∉ M.carrier →
      ¬ ltO N a b ∧ ¬ ltO N b a⟩

-- AGENT-CHOICE (reading): `E` is undefined in 2.4; `aE^M` is read as `a` together with its
-- connectedness component.
/-- The class `aE^M` in Remark 2.4.7 (`E` is not defined in Subsection 2.4; read as the
connectedness component together with `a`, see docs/METHOD.md). -/
def compE (M : Model U LOrd) (a : M.carrier) : Set M.carrier := {b | b = a ∨ b ∈ comp M a}

/-! ## 2.5 Additional properties of a frame -/

/-- Def 2.5.1: `p₀ ∈ S(M₀)`, `p₁ ∈ S(M₁)` are conjugate: for some `a₀, M₀⁺, a₁, M₁⁺, f`,
`tp(aₙ, Mₙ, Mₙ⁺) = pₙ`, `f : M₀⁺ → M₁⁺` is an isomorphism, `f ↾ M₀ : M₀ → M₁` is an
isomorphism and `f(a₀) = a₁`. -/
def Conjugate (S : KSys U L) (lam : Cardinal.{u}) (M₀ : Model U L) (p₀ : Set (Tri U L))
    (M₁ : Model U L) (p₁ : Set (Tri U L)) : Prop :=
  ∃ (a₀ : U) (M₀p : Model U L) (a₁ : U) (M₁p : Model U L) (f : U → U),
    tp S lam a₀ M₀ M₀p = p₀ ∧ tp S lam a₁ M₁ M₁p = p₁ ∧ IsoOn f M₀p M₁p ∧ IsoOn f M₀ M₁ ∧
      f a₀ = a₁

/-- Def 2.5.3: for `p = tp(a, M, N)` and a bijection `f` with domain `M`,
`f(p) := tp(f(a), f[M], f⁺[N])` where `f⁺ ⊇ f` and `f⁺ : N → f⁺[N]` is an isomorphism.
`MapsType S lam f M p q` says `q = f(p)` for some representative and some such `f⁺`. -/
def MapsType (S : KSys U L) (lam : Cardinal.{u}) (f : U → U) (M : Model U L)
    (p q : Set (Tri U L)) : Prop :=
  ∃ (N : Model U L) (a : U), (M, N, a) ∈ S.K3 ∧ p = tp S lam a M N ∧
    ∃ (fp : U → U) (N' M' : Model U L), (∀ x ∈ M.carrier, fp x = f x) ∧ IsoOn fp N N' ∧
      IsoOn f M M' ∧ q = tp S lam (fp a) M' N'

/-- Def 2.5.5: the semi-good `λ`-frame `s` satisfies the conjugation property: `K_λ` is
categorical and whenever `M₁ ≼ M₂` in `K_λ` and `p₂ ∈ S^bs(M₂)` is the non-forking extension of
`p₁ ∈ S^bs(M₁)`, the types `p₁, p₂` are conjugate. -/
def ConjProp (s : Frame U L) (lam : Cardinal.{u}) : Prop :=
  numModels s.S lam = 1 ∧
    ∀ M₁ ∈ s.S.Kc lam, ∀ M₂ ∈ s.S.Kc lam, s.S.le M₁ M₂ → ∀ p₁ ∈ s.Sbs M₁, ∀ p₂ ∈ s.Sbs M₂,
      s.IsNFExt lam M₁ M₂ p₂ p₁ → Conjugate s.S lam M₁ p₁ M₂ p₂

/-- AUX: not in paper. The conjugation property includes categoricity in `λ` ("`K_λ` is
categorical", Def 2.5.5), so `K_λ ≠ ∅`. -/
theorem ConjProp.kc_nonempty {s : Frame U L} {lam : Cardinal.{u}} (h : ConjProp s lam) :
    (s.S.Kc lam).Nonempty := by
  have h1 : numModels s.S lam ≠ 0 := by rw [h.1]; exact one_ne_zero
  unfold numModels at h1
  obtain ⟨q⟩ := Cardinal.mk_ne_zero_iff.1 h1
  induction q using Quotient.inductionOn with
  | h M => exact ⟨M.1, M.2⟩

-- CITED, not used by any proof (removed): Prop 2.5.6, the transitivity proposition ([Sh:h].II Claim 2.18); see docs/UNPROVED_STATEMENTS.md

/-- Prop 2.5.7 (by [Sh:h].II Claim 2.16, cited): if `s` satisfies the axioms of a semi-good
`λ`-frame, `M₀ ≼ Mₙ` (`n < 3`), and for `n = 1, 2`, `aₙ ∈ Mₙ - M₀` with
`tp(aₙ, M₀, Mₙ) ∈ S^bs(M₀)`, then there is an amalgamation `(f₁, f₂, M₃)` of `M₁, M₂` over `M₀`
such that `tp(fₙ(aₙ), f_{3-n}[M_{3-n}], M₃)` does not fork over `M₀` (`n = 1, 2`). -/
-- CITED: proved in the paper only by reference to the literature.
-- PROOF-STAGE CHANGE (author decision): hypothesis weakened from `s.IsSemiGood lam` (original:
-- "s satisfies the axioms of a semi-good λ-frame") to `Core ∧ Ax3g ∧ Ax3e` (= `Hyp_3_0_1`,
-- defined in Section 3): the paper applies 2.5.7 under Hypothesis 3.0.1 in the proof of Prop
-- 3.1.8. The cited assumption is thus the stronger statement, as in the paper.
-- CITED: stated as a `Prop`, assumed through the field `CitedResults.prop_2_5_7`.
def Prop_2_5_7 : Prop :=
  ∀ {U : Type u} {L : Language.{u, u}}
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam)
    (M₀ M₁ M₂ : Model U L) (h₀ : M₀ ∈ s.S.Kc lam) (h₁ : M₁ ∈ s.S.Kc lam)
    (h₂ : M₂ ∈ s.S.Kc lam) (h01 : s.S.le M₀ M₁) (h02 : s.S.le M₀ M₂) (a₁ a₂ : U)
    (ha₁ : a₁ ∈ M₁.carrier \ M₀.carrier) (ha₂ : a₂ ∈ M₂.carrier \ M₀.carrier)
    (hb₁ : tp s.S lam a₁ M₀ M₁ ∈ s.Sbs M₀) (hb₂ : tp s.S lam a₂ M₀ M₂ ∈ s.Sbs M₀),
    ∃ (f₁ f₂ : U → U) (M₃ M₁' M₂' : Model U L), IsAmalgIn s.S lam f₁ f₂ M₃ M₀ M₁ M₂ ∧
      IsoOn f₁ M₁ M₁' ∧ IsoOn f₂ M₂ M₂' ∧
      s.NotFork lam M₀ M₂' (tp s.S lam (f₁ a₁) M₂' M₃) ∧
      s.NotFork lam M₀ M₁' (tp s.S lam (f₂ a₂) M₁' M₃)

