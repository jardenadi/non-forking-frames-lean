-- `plusN` (Def 11.0.1) is defined in Part 0.

-- DEVIATION (encoding): `^{<λ}λ` is encoded by pairs `(δ, η ↾ δ)` with `η ↾ δ` truncated to `0`
-- outside `δ`, so `F` cannot see `η` beyond `δ`. The quantifier order "for some F for every c
-- for some η" is kept as written (author decision Q5: it is the negation of the weak diamond,
-- which is the right definition of the ideal).
/-- Def 11.1.2: `WDmId(λ) = {A ⊆ λ : for some F : ^{<λ}λ → 2, for every c : A → 2, for some
η : λ → λ, the set {δ ∈ A : F(η ↾ δ) = c(δ)} is not stationary}`. -/
def WDmId (kap : Cardinal.{u}) : Set (Set Ordinal.{u}) :=
  {A | A ⊆ Iio kap.ord ∧ ∃ F : Ordinal.{u} → (Ordinal.{u} → Ordinal.{u}) → Bool,
    ∀ c : Ordinal.{u} → Bool, ∃ η : Ordinal.{u} → Ordinal.{u}, (∀ x < kap.ord, η x < kap.ord) ∧
      ¬ IsStationaryIn kap.ord
        {δ | δ ∈ A ∧ F δ (fun x => if x < δ then η x else 0) = c δ}}

-- AGENT-CHOICE: the preconditions "λ regular uncountable, I normal" are not part of the defined
-- property and are dropped.
/-- Def 11.1.3: the ideal `I` on `λ` is not saturated in `μ`: there are `A_i ⊆ λ` (`i < μ`) with
`A_i ∉ I` and `A_i ∩ A_j ∈ I` for `i ≠ j`. (The preconditions "`λ` regular uncountable, `I`
normal" are not part of the defined property.) -/
def NotSaturatedIn (I : Set (Set Ordinal.{u})) (kap μ : Cardinal.{u}) : Prop :=
  ∃ A : Ordinal.{u} → Set Ordinal.{u}, (∀ i < μ.ord, A i ⊆ Iio kap.ord ∧ A i ∉ I) ∧
    ∀ i j, i < μ.ord → j < μ.ord → i ≠ j → A i ∩ A j ∈ I

-- DEVIATION (author-confirmed erratum): the paper has "WDmId(λ⁺) is not saturated in λ⁺"; the
-- author confirmed it should read "not saturated in λ^{+2}" (pattern WDmId(λ^{+1+m}) not
-- saturated in λ^{+(2+m)} of Thm 11.1.5(3), Thm 11.1.7).
/-- Conjecture 11.1.4 (the uniqueness triples conjecture), as a proposition (not proved; used
as a hypothesis of Thms 1.0.2, 11.1.5, 11.1.7 and Cor 11.1.6): for a semi-good `λ`-frame `s`, if
`2^λ < 2^{λ⁺} < 2^{λ^{+2}}`, `WDmId(λ⁺)` is not saturated in `λ⁺` [erratum: in `λ^{+2}`], and
`K^{3,uq}_s` is not dense with respect to `≼_bs`, then `I(λ^{+2}, K) = 2^{λ^{+2}}`. -/
def Conjecture_11_1_4 : Prop :=
  ∀ (U' : Type u) (L' : Language.{u, u}) (s : Frame U' L') (lam : Cardinal.{u}),
    Room U' lam → s.IsSemiGood lam → (2 : Cardinal.{u}) ^ lam < 2 ^ (Order.succ lam) →
    (2 : Cardinal.{u}) ^ (Order.succ lam) < 2 ^ (plusN lam 2) →
    NotSaturatedIn (WDmId (Order.succ lam)) (Order.succ lam) (plusN lam 2) →
    ¬ s.Dense lam (s.K3uq lam) → numModels s.S (plusN lam 2) = 2 ^ (plusN lam 2)


/-- AUX: not in paper. Under Hypothesis 10.1.2 with `K_λ ≠ ∅` there is a model of cardinality
`λ^{+2}` (a `≺⁺`-chain of length `λ^{+2}` in `K^sat`, unions by Thm 7.1.18(a)). -/
theorem Frame.exists_Kc_plus2 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_10_1_2 s lam) (hne : (s.S.Kc lam).Nonempty) : (s.S.Kc (plusN lam 2)).Nonempty := by
  classical
  obtain ⟨hinf, ⟨M₀, kM₀⟩⟩ := Frame.hyp10_facts hU hs hne
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf₂ : ℵ₀ ≤ plusN lam 2 := hinf.trans ((Order.le_succ lam).trans (Order.le_succ _))
  have hκ₂l : Order.IsSuccLimit (plusN lam 2).ord := Cardinal.isSuccLimit_ord hinf₂
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c =>
    α < (plusN lam 2).ord → c α ∈ s.Ksat lam ∧ (∀ β < α, s.leNF lam (c β) (c α) ∧ c β ≠ c α) ∧
      (Order.IsSuccLimit α → IsUnionOf c (Iio α) (c α))
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' e h hα
    obtain ⟨h1, h2, h3⟩ := h hα
    have eα := e α le_rfl
    refine ⟨eα ▸ h1, fun β hβ => by rw [← eα, ← e β hβ.le]; exact h2 β hβ, fun hl => ?_⟩
    rw [← eα]; exact (h3 hl).congr' fun β hβ => e β (le_of_lt hβ)
  have : Nonempty (Model U L) := ⟨M₀⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (plusN lam 2).ord Inv hloc (by
    intro α hαθ c ih
    by_cases hα : α < (plusN lam 2).ord
    swap
    · exact ⟨M₀, fun h => absurd h hα⟩
    have ih' : ∀ β < α, _ := fun β hβ => ih β hβ (hβ.trans hα)
    suffices hx : ∃ x : Model U L, x ∈ s.Ksat lam ∧ (∀ β < α, s.leNF lam (c β) x ∧ c β ≠ x) ∧
        (Order.IsSuccLimit α → IsUnionOf c (Iio α) x) by
      obtain ⟨x, h1, h2, h3⟩ := hx
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, fun β hβ => ?_, fun hl => (h3 hl).congr' fun β hβ => ?_⟩
      · simp only [hβ, ite_true]; exact h2 β hβ
      · have : β < α := hβ
        simp only [this, ite_true]
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨η, hη⟩ | hl
    · subst h0
      exact ⟨M₀, kM₀, fun β hβ => absurd hβ (not_lt.2 zero_le),
        fun hl => absurd hl Order.not_isSuccLimit_bot⟩
    · have hη' : α = η + 1 := hη.symm
      subst hη'
      have hηlt : η < η + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨kη, ltη, -⟩ := ih' η hηlt
      obtain ⟨x, hx⟩ := prop_7_1_12_a lam hU s hs7 hinf _ kη.1
      have kx := prop_7_1_10_b lam hU s hs7 _ _ hx
      have nx := prop_7_1_10_a lam hU s hs7 _ _ hx
      refine ⟨x, kx, fun β hβ => ?_, fun hl => absurd hl fun hl' => lt_irrefl _ (hl'.add_one_lt hηlt)⟩
      rcases (Order.lt_succ_iff.1 hβ).lt_or_eq with h | h
      · refine ⟨Frame.leNF_trans hU hs6 (ltη β h).1 nx.1, fun e => ?_⟩
        obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt ⟨nx.1.2.2.1, nx.2⟩
        exact hyn (hS.sub (ltη β h).1.2.2.1 (e ▸ hy))
      · rw [h]; exact nx
    · have hnf : IsIncreasing (s.leNF lam) c (Iio α) := fun a' _ b' hb h' => ((ih' b' hb).2.1 a' h').1
      have hco : IsContinuous c (Iio α) := fun β hβ hl' => ((ih' β hβ).2.2 hl').1
      obtain ⟨V, uV, kV, -⟩ := thm_7_1_18_a lam hU s hs7 α hl hα c
        (fun a' ha b' hb h' => ⟨(ih' a' ha).1, (ih' b' hb).1, hnf a' ha b' hb h'⟩) hco
      have lV : ∀ β < α, s.leNF lam (c β) V := fun β hβ =>
        Frame.leNF_of_union hU hs6 hinf hl hα hnf hco uV hβ
      refine ⟨V, kV, fun β hβ => ⟨lV β hβ, fun e => ?_⟩, fun _ => uV⟩
      have hβ1 : β + 1 < α := hl.add_one_lt hβ
      have l1 := (ih' (β + 1) hβ1).2.1 β (Order.lt_add_one_iff.2 le_rfl)
      obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt ⟨l1.1.2.2.1, l1.2⟩
      exact hyn (e ▸ hS.sub (lV _ hβ1).2.2.1 hy))
  have hI : ∀ α < (plusN lam 2).ord, _ := fun α hα => hcI α hα.le hα
  have hi : IsIncreasing s.S.le c (Iio (plusN lam 2).ord) := fun a' _ b' hb h' =>
    ((hI b' hb).2.1 a' h').1.2.2.1
  have hco : IsContinuous c (Iio (plusN lam 2).ord) := fun β hβ hl' => ((hI β hβ).2.2 hl').1
  obtain ⟨N, hN, kN, -⟩ := hS.union _ hκ₂l c hi hco
  refine ⟨N, kN, le_antisymm ?_ ?_⟩
  · show #N.carrier ≤ _
    rw [hN.1]
    exact card_biUnion_le hinf₂ (by rw [Cardinal.card_ord]) fun β hβ =>
      (le_of_eq (hI β hβ).1.1.2).trans (Order.le_succ _)
  · have hdiff : ∀ β, β < (plusN lam 2).ord → ∃ y ∈ (c (β + 1)).carrier, y ∉ (c β).carrier :=
      fun β hβ => by
        have l1 := (hI (β + 1) (hκ₂l.add_one_lt hβ)).2.1 β (Order.lt_add_one_iff.2 le_rfl)
        exact hS.exists_diff_of_lt ⟨l1.1.2.2.1, l1.2⟩
    choose y hy1 hy2 using hdiff
    let E := Ordinal.ToType.mk (o := (plusN lam 2).ord)
    have hsubc : ∀ a < (plusN lam 2).ord, ∀ b < (plusN lam 2).ord, a ≤ b →
        (c a).carrier ⊆ (c b).carrier := fun a ha b hb h => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub (hi a ha b hb h')
      · rw [h']
    let g : (plusN lam 2).ord.ToType → N.carrier := fun i =>
      ⟨y (E.symm i) (E.symm i).2, by
        rw [hN.1]
        exact Set.mem_iUnion₂.2 ⟨_, hκ₂l.add_one_lt (E.symm i).2, hy1 _ _⟩⟩
    have hg : Function.Injective g := by
      intro i j hij
      have hij' := congrArg Subtype.val hij
      simp only [g] at hij'
      by_contra hne'
      have hne'' : (E.symm i : Ordinal.{u}) ≠ E.symm j := fun e =>
        hne' (E.symm.injective (Subtype.ext e))
      have key : ∀ i' j' : (plusN lam 2).ord.ToType, (E.symm i' : Ordinal.{u}) < E.symm j' →
          y (E.symm i') (E.symm i').2 ≠ y (E.symm j') (E.symm j').2 := by
        intro i' j' hlt he
        have h1 := hsubc _ (hκ₂l.add_one_lt (E.symm i').2) _ (E.symm j').2
          (Order.add_one_le_of_lt hlt) (hy1 _ (E.symm i').2)
        exact hy2 _ _ (he ▸ h1)
      rcases lt_or_gt_of_ne hne'' with h | h
      · exact key i j h hij'
      · exact key j i h hij'.symm
    have := Cardinal.mk_le_of_injective hg
    rw [Cardinal.mk_toType, Cardinal.card_ord] at this
    exact this

/-- AUX: not in paper. Thm 11.1.1(2): `s⁺` has the conjugation property. -/
theorem Frame.splus_conj [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_10_1_2 s lam)
    (hne : (s.S.Kc lam).Nonempty) : ConjProp (s.splus lam) (Order.succ lam) := by
  classical
  obtain ⟨hinf, hKs⟩ := Frame.hyp10_facts hU hs hne
  have hs6 : Hyp_6_1_1 s lam := ⟨hs.1, hs.2.2, hs.2.1.1⟩
  have hs7 : Hyp_7_1_1 s lam := hs6
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hsg : s.IsSemiGoodExceptLC lam := ⟨hs.1.1, hs.1.2.1, hs.1.2.2.1, hs.1.2.2.2.1⟩
  obtain ⟨hA, hK, hle, hL⟩ := Frame.up_facts hU hs hinf hKs
  have kc' : ∀ X, X ∈ (s.upKSys lam).Kc (Order.succ lam) → X ∈ s.Ksat lam := fun X hX => by
    rw [← hK]; exact hX
  have hgt : ∀ X : Model U L, X ∈ s.Ksat lam → lam < X.card := fun X hX => by
    rw [hX.1.2]; exact Order.lt_succ_of_not_isMax (not_isMax lam)
  have kG : ∀ X : Model U L, X ∈ s.Ksat lam → X ∈ s.S.KGe lam := fun X hX => ⟨hX.1.1, (hgt X hX).le⟩
  have isoNF : ∀ {f : U → U} {X Y X' Y' : Model U L}, s.leNF lam X Y → IsoOn f Y Y' →
      IsoOn f X X' → s.leNF lam X' Y' := fun {f X Y X' Y'} h iY iX => by
    obtain ⟨-, X'', iX'', l⟩ := Frame.leNF_iso hU hs6 X Y Y' f h.2.1 h iY
    rwa [iX''.unique iX] at l
  refine ⟨?_, ?_⟩
  · unfold numModels
    rw [Cardinal.eq_one_iff_unique]
    obtain ⟨M, kM⟩ := hKs
    have kMu : M ∈ (s.splus lam).S.Kc (Order.succ lam) := by
      show M ∈ (s.upKSys lam).Kc (Order.succ lam); rw [hK]; exact kM
    refine ⟨⟨fun x y => ?_⟩, ⟨Quotient.mk _ ⟨M, kMu⟩⟩⟩
    induction x using Quotient.inductionOn with
    | h X =>
    induction y using Quotient.inductionOn with
    | h Y =>
    apply Quotient.sound
    obtain ⟨f, ⟨g, -⟩⟩ := C.thm_1_0_32_2 lam hU s.S hS hc.ax1b hc.ax0b X.1 Y.1 (kc' _ X.2) (kc' _ Y.2)
      hc.ax1a
    exact ⟨g⟩
  · intro M₁ kM₁ M₂ kM₂ l12 p₁ hp₁ p₂ hp₂ hext
    have k1 := kc' _ kM₁
    have k2 := kc' _ kM₂
    have n12 : s.leNF lam M₁ M₂ := ((hle _ k1 _ k2).1 l12).2.2
    obtain ⟨⟨b, N₂, rfl, -, -, kN₂, -, l2N, hnf⟩, hres⟩ := hext
    have hres' := res_tp (lam := Order.succ lam) (a := b) (N := N₂) hA l12
    have hp₁e : p₁ = s.tpPlus lam b M₁ N₂ := hres.symm.trans hres'
    obtain ⟨N, kN, lNM₁, hNf⟩ := Frame.notForkGe_wit hc hnf
    have hK3 := (Frame.mem_of_notForkGe hnf).1
    have hbM₂ := (Frame.mem_of_notForkGe hnf).2
    have lNM₂ := hS.trans lNM₁ n12.2.2.1
    obtain ⟨f, iff', fov⟩ := C.thm_1_0_32_1 lam hU s.S hS hc.ax1b hc.ax0b N M₁ M₂ kN lNM₁ lNM₂ k1 k2
    have hsmN₂ : #N₂.carrier < #U := by
      rw [show #N₂.carrier = Order.succ lam from kN₂.1.2]; exact hU.succ.2
    have n1N₂ := Frame.leNF_trans hU hs6 n12 l2N
    obtain ⟨σ, hσ⟩ := exists_perm_ext hU.infinite (iff'.injOn.mono (fun x hx => hx)) (X := M₁.carrier)
      (by rw [show #M₁.carrier = Order.succ lam from k1.1.2]; exact hU.succ.2)
    have hσM₁ : IsoOn σ M₁ M₂ := iff'.congr fun x hx => (hσ x hx).symm
    have hσN : ∀ x ∈ N.carrier, σ x = x := fun x hx => by
      rw [hσ x (hS.sub lNM₁ hx)]; exact fov.2 x hx
    have fixN : IsoOn σ N N := (IsoOn.refl N).congr fun x hx => (hσN x hx).symm
    have iP := permModel_iso σ N₂
    have nM₂P : s.leNF lam M₂ (permModel σ N₂) := isoNF n1N₂ iP hσM₁
    have kP : permModel σ N₂ ∈ s.Ksat lam := Saturated.iso hU hc hinf kN₂ iP
    have nf₁ := (thm_2_6_8_2 lam hU s hsg N M₁ M₂ lNM₁ n12.2.2.1 ⟨kN.1, kN.2.ge⟩ (kG _ k1) (kG _ k2)
      (hgt _ k2) _ (Frame.sbsGe_of_notForkGe hc hNf) hNf).2
    rw [res_tp hS n12.2.2.1] at nf₁
    have nf₂ := Frame.notForkGe_iso hU hc nf₁ hsmN₂ iP fixN hσM₁
    have lNP : s.S.le N (permModel σ N₂) := hS.trans lNM₂ nM₂P.2.2.1
    have htN : tp s.S lam (σ b) N (permModel σ N₂) = tp s.S lam b N N₂ :=
      (tp_emb hS ⟨kN.1, kN₂.1.1, hS.trans lNM₂ l2N.2.2.1, hK3.2.2.2⟩ lNP
        ⟨kN₂.1.1, kP.1.1, permModel σ N₂, hS.refl kP.1.1, iP⟩ hσN).symm
    have eM := cor_7_1_17_c lam hU s hs7 M₂ (permModel σ N₂) N₂ k2.1 kP.1 kN₂.1 nM₂P l2N (σ b) b
      ⟨N, kN, nf₂, hNf, htN⟩
    have hσb := Frame.mem_of_notForkGe nf₂
    have e := (prop_10_1_4 lam hU s hs hinf M₂ (permModel σ N₂) N₂ k2 kP kN₂ nM₂P l2N (σ b) b
      ⟨hσb.1.2.2.2, hσb.2⟩ ⟨hK3.2.2.2, hbM₂⟩).2 eM
    exact ⟨b, N₂, σ b, permModel σ N₂, σ, hp₁e.symm, e, iP, hσM₁, rfl⟩

/-- AUX: not in paper. Thm 11.1.1 (items (1)–(4)). Item (4) applies Prop 3.1.9 to `s⁺` and uses
`K⁺ ⊆ K` (`Frame.up_sub`, from the widened Fact 1.0.18). -/
theorem Frame.thm_11_1_1_123 [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam) (h2 : s.Dense lam (s.K3uq lam))
    (h3 : numModels s.S (plusN lam 2) < 2 ^ (plusN lam 2)) (hne : (s.S.Kc lam).Nonempty) :
    ((s.splus lam).IsGood (Order.succ lam) ∧ s.Ksat lam ⊆ s.S.Kc (Order.succ lam) ∧
      ∀ M ∈ s.Ksat lam, ∀ N ∈ s.Ksat lam, s.leNF lam M N → s.S.le M N) ∧
    ConjProp (s.splus lam) (Order.succ lam) ∧ (s.S.Kc (plusN lam 2)).Nonempty ∧
      (s.S.Kc (plusN lam 3)).Nonempty := by
  have hex : s.ExistProp lam (s.K3uq lam) := prop_4_1_12_1 lam hU s h1.1 h2 h1.2
  have hsm : ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.satKSys lam).AxSmooth δ := by
    by_contra hns
    exact absurd h3 (not_lt.2 (thm_7_1_3 lam hU s ⟨h1.1, h1.2, hex⟩ hns))
  have hs10 : Hyp_10_1_2 s lam := ⟨h1.1, ⟨hex, hsm⟩, h1.2⟩
  have hs := hs10
  have hgood := thm_10_1_9 lam hU s hs10
  obtain ⟨hinf, hKs⟩ := Frame.hyp10_facts hU hs10 hne
  have hne' : ((s.splus lam).S.Kc (Order.succ lam)).Nonempty := by
    rw [Frame.splus_Kc hU hs10 hinf hKs]; exact hKs
  obtain ⟨M, kM⟩ := (prop_3_1_9 (Order.succ lam) hU.succ (s.splus lam)
    ⟨hgood.1, hgood.2.1, hgood.2.2.1⟩ hne').2
  exact ⟨⟨hgood, fun M hM => hM.1, fun M _ N _ h => h.2.2.1⟩,
    Frame.splus_conj hU hs10 hne, Frame.exists_Kc_plus2 hU hs10 hne,
    ⟨M, (Frame.up_sub hs.1.1).1 M kM.1, kM.2⟩⟩


/-- AUX: not in paper. `λ^{+(1+m)} = (λ^{+m})⁺`. -/
theorem plusN_succ (lam : Cardinal.{u}) (m : ℕ) : Order.succ (plusN lam m) = plusN lam (1 + m) := by
  unfold plusN
  rw [Function.iterate_add_apply]; rfl

/-- AUX: not in paper. `λ^{+(2+m)} = (λ^{+m})^{+2}`. -/
theorem plusN_two (lam : Cardinal.{u}) (m : ℕ) : plusN (plusN lam m) 2 = plusN lam (2 + m) := by
  unfold plusN
  rw [Function.iterate_add_apply]

/-- AUX: not in paper. -/
theorem plusN_le (lam : Cardinal.{u}) (m : ℕ) : lam ≤ plusN lam m := by
  induction m with
  | zero => exact le_rfl
  | succ m ih =>
    unfold plusN at *
    rw [Function.iterate_succ_apply']
    exact ih.trans (Order.le_succ _)

/-- AUX: not in paper. -/
theorem Room.iter {lam : Cardinal.{u}} (hU : Room U lam) (m : ℕ) : Room U (plusN lam m) := by
  induction m with
  | zero => exact hU
  | succ m ih =>
    have : plusN lam (m + 1) = Order.succ (plusN lam m) := by
      unfold plusN; rw [Function.iterate_succ_apply']
    rw [this]; exact ih.succ

/-- AUX: not in paper. A class included in another one has at most as many models up to
isomorphism. -/
theorem numModels_mono {S T : KSys U L} {κ : Cardinal.{u}} (h : T.Kc κ ⊆ S.Kc κ) :
    numModels T κ ≤ numModels S κ := by
  let g : Quotient (isoSetoid T κ) → Quotient (isoSetoid S κ) :=
    Quotient.map (fun M => ⟨M.1, h M.2⟩) (fun _ _ e => e)
  refine Cardinal.mk_le_of_injective (f := g) ?_
  intro x y hxy
  induction x using Quotient.inductionOn with
  | h X =>
  induction y using Quotient.inductionOn with
  | h Y =>
  have e : (Quotient.mk _ ⟨X.1, h X.2⟩ : Quotient (isoSetoid S κ)) = Quotient.mk _ ⟨Y.1, h Y.2⟩ := hxy
  have r : Nonempty (X.1.carrier ≃[L] Y.1.carrier) := Quotient.exact e
  exact Quotient.sound r

/-- AUX: not in paper. The frames `sⁿ` of Cor 11.1.6: `s⁰ = s`, `s^{n+1} = (sⁿ)⁺`. -/
noncomputable def Frame.tower (s : Frame U L) (lam : Cardinal.{u}) : ℕ → Frame U L
  | 0 => s
  | m + 1 => (Frame.tower s lam m).splus (plusN lam m)

/-- AUX: not in paper. The induction of Cor 11.1.6. -/
theorem Frame.tower_spec [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (n : ℕ)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam) (hne : (s.S.Kc lam).Nonempty)
    (h3 : ∀ m < n, numModels s.S (plusN lam (2 + m)) < 2 ^ (plusN lam (2 + m)))
    (h4 : (∀ m < n + 1, (2 : Cardinal.{u}) ^ (plusN lam m) < 2 ^ (plusN lam (m + 1))) ∧
      ∀ m < n, NotSaturatedIn (WDmId (plusN lam (1 + m))) (plusN lam (1 + m)) (plusN lam (2 + m)))
    (h5 : Conjecture_11_1_4.{u}) :
    ∀ m ≤ n, (s.tower lam m).IsSemiGood (plusN lam m) ∧ ConjProp (s.tower lam m) (plusN lam m) ∧
      ((s.tower lam m).S.Kc (plusN lam m)).Nonempty ∧ (∀ M ∈ (s.tower lam m).S.K, M ∈ s.S.K) ∧
      (∀ M N, (s.tower lam m).S.le M N → s.S.le M N) ∧
      (0 < m → (s.tower lam m).IsGood (plusN lam m)) := by
  intro m
  induction m with
  | zero => intro _; exact ⟨h1.1, h1.2, hne, fun M h => h, fun M N h => h, fun h => absurd h (lt_irrefl 0)⟩
  | succ m ih =>
    intro hm
    have hmn : m < n := Nat.lt_of_succ_le hm
    obtain ⟨sg, cj, ne, inK, inle, -⟩ := ih hmn.le
    set t := s.tower lam m with ht
    set μ := plusN lam m with hμ
    have hU' : Room U μ := hU.iter m
    have hsucc : Order.succ μ = plusN lam (m + 1) := by
      rw [hμ]; unfold plusN; rw [Function.iterate_succ_apply']
    have hS : IsAEC s.S := h1.1.1.ax0a
    have hsub2 : t.S.Kc (plusN μ 2) ⊆ s.S.Kc (plusN μ 2) := fun M hM => ⟨inK M hM.1, hM.2⟩
    have hnum : numModels t.S (plusN μ 2) < 2 ^ (plusN μ 2) := by
      rw [plusN_two]
      exact lt_of_le_of_lt (numModels_mono (by rw [← plusN_two]; exact hsub2)) (h3 m hmn)
    have hD : t.Dense μ (t.K3uq μ) := by
      by_contra hd
      have e := h5 U L t μ hU' sg (by rw [plusN_succ, Nat.add_comm]; exact h4.1 m (by omega))
        (by rw [plusN_succ, plusN_two, show 2 + m = (1 + m) + 1 by omega]; exact h4.1 (1 + m) (by omega))
        (by rw [plusN_succ, plusN_two]; exact h4.2 m hmn) hd
      exact (lt_irrefl _) (e ▸ hnum)
    obtain ⟨⟨hgood, -, -⟩, hconj, -, -⟩ := Frame.thm_11_1_1_123 hU' ⟨sg, cj⟩ hD hnum ne
    have hex : t.ExistProp μ (t.K3uq μ) := prop_4_1_12_1 μ hU' t sg hD cj
    have hsm : ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (t.satKSys μ).AxSmooth δ := by
      by_contra hns
      exact absurd hnum (not_lt.2 (thm_7_1_3 μ hU' t ⟨sg, cj, hex⟩ hns))
    have hs10 : Hyp_10_1_2 t μ := ⟨sg, ⟨hex, hsm⟩, cj⟩
    obtain ⟨hinf, hKs⟩ := Frame.hyp10_facts hU' hs10 ne
    have hT : s.tower lam (m + 1) = t.splus μ := rfl
    rw [hT, ← hsucc]
    obtain ⟨u1, u2⟩ := Frame.up_sub (s := t) (lam := μ) sg.1
    refine ⟨⟨hgood.1, hgood.2.1, hgood.2.2.1, fun M hM => (hgood.2.2.2.1 M hM).trans
      (Order.le_succ _), hgood.2.2.2.2⟩, Frame.splus_conj hU' hs10 ne, ?_,
      fun M hM => inK M (u1 M hM), fun M N h => inle M N (u2 M N h), fun _ => hgood⟩
    rw [Frame.splus_Kc hU' hs10 hinf hKs]; exact hKs

/-- Thm 11.1.1 (= Thm 1.0.1): suppose (1) `s` is a semi-good `λ`-frame with conjugation,
(2) `K^{3,uq}` is dense with respect to `≼_bs`, (3) `I(λ^{+2}, K) < 2^{λ^{+2}}`. Then
(1) `s⁺ = ((K^sat, ≼^NF ↾ K^sat)^up, S^{bs,+}, ⨿⁺)` is a good `λ⁺`-frame, `K^sat ⊆ K_{λ⁺}` and
`≼^NF ↾ K^sat ⊆ ≼ ↾ K^sat`; (2) `s⁺` satisfies the conjugation property; (3) there is a model in
`K` of cardinality `λ^{+2}`; (4) there is a model in `K` of cardinality `λ^{+3}`. -/
theorem thm_11_1_1 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam) (h2 : s.Dense lam (s.K3uq lam))
    (h3 : numModels s.S (plusN lam 2) < 2 ^ (plusN lam 2)) :
    ((s.splus lam).IsGood (Order.succ lam) ∧ s.Ksat lam ⊆ s.S.Kc (Order.succ lam) ∧
      ∀ M ∈ s.Ksat lam, ∀ N ∈ s.Ksat lam, s.leNF lam M N → s.S.le M N) ∧
    ConjProp (s.splus lam) (Order.succ lam) ∧
    (s.S.Kc (plusN lam 2)).Nonempty ∧ (s.S.Kc (plusN lam 3)).Nonempty := by
  -- `K_λ ≠ ∅` comes from categoricity in `λ`, part of the conjugation property (Def 2.5.5).
  exact Frame.thm_11_1_1_123 hU h1 h2 h3 h1.2.kc_nonempty

-- DEVIATION (typo fixed to evident intent): conclusion (1) names the frame
-- `(K^sat, ≼^NF ↾ K^sat, S^{bs,+}, ⨿⁺)` without `up`; fixed to `s⁺` with `up` (as in Thm 11.1.1).
-- Hypothesis (3) "not saturated in λ^{+2}" is kept exactly as written (it is correct; the
-- erratum is in Conjecture 11.1.4).
/-- Thm 11.1.5: suppose (1) `s` is a semi-good `λ`-frame with conjugation,
(2) `I(λ^{+2}, K) < 2^{λ^{+2}}`, (3) `2^λ < 2^{λ⁺} < 2^{λ^{+2}}` and `WDmId(λ⁺)` is not saturated
in `λ^{+2}`, (4) Conjecture 11.1.4. Then (1)–(4) as in Thm 11.1.1 for
`s⁺ = (K^sat, ≼^NF ↾ K^sat, S^{bs,+}, ⨿⁺)` [typo: `((K^sat, ≼^NF ↾ K^sat)^up, S^{bs,+}, ⨿⁺)`]. -/
theorem thm_11_1_5 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam) (h2 : numModels s.S (plusN lam 2) < 2 ^ (plusN lam 2))
    (h3 : (2 : Cardinal.{u}) ^ lam < 2 ^ (Order.succ lam) ∧
      (2 : Cardinal.{u}) ^ (Order.succ lam) < 2 ^ (plusN lam 2) ∧
      NotSaturatedIn (WDmId (Order.succ lam)) (Order.succ lam) (plusN lam 2))
    (h4 : Conjecture_11_1_4.{u}) :
    ((s.splus lam).IsGood (Order.succ lam) ∧ s.Ksat lam ⊆ s.S.Kc (Order.succ lam) ∧
      ∀ M ∈ s.Ksat lam, ∀ N ∈ s.Ksat lam, s.leNF lam M N → s.S.le M N) ∧
    ConjProp (s.splus lam) (Order.succ lam) ∧
    (s.S.Kc (plusN lam 2)).Nonempty ∧ (s.S.Kc (plusN lam 3)).Nonempty := by
  have hD : s.Dense lam (s.K3uq lam) := by
    by_contra hd
    have e := h4 U L s lam hU h1.1 h3.1 h3.2.1 h3.2.2 hd
    exact (lt_irrefl _) (e ▸ h2)
  exact thm_11_1_1 lam hU s h1 hD h2

-- AGENT-CHOICE (reading): in conclusion (1), "≤ⁿ is included in ⪯ᵏ ↾ Kⁿ" (`k` undefined) is read
-- as "included in ≼ ↾ Kⁿ". The frame `sⁿ` is taken over the same vocabulary and ambient type.
/-- Cor 11.1.6: suppose (1) `n < ω`, (2) `s` is a semi-good `λ`-frame with conjugation,
(3) `I(λ^{+(2+m)}, K) < 2^{λ^{+(2+m)}}` for `m < n`, (4) `2^{λ^{+m}} < 2^{λ^{+(m+1)}}` for
`m < n+1` and `WDmId(λ^{+1+m})` is not saturated in `λ^{+(2+m)}` for `m < n`, (5) Conjecture
11.1.4. Then there is a good `λ^{+n}`-frame `sⁿ = ((Kⁿ, ≤ⁿ), S^{bs,+n}, ⨿^{+n})` with
(1) `Kⁿ_{λ^{+n}} ⊆ K_{λ^{+n}}` and `≤ⁿ ⊆ ≼ ↾ Kⁿ`, (2) conjugation, (3) a model in `Kⁿ` of
cardinality `λ^{+(2+n)}`. -/
theorem cor_11_1_6 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (n : ℕ)
    -- PROOF-STAGE CHANGE: added `0 < n`. For `n = 0` the conclusion asks for a good `λ`-frame,
    -- while `s` is only semi-good and hypotheses (3) and the `WDmId` part of (4) are vacuous; the
    -- paper's proof ("by induction on n, using Theorem 11.1.5") produces a good frame only at
    -- `n ≥ 1` (`s¹ = s⁺`, Thm 10.1.9).
    (hn : 0 < n)
    (h2 : s.IsSemiGood lam ∧ ConjProp s lam)
    (h3 : ∀ m < n, numModels s.S (plusN lam (2 + m)) < 2 ^ (plusN lam (2 + m)))
    (h4 : (∀ m < n + 1, (2 : Cardinal.{u}) ^ (plusN lam m) < 2 ^ (plusN lam (m + 1))) ∧
      ∀ m < n, NotSaturatedIn (WDmId (plusN lam (1 + m))) (plusN lam (1 + m)) (plusN lam (2 + m)))
    (h5 : Conjecture_11_1_4.{u}) :
    ∃ sn : Frame U L, sn.IsGood (plusN lam n) ∧
      sn.S.Kc (plusN lam n) ⊆ s.S.Kc (plusN lam n) ∧
      (∀ M ∈ sn.S.K, ∀ N ∈ sn.S.K, sn.S.le M N → s.S.le M N) ∧
      ConjProp sn (plusN lam n) ∧ (sn.S.Kc (plusN lam (2 + n))).Nonempty := by
  obtain ⟨sg, cj, ne, inK, inle, gd⟩ :=
    Frame.tower_spec hU n h2 h2.2.kc_nonempty h3 h4 h5 n le_rfl
  -- (3): Prop 3.1.9(2) for `sⁿ` at `λ^{+n}`.
  obtain ⟨M, kM⟩ := (prop_3_1_9 (plusN lam n) (hU.iter n) (s.tower lam n)
    ⟨sg.1, sg.2.1, sg.2.2.1⟩ ne).2
  refine ⟨s.tower lam n, gd hn, fun M hM => ⟨inK M hM.1, hM.2⟩, fun M _ N _ h => inle M N h, cj,
    ?_⟩
  rw [← plusN_two]; exact ⟨M, kM⟩

-- AGENT-CHOICE (reading): in (3) the first `m` is unquantified; read as "for every m". The
-- conclusion "a model in Kⁿ of cardinality λ^{+n}" uses `Kⁿ`, which is not defined in the
-- statement (it comes from Cor 11.1.6); read as "a model in K of cardinality λ^{+n}".
/-- Thm 11.1.7 (= Thm 1.0.2 with `I(…) < 2^{…}` in (2)): suppose (1) `s` is a semi-good
`λ`-frame with conjugation, (2) `I(λ^{+(2+m)}, K) < 2^{λ^{+(2+m)}}` for `m < ω`,
(3) `2^{λ^{+m}} < 2^{λ^{+m+1}}` and `WDmId(λ^{+1+m})` is not saturated in `λ^{+(2+m)}` for every
`m < ω`, (4) Conjecture 11.1.4. Then for every `n < ω` there is a model of cardinality
`λ^{+n}`. -/
theorem thm_11_1_7 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam)
    (h2 : ∀ m : ℕ, numModels s.S (plusN lam (2 + m)) < 2 ^ (plusN lam (2 + m)))
    (h3 : (∀ m : ℕ, (2 : Cardinal.{u}) ^ (plusN lam m) < 2 ^ (plusN lam (m + 1))) ∧
      ∀ m : ℕ, NotSaturatedIn (WDmId (plusN lam (1 + m))) (plusN lam (1 + m)) (plusN lam (2 + m)))
    (h4 : Conjecture_11_1_4.{u}) :
    ∀ n : ℕ, (s.S.Kc (plusN lam n)).Nonempty := by
  -- The paper: "By Corollary 11.1.6". Here directly from the tower `sⁿ` (`Frame.tower_spec`),
  -- which also covers `n = 0` (where Cor 11.1.6 needs `0 < n`).
  intro n
  obtain ⟨-, -, ⟨M, kM⟩, inK, -, -⟩ := Frame.tower_spec hU n h1 h1.2.kc_nonempty
    (fun m _ => h2 m) ⟨fun m _ => h3.1 m, fun m _ => h3.2 m⟩ h4 n le_rfl
  exact ⟨M, inK M kM.1, kM.2⟩

/-- Thm 1.0.1 (stated in Section 1; proved as Thm 11.1.1, same statement). -/
theorem thm_1_0_1 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam) (h2 : s.Dense lam (s.K3uq lam))
    (h3 : numModels s.S (plusN lam 2) < 2 ^ (plusN lam 2)) :
    ((s.splus lam).IsGood (Order.succ lam) ∧ s.Ksat lam ⊆ s.S.Kc (Order.succ lam) ∧
      ∀ M ∈ s.Ksat lam, ∀ N ∈ s.Ksat lam, s.leNF lam M N → s.S.le M N) ∧
    ConjProp (s.splus lam) (Order.succ lam) ∧
    (s.S.Kc (plusN lam 2)).Nonempty ∧ (s.S.Kc (plusN lam 3)).Nonempty := by
  -- `K_λ ≠ ∅` comes from categoricity in `λ`, part of the conjugation property (Def 2.5.5).
  exact Frame.thm_11_1_1_123 hU h1 h2 h3 h1.2.kc_nonempty

-- AGENT-CHOICE (reading): `μ_unif` is not defined in the paper; it is a parameter `μunif`. As in
-- Thm 11.1.7, the first `m` in (3) is read as "for every m", and "a model in Kⁿ" as "a model in
-- K" (`Kⁿ` is not defined in the statement).
/-- Thm 1.0.2: suppose (1) `s` is a semi-good `λ`-frame with conjugation,
(2) `I(λ^{+(2+m)}, K) < μ_unif(λ^{+(2+m)}, 2^{λ^{+(1+m)}})` for `m < ω`, (3) `2^{λ^{+m}} <
2^{λ^{+m+1}}` and `WDmId(λ^{+1+m})` is not saturated in `λ^{+(2+m)}` for every `m < ω`,
(4) Conjecture 11.1.4. Then there is a model of cardinality `λ^{+n}` for every `n < ω`. -/
theorem thm_1_0_2 [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (μunif : Cardinal.{u} → Cardinal.{u} → Cardinal.{u})
    (h1 : s.IsSemiGood lam ∧ ConjProp s lam)
    (h2 : ∀ m : ℕ, numModels s.S (plusN lam (2 + m)) < μunif (plusN lam (2 + m))
      (2 ^ (plusN lam (1 + m))))
    -- PROOF-STAGE CHANGE: added `hunif`: `μ_unif(λ^{+(2+m)}, 2^{λ^{+(1+m)}}) ≤ 2^{λ^{+(2+m)}}` for
    -- every `m`. `μ_unif` is defined only inside a `\begin{comment}` block of Section 11, together
    -- with Prop `unifleq`: "For every μ, μ_unif(μ⁺, 2^μ) ≤ 2^{μ⁺}" (proof: "Easy."). The hypothesis
    -- is that proposition at `μ = λ^{+(1+m)}`. Without it `μunif` is an arbitrary function and (2)
    -- says nothing; with it (2) implies hypothesis (2) of Thm 11.1.7.
    (hunif : ∀ m : ℕ, μunif (plusN lam (2 + m)) (2 ^ (plusN lam (1 + m))) ≤
      2 ^ (plusN lam (2 + m)))
    (h3 : (∀ m : ℕ, (2 : Cardinal.{u}) ^ (plusN lam m) < 2 ^ (plusN lam (m + 1))) ∧
      ∀ m : ℕ, NotSaturatedIn (WDmId (plusN lam (1 + m))) (plusN lam (1 + m)) (plusN lam (2 + m)))
    (h4 : Conjecture_11_1_4.{u}) :
    ∀ n : ℕ, (s.S.Kc (plusN lam n)).Nonempty :=
  thm_11_1_7 lam hU s h1 (fun m => (h2 m).trans_le (hunif m)) h3 h4

/-- AUX: not in paper (the function `μ_unif` of Thm 1.0.2; definition from [Sh:88r], as in the
author's screenshot, confirmed by the author 2026-11-25; see
`docs/MUUNIF_DEFINITION.md`, section 1).
`μ_unif(λ⁺, χ)` is the first cardinal `μ` such that there is `⟨c_α : α < μ⟩` with
(a) `c_α : ^{λ⁺>}(λ⁺) → χ` (sequences of ordinals `< λ⁺` of length `< λ⁺`), and
(b) there is no `ρ ∈ ^{λ⁺}χ` such that for every `α < μ` there is `η ∈ ^{λ⁺}(λ⁺)` for which
`{δ < λ : c_α(η ↾ δ) ≠ ρ(δ)}` is stationary in `λ`.
[Sh:88r] has `δ < λ` (not `δ < λ⁺`) in (b); the formalization follows it as written.
Encoding: the first argument `κ` is `λ⁺`, and `λ` is any cardinal with `succ λ = κ` (unique,
since `Order.succ` is injective on `Cardinal`; if `κ` is not a successor the set is empty and the
value is the junk value `0`). The ordinal `κ.ord` is represented by `κ.ord.ToType`; a sequence of
length `y < λ⁺` is a function on `{z // z < y}`, and `η ↾ y` is `fun z => η z.1`. The sequence
`⟨c_α : α < μ⟩` is a family indexed by `μ.out`. Stationarity is `IsStationaryIn λ.ord`. -/
noncomputable def muUnif (κ χ : Cardinal.{u}) : Cardinal.{u} :=
  sInf {x : Cardinal.{u} | ∃ lam : Cardinal.{u}, Order.succ lam = κ ∧
    ∃ c : x.out → (y : κ.ord.ToType) → ({z : κ.ord.ToType // z < y} → κ.ord.ToType) → χ.out,
      ¬ ∃ ρ : κ.ord.ToType → χ.out, ∀ α : x.out, ∃ η : κ.ord.ToType → κ.ord.ToType,
        IsStationaryIn lam.ord
          {δ | ∃ h : δ < κ.ord, δ < lam.ord ∧
            c α (Ordinal.ToType.mk ⟨δ, h⟩) (fun z => η z.1) ≠ ρ (Ordinal.ToType.mk ⟨δ, h⟩)}}

/-- AUX: not in paper. `μ_unif(λ⁺, 2^λ) ≤ 2^{λ⁺}` for infinite `λ`, with `μ_unif` as in [Sh:88r]
(`muUnif`). This is the commented-out Prop `unifleq` of the tex (l. 8023–8025, "Easy."; per
Shelah, personal communication), proved here for the [Sh:88r] definition as written and for
**infinite** `λ` only. Proof: for each `ρ ∈ ^{λ⁺}(2^λ)` let `c_ρ(ν) := ρ(length ν)`. Then
`c_ρ(η ↾ δ) = ρ(δ)` for all `η, δ`, so for the index `ρ` the set in (b) is empty, hence not
stationary in `λ` (`λ` is a limit ordinal). The family has size
`(2^λ)^{λ⁺} = 2^{λ · λ⁺} = 2^{λ⁺}`. -/
theorem muUnif_le (lam : Cardinal.{u}) (hlam : ℵ₀ ≤ lam) :
    muUnif (Order.succ lam) (2 ^ lam) ≤ 2 ^ Order.succ lam := by
  classical
  set κ := Order.succ lam
  set χ := (2 : Cardinal.{u}) ^ lam
  have hclub : IsClubIn lam.ord (Iio lam.ord) := by
    have hl : Order.IsSuccLimit lam.ord := Cardinal.isSuccLimit_ord hlam
    exact ⟨subset_rfl, fun α hα =>
      ⟨Order.succ α, hl.succ_lt hα, Order.lt_succ_of_not_isMax (not_isMax α)⟩, fun γ hγ _ _ => hγ⟩
  let e := Cardinal.outMkEquiv (α := κ.ord.ToType → χ.out)
  have hmem : #(κ.ord.ToType → χ.out) ∈ {x : Cardinal.{u} | ∃ l : Cardinal.{u}, Order.succ l = κ ∧
      ∃ c : x.out → (y : κ.ord.ToType) → ({z : κ.ord.ToType // z < y} → κ.ord.ToType) → χ.out,
        ¬ ∃ ρ : κ.ord.ToType → χ.out, ∀ α : x.out, ∃ η : κ.ord.ToType → κ.ord.ToType,
          IsStationaryIn l.ord
            {δ | ∃ h : δ < κ.ord, δ < l.ord ∧
              c α (Ordinal.ToType.mk ⟨δ, h⟩) (fun z => η z.1) ≠
                ρ (Ordinal.ToType.mk ⟨δ, h⟩)}} := by
    refine ⟨lam, rfl, fun α y _ => e α y, ?_⟩
    rintro ⟨ρ, hρ⟩
    obtain ⟨η, -, hst⟩ := hρ (e.symm ρ)
    obtain ⟨δ, ⟨h, -, hδ⟩, -⟩ := hst _ hclub
    exact hδ (by simp)
  refine (csInf_le' hmem).trans (le_of_eq ?_)
  calc #(κ.ord.ToType → χ.out) = χ ^ κ := by
        rw [← Cardinal.power_def, Cardinal.mk_out, Cardinal.mk_ord_toType]
    _ = 2 ^ κ := by
      rw [← Cardinal.power_mul, Cardinal.mul_eq_right (hlam.trans (Order.le_succ lam))
        (Order.le_succ lam)
        (fun h => by rw [h] at hlam; exact Cardinal.aleph0_pos.ne' (le_zero_iff.1 hlam))]

/-- AUX: not in paper. Thm 1.0.2 with `μ_unif` the defined function `muUnif` (instead of a free
parameter) and without the hypothesis `hunif`, which is discharged by `muUnif_le`. The frozen
`thm_1_0_2` is unchanged. -/
theorem thm_1_0_2_muUnif [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam)
    (s : Frame U L) (h1 : s.IsSemiGood lam ∧ ConjProp s lam)
    (h2 : ∀ m : ℕ, numModels s.S (plusN lam (2 + m)) < muUnif (plusN lam (2 + m))
      (2 ^ (plusN lam (1 + m))))
    (h3 : (∀ m : ℕ, (2 : Cardinal.{u}) ^ (plusN lam m) < 2 ^ (plusN lam (m + 1))) ∧
      ∀ m : ℕ, NotSaturatedIn (WDmId (plusN lam (1 + m))) (plusN lam (1 + m)) (plusN lam (2 + m)))
    (h4 : Conjecture_11_1_4.{u}) :
    ∀ n : ℕ, (s.S.Kc (plusN lam n)).Nonempty := by
  have hinf : ℵ₀ ≤ lam := by
    obtain ⟨M, hM⟩ := h1.2.kc_nonempty
    exact Frame.aleph0_le h1.1.1 hM
  refine thm_1_0_2 lam hU s muUnif h1 h2 (fun m => ?_) h3 h4
  have e : plusN lam (2 + m) = Order.succ (plusN lam (1 + m)) := by
    rw [plusN_succ]; congr 1; omega
  rw [e]
  exact muUnif_le _ (hinf.trans (plusN_le lam _))

end

