/-- AUX: not in paper. Prop 6.1.6(b), transitivity. -/
theorem Frame.leNF_trans [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {M N P : Model U L} (h : s.leNF lam M N) (h' : s.leNF lam N P) :
    s.leNF lam M P := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hM, hN, hMN, W, hW, -⟩ := id h
  obtain ⟨-, hP, hNP, -⟩ := id h'
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  obtain ⟨R₀, hR₀⟩ := hS.exists_filt hc.ax0b hinf hM
  obtain ⟨R₁, hR₁⟩ := hS.exists_filt hc.ax0b hinf hN
  obtain ⟨R₂, hR₂⟩ := hS.exists_filt hc.ax0b hinf hP
  obtain ⟨E₀, hE₀, n₀⟩ := Frame.club_of_leNF hU hs h hR₀ hR₁
  obtain ⟨E₁, hE₁, n₁⟩ := Frame.club_of_leNF hU hs h' hR₁ hR₂
  exact Frame.leNF_of_club hU hs hinf hM hP (hS.trans hMN hNP) (ClubL.inter hinf hE₀ hE₁) hR₀ hR₂
    fun ε hε ζ hζ hlt hl => Frame.nf_trans2 hU hs (n₀ ε hε.2.1 ζ hζ.2.1 hlt hl)
      (n₁ ε hε.2.2 ζ hζ.2.2 hlt hl)

/-- AUX: not in paper. Two filtrations of `M ⊆ M'`: on a club the levels are included. -/
theorem IsFilt.club_sub {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {M M' : Model U L} {R R' : Ordinal.{u} → Model U L} (hR : IsFilt S lam M R)
    (hR' : IsFilt S lam M' R') (hsub : M.carrier ⊆ M'.carrier) :
    ∃ E, ClubL lam E ∧ ∀ ε ∈ E, ε < (Order.succ lam).ord → (R ε).carrier ⊆ (R' ε).carrier := by
  obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (R' ε).carrier ∩ M.carrier)
    (G := fun ε => (R ε).carrier)
    (fun a b h hb => Set.inter_subset_inter_left _ (hR'.sub hS h hb))
    (fun a b h hb => hR.sub hS h hb)
    (fun b hb hl => by
      show (R' b).carrier ∩ M.carrier = _
      rw [hR'.2.1 b hb hl]; ext x
      simp only [Set.mem_inter_iff, Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨⟨ξ, hξ, hx⟩, hxM⟩; exact ⟨ξ, hξ, hx, hxM⟩
      · rintro ⟨ξ, hξ, hx, hxM⟩; exact ⟨⟨ξ, hξ, hx⟩, hxM⟩)
    (fun b hb hl => hR.2.1 b hb hl)
    (fun a ha => (Cardinal.mk_le_mk_of_subset Set.inter_subset_left).trans (le_of_eq (hR'.2.2.1 a ha).2))
    (fun a ha => le_of_eq (hR.2.2.1 a ha).2)
    (by
      rw [← hR.2.2.2.1]; ext x
      simp only [Set.mem_inter_iff, Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, -, -, hxM⟩; exact hxM
      · intro hx
        have hx' := hsub hx
        rw [hR'.2.2.2.1] at hx'
        obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hx'
        exact ⟨ξ, hξ, h, hx⟩)
  refine ⟨_, ⟨hub, hcl⟩, fun ε hε _ => ?_⟩
  have e : (R' ε).carrier ∩ M.carrier = (R ε).carrier := hε
  rw [← e]; exact Set.inter_subset_left

/-- AUX: not in paper. Prop 6.1.6(c). -/
theorem Frame.leNF_mid [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {M₀ M₁ M₂ : Model U L} (h01 : s.S.le M₀ M₁) (h12 : s.S.le M₁ M₂)
    (h : s.leNF lam M₀ M₂) : s.leNF lam M₀ M₁ := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h₀, h₂, -, W, hW, -⟩ := id h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have h₁ : M₁ ∈ s.S.Kc (Order.succ lam) := ⟨hS.mem_left h12, le_antisymm
    (by rw [show Order.succ lam = M₂.card from h₂.2.symm]; exact Model.card_le_of_sub (hS.sub h12))
    (by rw [show Order.succ lam = M₀.card from h₀.2.symm]; exact Model.card_le_of_sub (hS.sub h01))⟩
  obtain ⟨R₀, hR₀⟩ := hS.exists_filt hc.ax0b hinf h₀
  obtain ⟨R₁, hR₁⟩ := hS.exists_filt hc.ax0b hinf h₁
  obtain ⟨R₂, hR₂⟩ := hS.exists_filt hc.ax0b hinf h₂
  obtain ⟨E, hE, hN⟩ := Frame.club_of_leNF hU hs h hR₀ hR₂
  obtain ⟨D₀, hD₀, s₀⟩ := hR₀.club_sub hS hinf hR₁ (hS.sub h01)
  obtain ⟨D₁, hD₁, s₁⟩ := hR₁.club_sub hS hinf hR₂ (hS.sub h12)
  refine Frame.leNF_of_club hU hs hinf h₀ h₁ h01 (ClubL.inter hinf hE (ClubL.inter hinf hD₀ hD₁)) hR₀ hR₁
    fun ε hε ζ hζ hlt hl => ?_
  have hεκ := lt_trans hlt hl
  have kK : ∀ α < (Order.succ lam).ord, R₀ α ∈ s.S.Kc lam ∧ R₁ α ∈ s.S.Kc lam ∧ R₂ α ∈ s.S.Kc lam :=
    fun α hα => ⟨hR₀.2.2.1 α hα, hR₁.2.2.1 α hα, hR₂.2.2.1 α hα⟩
  have l01 : ∀ α, α ∈ D₀ → α < (Order.succ lam).ord → s.S.le (R₀ α) (R₁ α) := fun α hα hκ =>
    hS.le_of_sub (hS.trans (hR₀.le hS hinf hκ) h01) (hR₁.le hS hinf hκ) (s₀ α hα hκ)
  have l12 : ∀ α, α ∈ D₁ → α < (Order.succ lam).ord → s.S.le (R₁ α) (R₂ α) := fun α hα hκ =>
    hS.le_of_sub (hS.trans (hR₁.le hS hinf hκ) h12) (hR₂.le hS hinf hκ) (s₁ α hα hκ)
  have a0 := l01 ε hε.2.2.2.1 hεκ
  have b0 := l01 ζ hζ.2.2.2.1 hl
  have a1 := l12 ε hε.2.2.2.2 hεκ
  have b1 := l12 ζ hζ.2.2.2.2 hl
  have i0 := hR₀.1 ε hεκ ζ hl hlt
  have i1 := hR₁.1 ε hεκ ζ hl hlt
  exact prop_5_3_9_4 lam hU s hs _ (kK ε hεκ).1 _ (kK ζ hl).1 _ (kK ε hεκ).2.2 _ (kK ζ hl).2.2
    _ (kK ε hεκ).1 _ (kK ζ hl).1 _ (kK ε hεκ).2.1 _ (kK ζ hl).2.1 (hN ε hε.2.1 ζ hζ.2.1 hlt hl) rfl
    ⟨hS.refl (kK ε hεκ).1.1, hS.refl (kK ε hεκ).1.1, hS.trans i0 b0⟩
    ⟨hS.refl (kK ζ hl).1.1, i0, b0⟩ ⟨a1, a0, i1⟩ ⟨_, hS.refl (kK ζ hl).2.2.1, b1⟩

/-- AUX: not in paper. `NF^(N₀, N₁, M₀, M₁)` implies `M₀ ≼ M₁`. -/
theorem Frame.nfhat_le {s : Frame U L} {lam : Cardinal.{u}} (hs : Hyp_6_1_1 s lam)
    (hinf : ℵ₀ ≤ lam) {N₀ N₁ M₀ M₁ : Model U L} (h : s.NFhat lam N₀ N₁ M₀ M₁) :
    s.S.le M₀ M₁ := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨-, -, kM₀, -, A, B, Ai, Ac, Bi, Bc, hst, -, -, hMA, hMB⟩ := h
  obtain ⟨-, hle⟩ := hS.le_union hκl Bi Bc hMB
  exact hS.smooth _ hκl A M₁ Ai Ac (fun α hα => hS.trans (hst α hα).2.2.2.2.1 (hle α hα)) M₀ hMA kM₀.1

/-- AUX: not in paper. Prop 6.1.6(e). -/
theorem Frame.leNF_noMax [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {M₀ : Model U L}
    (hM : M₀ ∈ s.S.Kc (Order.succ lam)) : ¬ IsMaximal (s.nfKSys lam) M₀ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf hM
  have h0 := hκl.bot_lt
  have hP := hR.2.2.1 0 h0
  have hnm := hc.ax1c _ hP
  unfold IsMaximal at hnm
  push Not at hnm
  obtain ⟨N, hN, hlt⟩ := hnm hP
  have hPN : s.S.lt (R 0) N := ⟨hlt.1.2.2, hlt.2⟩
  have hsucc : Order.succ lam < #U := lt_of_le_of_lt (Order.succ_le_of_lt (Cardinal.cantor lam))
    (hU.1.isStrongPrelimit hU.2)
  have hsmall : #(M₀.carrier ∪ (R 0).carrier : Set U) < #U := by
    refine lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.1.aleph0_le ?_ ?_)
    · have : #M₀.carrier = Order.succ lam := hM.2
      rw [this]; exact hsucc
    · have : #(R 0).carrier = lam := hP.2
      rw [this]; exact hU.2
  obtain ⟨h, N', hh, hfix, hle', hK', hout⟩ := hS.rename hU.infinite (B := M₀.carrier) hPN.1
    (IsoOn.refl (R 0)) hsmall
  have hN' : N' ∈ s.S.Kc lam := ⟨hK', by rw [hh.card_eq]; exact hN.2⟩
  have hd : N'.carrier ∩ M₀.carrier = (R 0).carrier := by
    ext y
    refine ⟨fun ⟨hy, hyM⟩ => ?_, fun hy => ⟨hS.sub hle' hy, hS.sub (hR.le hS hinf h0) hy⟩⟩
    rw [hh.carrier_eq] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    by_cases hxP : x ∈ (R 0).carrier
    · rw [hfix x hxP]; exact hxP
    · exact absurd (Or.inl hyM) (hout x ⟨hx, hxP⟩)
  obtain ⟨M₁, hM₁⟩ := thm_6_1_3_c lam hU s hs (R 0) N' M₀ hP hN' hM hle' (hR.le hS hinf h0) hd
  have hle := Frame.nfhat_le hs hinf hM₁
  rintro ⟨-, hno⟩
  refine hno ⟨M₁, hM₁.2.2.2.1, ⟨hM, hM₁.2.2.2.1, hle, _, hP, _, hN', hM₁⟩, fun e => ?_⟩
  obtain ⟨a, ha, haP⟩ := hS.exists_diff_of_lt hPN
  have ha' : h a ∈ N'.carrier := hh.mapsTo ha
  have hout' := hout a ⟨ha, haP⟩
  obtain ⟨-, -, -, -, A, B, -, -, -, -, -, -, hB0, -, hMB⟩ := hM₁
  have : h a ∈ M₁.carrier := by
    have h1 := (hMB.2 0 h0).sub
    rw [hB0] at h1
    exact h1 ha'
  rw [← e] at this
  exact hout' (Or.inl this)

/-- AUX: not in paper. A subset of size `≤ λ` of the union is inside one level. -/
theorem IsFilt.cover {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {M : Model U L} {R : Ordinal.{u} → Model U L} (hR : IsFilt S lam M R) {A : Set U}
    (hA : A ⊆ M.carrier) (hc : #A ≤ lam) :
    ∃ ζ < (Order.succ lam).ord, A ⊆ (R ζ).carrier := by
  have hreg : (Order.succ lam).IsRegular := Cardinal.isRegular_succ hinf
  have hex : ∀ x : A, ∃ ζ < (Order.succ lam).ord, x.1 ∈ (R ζ).carrier := fun x => by
    have hx := hA x.2
    rw [hR.2.2.2.1] at hx
    obtain ⟨ζ, hζ, h⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨ζ, hζ, h⟩
  choose f hf hfR using hex
  have hsup : iSup f < (Order.succ lam).ord := Ordinal.iSup_lt_of_lt_cof
    (by rw [hreg.cof_ord]; exact Order.lt_succ_iff.2 hc) hf
  exact ⟨iSup f, hsup, fun x hx => hR.sub hS (Ordinal.le_iSup f ⟨x, hx⟩) hsup (hfR ⟨x, hx⟩)⟩

/-- AUX: not in paper. Prop 6.1.6(g). -/
theorem Frame.leNF_lst [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {M₀ M₁ : Model U L} (h : s.leNF lam M₀ M₁) {A₀ A₁ : Set U}
    (hA₀ : A₀ ⊆ M₀.carrier) (hA₁ : A₁ ⊆ M₁.carrier) (hc₀ : #A₀ ≤ lam) (hc₁ : #A₁ ≤ lam) :
    ∃ N₀ ∈ s.S.Kc lam, ∃ N₁ ∈ s.S.Kc lam, s.NFhat lam N₀ N₁ M₀ M₁ ∧ A₀ ⊆ N₀.carrier ∧
      A₁ ⊆ N₁.carrier := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h₀, h₁, -, W, hW, -, -, -, -, -, -, A, B, Ai, Ac, Bi, Bc, hst, -, -, hMA, hMB⟩ := h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨hA, hB⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst hMA hMB
  obtain ⟨z₀, hz₀, s₀⟩ := hA.cover hS hinf hA₀ hc₀
  obtain ⟨z₁, hz₁, s₁⟩ := hB.cover hS hinf hA₁ hc₁
  have hE : ClubL lam {ε | max z₀ z₁ ≤ ε} := by
    refine ⟨fun ξ hξ => ⟨max (max z₀ z₁) ξ + 1, ?_, ?_, hκl.add_one_lt (max_lt (max_lt hz₀ hz₁) hξ)⟩,
      fun δ _ hl H => ?_⟩
    · show max z₀ z₁ ≤ _
      exact (le_max_left (max z₀ z₁) ξ).trans (Order.lt_add_one_iff.2 (le_refl _)).le
    · exact lt_of_le_of_lt (le_max_right _ _) (Order.lt_add_one_iff.2 le_rfl)
    · obtain ⟨ε, h1, -, h2⟩ := H 0 hl.bot_lt
      exact le_trans h1 h2.le
  obtain ⟨ε₀, hε, hκ, hN⟩ := Frame.nfhat_of_club_filt hU hs hinf h₀ h₁ hE hA hB
    fun ε _ ζ _ hlt hl => Frame.nf_symm hU hs (Frame.nf_interval hU hs Ai Ac Bi Bc hst hlt hl)
  exact ⟨_, hA.2.2.1 ε₀ hκ, _, hB.2.2.1 ε₀ hκ, hN,
    s₀.trans (hA.sub hS ((le_max_left _ _).trans hε) hκ),
    s₁.trans (hB.sub hS ((le_max_right _ _).trans hε) hκ)⟩

