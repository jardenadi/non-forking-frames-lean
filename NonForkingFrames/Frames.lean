  have hr : s.IsRun lam D G (Order.succ lam).ord A c :=
    Frame.IsRun.of_lim hκl fun β hβ => (hcI β hβ.le hβ).2.1
  have inv := Frame.run_inv hc hinf hG' le_rfl hr
  have Bi : IsIncreasing s.S.le c (Iio (Order.succ lam).ord) := fun a _ b hb hab =>
    (inv b hb).2.2.2.2.2.1 a (mem_Iic.2 hab.le) b (mem_Iic.2 le_rfl) hab
  have Bc : IsContinuous c (Iio (Order.succ lam).ord) := fun b hb hl =>
