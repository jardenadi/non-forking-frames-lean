theorem ClubL.univ {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) : ClubL lam (Set.univ : Set Ordinal.{u}) := by
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
