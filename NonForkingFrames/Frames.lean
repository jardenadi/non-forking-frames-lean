  refine ⟨fun ξ hξ => ?_, fun δ _ hl H => ?_⟩
  · have h1 := max_lt ht hξ
    have hlt : max t ξ < max t ξ + Ordinal.omega0 := by
      simp
    exact ⟨max t ξ + Ordinal.omega0, ⟨Ordinal.isSuccLimit_add _ Ordinal.isSuccLimit_omega0,
      lt_of_le_of_lt (le_max_left _ _) hlt⟩, lt_of_le_of_lt (le_max_right _ _) hlt, hp h1 hω⟩
  · obtain ⟨ε, h1, -, h2⟩ := H 0 hl.bot_lt
    exact ⟨hl, lt_trans h1.2 h2⟩

/-- AUX: not in paper. Intersection of fewer than `λ⁺` clubs, indexed by `β < γ`. -/
theorem ClubL.bInter {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) {γ : Ordinal.{u}}
    (hγ : γ < (Order.succ lam).ord) {P : Ordinal.{u} → Set Ordinal.{u}}
    (hP : ∀ β, ClubL lam (P β)) : ClubL lam {ε | γ < ε ∧ ∀ β < γ, ε ∈ P β} := by
  have hd := ClubL.inter hinf (ClubL.gt hinf hγ) (ClubL.diag hinf fun β _ => hP β)
  refine ⟨fun ξ hξ => ?_, fun δ hδ hl H => ?_⟩
  · obtain ⟨ε, h1, h2, h3⟩ := hd.1 ξ hξ
    exact ⟨ε, ⟨h1.2.1, fun β hβ => h1.2.2 β (lt_trans hβ h1.2.1)⟩, h2, h3⟩
  · have hγδ : γ < δ := by
      obtain ⟨ε, h1, -, h2⟩ := H 0 hl.bot_lt
      exact lt_trans h1.1 h2
    refine ⟨hγδ, fun β hβ => (hP β).2 δ hδ hl fun ξ hξ => ?_⟩
    obtain ⟨ε, h1, h2, h3⟩ := H ξ hξ
    exact ⟨ε, h1.2 β hβ, h2, h3⟩

/-- AUX: not in paper. Cardinality of a union indexed by the ordinals below `γ`. -/
theorem card_bUnion_le {μ : Cardinal.{u}} (hinf : ℵ₀ ≤ μ) {γ : Ordinal.{u}} (hγ : γ.card ≤ μ)
    (X : Ordinal.{u} → Set U) (hX : ∀ β < γ, #(X β) ≤ μ) : #(⋃ β ∈ Iio γ, X β : Set U) ≤ μ := by
  have e : (⋃ β ∈ Iio γ, X β) = ⋃ i : γ.ToType, X (Ordinal.ToType.mk.symm i).1 := by
    ext x
    simp only [Set.mem_Iio, exists_prop, Set.mem_iUnion]
    constructor
    · rintro ⟨β, hβ, hx⟩
      exact ⟨Ordinal.ToType.mk ⟨β, hβ⟩, by simpa using hx⟩
    · rintro ⟨i, hx⟩
      exact ⟨_, (Ordinal.ToType.mk.symm i).2, hx⟩
  rw [e]
  refine (Cardinal.mk_iUnion_le _).trans ?_
  rw [Cardinal.mk_toType]
  calc γ.card * ⨆ i : γ.ToType, #(X (Ordinal.ToType.mk.symm i).1)
      ≤ μ * μ := mul_le_mul' hγ (ciSup_le' fun i => hX _ (Ordinal.ToType.mk.symm i).2)
    _ = μ := Cardinal.mul_eq_self hinf

/-- AUX: not in paper. At a limit `γ < λ⁺`, the level `γ` of the filtrations is, on a club, the
union of the lower levels (the club `E_{α,1}` of the paper's proof of Prop 6.1.6(d)). -/
theorem IsFilt.limClub {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {T : Model U L} {M : Ordinal.{u} → Model U L} {R : Ordinal.{u} → Ordinal.{u} → Model U L}
    {γ : Ordinal.{u}} (hγ : γ < (Order.succ lam).ord) (hR : IsFilt S lam T (R γ))
    (hRβ : ∀ β < γ, IsFilt S lam (M β) (R β))
    (hT : T.carrier = ⋃ β ∈ Iio γ, (M β).carrier) :
    ∃ D, ClubL lam D ∧ ∀ ε ∈ D, ε < (Order.succ lam).ord →
      (R γ ε).carrier = ⋃ β ∈ Iio γ, (R β ε).carrier := by
  have hγc : γ.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hγ)
  obtain ⟨hub, hcl⟩ := filt_club (lam := lam) hinf (F := fun ε => (R γ ε).carrier)
    (G := fun ε => ⋃ β ∈ Iio γ, (R β ε).carrier)
    (fun a b h hb => hR.sub hS h hb)
    (fun a b h hb => Set.biUnion_mono subset_rfl fun β hβ => (hRβ β hβ).sub hS h hb)
    (fun b hb hl => hR.2.1 b hb hl)
    (fun b hb hl => by
      show (⋃ β ∈ Iio γ, (R β b).carrier) = ⋃ ξ ∈ Iio b, ⋃ β ∈ Iio γ, (R β ξ).carrier
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨β, hβ, hx⟩
        rw [(hRβ β hβ).2.1 b hb hl] at hx
        obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hx
        exact ⟨ξ, hξ, β, hβ, h⟩
      · rintro ⟨ξ, hξ, β, hβ, hx⟩
        have hx' : x ∈ ⋃ ξ ∈ Iio b, (R β ξ).carrier := Set.mem_iUnion₂.2 ⟨ξ, hξ, hx⟩
        rw [← (hRβ β hβ).2.1 b hb hl] at hx'
        exact ⟨β, hβ, hx'⟩)
    (fun a ha => le_of_eq (hR.2.2.1 a ha).2)
    (fun a ha => card_bUnion_le hinf hγc _ fun β hβ => le_of_eq ((hRβ β hβ).2.2.1 a ha).2)
    (by
      rw [← hR.2.2.2.1, hT]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨β, hβ, hx⟩
        rw [(hRβ β hβ).2.2.2.1] at hx
        obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hx
        exact ⟨ξ, hξ, β, hβ, h⟩
      · rintro ⟨ξ, hξ, β, hβ, hx⟩
        have hx' : x ∈ ⋃ ξ ∈ Iio (Order.succ lam).ord, (R β ξ).carrier :=
          Set.mem_iUnion₂.2 ⟨ξ, hξ, hx⟩
        rw [← (hRβ β hβ).2.2.2.1] at hx'
        exact ⟨β, hβ, hx'⟩)
  exact ⟨_, ⟨hub, hcl⟩, fun ε hε _ => hε⟩

/-- AUX: not in paper. A column of `NF`-squares with limit height gives `NF` for the unions, by
Thm 5.5.1. -/
theorem Frame.nf_column [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) (hinf : ℵ₀ ≤ lam) {h : Ordinal.{u}} (hl : Order.IsSuccLimit h)
    (hh : h < (Order.succ lam).ord) {X Y : Ordinal.{u} → Model U L} {Tx Ty : Model U L}
    (Xi : IsIncreasing s.S.le X (Iio h)) (Xc : IsContinuous X (Iio h))
    (XK : ∀ β < h, X β ∈ s.S.Kc lam)
    (Yi : IsIncreasing s.S.le Y (Iio h)) (Yc : IsContinuous Y (Iio h))
    (YK : ∀ β < h, Y β ∈ s.S.Kc lam)
    (hst : ∀ β < h, s.NF lam (X β) (X (β + 1)) (Y β) (Y (β + 1)))
    (Ux : IsUnionOf X (Iio h) Tx) (Uy : IsUnionOf Y (Iio h) Ty) :
    s.NF lam (X 0) Tx (Y 0) Ty := by
  classical
  have hS : IsAEC s.S := hs.1.1.ax0a
  have h0 : (0 : Ordinal.{u}) < h := hl.bot_lt
  have mk : ∀ {Z : Ordinal.{u} → Model U L} {T : Model U L}, IsIncreasing s.S.le Z (Iio h) →
      IsContinuous Z (Iio h) → (∀ β < h, Z β ∈ s.S.Kc lam) → IsUnionOf Z (Iio h) T →
      IsIncreasing s.S.le (fun β => if β < h then Z β else T) (Iic h) ∧
      IsContinuous (fun β => if β < h then Z β else T) (Iic h) ∧
      ∀ ε ≤ h, (fun β => if β < h then Z β else T) ε ∈ s.S.Kc lam := by
    intro Z T Zi Zc ZK UZ
    obtain ⟨-, hle⟩ := hS.le_union hl Zi Zc UZ
    obtain ⟨e1, e2⟩ := IsAEC.extend_union Zi Zc UZ hle
    refine ⟨e1, e2, hS.chain_mem_Kc hinf hh e1 e2 ?_ fun ε hε => ?_⟩
    · simp only [h0, ↓reduceIte]; exact ZK _ h0
    · have := hl.add_one_lt hε
      simp only [this, ↓reduceIte]; exact ZK _ this
  obtain ⟨a1, a2, a3⟩ := mk Xi Xc XK Ux
  obtain ⟨b1, b2, b3⟩ := mk Yi Yc YK Uy
  have := Frame.nf_long hU hs hh hl.bot_lt a1 a2 a3 b1 b2 b3 fun ε hε => by
    have h1 := hl.add_one_lt hε
    simp only [hε, h1, ↓reduceIte]
    exact hst ε hε
  simpa only [h0, lt_self_iff_false, ↓reduceIte] using this

/-- AUX: not in paper. Prop 6.1.6(d) for a sequence of length `θ ≤ λ⁺` (the two cases of the
paper's proof). -/
theorem Frame.leNF_union_core [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {θ : Ordinal.{u}} (hθ : Order.IsSuccLimit θ)
    (hθκ : θ ≤ (Order.succ lam).ord) {M : Ordinal.{u} → Model U L}
    (hM : IsIncreasing (s.leNF lam) M (Iio θ)) (hc' : IsContinuous M (Iio θ)) {N : Model U L}
    (hN : IsUnionOf M (Iio θ) N) (hNK : N ∈ s.S.Kc (Order.succ lam)) : s.leNF lam (M 0) N := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have h0θ : (0 : Ordinal.{u}) < θ := hθ.bot_lt
  have h1θ : (1 : Ordinal.{u}) < θ := by simpa using hθ.add_one_lt h0θ
  obtain ⟨-, -, -, W, hW, -⟩ := hM 0 h0θ 1 h1θ zero_lt_one
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have Mi : IsIncreasing s.S.le M (Iio θ) := fun a ha b hb h => (hM a ha b hb h).2.2.1
  have MK : ∀ β < θ, M β ∈ s.S.Kc (Order.succ lam) := fun β hβ =>
    (hM β hβ (β + 1) (hθ.add_one_lt hβ) (Order.lt_add_one_iff.2 le_rfl)).1
  obtain ⟨-, Mle⟩ := hS.le_union hθ Mi hc' hN
  have hex : ∀ γ, ∃ R, (γ < θ → IsFilt s.S lam (M γ) R) ∧ (γ = θ → IsFilt s.S lam N R) := fun γ => by
    by_cases hγ : γ < θ
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf (MK γ hγ)
      exact ⟨R, fun _ => hR, fun h => absurd h hγ.ne⟩
    · obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf hNK
      exact ⟨R, fun h => absurd h hγ, fun _ => hR⟩
  choose Rr hF hFN using hex
  have hNfilt := hFN θ rfl
  have hP : ∀ β γ, ∃ P, ClubL lam P ∧ (β < γ → γ < θ → ∀ ε ∈ P, ∀ ζ ∈ P, ε < ζ →
      ζ < (Order.succ lam).ord → s.NF lam (Rr β ε) (Rr β ζ) (Rr γ ε) (Rr γ ζ)) := fun β γ => by
    by_cases hb : β < γ ∧ γ < θ
    · obtain ⟨E, hE, hn⟩ := Frame.club_of_leNF hU hs (hM β (lt_trans hb.1 hb.2) γ hb.2 hb.1)
        (hF β (lt_trans hb.1 hb.2)) (hF γ hb.2)
      exact ⟨E, hE, fun _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 => absurd ⟨h1, h2⟩ hb⟩
  choose P hPc hPn using hP
  have hL : ∀ γ, ∃ D, ClubL lam D ∧ (γ < (Order.succ lam).ord → Order.IsSuccLimit γ → γ ≤ θ →
      ∀ ε ∈ D, ε < (Order.succ lam).ord →
        (Rr γ ε).carrier = ⋃ β ∈ Iio γ, (Rr β ε).carrier) := fun γ => by
    by_cases hb : γ < (Order.succ lam).ord ∧ Order.IsSuccLimit γ ∧ γ ≤ θ
    · obtain ⟨hγ, hl, hle⟩ := hb
      rcases hle.lt_or_eq with h' | h'
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) hS hinf hγ (hF γ h')
          (fun β hβ => hF β (lt_trans hβ h')) (hc' γ h' hl)
        exact ⟨D, hD, fun _ _ _ => hn⟩
      · obtain ⟨D, hD, hn⟩ := IsFilt.limClub (M := M) (R := Rr) (T := N) hS hinf hγ (hFN γ h')
          (fun β hβ => hF β (by rw [← h']; exact hβ)) (by rw [h']; exact hN.1)
        exact ⟨D, hD, fun _ _ _ => hn⟩
    · exact ⟨Set.univ, ClubL.univ hinf, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ hb⟩
  choose Ls hLc hLn using hL
  let C : Ordinal.{u} → Set Ordinal.{u} := fun γ =>
    {ε | 1 < ε ∧ ε ∈ {ε | γ < ε ∧ ∀ β < γ, ε ∈ P β γ} ∧ ε ∈ Ls γ}
  have hC : ∀ γ < (Order.succ lam).ord, ClubL lam (C γ) := fun γ hγ =>
    ClubL.inter hinf (ClubL.bInter hinf hγ fun β => hPc β γ) (hLc γ)
  let t : Ordinal.{u} := if θ < (Order.succ lam).ord then θ else 0
  have ht : t < (Order.succ lam).ord := by
    by_cases h' : θ < (Order.succ lam).ord
    · simp only [t, h', ↓reduceIte]
    · simp only [t, h', ↓reduceIte]; exact hκl.bot_lt
  let E : Set Ordinal.{u} := {ε | 1 < ε ∧ ε ∈ {ε | Order.IsSuccLimit ε ∧ t < ε} ∧
    ε ∈ {ε | ∀ γ < ε, ε ∈ C γ}}
  have hE : ClubL lam E := ClubL.inter hinf (ClubL.limits hinf ht) (ClubL.diag hinf hC)
  have mP : ∀ ε ∈ E, ∀ γ < ε, ∀ β < γ, ε ∈ P β γ := fun ε hε γ hγ => (hε.2.2 γ hγ).2.1.2
  have mL : ∀ ε ∈ E, ∀ γ < ε, ε ∈ Ls γ := fun ε hε γ hγ => (hε.2.2 γ hγ).2.2
  have pa : ∀ ε ∈ E, ε < (Order.succ lam).ord → ∀ β γ, β < γ → γ < ε → γ < θ →
      s.S.le (Rr β ε) (Rr γ ε) := by
    intro ε hε hκ β γ hb hγ hγθ
    obtain ⟨ε', h1, h2, h3⟩ := (hPc β γ).1 ε hκ
    exact (hPn β γ hb hγθ ε (mP ε hε γ hγ β hb) ε' h1 h2 h3).2.2.2.2.2.2.1
  have hRN : ∀ γ ≤ θ, ∀ ξ < (Order.succ lam).ord, s.S.le (Rr γ ξ) N := by
    intro γ hγ ξ hξ
    rcases hγ.lt_or_eq with h' | h'
    · exact hS.trans ((hF γ h').le hS hinf hξ) (Mle γ h')
    · rw [h']; exact hNfilt.le hS hinf hξ
  have chn : ∀ ξ ∈ E, ξ < (Order.succ lam).ord → ∀ h, h ≤ ξ → h ≤ θ →
      IsIncreasing s.S.le (fun β => Rr β ξ) (Iio h) ∧ IsContinuous (fun β => Rr β ξ) (Iio h) ∧
      ∀ β < h, Rr β ξ ∈ s.S.Kc lam := by
    intro ξ hξ hκ h h1 h2
    refine ⟨fun a ha b hb hab => pa ξ hξ hκ a b hab (lt_of_lt_of_le hb h1) (lt_of_lt_of_le hb h2),
      fun b hb hl => ?_, fun β hβ => (hF β (lt_of_lt_of_le hβ h2)).2.2.1 ξ hκ⟩
    have hbξ : b < ξ := lt_of_lt_of_le hb h1
    exact hLn b (lt_trans hbξ hκ) hl (le_of_lt (lt_of_lt_of_le hb h2)) ξ (mL ξ hξ b hbξ) hκ
  have col : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord → ∀ h, Order.IsSuccLimit h →
      h ≤ ε → h ≤ θ → ∀ Tx Ty, IsUnionOf (fun β => Rr β ε) (Iio h) Tx →
      IsUnionOf (fun β => Rr β ζ) (Iio h) Ty → s.NF lam (Rr 0 ε) Tx (Rr 0 ζ) Ty := by
    intro ε hε ζ hζ hlt hκ h hl h1 h2 Tx Ty Ux Uy
    have hεκ := lt_trans hlt hκ
    obtain ⟨x1, x2, x3⟩ := chn ε hε hεκ h h1 h2
    obtain ⟨y1, y2, y3⟩ := chn ζ hζ hκ h (h1.trans hlt.le) h2
    refine Frame.nf_column (X := fun β => Rr β ε) (Y := fun β => Rr β ζ) hU hs hinf hl
      (lt_of_le_of_lt h1 hεκ) x1 x2 x3 y1 y2 y3 (fun β hβ => ?_) Ux Uy
    have hb1 := hl.add_one_lt hβ
    have hb2 : β < β + 1 := Order.lt_add_one_iff.2 le_rfl
    exact Frame.nf_symm hU hs (hPn β (β + 1) hb2 (lt_of_lt_of_le hb1 h2) ε
      (mP ε hε _ (lt_of_lt_of_le hb1 h1) β hb2) ζ
      (mP ζ hζ _ (lt_trans (lt_of_lt_of_le hb1 h1) hlt) β hb2) hlt hκ)
  have Ug : ∀ ξ ∈ E, ξ < (Order.succ lam).ord → ∀ h, Order.IsSuccLimit h → h < ξ → h ≤ θ →
      IsUnionOf (fun β => Rr β ξ) (Iio h) (Rr h ξ) := by
    intro ξ hξ hκ h hl h1 h2
    have e := hLn h (lt_trans h1 hκ) hl h2 ξ (mL ξ hξ h h1) hκ
    refine ⟨e, fun β hβ => ?_⟩
    have hβθ : β ≤ θ := le_of_lt (lt_of_lt_of_le hβ h2)
    refine IsSubstr.of_sub (hS.incl _ _ (hRN β hβθ ξ hκ)) (hS.incl _ _ (hRN h h2 ξ hκ)) ?_
    rw [e]
    exact Set.subset_biUnion_of_mem (u := fun β => (Rr β ξ).carrier) hβ
  by_cases hθ' : θ < (Order.succ lam).ord
  · have htθ : t = θ := by simp only [t, hθ', ↓reduceIte]
    have hgt : ∀ ε ∈ E, θ < ε := fun ε hε => by
      have := hε.2.1.2
      rwa [htθ] at this
    exact Frame.leNF_of_club hU hs hinf (MK 0 h0θ) hNK (Mle 0 h0θ) hE (hF 0 h0θ) hNfilt
      fun ε hε ζ hζ hlt hl => Frame.nf_symm hU hs
        (col ε hε ζ hζ hlt hl θ hθ (hgt ε hε).le le_rfl _ _
          (Ug ε hε (lt_trans hlt hl) θ hθ (hgt ε hε) le_rfl) (Ug ζ hζ hl θ hθ (hgt ζ hζ) le_rfl))
  · have hθe : θ = (Order.succ lam).ord := le_antisymm hθκ (not_lt.1 hθ')
    have hle : ∀ ε, ε < (Order.succ lam).ord → ε ≤ θ := fun ε h => by rw [hθe]; exact h.le
    have hNex : ∀ ε, ∃ T, ε ∈ E → ε < (Order.succ lam).ord →
        IsUnionOf (fun β => Rr β ε) (Iio ε) T ∧ T ∈ s.S.K := fun ε => by
      by_cases hb : ε ∈ E ∧ ε < (Order.succ lam).ord
      · obtain ⟨x1, x2, -⟩ := chn ε hb.1 hb.2 ε le_rfl (hle ε hb.2)
        obtain ⟨T, hT, hTK, -⟩ := hS.union ε hb.1.2.1.1 _ x1 x2
        exact ⟨T, fun _ _ => ⟨hT, hTK⟩⟩
      · exact ⟨N, fun h1 h2 => absurd ⟨h1, h2⟩ hb⟩
    choose Nn hNu using hNex
    have hcol : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
        s.NF lam (Rr 0 ε) (Nn ε) (Rr 0 ζ) (Rr ε ζ) := fun ε hε ζ hζ hlt hκ =>
      col ε hε ζ hζ hlt hκ ε hε.2.1.1 le_rfl (hle ε (lt_trans hlt hκ)) _ _
        (hNu ε hε (lt_trans hlt hκ)).1 (Ug ζ hζ hκ ε hε.2.1.1 hlt (hle ε (lt_trans hlt hκ)))
    have hNnK : ∀ ζ ∈ E, ζ < (Order.succ lam).ord → Nn ζ ∈ s.S.Kc lam := fun ζ hζ hκ => by
      obtain ⟨ζ', h1, h2, h3⟩ := hE.1 ζ hκ
      exact (hcol ζ hζ ζ' h1 h2 h3).2.1
    have hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
        s.NF lam (Rr 0 ε) (Rr 0 ζ) (Nn ε) (Nn ζ) := by
      intro ε hε ζ hζ hlt hκ
      have n := hcol ε hε ζ hζ hlt hκ
      obtain ⟨x1, x2, -⟩ := chn ζ hζ hκ ζ le_rfl (hle ζ hκ)
      have hup : s.S.le (Rr ε ζ) (Nn ζ) :=
        (hS.le_union hζ.2.1.1 x1 x2 (hNu ζ hζ hκ).1).2 ε hlt
      have kN := hNnK ζ hζ hκ
      obtain ⟨k0, k1, k2, k3, l1, l2, l3, l4, -⟩ := id n
      exact Frame.nf_symm hU hs (prop_5_3_9_4 lam hU s hs _ k0 _ k1 _ k2 _ k3 _ k0 _ k1 _ k2 _ kN n rfl
        ⟨hS.refl k0.1, hS.refl k0.1, hS.trans l1 (hS.trans l2 hup)⟩
        ⟨hS.refl k1.1, l1, hS.trans l2 hup⟩
        ⟨hS.refl k2.1, l3, hS.trans l4 hup⟩ ⟨_, hup, hS.refl kN.1⟩)
    have hA := hF 0 h0θ
    have Bc : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
        (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
        (Nn ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (Nn ε').carrier := by
      intro ε hε hκ hl hcof
      rw [(hNu ε hε hκ).1.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
      constructor
      · rintro ⟨β, hβ, hx⟩
        have hβθ : β < θ := by rw [hθe]; exact lt_trans hβ hκ
        rw [(hF β hβθ).2.1 ε hκ hl] at hx
        obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hx
        obtain ⟨ε', h1, h2, h3⟩ := hcof (max ξ β) (max_lt hξ hβ)
        have hκ' := lt_trans h3 hκ
        refine ⟨ε', ⟨h1, h3⟩, (hNu ε' h1 hκ').1.2 β (lt_of_le_of_lt (le_max_right _ _) h2) |>.sub ?_⟩
        exact (hF β hβθ).sub hS ((le_max_left _ _).trans h2.le) hκ' h
      · rintro ⟨ε', ⟨h1, h2⟩, hx⟩
        have hin : x ∈ (Nn ε).carrier := hS.sub (hNF ε' h1 ε hε h2 hκ).2.2.2.2.2.2.2.1 hx
        rw [(hNu ε hε hκ).1.1] at hin
        obtain ⟨β, hβ, h⟩ := Set.mem_iUnion₂.1 hin
        exact ⟨β, hβ, h⟩
    have Ac : ∀ ε ∈ E, ε < (Order.succ lam).ord → Order.IsSuccLimit ε →
        (∀ ξ < ε, ∃ ε' ∈ E, ξ < ε' ∧ ε' < ε) →
        (Rr 0 ε).carrier = ⋃ ε' ∈ E ∩ Iio ε, (Rr 0 ε').carrier := by
      intro ε _ hκ hl hcof
      rw [hA.2.1 ε hκ hl]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨ε', h1, h2, h3⟩ := hcof ξ hξ
        exact ⟨ε', ⟨h1, h3⟩, hA.sub hS h2.le (lt_trans h3 hκ) hx⟩
      · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
        exact ⟨ξ, hξ, hx⟩
    have AU : (M 0).carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (Rr 0 ε).carrier := by
      rw [hA.2.2.2.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨ε', h1, h2, h3⟩ := hE.1 ξ hξ
        exact ⟨ε', ⟨h1, h3⟩, hA.sub hS h2.le h3 hx⟩
      · rintro ⟨ξ, ⟨-, hξ⟩, hx⟩
        exact ⟨ξ, hξ, hx⟩
    have BU : N.carrier = ⋃ ε ∈ E ∩ Iio (Order.succ lam).ord, (Nn ε).carrier := by
      rw [hN.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop, Set.mem_inter_iff]
      constructor
      · rintro ⟨β, hβ, hx⟩
        have hβκ : β < (Order.succ lam).ord := lt_of_lt_of_le hβ hθκ
        rw [(hF β hβ).2.2.2.1] at hx
        obtain ⟨ξ, hξ, h⟩ := Set.mem_iUnion₂.1 hx
        obtain ⟨ε, h1, h2, h3⟩ := hE.1 (max ξ β) (max_lt hξ hβκ)
        exact ⟨ε, ⟨h1, h3⟩, ((hNu ε h1 h3).1.2 β (lt_of_le_of_lt (le_max_right _ _) h2)).sub
          ((hF β hβ).sub hS ((le_max_left _ _).trans h2.le) h3 h)⟩
      · rintro ⟨ε, ⟨h1, h2⟩, hx⟩
        rw [(hNu ε h1 h2).1.1] at hx
        obtain ⟨β, hβ, h⟩ := Set.mem_iUnion₂.1 hx
        have hβθ : β < θ := by rw [hθe]; exact lt_trans hβ h2
        exact ⟨β, hβθ, (hS.sub ((hF β hβθ).le hS hinf h2)) h⟩
    obtain ⟨ε₀, -, hε₀, hat⟩ := Frame.nfhat_of_club hU hs hinf (MK 0 h0θ) hNK hE hNF Ac Bc AU BU
      (fun ε _ hκ => hA.2.2.2.2 ε hκ) (fun ε hε hκ => by
        obtain ⟨x1, x2, -⟩ := chn ε hε hκ ε le_rfl (hle ε hκ)
        exact hS.incl _ _ (hS.smooth ε hε.2.1.1 _ N x1 x2
          (fun β hβ => hRN β ((le_of_lt hβ).trans (hle ε hκ)) ε hκ) _ (hNu ε hε hκ).1 (hNu ε hε hκ).2))
    exact ⟨MK 0 h0θ, hNK, Mle 0 h0θ, _, hat.1, _, hat.2.1, hat⟩

/-- AUX: not in paper. Prop 6.1.6(d): reduction to length `cf δ ≤ λ⁺`. -/
theorem Frame.leNF_union [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) {δ : Ordinal.{u}} (hδ : Order.IsSuccLimit δ)
    (hδ' : δ < (plusN lam 2).ord) {M : Ordinal.{u} → Model U L}
    (hM : IsIncreasing (s.leNF lam) M (Iio δ)) (hc' : IsContinuous M (Iio δ)) :
    ∃ N, IsUnionOf M (Iio δ) N ∧ N ∈ s.S.Kc (Order.succ lam) ∧ s.leNF lam (M 0) N := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have h0δ : (0 : Ordinal.{u}) < δ := hδ.bot_lt
  have h1δ : (1 : Ordinal.{u}) < δ := by simpa using hδ.add_one_lt h0δ
  obtain ⟨-, -, -, W, hW, -⟩ := hM 0 h0δ 1 h1δ zero_lt_one
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have hinf' : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have Mi : IsIncreasing s.S.le M (Iio δ) := fun a ha b hb h => (hM a ha b hb h).2.2.1
  have MK : ∀ β < δ, M β ∈ s.S.Kc (Order.succ lam) := fun β hβ =>
    (hM β hβ (β + 1) (hδ.add_one_lt hβ) (Order.lt_add_one_iff.2 le_rfl)).1
  obtain ⟨N, hN, hNK, hle0⟩ := hS.union δ hδ M Mi hc'
  have hδc : δ.card ≤ Order.succ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hδ')
  have hNc : N ∈ s.S.Kc (Order.succ lam) := by
    refine ⟨hNK, le_antisymm ?_ ?_⟩
    · show #N.carrier ≤ _
      rw [hN.1]
      exact card_bUnion_le hinf' hδc _ fun β hβ => le_of_eq (MK β hβ).2
    · rw [show Order.succ lam = (M 0).card from (MK 0 h0δ).2.symm]
      exact Model.card_le_of_sub (hS.sub hle0)
  refine ⟨N, hN, hNc, ?_⟩
  obtain ⟨θ, hθdef⟩ : ∃ θ, δ.cof.ord = θ := ⟨_, rfl⟩
  obtain ⟨f, hf⟩ := Ordinal.exists_isFundamentalSeq hθdef
  have hθ : Order.IsSuccLimit θ := by
    rw [← hθdef]
    exact Cardinal.isSuccLimit_ord (Ordinal.aleph0_le_cof_iff.2 (Ordinal.one_lt_cof_iff.2 hδ))
  have hθκ : θ ≤ (Order.succ lam).ord := by
    rw [← hθdef]
    exact Cardinal.ord_le_ord.2 ((Ordinal.cof_le_card δ).trans hδc)
  let f' : Ordinal.{u} → Ordinal.{u} := fun j => if h : j < θ then (f ⟨j, h⟩).1 else 0
  have f'lt : ∀ j < θ, f' j < δ := fun j h => by
    simp only [f', h, ↓reduceDIte]; exact (f ⟨j, h⟩).2
  have f'm : ∀ i j, i < j → j < θ → f' i < f' j := fun i j h hj => by
    have hi := lt_trans h hj
    simp only [f', hi, hj, ↓reduceDIte]
    exact hf.strictMono (show (⟨i, hi⟩ : Iio θ) < ⟨j, hj⟩ from h)
  have f'c : ∀ ξ < δ, ∃ j < θ, ξ ≤ f' j := fun ξ hξ => by
    obtain ⟨_, ⟨c, rfl⟩, hc2⟩ := hf.isCofinal_range ⟨ξ, hξ⟩
    refine ⟨c.1, c.2, ?_⟩
    have hcθ : c.1 < θ := c.2
    simp only [f', hcθ, ↓reduceDIte]
    exact hc2
  let g : Ordinal.{u} → Ordinal.{u} := fun i => ⨆ j : i.ToType, f' (Ordinal.ToType.mk.symm j).1 + 1
  have gb : ∀ i, ∀ j < i, f' j + 1 ≤ g i := fun i j h => by
    have := Ordinal.le_iSup (fun j : i.ToType => f' (Ordinal.ToType.mk.symm j).1 + 1)
      (Ordinal.ToType.mk ⟨j, h⟩)
    simp only [OrderIso.symm_apply_apply] at this
    exact this
  have gle : ∀ i a, (∀ j < i, f' j + 1 ≤ a) → g i ≤ a := fun i a h =>
    ciSup_le' fun j => h _ (Ordinal.ToType.mk.symm j).2
  have gbelow : ∀ i, ∀ ξ < g i, ∃ j < i, ξ ≤ f' j := fun i ξ hξ => by
    by_contra hno
    push Not at hno
    exact absurd hξ (not_lt.2 (gle i ξ fun j hj => Order.add_one_le_iff.2 (hno j hj)))
  have gf : ∀ i < θ, g i ≤ f' i := fun i hi =>
    gle i _ fun j hj => Order.add_one_le_iff.2 (f'm j i hj hi)
  have gδ : ∀ i < θ, g i < δ := fun i hi => lt_of_le_of_lt (gf i hi) (f'lt i hi)
  have gm : ∀ a b, a < b → b < θ → g a < g b := fun a b h hb =>
    lt_of_le_of_lt (gf a (lt_trans h hb)) (Order.add_one_le_iff.1 (gb b a h))
  have g0 : g 0 = 0 := le_antisymm (gle 0 0 fun j hj => absurd hj (not_lt.2 zero_le)) zero_le
  have gcof : ∀ ξ < δ, ∃ i < θ, ξ < g i := fun ξ hξ => by
    obtain ⟨j, hj, h⟩ := f'c ξ hξ
    exact ⟨j + 1, hθ.add_one_lt hj, lt_of_le_of_lt h
      (Order.add_one_le_iff.1 (gb _ j (Order.lt_add_one_iff.2 le_rfl)))⟩
  have gl : ∀ i < θ, Order.IsSuccLimit i → ∀ ξ < g i, ∃ j < i, ξ < g j := fun i _ hl ξ hξ => by
    obtain ⟨j, hj, h⟩ := gbelow i ξ hξ
    exact ⟨j + 1, hl.add_one_lt hj, lt_of_le_of_lt h
      (Order.add_one_le_iff.1 (gb _ j (Order.lt_add_one_iff.2 le_rfl)))⟩
  have gsl : ∀ i < θ, Order.IsSuccLimit i → Order.IsSuccLimit (g i) := fun i hi hl => by
    rcases Ordinal.zero_or_succ_or_isSuccLimit (g i) with h' | ⟨d, hd⟩ | h'
    · have := gm 0 i hl.bot_lt hi
      rw [g0, h'] at this
      exact absurd this (lt_irrefl _)
    · rw [Order.succ_eq_add_one] at hd
      obtain ⟨j, hj, h⟩ := gl i hi hl d (by rw [← hd]; exact Order.lt_add_one_iff.2 le_rfl)
      have h2 := gm j i hj hi
      rw [← hd] at h2
      exact absurd h2 (not_lt.2 (Order.add_one_le_iff.2 h))
    · exact h'
  have hsubM : ∀ a < δ, ∀ b < δ, a ≤ b → (M a).carrier ⊆ (M b).carrier := fun a _ b hb h => by
    rcases h.lt_or_eq with h' | h'
    · exact hS.sub (Mi a (lt_trans h' hb) b hb h')
    · rw [h']
  have hcore := Frame.leNF_union_core hU hs (M := fun i => M (g i)) (N := N) hθ hθκ
    (fun a ha b hb h => hM _ (gδ a ha) _ (gδ b hb) (gm a b h hb))
    (fun b hb hl => by
      have hbθ : b < θ := hb
      show (M (g b)).carrier = _
      rw [hc' _ (gδ b hbθ) (gsl b hbθ hl)]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨j, hj, h⟩ := gl b hbθ hl ξ hξ
        have hjθ := lt_trans hj hbθ
        exact ⟨j, hj, hsubM ξ (lt_trans h (gδ j hjθ)) _ (gδ j hjθ) h.le hx⟩
      · rintro ⟨j, hj, hx⟩
        exact ⟨g j, gm j b hj hbθ, hx⟩)
    ⟨by
      rw [hN.1]
      ext x
      simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨ξ, hξ, hx⟩
        obtain ⟨i, hi, h⟩ := gcof ξ hξ
        exact ⟨i, hi, hsubM ξ hξ _ (gδ i hi) h.le hx⟩
      · rintro ⟨i, hi, hx⟩
        exact ⟨g i, gδ i hi, hx⟩, fun i hi => hN.2 _ (gδ i hi)⟩ hNc
  simpa only [g0] using hcore

/-- AUX: not in paper. Prop 6.1.6(f), the isomorphism axiom for `≼^NF`. -/
theorem Frame.leNF_iso {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_6_1_1 s lam) : (s.nfKSys lam).AxIso := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  intro M₀ M₁ N₁ f hM₁ h hf
  obtain ⟨h₀, h₁, h01, W, hW, W', hW', -, -, -, -, A, B, Ai, Ac, Bi, Bc, hst, -, -, hMA, hMB⟩ := id h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨hAf, hBf⟩ := Frame.nfhat_filt Ai Ac Bi Bc hst hMA hMB
  have hN₁ : N₁ ∈ s.S.Kc (Order.succ lam) := ⟨hS.iso_mem h₁.1 hf, by rw [hf.card_eq]; exact h₁.2⟩
  obtain ⟨-, M₀', hfM, hle'⟩ := hS.iso M₀ M₁ N₁ f h₁.1 h01 hf
  have hM₀' : M₀' ∈ s.S.Kc (Order.succ lam) := ⟨hS.mem_left hle', by rw [hfM.card_eq]; exact h₀.2⟩
  have mk : ∀ X : Ordinal.{u} → Model U L, (∀ α < (Order.succ lam).ord, s.S.le (X α) M₁) →
      ∃ X' : Ordinal.{u} → Model U L, ∀ α < (Order.succ lam).ord, IsoOn f (X α) (X' α) ∧
        s.S.le (X' α) N₁ := by
    intro X hX
    have : ∀ α, ∃ Y, α < (Order.succ lam).ord → IsoOn f (X α) Y ∧ s.S.le Y N₁ := fun α => by
      by_cases hα : α < (Order.succ lam).ord
      · obtain ⟨-, Y, h1, h2⟩ := hS.iso (X α) M₁ N₁ f h₁.1 (hX α hα) hf
        exact ⟨Y, fun _ => ⟨h1, h2⟩⟩
      · exact ⟨N₁, fun h => absurd h hα⟩
    choose X' hX' using this
    exact ⟨X', hX'⟩
  obtain ⟨A', hA'⟩ := mk A fun α hα => hS.trans (hAf.le hS hinf hα) h01
  obtain ⟨B', hB'⟩ := mk B fun α hα => hBf.le hS hinf hα
  have tr : ∀ {X X' : Ordinal.{u} → Model U L} {T : Model U L},
      IsFilt s.S lam T X → (∀ α < (Order.succ lam).ord, IsoOn f (X α) (X' α) ∧ s.S.le (X' α) N₁) →
      IsIncreasing s.S.le X' (Iio (Order.succ lam).ord) ∧
        IsContinuous X' (Iio (Order.succ lam).ord) := by
    intro X X' T hX hX'
    refine ⟨fun a ha b hb hab => ?_, fun b hb hl => ?_⟩
    · have ha' : a < (Order.succ lam).ord := ha
      have hb' : b < (Order.succ lam).ord := hb
      refine hS.le_of_sub (hX' a ha').2 (hX' b hb').2 ?_
      rw [(hX' a ha').1.carrier_eq, (hX' b hb').1.carrier_eq]
      exact Set.image_mono (hX.sub hS hab.le hb')
    · have hb' : b < (Order.succ lam).ord := hb
      rw [(hX' b hb').1.carrier_eq, hX.2.1 b hb' hl, Set.image_iUnion₂]
      refine Set.iUnion₂_congr fun ξ hξ => ?_
      rw [(hX' ξ (lt_trans hξ hb')).1.carrier_eq]
  obtain ⟨Ai', Ac'⟩ := tr hAf hA'
  obtain ⟨Bi', Bc'⟩ := tr hBf hB'
  have un : ∀ {X X' : Ordinal.{u} → Model U L} {T T' : Model U L}, IsFilt s.S lam T X →
      IsoOn f T T' → s.S.le T' N₁ →
      (∀ α < (Order.succ lam).ord, IsoOn f (X α) (X' α) ∧ s.S.le (X' α) N₁) →
      IsUnionOf X' (Iio (Order.succ lam).ord) T' := by
    intro X X' T T' hX hT hT' hX'
    have e : T'.carrier = ⋃ α ∈ Iio (Order.succ lam).ord, (X' α).carrier := by
      rw [hT.carrier_eq, hX.2.2.2.1, Set.image_iUnion₂]
      refine Set.iUnion₂_congr fun ξ hξ => ?_
      rw [(hX' ξ hξ).1.carrier_eq]
    refine ⟨e, fun α hα => IsSubstr.of_sub (hS.incl _ _ (hX' α hα).2) (hS.incl _ _ hT') ?_⟩
    rw [e]
    exact Set.subset_biUnion_of_mem (u := fun α => (X' α).carrier) hα
  have hκ0 := hκl.bot_lt
  have hat : s.NFhat lam (A' 0) (B' 0) M₀' N₁ := by
    refine ⟨?_, ?_, hM₀', hN₁, A', B', Ai', Ac', Bi', Bc', fun α hα => ?_, rfl, rfl,
      un hAf hfM hle' hA', un hBf hf (hS.refl hN₁.1) hB'⟩
    · exact ⟨hS.mem_left (hA' 0 hκ0).2, by rw [(hA' 0 hκ0).1.card_eq]; exact (hst 0 hκ0).1.2⟩
    · exact ⟨hS.mem_left (hB' 0 hκ0).2, by rw [(hB' 0 hκ0).1.card_eq]; exact (hst 0 hκ0).2.1.2⟩
    · have h1 := hκl.add_one_lt hα
      exact (prop_5_3_3 lam hU s hs _ _ _ _ _ _ _ _ f (hB' _ h1).1 (hA' α hα).1 (hB' α hα).1
        (hA' _ h1).1).2 (hst α hα)
  exact ⟨hN₁, M₀', hfM, hM₀', hN₁, hle', _, hat.1, _, hat.2.1, hat⟩

/-- Prop 6.1.6(a): for `M₀ ≼ M₁` in `K_{λ⁺}` with representations `⟨N_{n,ε} : ε < λ⁺⟩`,
`M₀ ≼^NF M₁` iff for some club `E ⊆ λ⁺`, `ε < ζ` in `E` imply
`NF(N_{0,ε}, N_{0,ζ}, N_{1,ε}, N_{1,ζ})`. -/
theorem prop_6_1_6_a [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (M₀ M₁ : Model U L) (h₀ : M₀ ∈ s.S.Kc (Order.succ lam)) (h₁ : M₁ ∈ s.S.Kc (Order.succ lam))
    (h01 : s.S.le M₀ M₁) (R₀ R₁ : Ordinal.{u} → Model U L) (hR₀ : IsRepresentation s.S M₀ R₀)
    (hR₁ : IsRepresentation s.S M₁ R₁) :
    s.leNF lam M₀ M₁ ↔ ∃ E, IsClubIn (Order.succ lam).ord E ∧
      ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → s.NF lam (R₀ ε) (R₀ ζ) (R₁ ε) (R₁ ζ) := by
  -- `ℵ₀ ≤ λ` from `K_λ ≠ ∅` (categoricity, part of the conjugation property).
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hs.1.1 hs.2.1.kc_nonempty.some_mem
  have hS : IsAEC s.S := hs.1.1.ax0a
  exact Frame.leNF_iff_club hU hs hinf h₀ h₁ h01 (hR₀.isFilt hS hinf h₀) (hR₁.isFilt hS hinf h₁)

/-- Prop 6.1.6(b): `≼^NF_{λ⁺}` is a partial order (on `K_{λ⁺}`). -/
theorem prop_6_1_6_b [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`. Reflexivity needs a model in `K_λ`; for finite `λ` it can
    -- fail (see docs/METHOD.md).
    (hinf : ℵ₀ ≤ lam) :
    (∀ M ∈ s.S.Kc (Order.succ lam), s.leNF lam M M) ∧
    (∀ M N, s.leNF lam M N → s.leNF lam N M → M = N) ∧
    (∀ M N P, s.leNF lam M N → s.leNF lam N P → s.leNF lam M P) :=
  ⟨fun _ hM => Frame.leNF_refl hU hs hinf hM,
    fun _ _ h h' => hs.1.1.ax0a.po.2.2.1 _ _ h.2.2.1 h'.2.2.1,
    fun _ _ _ h h' => Frame.leNF_trans hU hs h h'⟩

/-- Prop 6.1.6(c): `M₀ ≼ M₁ ≼ M₂` and `M₀ ≼^NF M₂` imply `M₀ ≼^NF M₁`. -/
theorem prop_6_1_6_c [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (M₀ M₁ M₂ : Model U L) (h01 : s.S.le M₀ M₁) (h12 : s.S.le M₁ M₂) (h : s.leNF lam M₀ M₂) :
    s.leNF lam M₀ M₁ :=
  Frame.leNF_mid hU hs h01 h12 h

/-- Prop 6.1.6(d): `(K_{λ⁺}, ≼^NF)` satisfies Axiom c of AEC in `λ⁺`: for limit `δ < λ^{+2}`
and a `≼^NF`-increasing continuous `⟨M_α : α < δ⟩`, `M₀ ≼^NF ⋃ M_α` (and `⋃ M_α ∈ K_{λ⁺}`). -/
theorem prop_6_1_6_d [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (δ : Ordinal.{u}) (hδ : Order.IsSuccLimit δ) (hδ' : δ < (plusN lam 2).ord)
    (M : Ordinal.{u} → Model U L) (hM : IsIncreasing (s.leNF lam) M (Iio δ))
    (hc : IsContinuous M (Iio δ)) :
    ∃ N, IsUnionOf M (Iio δ) N ∧ N ∈ s.S.Kc (Order.succ lam) ∧ s.leNF lam (M 0) N :=
  Frame.leNF_union hU hs hδ hδ' hM hc

/-- Prop 6.1.6(e): `K_{λ⁺}` has no `≼^NF`-maximal model. -/
theorem prop_6_1_6_e [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`; false for finite `λ` (see docs/METHOD.md).
    (hinf : ℵ₀ ≤ lam) :
    ∀ M ∈ s.S.Kc (Order.succ lam), ¬ IsMaximal (s.nfKSys lam) M :=
  fun _ hM => Frame.leNF_noMax hU hs hinf hM

/-- Prop 6.1.6(f): if `(K_{λ⁺}, ≼^NF)` satisfies smoothness, then it is an AEC in `λ⁺`. -/
theorem prop_6_1_6_f [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    -- PROOF-STAGE CHANGE: added `ℵ₀ ≤ λ`, used by reflexivity (item (b)); see docs/METHOD.md,
    -- "Proof-stage changes".
    (hinf : ℵ₀ ≤ lam)
    (hsm : ∀ δ : Ordinal.{u}, Order.IsSuccLimit δ → (s.nfKSys lam).AxSmooth δ) :
    IsAECIn (s.nfKSys lam) (Order.succ lam) := by
  have hS : IsAEC s.S := hs.1.1.ax0a
  exact ⟨fun M hM => hM.2, Frame.leNF_iso hU hs,
    ⟨fun M N h => ⟨h.1, h.2.1⟩, fun M hM => Frame.leNF_refl hU hs hinf hM,
      fun M N h h' => hS.po.2.2.1 _ _ h.2.2.1 h'.2.2.1,
      fun M N P h h' => Frame.leNF_trans hU hs h h'⟩,
    fun M N h => hS.incl _ _ h.2.2.1, hsm,
    fun M₀ M₁ M₂ a b h h' => Frame.leNF_mid hU hs (hS.coh _ _ _ a b h.2.2.1 h'.2.2.1) h'.2.2.1 h,
    fun δ hδ hδ' M hM hc => Frame.leNF_union hU hs hδ hδ' hM hc⟩

/-- Prop 6.1.6(g), LST for `≼^NF`: if `M₀ ≼^NF M₁` and `Aₙ ⊆ Mₙ`, `|Aₙ| ≤ λ`, there are
`N₀, N₁ ∈ K_λ` with `NF^(N₀, N₁, M₀, M₁)` and `Aₙ ⊆ Nₙ`. -/
theorem prop_6_1_6_g [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_6_1_1 s lam)
    (M₀ M₁ : Model U L) (h : s.leNF lam M₀ M₁) (A₀ A₁ : Set U) (hA₀ : A₀ ⊆ M₀.carrier)
    (hA₁ : A₁ ⊆ M₁.carrier) (hc₀ : #A₀ ≤ lam) (hc₁ : #A₁ ≤ lam) :
    ∃ N₀ ∈ s.S.Kc lam, ∃ N₁ ∈ s.S.Kc lam, s.NFhat lam N₀ N₁ M₀ M₁ ∧ A₀ ⊆ N₀.carrier ∧
      A₁ ⊆ N₁.carrier :=
  Frame.leNF_lst hU hs h hA₀ hA₁ hc₀ hc₁

/-- AUX: not in paper. An embedding over `M` preserves `tp(a, M, ·)`. -/
theorem tp_emb {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} {f : U → U} {a : U}
    {M N N' : Model U L} (hK : (M, N, a) ∈ S.K3) (hle : S.le M N') (hf : IsEmb S f N N')
    (hov : ∀ x ∈ M.carrier, f x = x) : tp S lam a M N = tp S lam (f a) M N' := by
  obtain ⟨-, hN', P, hP, hfP⟩ := id hf
  have ha' : f a ∈ N'.carrier := hS.sub hP (hfP.mapsTo hK.2.2.2)
  exact tp_eq_iff.2 (Relation.EqvGen.rel _ _ ⟨hK, ⟨hK.1, hN', hle, ha'⟩, rfl, N', hN',
    hS.refl hN', f, hf, ⟨fun x hx => ⟨hS.sub hK.2.2.1 hx, hS.sub hle hx⟩, hov⟩, rfl⟩)

/-- AUX: not in paper. From a realized type to an extension of an embedding: `g : B → N`, `r` inverts `g`
on the image, `tp(x', B, C) = tp(r a, B, N')`, `a ∈ N`. -/
theorem IsAEC.star_gen {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hAP : AP S lam) (hlst : S.LST ≤ lam) (hinf : ℵ₀ ≤ lam) {B C N N' : Model U L} {g r : U → U}
    {a x' : U} (kB : B ∈ S.Kc lam) (kC : C ∈ S.Kc lam) (kN : N ∈ S.Kc lam) (lBC : S.le B C)
    (hg : IsEmb S g B N) (hr : IsoOn r N N') (lBN' : S.le B N') (hrg : ∀ y ∈ B.carrier, r (g y) = y)
    (ha : a ∈ N.carrier) (hx' : x' ∈ C.carrier) (htp : tp S lam x' B C = tp S lam (r a) B N') :
    ∃ (W₀ : Model U L) (h₀ : U → U), W₀ ∈ S.Kc lam ∧ S.le N W₀ ∧ IsEmb S h₀ C W₀ ∧
      (∀ x ∈ B.carrier, h₀ x = g x) ∧ h₀ x' = a := by
  classical
  have kN' : N' ∈ S.Kc lam := ⟨hS.iso_mem kN.1 hr, by rw [hr.card_eq]; exact kN.2⟩
  obtain ⟨N₂, kN₂, lN'N₂, u, hu, huo, hux⟩ := tp_eq_small hS hU hAP hlst hinf
    (M := B) (N := C) (N' := N') (a := x') (a' := r a) ⟨kB, kC, lBC, hx'⟩
    ⟨kB, kN', lBN', hr.mapsTo ha⟩ htp
  obtain ⟨r', hr', h1, h2⟩ := hr.exists_inv
  have hsmall : #(∅ ∪ N.carrier : Set U) < #U := by
    rw [Set.empty_union]
    have : #N.carrier = lam := kN.2
    rw [this]; exact hU.2
  obtain ⟨ρ, W₀, hρ, hid, lN, memW, -⟩ := hS.rename hU.infinite ∅ lN'N₂ hr' hsmall
  have kW₀ : W₀ ∈ S.Kc lam := ⟨memW, by rw [hρ.card_eq]; exact kN₂.2⟩
  obtain ⟨-, -, P, lP, iP⟩ := id hg
  refine ⟨W₀, ρ ∘ u, kW₀, lN, hu.comp_iso hS hρ, fun x hx => ?_, ?_⟩
  · have hgx : g x ∈ N.carrier := hS.sub lP (iP.mapsTo hx)
    have hxN' : x ∈ N'.carrier := hS.sub lBN' hx
    simp only [Function.comp, huo.2 x hx, hid x hxN']
    have := h1 _ hgx
    rwa [hrg x hx] at this
  · simp only [Function.comp, hux, hid _ (hr.mapsTo ha), h1 a ha]

/-- AUX: not in paper. The core of Thm 2.5.8(2): `N ≽ M_{α₀}` in `K_λ` embeds in `M_{λ⁺}` over `M_{α₀}`. -/
theorem Frame.emb_into {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : s.Cond12 lam)
    (h0 : s.Ax0a ∧ s.Ax0b lam) (hinf : ℵ₀ ≤ lam) (M : Ordinal.{u} → Model U L)
    (hM : IsIncreasing s.S.le M (Iic (Order.succ lam).ord) ∧
      IsContinuous M (Iic (Order.succ lam).ord) ∧ ∀ α < (Order.succ lam).ord, M α ∈ s.S.Kc lam)
    (hreal : ∀ α < (Order.succ lam).ord, ∀ p ∈ s.Sbs (M α),
      ∃ β, α < β ∧ β < (Order.succ lam).ord ∧ Realizes s.S lam (M β) (M α) p)
    {α₀ : Ordinal.{u}} (hα₀ : α₀ < (Order.succ lam).ord) {N : Model U L} (kN : N ∈ s.S.Kc lam)
    (lN : s.S.le (M α₀) N) :
    ∃ f, IsEmb s.S f N (M (Order.succ lam).ord) ∧ ∀ x ∈ (M α₀).carrier, f x = x := by
  classical
  have hS : IsAEC s.S := h0.1
  obtain ⟨-, h1b, -, h2a, h2b, h2c, -⟩ := id hs
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  obtain ⟨hMi, hMc, hMK⟩ := hM
  have κm : (Order.succ lam).ord ∈ Iic (Order.succ lam).ord := mem_Iic.2 le_rfl
  have lt1 : ∀ x : Ordinal.{u}, x < x + 1 := fun x => Order.lt_add_one_iff.2 le_rfl
  have Mle : ∀ a < (Order.succ lam).ord, s.S.le (M a) (M (Order.succ lam).ord) := fun a ha =>
    hMi a (mem_Iic.2 ha.le) _ κm ha
  have Mlt : ∀ a b, a < b → b < (Order.succ lam).ord → s.S.le (M a) (M b) := fun a b h hb =>
    hMi a (mem_Iic.2 (h.le.trans hb.le)) b (mem_Iic.2 hb.le) h
  by_contra hno
  let Inv : Ordinal.{u} → (Ordinal.{u} → Ordinal.{u} × Model U L × (U → U)) → Prop := fun ε c =>
    ε < (Order.succ lam).ord →
    (∀ β ≤ ε, (c β).1 < (Order.succ lam).ord ∧ (c β).2.1 ∈ s.S.Kc lam ∧
      IsEmb s.S (c β).2.2 (M (c β).1) (c β).2.1) ∧
    (c 0).1 = α₀ ∧ (c 0).2.1 = N ∧ (∀ x ∈ (M α₀).carrier, (c 0).2.2 x = x) ∧
    (∀ a b, a < b → b ≤ ε → (c a).1 < (c b).1) ∧
    (∀ b ≤ ε, Order.IsSuccLimit b → Order.IsSuccLimit (c b).1 ∧ ∀ x < (c b).1, ∃ a < b, x < (c a).1) ∧
    IsIncreasing s.S.le (fun β => (c β).2.1) (Iic ε) ∧ IsContinuous (fun β => (c β).2.1) (Iic ε) ∧
    FunIncreasing (fun β => (c β).2.2) (fun β => M (c β).1) (Iic ε) ∧
    FunContinuous (fun β => (c β).2.2) (fun β => M (c β).1) (Iic ε) ∧
    ∀ β, β + 1 ≤ ε → ∃ a ∈ (M (c (β + 1)).1).carrier \ (M (c β).1).carrier,
      (c (β + 1)).2.2 a ∈ (c β).2.1.carrier
  haveI : Nonempty (Ordinal.{u} × Model U L × (U → U)) := ⟨(α₀, N, id)⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (Order.succ lam).ord Inv
    (fun ε c c' h hi hε => by
      obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := hi hε
      have e : ∀ β ≤ ε, c' β = c β := fun β hβ => (h β hβ).symm
      have e0 := e 0 zero_le
      refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2, by rw [e0]; exact h3,
        by rw [e0]; exact h4, fun a b hab hb => by
          rw [e a (hab.le.trans hb), e b hb]; exact h5 a b hab hb, fun b hb hl => ?_,
        fun a ha b hb hab => ?_, fun b hb hl => ?_, fun a ha b hb hab y hy => ?_,
        fun b hb hl y hy => ?_, fun β hβ => ?_⟩
      · rw [e b hb]
        refine ⟨(h6 b hb hl).1, fun x hx => ?_⟩
        obtain ⟨a, ha, h⟩ := (h6 b hb hl).2 x hx
        exact ⟨a, ha, by rw [e a (ha.le.trans hb)]; exact h⟩
      · simp only [e a ha, e b hb]; exact h7 a ha b hb hab
      · simp only [e b hb]; rw [h8 b hb hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hb)]
      · simp only [e a ha] at hy
        simp only [e a ha, e b hb]; exact h9 a ha b hb hab y hy
      · simp only [e b hb] at hy
        obtain ⟨ξ, hξ, hyξ, hx⟩ := h10 b hb hl y hy
        have eξ := e ξ (hξ.le.trans hb)
        refine ⟨ξ, hξ, by simp only [eξ]; exact hyξ, ?_⟩
        simp only [e b hb, eξ]; exact hx
      · rw [e β ((lt1 β).le.trans hβ), e (β + 1) hβ]; exact h11 β hβ)
    (fun ε hεle c prev => by
      by_cases hεκ : ε < (Order.succ lam).ord
      swap
      · exact ⟨(α₀, N, id), fun h => absurd h hεκ⟩
      rcases Ordinal.zero_or_succ_or_isSuccLimit ε with rfl | ⟨γ, hγ⟩ | hl
      · refine ⟨(α₀, N, id), fun _ => ?_⟩
        have hc0 : (fun b => if b < (0 : Ordinal.{u}) then c b else (α₀, N, id)) = fun _ => (α₀, N, id) :=
          funext fun b => if_neg (not_lt.2 zero_le)
        rw [hc0]
        have hz : ∀ b ≤ (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
        have hbad : ∀ {a b : Ordinal.{u}}, b ∈ Iic (0 : Ordinal.{u}) → a < b → False :=
          fun {a b} hb h => absurd (lt_of_lt_of_le h hb) (not_lt.2 zero_le)
        have hbl : ∀ {b : Ordinal.{u}}, b ≤ 0 → Order.IsSuccLimit b → False := fun {b} hb hl => by
          rw [hz b hb] at hl; exact Order.not_isSuccLimit_bot hl
        refine ⟨fun _ _ => ⟨hα₀, kN, IsEmb.of_le hS lN⟩, rfl, rfl, fun _ _ => rfl,
          fun a b h hb => (hbad (mem_Iic.2 hb) h).elim, fun b hb hl => (hbl hb hl).elim,
          fun _ _ b hb h => (hbad hb h).elim, fun b hb hl => (hbl hb hl).elim,
          fun _ _ b hb h => (hbad hb h).elim, fun b hb hl => (hbl hb hl).elim, fun b hb => ?_⟩
        exact absurd (lt_of_lt_of_le (lt1 b) hb) (not_lt.2 zero_le)
      · rw [Order.succ_eq_add_one] at hγ
        subst hγ
        have hγκ : γ < (Order.succ lam).ord := (lt1 γ).trans hεκ
        obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11⟩ := prev γ (lt1 γ) hγκ
        obtain ⟨hακ, kNγ, hemb⟩ := p1 γ le_rfl
        have kB := hMK _ hακ
        obtain ⟨-, -, P, lP, iP⟩ := id hemb
        have kP : P ∈ s.S.Kc lam := ⟨hS.mem_left lP, by rw [iP.card_eq]; exact kB.2⟩
        have hle0 : ∀ b ≤ γ, s.S.le (c b).2.1 (c γ).2.1 := fun b hb => by
          rcases hb.lt_or_eq with h | h
          · exact p7 b (mem_Iic.2 hb) γ (mem_Iic.2 le_rfl) h
          · rw [h]; exact hS.refl kNγ.1
        have hfix0 : ∀ x ∈ (M α₀).carrier, (c γ).2.2 x = x := by
          intro x hx
          rcases (zero_le : (0 : Ordinal.{u}) ≤ γ).lt_or_eq with h | h
          · have hx0 : x ∈ ((fun β => M (c β).1) 0).carrier := by
              show x ∈ (M (c 0).1).carrier
              rw [p2]; exact hx
            exact (p9 0 (mem_Iic.2 zero_le) γ (mem_Iic.2 le_rfl) h x hx0).trans (p4 x hx)
          · rw [← h]; exact p4 x hx
        have hneP : P ≠ (c γ).2.1 := by
          intro e
          obtain ⟨gi, hgi, gi1, -⟩ := iP.exists_inv
          have hgi' : IsoOn gi (c γ).2.1 (M (c γ).1) := e ▸ hgi
          have lNN : s.S.le N (c γ).2.1 := by
            have := hle0 0 zero_le
            rwa [p3] at this
          refine hno ⟨gi, ?_, fun x hx => ?_⟩
          · have e1 : IsEmb s.S (gi ∘ id) N (M (c γ).1) := (IsEmb.of_le hS lNN).comp_iso hS hgi'
            have e2 := e1.comp hS (IsEmb.of_le hS (Mle _ hακ))
            simpa using e2
          · have hxB : x ∈ (M (c γ).1).carrier := by
              rcases (zero_le : (0 : Ordinal.{u}) ≤ γ).lt_or_eq with h | h
              · have := p5 0 γ h le_rfl
                rw [p2] at this
                exact hS.sub (Mlt _ _ this hακ) hx
              · rw [← h, p2]; exact hx
            have := gi1 x hxB
            rwa [hfix0 x hx] at this
        have hlt : s.S.lt P (c γ).2.1 := ⟨lP, hneP⟩
        obtain ⟨b₀, hb₀, hbs⟩ := h2c P kP _ kNγ hlt
        obtain ⟨gi, hgi, gi1, -⟩ := iP.exists_inv
        have hsm : #(∅ ∪ (M (c γ).1).carrier : Set U) < #U := by
          rw [Set.empty_union]
          have : #(M (c γ).1).carrier = lam := kB.2
          rw [this]; exact hU.2
        obtain ⟨r, N', hr, hid, lB, mem, -⟩ := hS.rename hU.infinite ∅ lP hgi hsm
        have hrP : IsoOn r P (M (c γ).1) := hgi.congr fun x hx => (hid x hx).symm
        have hbs' := h2b P _ N' _ b₀ r kP hbs hr hrP
        obtain ⟨β', hβ1, hβ2, x', hx', hxt⟩ := hreal _ hακ _ hbs'
        obtain ⟨W₀, h₀, kW₀, lNW, em, ext, hx0⟩ := hS.star_gen hU h1b h0.2 hinf kB (hMK _ hβ2) kNγ
          (Mlt _ _ hβ1 hβ2) hemb hr lB (fun y hy => by rw [hid _ (iP.mapsTo hy)]; exact gi1 y hy)
          hb₀.1 hx' hxt
        obtain ⟨W, y, -, -, hy, hEq⟩ := h2a _ kB hbs'
        have hx'B : x' ∉ (M (c γ).1).carrier := fun hab => by
          have e : y = x' := (ERel.alg (tp_eq_iff.1 (hxt.trans hEq))).1 hab
          exact hy.2 (e ▸ hab)
        refine ⟨(β', W₀, h₀), fun _ => ?_⟩
        set c' : Ordinal.{u} → Ordinal.{u} × Model U L × (U → U) :=
          fun b => if b < γ + 1 then c b else (β', W₀, h₀) with hc'def
        have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
        have hcx : c' (γ + 1) = (β', W₀, h₀) := if_neg (lt_irrefl _)
        have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
          rcases hb.lt_or_eq with h | h
          · exact Or.inl (Order.lt_add_one_iff.1 h)
          · exact Or.inr h
        have hαle : ∀ b ≤ γ, (c b).1 ≤ (c γ).1 := fun b hb => by
          rcases hb.lt_or_eq with h | h
          · exact (p5 b γ h le_rfl).le
          · rw [h]
        refine ⟨fun b hb => ?_, by rw [hcl 0 zero_le]; exact p2, by rw [hcl 0 zero_le]; exact p3,
          by rw [hcl 0 zero_le]; exact p4, fun a b hab hb => ?_, fun b hb hl' => ?_,
          fun a ha b hb hab => ?_, fun b hb hl' => ?_, fun a ha b hb hab y' hy' => ?_,
          fun b hb hl' y' hy' => ?_, fun b hb => ?_⟩
        · rcases hcases b hb with h | h
          · rw [hcl b h]; exact p1 b h
          · rw [h, hcx]; exact ⟨hβ2, kW₀, em⟩
        · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
          rw [hcl a haγ]
          rcases hcases b hb with h | h
          · rw [hcl b h]; exact p5 a b hab h
          · rw [h, hcx]; exact lt_of_le_of_lt (hαle a haγ) hβ1
        · rcases hcases b hb with h | h
          · rw [hcl b h]
            refine ⟨(p6 b h hl').1, fun x hx => ?_⟩
            obtain ⟨a, ha, h'⟩ := (p6 b h hl').2 x hx
            exact ⟨a, ha, by rw [hcl a (ha.le.trans h)]; exact h'⟩
          · rw [h] at hl'
            exact absurd (hl'.add_one_lt (lt1 γ)) (lt_irrefl _)
        · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
          show s.S.le (c' a).2.1 (c' b).2.1
          rw [hcl a haγ]
          rcases hcases b hb with h | h
          · rw [hcl b h]; exact p7 a (mem_Iic.2 haγ) b (mem_Iic.2 h) hab
          · rw [h, hcx]; exact hS.trans (hle0 a haγ) lNW
        · rcases hcases b hb with h | h
          · show (c' b).2.1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).2.1.carrier
            rw [hcl b h, p8 b (mem_Iic.2 h) hl']
            exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (hξ.le.trans h)]
          · rw [h] at hl'
            exact absurd (hl'.add_one_lt (lt1 γ)) (lt_irrefl _)
        · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
          have hy2 : y' ∈ (M (c a).1).carrier := by
            have : y' ∈ (M (c' a).1).carrier := hy'
            rwa [hcl a haγ] at this
          show (c' b).2.2 y' = (c' a).2.2 y'
          rw [hcl a haγ]
          rcases hcases b hb with h | h
          · rw [hcl b h]; exact p9 a (mem_Iic.2 haγ) b (mem_Iic.2 h) hab y' hy2
          · rw [h, hcx]
            have hyγ : y' ∈ (M (c γ).1).carrier := by
              rcases haγ.lt_or_eq with h' | h'
              · exact hS.sub (Mlt _ _ (p5 a γ h' le_rfl) hακ) hy2
              · rw [← h']; exact hy2
            show h₀ y' = _
            rw [ext y' hyγ]
            rcases haγ.lt_or_eq with h' | h'
            · exact p9 a (mem_Iic.2 haγ) γ (mem_Iic.2 le_rfl) h' y' hy2
            · rw [h']
        · rcases hcases b hb with h | h
          · have hy2 : y' ∈ (M (c b).1).carrier := by
              have : y' ∈ (M (c' b).1).carrier := hy'
              rwa [hcl b h] at this
            obtain ⟨ξ, hξ, hyξ, hx⟩ := p10 b (mem_Iic.2 h) hl' y' hy2
            refine ⟨ξ, hξ, ?_, ?_⟩
            · show y' ∈ (M (c' ξ).1).carrier
              rw [hcl ξ (hξ.le.trans h)]; exact hyξ
            · show (c' b).2.2 y' = (c' ξ).2.2 y'
              rw [hcl b h, hcl ξ (hξ.le.trans h)]; exact hx
          · rw [h] at hl'
