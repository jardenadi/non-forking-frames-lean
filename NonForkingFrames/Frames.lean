/-- AUX: not in paper. `K_λ ≠ ∅` gives `K_{λ⁺} ≠ ∅` (the argument at the beginning of
Section 2.1 of the paper: a `≺`-increasing continuous chain of length `λ⁺` in `K_λ`). -/
theorem Frame.exists_Kc_succ {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    (hne : (s.S.Kc lam).Nonempty) : (s.S.Kc (Order.succ lam)).Nonempty := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨M₀, kM₀⟩ := hne
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc kM₀
  have hinf₁ : ℵ₀ ≤ Order.succ lam := hinf.trans (Order.le_succ lam)
  have hκl := Cardinal.isSuccLimit_ord hinf₁
  have hgo : ∀ N ∈ s.S.Kc lam, ∃ N' ∈ s.S.Kc lam, s.S.lt N N' := fun N hN => by
    have hnm := hc.ax1c _ hN
    by_contra hcon
    exact hnm ⟨hN, fun ⟨N', hN', hl⟩ => hcon ⟨N', hN', hl.1.2.2, hl.2⟩⟩
  let Inv : Ordinal.{u} → (Ordinal.{u} → Model U L) → Prop := fun α c =>
    α < (Order.succ lam).ord → c α ∈ s.S.Kc lam ∧ (∀ β < α, s.S.lt (c β) (c α)) ∧
      (Order.IsSuccLimit α → IsUnionOf c (Iio α) (c α))
  have hloc : ∀ α (c c' : Ordinal.{u} → Model U L), (∀ β ≤ α, c β = c' β) → Inv α c → Inv α c' := by
    intro α c c' e h hα
    obtain ⟨h1, h2, h3⟩ := h hα
    have eα := e α le_rfl
    refine ⟨eα ▸ h1, fun β hβ => by rw [← eα, ← e β hβ.le]; exact h2 β hβ, fun hl => ?_⟩
    rw [← eα]; exact (h3 hl).congr' fun β hβ => e β (le_of_lt hβ)
  have : Nonempty (Model U L) := ⟨M₀⟩
  obtain ⟨c, hcI⟩ := transfinite_construction (Order.succ lam).ord Inv hloc (by
    intro α hαθ c ih
    by_cases hα : α < (Order.succ lam).ord
    swap
    · exact ⟨M₀, fun h => absurd h hα⟩
    have ih' : ∀ β < α, _ := fun β hβ => ih β hβ (hβ.trans hα)
    suffices hx : ∃ x : Model U L, x ∈ s.S.Kc lam ∧ (∀ β < α, s.S.lt (c β) x) ∧
        (Order.IsSuccLimit α → IsUnionOf c (Iio α) x) by
      obtain ⟨x, h1, h2, h3⟩ := hx
      refine ⟨x, fun _ => ?_⟩
      simp only [lt_irrefl, ite_false]
      refine ⟨h1, fun β hβ => ?_, fun hl => (h3 hl).congr' fun β hβ => ?_⟩
      · simp only [hβ, ite_true]; exact h2 β hβ
      · have : β < α := hβ
        simp only [this, ite_true]
    rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0 | ⟨η, hη⟩ | hl
    · subst h0
      exact ⟨M₀, kM₀, fun β hβ => absurd hβ (not_lt.2 zero_le),
        fun hl => absurd hl Order.not_isSuccLimit_bot⟩
    · have hη' : α = η + 1 := hη.symm
      subst hη'
      have hηlt : η < η + 1 := Order.lt_add_one_iff.2 le_rfl
      obtain ⟨kη, ltη, -⟩ := ih' η hηlt
      obtain ⟨x, kx, lx⟩ := hgo _ kη
      refine ⟨x, kx, fun β hβ => ?_, fun hl => absurd hl fun hl' =>
        lt_irrefl _ (hl'.add_one_lt hηlt)⟩
      rcases (Order.lt_succ_iff.1 hβ).lt_or_eq with h | h
      · exact ⟨hS.trans (ltη β h).1 lx.1, fun e => by
          obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt lx
          exact hyn (hS.sub (ltη β h).1 (e ▸ hy))⟩
      · rw [h]; exact lx
    · have hi : IsIncreasing s.S.le c (Iio α) := fun a' _ b' hb h' => ((ih' b' hb).2.1 a' h').1
      have hco : IsContinuous c (Iio α) := fun β hβ hl' => ((ih' β hβ).2.2 hl').1
      obtain ⟨V, kV, uV, lV⟩ := hS.union_Kc hinf hl hα hi hco fun β hβ => (ih' β hβ).1
      refine ⟨V, kV, fun β hβ => ⟨lV β hβ, fun e => ?_⟩, fun _ => uV⟩
      have hβ1 : β + 1 < α := hl.add_one_lt hβ
      obtain ⟨y, hy, hyn⟩ := hS.exists_diff_of_lt ((ih' (β + 1) hβ1).2.1 β (Order.lt_add_one_iff.2 le_rfl))
      exact hyn (e ▸ hS.sub (lV _ hβ1) hy))
  have hI : ∀ α < (Order.succ lam).ord, _ := fun α hα => hcI α hα.le hα
  have hi : IsIncreasing s.S.le c (Iio (Order.succ lam).ord) := fun a' _ b' hb h' => ((hI b' hb).2.1 a' h').1
  have hco : IsContinuous c (Iio (Order.succ lam).ord) := fun β hβ hl' => ((hI β hβ).2.2 hl').1
  obtain ⟨N, hN, kN, -⟩ := hS.union _ hκl c hi hco
  refine ⟨N, kN, le_antisymm ?_ ?_⟩
  · show #N.carrier ≤ _
    rw [hN.1]
    exact card_biUnion_le hinf₁ (by rw [Cardinal.card_ord]) fun β hβ =>
      (le_of_eq (hI β hβ).1.2).trans (Order.le_succ lam)
  · have hdiff : ∀ β, β < (Order.succ lam).ord → ∃ y ∈ (c (β + 1)).carrier, y ∉ (c β).carrier := fun β hβ =>
      hS.exists_diff_of_lt ((hI (β + 1) (hκl.add_one_lt hβ)).2.1 β (Order.lt_add_one_iff.2 le_rfl))
    choose y hy1 hy2 using hdiff
    let E := Ordinal.ToType.mk (o := (Order.succ lam).ord)
    have hsubc : ∀ a < (Order.succ lam).ord, ∀ b < (Order.succ lam).ord, a ≤ b →
        (c a).carrier ⊆ (c b).carrier := fun a ha b hb h => by
      rcases h.lt_or_eq with h' | h'
      · exact hS.sub (hi a ha b hb h')
      · rw [h']
    let g : (Order.succ lam).ord.ToType → N.carrier := fun i =>
      ⟨y (E.symm i) (E.symm i).2, by
        rw [hN.1]
        exact Set.mem_iUnion₂.2 ⟨_, hκl.add_one_lt (E.symm i).2, hy1 _ _⟩⟩
    have hg : Function.Injective g := by
      intro i j hij
      have hij' := congrArg Subtype.val hij
      simp only [g] at hij'
      by_contra hne
      have hne' : (E.symm i : Ordinal.{u}) ≠ E.symm j := fun e =>
        hne (E.symm.injective (Subtype.ext e))
      have key : ∀ i' j' : (Order.succ lam).ord.ToType, (E.symm i' : Ordinal.{u}) < E.symm j' →
          y (E.symm i') (E.symm i').2 ≠ y (E.symm j') (E.symm j').2 := by
        intro i' j' hlt he
        have h1 := hsubc _ (hκl.add_one_lt (E.symm i').2) _ (E.symm j').2
          (Order.add_one_le_of_lt hlt) (hy1 _ (E.symm i').2)
        exact hy2 _ _ (he ▸ h1)
      rcases lt_or_gt_of_ne hne' with h | h
      · exact key i j h hij'
      · exact key j i h hij'.symm
    have := Cardinal.mk_le_of_injective hg
    rw [Cardinal.mk_toType, Cardinal.card_ord] at this
    exact this

/-- AUX: not in paper. `K⁺ ⊆ K` and `≼⁺ ⊆ ≼` for `K⁺ = (K^sat, ≼^NF)^up` (Section 2.1 of the paper),
from the widened Fact 1.0.18. -/
theorem Frame.up_sub [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) :
    (∀ M ∈ (s.upKSys lam).K, M ∈ s.S.K) ∧ ∀ M N, (s.upKSys lam).le M N → s.S.le M N := by
  have hS : IsAEC s.S := hc.ax0a
  have hle : ∀ M N, (s.satKSys lam).le M N → s.S.le M N := fun M N h => h.2.2.2.2.1
  exact ⟨fun M hM => ((C.fact_1_0_18_up s.S hS).1 M (InUp.mono hle hM)).1,
    fun M N h => (C.fact_1_0_18_up s.S hS).2 M N (LeUp.mono hle h)⟩

/-- AUX: not in paper. The construction of Prop 3.1.8 (`Frame.construction_318`) along a chain of
length `λ⁺` without a last model (for Prop 3.1.9(1)). -/
theorem Frame.construction_318_long [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : s.Core lam ∧ s.Ax3g lam ∧ s.Ax3e lam) {M : Ordinal.{u} → Model U L}
