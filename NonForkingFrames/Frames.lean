      have hnr : ¬ (((c γ).1, (c γ).2, a) ∈ s.K3r lam) := fun hr =>
        H ⟨(c γ).1, (c γ).2, hr, hγle⟩
      have hnr' : ∃ Ms Ns : Model U L, s.leBs lam ((c γ).1, (c γ).2, a) (Ms, Ns, a) ∧
