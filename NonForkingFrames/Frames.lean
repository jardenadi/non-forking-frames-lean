/-- AUX: not in paper. A relation on quadruples of models is closed under isomorphisms. -/
def IsoClosedQ (R : QRel U L) : Prop :=
  ∀ (M₀ M₁ M₂ M₃ M₀' M₁' M₂' M₃' : Model U L) (f : U → U), IsoOn f M₃ M₃' → IsoOn f M₀ M₀' →
    IsoOn f M₁ M₁' → IsoOn f M₂ M₂' → R M₀ M₁ M₂ M₃ → R M₀' M₁' M₂' M₃'

/-- AUX: not in paper. A three-term increasing chain indexed by `0, 0+1, 0+1+1`. -/
theorem IsAEC.three_chain {S : KSys U L} (hS : IsAEC S) {X0 X1 X2 : Model U L}
    (h01 : S.le X0 X1) (h12 : S.le X1 X2) :
    ∃ X : Ordinal.{u} → Model U L, X 0 = X0 ∧ X (0 + 1) = X1 ∧ X (0 + 1 + 1) = X2 ∧
      IsIncreasing S.le X (Iic (0 + 1 + 1)) ∧ IsContinuous X (Iic (0 + 1 + 1)) := by
  classical
  let o1 : Ordinal.{u} := 0 + 1
  let o2 : Ordinal.{u} := o1 + 1
  have l01 : (0 : Ordinal.{u}) < o1 := Order.lt_add_one_iff.2 le_rfl
  have l12 : o1 < o2 := Order.lt_add_one_iff.2 le_rfl
  have hcase : ∀ ε ≤ o2, ε = 0 ∨ ε = o1 ∨ ε = o2 := fun ε hε => by
    rcases hε.lt_or_eq with h | h
    · have h' : ε ≤ o1 := Order.lt_add_one_iff.1 h
      rcases h'.lt_or_eq with h'' | h''
      · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h'') zero_le)
      · exact Or.inr (Or.inl h'')
    · exact Or.inr (Or.inr h)
  let X : Ordinal.{u} → Model U L := fun ε => if ε = 0 then X0 else if ε = o1 then X1 else X2
  have e0 : X 0 = X0 := if_pos rfl
  have e1 : X o1 = X1 := by simp only [X, if_neg l01.ne', if_true]
  have e2 : X o2 = X2 := by
    simp only [X, if_neg (lt_trans l01 l12).ne', if_neg l12.ne', if_false]
  refine ⟨X, e0, e1, e2, fun a ha b hb h => ?_, fun b hb hl => ?_⟩
  · rcases hcase a ha with rfl | rfl | rfl <;> rcases hcase b hb with rfl | rfl | rfl
    · exact absurd h (lt_irrefl _)
    · rw [e0, e1]; exact h01
    · rw [e0, e2]; exact hS.trans h01 h12
    · exact absurd (lt_trans h l01) (lt_irrefl _)
    · exact absurd h (lt_irrefl _)
    · rw [e1, e2]; exact h12
    · exact absurd (lt_trans h (lt_trans l01 l12)) (lt_irrefl _)
    · exact absurd (lt_trans h l12) (lt_irrefl _)
    · exact absurd h (lt_irrefl _)
  · exfalso
    rcases hcase b hb with rfl | rfl | rfl
    · exact absurd hl Order.not_isSuccLimit_bot
    · have hl' : Order.IsSuccLimit (Order.succ (0 : Ordinal.{u})) := by
        rw [Order.succ_eq_add_one]; exact hl
      exact absurd hl'.isMax (not_isMax _)
    · have hl' : Order.IsSuccLimit (Order.succ o1) := by
        rw [Order.succ_eq_add_one]; exact hl
      exact absurd hl'.isMax (not_isMax _)

-- DEVIATION (author-confirmed erratum): (1) is for `NF^uq` with `a` explicit (`OtMinusE`, in which
-- weak uniqueness compares amalgamations moving the same element), (2) assumes `R` closed under
-- isomorphisms. Original text: "(1) `⊗⁻_{NF^uq}`. (2) For every relation `R`, `⊗_R → ⊗⁻_R`."
/-- Prop 5.4.3, corrected: (1) `⊗⁻` for `NF^uq` with explicit element; (2) `⊗_R → ⊗⁻_R` for
every `R` closed under isomorphisms. -/
theorem prop_5_4_3 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    OtMinusE s.S lam (s.NFuqE lam) ∧
      ∀ R : QRel U L, IsoClosedQ R → Otimes s.S lam R → OtMinus s.S lam R := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  refine ⟨Frame.otMinusE_NFuq hU hc, fun R hisoR ot => ?_⟩
  have hdom := ot.dom
  have hA := ot.a
  refine ⟨hdom, fun M₀ M₁ M₂ M₃ h => ?_, ?_, ?_⟩
  · obtain ⟨a, b, c', d, -⟩ := hA _ _ _ _ h
    exact ⟨a, b, c', d⟩
  · rintro N₀ N₁ N₂ A B hAm hBm ⟨P, Q, hP, hQ, hNA⟩ ⟨P', Q', hP', hQ', hNB⟩
    obtain ⟨k0, kP, kQ, kA⟩ := hdom _ _ _ _ hNA
    obtain ⟨-, kP', kQ', kB⟩ := hdom _ _ _ _ hNB
    obtain ⟨l0P, lPA, l0Q, lQA, hd⟩ := hA _ _ _ _ hNA
    obtain ⟨l0P', lPB, l0Q', lQB, hd'⟩ := hA _ _ _ _ hNB
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
    obtain ⟨⟨hA1, hA2, ovA1, ovA2⟩, -⟩ := id hAm
    obtain ⟨⟨hB1, hB2, ovB1, ovB2⟩, -⟩ := id hBm
    obtain ⟨θ₁, hθ₁, hθ₁B, -⟩ := hP'.exists_inv
    obtain ⟨θ₂, hθ₂, hθ₂B, -⟩ := hQ'.exists_inv
    have hN₀N₁ : N₀.carrier ⊆ N₁.carrier := fun x hx => (ovA1.1 hx).1
    have hN₀N₂ : N₀.carrier ⊆ N₂.carrier := fun x hx => (ovA2.1 hx).1
    have hθ₁0 : ∀ x ∈ N₀.carrier, θ₁ x = x := fun x hx => by
      have := hθ₁B x (hN₀N₁ hx); rwa [ovB1.2 x hx] at this
    have hθ₂0 : ∀ x ∈ N₀.carrier, θ₂ x = x := fun x hx => by
      have := hθ₂B x (hN₀N₂ hx); rwa [ovB2.2 x hx] at this
    let u₁ : U → U := A.1 ∘ θ₁
    let u₂ : U → U := A.2.1 ∘ θ₂
    have hu₁ : IsoOn u₁ P' P := hθ₁.comp hP
    have hu₂ : IsoOn u₂ Q' Q := hθ₂.comp hQ
    have hu₁0 : ∀ x ∈ N₀.carrier, u₁ x = x := fun x hx => by
      show A.1 (θ₁ x) = x
      rw [hθ₁0 x hx, ovA1.2 x hx]
    have hu₂0 : ∀ x ∈ N₀.carrier, u₂ x = x := fun x hx => by
      show A.2.1 (θ₂ x) = x
      rw [hθ₂0 x hx, ovA2.2 x hx]
    have hsP : N₀.carrier ⊆ P'.carrier := hS.sub l0P'
    have hsQ : N₀.carrier ⊆ Q'.carrier := hS.sub l0Q'
    have back : ∀ {x : U}, x ∈ P'.carrier → u₁ x ∈ N₀.carrier → x ∈ N₀.carrier := fun {x} hx h3 => by
      have := hu₁.injOn hx (hsP h3) (hu₁0 _ h3).symm
      rw [this]; exact h3
    let h₀ : U → U := fun x => if x ∈ P'.carrier then u₁ x else u₂ x
    have hinj : InjOn h₀ (P'.carrier ∪ Q'.carrier) := by
      intro x hx y hy hxy
      by_cases hxB : x ∈ P'.carrier <;> by_cases hyB : y ∈ P'.carrier
      · simp only [h₀, hxB, hyB, if_true] at hxy; exact hu₁.injOn hxB hyB hxy
      · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
        have hyQ := hy.resolve_left hyB
        have h3 : u₁ x ∈ N₀.carrier := by
          rw [← hd]; exact ⟨hu₁.mapsTo hxB, by rw [hxy]; exact hu₂.mapsTo hyQ⟩
        have hx0 := back hxB h3
        have hy0 : u₂ y = u₂ x := by rw [← hxy, hu₁0 x hx0, hu₂0 x hx0]
        rw [hu₂.injOn hyQ (hsQ hx0) hy0]
      · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
        have hxQ := hx.resolve_left hxB
        have h3 : u₁ y ∈ N₀.carrier := by
          rw [← hd]; exact ⟨hu₁.mapsTo hyB, by rw [← hxy]; exact hu₂.mapsTo hxQ⟩
        have hy0 := back hyB h3
        have hx0 : u₂ x = u₂ y := by rw [hxy, hu₁0 y hy0, hu₂0 y hy0]
        rw [hu₂.injOn hxQ (hsQ hy0) hx0]
      · simp only [h₀, hxB, hyB, if_false] at hxy
        exact hu₂.injOn (hx.resolve_left hxB) (hy.resolve_left hyB) hxy
    have hsmall : #(∅ ∪ h₀ '' (P'.carrier ∪ Q'.carrier) : Set U) < #U := by
      rw [Set.empty_union]
      refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset (t := P.carrier ∪ Q.carrier) ?_)
        (card_union_le kP kQ hinf)) hU.2
      rintro _ ⟨x, hx, rfl⟩
      by_cases hxB : x ∈ P'.carrier
      · left; simp only [h₀, hxB, if_true]; exact hu₁.mapsTo hxB
      · right; simp only [h₀, hxB, if_false]; exact hu₂.mapsTo (hx.resolve_left hxB)
    obtain ⟨ρ, hρ, hρD, -⟩ := exists_rename hU.infinite h₀ hinj (X := B.2.2.carrier) hsmall
    obtain ⟨B₃, hB₃⟩ := exists_isoOn hρ
    have hρP : ∀ x ∈ P'.carrier, ρ x = u₁ x := fun x hx => by
      rw [hρD x (Or.inl hx)]; simp only [h₀, hx, if_true]
    have hρQ : ∀ x ∈ Q'.carrier, ρ x = u₂ x := fun x hx => by
      rw [hρD x (Or.inr hx)]
      by_cases hxB : x ∈ P'.carrier
      · have hx0 : x ∈ N₀.carrier := by rw [← hd']; exact ⟨hxB, hx⟩
        simp only [h₀, hxB, if_true]
        rw [hu₁0 x hx0, hu₂0 x hx0]
      · simp only [h₀, hxB, if_false]
    have hρ0 : IsoOn ρ N₀ N₀ := (IsoOn.refl _).congr fun x hx => by
      show x = ρ x
      rw [hρP x (hsP hx), hu₁0 x hx]
    have hNB' := hisoR _ _ _ _ N₀ P Q B₃ ρ hB₃ hρ0 (hu₁.congr fun x hx => (hρP x hx).symm)
      (hu₂.congr fun x hx => (hρQ x hx).symm) hNB
    obtain ⟨Z, F, G, hZ, hF, hG, ovF, ovG⟩ := ot.d _ _ _ _ _ hNA hNB'
    have hN₁c : N₁ ∈ s.S.Kc lam := ⟨hA1.1, by
      obtain ⟨κ, hκ, -⟩ := hP.exists_inv; rw [hκ.card_eq]; exact kP.2⟩
    have hN₂c : N₂ ∈ s.S.Kc lam := ⟨hA2.1, by
      obtain ⟨κ, hκ, -⟩ := hQ.exists_inv; rw [hκ.card_eq]; exact kQ.2⟩
    have pull : ∀ {g : U → U} {X Y : Model U L}, IsoOn g X Y → s.S.le N₀ Y →
        (∀ x ∈ N₀.carrier, g x = x) → N₀.carrier ⊆ X.carrier → s.S.le N₀ X := by
      intro g X Y hg hle hg0 hsub
      obtain ⟨κ, hκ, hκg, -⟩ := hg.exists_inv
      exact hS.iso_le hle hκ ((IsoOn.refl _).congr fun x hx => by
        show x = κ x
        have := hκg x (hsub hx); rw [hg0 x hx] at this; exact this.symm)
    exact ⟨k0, hN₁c, hN₂c, pull hP l0P ovA1.2 hN₀N₁, pull hQ l0Q ovA2.2 hN₀N₂, hAm, hBm, F,
      G ∘ ρ, Z, hF, IsEmb.iso_comp hB₃ kB.1 hG, fun x hx => by
        show G (ρ (B.1 x)) = F (A.1 x)
        have hm := hP'.mapsTo hx
        have e1 : u₁ (B.1 x) = A.1 x := by show A.1 (θ₁ (B.1 x)) = A.1 x; rw [hθ₁B x hx]
        rw [hρP _ hm, e1, ovG.2 _ (Or.inl (hP.mapsTo hx)), ovF.2 _ (Or.inl (hP.mapsTo hx))],
      fun x hx => by
        show G (ρ (B.2.1 x)) = F (A.2.1 x)
        have hm := hQ'.mapsTo hx
        have e1 : u₂ (B.2.1 x) = A.2.1 x := by show A.2.1 (θ₂ (B.2.1 x)) = A.2.1 x; rw [hθ₂B x hx]
        rw [hρQ _ hm, e1, ovG.2 _ (Or.inr (hQ.mapsTo hx)), ovF.2 _ (Or.inr (hQ.mapsTo hx))]⟩
  · intro M₀ M₁ M₂ M₃ M₄ f h hf hM₄
    obtain ⟨k0, k1, k2, k3⟩ := hdom _ _ _ _ h
    obtain ⟨l01, l13, l02, l23, hd12⟩ := hA _ _ _ _ h
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
    obtain ⟨-, -, Q₂, hQ₂, hfQ⟩ := id hf
    have hQ₂c : Q₂ ∈ s.S.Kc lam := ⟨hS.mem_left hQ₂, by rw [hfQ.card_eq]; exact k2.2⟩
    obtain ⟨g₀, M₃', hg₀, hg₀f, hQM, hM'K, hout⟩ := hS.rename hU.infinite M₄.carrier l23 hfQ
      (lt_of_le_of_lt (card_union_le hM₄ hQ₂c hinf) hU.2)
    have hM'c : M₃' ∈ s.S.Kc lam := ⟨hM'K, by rw [hg₀.card_eq]; exact k3.2⟩
    obtain ⟨P, hfP⟩ := exists_isoOn (hfQ.injOn.mono (hS.sub l02))
    obtain ⟨Q₁, hgQ⟩ := exists_isoOn (hg₀.injOn.mono (hS.sub l13))
    have hg₀P : IsoOn g₀ M₀ P := hfP.congr fun x hx => (hg₀f x (hS.sub l02 hx)).symm
    have hg₀Q₂ : IsoOn g₀ M₂ Q₂ := hfQ.congr fun x hx => (hg₀f x hx).symm
    have hR' := hisoR _ _ _ _ P Q₁ Q₂ M₃' g₀ hg₀ hg₀P hgQ hg₀Q₂ h
    have hdisj : M₃'.carrier ∩ M₄.carrier = Q₂.carrier := by
      ext x
      constructor
      · rintro ⟨hx3, hx4⟩
        rw [hg₀.carrier_eq] at hx3
        obtain ⟨y, hy, rfl⟩ := hx3
        by_cases hy2 : y ∈ M₂.carrier
        · exact hg₀Q₂.mapsTo hy2
        · exact absurd (Or.inl hx4) (hout y ⟨hy, hy2⟩)
      · intro hx; exact ⟨hS.sub hQM hx, hS.sub hQ₂ hx⟩
    obtain ⟨M₅, hR2⟩ := ot.c Q₂ hQ₂c M₃' hM'c M₄ hM₄ hQM hQ₂ hdisj
    obtain ⟨-, -, -, k5⟩ := hdom _ _ _ _ hR2
    obtain ⟨-, h35, -, h45, -⟩ := hA _ _ _ _ hR2
    obtain ⟨-, -, -, -, -⟩ := hA _ _ _ _ hR'
    obtain ⟨lP1, l13', lP2, l23', -⟩ := hA _ _ _ _ hR'
    obtain ⟨kP, kQ₁, -, -⟩ := hdom _ _ _ _ hR'
    obtain ⟨Ma, a0, a1, a2, ai, ac⟩ := hS.three_chain lP2 hQ₂
    obtain ⟨Mb, b0, b1, b2, bi, bc⟩ := hS.three_chain l13' h35
    have hcase : ∀ ε ≤ (0 : Ordinal.{u}) + 1 + 1, ε = 0 ∨ ε = 0 + 1 ∨ ε = 0 + 1 + 1 := fun ε hε => by
      rcases hε.lt_or_eq with h' | h'
      · rcases (Order.lt_add_one_iff.1 h').lt_or_eq with h'' | h''
        · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h'') zero_le)
        · exact Or.inr (Or.inl h'')
      · exact Or.inr (Or.inr h')
    have := ot.f (0 + 1 + 1) Ma Mb ⟨ai, ac, fun ε hε => by
        rcases hcase ε hε with rfl | rfl | rfl
        · rw [a0]; exact kP
        · rw [a1]; exact hQ₂c
        · rw [a2]; exact hM₄⟩ ⟨bi, bc, fun ε hε => by
        rcases hcase ε hε with rfl | rfl | rfl
        · rw [b0]; exact kQ₁
        · rw [b1]; exact hM'c
        · rw [b2]; exact k5⟩ (fun i hi => by
        rcases (Order.lt_add_one_iff.1 hi).lt_or_eq with h' | h'
        · have h0 : i = 0 := le_antisymm (Order.lt_add_one_iff.1 h') zero_le
          subst h0
          rw [a0, a1, b0, b1]; exact (ot.e _ _ _ _).1 hR'
        · subst h'
          rw [a1, a2, b1, b2]; exact (ot.e _ _ _ _).1 hR2)
    rw [a0, a2, b0, b2] at this
    exact ⟨g₀, M₅, P, Q₁, k5, ⟨k3.1, k5.1, M₃', h35, hg₀⟩, hg₀f, h45, hfP, hgQ,
      (ot.e _ _ _ _).1 this⟩

-- DEVIATION (typo fixed to evident intent): the paper compares `(f^a_{α*}, id, N^a_{2,α*})` with
-- `(f^a_{α*}, id, N^b_{2,α*})`; the second is fixed to `f^b_{α*}`.
/-- Prop 5.4.4 (transitivity of weak uniqueness): suppose `⊗⁻_R`, `α* ≤ λ⁺`, three increasing
continuous sequences `⟨N_{1,α}⟩, ⟨N^a_{2,α}⟩, ⟨N^b_{2,α}⟩` (`α ≤ α*`, models in `K_λ` for
`α < α*`), `N^a_{2,0} = N^b_{2,0}`, embeddings `f^x_α : N_{1,α} → N^x_{2,α}` and
`R(f^x_α[N_{1,α}], f^x_{α+1}[N_{1,α+1}], N^x_{2,α}, N^x_{2,α+1})`. Then
`(f^a_{α*}, id, N^a_{2,α*}) E_{N_{1,0}} (f^a_{α*}, id, N^b_{2,α*})` [typo: `f^b_{α*}`]. -/
theorem prop_5_4_4 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (R : QRel U L) (hR : OtMinus s.S lam R) (αs : Ordinal.{u}) (hαs : αs ≤ (Order.succ lam).ord)
    (N₁ Na Nb : Ordinal.{u} → Model U L)
    -- PROOF-STAGE CHANGE: `α ≤ α*` instead of `α < α*`, and the hypotheses `hf0`, `hfai`, `hfbi`.
    -- The conclusion is an `E`-equivalence inside `K_λ`, so the top models must be in `K_λ`. Without
    -- `f^a_0 = f^b_0 = id` and increasing `f^x_α` the statement is false already for `α* = 0`, and
    -- the paper's proof uses them (`g_{x,0} = id`, `g_a ∘ f^a_α = g_b ∘ f^b_α`, unions).
    (hK : ∀ α ≤ αs, N₁ α ∈ s.S.Kc lam ∧ Na α ∈ s.S.Kc lam ∧ Nb α ∈ s.S.Kc lam)
    (hN₁ : IsIncreasing s.S.le N₁ (Iic αs) ∧ IsContinuous N₁ (Iic αs))
    (hNa : IsIncreasing s.S.le Na (Iic αs) ∧ IsContinuous Na (Iic αs))
    (hNb : IsIncreasing s.S.le Nb (Iic αs) ∧ IsContinuous Nb (Iic αs)) (h0 : Na 0 = Nb 0)
    (fa fb : Ordinal.{u} → U → U)
    (hf : ∀ α ≤ αs, IsEmb s.S (fa α) (N₁ α) (Na α) ∧ IsEmb s.S (fb α) (N₁ α) (Nb α))
    (hf0 : ∀ x ∈ (N₁ 0).carrier, fa 0 x = x ∧ fb 0 x = x)
    (hfai : FunIncreasing fa N₁ (Iic αs)) (hfbi : FunIncreasing fb N₁ (Iic αs))
    (hRa : ∀ α < αs, ∃ P Q, IsoOn (fa α) (N₁ α) P ∧ IsoOn (fa (α + 1)) (N₁ (α + 1)) Q ∧
      R P Q (Na α) (Na (α + 1)))
    (hRb : ∀ α < αs, ∃ P Q, IsoOn (fb α) (N₁ α) P ∧ IsoOn (fb (α + 1)) (N₁ (α + 1)) Q ∧
      R P Q (Nb α) (Nb (α + 1))) :
    AmalgEquiv s.S lam (N₁ 0) (N₁ αs) (Na 0) (fa αs, id, Na αs) (fb αs, id, Nb αs) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (hK 0 zero_le).1
  haveI : Infinite U := hU.infinite
  have hex : ∀ α, ∃ x : U, α < αs → x ∈ (N₁ (α + 1)).carrier := fun α => by
    by_cases h : α < αs
    · have hc1 := (hK (α + 1) (Order.add_one_le_iff.2 h)).1.2
      have hne : (N₁ (α + 1)).carrier.Nonempty := by
        rw [Set.nonempty_iff_ne_empty]
        intro he
        have h2 : Model.card (N₁ (α + 1)) = 0 := by
          unfold Model.card; rw [he]; simp
        rw [h2] at hc1
        exact absurd (hc1 ▸ hinf) (not_le.2 Cardinal.aleph0_pos)
      obtain ⟨x, hx⟩ := hne
      exact ⟨x, fun _ => hx⟩
    · exact ⟨Classical.arbitrary U, fun h' => absurd h' h⟩
  choose d hd using hex
  have hE : OtMinusE s.S lam (fun _ => R) :=
    ⟨fun _ M₀ M₁ M₂ M₃ h => by
      obtain ⟨a, b, c', e⟩ := hR.1 _ _ _ _ h
      obtain ⟨f', g, i, j⟩ := hR.2.1 _ _ _ _ h
      exact ⟨a, b, c', e, f', g, i, j⟩,
      fun _ N₀ N₁' N₂ A B _ hA hB h1 h2 => hR.2.2.1 N₀ N₁' N₂ A B hA hB h1 h2,
      fun _ M₀ M₁ M₂ M₃ M₄ f h hf' hm => hR.2.2.2 M₀ M₁ M₂ M₃ M₄ f h hf' hm⟩
  obtain ⟨Z, ga, gb, hga, hgb, e, hga0, hgb0, -⟩ := transit_weak hS hU hc.ax0b hinf hE hαs hNa.1
    hNa.2 hNb.1 hNb.2 hN₁.1 hN₁.2 h0 hf hf0 hfai hfbi (hK 0 zero_le).2.1 hd hRa hRb
  have hle0 : ∀ {M : Ordinal.{u} → Model U L}, IsIncreasing s.S.le M (Iic αs) →
      (∀ α ≤ αs, M α ∈ s.S.K) → s.S.le (M 0) (M αs) := fun {M} hM hk => by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h | h
    · exact hM 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) h
    · rw [← h]; exact hS.refl (hk 0 zero_le)
  have h1α := hle0 hN₁.1 fun α hα => (hK α hα).1.1
  have haα := hle0 hNa.1 fun α hα => (hK α hα).2.1.1
  have hbα := hle0 hNb.1 fun α hα => (hK α hα).2.2.1
  have h10a : s.S.le (N₁ 0) (Na 0) := by
    obtain ⟨-, -, Y, hY, hfY⟩ := (hf 0 zero_le).1
    rw [Model.eq_of_isoOn_id (hfY.congr fun x hx => (hf0 x hx).1)]; exact hY
  have hfix : ∀ {G : Ordinal.{u} → U → U}, FunIncreasing G N₁ (Iic αs) →
      (∀ x ∈ (N₁ 0).carrier, G 0 x = x) → ∀ x ∈ (N₁ 0).carrier, G αs x = x :=
    fun {G} hi h0' x hx => by
      rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h | h
      · rw [hi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) h x hx]; exact h0' x hx
      · rw [← h]; exact h0' x hx
  have hfa := hfix hfai fun x hx => (hf0 x hx).1
  have hfb := hfix hfbi fun x hx => (hf0 x hx).2
  have hmem : ∀ {G : U → U} {T : Model U L}, IsEmb s.S G (N₁ αs) T → (∀ x ∈ (N₁ 0).carrier, G x = x) →
      ∀ x ∈ (N₁ 0).carrier, x ∈ T.carrier := fun {G T} hG hfx x hx => by
    rw [← hfx x hx]; exact hG.mapsTo hS (hS.sub h1α hx)
  refine ⟨(hK 0 zero_le).1, (hK αs le_rfl).1, (hK 0 zero_le).2.1, h1α, h10a,
    ⟨⟨(hf αs le_rfl).1, IsEmb.of_le hS haα,
      ⟨fun x hx => ⟨hS.sub h1α hx, hmem (hf αs le_rfl).1 hfa x hx⟩, hfa⟩,
      ⟨fun x hx => ⟨hS.sub h10a hx, hS.sub haα (hS.sub h10a hx)⟩, fun _ _ => rfl⟩⟩,
      (hK αs le_rfl).2.1⟩,
    ⟨⟨(hf αs le_rfl).2, IsEmb.of_le hS (h0 ▸ hbα),
      ⟨fun x hx => ⟨hS.sub h1α hx, hmem (hf αs le_rfl).2 hfb x hx⟩, hfb⟩,
      ⟨fun x hx => ⟨hS.sub h10a hx, hS.sub (h0 ▸ hbα) (hS.sub h10a hx)⟩, fun _ _ => rfl⟩⟩,
      (hK αs le_rfl).2.2⟩, ga, gb, Z, hga, hgb, fun x hx => (e x hx).symm, fun x hx => ?_⟩
  show gb x = ga x
  rw [hgb0 x (h0 ▸ hx), hga0 x hx]

/-- Prop 5.4.5: if `NF*(N₀, N₁, N₂, N₃ˣ)` (`x = a, b`) with the same first witness, then there is
a joint embedding of `N₃ᵃ, N₃ᵇ` over `N₁ ∪ N₂`. -/
theorem prop_5_4_5 (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (N₀ N₁ N₂ Na Nb : Model U L) (αs : Ordinal.{u}) (A Ba Bb : Ordinal.{u} → Model U L)
    (d : Ordinal.{u} → U) (hNa : N₀ ∈ s.S.Kc lam ∧ N₁ ∈ s.S.Kc lam ∧ N₂ ∈ s.S.Kc lam)
    (hKa : Na ∈ s.S.Kc lam) (hKb : Nb ∈ s.S.Kc lam)
    (ha : s.NFStarWit lam N₀ N₁ N₂ Na αs A Ba d) (hb : s.NFStarWit lam N₀ N₁ N₂ Nb αs A Bb d) :
    JointEmbOver s.S lam Na Nb (N₁.carrier ∪ N₂.carrier) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hNa.1
  obtain ⟨hαs, hAi, hAc, hBai, hBac, -, ⟨h01, h13⟩, ⟨h02, h23⟩, hA0, hAα, hB0, hBα, hAB, hdm, huq,
    hnf⟩ := ha
  obtain ⟨-, -, -, hBbi, hBbc, -, ⟨-, h13b⟩, ⟨-, h23b⟩, -, -, hB0b, hBαb, hABb, -, -, hnfb⟩ := hb
  have kc : ∀ {B : Ordinal.{u} → Model U L} {T : Model U L}, IsIncreasing s.S.le B (Iic αs) →
      B 0 = N₂ → B αs = T → T ∈ s.S.Kc lam → (∀ β ≤ αs, s.S.le (A β) (B β)) →
      ∀ β ≤ αs, B β ∈ s.S.Kc lam := fun {B T} hi h0 ht hT hab β hβ => by
    have hK := hS.mem_right (hab β hβ)
    refine ⟨hK, le_antisymm ?_ ?_⟩
    · rw [← hT.2, ← ht]
      rcases hβ.lt_or_eq with h | h
      · exact Model.card_le_of_sub (hS.sub (hi β hβ αs (Set.mem_Iic.2 le_rfl) h))
      · rw [h]
    · rw [← hNa.2.2.2, ← h0]
      rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h | h
      · exact Model.card_le_of_sub (hS.sub (hi 0 (Set.mem_Iic.2 zero_le) β hβ h))
      · rw [← h]
  have hKa' := kc hBai hB0 hBα hKa hAB
  have hKb' := kc hBbi hB0b hBαb hKb hABb
  have hle : ∀ {B : Ordinal.{u} → Model U L}, IsIncreasing s.S.le B (Iic αs) →
      ∀ i < αs, s.S.le (B i) (B (i + 1)) := fun {B} hi i h =>
    hi i (Set.mem_Iic.2 h.le) (i + 1) (Set.mem_Iic.2 (Order.add_one_le_iff.2 h))
      (Order.lt_add_one_iff.2 le_rfl)
  obtain ⟨Z, ga, gb, hga, hgb, e, hga0, hgb0, hZ⟩ := transit_weak (fa := fun _ => id)
    (fb := fun _ => id) (d := d) hS hU hc.ax0b hinf (Frame.otMinusE_NFuq hU hc)
    hαs.le hBai hBac hBbi hBbc hAi hAc (hB0.trans hB0b.symm)
    (fun α hα => ⟨IsEmb.of_le hS (hAB α hα), IsEmb.of_le hS (hABb α hα)⟩)
    (fun _ _ => ⟨rfl, rfl⟩) (fun _ _ _ _ _ _ _ => rfl) (fun _ _ _ _ _ _ _ => rfl)
    (by rw [hB0]; exact hNa.2.2) (fun α hα => (hdm α hα).1)
    (fun α hα => ⟨A α, A (α + 1), IsoOn.refl _, IsoOn.refl _, huq α hα, hKa' α hα.le,
      hKa' (α + 1) (Order.add_one_le_iff.2 hα), hAB (α + 1) (Order.add_one_le_iff.2 hα),
      hAB α hα.le, hle hBai α hα, hnf α hα⟩)
    (fun α hα => ⟨A α, A (α + 1), IsoOn.refl _, IsoOn.refl _, huq α hα, hKb' α hα.le,
      hKb' (α + 1) (Order.add_one_le_iff.2 hα), hABb (α + 1) (Order.add_one_le_iff.2 hα),
      hABb α hα.le, hle hBbi α hα, hnfb α hα⟩)
  rw [hBα] at hga
  rw [hBαb] at hgb
  rw [hAα] at e
  rw [hB0] at hga0
  rw [hB0b] at hgb0
  have hZc := hZ hαs
  obtain ⟨-, -, Y, hY, hgaY⟩ := id hga
  obtain ⟨κ, hκ, hκg, -⟩ := hgaY.exists_inv
  obtain ⟨r, Z', hr, hrκ, hNaZ, hZ'K, -⟩ := hS.rename hU.infinite (∅ : Set U) hY hκ (by
    rw [Set.empty_union]; change Na.card < #U; rw [hKa.2]; exact hU.2)
  have hrga : ∀ x ∈ Na.carrier, r (ga x) = x := fun x hx => by
    rw [hrκ _ (hgaY.mapsTo hx), hκg x hx]
  have hsubA : N₁.carrier ∪ N₂.carrier ⊆ Na.carrier :=
    Set.union_subset (hS.sub h13) (hS.sub h23)
  have hsubB : N₁.carrier ∪ N₂.carrier ⊆ Nb.carrier :=
    Set.union_subset (hS.sub h13b) (hS.sub h23b)
  refine ⟨Z', id, r ∘ gb, ⟨hZ'K, by rw [hr.card_eq]; exact hZc.2⟩, IsEmb.of_le hS hNaZ,
    IsEmb.comp_iso hS hgb hr, ⟨fun x hx => ⟨hsubA hx, hS.sub hNaZ (hsubA hx)⟩, fun _ _ => rfl⟩,
    ?_⟩
  have hfix : ∀ x ∈ N₁.carrier ∪ N₂.carrier, (r ∘ gb) x = x := by
    rintro x (hx | hx)
    · have e1 : ga x = gb x := e x hx
      show r (gb x) = x
      rw [← e1]; exact hrga x (hsubA (Or.inl hx))
    · show r (gb x) = x
      have h1 := hgb0 x hx
      have h2 := hrga x (hsubA (Or.inr hx))
      rw [hga0 x hx] at h2
      rw [h1]; exact h2
  exact ⟨fun x hx => ⟨hsubB hx, hfix x hx ▸ hr.mapsTo (hgb.mapsTo hS (hsubB hx))⟩, hfix⟩

/-- AUX: not in paper. The invariant of the rectangle construction (Prop 3.1.10). -/
def Frame.RectInv (s : Frame U L) (lam : Cardinal.{u}) (Ma Mb : Ordinal.{u} → Model U L)
    (da db : Ordinal.{u} → U) (θ β : Ordinal.{u})
    (c : Ordinal.{u} → (Ordinal.{u} → Model U L) × (U → U)) : Prop :=
  (∀ γ ≤ β, IsIncreasing s.S.le (c γ).1 (Iic θ) ∧ IsContinuous (c γ).1 (Iic θ) ∧
    ∀ α ≤ θ, (c γ).1 α ∈ s.S.Kc lam) ∧
  (∀ α ≤ θ, (c 0).1 α = Ma α) ∧ (∀ x ∈ (Ma 0).carrier, (c 0).2 x = x) ∧
  (∀ γ ≤ β, IsoOn (c γ).2 (Mb γ) ((c γ).1 0)) ∧
  FunIncreasing (fun γ => (c γ).2) Mb (Iic β) ∧
  (∀ α ≤ θ, IsIncreasing s.S.le (fun γ => (c γ).1 α) (Iic β) ∧
    IsContinuous (fun γ => (c γ).1 α) (Iic β)) ∧
  (∀ γ ≤ β, ∀ α < θ, s.NotFork lam ((c 0).1 α) ((c γ).1 α)
    (tp s.S lam (da α) ((c γ).1 α) ((c γ).1 (α + 1)))) ∧
  (∀ γ, γ + 1 ≤ β → ∀ α ≤ θ, s.NotFork lam ((c γ).1 0) ((c γ).1 α)
    (tp s.S lam ((c (γ + 1)).2 (db γ)) ((c γ).1 α) ((c (γ + 1)).1 α)))

/-- AUX: not in paper. The construction in the proof of Prop 3.1.10 (a rectangle amalgamating two
sequences), for a first sequence with a top model in `K_λ`. -/
theorem Frame.rectangle [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_3_0_1 s lam) {θ θb : Ordinal.{u}} {Ma Mb : Ordinal.{u} → Model U L}
    (hMa : IsIncCont s.S Ma (Iic θ) (s.S.Kc lam)) (hMb : IsIncCont s.S Mb (Iio θb) (s.S.Kc lam))
    (h0 : Ma 0 = Mb 0) {da db : Ordinal.{u} → U}
    (hda : ∀ α < θ, (Ma α, Ma (α + 1), da α) ∈ s.K3bs lam)
    (hdb : ∀ β, β + 1 < θb → (Mb β, Mb (β + 1), db β) ∈ s.K3bs lam)
    (hθb : ∀ β < θb, β.card ≤ lam) :
    ∃ c, ∀ β < θb, s.RectInv lam Ma Mb da db θ β c := by
  classical
  obtain ⟨hc, hcont3, hsym⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  have hM0 : Ma 0 ∈ s.S.Kc lam := hMa.2.2 0 (Set.mem_Iic.2 zero_le)
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM0
  have hne : Nonempty ((Ordinal.{u} → Model U L) × (U → U)) := ⟨(Ma, id)⟩
  have hMbK : ∀ β < θb, Mb β ∈ s.S.Kc lam := fun β hβ => hMb.2.2 β hβ
  suffices H : ∃ c, ∀ β ≤ θb, β < θb → s.RectInv lam Ma Mb da db θ β c by
    obtain ⟨c, hc'⟩ := H; exact ⟨c, fun β hβ => hc' β hβ.le hβ⟩
  refine transfinite_construction θb (fun β c => β < θb → s.RectInv lam Ma Mb da db θ β c)
    (fun β c c' h hi => ?_) (fun β hβ c hprev => ?_)
  · intro hlt
    obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hi hlt
    have e : ∀ γ ≤ β, c' γ = c γ := fun γ hγ => (h γ hγ).symm
    have e0 := e 0 zero_le
    refine ⟨fun γ hγ => by rw [e γ hγ]; exact h1 γ hγ, by rw [e0]; exact h2,
      by rw [e0]; exact h3, fun γ hγ => by rw [e γ hγ]; exact h4 γ hγ,
      fun a ha b hb hl => ?_, fun α hα => ⟨fun a ha b hb hl => ?_, fun b hb hl => ?_⟩,
      fun γ hγ α hα => by rw [e γ hγ, e0]; exact h7 γ hγ α hα, fun γ hγ α hα => ?_⟩
    · simp only [e a ha, e b hb]; exact h5 a ha b hb hl
    · simp only [e a ha, e b hb]; exact (h6 α hα).1 a ha b hb hl
    · simp only [e b hb]; rw [(h6 α hα).2 b hb hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hb)]
    · rw [e γ ((Order.lt_add_one_iff.2 le_rfl).le.trans hγ), e (γ + 1) hγ]; exact h8 γ hγ α hα
  rcases hβ.lt_or_eq with hβ | hβe
  swap
  · exact ⟨(Ma, id), fun h => absurd h (by rw [hβe]; exact lt_irrefl _)⟩
  replace hprev : ∀ γ < β, s.RectInv lam Ma Mb da db θ γ c := fun γ h =>
    hprev γ h (lt_trans h hβ)
  rcases Ordinal.zero_or_succ_or_isSuccLimit β with h0β | ⟨γ, hγ⟩ | hlim
  · subst h0β
    have hc0 : (fun b => if b < (0 : Ordinal.{u}) then c b else (Ma, id)) =
        fun _ => (Ma, id) := funext fun b => if_neg (not_lt.2 zero_le)
    refine ⟨(Ma, id), ?_⟩
    rw [hc0]
    intro _
    have hz : ∀ b ≤ (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
    have hbad : ∀ {a b : Ordinal.{u}}, b ∈ Iic (0 : Ordinal.{u}) → a < b → False :=
      fun {a b} hb h => absurd (lt_of_lt_of_le h hb) (not_lt.2 zero_le)
    refine ⟨fun _ _ => ⟨hMa.1, hMa.2.1, fun α hα => hMa.2.2 α hα⟩, fun _ _ => rfl,
      fun _ _ => rfl, fun b hb => ?_, fun _ _ b hb h => (hbad hb h).elim,
      fun α hα => ⟨fun _ _ b hb h => (hbad hb h).elim, fun b hb hl => ?_⟩,
      fun _ _ α hα => ?_, fun b hb α hα => ?_⟩
    · rw [hz b hb]
      show IsoOn id (Mb 0) (Ma 0)
      rw [h0]; exact IsoOn.refl _
    · rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
    · exact Frame.notFork_self hc (hda α hα).1 (hda α hα).2.2.2
    · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hb) (not_lt.2 zero_le)
  · -- successor stage
    rw [Order.succ_eq_add_one] at hγ
    subst hγ
    have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
    have hγθ : γ < θb := lt_trans hγ1 hβ
    obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8⟩ := hprev γ hγ1
    obtain ⟨hCi, hCc, hCK⟩ := p1 γ le_rfl
    have hC0 : (c γ).1 0 ∈ s.S.Kc lam := hCK 0 zero_le
    have hle : s.S.le (Mb γ) (Mb (γ + 1)) :=
      hMb.1 γ hγθ (γ + 1) hβ hγ1
    obtain ⟨g₁, X, hg₁, hg₁f, hPX, hXK, -⟩ := hS.rename hU.infinite (∅ : Set U) hle (p4 γ le_rfl)
      (by rw [Set.empty_union]; change ((c γ).1 0).card < #U; rw [hC0.2]; exact hU.2)
    have hXc : X ∈ s.S.Kc lam := ⟨hXK, by rw [hg₁.card_eq]; exact (hMbK _ hβ).2⟩
    have hg₁γ : IsoOn g₁ (Mb γ) ((c γ).1 0) := (p4 γ le_rfl).congr fun x hx => (hg₁f x hx).symm
    have hbbs : ((c γ).1 0, X, g₁ (db γ)) ∈ s.K3bs lam :=
      Frame.K3bs_iso hc (hdb γ hβ) hg₁ hg₁γ
    have hlt : s.S.lt ((c γ).1 0) X := ⟨hPX, fun e => hbbs.2.2.1.2 (by rw [e]; exact hbbs.2.2.1.1)⟩
    have hda' : ∀ α < θ, da α ∈ ((c γ).1 (α + 1)).carrier \ ((c γ).1 α).carrier ∧
        ((c γ).1 α, (c γ).1 (α + 1), da α) ∈ s.K3bs lam := fun α hα => by
      have h1 := Order.add_one_le_iff.2 hα
      have hn := Frame.nf_of_notFork hU hc (p7 γ le_rfl α hα) (hCK _ h1)
      have hf := hc.ax3a.1 _ _ _ _ hn
      exact ⟨hf.2.2.2.1, hCK α hα.le, hCK _ h1, hf.2.2.2.1, hf.2.2.2.2.2.2.2⟩
    obtain ⟨f', Ns, hNsK, hf', hov, hNi, hNc, hCN, hnfa, hnfb⟩ := Frame.prop_3_1_8_strong lam hU s
      hs θ (c γ).1 ⟨hCi, hCc, hCK⟩ X hXc hlt da hda' (g₁ (db γ)) hbbs.2.2.1 hbbs
    have hcomp : IsoOn (f' ∘ g₁) (Mb (γ + 1)) (Ns 0) := hg₁.comp hf'
    have hext : ∀ y ∈ (Mb γ).carrier, (f' ∘ g₁) y = (c γ).2 y := fun y hy => by
      show f' (g₁ y) = _
      rw [hg₁f y hy, hov.2 _ ((p4 γ le_rfl).mapsTo hy)]
    refine ⟨(Ns, f' ∘ g₁), fun _ => ?_⟩
    set c' : Ordinal.{u} → (Ordinal.{u} → Model U L) × (U → U) :=
      fun b => if b < γ + 1 then c b else (Ns, f' ∘ g₁) with hc'def
    have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
    have hcx : c' (γ + 1) = (Ns, f' ∘ g₁) := if_neg (lt_irrefl _)
    have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
      rcases hb.lt_or_eq with h | h
      · exact Or.inl (Order.lt_add_one_iff.1 h)
      · exact Or.inr h
    have hnl : ∀ b ≤ γ + 1, Order.IsSuccLimit b → b ≤ γ := fun b hb hl => by
      rcases hcases b hb with h | h
      · exact h
      · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax γ)
    have hrow : ∀ α ≤ θ, ∀ b ≤ γ, s.S.le ((c b).1 α) ((c γ).1 α) := fun α hα b hb => by
      rcases hb.lt_or_eq with h | h
      · exact (p6 α hα).1 b (Set.mem_Iic.2 hb) γ (Set.mem_Iic.2 le_rfl) h
      · rw [h]; exact hS.refl (hCK α hα).1
    refine ⟨fun b hb => ?_, by rw [hcl 0 zero_le]; exact p2, by rw [hcl 0 zero_le]; exact p3,
      fun b hb => ?_, fun a ha b hb hl y hy => ?_, fun α hα => ⟨fun a ha b hb hl => ?_,
      fun b hb hl => ?_⟩, fun b hb α hα => ?_, fun b hb α hα => ?_⟩
    · rcases hcases b hb with h | h
      · rw [hcl b h]; exact p1 b h
      · rw [h, hcx]; exact ⟨hNi, hNc, hNsK⟩
    · rcases hcases b hb with h | h
      · rw [hcl b h]; exact p4 b h
      · rw [h, hcx]; exact hcomp
    · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hb)
      show (c' b).2 y = (c' a).2 y
      rw [hcl a haγ]
      rcases hcases b hb with h | h
      · rw [hcl b h]; exact p5 a (Set.mem_Iic.2 haγ) b (Set.mem_Iic.2 h) hl y hy
      · rw [h, hcx]
        have hyγ : y ∈ (Mb γ).carrier := by
          rcases haγ.lt_or_eq with h' | h'
          · exact hS.sub (hMb.1 a (lt_of_le_of_lt haγ hγθ) γ hγθ h') hy
          · rw [← h']; exact hy
        show (f' ∘ g₁) y = _
        rw [hext y hyγ]
        rcases haγ.lt_or_eq with h' | h'
        · exact p5 a (Set.mem_Iic.2 haγ) γ (Set.mem_Iic.2 le_rfl) h' y hy
        · rw [h']
    · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hb)
      show s.S.le ((c' a).1 α) ((c' b).1 α)
      rw [hcl a haγ]
      rcases hcases b hb with h | h
      · rw [hcl b h]; exact (p6 α hα).1 a (Set.mem_Iic.2 haγ) b (Set.mem_Iic.2 h) hl
      · rw [h, hcx]; exact hS.trans (hrow α hα a haγ) (hCN α hα)
    · have hbγ := hnl b hb hl
      show ((c' b).1 α).carrier = ⋃ ξ ∈ Iio b, ((c' ξ).1 α).carrier
      rw [hcl b hbγ, (p6 α hα).2 b (Set.mem_Iic.2 hbγ) hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hbγ)]
    · rw [hcl 0 zero_le]
      rcases hcases b hb with h | h
      · rw [hcl b h]; exact p7 b h α hα
      · rw [h, hcx]
        have h1 := Order.add_one_le_iff.2 hα
        have hn := hnfa α hα
        obtain ⟨-, -, -, -, -, -, -, -, -, -, hpSb⟩ := hn.facts hc.ax3a
        have hNn := Frame.nf_of_notFork hU hc hn (hNsK _ h1)
        have hsb := (hc.ax3a.1 _ _ _ _ hNn).2.2.2.2.2.2.2
        refine Frame.notFork_trans hc ((p1 0 zero_le).2.2 α hα.le |> fun h' => h') (hNsK α hα.le)
          (hrow α hα.le 0 zero_le) (hCN α hα.le) hsb hn ?_
        have hdaC : da α ∈ ((c γ).1 (α + 1)).carrier := (hda' α hα).1.1
        have hK : ((c γ).1 α, Ns (α + 1), da α) ∈ s.S.K3 := ⟨(hCK α hα.le).1, (hNsK _ h1).1,
          hS.trans (hCi α hα.le (α + 1) h1 (Order.lt_add_one_iff.2 le_rfl)) (hCN _ h1),
          hS.sub (hCN _ h1) hdaC⟩
        rw [res_tp hS (hCN α hα.le), ← tp_eq_of_le hS hK (hCN _ h1)
          (hCi α hα.le (α + 1) h1 (Order.lt_add_one_iff.2 le_rfl)) hdaC]
        exact p7 γ le_rfl α hα
    · have hbγ : b ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hb)
      rcases hbγ.lt_or_eq with h | h
      · have hb1 : b + 1 ≤ γ := Order.add_one_le_iff.2 h
        rw [hcl b hbγ, hcl (b + 1) hb1]; exact p8 b hb1 α hα
      · subst h
        rw [hcl b le_rfl, hcx]
        exact hnfb α hα
  · -- limit stage
    have h0β : (0 : Ordinal.{u}) < β := hlim.bot_lt
    have hβc : β.card ≤ lam := hθb β hβ
    have hβκ : β < (Order.succ lam).ord :=
      Cardinal.lt_ord.2 (lt_of_le_of_lt hβc (Order.lt_succ lam))
    have hri : ∀ α ≤ θ, IsIncreasing s.S.le (fun γ => (c γ).1 α) (Iio β) := fun α hα a ha b hb h =>
      ((hprev b hb).2.2.2.2.2.1 α hα).1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h
    have hrc : ∀ α ≤ θ, IsContinuous (fun γ => (c γ).1 α) (Iio β) := fun α hα b hb hl =>
      ((hprev b hb).2.2.2.2.2.1 α hα).2 b (Set.mem_Iic.2 le_rfl) hl
    have hCol : ∀ γ < β, IsIncreasing s.S.le (c γ).1 (Iic θ) ∧ IsContinuous (c γ).1 (Iic θ) ∧
        ∀ α ≤ θ, (c γ).1 α ∈ s.S.Kc lam := fun γ hγ => (hprev γ hγ).1 γ le_rfl
    have hex : ∀ α, ∃ Y : Model U L, α ≤ θ → IsUnionOf (fun γ => (c γ).1 α) (Iio β) Y :=
      fun α => by
        by_cases h : α ≤ θ
        · obtain ⟨Y, hY, -, -⟩ := hS.union β hlim _ (hri α h) (hrc α h)
          exact ⟨Y, fun _ => hY⟩
        · exact ⟨Ma 0, fun h' => absurd h' h⟩
    choose Ub hUb using hex
    have hUle : ∀ α ≤ θ, Ub α ∈ s.S.K ∧ ∀ γ < β, s.S.le ((c γ).1 α) (Ub α) := fun α hα =>
      hS.le_union hlim (hri α hα) (hrc α hα) (hUb α hα)
    have hUK : ∀ α ≤ θ, Ub α ∈ s.S.Kc lam := fun α hα => by
      refine ⟨(hUle α hα).1, le_antisymm ?_ ?_⟩
      · change #(Ub α).carrier ≤ lam
        rw [(hUb α hα).1]
        exact card_biUnion_le hinf hβc fun γ hγ => le_of_eq ((hCol γ hγ).2.2 α hα).2
      · rw [← ((hCol 0 h0β).2.2 α hα).2]
        exact Model.card_le_of_sub (hS.sub ((hUle α hα).2 0 h0β))
    have hUi : IsIncreasing s.S.le Ub (Iic θ) := fun a ha b hb h =>
      hS.smooth β hlim _ (Ub b) (hri a ha) (hrc a ha)
        (fun γ hγ => hS.trans ((hCol γ hγ).1 a ha b hb h) ((hUle b hb).2 γ hγ)) (Ub a) (hUb a ha)
        (hUle a ha).1
    have hUc : IsContinuous Ub (Iic θ) := by
      intro a ha hl
      rw [(hUb a ha).1]
      ext x
      simp only [Set.mem_iUnion, Set.mem_Iio, exists_prop]
      constructor
      · rintro ⟨γ, hγ, hx⟩
        rw [(hCol γ hγ).2.1 a ha hl] at hx
        obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
        refine ⟨ξ, hξ, ?_⟩
        rw [(hUb ξ ((le_of_lt (show ξ < a from hξ)).trans ha)).1]
        exact Set.mem_iUnion₂.2 ⟨γ, hγ, hxξ⟩
      · rintro ⟨ξ, hξ, hx⟩
        rw [(hUb ξ ((le_of_lt hξ).trans ha)).1] at hx
        obtain ⟨γ, hγ, hxγ⟩ := Set.mem_iUnion₂.1 hx
        exact ⟨γ, hγ, hS.sub ((hCol γ hγ).1 ξ ((le_of_lt hξ).trans ha) a ha hξ) hxγ⟩
    have hfi : ∀ a < β, ∀ b < β, a < b → ∀ y ∈ (Mb a).carrier, (c b).2 y = (c a).2 y :=
      fun a _ b hb h y hy =>
        (hprev b hb).2.2.2.2.1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h y hy
    let F : U → U := fun x => if h : ∃ γ < β, x ∈ (Mb γ).carrier then (c h.choose).2 x else x
    have hF : ∀ γ < β, ∀ y ∈ (Mb γ).carrier, F y = (c γ).2 y := fun γ hγ y hy => by
      have h : ∃ γ < β, y ∈ (Mb γ).carrier := ⟨γ, hγ, hy⟩
      simp only [F, h, dite_true]
      obtain ⟨h1, h2⟩ := h.choose_spec
      rcases lt_trichotomy h.choose γ with h' | h' | h'
      · exact (hfi _ h1 γ hγ h' y h2).symm
      · rw [h']
      · exact hfi γ hγ _ h1 h' y hy
    refine ⟨(Ub, F), fun _ => ?_⟩
    set c' : Ordinal.{u} → (Ordinal.{u} → Model U L) × (U → U) :=
      fun b => if b < β then c b else (Ub, F) with hc'def
    have hcl : ∀ b < β, c' b = c b := fun b hb => if_pos hb
    have hcx : c' β = (Ub, F) := if_neg (lt_irrefl _)
    have hp0 := hprev 0 h0β
    have c6 : ∀ α ≤ θ, IsIncreasing s.S.le (fun γ => (c' γ).1 α) (Iic β) ∧
        IsContinuous (fun γ => (c' γ).1 α) (Iic β) := fun α hα => by
      refine ⟨fun a ha b hb hl => ?_, fun b hb hl => ?_⟩
      · have haβ : a < β := lt_of_lt_of_le hl hb
        show s.S.le ((c' a).1 α) ((c' b).1 α)
        rw [hcl a haβ]
        rcases (show b ≤ β from hb).lt_or_eq with h' | h'
        · rw [hcl b h']; exact hri α hα a haβ b h' hl
        · rw [h', hcx]; exact (hUle α hα).2 a haβ
      · show ((c' b).1 α).carrier = ⋃ ξ ∈ Iio b, ((c' ξ).1 α).carrier
        rcases (show b ≤ β from hb).lt_or_eq with h' | h'
        · rw [hcl b h', hrc α hα b h' hl]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h')]
        · rw [h', hcx, (hUb α hα).1]
          exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
    have c5 : FunIncreasing (fun γ => (c' γ).2) Mb (Iic β) := by
      intro a ha b hb hl y hy
      have haβ : a < β := lt_of_lt_of_le hl hb
      show (c' b).2 y = (c' a).2 y
      rw [hcl a haβ]
      rcases (show b ≤ β from hb).lt_or_eq with h' | h'
      · rw [hcl b h']; exact hfi a haβ b h' hl y hy
      · rw [h', hcx]; exact hF a haβ y hy
    have hMbi : IsIncreasing s.S.le Mb (Iic β) := fun a ha b hb h =>
      hMb.1 a (lt_of_le_of_lt (show a ≤ β from ha) hβ) b (lt_of_le_of_lt (show b ≤ β from hb) hβ) h
    have hMbc : IsContinuous Mb (Iic β) := fun b hb hl =>
      hMb.2.1 b (lt_of_le_of_lt (show b ≤ β from hb) hβ) hl
    have hIso : IsoOn F (Mb β) (Ub 0) := by
      have hlt : ∀ γ < β, IsEmb s.S (c' γ).2 (Mb γ) ((c' γ).1 0) := fun γ hγ => by
        rw [hcl γ hγ]
        obtain ⟨hiso⟩ : Nonempty (IsoOn (c γ).2 (Mb γ) ((c γ).1 0)) :=
          ⟨(hprev γ hγ).2.2.2.1 γ le_rfl⟩
        exact ⟨(hMbK γ (lt_trans hγ hβ)).1, ((hCol γ hγ).2.2 0 zero_le).1, _,
          hS.refl ((hCol γ hγ).2.2 0 zero_le).1, hiso⟩
      have hE := hS.emb_limit (f := fun γ => (c' γ).2) (N := fun γ => (c' γ).1 0) hlim hMbi hMbc
        (c6 0 zero_le).1 hlt c5
      simp only [hcx] at hE
      obtain ⟨-, -, Y, hY, hFY⟩ := hE
      have hsub : (Ub 0).carrier ⊆ Y.carrier := by
        rw [(hUb 0 zero_le).1, hFY.carrier_eq]
        intro x hx
        obtain ⟨γ, hγ, hxγ⟩ := Set.mem_iUnion₂.1 hx
        have hiso := (hprev γ hγ).2.2.2.1 γ le_rfl
        rw [hiso.carrier_eq] at hxγ
        obtain ⟨y, hy, rfl⟩ := hxγ
        exact ⟨y, hS.sub (hMb.1 γ (lt_trans hγ hβ) β hβ hγ) hy,
          hF γ hγ y hy⟩
      have e : Y = Ub 0 := hS.po.2.2.1 _ _ hY (hS.le_of_sub (hS.refl (hS.mem_right hY)) hY hsub)
      rw [← e]; exact hFY
    refine ⟨fun b hb => ?_, by rw [hcl 0 h0β]; exact hp0.2.1, by rw [hcl 0 h0β]; exact hp0.2.2.1,
      fun b hb => ?_, c5, c6, fun b hb α hα => ?_, fun b hb α hα => ?_⟩
    · rcases hb.lt_or_eq with h | h
      · rw [hcl b h]; exact hCol b h
      · rw [h, hcx]; exact ⟨hUi, hUc, hUK⟩
    · rcases hb.lt_or_eq with h | h
      · rw [hcl b h]; exact (hprev b h).2.2.2.1 b le_rfl
      · rw [h, hcx]; exact hIso
    · rw [hcl 0 h0β]
      rcases hb.lt_or_eq with h | h
      · rw [hcl b h]; exact (hprev b h).2.2.2.2.2.2.1 b le_rfl α hα
      · subst h
        rw [hcx]
        have h1 := Order.add_one_le_iff.2 hα
        have hdaU : da α ∈ (Ub (α + 1)).carrier := by
          have h2 : da α ∈ ((c 0).1 (α + 1)).carrier := by rw [hp0.2.1 _ h1]; exact (hda α hα).2.2.1.1
          exact hS.sub ((hUle _ h1).2 0 h0β) h2
        have hK : (Ub α, Ub (α + 1), da α) ∈ s.S.K3 := ⟨(hUK α hα.le).1, (hUK _ h1).1,
          hUi α hα.le (α + 1) h1 (Order.lt_add_one_iff.2 le_rfl), hdaU⟩
        have hT0 : (c' 0).1 α = (c 0).1 α := by rw [hcl 0 h0β]
        have hcg := hcont3 b hlim hβκ (fun γ => (c' γ).1 α) ⟨(c6 α hα.le).1, (c6 α hα.le).2,
            fun γ hγ => by
              rcases (show γ ≤ b from hγ).lt_or_eq with h | h
              · show (c' γ).1 α ∈ _
                rw [hcl γ h]; exact (hCol γ h).2.2 α hα.le
              · show (c' γ).1 α ∈ _
                rw [h, hcx]; exact hUK α hα.le⟩
          (tp s.S lam (da α) ((c' b).1 α) (Ub (α + 1)))
          ⟨Ub (α + 1), da α, by rw [hcx]; exact hK, rfl⟩ (fun γ hγ => by
            have hle' := (hUle α hα.le).2 γ hγ
            have hcC := hCol γ hγ
            have h3 : da α ∈ ((c γ).1 (α + 1)).carrier := by
              have := Frame.nf_of_notFork hU hc ((hprev γ hγ).2.2.2.2.2.2.1 γ le_rfl α hα)
                (hcC.2.2 _ h1)
              exact (hc.ax3a.1 _ _ _ _ this).2.2.2.1.1
            have hK' : ((c γ).1 α, Ub (α + 1), da α) ∈ s.S.K3 :=
              ⟨(hcC.2.2 α hα.le).1, (hUK _ h1).1, hS.trans hle' hK.2.2.1, hdaU⟩
            show s.NotFork lam ((c' 0).1 α) ((c' γ).1 α) (res s.S lam _ ((c' γ).1 α))
            rw [hT0, hcl γ hγ, hcx]
            show s.NotFork lam _ _ (res s.S lam (tp s.S lam (da α) (Ub α) (Ub (α + 1))) _)
            rw [res_tp hS hle', ← tp_eq_of_le hS hK' ((hUle _ h1).2 γ hγ)
              (hcC.1 α hα.le (α + 1) h1 (Order.lt_add_one_iff.2 le_rfl)) h3]
            exact (hprev γ hγ).2.2.2.2.2.2.1 γ le_rfl α hα)
        have h2 := hcg.2
        simp only [hT0, hcx] at h2
        exact h2
    · have hb1 : b + 1 < β := lt_of_le_of_ne hb fun h => by
        rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax b)
      have hb' : b < β := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
      rw [hcl b hb', hcl (b + 1) hb1]
      exact (hprev (b + 1) hb1).2.2.2.2.2.2.2 b le_rfl α hα

/-- AUX: not in paper. An increasing chain with new elements at each step, in `K_λ`, has length
`≤ λ⁺`: each proper initial segment has cardinality `≤ λ`. -/
theorem IsAEC.chain_card_le {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} {θ : Ordinal.{u}}
    {M : Ordinal.{u} → Model U L} (hinc : IsIncreasing S.le M (Iio θ))
    (hK : ∀ α < θ, M α ∈ S.Kc lam) {d : Ordinal.{u} → U}
    (hd : ∀ α, α + 1 < θ → d α ∈ (M (α + 1)).carrier \ (M α).carrier) :
    ∀ β < θ, β.card ≤ lam := by
  intro β hβ
  have hsub : ∀ γ < θ, ∀ δ < θ, γ ≤ δ → (M γ).carrier ⊆ (M δ).carrier := fun γ hγ δ hδ h => by
    rcases h.lt_or_eq with h | h
    · exact hS.sub (hinc γ hγ δ hδ h)
    · rw [h]
  have hs1 : ∀ x : Iio β, x.1 + 1 < θ := fun x =>
    lt_of_le_of_lt (Order.add_one_le_iff.2 x.2) hβ
  let g : Iio β → (M β).carrier := fun x =>
    ⟨d x.1, hsub _ (hs1 x) β hβ (Order.add_one_le_iff.2 x.2) (hd x.1 (hs1 x)).1⟩
  have hg : Function.Injective g := by
    have key : ∀ x y : Iio β, x.1 < y.1 → d x.1 ≠ d y.1 := fun x y hxy e => by
      have h1 := hsub _ (hs1 x) y.1 (lt_trans y.2 hβ) (Order.add_one_le_iff.2 hxy)
        (hd x.1 (hs1 x)).1
      exact (hd y.1 (hs1 y)).2 (e ▸ h1)
    intro x y hxy
    have e : d x.1 = d y.1 := congrArg Subtype.val hxy
    rcases lt_trichotomy x.1 y.1 with h | h | h
    · exact absurd e (key x y h)
    · exact Subtype.ext h
    · exact absurd e.symm (key y x h)
  have h1 := Cardinal.lift_mk_le_lift_mk_of_injective hg
  rw [Cardinal.mk_Iio_ordinal, Cardinal.lift_lift] at h1
  exact (Cardinal.lift_le.1 h1).trans (le_of_eq (hK β hβ).2)

-- DEVIATION (author-confirmed): added `θ^a < λ⁺`. The paper has no bound on `θ^a`. The use in
-- Prop 5.4.6 has `θ^a = α* + 1` with `α* < λ⁺` (there through `Frame.rectangle`).
/-- Prop 3.1.10 (a rectangle which amalgamates two sequences): for `x = a, b` let
`⟨M_{x,α} : α < θ^x⟩` be increasing continuous in `K_λ` with `M_{a,0} = M_{b,0}`, and
`d_{x,α} ∈ M_{x,α+1} - M_{x,α}` with `tp(d_{x,α}, M_{x,α}, M_{x,α+1})` basic. Then there are
models `M_{α,β}` (`α < α* = θ^a`, `β < β* = θ^b`) and `⟨f_β : β < β*⟩` with (1)–(10) below.
Original text has no bound on `θ^a`, and its item on `b` reads "`tp(d_{b,β}, M_{α,β}, M_{α,β+1})` does
not fork over `M_{0,β}`"; item (7) below states explicitly that the element is
`f_{β+1}(d_{b,β}) ∈ M_{0,β+1}` (author decision; not a change of meaning). -/
theorem prop_3_1_10 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_3_0_1 s lam)
    (θa θb : Ordinal.{u}) (hθa : θa < (Order.succ lam).ord) (Ma Mb : Ordinal.{u} → Model U L)
    (hMa : IsIncCont s.S Ma (Iio θa) (s.S.Kc lam)) (hMb : IsIncCont s.S Mb (Iio θb) (s.S.Kc lam))
    (h0 : Ma 0 = Mb 0) (da db : Ordinal.{u} → U)
    (hda : ∀ α < θa, da α ∈ (Ma (α + 1)).carrier \ (Ma α).carrier ∧
      tp s.S lam (da α) (Ma α) (Ma (α + 1)) ∈ s.Sbs (Ma α))
    (hdb : ∀ β < θb, db β ∈ (Mb (β + 1)).carrier \ (Mb β).carrier ∧
      tp s.S lam (db β) (Mb β) (Mb (β + 1)) ∈ s.Sbs (Mb β)) :
    ∃ (R : Ordinal.{u} → Ordinal.{u} → Model U L) (f : Ordinal.{u} → U → U),
      -- (1)
      (∀ α < θa, ∀ β < θb, R α β ∈ s.S.Kc lam) ∧
      -- (2)
      (∀ β < θb, IsoOn (f β) (Mb β) (R 0 β)) ∧
      -- (3)
      (∀ α < θa, R α 0 = Ma α) ∧
      -- (4)
      (∀ x ∈ (Ma 0).carrier, f 0 x = x) ∧
      -- (5)
      FunIncreasing f Mb (Iio θb) ∧ FunContinuous f Mb (Iio θb) ∧
      -- (6)
      (∀ α β, α + 1 < θa → β < θb →
        s.NotFork lam (R α 0) (R α β) (tp s.S lam (da α) (R α β) (R (α + 1) β))) ∧
      -- (7)
      (∀ α β, α < θa → β + 1 < θb →
        s.NotFork lam (R 0 β) (R α β) (tp s.S lam (f (β + 1) (db β)) (R α β) (R α (β + 1)))) ∧
      -- (8)
      (((⋃ β ∈ Iio θb, f β '' (Mb β).carrier) ∩ (⋃ α ∈ Iio θa, (Ma α).carrier) = (Ma 0).carrier ∧
        (⋃ β ∈ Iio θb, (Mb β).carrier) ∩ (⋃ α ∈ Iio θa, (Ma α).carrier) = (Ma 0).carrier) →
          ∀ β < θb, ∀ x ∈ (Mb β).carrier, f β x = x) ∧
      -- (9)
      (∀ α < θa, IsIncreasing s.S.le (R α) (Iio θb) ∧ IsContinuous (R α) (Iio θb)) ∧
      -- (10)
      (∀ β < θb, IsIncreasing s.S.le (fun α => R α β) (Iio θa) ∧
        IsContinuous (fun α => R α β) (Iio θa)) := by
  classical
  obtain ⟨hc, hcont3, hsym⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  by_cases hθa0 : θa = 0
  · subst hθa0
    have hbad : ∀ {α : Ordinal.{u}}, α < 0 → False := fun h => absurd h (not_lt.2 zero_le)
    exact ⟨fun _ β => Mb β, fun _ => id, fun _ h _ _ => (hbad h).elim, fun _ _ => IsoOn.refl _,
      fun _ h => (hbad h).elim, fun _ _ => rfl, fun _ _ _ _ _ _ _ => rfl,
      fun β hβ hl x hx => by
        rw [hMb.2.1 β hβ hl] at hx
        obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
        exact ⟨ξ, hξ, hxξ, rfl⟩,
      fun α β h _ => (hbad (lt_trans (Order.lt_add_one_iff.2 le_rfl) h)).elim,
      fun α β h _ => (hbad h).elim, fun _ _ _ _ _ => rfl, fun _ h => (hbad h).elim,
      fun β _ => ⟨fun _ h => (hbad h).elim, fun _ h => (hbad h).elim⟩⟩
  have hθpos : (0 : Ordinal.{u}) < θa := pos_iff_ne_zero.2 hθa0
  have hM0 : Ma 0 ∈ s.S.Kc lam := hMa.2.2 0 hθpos
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM0
  have hMaK : ∀ α < θa, Ma α ∈ s.S.Kc lam := fun α h => hMa.2.2 α h
  have hle : ∀ a < θa, ∀ b < θa, a ≤ b → s.S.le (Ma a) (Ma b) := fun a ha b hb h => by
    rcases h.lt_or_eq with h | h
    · exact hMa.1 a ha b hb h
    · rw [h]; exact hS.refl (hMaK b hb).1
  -- a top for the first sequence
  obtain ⟨θh, Mh, hMh, heq, hcov, hsucc, hsucc', hTop⟩ : ∃ (θh : Ordinal.{u})
      (Mh : Ordinal.{u} → Model U L), IsIncCont s.S Mh (Iic θh) (s.S.Kc lam) ∧
      (∀ α < θa, Mh α = Ma α) ∧ (∀ α < θa, α ≤ θh) ∧ (∀ α < θh, α + 1 < θa) ∧
      (∀ α, α + 1 < θa → α < θh) ∧ (Mh θh).carrier = ⋃ α ∈ Iio θa, (Ma α).carrier := by
    rcases Ordinal.zero_or_succ_or_isSuccLimit θa with h0' | ⟨τ, hτ⟩ | hlim
    · exact absurd h0' hθa0
    · rw [Order.succ_eq_add_one] at hτ
      subst hτ
      have hlt : ∀ {x : Ordinal.{u}}, x < τ + 1 ↔ x ≤ τ := Order.lt_add_one_iff
      refine ⟨τ, Ma, ⟨fun a ha b hb h => hMa.1 a (hlt.2 ha) b (hlt.2 hb) h,
        fun b hb hl => hMa.2.1 b (hlt.2 hb) hl, fun α hα => hMaK α (hlt.2 hα)⟩, fun _ _ => rfl,
        fun α h => hlt.1 h, fun α h => hlt.2 (Order.add_one_le_iff.2 h),
        fun α h => Order.add_one_le_iff.1 (hlt.1 h), ?_⟩
      ext x
      constructor
      · intro hx; exact Set.mem_iUnion₂.2 ⟨τ, hlt.2 le_rfl, hx⟩
      · intro hx
        obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
        rcases (hlt.1 hξ).lt_or_eq with h' | h'
        · exact hS.sub (hle ξ hξ τ (hlt.2 le_rfl) (hlt.1 hξ)) hxξ
        · rw [← h']; exact hxξ
    · obtain ⟨Mu, hMu, -, -⟩ := hS.union θa hlim _ hMa.1 hMa.2.1
      obtain ⟨hMuK, hleu⟩ := hS.le_union hlim hMa.1 hMa.2.1 hMu
      obtain ⟨hext, hextc⟩ := IsAEC.extend_union hMa.1 hMa.2.1 hMu hleu
      have hMuc : Mu ∈ s.S.Kc lam := by
        refine ⟨hMuK, le_antisymm ?_ ?_⟩
        · change #Mu.carrier ≤ lam
          rw [hMu.1]
          exact card_biUnion_le hinf (Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hθa))
            fun β hβ => le_of_eq (hMaK β hβ).2
        · rw [← hM0.2]; exact Model.card_le_of_sub (hS.sub (hleu 0 hθpos))
      refine ⟨θa, fun β => if β < θa then Ma β else Mu, ⟨hext, hextc, fun α hα => ?_⟩,
        fun α h => if_pos h, fun α h => h.le, fun α h => hlim.add_one_lt h,
        fun α h => lt_trans (Order.lt_add_one_iff.2 le_rfl) h, ?_⟩
      · rcases (show α ≤ θa from hα).lt_or_eq with h | h
        · show (if α < θa then Ma α else Mu) ∈ _
          rw [if_pos h]; exact hMaK α h
        · show (if α < θa then Ma α else Mu) ∈ _
          rw [if_neg (not_lt.2 h.ge)]; exact hMuc
      · show (if θa < θa then Ma θa else Mu).carrier = _
        rw [if_neg (lt_irrefl _)]; exact hMu.1
  have hMh0 : Mh 0 = Ma 0 := heq 0 hθpos
  by_cases hθb0 : θb = 0
  · subst hθb0
    have hbad : ∀ {α : Ordinal.{u}}, α < 0 → False := fun h => absurd h (not_lt.2 zero_le)
    exact ⟨fun α _ => Ma α, fun _ => id, fun _ _ _ h => (hbad h).elim, fun _ h => (hbad h).elim,
      fun _ _ => rfl, fun _ _ => rfl, fun _ h => (hbad h).elim, fun _ h => (hbad h).elim,
      fun _ _ _ h => (hbad h).elim,
      fun α β _ h => (hbad (lt_trans (Order.lt_add_one_iff.2 le_rfl) h)).elim,
      fun _ _ h => (hbad h).elim, fun _ _ => ⟨fun _ h => (hbad h).elim, fun _ h => (hbad h).elim⟩,
      fun _ h => (hbad h).elim⟩
  have hβpos : (0 : Ordinal.{u}) < θb := pos_iff_ne_zero.2 hθb0
  have hlen := hS.chain_card_le hMb.1 hMb.2.2 (d := db) fun α h =>
    (hdb α (lt_trans (Order.lt_add_one_iff.2 le_rfl) h)).1
  have hMbK : ∀ β < θb, Mb β ∈ s.S.Kc lam := hMb.2.2
  obtain ⟨c, hinv⟩ := Frame.rectangle (Ma := Mh) (Mb := Mb) (da := da) (db := db) (θ := θh)
    (θb := θb) hU hs hMh hMb (hMh0.trans h0)
    (fun α hα => by
      have h1 := hsucc α hα
      have h2 := lt_trans (Order.lt_add_one_iff.2 le_rfl) h1
      rw [heq α h2, heq (α + 1) h1]
      exact ⟨hMaK α h2, hMaK _ h1, (hda α h2).1, (hda α h2).2⟩)
    (fun β hβ => by
      have h2 := lt_trans (Order.lt_add_one_iff.2 le_rfl) hβ
      exact ⟨hMbK β h2, hMbK _ hβ, (hdb β h2).1, (hdb β h2).2⟩) hlen
  have hI1 : ∀ β < θb, IsIncreasing s.S.le (c β).1 (Iic θh) ∧ IsContinuous (c β).1 (Iic θh) ∧
      ∀ α ≤ θh, (c β).1 α ∈ s.S.Kc lam := fun β hβ => (hinv β hβ).1 β le_rfl
  have hI2 : ∀ α ≤ θh, (c 0).1 α = Mh α := (hinv 0 hβpos).2.1
  have hI3 : ∀ x ∈ (Mh 0).carrier, (c 0).2 x = x := (hinv 0 hβpos).2.2.1
  have hI4 : ∀ β < θb, IsoOn (c β).2 (Mb β) ((c β).1 0) := fun β hβ =>
    (hinv β hβ).2.2.2.1 β le_rfl
  have hI5 : ∀ a < θb, ∀ b < θb, a < b → ∀ y ∈ (Mb a).carrier, (c b).2 y = (c a).2 y :=
    fun a _ b hb h y hy =>
      (hinv b hb).2.2.2.2.1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h y hy
  have hI6i : ∀ α ≤ θh, IsIncreasing s.S.le (fun β => (c β).1 α) (Iio θb) := fun α hα a _ b hb h =>
    ((hinv b hb).2.2.2.2.2.1 α hα).1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h
  have hI6c : ∀ α ≤ θh, IsContinuous (fun β => (c β).1 α) (Iio θb) := fun α hα b hb hl =>
    ((hinv b hb).2.2.2.2.2.1 α hα).2 b (Set.mem_Iic.2 le_rfl) hl
  have hI7 : ∀ β < θb, ∀ α < θh, s.NotFork lam ((c 0).1 α) ((c β).1 α)
      (tp s.S lam (da α) ((c β).1 α) ((c β).1 (α + 1))) := fun β hβ α hα =>
    (hinv β hβ).2.2.2.2.2.2.1 β le_rfl α hα
  have hI8 : ∀ β, β + 1 < θb → ∀ α ≤ θh, s.NotFork lam ((c β).1 0) ((c β).1 α)
      (tp s.S lam ((c (β + 1)).2 (db β)) ((c β).1 α) ((c (β + 1)).1 α)) := fun β hβ α hα =>
    (hinv (β + 1) hβ).2.2.2.2.2.2.2 β le_rfl α hα
  have hR0 : ∀ α < θa, (c 0).1 α = Ma α := fun α h => by
    rw [hI2 α (hcov α h), heq α h]
  have hf0 : ∀ x ∈ (Ma 0).carrier, (c 0).2 x = x := fun x hx => hI3 x (by rw [hMh0]; exact hx)
  have hfc : ∀ b < θb, Order.IsSuccLimit b → ∀ x ∈ (Mb b).carrier,
      ∃ a < b, x ∈ (Mb a).carrier ∧ (c b).2 x = (c a).2 x := fun b hb hl x hx => by
    rw [hMb.2.1 b hb hl] at hx
    obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨ξ, hξ, hxξ, hI5 ξ (lt_trans hξ hb) b hb hξ x hxξ⟩
  by_cases hant : (⋃ β ∈ Iio θb, (c β).2 '' (Mb β).carrier) ∩ (⋃ α ∈ Iio θa, (Ma α).carrier) =
      (Ma 0).carrier ∧ (⋃ β ∈ Iio θb, (Mb β).carrier) ∩ (⋃ α ∈ Iio θa, (Ma α).carrier) =
      (Ma 0).carrier
  swap
  · exact ⟨fun α β => (c β).1 α, fun β => (c β).2,
      fun α hα β hβ => (hI1 β hβ).2.2 α (hcov α hα), hI4, hR0, hf0,
      fun a ha b hb h y hy => hI5 a ha b hb h y hy, hfc,
      fun α β hα hβ => hI7 β hβ α (hsucc' α hα),
      fun α β hα hβ => hI8 β hβ α (hcov α hα), fun h => absurd h hant,
      fun α hα => ⟨hI6i α (hcov α hα), hI6c α (hcov α hα)⟩,
      fun β hβ => ⟨fun a ha b hb h => (hI1 β hβ).1 a (hcov a ha) b (hcov b hb) h,
        fun b hb hl => (hI1 β hβ).2.1 b (hcov b hb) hl⟩⟩
  -- the identity case: move the rectangle so that `f_β = id`
  obtain ⟨hant1, hant2⟩ := hant
  rw [← hTop] at hant1 hant2
  have hle' : ∀ a < θb, ∀ b < θb, a ≤ b → ∀ y ∈ (Mb a).carrier, (c b).2 y = (c a).2 y :=
    fun a ha b hb h y hy => by
      rcases h.lt_or_eq with h | h
      · exact hI5 a ha b hb h y hy
      · rw [h]
  have hMbsub : ∀ a < θb, ∀ b < θb, a ≤ b → (Mb a).carrier ⊆ (Mb b).carrier :=
    fun a ha b hb h => by
      rcases h.lt_or_eq with h | h
      · exact hS.sub (hMb.1 a ha b hb h)
      · rw [h]
  have huniq : ∀ a < θb, ∀ b < θb, ∀ y ∈ (Mb a).carrier, ∀ z ∈ (Mb b).carrier,
      (c a).2 y = (c b).2 z → y = z := by
    intro a ha b hb y hy z hz e
    rcases le_total a b with h | h
    · rw [← hle' a ha b hb h y hy] at e
      exact (hI4 b hb).injOn (hMbsub a ha b hb h hy) hz e
    · rw [← hle' b hb a ha h z hz] at e
      exact (hI4 a ha).injOn hy (hMbsub b hb a ha h hz) e
  let Im : Set U := ⋃ β ∈ Iio θb, (c β).2 '' (Mb β).carrier
  let g : U → U := fun x => if h : ∃ β, β < θb ∧ ∃ y ∈ (Mb β).carrier, (c β).2 y = x then
    h.choose_spec.2.choose else x
  have hgf : ∀ β < θb, ∀ y ∈ (Mb β).carrier, g ((c β).2 y) = y := fun β hβ y hy => by
    have h : ∃ β', β' < θb ∧ ∃ y' ∈ (Mb β').carrier, (c β').2 y' = (c β).2 y := ⟨β, hβ, y, hy, rfl⟩
    simp only [g, dif_pos h]
    obtain ⟨h1, h2⟩ := h.choose_spec.2.choose_spec
    exact huniq _ h.choose_spec.1 β hβ _ h1 y hy h2
  have hImEx : ∀ x ∈ Im, ∃ β, β < θb ∧ ∃ y ∈ (Mb β).carrier, (c β).2 y = x := fun x hx => by
    obtain ⟨β, hβ, y, hy, e⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨β, hβ, y, hy, e⟩
  have h0Im : ∀ x ∈ (Ma 0).carrier, x ∈ Im ∧ g x = x := fun x hx => by
    have hxb : x ∈ (Mb 0).carrier := by rw [← h0]; exact hx
    have e : (c 0).2 x = x := hf0 x hx
    exact ⟨Set.mem_iUnion₂.2 ⟨0, hβpos, x, hxb, e⟩, by
      have := hgf 0 hβpos x hxb; rwa [e] at this⟩
  let D : Set U := Im ∪ (Mh θh).carrier
  let h₀ : U → U := fun x => if x ∈ Im then g x else x
  have hinj : InjOn h₀ D := by
    intro x hx y hy hxy
    by_cases hxB : x ∈ Im <;> by_cases hyB : y ∈ Im
    · simp only [h₀, hxB, hyB, if_true] at hxy
      obtain ⟨a, ha, u, hu, rfl⟩ := hImEx x hxB
      obtain ⟨b, hb, v, hv, rfl⟩ := hImEx y hyB
      rw [hgf a ha u hu, hgf b hb v hv] at hxy
      subst hxy
      rcases le_total a b with h | h
      · exact (hle' a ha b hb h u hu).symm
      · exact hle' b hb a ha h u hv
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      obtain ⟨a, ha, u, hu, rfl⟩ := hImEx x hxB
      rw [hgf a ha u hu] at hxy
      have hy0 : y ∈ (Ma 0).carrier := by
        rw [← hant2]
        exact ⟨Set.mem_iUnion₂.2 ⟨a, ha, by rw [← hxy]; exact hu⟩, hy.resolve_left hyB⟩
      exact absurd (h0Im y hy0).1 hyB
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      obtain ⟨a, ha, u, hu, rfl⟩ := hImEx y hyB
      rw [hgf a ha u hu] at hxy
      have hx0 : x ∈ (Ma 0).carrier := by
        rw [← hant2]
        exact ⟨Set.mem_iUnion₂.2 ⟨a, ha, by rw [hxy]; exact hu⟩, hx.resolve_left hxB⟩
      exact absurd (h0Im x hx0).1 hxB
    · simp only [h₀, hxB, hyB, if_false] at hxy; exact hxy
  have hθbcard : θb.card ≤ Order.succ lam := by
    by_contra hno
    have h1 : (Order.succ lam).ord < θb := by
      by_contra h'
      exact hno ((Ordinal.card_le_card (not_lt.1 h')).trans (le_of_eq (Cardinal.card_ord _)))
    have h2 := hlen _ h1
    rw [Cardinal.card_ord] at h2
    exact absurd h2 (not_le.2 (Order.lt_succ lam))
  have hsucclt : Order.succ lam < #U := hU.1.isSuccLimit.succ_lt hU.2
  have hsmall : #(∅ ∪ h₀ '' D : Set U) < #U := by
    rw [Set.empty_union]
    refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset
      (t := (⋃ β ∈ Iio θb, (Mb β).carrier) ∪ (Mh θh).carrier) ?_)
      ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le (hinf.trans (Order.le_succ lam))
        (card_biUnion_le (hinf.trans (Order.le_succ lam)) hθbcard fun β hβ =>
          (le_of_eq (hMbK β hβ).2).trans (Order.le_succ lam))
        ((le_of_eq (hMh.2.2 θh (Set.mem_Iic.2 le_rfl)).2).trans (Order.le_succ lam))))) hsucclt
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxB : x ∈ Im
    · left
      simp only [h₀, hxB, if_true]
      obtain ⟨a, ha, u, hu, rfl⟩ := hImEx x hxB
      rw [hgf a ha u hu]
      exact Set.mem_iUnion₂.2 ⟨a, ha, hu⟩
    · right; simp only [h₀, hxB, if_false]; exact hx.resolve_left hxB
  let T : Set U := ⋃ β ∈ Iio θb, ((c β).1 θh).carrier
  obtain ⟨ρ, hρ, hρD, -⟩ := exists_rename hU.infinite h₀ hinj (X := T) hsmall
  have hsubT : ∀ α ≤ θh, ∀ β < θb, ((c β).1 α).carrier ⊆ T := fun α hα β hβ x hx => by
    refine Set.mem_iUnion₂.2 ⟨β, hβ, ?_⟩
    rcases hα.lt_or_eq with h | h
    · exact hS.sub ((hI1 β hβ).1 α hα θh (Set.mem_Iic.2 le_rfl) h) hx
    · rw [← h]; exact hx
  have hfixTop : ∀ x ∈ (Mh θh).carrier, ρ x = x := fun x hx => by
    rw [hρD x (Or.inr hx)]
    by_cases hxB : x ∈ Im
    · simp only [h₀, hxB, if_true]
      exact (h0Im x (by rw [← hant1]; exact ⟨hxB, hx⟩)).2
    · simp only [h₀, hxB, if_false]
  have hρf : ∀ β < θb, ∀ y ∈ (Mb β).carrier, ρ ((c β).2 y) = y := fun β hβ y hy => by
    have hm : (c β).2 y ∈ Im := Set.mem_iUnion₂.2 ⟨β, hβ, y, hy, rfl⟩
    rw [hρD _ (Or.inl hm)]
    simp only [h₀, hm, if_true]
    exact hgf β hβ y hy
  have hex : ∀ α β, ∃ X : Model U L, α ≤ θh → β < θb → IsoOn ρ ((c β).1 α) X := fun α β => by
    by_cases h : α ≤ θh ∧ β < θb
    · obtain ⟨X, hX⟩ := exists_isoOn (hρ.mono (hsubT α h.1 β h.2))
      exact ⟨X, fun _ _ => hX⟩
    · exact ⟨Mb 0, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose R' hR' using hex
  have hR'0 : ∀ β < θb, R' 0 β = Mb β := fun β hβ => by
    obtain ⟨κ, hκ, -, hfκ⟩ := (hI4 β hβ).exists_inv
    refine (hR' 0 β zero_le hβ).unique (hκ.congr fun z hz => ?_)
    have h3 := hρf β hβ (κ z) (hκ.mapsTo hz)
    rw [hfκ z hz] at h3
    exact h3.symm
  have hMsub : ∀ α < θa, (Ma α).carrier ⊆ (Mh θh).carrier := fun α hα x hx => by
    rw [hTop]; exact Set.mem_iUnion₂.2 ⟨α, hα, hx⟩
  have hR'b : ∀ α < θa, R' α 0 = Ma α := fun α hα => by
    have h1 := hR' α 0 (hcov α hα) hβpos
    rw [hR0 α hα] at h1
    exact h1.unique ((IsoOn.refl _).congr fun x hx => (hfixTop x (hMsub α hα hx)).symm)
  have himg : ∀ (X X' : Ordinal.{u} → Model U L) (I : Set Ordinal.{u}), (∀ b ∈ I, ∀ ξ < b, ξ ∈ I) →
      IsContinuous X I → (∀ b ∈ I, IsoOn ρ (X b) (X' b)) → IsContinuous X' I := by
    intro X X' I hI hX hX' b hb hl
    rw [(hX' b hb).carrier_eq, hX b hb hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ξ hξ => ((hX' ξ (hI b hb ξ hξ)).carrier_eq).symm
  refine ⟨R', fun _ => id, fun α hα β hβ => ?_, fun β hβ => ?_, hR'b, fun _ _ => rfl,
    fun _ _ _ _ _ _ _ => rfl, fun β hβ hl x hx => ?_, fun α β hα hβ => ?_, fun α β hα hβ => ?_,
    fun _ _ _ _ _ => rfl, fun α hα => ⟨fun a ha b hb h => ?_, ?_⟩, fun β hβ =>
    ⟨fun a ha b hb h => ?_, ?_⟩⟩
  · have hk := (hI1 β hβ).2.2 α (hcov α hα)
    have hi := hR' α β (hcov α hα) hβ
    exact ⟨hS.iso_mem hk.1 hi, by rw [hi.card_eq]; exact hk.2⟩
  · rw [hR'0 β hβ]; exact IsoOn.refl _
  · rw [hMb.2.1 β hβ hl] at hx
    obtain ⟨ξ, hξ, hxξ⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨ξ, hξ, hxξ, rfl⟩
  · have hαh := hsucc' α hα
    have h1 := Order.add_one_le_iff.2 hαh
    have h7 := hI7 β hβ α hαh
    have hn := Frame.nf_of_notFork hU hc h7 ((hI1 β hβ).2.2 _ h1)
    have hf := hc.ax3a.1 _ _ _ _ hn
    have h2 := Frame.notFork_iso hU hc h7 hf.2.2.2.2.2.1 hf.2.2.2.1.1 (hR' (α + 1) β h1 hβ)
      (hR' α 0 hαh.le hβpos) (hR' α β hαh.le hβ)
    rwa [hfixTop _ (hMsub _ hα (hda α (lt_trans (Order.lt_add_one_iff.2 le_rfl) hα)).1.1)] at h2
  · have hαh := hcov α hα
    have hb' : β < θb := lt_trans (Order.lt_add_one_iff.2 le_rfl) hβ
    have h8 := hI8 β hβ α hαh
    have hn := Frame.nf_of_notFork hU hc h8 ((hI1 _ hβ).2.2 α hαh)
    have hf := hc.ax3a.1 _ _ _ _ hn
    have h2 := Frame.notFork_iso hU hc h8 hf.2.2.2.2.2.1 hf.2.2.2.1.1 (hR' α (β + 1) hαh hβ)
      (hR' 0 β zero_le hb') (hR' α β hαh hb')
    rw [hρf _ hβ _ (hdb β hb').1.1] at h2
    exact h2
  · exact hS.iso_le (hI6i α (hcov α hα) a ha b hb h) (hR' α b (hcov α hα) hb)
      (hR' α a (hcov α hα) ha)
  · exact himg (fun β => (c β).1 α) (fun β => R' α β) (Iio θb) (fun b hb ξ hξ => lt_trans hξ hb)
      (hI6c α (hcov α hα)) fun b hb => hR' α b (hcov α hα) hb
  · exact hS.iso_le ((hI1 β hβ).1 a (hcov a ha) b (hcov b hb) h) (hR' b β (hcov b hb) hβ)
      (hR' a β (hcov a ha) hβ)
  · exact himg (fun α => (c β).1 α) (fun α => R' α β) (Iio θa) (fun b hb ξ hξ => lt_trans hξ hb)
      (fun b hb hl => (hI1 β hβ).2.1 b (hcov b hb) hl) fun b hb => hR' b β (hcov b hb) hβ

/-- AUX: not in paper. A witness for `NF*` depends only on `A` on `[0, α*]` and on `d` on
`[0, α*)`. -/
theorem Frame.NFStarWit.congr {s : Frame U L} {lam : Cardinal.{u}} {N₀ N₁ N₂ N₃ : Model U L}
    {αs : Ordinal.{u}} {A A' B : Ordinal.{u} → Model U L} {d d' : Ordinal.{u} → U}
    (hw : s.NFStarWit lam N₀ N₁ N₂ N₃ αs A B d) (hA : ∀ β ≤ αs, A' β = A β)
    (hd : ∀ i < αs, d' i = d i) : s.NFStarWit lam N₀ N₁ N₂ N₃ αs A' B d' := by
  obtain ⟨hαs, hAi, hAc, hBi, hBc, h1, h2, h3, hA0, hAα, hB0, hBα, hAB, hdm, huq, hnf⟩ := hw
  have hs : ∀ i < αs, i + 1 ≤ αs := fun i h => Order.add_one_le_iff.2 h
  refine ⟨hαs, fun a ha b hb h => ?_, fun b hb hl => ?_, hBi, hBc, h1, h2, h3,
    by rw [hA 0 zero_le]; exact hA0, by rw [hA αs le_rfl]; exact hAα, hB0, hBα,
    fun i hi => by rw [hA i hi]; exact hAB i hi, fun i hi => ?_, fun i hi => ?_, fun i hi => ?_⟩
  · rw [hA a ha, hA b hb]; exact hAi a ha b hb h
  · rw [hA b hb, hAc b hb hl]
    exact Set.iUnion₂_congr fun ξ hξ => by
      rw [hA ξ ((le_of_lt (show ξ < b from hξ)).trans hb)]
  · rw [hA (i + 1) (hs i hi), hA i hi.le, hd i hi]; exact hdm i hi
  · rw [hA (i + 1) (hs i hi), hA i hi.le, hd i hi]; exact huq i hi
  · rw [hA i hi.le, hd i hi]; exact hnf i hi

/-- AUX: not in paper. The renaming used in Thm 5.3.7 and Prop 5.4.6: the identity on `N₁` and
`F⁻¹` on `F[N₂]` together extend to an injection on any set. -/
theorem rename_back {lam : Cardinal.{u}} (hU : Room U lam) (hinf : ℵ₀ ≤ lam)
    {N₀ N₁ N₂ Y : Model U L} {T : Set U} {F : U → U} (hF : IsoOn F N₂ Y)
    (hFid : ∀ x ∈ N₀.carrier, F x = x) (h02 : N₀.carrier ⊆ N₂.carrier)
    (h0Y : N₀.carrier ⊆ Y.carrier) (h1 : N₁.carrier ∩ N₂.carrier = N₀.carrier)
    (h1Y : N₁.carrier ∩ Y.carrier = N₀.carrier) (hc1 : #N₁.carrier ≤ lam)
    (hc2 : #N₂.carrier ≤ lam) :
    ∃ h : U → U, InjOn h T ∧ (∀ x ∈ N₁.carrier, h x = x) ∧ ∀ y ∈ N₂.carrier, h (F y) = y := by
  classical
  obtain ⟨g, hg, hgf, -⟩ := hF.exists_inv
  have hgN0 : ∀ x ∈ N₀.carrier, g x = x := fun x hx => by
    have := hgf x (h02 hx); rwa [hFid x hx] at this
  let h₀ : U → U := fun x => if x ∈ Y.carrier then g x else x
  have hinj : InjOn h₀ (Y.carrier ∪ N₁.carrier) := by
    intro x hx y hy hxy
    by_cases hxB : x ∈ Y.carrier <;> by_cases hyB : y ∈ Y.carrier
    · simp only [h₀, hxB, hyB, if_true] at hxy; exact hg.injOn hxB hyB hxy
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hyN₂ : y ∈ N₂.carrier := by rw [← hxy]; exact hg.mapsTo hxB
      exact absurd (h0Y (by rw [← h1]; exact ⟨hy.resolve_left hyB, hyN₂⟩)) hyB
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hxN₂ : x ∈ N₂.carrier := by rw [hxy]; exact hg.mapsTo hyB
      exact absurd (h0Y (by rw [← h1]; exact ⟨hx.resolve_left hxB, hxN₂⟩)) hxB
    · simp only [h₀, hxB, hyB, if_false] at hxy; exact hxy
  have hsmall : #(∅ ∪ h₀ '' (Y.carrier ∪ N₁.carrier) : Set U) < #U := by
    rw [Set.empty_union]
    refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset ?_)
      ((Cardinal.mk_union_le N₂.carrier N₁.carrier).trans (Cardinal.add_le_of_le hinf hc2 hc1))) hU.2
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxB : x ∈ Y.carrier
    · left; simp only [h₀, hxB, if_true]; exact hg.mapsTo hxB
    · right; simp only [h₀, hxB, if_false]; exact hx.resolve_left hxB
  obtain ⟨h, hhinj, hhD, -⟩ := exists_rename hU.infinite h₀ hinj (X := T) hsmall
  refine ⟨h, hhinj, fun x hx => ?_, fun y hy => ?_⟩
  · rw [hhD x (Or.inr hx)]
    by_cases hxB : x ∈ Y.carrier
    · simp only [h₀, hxB, if_true]
      exact hgN0 x (by rw [← h1Y]; exact ⟨hx, hxB⟩)
    · simp only [h₀, hxB, if_false]
  · have hm := hF.mapsTo hy
    rw [hhD _ (Or.inl hm)]
    simp only [h₀, hm, if_true]
    exact hgf y hy

/-- AUX: not in paper. Joint embeddings of `X, T` and of `Y, T` over `A` give a joint embedding of
`X, Y` over `A`. -/
theorem IsAEC.joint_trans {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hAP : AP S lam) {X Y T : Model U L} {A : Set U} (hT : T ∈ S.Kc lam)
    (h1 : JointEmbOver S lam X T A) (h2 : JointEmbOver S lam Y T A) : JointEmbOver S lam X Y A := by
  obtain ⟨W₁, f₁, g₁, hW₁, hf₁, hg₁, hof₁, hog₁⟩ := h1
  obtain ⟨W₂, f₂, g₂, hW₂, hf₂, hg₂, hof₂, hog₂⟩ := h2
  obtain ⟨-, -, Y₂, hY₂, hgY⟩ := id hg₂
  obtain ⟨κ, hκ, hκg, -⟩ := hgY.exists_inv
  obtain ⟨r, W₂', hr, hrκ, hTW, hWK, -⟩ := hS.rename hU.infinite (∅ : Set U) hY₂ hκ (by
    rw [Set.empty_union]; change T.card < #U; rw [hT.2]; exact hU.2)
  have hW₂'c : W₂' ∈ S.Kc lam := ⟨hWK, by rw [hr.card_eq]; exact hW₂.2⟩
  obtain ⟨k, W₅, hW₅, hW₁W₅, hk, hkg⟩ := hS.amalg_along hU hAP hT hW₂'c hW₁ hTW hg₁
  have hrg : ∀ x ∈ T.carrier, r (g₂ x) = x := fun x hx => by
    rw [hrκ _ (hgY.mapsTo hx), hκg x hx]
  obtain ⟨hX, -, P, hP, hfP⟩ := hf₁
  have hG : IsEmb S (k ∘ (r ∘ f₂)) Y W₅ := IsEmb.comp hS (IsEmb.comp_iso hS hf₂ hr) hk
  refine ⟨W₅, f₁, k ∘ (r ∘ f₂), hW₅, ⟨hX, hS.mem_right hW₁W₅, P, hS.trans hP hW₁W₅, hfP⟩, hG,
    ⟨fun x hx => ⟨(hof₁.1 hx).1, hS.sub hW₁W₅ (hof₁.1 hx).2⟩, hof₁.2⟩, ?_⟩
  have hfix : ∀ x ∈ A, (k ∘ (r ∘ f₂)) x = x := fun x hx => by
    show k (r (f₂ x)) = x
    have hxT : x ∈ T.carrier := (hog₁.1 hx).1
    have h3 := hrg x hxT
    rw [hog₂.2 x hx] at h3
    rw [hof₂.2 x hx, h3, hkg x hxT, hog₁.2 x hx]
  exact ⟨fun x hx => ⟨(hof₂.1 hx).1, hS.sub hW₁W₅ (hog₁.1 hx).2⟩, hfix⟩

/-- Prop 5.4.6 (opposite uniqueness): `NF*(N₀, N₁, N₂, N₃ᵃ)` and `NF*(N₀, N₂, N₁, N₃ᵇ)` imply a
joint embedding of `N₃ᵃ, N₃ᵇ` over `N₁ ∪ N₂`. -/
theorem prop_5_4_6 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (N₀ N₁ N₂ Na Nb : Model U L) (ha : s.NFStar lam N₀ N₁ N₂ Na) (hb : s.NFStar lam N₀ N₂ N₁ Nb) :
    JointEmbOver s.S lam Na Nb (N₁.carrier ∪ N₂.carrier) := by
  classical
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, -⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, kA, αa, A, Ba, da, wa⟩ := ha
  obtain ⟨-, -, -, kB, αb, C, Bb, db, wb⟩ := hb
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  obtain ⟨hαa, hAi, hAc, -, -, -, ⟨h01, h1a⟩, ⟨h02, h2a⟩, hA0, hAα, hB0, -, hAB, hdma, hua, -⟩ :=
    id wa
  obtain ⟨hαb, hCi, hCc, -, -, -, ⟨-, h2b⟩, ⟨-, h1b⟩, hC0, hCα, -, -, -, hdmb, hub, -⟩ := id wb
  have chainK : ∀ {X : Ordinal.{u} → Model U L} {αs : Ordinal.{u}} {T : Model U L},
      IsIncreasing s.S.le X (Iic αs) → X 0 = N₀ → X αs = T → T ∈ s.S.Kc lam →
      ∀ β ≤ αs, X β ∈ s.S.Kc lam := fun {X αs T} hi h0 ht hT β hβ => by
    have hle0 : s.S.le (X 0) (X β) ∨ β = 0 := by
      rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h | h
      · exact Or.inl (hi 0 (Set.mem_Iic.2 zero_le) β hβ h)
      · exact Or.inr h.symm
    rcases hle0 with hle0 | hβ0
    · refine ⟨hS.mem_right hle0, le_antisymm ?_ ?_⟩
      · rw [← hT.2, ← ht]
        rcases hβ.lt_or_eq with h | h
        · exact Model.card_le_of_sub (hS.sub (hi β hβ αs (Set.mem_Iic.2 le_rfl) h))
        · rw [h]
      · rw [← k0.2, ← h0]; exact Model.card_le_of_sub (hS.sub hle0)
    · rw [hβ0, h0]; exact k0
  have hAK := chainK hAi hA0 hAα k1
  have hCK := chainK hCi hC0 hCα k2
  have hαbc : αb.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hαb)
  have hlt1 : ∀ {x y : Ordinal.{u}}, x < y + 1 → x ≤ y := fun h => Order.lt_add_one_iff.1 h
  obtain ⟨c, hrect⟩ := Frame.rectangle (Ma := A) (Mb := C) (da := da) (θb := αb + 1)
    (db := db) hU ⟨hc, hcont3, hsym⟩ ⟨hAi, hAc, hAK⟩
    ⟨fun a ha b hb h => hCi a (hlt1 ha) b (hlt1 hb) h, fun b hb hl => hCc b (hlt1 hb) hl,
      fun β hβ => hCK β (hlt1 hβ)⟩ (hA0.trans hC0.symm)
    (fun α hα => (hua α hα).1)
    (fun β hβ => (hub β (Order.lt_add_one_iff.1 hβ |> fun h =>
      Order.add_one_le_iff.1 h)).1)
    (fun β hβ => (Ordinal.card_le_card (hlt1 hβ)).trans hαbc)
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8⟩ := hrect αb (Order.lt_add_one_iff.2 le_rfl)
  obtain ⟨hTi, hTc, hTK⟩ := c1 αb le_rfl
  have hrow : ∀ α ≤ αa, s.S.le (A α) ((c αb).1 α) := fun α hα => by
    rw [← c2 α hα]
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αb).lt_or_eq with h | h
    · exact (c6 α hα).1 0 (Set.mem_Iic.2 zero_le) αb (Set.mem_Iic.2 le_rfl) h
    · rw [← h, c2 α hα]; exact hS.refl (hAK α hα).1
  have hCle : ∀ β ≤ αb, s.S.le (C β) N₂ := fun β hβ => by
    rw [← hCα]
    rcases hβ.lt_or_eq with h | h
    · exact hCi β hβ αb (Set.mem_Iic.2 le_rfl) h
    · rw [h]; exact hS.refl (hCK αb le_rfl).1
  have hFinc : ∀ β ≤ αb, ∀ y ∈ (C β).carrier, (c αb).2 y = (c β).2 y := fun β hβ y hy => by
    rcases hβ.lt_or_eq with h | h
    · exact c5 β hβ αb (Set.mem_Iic.2 le_rfl) h y hy
    · rw [h]
  have hF : IsoOn (c αb).2 N₂ ((c αb).1 0) := by have := c4 αb le_rfl; rwa [hCα] at this
  have hFid : ∀ x ∈ N₀.carrier, (c αb).2 x = x := fun x hx => by
    have hx0 : x ∈ (C 0).carrier := by rw [hC0]; exact hx
    rw [hFinc 0 zero_le x hx0]
    exact c3 x (by rw [hA0]; exact hx)
  set T := (c αb).1 αa with hTdef
  have h0Y : s.S.le N₀ ((c αb).1 0) := by have := hrow 0 zero_le; rwa [hA0] at this
  have hYT : s.S.le ((c αb).1 0) T := by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αa).lt_or_eq with h | h
    · exact hTi 0 (Set.mem_Iic.2 zero_le) αa (Set.mem_Iic.2 le_rfl) h
    · rw [hTdef, ← h]; exact hS.refl (hTK 0 zero_le).1
  have h1T : s.S.le N₁ T := by have := hrow αa le_rfl; rwa [hAα] at this
  have hw1 : s.NFStarWit lam N₀ N₁ ((c αb).1 0) T αa A (c αb).1 da :=
    ⟨hαa, hAi, hAc, hTi, hTc, ⟨hS.refl k0.1, hS.trans h01 h1T⟩, ⟨h01, h1T⟩, ⟨h0Y, hYT⟩, hA0, hAα,
      rfl, rfl, hrow, hdma, hua, fun α hα => by
        have := c7 αb le_rfl α hα; rwa [c2 α hα.le] at this⟩
  have hdisj1 := (prop_5_3_6 lam hU s hs N₀ N₁ ((c αb).1 0) T).1
    ⟨k0, k1, hTK 0 zero_le, hTK αa le_rfl, αa, A, (c αb).1, da, hw1⟩
  have hdisj2 := (prop_5_3_6 lam hU s hs N₀ N₁ N₂ Na).1
    ⟨k0, k1, k2, kA, αa, A, Ba, da, wa⟩
  obtain ⟨h, hinj, hN₁, hN₂⟩ := rename_back (T := T.carrier) hU hinf hF hFid (hS.sub h02)
    (hS.sub h0Y) hdisj2 hdisj1 (le_of_eq k1.2) (le_of_eq k2.2)
  obtain ⟨T', hT'⟩ := exists_isoOn hinj
  have hT'c : T' ∈ s.S.Kc lam :=
    ⟨hS.iso_mem (hTK αa le_rfl).1 hT', by rw [hT'.card_eq]; exact (hTK αa le_rfl).2⟩
  have hfN₁ : IsoOn h N₁ N₁ := (IsoOn.refl _).congr fun x hx => (hN₁ x hx).symm
  have hfN₀ : IsoOn h N₀ N₀ := (IsoOn.refl _).congr fun x hx => (hN₁ x (hS.sub h01 hx)).symm
  have hfY : IsoOn h ((c αb).1 0) N₂ := by
    obtain ⟨κ, hκ, hκF, hFκ⟩ := hF.exists_inv
    refine hκ.congr fun y hy => ?_
    have h3 := hN₂ (κ y) (hκ.mapsTo hy)
    rw [hFκ y hy] at h3
    exact h3.symm
  obtain ⟨A', B', hw', hA'⟩ := Frame.nfstarWit_iso hU hc hT' hfN₀ hfN₁ hfY hw1
  have hAsub : ∀ β ≤ αa, (A β).carrier ⊆ N₁.carrier := fun β hβ => by
    rw [← hAα]
    rcases hβ.lt_or_eq with h' | h'
    · exact hS.sub (hAi β hβ αa (Set.mem_Iic.2 le_rfl) h')
    · rw [h']
  have hw1' : s.NFStarWit lam N₀ N₁ N₂ T' αa A B' da := hw'.congr
    (fun β hβ => ((hA' β hβ).unique ((IsoOn.refl _).congr fun x hx =>
      (hN₁ x (hAsub β hβ hx)).symm)).symm ▸ rfl)
    (fun i hi => by
      have h1' : i + 1 ≤ αa := Order.add_one_le_iff.2 hi
      show da i = h (da i)
      rw [hN₁ _ (hAsub _ h1' (hdma i hi).1)])
  have hw2 : s.NFStarWit lam N₀ ((c αb).1 0) N₁ T αb (fun β => (c β).1 0)
      (fun β => (c β).1 αa) (fun β => (c (β + 1)).2 (db β)) := by
    have huq2 : ∀ β < αb, ((c β).1 0, (c (β + 1)).1 0, (c (β + 1)).2 (db β)) ∈ s.K3uq lam :=
      fun β hβ => by
        have h1' := Order.add_one_le_iff.2 hβ
        have hiso1 := c4 (β + 1) h1'
        have hiso2 : IsoOn (c (β + 1)).2 (C β) ((c β).1 0) := (c4 β hβ.le).congr fun y hy =>
          (c5 β (Set.mem_Iic.2 hβ.le) (β + 1) (Set.mem_Iic.2 h1')
            (Order.lt_add_one_iff.2 le_rfl) y hy).symm
        exact Frame.K3uq_isoClosed hU hc _ (hub β hβ) _ _ _ hiso1 hiso2
    refine ⟨hαb, (c6 0 zero_le).1, (c6 0 zero_le).2, (c6 αa le_rfl).1, (c6 αa le_rfl).2,
      ⟨hS.refl k0.1, hS.trans h01 h1T⟩, ⟨h0Y, hYT⟩, ⟨h01, h1T⟩, ?_, rfl, ?_, rfl, fun β hβ => ?_,
      fun β hβ => (huq2 β hβ).1.2.2.1, huq2, fun β hβ => c8 β (Order.add_one_le_iff.2 hβ) αa le_rfl⟩
    · show (c 0).1 0 = N₀
      rw [c2 0 zero_le, hA0]
    · show (c 0).1 αa = N₁
      rw [c2 αa le_rfl, hAα]
    · show s.S.le ((c β).1 0) ((c β).1 αa)
      rcases (zero_le : (0 : Ordinal.{u}) ≤ αa).lt_or_eq with h' | h'
      · exact (c1 β hβ).1 0 (Set.mem_Iic.2 zero_le) αa (Set.mem_Iic.2 le_rfl) h'
      · rw [← h']; exact hS.refl ((c1 β hβ).2.2 0 zero_le).1
  obtain ⟨A2, B2, hw'', hA2⟩ := Frame.nfstarWit_iso hU hc hT' hfN₀ hfY hfN₁ hw2
  have hCiso : ∀ β ≤ αb, IsoOn h ((c β).1 0) (C β) := fun β hβ => by
    obtain ⟨κ, hκ, -, hfκ⟩ := (c4 β hβ).exists_inv
    refine hκ.congr fun z hz => ?_
    have hy := hκ.mapsTo hz
    have h3 := hN₂ (κ z) (hS.sub (hCle β hβ) hy)
    rw [hFinc β hβ _ hy, hfκ z hz] at h3
    exact h3.symm
  have hw2' : s.NFStarWit lam N₀ N₂ N₁ T' αb C B2 db := hw''.congr
    (fun β hβ => (hCiso β hβ).unique (hA2 β hβ))
    (fun i hi => by
      have h1' := Order.add_one_le_iff.2 hi
      have hd := (hdmb i hi).1
      have h3 := hN₂ (db i) (hS.sub (hCle _ h1') hd)
      rw [hFinc _ h1' _ hd] at h3
      exact h3.symm)
  have J1 := prop_5_4_5 lam hU s hs N₀ N₁ N₂ Na T' αa A Ba B' da ⟨k0, k1, k2⟩ kA hT'c wa hw1'
  have J2 := prop_5_4_5 lam hU s hs N₀ N₂ N₁ Nb T' αb C Bb B2 db ⟨k0, k2, k1⟩ kB hT'c wb hw2'
  rw [Set.union_comm] at J2
  exact hS.joint_trans hU hc.ax1b hT'c J1 J2

/-- AUX: not in paper. A decomposition is carried by an isomorphism of the top model. -/
theorem decomp_iso {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} {T : Set (Tri U L)}
    (hiso : IsoClosedTri T) {M Ms M' Ms' : Model U L} {f : U → U} {αs : Ordinal.{u}}
    {N : Ordinal.{u} → Model U L} {d : Ordinal.{u} → U}
    (hd : IsDecomp S lam T M Ms αs N d) (hfs : IsoOn f Ms Ms') (hf : IsoOn f M M')
    (hK : Ms ∈ S.Kc lam) : Decomposable S lam T M' Ms' := by
  classical
  obtain ⟨hαs, hNK, hi, hc, h0, hT, hα⟩ := hd
  have hsub : ∀ β ≤ αs, (N β).carrier ⊆ Ms.carrier := fun β hβ => by
    rw [← hα]
    rcases hβ.lt_or_eq with h | h
    · exact hS.sub (hi β hβ αs (Set.mem_Iic.2 le_rfl) h)
    · rw [h]
  have hex : ∀ β ≤ αs, ∃ X, IsoOn f (N β) X := fun β hβ => exists_isoOn (hfs.injOn.mono (hsub β hβ))
  let N' : Ordinal.{u} → Model U L := fun β => if h : β ≤ αs then (hex β h).choose else N β
  have hN' : ∀ β ≤ αs, IsoOn f (N β) (N' β) := fun β hβ => by
    simp only [N', hβ, dite_true]; exact (hex β hβ).choose_spec
  refine ⟨⟨hS.iso_mem hK.1 hfs, by rw [hfs.card_eq]; exact hK.2⟩, αs, N', fun i => f (d i), hαs,
    fun ε hε => ⟨hS.iso_mem (hNK ε hε).1 (hN' ε hε.le), by
      rw [(hN' ε hε.le).card_eq]; exact (hNK ε hε).2⟩,
    fun a ha b hb h => hS.iso_le (hi a ha b hb h) (hN' b hb) (hN' a ha), fun b hb hl => ?_,
    (hN' 0 zero_le).unique (by rw [h0]; exact hf), fun ε hε => ?_,
    (hN' αs le_rfl).unique (by rw [hα]; exact hfs)⟩
  · have hb' : b ≤ αs := hb
    rw [(hN' b hb').carrier_eq, hc b hb hl, Set.image_iUnion₂]
    exact Set.iUnion₂_congr fun ξ hξ => ((hN' ξ ((le_of_lt hξ).trans hb')).carrier_eq).symm
  · exact hiso _ (hT ε hε) f _ _ (hN' (ε + 1) (Order.add_one_le_iff.2 hε)) (hN' ε hε.le)

/-- AUX: not in paper. Composition of two `NF*` squares (Prop 5.3.8 with `α* = 2`). -/
theorem Frame.nfstar_comp {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {A B C D E F : Model U L} (h1 : s.NFStar lam A B C D)
    (h2 : s.NFStar lam B E D F) : s.NFStar lam A E C F := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hA, hB, hC, hD, -, -, -, -, -, -, -, -, -, ⟨-, -⟩, ⟨hAB, -⟩, ⟨hAC, hCD⟩, -⟩ := id h1
  obtain ⟨-, hE, -, hF, -, -, -, -, -, -, -, -, -, ⟨-, -⟩, ⟨hBE, -⟩, ⟨-, hDF⟩, -⟩ := id h2
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hA
  have hκ := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  let o1 : Ordinal.{u} := 0 + 1
  let o2 : Ordinal.{u} := o1 + 1
  have l01 : (0 : Ordinal.{u}) < o1 := Order.lt_add_one_iff.2 le_rfl
  have l12 : o1 < o2 := Order.lt_add_one_iff.2 le_rfl
  have hcase : ∀ ε ≤ o2, ε = 0 ∨ ε = o1 ∨ ε = o2 := fun ε hε => by
    rcases hε.lt_or_eq with h | h
    · have h' : ε ≤ o1 := Order.lt_add_one_iff.1 h
      rcases h'.lt_or_eq with h'' | h''
      · exact Or.inl (le_antisymm (Order.lt_add_one_iff.1 h'') zero_le)
      · exact Or.inr (Or.inl h'')
    · exact Or.inr (Or.inr h)
  have mk : ∀ X0 X1 X2 : Model U L, s.S.le X0 X1 → s.S.le X1 X2 →
      ∃ X : Ordinal.{u} → Model U L, X 0 = X0 ∧ X o1 = X1 ∧ X o2 = X2 ∧
        IsIncreasing s.S.le X (Iic o2) ∧ IsContinuous X (Iic o2) := by
    intro X0 X1 X2 h01 h12
    let X : Ordinal.{u} → Model U L := fun ε => if ε = 0 then X0 else if ε = o1 then X1 else X2
    have e0 : X 0 = X0 := if_pos rfl
    have e1 : X o1 = X1 := by simp only [X, if_neg l01.ne', if_true]
    have e2 : X o2 = X2 := by
      simp only [X, if_neg (lt_trans l01 l12).ne', if_neg l12.ne', if_false]
    refine ⟨X, e0, e1, e2, fun a ha b hb h => ?_, fun b hb hl => ?_⟩
    · rcases hcase a ha with rfl | rfl | rfl <;> rcases hcase b hb with rfl | rfl | rfl
      · exact absurd h (lt_irrefl _)
      · rw [e0, e1]; exact h01
      · rw [e0, e2]; exact hS.trans h01 h12
      · exact absurd (lt_trans h l01) (lt_irrefl _)
      · exact absurd h (lt_irrefl _)
      · rw [e1, e2]; exact h12
      · exact absurd (lt_trans h (lt_trans l01 l12)) (lt_irrefl _)
      · exact absurd (lt_trans h l12) (lt_irrefl _)
      · exact absurd h (lt_irrefl _)
    · exfalso
      rcases hcase b hb with rfl | rfl | rfl
      · exact absurd hl Order.not_isSuccLimit_bot
      · have hl' : Order.IsSuccLimit (Order.succ (0 : Ordinal.{u})) := by
          rw [Order.succ_eq_add_one]; exact hl
        exact absurd hl'.isMax (not_isMax _)
      · have hl' : Order.IsSuccLimit (Order.succ o1) := by
          rw [Order.succ_eq_add_one]; exact hl
        exact absurd hl'.isMax (not_isMax _)
  obtain ⟨Ma, a0, a1, a2, ai, ac⟩ := mk A B E hAB hBE
  obtain ⟨Mb, b0, b1, b2, bi, bc⟩ := mk C D F hCD hDF
  have := prop_5_3_8 lam hU s hs o2 (hκ.add_one_lt (hκ.add_one_lt hκ.bot_lt)) Ma Mb
    (by rw [a0]; exact hA) (by rw [b0]; exact hC) (lt_trans l01 l12) ⟨ai, ac⟩ ⟨bi, bc⟩
    (fun α hα => by
      rcases (Order.lt_add_one_iff.1 hα).lt_or_eq with h | h
      · have h0 : α = 0 := le_antisymm (Order.lt_add_one_iff.1 h) zero_le
        subst h0
        show s.NFStar lam (Ma 0) (Ma o1) (Mb 0) (Mb o1)
        rw [a0, a1, b0, b1]; exact h1
      · subst h
        show s.NFStar lam (Ma o1) (Ma o2) (Mb o1) (Mb o2)
        rw [a1, a2, b1, b2]; exact h2)
  rwa [a0, a2, b0, b2] at this

/-- AUX: not in paper. Case a of Thm 5.4.7. -/
theorem Frame.weak_uq_case_a [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀ M₁ M₂ Ma Mb : Model U L} (ha : s.NFStar lam M₀ M₁ M₂ Ma)
    (hb : s.NFStar lam M₀ M₁ M₂ Mb) (hd : Decomposable s.S lam (s.K3uq lam) M₀ M₂) :
    JointEmbOver s.S lam Ma Mb (M₁.carrier ∪ M₂.carrier) := by
  have hc : s.Core lam := hs.1.1
  obtain ⟨k0, k1, k2, -, -, -, -, -, -, -, -, -, -, -, ⟨h01, -⟩, -⟩ := id ha
  have hdisj := (prop_5_3_6 lam hU s hs M₀ M₁ M₂ Ma).1 ha
  obtain ⟨U₃, hU₃, hop⟩ := Frame.thm_5_3_7_b hU hs k0 k2 k1 h01
    (by rw [Set.inter_comm]; exact hdisj) hd
  exact hc.ax0a.joint_trans hU hc.ax1b hU₃ (prop_5_4_6 lam hU s hs M₀ M₁ M₂ Ma U₃ ha hop)
    (prop_5_4_6 lam hU s hs M₀ M₁ M₂ Mb U₃ hb hop)

/-- AUX: not in paper. In the general case of Thm 5.4.7: from `NF(M₀, M₁, M₂, M)` and a proper
extension `M⁺` of `M₂` with `M⁺ ∩ M₁ = M₀`, get `NF*(M₀, N₁, M⁺, N)` with `M₁ ≼ N₁` and an
embedding of `M` into `N` fixing `M₁ ∪ M₂`. -/
theorem Frame.nf_lift [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀ M₁ M₂ M Mp : Model U L} (h : s.NF lam M₀ M₁ M₂ M)
    (hMp : Mp ∈ s.S.Kc lam) (hlt : s.S.lt M₂ Mp)
    (hdisj : Mp.carrier ∩ M₁.carrier = M₀.carrier) :
    ∃ (N₁ N : Model U L) (e : U → U), s.NFStar lam M₀ N₁ Mp N ∧ s.S.le M₁ N₁ ∧ IsEmb s.S e M N ∧
      ∀ x ∈ M₁.carrier ∪ M₂.carrier, e x = x := by
  classical
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, -⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, kM, l01, -, l02, -, -⟩ := id h
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  obtain ⟨P₁, P₃, hNF, m1, h13, m3⟩ := prop_5_3_9_2 lam hU s hs M₀ M₁ M₂ M h
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨-, h2P⟩, -⟩ := id hNF
  have hsmall : #(Mp.carrier ∪ id '' (M₁.carrier ∪ M₂.carrier) : Set U) < #U := by
    rw [Set.image_id]
    exact lt_of_le_of_lt ((Cardinal.mk_union_le _ _).trans (Cardinal.add_le_of_le hinf
      (le_of_eq hMp.2) (card_union_le k1 k2 hinf))) hU.2
  obtain ⟨ρ, hρ, hρD, hρout⟩ := exists_rename hU.infinite id (Set.injOn_id _)
    (X := P₃.carrier) hsmall
  obtain ⟨P₃', hP₃⟩ := exists_isoOn hρ
  obtain ⟨P₁', hP₁⟩ := exists_isoOn (hρ.mono (hS.sub h13))
  have hfix : ∀ {X : Model U L}, X.carrier ⊆ M₁.carrier ∪ M₂.carrier → IsoOn ρ X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hρD x (hX hx)).symm
  have hfix0 := hfix (X := M₀) fun x hx => Or.inl (hS.sub l01 hx)
  have hfix1 := hfix (X := M₁) fun x hx => Or.inl hx
  have hfix2 := hfix (X := M₂) fun x hx => Or.inr hx
  have hNF' := (prop_5_3_3 lam hU s hs M₀ P₁ M₂ P₃ M₀ P₁' M₂ P₃' ρ hP₃ hfix0 hP₁ hfix2).1 hNF
  have hM₁P : s.S.le M₁ P₁' := hS.iso_le m1 hP₁ hfix1
  have hd1 := (prop_5_3_6 lam hU s hs M₀ P₁ M₂ P₃).1 hNF
  obtain ⟨-, kP₁, -, kP₃, αs, A, B, d, hαs, hAi, hAc, hBi, hBc, -, ⟨h0P, hPT⟩, ⟨h02', h2T⟩, hA0, hAα,
    hB0, hBα, hAB, hdm, huq, hnf⟩ := id hNF'
  have hdisj3 : P₁'.carrier ∩ Mp.carrier = M₀.carrier := by
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub h0P hx, hS.sub (hS.trans l02 hlt.1) hx⟩⟩
    obtain ⟨hxP, hxM⟩ := hx
    rw [hP₁.carrier_eq] at hxP
    obtain ⟨y, hy, rfl⟩ := hxP
    by_cases hyD : y ∈ M₁.carrier ∪ M₂.carrier
    · have e : ρ y = y := hρD y hyD
      rw [e] at hxM ⊢
      rcases hyD with h1 | h2
      · rw [← hdisj]; exact ⟨hxM, h1⟩
      · rw [← hd1]; exact ⟨hy, h2⟩
    · exact absurd (Or.inl hxM) (hρout y ⟨hS.sub h13 hy, hyD⟩)
  have kB : ∀ β ≤ αs, B β ∈ s.S.Kc lam := fun β hβ => by
    have hK := hS.mem_right (hAB β hβ)
    refine ⟨hK, le_antisymm ?_ ?_⟩
    · rw [← kP₃.2, ← hBα]
      rcases hβ.lt_or_eq with h' | h'
      · exact Model.card_le_of_sub (hS.sub (hBi β hβ αs (Set.mem_Iic.2 le_rfl) h'))
      · rw [h']
    · rw [← k2.2, ← hB0]
      rcases (zero_le : (0 : Ordinal.{u}) ≤ β).lt_or_eq with h' | h'
      · exact Model.card_le_of_sub (hS.sub (hBi 0 (Set.mem_Iic.2 zero_le) β hβ h'))
      · rw [← h']
  have hbs : ∀ α < αs, (B α, B (α + 1), d α) ∈ s.K3bs lam := fun α hα => by
    have h1 := Order.add_one_le_iff.2 hα
    have hn := Frame.nf_of_notFork hU hc (hnf α hα) (kB _ h1)
    have hf := hc.ax3a.1 _ _ _ _ hn
    exact ⟨kB α hα.le, kB _ h1, hf.2.2.2.1, hf.2.2.2.2.2.2.2⟩
  obtain ⟨b, hb, hbb⟩ := hc.ax2c M₂ k2 Mp hMp hlt
  obtain ⟨f, C, hCK, hfC, hov, hCi, hCc, hBC, hnfa, -⟩ := Frame.prop_3_1_8_strong lam hU s
    ⟨hc, hcont3, hsym⟩ αs B ⟨hBi, hBc, kB⟩ Mp hMp (by rw [hB0]; exact hlt) d
    (fun α hα => ⟨(hbs α hα).2.2.1, hbs α hα⟩) b (by rw [hB0]; exact hb)
    (by rw [hB0]; exact ⟨k2, hMp, hb, hbb⟩)
  rw [hB0] at hov
  have hC0T : s.S.le (C 0) (C αs) := by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h' | h'
    · exact hCi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) h'
    · rw [← h']; exact hS.refl (hCK 0 zero_le).1
  have hAC : ∀ β ≤ αs, s.S.le (A β) (C β) := fun β hβ => hS.trans (hAB β hβ) (hBC β hβ)
  have hP'C : s.S.le P₁' (C αs) := by have := hAC αs le_rfl; rwa [hAα] at this
  have h0C : s.S.le M₀ (C 0) := by have := hAC 0 zero_le; rwa [hA0] at this
  have hw2 : s.NFStarWit lam M₀ P₁' (C 0) (C αs) αs A C d := by
    refine ⟨hαs, hAi, hAc, hCi, hCc, ⟨hS.refl k0.1, hS.trans h0C hC0T⟩, ⟨h0P, hP'C⟩, ⟨h0C, hC0T⟩,
      hA0, hAα, rfl, rfl, hAC, hdm, huq, fun i hi => ?_⟩
    have h1 := Order.add_one_le_iff.2 hi
    have hn := hnfa i hi
    have hNn := Frame.nf_of_notFork hU hc hn (hCK _ h1)
    have hsb := (hc.ax3a.1 _ _ _ _ hNn).2.2.2.2.2.2.2
    refine Frame.notFork_trans hc (huq i hi).1.1 (hCK i hi.le) (hAB i hi.le) (hBC i hi.le) hsb hn ?_
    have hdB : d i ∈ (B (i + 1)).carrier := (hbs i hi).2.2.1.1
    have hBs : s.S.le (B i) (B (i + 1)) :=
      hBi i (Set.mem_Iic.2 hi.le) (i + 1) (Set.mem_Iic.2 h1) (Order.lt_add_one_iff.2 le_rfl)
    have hK : (B i, C (i + 1), d i) ∈ s.S.K3 := ⟨(kB i hi.le).1, (hCK _ h1).1,
      hS.trans hBs (hBC _ h1), hS.sub (hBC _ h1) hdB⟩
    rw [res_tp hS (hBC i hi.le), ← tp_eq_of_le hS hK (hBC _ h1) hBs hdB]
    exact hnf i hi
  have hNF2 : s.NFStar lam M₀ P₁' (C 0) (C αs) :=
    ⟨k0, kP₁, hCK 0 zero_le, hCK αs le_rfl, αs, A, C, d, hw2⟩
  have hdisj4 := (prop_5_3_6 lam hU s hs M₀ P₁' (C 0) (C αs)).1 hNF2
  have hFid : ∀ x ∈ M₀.carrier, f x = x := fun x hx => hov.2 x (hS.sub l02 hx)
  obtain ⟨g, hg, hgP, hgMp⟩ := rename_back (T := (C αs).carrier) hU hinf hfC hFid
    (hS.sub (hS.trans l02 hlt.1)) (hS.sub h0C) hdisj3 hdisj4 (le_of_eq kP₁.2) (le_of_eq hMp.2)
  obtain ⟨T', hT'⟩ := exists_isoOn hg
  have hg0 : IsoOn g M₀ M₀ := (IsoOn.refl _).congr fun x hx => (hgP x (hS.sub h0P hx)).symm
  have hgP' : IsoOn g P₁' P₁' := (IsoOn.refl _).congr fun x hx => (hgP x hx).symm
  have hgC : IsoOn g (C 0) Mp := by
    obtain ⟨κ, hκ, -, hfκ⟩ := hfC.exists_inv
    refine hκ.congr fun y hy => ?_
    have h3 := hgMp (κ y) (hκ.mapsTo hy)
    rw [hfκ y hy] at h3
    exact h3.symm
  have hNF3 := (prop_5_3_3 lam hU s hs M₀ P₁' (C 0) (C αs) M₀ P₁' Mp T' g hT' hg0 hgP' hgC).1 hNF2
  obtain ⟨Y, hY⟩ := exists_isoOn (hρ.mono (hS.sub m3))
  have hYP : s.S.le Y P₃' := hS.iso_le m3 hP₃ hY
  have hP₃C : s.S.le P₃' (C αs) := by rw [← hBα]; exact hBC αs le_rfl
  have hYC := hS.trans hYP hP₃C
  obtain ⟨Z, hZ⟩ := exists_isoOn (hg.mono (hS.sub hYC))
  refine ⟨P₁', T', g ∘ ρ, hNF3, hM₁P, ⟨kM.1, hS.iso_mem (hCK αs le_rfl).1 hT', Z,
    hS.iso_le hYC hT' hZ, hY.comp hZ⟩, fun x hx => ?_⟩
  show g (ρ x) = x
  rw [hρD x hx]
  rcases hx with h1 | h2
  · exact hgP x (hS.sub hM₁P h1)
  · have := hgMp x (hS.sub hlt.1 h2)
    rwa [hov.2 x h2] at this

/-- AUX: not in paper. In the general case of Thm 5.4.7: moves `NF*(M₀, N₁ˣ, M⁺, Nˣ)` onto a common
first model `N` that is decomposable over the image of `N₁ˣ`. -/
theorem Frame.nf_side [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀ M₁ Mp N₁x Nx P Ns Nq : Model U L} {f ι : U → U}
    (h01 : s.S.le M₀ M₁) (hNF : s.NFStar lam M₀ N₁x Mp Nx) (hM₁ : s.S.le M₁ N₁x)
    (hfP : IsoOn f N₁x P) (hfid : ∀ x ∈ M₁.carrier, f x = x) (hPs : s.S.le P Ns)
    (hDec : Decomposable s.S lam (s.K3uq lam) P Ns) (hι : IsoOn ι Ns Nq)
    (hιid : ∀ x ∈ M₁.carrier, ι x = x) (hNq : Nq ∈ s.S.Kc lam)
    (hdq : Nq.carrier ∩ Mp.carrier = M₀.carrier) :
    ∃ (W : Model U L) (η : U → U), s.NFStar lam M₀ Nq Mp W ∧ IsEmb s.S η Nx W ∧
      (∀ x ∈ M₁.carrier, η x = x) ∧ ∀ x ∈ Mp.carrier, η x = x := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, kN₁, kMp, kNx, -, -, -, -, -, -, -, -, -, -, ⟨-, hN₁Nx⟩, ⟨h0Mp, hMpNx⟩, -⟩ := id hNF
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
  obtain ⟨-, αs, D, e, hd⟩ := id hDec
  have hsNs := hS.sub hPs
  obtain ⟨Pq, hιP⟩ := exists_isoOn (hι.injOn.mono hsNs)
  have hdecq := decomp_iso hS (Frame.K3uq_isoClosed hU hc) hd hι hιP hDec.1
  have hPqNq : s.S.le Pq Nq := hS.iso_le hPs hι hιP
  have hfq : IsoOn (ι ∘ f) N₁x Pq := hfP.comp hιP
  have hfq1 : ∀ x ∈ M₁.carrier, (ι ∘ f) x = x := fun x hx => by
    show ι (f x) = x
    rw [hfid x hx, hιid x hx]
  have hs01 := hS.sub h01
  have hdN := (prop_5_3_6 lam hU s hs M₀ N₁x Mp Nx).1 hNF
  let h₀ : U → U := fun x => if x ∈ N₁x.carrier then (ι ∘ f) x else x
  have hinj : InjOn h₀ (N₁x.carrier ∪ Mp.carrier) := by
    intro x hx y hy hxy
    by_cases hxB : x ∈ N₁x.carrier <;> by_cases hyB : y ∈ N₁x.carrier
    · simp only [h₀, hxB, hyB, if_true] at hxy; exact hfq.injOn hxB hyB hxy
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hyP : y ∈ Nq.carrier := by rw [← hxy]; exact hS.sub hPqNq (hfq.mapsTo hxB)
      have : y ∈ M₀.carrier := by rw [← hdq]; exact ⟨hyP, hy.resolve_left hyB⟩
      exact absurd (hS.sub hM₁ (hs01 this)) hyB
    · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
      have hxP : x ∈ Nq.carrier := by rw [hxy]; exact hS.sub hPqNq (hfq.mapsTo hyB)
      have : x ∈ M₀.carrier := by rw [← hdq]; exact ⟨hxP, hx.resolve_left hxB⟩
      exact absurd (hS.sub hM₁ (hs01 this)) hxB
    · simp only [h₀, hxB, hyB, if_false] at hxy; exact hxy
  have hsmall : #(Nq.carrier ∪ h₀ '' (N₁x.carrier ∪ Mp.carrier) : Set U) < #U := by
    refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset (t := Nq.carrier ∪ Mp.carrier) ?_)
      (card_union_le hNq kMp hinf)) hU.2
    rintro x (hx | ⟨y, hy, rfl⟩)
    · exact Or.inl hx
    · by_cases hyB : y ∈ N₁x.carrier
      · left; simp only [h₀, hyB, if_true]; exact hS.sub hPqNq (hfq.mapsTo hyB)
      · right; simp only [h₀, hyB, if_false]; exact hy.resolve_left hyB
  obtain ⟨η, hη, hηD, hηout⟩ := exists_rename hU.infinite h₀ hinj (X := Nx.carrier) hsmall
  obtain ⟨Z, hZ⟩ := exists_isoOn hη
  have hηN : ∀ x ∈ N₁x.carrier, η x = (ι ∘ f) x := fun x hx => by
    rw [hηD x (Or.inl hx)]; simp only [h₀, hx, if_true]
  have hηMp : ∀ x ∈ Mp.carrier, η x = x := fun x hx => by
    rw [hηD x (Or.inr hx)]
    by_cases hxB : x ∈ N₁x.carrier
    · simp only [h₀, hxB, if_true]
      have : x ∈ M₀.carrier := by rw [← hdN]; exact ⟨hxB, hx⟩
      exact hfq1 x (hs01 this)
    · simp only [h₀, hxB, if_false]
  have hη0 : IsoOn η M₀ M₀ := (IsoOn.refl _).congr fun x hx => (hηMp x (hS.sub h0Mp hx)).symm
  have hηP : IsoOn η N₁x Pq := hfq.congr fun x hx => (hηN x hx).symm
  have hηM : IsoOn η Mp Mp := (IsoOn.refl _).congr fun x hx => (hηMp x hx).symm
  have hNF' := (prop_5_3_3 lam hU s hs M₀ N₁x Mp Nx M₀ Pq Mp Z η hZ hη0 hηP hηM).1 hNF
  have hPqZ : s.S.le Pq Z := hS.iso_le hN₁Nx hZ hηP
  have hM₀Pq : M₀.carrier ⊆ Pq.carrier := fun x hx => by
    rw [← hfq1 x (hs01 hx)]; exact hfq.mapsTo (hS.sub hM₁ (hs01 hx))
  have hdisjZ : Nq.carrier ∩ Z.carrier = Pq.carrier := by
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub hPqNq hx, hS.sub hPqZ hx⟩⟩
    obtain ⟨hxN, hxZ⟩ := hx
    rw [hZ.carrier_eq] at hxZ
    obtain ⟨y, hy, rfl⟩ := hxZ
    by_cases hyD : y ∈ N₁x.carrier ∪ Mp.carrier
    · by_cases hy1 : y ∈ N₁x.carrier
      · rw [hηN y hy1]; exact hfq.mapsTo hy1
      · have hyM := hyD.resolve_left hy1
        rw [hηMp y hyM] at hxN ⊢
        exact hM₀Pq (by rw [← hdq]; exact ⟨hxN, hyM⟩)
    · exact absurd (Or.inl hxN) (hηout y ⟨hy, hyD⟩)
  have hPqc : Pq ∈ s.S.Kc lam := ⟨hS.mem_left hPqNq, by
    rw [hfq.card_eq]; exact kN₁.2⟩
  have hZc : Z ∈ s.S.Kc lam := ⟨hS.iso_mem kNx.1 hZ, by rw [hZ.card_eq]; exact kNx.2⟩
  obtain ⟨W, hW, hNF2⟩ := Frame.thm_5_3_7_b hU hs hPqc hNq hZc hPqZ hdisjZ hdecq
  have hcomp := Frame.nfstar_comp hU hs hNF' hNF2
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨-, hZW⟩, -⟩ := id hNF2
  exact ⟨W, η, hcomp, ⟨kNx.1, hS.mem_right hZW, Z, hZW, hZ⟩,
    fun x hx => (hηN x (hS.sub hM₁ hx)).trans (hfq1 x hx), hηMp⟩

/-- Thm 5.4.7 (weak uniqueness for `NF`): `NF(M₀, M₁, M₂, Mˣ)` (`x = a, b`) imply a joint
embedding of `Mᵃ, Mᵇ` over `M₁ ∪ M₂`. -/
theorem thm_5_4_7 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam)
    (M₀ M₁ M₂ Ma Mb : Model U L) (ha : s.NF lam M₀ M₁ M₂ Ma) (hb : s.NF lam M₀ M₁ M₂ Mb) :
    JointEmbOver s.S lam Ma Mb (M₁.carrier ∪ M₂.carrier) := by
  classical
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, kMa, l01, l1a, l02, l2a, -⟩ := id ha
  obtain ⟨-, -, -, kMb, -, l1b, -, l2b, -⟩ := id hb
  have hiso := Frame.K3uq_isoClosed hU hc
  have hsub : s.K3uq lam ⊆ s.K3bs lam := fun _ h => h.1
  obtain ⟨X, hX, hltX⟩ := Frame.exists_strict hc k2
  have h0X : s.S.lt M₀ X := ⟨hS.trans l02 hltX.1, fun e => by
    have h1 : s.S.le X M₂ := by rw [← e]; exact l02
    exact hltX.2 (hS.po.2.2.1 _ _ hltX.1 h1)⟩
  obtain ⟨Ms, hMs, hXMs, -, αd, D, e, hd⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3uq lam)
    hsub hiso hex M₀ X k0 hX h0X).1
  obtain ⟨a, ha', -⟩ := hc.ax2c M₂ k2 X hX hltX
  have h2Ms : s.S.le M₂ Ms := hS.trans hltX.1 hXMs
  obtain ⟨h, Mp, hh, hid, hM₂Mp, hMpK, hout⟩ := hS.rename hU.infinite M₁.carrier h2Ms
    (IsoOn.refl M₂) (by
      refine lt_of_le_of_lt (card_union_le k1 k2 (Frame.aleph0_le hc k0)) hU.2)
  have hMpc : Mp ∈ s.S.Kc lam := ⟨hMpK, by rw [hh.card_eq]; exact hMs.2⟩
  have hh0 : IsoOn h M₀ M₀ := (IsoOn.refl _).congr fun x hx => (hid x (hS.sub l02 hx)).symm
  have hdecp := decomp_iso hS hiso hd hh hh0 hMs
  have hltp : s.S.lt M₂ Mp := ⟨hM₂Mp, fun e' => by
    have haM : a ∈ Ms.carrier := hS.sub hXMs ha'.1
    have h3 := hh.mapsTo haM
    rw [← e'] at h3
    exact (hout a ⟨haM, ha'.2⟩) (Or.inr h3)⟩
  have hd12 := (prop_5_3_6 lam hU s hs M₀ M₁ M₂ Ma).2 ha
  have hdisj : Mp.carrier ∩ M₁.carrier = M₀.carrier := by
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub (hS.trans l02 hM₂Mp) hx, hS.sub l01 hx⟩⟩
    obtain ⟨hx1, hx2⟩ := hx
    rw [hh.carrier_eq] at hx1
    obtain ⟨y, hy, rfl⟩ := hx1
    by_cases hy2 : y ∈ M₂.carrier
    · have e' : h y = y := hid y hy2
      rw [e'] at hx2 ⊢
      rw [← hd12]; exact ⟨hx2, hy2⟩
    · exact absurd (Or.inl hx2) (hout y ⟨hy, hy2⟩)
  obtain ⟨N₁a, Na, ga, hNFa, hM₁a, hga, hga1⟩ := Frame.nf_lift hU hs ha hMpc hltp hdisj
  obtain ⟨N₁b, Nb, gb, hNFb, hM₁b, hgb, hgb1⟩ := Frame.nf_lift hU hs hb hMpc hltp hdisj
  have hN₁ac : N₁a ∈ s.S.Kc lam := hNFa.2.1
  have hN₁bc : N₁b ∈ s.S.Kc lam := hNFb.2.1
  obtain ⟨fa, fb, W, ⟨hfa, hfb, ova, ovb⟩, hW⟩ := hc.ax1b M₁ k1 N₁a hN₁ac N₁b hN₁bc hM₁a hM₁b
  obtain ⟨-, -, Pa, hPaW, hfaP⟩ := hfa
  obtain ⟨-, -, Pb, hPbW, hfbP⟩ := hfb
  have hPac : Pa ∈ s.S.Kc lam := ⟨hS.mem_left hPaW, by rw [hfaP.card_eq]; exact hN₁ac.2⟩
  have hPbc : Pb ∈ s.S.Kc lam := ⟨hS.mem_left hPbW, by rw [hfbP.card_eq]; exact hN₁bc.2⟩
  obtain ⟨Ns, hNs, hWNs, hDa, hDb⟩ := prop_3_2_4 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3uq lam) hsub hiso
    hex Pa Pb W hPac hPbc hW hPaW hPbW
  have hM₁Pa : s.S.le M₁ Pa :=
    hS.iso_le hM₁a hfaP ((IsoOn.refl _).congr fun x hx => (ova.2 x hx).symm)
  have hM₁Ns : s.S.le M₁ Ns := hS.trans hM₁Pa (hS.trans hPaW hWNs)
  obtain ⟨ι, Nq, hι, hιid, hM₁Nq, hNqK, hιout⟩ := hS.rename hU.infinite Mp.carrier hM₁Ns
    (IsoOn.refl M₁) (by
      refine lt_of_le_of_lt (card_union_le hMpc k1 (Frame.aleph0_le hc k0)) hU.2)
  have hNqc : Nq ∈ s.S.Kc lam := ⟨hNqK, by rw [hι.card_eq]; exact hNs.2⟩
  have hdq : Nq.carrier ∩ Mp.carrier = M₀.carrier := by
    ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub hM₁Nq (hS.sub l01 hx),
      hS.sub (hS.trans l02 hM₂Mp) hx⟩⟩
    obtain ⟨hx1, hx2⟩ := hx
    rw [hι.carrier_eq] at hx1
    obtain ⟨y, hy, rfl⟩ := hx1
    by_cases hy1 : y ∈ M₁.carrier
    · have e' : ι y = y := hιid y hy1
      rw [e'] at hx2 ⊢
      rw [← hdisj]; exact ⟨hx2, hy1⟩
    · exact absurd (Or.inl hx2) (hιout y ⟨hy, hy1⟩)
  obtain ⟨Wa, ηa, hNa', hηa, hηa1, hηa2⟩ := Frame.nf_side hU hs l01 hNFa hM₁a hfaP ova.2
    (hS.trans hPaW hWNs) hDa hι hιid hNqc hdq
  obtain ⟨Wb, ηb, hNb', hηb, hηb1, hηb2⟩ := Frame.nf_side hU hs l01 hNFb hM₁b hfbP ovb.2
    (hS.trans hPbW hWNs) hDb hι hιid hNqc hdq
  obtain ⟨Z, F, G, hZ, hF, hG, ovF, ovG⟩ := Frame.weak_uq_case_a hU hs hNa' hNb' hdecp
  have hsubU : ∀ x ∈ M₁.carrier ∪ M₂.carrier, x ∈ Nq.carrier ∪ Mp.carrier := by
    rintro x (h1 | h2)
    · exact Or.inl (hS.sub hM₁Nq h1)
    · exact Or.inr (hS.sub hM₂Mp h2)
  have hfixa : ∀ x ∈ M₁.carrier ∪ M₂.carrier, (F ∘ (ηa ∘ ga)) x = x := fun x hx => by
    show F (ηa (ga x)) = x
    rw [hga1 x hx]
    rcases hx with h1 | h2
    · rw [hηa1 x h1]; exact ovF.2 x (hsubU x (Or.inl h1))
    · rw [hηa2 x (hS.sub hM₂Mp h2)]; exact ovF.2 x (hsubU x (Or.inr h2))
  have hfixb : ∀ x ∈ M₁.carrier ∪ M₂.carrier, (G ∘ (ηb ∘ gb)) x = x := fun x hx => by
    show G (ηb (gb x)) = x
    rw [hgb1 x hx]
    rcases hx with h1 | h2
    · rw [hηb1 x h1]; exact ovG.2 x (hsubU x (Or.inl h1))
    · rw [hηb2 x (hS.sub hM₂Mp h2)]; exact ovG.2 x (hsubU x (Or.inr h2))
  refine ⟨Z, F ∘ (ηa ∘ ga), G ∘ (ηb ∘ gb), hZ, IsEmb.comp hS (IsEmb.comp hS hga hηa) hF,
    IsEmb.comp hS (IsEmb.comp hS hgb hηb) hG, ⟨fun x hx => ⟨?_, (ovF.1 (hsubU x hx)).2⟩, hfixa⟩,
    ⟨fun x hx => ⟨?_, (ovF.1 (hsubU x hx)).2⟩, hfixb⟩⟩
  · rcases hx with h1 | h2
    · exact hS.sub l1a h1
    · exact hS.sub l2a h2
  · rcases hx with h1 | h2
    · exact hS.sub l1b h1
    · exact hS.sub l2b h2

/-- AUX: not in paper. A proper extension of `M₂`, decomposable over `M₀` by `K^{3,uq}`, meeting a
given `M₁` only in `M₀`. -/
theorem Frame.exists_decomp_ext {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {M₀ M₁ M₂ : Model U L} (k0 : M₀ ∈ s.S.Kc lam) (k1 : M₁ ∈ s.S.Kc lam)
    (k2 : M₂ ∈ s.S.Kc lam) (l01 : s.S.le M₀ M₁) (l02 : s.S.le M₀ M₂)
    (hd12 : M₁.carrier ∩ M₂.carrier = M₀.carrier) :
    ∃ Mp ∈ s.S.Kc lam, s.S.lt M₂ Mp ∧ Decomposable s.S lam (s.K3uq lam) M₀ Mp ∧
      Mp.carrier ∩ M₁.carrier = M₀.carrier := by
  obtain ⟨⟨hc, hcont3, hsym, -, -⟩, -, hex⟩ := id hs
  have hS : IsAEC s.S := hc.ax0a
  have hiso := Frame.K3uq_isoClosed hU hc
  obtain ⟨X, hX, hltX⟩ := Frame.exists_strict hc k2
  have h0X : s.S.lt M₀ X := ⟨hS.trans l02 hltX.1, fun e => by
    have h1 : s.S.le X M₂ := by rw [← e]; exact l02
    exact hltX.2 (hS.po.2.2.1 _ _ hltX.1 h1)⟩
  obtain ⟨Ms, hMs, hXMs, -, αd, D, e, hd⟩ := (thm_3_2_3_3 lam hU s ⟨hc, hcont3, hsym⟩ (s.K3uq lam)
    (fun _ h => h.1) hiso hex M₀ X k0 hX h0X).1
  obtain ⟨a, ha', -⟩ := hc.ax2c M₂ k2 X hX hltX
  have h2Ms : s.S.le M₂ Ms := hS.trans hltX.1 hXMs
  obtain ⟨h, Mp, hh, hid, hM₂Mp, hMpK, hout⟩ := hS.rename hU.infinite M₁.carrier h2Ms
    (IsoOn.refl M₂) (lt_of_le_of_lt (card_union_le k1 k2 (Frame.aleph0_le hc k0)) hU.2)
  have hh0 : IsoOn h M₀ M₀ := (IsoOn.refl _).congr fun x hx => (hid x (hS.sub l02 hx)).symm
  refine ⟨Mp, ⟨hMpK, by rw [hh.card_eq]; exact hMs.2⟩, ⟨hM₂Mp, fun e' => ?_⟩,
    decomp_iso hS hiso hd hh hh0 hMs, ?_⟩
  · have haM : a ∈ Ms.carrier := hS.sub hXMs ha'.1
    have h3 := hh.mapsTo haM
    rw [← e'] at h3
    exact (hout a ⟨haM, ha'.2⟩) (Or.inr h3)
  · ext x
    refine ⟨fun hx => ?_, fun hx => ⟨hS.sub (hS.trans l02 hM₂Mp) hx, hS.sub l01 hx⟩⟩
    obtain ⟨hx1, hx2⟩ := hx
    rw [hh.carrier_eq] at hx1
    obtain ⟨y, hy, rfl⟩ := hx1
    by_cases hy2 : y ∈ M₂.carrier
    · have e' : h y = y := hid y hy2
      rw [e'] at hx2 ⊢
      rw [← hd12]; exact ⟨hx2, hy2⟩
    · exact absurd (Or.inl hx2) (hout y ⟨hy, hy2⟩)

/-- AUX: not in paper. The core of Thm 5.4.9: `NF` is symmetric. -/
theorem Frame.nf_symm [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {N₀ N₁ N₂ N₃ : Model U L} (h : s.NF lam N₀ N₁ N₂ N₃) :
    s.NF lam N₀ N₂ N₁ N₃ := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, -⟩ := id h
  have hd12 := (prop_5_3_6 lam hU s hs N₀ N₁ N₂ N₃).2 h
  obtain ⟨Mp, hMp, hlt, hdec, hdisj⟩ := Frame.exists_decomp_ext hU hs k0 k1 k2 l01 l02 hd12
  obtain ⟨Q₁, W, e, hNF, hN₁Q, he, hfix⟩ := Frame.nf_lift hU hs h hMp hlt hdisj
  obtain ⟨-, kQ, -, kW, -⟩ := id hNF
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨h0Q, hQW⟩, ⟨h0M, hMW⟩, -⟩ := id hNF
  have hd2 := (prop_5_3_6 lam hU s hs N₀ Q₁ Mp W).1 hNF
  obtain ⟨V, hV, hop⟩ := Frame.thm_5_3_7_b hU hs k0 hMp kQ h0Q
    (by rw [Set.inter_comm]; exact hd2) hdec
  obtain ⟨Z, F, G, hZ, hF, hG, ovF, ovG⟩ := prop_5_4_6 lam hU s hs N₀ Q₁ Mp W V hNF hop
  obtain ⟨-, -, Vi, hViZ, hGV⟩ := id hG
  have hfixG : ∀ {X : Model U L}, X.carrier ⊆ Q₁.carrier ∪ Mp.carrier → IsoOn G X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (ovG.2 x (hX hx)).symm
  have hs0Q : N₀.carrier ⊆ Q₁.carrier := hS.sub h0Q
  have hNFi := (prop_5_3_3 lam hU s hs N₀ Mp Q₁ V N₀ Mp Q₁ Vi G hGV (hfixG fun x hx => Or.inl (hs0Q hx))
    (hfixG fun x hx => Or.inr hx) (hfixG fun x hx => Or.inl hx)).1 hop
  have hNFZ := prop_5_3_9_3 lam hU s hs N₀ Mp Q₁ Vi Z hNFi hViZ hZ
  have hE : IsEmb s.S (F ∘ e) N₃ Z := IsEmb.comp hS he hF
  obtain ⟨-, -, Y, hYZ, hFY⟩ := id hE
  have hfix' : ∀ x ∈ N₁.carrier ∪ N₂.carrier, (F ∘ e) x = x := fun x hx => by
    show F (e x) = x
    rw [hfix x hx]
    rcases hx with h1 | h2
    · exact ovF.2 x (Or.inl (hS.sub hN₁Q h1))
    · exact ovF.2 x (Or.inr (hS.sub hlt.1 h2))
  have hfixX : ∀ {X : Model U L}, X.carrier ⊆ N₁.carrier ∪ N₂.carrier → IsoOn (F ∘ e) X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hfix' x (hX hx)).symm
  have h1Y : s.S.le N₁ Y := hS.iso_le l13 hFY (hfixX fun x hx => Or.inl hx)
  have h2Y : s.S.le N₂ Y := hS.iso_le l23 hFY (hfixX fun x hx => Or.inr hx)
  have hYc : Y ∈ s.S.Kc lam := ⟨hS.mem_left hYZ, by rw [hFY.card_eq]; exact k3.2⟩
  have hNFY : s.NF lam N₀ N₂ N₁ Y := prop_5_3_9_4 lam hU s hs N₀ k0 Mp hMp Q₁ kQ Z hZ N₀ k0 N₂ k2 N₁ k1 Y
    hYc hNFZ rfl ⟨hS.refl k0.1, hS.refl k0.1, hS.trans l02 h2Y⟩ ⟨hlt.1, l02, h2Y⟩
    ⟨hN₁Q, l01, h1Y⟩ ⟨Z, hS.refl hZ.1, hYZ⟩
  obtain ⟨κ, hκ, hκF, -⟩ := hFY.exists_inv
  have hfixκ : ∀ {X : Model U L}, X.carrier ⊆ N₁.carrier ∪ N₂.carrier → IsoOn κ X X := fun {X} hX =>
    (IsoOn.refl _).congr fun x hx => by
      show x = κ x
      have hx3 : x ∈ N₃.carrier := by
        rcases hX hx with h1 | h2
        · exact hS.sub l13 h1
        · exact hS.sub l23 h2
      have := hκF x hx3
      rw [hfix' x (hX hx)] at this
      exact this.symm
  exact (prop_5_3_3 lam hU s hs N₀ N₂ N₁ Y N₀ N₂ N₁ N₃ κ hκ
    (hfixκ fun x hx => Or.inl (hS.sub l01 hx)) (hfixκ fun x hx => Or.inr hx)
    (hfixκ fun x hx => Or.inl hx)).2 hNFY

/-- Prop 5.4.8: `⊗⁻_{NF}`. -/
theorem prop_5_4_8 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    OtMinus s.S lam (s.NF lam) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  refine ⟨fun M₀ M₁ M₂ M₃ h => ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1⟩,
    fun M₀ M₁ M₂ M₃ h => ⟨h.2.2.2.2.1, h.2.2.2.2.2.1, h.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2.1⟩, ?_, ?_⟩
  · rintro N₀ N₁ N₂ A B hA hB ⟨P, Q, hP, hQ, hNA⟩ ⟨P', Q', hP', hQ', hNB⟩
    obtain ⟨k0, kP, kQ, kA, l0P, lPA, l0Q, lQA, -⟩ := id hNA
    obtain ⟨-, kP', kQ', kB, -, lPB, -, lQB, -⟩ := id hNB
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
    obtain ⟨⟨hA1, hA2, ovA1, ovA2⟩, -⟩ := id hA
    obtain ⟨⟨hB1, hB2, ovB1, ovB2⟩, -⟩ := id hB
    have hd := (prop_5_3_6 lam hU s hs N₀ P Q A.2.2).2 hNA
    have hd' := (prop_5_3_6 lam hU s hs N₀ P' Q' B.2.2).2 hNB
    obtain ⟨θ₁, hθ₁, hθ₁B, hBθ₁⟩ := hP'.exists_inv
    obtain ⟨θ₂, hθ₂, hθ₂B, hBθ₂⟩ := hQ'.exists_inv
    have hN₀N₁ : N₀.carrier ⊆ N₁.carrier := fun x hx => (ovA1.1 hx).1
    have hN₀N₂ : N₀.carrier ⊆ N₂.carrier := fun x hx => (ovA2.1 hx).1
    have hθ₁0 : ∀ x ∈ N₀.carrier, θ₁ x = x := fun x hx => by
      have := hθ₁B x (hN₀N₁ hx); rwa [ovB1.2 x hx] at this
    have hθ₂0 : ∀ x ∈ N₀.carrier, θ₂ x = x := fun x hx => by
      have := hθ₂B x (hN₀N₂ hx); rwa [ovB2.2 x hx] at this
    let u₁ : U → U := A.1 ∘ θ₁
    let u₂ : U → U := A.2.1 ∘ θ₂
    have hu₁ : IsoOn u₁ P' P := hθ₁.comp hP
    have hu₂ : IsoOn u₂ Q' Q := hθ₂.comp hQ
    have hu₁0 : ∀ x ∈ N₀.carrier, u₁ x = x := fun x hx => by
      show A.1 (θ₁ x) = x
      rw [hθ₁0 x hx, ovA1.2 x hx]
    have hu₂0 : ∀ x ∈ N₀.carrier, u₂ x = x := fun x hx => by
      show A.2.1 (θ₂ x) = x
      rw [hθ₂0 x hx, ovA2.2 x hx]
    let h₀ : U → U := fun x => if x ∈ P'.carrier then u₁ x else u₂ x
    have hinj : InjOn h₀ (P'.carrier ∪ Q'.carrier) := by
      intro x hx y hy hxy
      by_cases hxB : x ∈ P'.carrier <;> by_cases hyB : y ∈ P'.carrier
      · simp only [h₀, hxB, hyB, if_true] at hxy; exact hu₁.injOn hxB hyB hxy
      · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
        have hyQ := hy.resolve_left hyB
        have h3 : u₁ x ∈ N₀.carrier := by
          rw [← hd]; exact ⟨hu₁.mapsTo hxB, by rw [hxy]; exact hu₂.mapsTo hyQ⟩
        have hx0 : x ∈ N₀.carrier := by
          obtain ⟨κ, hκ, hκu, huκ⟩ := hu₁.exists_inv
          have hsP : N₀.carrier ⊆ P'.carrier := hS.sub (by
            obtain ⟨_, _, _, _, l, -⟩ := id hNB; exact l)
          have := hu₁.injOn hxB (hsP h3) (hu₁0 _ h3).symm
          rw [this]; exact h3
        have hy0 : u₂ y = u₂ x := by rw [← hxy, hu₁0 x hx0, hu₂0 x hx0]
        have hsQ : N₀.carrier ⊆ Q'.carrier := hS.sub (by
          obtain ⟨_, _, _, _, _, _, l, -⟩ := id hNB; exact l)
        have e := hu₂.injOn hyQ (hsQ hx0) hy0
        rw [e]
      · simp only [h₀, hxB, hyB, if_true, if_false] at hxy
        have hxQ := hx.resolve_left hxB
        have h3 : u₁ y ∈ N₀.carrier := by
          rw [← hd]; exact ⟨hu₁.mapsTo hyB, by rw [← hxy]; exact hu₂.mapsTo hxQ⟩
        have hsP : N₀.carrier ⊆ P'.carrier := hS.sub (by
          obtain ⟨_, _, _, _, l, -⟩ := id hNB; exact l)
        have hy0 : y ∈ N₀.carrier := by
          have := hu₁.injOn hyB (hsP h3) (hu₁0 _ h3).symm
          rw [this]; exact h3
        have hx0 : u₂ x = u₂ y := by rw [hxy, hu₁0 y hy0, hu₂0 y hy0]
        have hsQ : N₀.carrier ⊆ Q'.carrier := hS.sub (by
          obtain ⟨_, _, _, _, _, _, l, -⟩ := id hNB; exact l)
        have e := hu₂.injOn hxQ (hsQ hy0) hx0
        rw [e]
      · simp only [h₀, hxB, hyB, if_false] at hxy
        exact hu₂.injOn (hx.resolve_left hxB) (hy.resolve_left hyB) hxy
    have hsmall : #(∅ ∪ h₀ '' (P'.carrier ∪ Q'.carrier) : Set U) < #U := by
      rw [Set.empty_union]
      refine lt_of_le_of_lt (le_trans (Cardinal.mk_le_mk_of_subset (t := P.carrier ∪ Q.carrier) ?_)
        (card_union_le kP kQ hinf)) hU.2
      rintro _ ⟨x, hx, rfl⟩
      by_cases hxB : x ∈ P'.carrier
      · left; simp only [h₀, hxB, if_true]; exact hu₁.mapsTo hxB
      · right; simp only [h₀, hxB, if_false]; exact hu₂.mapsTo (hx.resolve_left hxB)
    obtain ⟨ρ, hρ, hρD, -⟩ := exists_rename hU.infinite h₀ hinj (X := B.2.2.carrier) hsmall
    obtain ⟨B₃, hB₃⟩ := exists_isoOn hρ
    have hρP : ∀ x ∈ P'.carrier, ρ x = u₁ x := fun x hx => by
      rw [hρD x (Or.inl hx)]; simp only [h₀, hx, if_true]
    have hρQ : ∀ x ∈ Q'.carrier, ρ x = u₂ x := fun x hx => by
      rw [hρD x (Or.inr hx)]
      by_cases hxB : x ∈ P'.carrier
      · have hx0 : x ∈ N₀.carrier := by rw [← hd']; exact ⟨hxB, hx⟩
        simp only [h₀, hxB, if_true]
        rw [hu₁0 x hx0, hu₂0 x hx0]
      · simp only [h₀, hxB, if_false]
    have hl0P' : s.S.le N₀ P' := hNB.2.2.2.2.1
    have hρ0 : IsoOn ρ N₀ N₀ := (IsoOn.refl _).congr fun x hx => by
      show x = ρ x
      rw [hρP x (hS.sub hl0P' hx), hu₁0 x hx]
    have hNB' := (prop_5_3_3 lam hU s hs N₀ P' Q' B.2.2 N₀ P Q B₃ ρ hB₃ hρ0
      (hu₁.congr fun x hx => (hρP x hx).symm) (hu₂.congr fun x hx => (hρQ x hx).symm)).2 hNB
    obtain ⟨Z, F, G, hZ, hF, hG, ovF, ovG⟩ := thm_5_4_7 lam hU s hs N₀ P Q A.2.2 B₃ hNA hNB'
    have hN₁c : N₁ ∈ s.S.Kc lam := ⟨hA1.1, by
      obtain ⟨κ, hκ, -⟩ := hP.exists_inv; rw [hκ.card_eq]; exact kP.2⟩
    have hN₂c : N₂ ∈ s.S.Kc lam := ⟨hA2.1, by
      obtain ⟨κ, hκ, -⟩ := hQ.exists_inv; rw [hκ.card_eq]; exact kQ.2⟩
    have pull : ∀ {g : U → U} {X Y : Model U L}, IsoOn g X Y → s.S.le N₀ Y →
        (∀ x ∈ N₀.carrier, g x = x) → N₀.carrier ⊆ X.carrier → s.S.le N₀ X := by
      intro g X Y hg hle hg0 hsub
      obtain ⟨κ, hκ, hκg, -⟩ := hg.exists_inv
      exact hS.iso_le hle hκ ((IsoOn.refl _).congr fun x hx => by
        show x = κ x
        have := hκg x (hsub hx); rw [hg0 x hx] at this; exact this.symm)
    exact ⟨k0, hN₁c, hN₂c, pull hP l0P ovA1.2 hN₀N₁, pull hQ l0Q ovA2.2 hN₀N₂, hA, hB, F,
      G ∘ ρ, Z, hF, IsEmb.iso_comp hB₃ kB.1 hG, fun x hx => by
        show G (ρ (B.1 x)) = F (A.1 x)
        have hm := hP'.mapsTo hx
        have e1 : u₁ (B.1 x) = A.1 x := by show A.1 (θ₁ (B.1 x)) = A.1 x; rw [hθ₁B x hx]
        rw [hρP _ hm, e1, ovG.2 _ (Or.inl (hP.mapsTo hx)), ovF.2 _ (Or.inl (hP.mapsTo hx))],
      fun x hx => by
        show G (ρ (B.2.1 x)) = F (A.2.1 x)
        have hm := hQ'.mapsTo hx
        have e1 : u₂ (B.2.1 x) = A.2.1 x := by show A.2.1 (θ₂ (B.2.1 x)) = A.2.1 x; rw [hθ₂B x hx]
        rw [hρQ _ hm, e1, ovG.2 _ (Or.inr (hQ.mapsTo hx)), ovF.2 _ (Or.inr (hQ.mapsTo hx))]⟩
  · intro M₀ M₁ M₂ M₃ M₄ f h hf hM₄
    obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, -⟩ := id h
    have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc k0
    have hd12 := (prop_5_3_6 lam hU s hs M₀ M₁ M₂ M₃).2 h
    obtain ⟨-, -, Q₂, hQ₂, hfQ⟩ := id hf
    have hQ₂c : Q₂ ∈ s.S.Kc lam := ⟨hS.mem_left hQ₂, by rw [hfQ.card_eq]; exact k2.2⟩
    obtain ⟨g₀, M₃', hg₀, hg₀f, hQM, hM'K, hout⟩ := hS.rename hU.infinite M₄.carrier l23 hfQ
      (lt_of_le_of_lt (card_union_le hM₄ hQ₂c hinf) hU.2)
    have hM'c : M₃' ∈ s.S.Kc lam := ⟨hM'K, by rw [hg₀.card_eq]; exact k3.2⟩
    obtain ⟨P, hfP⟩ := exists_isoOn (hfQ.injOn.mono (hS.sub l02))
    obtain ⟨Q₁, hgQ⟩ := exists_isoOn (hg₀.injOn.mono (hS.sub l13))
    have hg₀P : IsoOn g₀ M₀ P := hfP.congr fun x hx => (hg₀f x (hS.sub l02 hx)).symm
    have hg₀Q₂ : IsoOn g₀ M₂ Q₂ := hfQ.congr fun x hx => (hg₀f x hx).symm
    have hNF' := (prop_5_3_3 lam hU s hs M₀ M₁ M₂ M₃ P Q₁ Q₂ M₃' g₀ hg₀ hg₀P hgQ hg₀Q₂).2 h
    by_cases heq : Q₂ = M₄
    · subst heq
      exact ⟨g₀, M₃', P, Q₁, hM'c, ⟨k3.1, hM'K, M₃', hS.refl hM'K, hg₀⟩, hg₀f, hQM, hfP, hgQ, hNF'⟩
    have hdisj : M₄.carrier ∩ Q₁.carrier = P.carrier := by
      have hd' := (prop_5_3_6 lam hU s hs P Q₁ Q₂ M₃').2 hNF'
      ext x
      constructor
      · rintro ⟨hx4, hx1⟩
        have hx1' := hx1
        rw [hgQ.carrier_eq] at hx1'
        obtain ⟨y, hy, rfl⟩ := hx1'
        by_cases hy2 : y ∈ M₂.carrier
        · rw [← hd']; exact ⟨hx1, hg₀Q₂.mapsTo hy2⟩
        · exact absurd (Or.inl hx4) (hout y ⟨hS.sub l13 hy, hy2⟩)
      · intro hx
        have hP0 : s.S.le P Q₂ := hNF'.2.2.2.2.2.2.1
        have hPQ : s.S.le P Q₁ := hNF'.2.2.2.2.1
        exact ⟨hS.sub hQ₂ (hS.sub hP0 hx), hS.sub hPQ hx⟩
    obtain ⟨N₁, N, e, hNF2, hQN, he, hfix⟩ := Frame.nf_lift hU hs hNF' hM₄ ⟨hQ₂, heq⟩ hdisj
    obtain ⟨kP, kN₁, -, kN, -, -, -, -, -, -, -, -, -, -, ⟨hPN₁, hN₁N⟩, ⟨hPM₄, hM₄N⟩, -⟩ := id hNF2
    have hgE : IsEmb s.S (e ∘ g₀) M₃ N := IsEmb.iso_comp hg₀ k3.1 he
    have hgQ' : IsoOn (e ∘ g₀) M₁ Q₁ := hgQ.congr fun x hx => by
      show g₀ x = e (g₀ x)
      rw [hfix _ (Or.inl (hgQ.mapsTo hx))]
    have hQ₁N : s.S.le Q₁ N := hS.trans hQN hN₁N
    have hgf : ∀ x ∈ M₂.carrier, (e ∘ g₀) x = f x := fun x hx => by
      show e (g₀ x) = f x
      rw [hg₀f x hx, hfix _ (Or.inr (hfQ.mapsTo hx))]
    have hPQ₁ : s.S.le P Q₁ := hNF'.2.2.2.2.1
    exact ⟨e ∘ g₀, N, P, Q₁, kN, hgE, hgf, hM₄N, hfP, hgQ', kP, hNF'.2.1, hM₄, kN, hPQ₁, hQ₁N,
      hPM₄, hM₄N, P, N₁, M₄, N, rfl, hS.refl kP.1, hQN, hS.refl hM₄.1, hS.refl kN.1, hNF2⟩

/-- Thm 5.4.9 (symmetry): `NF(N₀, N₁, N₂, N₃) ↔ NF(N₀, N₂, N₁, N₃)`. -/
theorem thm_5_4_9 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    OtE (s.NF lam) := by
  intro N₀ N₁ N₂ N₃
  exact ⟨fun h => Frame.nf_symm hU hs h, fun h => Frame.nf_symm hU hs h⟩

/-- Thm 5.4.10: `NF` respects `s`. -/
theorem thm_5_4_10 [C : CitedResults.{u}]
    (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L) (hs : Hyp_5_1_1 s lam) :
    Respects s lam (s.NF lam) := by
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  intro M₀ M₁ M₂ M₃ a h hab
  obtain ⟨k0, k1, k2, k3, l01, l13, l02, l23, -⟩ := id h
  have hd12 := (prop_5_3_6 lam hU s hs M₀ M₁ M₂ M₃).2 h
  obtain ⟨N', a', hlt, hN', ha', heq⟩ := hc.ax2a M₀ k0 hab
  have hK : (M₀, M₁, a) ∈ s.S.K3 := (ERel.K3_iff (tp_eq_iff.1 heq)).2 ⟨k0.1, hN'.1, hlt.1, ha'.1⟩
  have hna : a ∉ M₀.carrier := fun haM => ha'.2 (by
    have e := (ERel.alg (tp_eq_iff.1 heq)).1 haM
    simp only at e; rw [e]; exact haM)
  obtain ⟨N₃, hN₃, N₁s, hN₁s, hM₁N, αs, A, B, d, hw, hd0⟩ := Frame.thm_5_3_7_c hU hs k0 k1 k2 l01 l02
    hd12 ⟨hK.2.2.2, hna⟩ hab
  have hNFs : s.NFStar lam M₀ N₁s M₂ N₃ := ⟨k0, hN₁s, k2, hN₃, αs, A, B, d, hw⟩
  obtain ⟨hαs, hAi, -, hBi, -, ⟨-, -⟩, ⟨h0N, hNN⟩, ⟨-, h2N⟩, hA0, hAα, hB0, hBα, hAB, hdm, -, hnf⟩ := id hw
  have hNF' : s.NF lam M₀ M₁ M₂ N₃ := ⟨k0, k1, k2, hN₃, l01, hS.trans hM₁N hNN, l02, h2N, M₀, N₁s, M₂,
    N₃, rfl, hS.refl k0.1, hM₁N, hS.refl k2.1, hS.refl hN₃.1, hNFs⟩
  obtain ⟨W, F, G, hW, hF, hG, ovF, ovG⟩ := thm_5_4_7 lam hU s hs M₀ M₁ M₂ N₃ M₃ hNF' h
  have hpos : (0 : Ordinal.{u}) < αs := by
    rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with h' | h'
    · exact h'
    · exfalso; apply hna
      have : a ∈ N₁s.carrier := hS.sub hM₁N hK.2.2.2
      rwa [← hAα, ← h', hA0] at this
  have h1 : (0 : Ordinal.{u}) + 1 ≤ αs := Order.add_one_le_iff.2 hpos
  have hn0 := hnf 0 hpos
  rw [hA0, hB0, hd0] at hn0
  have haB1 : a ∈ (B (0 + 1)).carrier := by
    have := (hdm 0 hpos).1
    rw [hd0] at this
    exact hS.sub (hAB _ h1) this
  have hB1 : s.S.le (B (0 + 1)) N₃ := by
    rw [← hBα]
    rcases h1.lt_or_eq with h' | h'
    · exact hBi _ h1 αs (Set.mem_Iic.2 le_rfl) h'
    · rw [h']; exact hS.refl (hS.mem_right (hAB αs le_rfl))
  have h2B1 : s.S.le M₂ (B (0 + 1)) := by
    rw [← hB0]
    exact hBi 0 (Set.mem_Iic.2 zero_le) (0 + 1) h1 (Order.lt_add_one_iff.2 le_rfl)
  have haN : a ∈ N₃.carrier := hS.sub hB1 haB1
  have hK1 : (M₂, N₃, a) ∈ s.S.K3 := ⟨k2.1, hN₃.1, h2N, haN⟩
  rw [tp_eq_of_le hS hK1 hB1 h2B1 haB1] at hn0
  have haM₁ : a ∈ M₁.carrier ∪ M₂.carrier := Or.inl hK.2.2.2
  have hK3 : (M₂, M₃, a) ∈ s.S.K3 := ⟨k2.1, k3.1, l23, hS.sub l13 hK.2.2.2⟩
  have hKW : (M₂, W, a) ∈ s.S.K3 := by
    have hk : M₂.carrier ⊆ W.carrier := fun x hx => (ovF.1 (Or.inr hx)).2
    refine ⟨k2.1, hW.1, ?_, (ovF.1 haM₁).2⟩
    obtain ⟨-, -, Y, hY, hFY⟩ := id hF
    exact hS.trans (hS.iso_le h2N hFY ((IsoOn.refl _).congr fun x hx =>
      (ovF.2 x (Or.inr hx)).symm)) hY
  have e1 : tp s.S lam a M₂ N₃ = tp s.S lam a M₂ W := tp_eq_iff.2 (Relation.EqvGen.rel _ _
    ⟨hK1, hKW, rfl, W, hW.1, hS.refl hW.1, F, hF,
      ⟨fun x hx => ⟨hS.sub h2N hx, hS.sub hKW.2.2.1 hx⟩, fun x hx => ovF.2 x (Or.inr hx)⟩,
      ovF.2 a haM₁⟩)
  have e2 : tp s.S lam a M₂ M₃ = tp s.S lam a M₂ W := tp_eq_iff.2 (Relation.EqvGen.rel _ _
    ⟨hK3, hKW, rfl, W, hW.1, hS.refl hW.1, G, hG,
      ⟨fun x hx => ⟨hS.sub l23 hx, hS.sub hKW.2.2.1 hx⟩, fun x hx => ovG.2 x (Or.inr hx)⟩,
      ovG.2 a haM₁⟩)
  rw [e2, ← e1]
  exact hn0

/-! ## 5.5 Long transitivity -/

/-- AUX: not in paper. The invariant of `Frame.chain_build`. -/
def ChainInv (S : KSys U L) (lam : Cardinal.{u}) (M : Ordinal.{u} → Model U L) (X : Model U L)
    (Step : Ordinal.{u} → QRel U L) (α : Ordinal.{u})
    (c : Ordinal.{u} → Model U L × (U → U)) : Prop :=
  (∀ β ≤ α, (c β).1 ∈ S.Kc lam) ∧ (c 0).1 = X ∧ (∀ x ∈ (M 0).carrier, (c 0).2 x = x) ∧
  IsIncreasing S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
  (∀ β ≤ α, IsEmb S (c β).2 (M β) (c β).1) ∧ FunIncreasing (fun β => (c β).2) M (Iic α) ∧
  ∀ β, β + 1 ≤ α → ∃ P Q, IsoOn (c β).2 (M β) P ∧ IsoOn (c (β + 1)).2 (M (β + 1)) Q ∧
    Step β P Q (c β).1 (c (β + 1)).1

/-- AUX: not in paper. `ChainInv` for a chain that may leave `K_λ` at `λ⁺`. -/
def ChainInvG (S : KSys U L) (lam : Cardinal.{u}) (M : Ordinal.{u} → Model U L) (X : Model U L)
    (Step : Ordinal.{u} → QRel U L) (α : Ordinal.{u})
    (c : Ordinal.{u} → Model U L × (U → U)) : Prop :=
  (∀ β ≤ α, (c β).1 ∈ S.K ∧ (β < (Order.succ lam).ord → (c β).1 ∈ S.Kc lam)) ∧ (c 0).1 = X ∧
  (∀ x ∈ (M 0).carrier, (c 0).2 x = x) ∧
  IsIncreasing S.le (fun β => (c β).1) (Iic α) ∧ IsContinuous (fun β => (c β).1) (Iic α) ∧
  (∀ β ≤ α, IsEmb S (c β).2 (M β) (c β).1) ∧ FunIncreasing (fun β => (c β).2) M (Iic α) ∧
  ∀ β, β + 1 ≤ α → ∃ P Q, IsoOn (c β).2 (M β) P ∧ IsoOn (c (β + 1)).2 (M (β + 1)) Q ∧
    Step β P Q (c β).1 (c (β + 1)).1

/-- AUX: not in paper. The common construction of Thm 5.5.1 and Prop 5.5.3: a chain `N_ε` with
embeddings `f_ε : M_ε → N_ε`, where each step `(f_ε[M_ε], f_{ε+1}[M_{ε+1}], N_ε, N_{ε+1})` has a
prescribed property. -/
theorem IsAEC.chain_build_gen {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hinf : ℵ₀ ≤ lam) {αs : Ordinal.{u}} (hαs : αs ≤ (Order.succ lam).ord)
    {M : Ordinal.{u} → Model U L} (hMi : IsIncreasing S.le M (Iic αs))
    (hMc : IsContinuous M (Iic αs))
    (hMK : ∀ ε ≤ αs, M ε ∈ S.K ∧ (ε < (Order.succ lam).ord → M ε ∈ S.Kc lam)) {X : Model U L}
    (hX : X ∈ S.Kc lam) (h0X : S.le (M 0) X) (Step : Ordinal.{u} → QRel U L)
    (hstep : ∀ ε < αs, ∀ (g : U → U) (P Q N : Model U L), IsoOn g (M ε) P →
      IsoOn g (M (ε + 1)) Q → S.le P Q → N ∈ S.Kc lam → S.le P N →
      Q.carrier ∩ N.carrier = P.carrier → ∃ N' ∈ S.Kc lam, S.le N N' ∧ S.le Q N' ∧ Step ε P Q N N') :
    ∃ c, ChainInvG S lam M X Step αs c := by
  classical
  have hne : Nonempty (Model U L × (U → U)) := ⟨(X, id)⟩
  suffices H : ∃ c, ∀ α ≤ αs, ChainInvG S lam M X Step α c by
    obtain ⟨c, hc⟩ := H; exact ⟨c, hc αs le_rfl⟩
  refine transfinite_construction αs (ChainInvG S lam M X Step) (fun α c c' h hi => ?_)
    (fun α hα c hprev => ?_)
  · obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hi
    have e : ∀ β ≤ α, c' β = c β := fun β hβ => (h β hβ).symm
    have e0 := e 0 zero_le
    refine ⟨fun β hβ => by rw [e β hβ]; exact h1 β hβ, by rw [e0]; exact h2,
      by rw [e0]; exact h3, fun a ha b hb hl => ?_, fun b hb hl => ?_,
      fun β hβ => by rw [e β hβ]; exact h6 β hβ, fun a ha b hb hl => ?_, fun β hβ => ?_⟩
    · simp only [e a ha, e b hb]; exact h4 a ha b hb hl
    · simp only [e b hb]; rw [h5 b hb hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [e ξ ((le_of_lt hξ).trans hb)]
    · simp only [e a ha, e b hb]; exact h7 a ha b hb hl
    · rw [e β ((Order.lt_add_one_iff.2 le_rfl).le.trans hβ), e (β + 1) hβ]; exact h8 β hβ
  rcases Ordinal.zero_or_succ_or_isSuccLimit α with h0α | ⟨γ, hγ⟩ | hlim
  · subst h0α
    have hc0 : (fun b => if b < (0 : Ordinal.{u}) then c b else (X, id)) = fun _ => (X, id) :=
      funext fun b => if_neg (not_lt.2 zero_le)
    refine ⟨(X, id), ?_⟩
    rw [hc0]
    have hz : ∀ b ≤ (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
    have hbad : ∀ {a b : Ordinal.{u}}, b ∈ Iic (0 : Ordinal.{u}) → a < b → False :=
      fun {a b} hb h => absurd (lt_of_lt_of_le h hb) (not_lt.2 zero_le)
    refine ⟨fun _ _ => ⟨hX.1, fun _ => hX⟩, rfl, fun _ _ => rfl, fun _ _ b hb h => (hbad hb h).elim,
      fun b hb hl => ?_, fun b hb => ?_, fun _ _ b hb h => (hbad hb h).elim, fun b hb => ?_⟩
    · rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
    · rw [hz b hb]; exact IsEmb.of_le hS h0X
    · exact absurd (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hb) (not_lt.2 zero_le)
  · rw [Order.succ_eq_add_one] at hγ
    subst hγ
    have hγ1 : γ < γ + 1 := Order.lt_add_one_iff.2 le_rfl
    have hγα : γ < αs := lt_of_lt_of_le hγ1 hα
    obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8⟩ := hprev γ hγ1
    have hle : S.le (M γ) (M (γ + 1)) :=
      hMi γ (Set.mem_Iic.2 hγα.le) (γ + 1) (Set.mem_Iic.2 hα) hγ1
    have hγκ : γ < (Order.succ lam).ord := lt_of_lt_of_le hγα hαs
    have hNγ := (p1 γ le_rfl).2 hγκ
    obtain ⟨-, -, P, hPN, hfP⟩ := p6 γ le_rfl
    have hPc : P ∈ S.Kc lam := ⟨hS.mem_left hPN, by rw [hfP.card_eq]; exact ((hMK γ hγα.le).2 hγκ).2⟩
    obtain ⟨g, Q, hg, hgf, hPQ, hQK, hout⟩ := hS.rename hU.infinite (c γ).1.carrier hle hfP
      (lt_of_le_of_lt (card_union_le hNγ hPc hinf) hU.2)
    have hgP : IsoOn g (M γ) P := hfP.congr fun x hx => (hgf x hx).symm
    have hd : Q.carrier ∩ (c γ).1.carrier = P.carrier := by
      ext x
      constructor
      · rintro ⟨hx1, hx2⟩
        rw [hg.carrier_eq] at hx1
        obtain ⟨y, hy, rfl⟩ := hx1
        by_cases hy2 : y ∈ (M γ).carrier
        · exact hgP.mapsTo hy2
        · exact absurd (Or.inl hx2) (hout y ⟨hy, hy2⟩)
      · intro hx; exact ⟨hS.sub hPQ hx, hS.sub hPN hx⟩
    obtain ⟨N', hN', hNN', hQN', hSt⟩ := hstep γ hγα g P Q (c γ).1 hgP hg hPQ hNγ hPN hd
    refine ⟨(N', g), ?_⟩
    set c' : Ordinal.{u} → Model U L × (U → U) :=
      fun b => if b < γ + 1 then c b else (N', g) with hc'def
    have hcl : ∀ b ≤ γ, c' b = c b := fun b hb => if_pos (Order.lt_add_one_iff.2 hb)
    have hcx : c' (γ + 1) = (N', g) := if_neg (lt_irrefl _)
    have hcases : ∀ b ≤ γ + 1, b ≤ γ ∨ b = γ + 1 := fun b hb => by
      rcases hb.lt_or_eq with h | h
      · exact Or.inl (Order.lt_add_one_iff.1 h)
      · exact Or.inr h
    have hle1 : ∀ b ≤ γ, S.le (c b).1 (c γ).1 := fun b hb => by
      rcases hb.lt_or_eq with h | h
      · exact p4 b (Set.mem_Iic.2 hb) γ (Set.mem_Iic.2 le_rfl) h
      · rw [h]; exact hS.refl hNγ.1
    refine ⟨fun b hb => ?_, by rw [hcl 0 zero_le]; exact p2, by rw [hcl 0 zero_le]; exact p3,
      fun a ha b hb hl => ?_, fun b hb hl => ?_, fun b hb => ?_, fun a ha b hb hl y hy => ?_,
      fun b hb => ?_⟩
    · rcases hcases b hb with h | h
      · rw [hcl b h]; exact p1 b h
      · rw [h, hcx]; exact ⟨hN'.1, fun _ => hN'⟩
    · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hb)
      show S.le (c' a).1 (c' b).1
      rw [hcl a haγ]
      rcases hcases b hb with h | h
      · rw [hcl b h]; exact p4 a (Set.mem_Iic.2 haγ) b (Set.mem_Iic.2 h) hl
      · rw [h, hcx]; exact hS.trans (hle1 a haγ) hNN'
    · have hbγ : b ≤ γ := by
        rcases hcases b hb with h | h
        · exact h
        · rw [h, ← Order.succ_eq_add_one] at hl; exact absurd hl.isMax (not_isMax γ)
      show (c' b).1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).1.carrier
      rw [hcl b hbγ, p5 b (Set.mem_Iic.2 hbγ) hl]
      exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ ((le_of_lt hξ).trans hbγ)]
    · rcases hcases b hb with h | h
      · rw [hcl b h]; exact p6 b h
      · rw [h, hcx]; exact ⟨(hMK _ hα).1, hN'.1, Q, hQN', hg⟩
    · have haγ : a ≤ γ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hl hb)
      show (c' b).2 y = (c' a).2 y
      rw [hcl a haγ]
      rcases hcases b hb with h | h
      · rw [hcl b h]; exact p7 a (Set.mem_Iic.2 haγ) b (Set.mem_Iic.2 h) hl y hy
      · rw [h, hcx]
        have hyγ : y ∈ (M γ).carrier := by
          rcases haγ.lt_or_eq with h' | h'
          · exact hS.sub (hMi a (Set.mem_Iic.2 (haγ.trans hγα.le)) γ (Set.mem_Iic.2 hγα.le) h') hy
          · rw [← h']; exact hy
        show g y = _
        rw [hgf y hyγ]
        rcases haγ.lt_or_eq with h' | h'
        · exact p7 a (Set.mem_Iic.2 haγ) γ (Set.mem_Iic.2 le_rfl) h' y hy
        · rw [h']
    · have hbγ : b ≤ γ := Order.lt_add_one_iff.1 (Order.add_one_le_iff.1 hb)
      rcases hbγ.lt_or_eq with h | h
      · have hb1 : b + 1 ≤ γ := Order.add_one_le_iff.2 h
        rw [hcl b hbγ, hcl (b + 1) hb1]; exact p8 b hb1
      · subst h
        rw [hcl b le_rfl, hcx]
        exact ⟨P, Q, hfP, hg, hSt⟩
  · have h0α : (0 : Ordinal.{u}) < α := hlim.bot_lt
    have hK : ∀ β < α, (c β).1 ∈ S.K ∧ (β < (Order.succ lam).ord → (c β).1 ∈ S.Kc lam) :=
      fun β hβ => (hprev β hβ).1 β le_rfl
    have hinc : IsIncreasing S.le (fun β => (c β).1) (Iio α) := fun β hβ β' hβ' h =>
      (hprev β' hβ').2.2.2.1 β (Set.mem_Iic.2 h.le) β' (Set.mem_Iic.2 le_rfl) h
    have hcont : IsContinuous (fun β => (c β).1) (Iio α) := fun β hβ hl =>
      (hprev β hβ).2.2.2.2.1 β (Set.mem_Iic.2 le_rfl) hl
    obtain ⟨Nα, hNαU, -, -⟩ := hS.union α hlim _ hinc hcont
    obtain ⟨hNαK, hleNα⟩ := hS.le_union hlim hinc hcont hNαU
    have hNαc : α < (Order.succ lam).ord → Nα ∈ S.Kc lam := fun hακ => by
      have hαcard : α.card ≤ lam := Order.lt_succ_iff.1 (Cardinal.lt_ord.1 hακ)
      have hK' : ∀ β < α, (c β).1 ∈ S.Kc lam := fun β hβ => (hK β hβ).2 (lt_trans hβ hακ)
      refine ⟨hNαK, le_antisymm ?_ ?_⟩
      · change #Nα.carrier ≤ lam
        rw [hNαU.1]
        exact card_biUnion_le hinf hαcard fun β hβ => le_of_eq (hK' β hβ).2
      · rw [← (hK' 0 h0α).2]; exact Model.card_le_of_sub (hS.sub (hleNα 0 h0α))
    have hfi : ∀ a < α, ∀ b < α, a < b → ∀ y ∈ (M a).carrier, (c b).2 y = (c a).2 y :=
      fun a _ b hb h y hy =>
        (hprev b hb).2.2.2.2.2.2.1 a (Set.mem_Iic.2 h.le) b (Set.mem_Iic.2 le_rfl) h y hy
    let F : U → U := fun x => if h : ∃ β < α, x ∈ (M β).carrier then (c h.choose).2 x else x
    have hF : ∀ γ < α, ∀ y ∈ (M γ).carrier, F y = (c γ).2 y := fun γ hγ y hy => by
      have h : ∃ β < α, y ∈ (M β).carrier := ⟨γ, hγ, hy⟩
      simp only [F, h, dite_true]
      obtain ⟨h1, h2⟩ := h.choose_spec
      rcases lt_trichotomy h.choose γ with h' | h' | h'
      · exact (hfi _ h1 γ hγ h' y h2).symm
      · rw [h']
      · exact hfi γ hγ _ h1 h' y hy
    refine ⟨(Nα, F), ?_⟩
    set c' : Ordinal.{u} → Model U L × (U → U) :=
      fun b => if b < α then c b else (Nα, F) with hc'def
    have hcl : ∀ b < α, c' b = c b := fun b hb => if_pos hb
    have hcx : c' α = (Nα, F) := if_neg (lt_irrefl _)
    have hp0 := hprev 0 h0α
    have c4 : IsIncreasing S.le (fun β => (c' β).1) (Iic α) := by
      intro a ha b hb hl
      have haα : a < α := lt_of_lt_of_le hl hb
      show S.le (c' a).1 (c' b).1
      rw [hcl a haα]
      rcases (show b ≤ α from hb).lt_or_eq with h' | h'
      · rw [hcl b h']; exact hinc a haα b h' hl
      · rw [h', hcx]; exact hleNα a haα
    have c7 : FunIncreasing (fun β => (c' β).2) M (Iic α) := by
      intro a ha b hb hl y hy
      have haα : a < α := lt_of_lt_of_le hl hb
      show (c' b).2 y = (c' a).2 y
      rw [hcl a haα]
      rcases (show b ≤ α from hb).lt_or_eq with h' | h'
      · rw [hcl b h']; exact hfi a haα b h' hl y hy
      · rw [h', hcx]; exact hF a haα y hy
    have hMi' : IsIncreasing S.le M (Iic α) := fun a ha b hb h =>
      hMi a ((show a ≤ α from ha).trans hα) b ((show b ≤ α from hb).trans hα) h
    have hMc' : IsContinuous M (Iic α) := fun b hb hl => hMc b ((show b ≤ α from hb).trans hα) hl
    have c6 : ∀ b ≤ α, IsEmb S (c' b).2 (M b) (c' b).1 := by
      have hlt : ∀ b < α, IsEmb S (c' b).2 (M b) (c' b).1 := fun b hb => by
        rw [hcl b hb]; exact (hprev b hb).2.2.2.2.2.1 b le_rfl
      intro b hb
      rcases hb.lt_or_eq with h | h
      · exact hlt b h
      · subst h
        exact hS.emb_limit (f := fun β => (c' β).2) (N := fun β => (c' β).1) hlim hMi' hMc' c4 hlt c7
    refine ⟨fun b hb => ?_, by rw [hcl 0 h0α]; exact hp0.2.1, by rw [hcl 0 h0α]; exact hp0.2.2.1,
      c4, fun b hb hl => ?_, c6, c7, fun b hb => ?_⟩
    · rcases hb.lt_or_eq with h | h
      · rw [hcl b h]; exact hK b h
      · rw [h, hcx]; exact ⟨hNαK, hNαc⟩
    · show (c' b).1.carrier = ⋃ ξ ∈ Iio b, (c' ξ).1.carrier
      rcases (show b ≤ α from hb).lt_or_eq with h | h
      · rw [hcl b h, hcont b h hl]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ (lt_trans hξ h)]
      · rw [h, hcx, hNαU.1]
        exact Set.iUnion₂_congr fun ξ hξ => by rw [hcl ξ hξ]
    · have hb1 : b + 1 < α := lt_of_le_of_ne hb fun h => by
        rw [h.symm, ← Order.succ_eq_add_one] at hlim; exact absurd hlim.isMax (not_isMax b)
      have hb' : b < α := lt_trans (Order.lt_add_one_iff.2 le_rfl) hb1
      rw [hcl b hb', hcl (b + 1) hb1]
      exact (hprev (b + 1) hb1).2.2.2.2.2.2.2 b le_rfl

/-- AUX: not in paper. `IsAEC.chain_build_gen` for a chain in `K_λ` of length `< λ⁺`. -/
theorem IsAEC.chain_build {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hU : Room U lam)
    (hinf : ℵ₀ ≤ lam) {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord)
    {M : Ordinal.{u} → Model U L} (hM : IsIncCont S M (Iic αs) (S.Kc lam)) {X : Model U L}
    (hX : X ∈ S.Kc lam) (h0X : S.le (M 0) X) (Step : Ordinal.{u} → QRel U L)
    (hstep : ∀ ε < αs, ∀ (g : U → U) (P Q N : Model U L), IsoOn g (M ε) P →
      IsoOn g (M (ε + 1)) Q → S.le P Q → N ∈ S.Kc lam → S.le P N →
      Q.carrier ∩ N.carrier = P.carrier → ∃ N' ∈ S.Kc lam, S.le N N' ∧ S.le Q N' ∧ Step ε P Q N N') :
    ∃ c, ChainInv S lam M X Step αs c := by
  obtain ⟨c, h1, h⟩ := hS.chain_build_gen hU hinf hαs.le hM.1 hM.2.1
    (fun ε hε => ⟨(hM.2.2 ε hε).1, fun _ => hM.2.2 ε hε⟩) hX h0X Step hstep
  exact ⟨c, fun β hβ => (h1 β hβ).2 (lt_of_le_of_lt hβ hαs), h⟩

/-- AUX: not in paper. `NF*` implies `NF`. -/
theorem Frame.nfstar_nf {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {A B C D : Model U L} (h : s.NFStar lam A B C D) : s.NF lam A B C D := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨k0, k1, k2, k3, -, -, -, -, -, -, -, -, -, -, ⟨l01, l13⟩, ⟨l02, l23⟩, -⟩ := id h
  exact ⟨k0, k1, k2, k3, l01, l13, l02, l23, A, B, C, D, rfl, hS.refl k0.1, hS.refl k1.1,
    hS.refl k2.1, hS.refl k3.1, h⟩

/-- AUX: not in paper. The trivial `NF*`: a witness of length `0`. -/
theorem Frame.nfstar_zero {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {A B : Model U L} (hA : A ∈ s.S.Kc lam) (hB : B ∈ s.S.Kc lam) (h : s.S.le A B) :
    s.NFStar lam A A B B := by
  have hS : IsAEC s.S := hc.ax0a
  haveI : Infinite U := hU.infinite
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hA
  have hz : ∀ b ∈ Iic (0 : Ordinal.{u}), b = 0 := fun b hb => le_antisymm hb zero_le
  have hbad : ∀ {i : Ordinal.{u}}, i < 0 → False := fun h' => absurd h' (not_lt.2 zero_le)
  have hinc : ∀ X : Model U L, IsIncreasing s.S.le (fun _ : Ordinal.{u} => X) (Iic 0) :=
    fun X a ha b hb hl => absurd (lt_of_lt_of_le hl hb) (not_lt.2 zero_le)
  have hcont : ∀ X : Model U L, IsContinuous (fun _ : Ordinal.{u} => X) (Iic 0) := fun X b hb hl => by
    rw [hz b hb] at hl; exact absurd hl Order.not_isSuccLimit_bot
  exact ⟨hA, hA, hB, hB, 0, fun _ => A, fun _ => B, fun _ => Classical.arbitrary U,
    (Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))).bot_lt, hinc A, hcont A, hinc B,
    hcont B, ⟨hS.refl hA.1, h⟩, ⟨hS.refl hA.1, h⟩, ⟨h, hS.refl hB.1⟩, rfl, rfl, rfl, rfl,
    fun _ _ => h, fun _ h' => (hbad h').elim, fun _ h' => (hbad h').elim,
    fun _ h' => (hbad h').elim⟩

/-- AUX: not in paper. Claim 5.5.2, in the form used: it is enough to find `N_{b,ε}, f_ε`.
(Compared with the paper's proof: the bottom of the second chain is replaced by `M_{b,0}`, so that
Prop 5.4.4 applies, and the conclusion is read off by monotonicity; Prop 5.3.4 is not needed.) -/
theorem Frame.nf_claim [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord)
    (hpos : 0 < αs) {Ma Mb N : Ordinal.{u} → Model U L} {f : Ordinal.{u} → U → U}
    (ai : IsIncreasing s.S.le Ma (Iic αs)) (ac : IsContinuous Ma (Iic αs))
    (aK : ∀ ε ≤ αs, Ma ε ∈ s.S.Kc lam) (bi : IsIncreasing s.S.le Mb (Iic αs))
    (bc : IsContinuous Mb (Iic αs)) (bK : ∀ ε ≤ αs, Mb ε ∈ s.S.Kc lam)
    (hNFs : ∀ ε < αs, s.NF lam (Ma ε) (Ma (ε + 1)) (Mb ε) (Mb (ε + 1)))
    (h0 : s.S.le (Ma 0) (Mb 0)) (ni : IsIncreasing s.S.le N (Iic αs)) (nc : IsContinuous N (Iic αs))
    (nK : ∀ ε ≤ αs, N ε ∈ s.S.Kc lam) (hb0 : s.S.le (Mb 0) (N 0))
    (hE : ∀ ε ≤ αs, IsEmb s.S (f ε) (Ma ε) (N ε)) (h0f : ∀ x ∈ (Ma 0).carrier, f 0 x = x)
    (fi : FunIncreasing f Ma (Iic αs))
    (h6 : ∀ ε < αs, ∃ P Q, IsoOn (f ε) (Ma ε) P ∧ IsoOn (f (ε + 1)) (Ma (ε + 1)) Q ∧
      s.NF lam P Q (N ε) (N (ε + 1)))
    (h7 : ∃ Qt, IsoOn (f αs) (Ma αs) Qt ∧ s.NF lam (Ma 0) Qt (N 0) (N αs)) :
    s.NF lam (Ma 0) (Ma αs) (Mb 0) (Mb αs) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hab : ∀ ε ≤ αs, s.S.le (Ma ε) (Mb ε) := by
    intro ε hε
    rcases Ordinal.zero_or_succ_or_isSuccLimit ε with h' | ⟨c, hc'⟩ | hlim
    · rw [h']; exact h0
    · rw [Order.succ_eq_add_one] at hc'
      subst hc'
      obtain ⟨-, -, -, -, -, l13, -⟩ := hNFs c (lt_of_lt_of_le (Order.lt_add_one_iff.2 le_rfl) hε)
      exact l13
    · have hincI : IsIncreasing s.S.le Ma (Iio ε) := fun a ha b hb h' =>
        ai a ((le_of_lt ha).trans hε) b ((le_of_lt hb).trans hε) h'
      have hcontI : IsContinuous Ma (Iio ε) := fun b hb hl' => ac b ((le_of_lt hb).trans hε) hl'
      exact hS.smooth ε hlim _ (Mb ε) hincI hcontI
        (fun β hβ => hS.trans (hNFs β (lt_of_lt_of_le hβ hε)).2.2.2.2.2.2.1
          (bi β ((le_of_lt hβ).trans hε) ε hε hβ)) (Ma ε)
        ⟨ac ε hε hlim, fun β hβ => hS.incl _ _ (ai β ((le_of_lt hβ).trans hε) ε hε hβ)⟩
        (aK ε hε).1
  let N' : Ordinal.{u} → Model U L := fun ε => if ε = 0 then Mb 0 else N ε
  have hN'0 : N' 0 = Mb 0 := if_pos rfl
  have hN'n : ∀ ε, ε ≠ 0 → N' ε = N ε := fun ε h => if_neg h
  have hsucc : ∀ i : Ordinal.{u}, i + 1 ≠ 0 := fun i h =>
    absurd (h ▸ Order.lt_add_one_iff.2 (le_refl i)) (not_lt.2 zero_le)
  have hMbN : ∀ γ ≤ αs, γ ≠ 0 → s.S.le (Mb 0) (N γ) := fun γ hγ h0' =>
    hS.trans hb0 (ni 0 (Set.mem_Iic.2 zero_le) γ hγ (pos_iff_ne_zero.2 h0'))
  have ni' : IsIncreasing s.S.le N' (Iic αs) := by
    intro a ha b hb hl
    have hb0' : b ≠ 0 := fun h => absurd (h ▸ hl) (not_lt.2 zero_le)
    rw [hN'n b hb0']
    by_cases ha0 : a = 0
    · rw [ha0, hN'0]; exact hMbN b hb hb0'
    · rw [hN'n a ha0]; exact ni a ha b hb hl
  have nc' : IsContinuous N' (Iic αs) := by
    intro b hb hl
    have hb0' : b ≠ 0 := by
      rintro rfl; exact absurd hl Order.not_isSuccLimit_bot
    rw [hN'n b hb0', nc b hb hl]
    ext x
    simp only [Set.mem_iUnion₂, Set.mem_Iio, exists_prop]
    constructor
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · have h1b : (0 : Ordinal.{u}) + 1 < b := hl.add_one_lt (pos_iff_ne_zero.2 hb0')
        refine ⟨0 + 1, h1b, ?_⟩
        rw [hN'n _ (hsucc 0)]
        rw [hξ0] at hx
        exact hS.sub (ni 0 (Set.mem_Iic.2 zero_le) (0 + 1) ((le_of_lt h1b).trans hb)
          (Order.lt_add_one_iff.2 le_rfl)) hx
      · exact ⟨ξ, hξ, by rw [hN'n ξ hξ0]; exact hx⟩
    · rintro ⟨ξ, hξ, hx⟩
      by_cases hξ0 : ξ = 0
      · rw [hξ0, hN'0] at hx
        exact ⟨0, pos_iff_ne_zero.2 hb0', hS.sub hb0 hx⟩
      · exact ⟨ξ, hξ, by rw [hN'n ξ hξ0] at hx; exact hx⟩
  have nK' : ∀ ε ≤ αs, N' ε ∈ s.S.Kc lam := fun ε hε => by
    by_cases h : ε = 0
    · rw [h, hN'0]; exact bK 0 zero_le
    · rw [hN'n ε h]; exact nK ε hε
  have hf0iso : IsoOn (f 0) (Ma 0) (Ma 0) := (IsoOn.refl _).congr fun x hx => (h0f x hx).symm
  have hRb : ∀ α < αs, ∃ P Q, IsoOn (f α) (Ma α) P ∧ IsoOn (f (α + 1)) (Ma (α + 1)) Q ∧
      s.NF lam P Q (N' α) (N' (α + 1)) := by
    intro α hα
    obtain ⟨P, Q, hP, hQ, hR⟩ := h6 α hα
    refine ⟨P, Q, hP, hQ, ?_⟩
    rw [hN'n _ (hsucc α)]
    by_cases hα0 : α = 0
    · subst hα0
      rw [hN'0]
      have e : P = Ma 0 := hP.unique hf0iso
      obtain ⟨kP, kQ, -, kN, lPQ, lQN, -, lN, -⟩ := id hR
      have l0 : s.S.le P (Mb 0) := by rw [e]; exact h0
      have l1 : s.S.le (Mb 0) (N (0 + 1)) := hS.trans hb0 lN
      exact prop_5_3_9_4 lam hU s hs P kP Q kQ (N 0) (nK 0 zero_le) (N (0 + 1)) kN P kP Q kQ (Mb 0)
        (bK 0 zero_le) (N (0 + 1)) kN hR rfl ⟨hS.refl kP.1, hS.refl kP.1, hS.trans l0 l1⟩
        ⟨hS.refl kQ.1, lPQ, lQN⟩ ⟨hb0, l0, l1⟩ ⟨_, hS.refl kN.1, hS.refl kN.1⟩
    · rw [hN'n α hα0]; exact hR
  have hE' : ∀ ε ≤ αs, IsEmb s.S (f ε) (Ma ε) (N' ε) := fun ε hε => by
    by_cases h : ε = 0
    · rw [h, hN'0]
      exact ⟨(aK 0 zero_le).1, (bK 0 zero_le).1, Ma 0, h0, hf0iso⟩
    · rw [hN'n ε h]; exact hE ε hε
  obtain ⟨-, -, -, -, -, -, -, ga, gb, Mab, hga, hgb, e1, e2⟩ := prop_5_4_4 lam hU s hs (s.NF lam)
    (prop_5_4_8 lam hU s hs) αs hαs.le Ma Mb N' (fun α hα => ⟨aK α hα, bK α hα, nK' α hα⟩) ⟨ai, ac⟩
    ⟨bi, bc⟩ ⟨ni', nc'⟩ hN'0.symm (fun _ => id) f
    (fun α hα => ⟨IsEmb.of_le hS (hab α hα), hE' α hα⟩) (fun x hx => ⟨rfl, h0f x hx⟩)
    (fun _ _ _ _ _ _ _ => rfl) fi
    (fun α hα => ⟨Ma α, Ma (α + 1), IsoOn.refl _, IsoOn.refl _, hNFs α hα⟩) hRb
  rw [hN'n αs hpos.ne'] at hgb
  obtain ⟨-, -, Y, hY, hgaY⟩ := id hga
  obtain ⟨κ, hκ, hκg, -⟩ := hgaY.exists_inv
  obtain ⟨r, W, hr, hrκ, hMW, hWK, -⟩ := hS.rename hU.infinite (∅ : Set U) hY hκ (by
    rw [Set.empty_union]; change (Mb αs).card < #U; rw [(bK αs le_rfl).2]; exact hU.2)
  have hrg : ∀ x ∈ (Mb αs).carrier, r (ga x) = x := fun x hx => by
    rw [hrκ _ (hgaY.mapsTo hx), hκg x hx]
  obtain ⟨-, -, G₀, hG₀, hgbG⟩ := id hgb
  obtain ⟨G, hrG⟩ := exists_isoOn (hr.injOn.mono (hS.sub hG₀))
  have hG : IsoOn (r ∘ gb) (N αs) G := hgbG.comp hrG
  have hGW : s.S.le G W := hS.iso_le hG₀ hr hrG
  have hgb' : ∀ x ∈ (Mb 0).carrier, (r ∘ gb) x = x := fun x hx => by
    show r (gb x) = x
    have e : gb x = ga x := e2 x hx
    rw [e]
    exact hrg x (hS.sub (bi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos) hx)
  obtain ⟨Qt, hQt, hNF7⟩ := h7
  obtain ⟨κ₂, hκ₂, hκ₂f, hfκ₂⟩ := hQt.exists_inv
  have hsNα : ∀ ε ≤ αs, (N ε).carrier ⊆ (N αs).carrier := fun ε hε => by
    rcases hε.lt_or_eq with h | h
    · exact hS.sub (ni ε hε αs (Set.mem_Iic.2 le_rfl) h)
    · rw [h]
  obtain ⟨-, -, -, -, l0Q, lQN, l0N, -, -⟩ := id hNF7
  have hQt_sub := hS.sub lQN
  have hQtM : IsoOn (r ∘ gb) Qt (Ma αs) := hκ₂.congr fun z hz => by
    have hy := hκ₂.mapsTo hz
    have h3 := e1 (κ₂ z) hy
    have h4 : ga (κ₂ z) = gb (f αs (κ₂ z)) := h3.symm
    show κ₂ z = r (gb z)
    rw [hfκ₂ z hz] at h4
    rw [← h4]
    exact (hrg _ (hS.sub (hab αs le_rfl) hy)).symm
  have hab0 : (Ma 0).carrier ⊆ (Mb 0).carrier := hS.sub h0
  have hfixMa : IsoOn (r ∘ gb) (Ma 0) (Ma 0) :=
    (IsoOn.refl _).congr fun x hx => (hgb' x (hab0 hx)).symm
  obtain ⟨N₀', hN₀'⟩ := exists_isoOn (hG.injOn.mono (hsNα 0 zero_le))
  have hNF' := (prop_5_3_3 lam hU s hs (Ma 0) Qt (N 0) (N αs) (Ma 0) (Ma αs) N₀' G (r ∘ gb) hG
    hfixMa hQtM hN₀').2 hNF7
  have hfixb : IsoOn (r ∘ gb) (Mb 0) (Mb 0) := (IsoOn.refl _).congr fun x hx => (hgb' x hx).symm
  have hMbN₀ : s.S.le (Mb 0) N₀' := hS.iso_le hb0 hN₀' hfixb
  have hN₀c : N₀' ∈ s.S.Kc lam := ⟨hS.iso_mem (nK 0 zero_le).1 hN₀', by
    rw [hN₀'.card_eq]; exact (nK 0 zero_le).2⟩
  have hGc : G ∈ s.S.Kc lam := ⟨hS.iso_mem (nK αs le_rfl).1 hG, by
    rw [hG.card_eq]; exact (nK αs le_rfl).2⟩
  have hab1 := hab αs le_rfl
  have hbα := bi 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos
  have haα := ai 0 (Set.mem_Iic.2 zero_le) αs (Set.mem_Iic.2 le_rfl) hpos
  exact prop_5_3_9_4 lam hU s hs (Ma 0) (aK 0 zero_le) (Ma αs) (aK αs le_rfl) N₀' hN₀c G hGc (Ma 0)
    (aK 0 zero_le) (Ma αs) (aK αs le_rfl) (Mb 0) (bK 0 zero_le) (Mb αs) (bK αs le_rfl) hNF' rfl
    ⟨hS.refl (aK 0 zero_le).1, hS.refl (aK 0 zero_le).1, hS.trans h0 hbα⟩
    ⟨hS.refl (aK αs le_rfl).1, haα, hab1⟩ ⟨hMbN₀, h0, hbα⟩ ⟨W, hGW, hMW⟩

/-- AUX: not in paper. Case b of Thm 5.5.1 (for chains that need not be strictly increasing). -/
theorem Frame.nf_caseb [C : CitedResults.{u}] {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {αs : Ordinal.{u}} (hαs : αs < (Order.succ lam).ord)
    {X Y : Ordinal.{u} → Model U L} (xi : IsIncreasing s.S.le X (Iic αs))
    (xc : IsContinuous X (Iic αs)) (xK : ∀ ε ≤ αs, X ε ∈ s.S.Kc lam)
    (yi : IsIncreasing s.S.le Y (Iic αs)) (yc : IsContinuous Y (Iic αs))
    (yK : ∀ ε ≤ αs, Y ε ∈ s.S.Kc lam)
    (hNF : ∀ ε < αs, s.NF lam (X ε) (X (ε + 1)) (Y ε) (Y (ε + 1)))
    (h0 : s.S.le (X 0) (Y 0))
    (hdec : ∀ ε < αs, Decomposable s.S lam (s.K3uq lam) (X ε) (X (ε + 1))) :
    s.NF lam (X 0) (X αs) (Y 0) (Y αs) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (xK 0 zero_le)
  rcases (zero_le : (0 : Ordinal.{u}) ≤ αs).lt_or_eq with hpos | h'
  swap
  · rw [← h']; exact Frame.nfstar_nf hc (Frame.nfstar_zero hU hc (xK 0 zero_le) (yK 0 zero_le) h0)
  have hiso := Frame.K3uq_isoClosed hU hc
  obtain ⟨c, c1, c2, c3, c4, c5, c6, c7, c8⟩ := hS.chain_build hU hinf hαs
    (M := X) ⟨xi, xc, fun ε h => xK ε h⟩ (X := Y 0) (yK 0 zero_le) h0
    (fun _ P Q N N' => s.NFStar lam P Q N N') (fun ε hε g P Q N hgP hgQ hPQ hN hPN hd => by
      obtain ⟨-, β, D, e, hdd⟩ := hdec ε hε
      have hK1 := xK (ε + 1) (Order.add_one_le_iff.2 hε)
      have hQc : Q ∈ s.S.Kc lam := ⟨hS.iso_mem hK1.1 hgQ, by rw [hgQ.card_eq]; exact hK1.2⟩
      have hPc : P ∈ s.S.Kc lam := ⟨hS.mem_left hPQ, by rw [hgP.card_eq]; exact (xK ε hε.le).2⟩
      obtain ⟨N', hN', hNF'⟩ := Frame.thm_5_3_7_b hU hs hPc hQc hN hPN hd
        (decomp_iso hS hiso hdd hgQ hgP hK1)
      obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, ⟨-, hQN⟩, ⟨-, hNN⟩, -⟩ := id hNF'
