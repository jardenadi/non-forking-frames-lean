/-- AUX: not in paper. The first two sequences of a witness for `≺⁺` are filtrations. -/
theorem Frame.PlusWit.filt {s : Frame U L} {lam : Cardinal.{u}} {M₀ M₁ : Model U L}
    {A B C : Ordinal.{u} → Model U L} {E : Set Ordinal.{u}} (hw : s.PlusWit lam M₀ M₁ A B C E) :
    IsFilt s.S lam M₀ A ∧ IsFilt s.S lam M₁ B := by
  obtain ⟨⟨a1, a2, a3⟩, ⟨b1, b2, b3⟩, -, -, -, h0, h1, -⟩ := hw
