/-- AUX: not in paper. In a witness for `≺⁺`, each basic type over `N_{1,α}` (`α ∈ E`) is realized
in `N^⊕_{1,β}` by an element outside `N_{1,β}`, for arbitrarily large `β ∈ E`. -/
theorem Frame.PlusWit.real {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam)
    {M₀ M₁ : Model U L} {A B C : Ordinal.{u} → Model U L} {E : Set Ordinal.{u}}
    (hw : s.PlusWit lam M₀ M₁ A B C E) {α ξ : Ordinal.{u}} (hα : α ∈ E)
    (hξ : ξ < (Order.succ lam).ord) {p : Set (Tri U L)} (hp : p ∈ s.Sbs (B α)) :
    ∃ β ∈ E, ξ < β ∧ ∃ a ∈ (C β).carrier, a ∉ (B β).carrier ∧ (α < β → tp s.S lam a (B α) (C β) = p) := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨hA, hB, hCi, hCK, hE, h0, h1, hb, hcc, hd⟩ := id hw
  obtain ⟨γ, hγ, H⟩ := hd α hα p hp
  have hκ : max (max γ ξ) α < (Order.succ lam).ord := max_lt (max_lt hγ hξ) (hE.1 hα)
  obtain ⟨β, hβ, hlt⟩ := hE.2.1 _ hκ
  have l1 : max γ ξ < β := (le_max_left _ _).trans_lt hlt
  have hαβ : α < β := (le_max_right _ _).trans_lt hlt
  obtain ⟨q, hq, ⟨-, hres⟩, a, ha, hat⟩ := H β hβ (((le_max_left _ _).trans_lt l1).le)
  have kB : B β ∈ s.S.Kc lam := hB.2.2 β (hE.1 hβ)
  obtain ⟨N, b, -, -, hb', hEq⟩ := hc.ax2a _ kB hq
  refine ⟨β, hβ, (le_max_right _ _).trans_lt l1, a, ha, fun hab => ?_, fun _ => ?_⟩
  · have e : b = a := (ERel.alg (tp_eq_iff.1 (hat.trans hEq))).1 hab
    exact hb'.2 (e ▸ hab)
  · rw [← hres, ← hat, res_tp hS (hB.1 α (hE.1 hα) β (hE.1 hβ) hαβ)]

/-- AUX: not in paper. In a witness for `≺⁺`, `N^⊕_{1,β} ≼ N_{1,δ}` for `β < δ` in `E`. -/
theorem Frame.PlusWit.le_next {s : Frame U L} {lam : Cardinal.{u}} {M₀ M₁ : Model U L}
    {A B C : Ordinal.{u} → Model U L} {E : Set Ordinal.{u}}
    (hw : s.PlusWit lam M₀ M₁ A B C E) {β δ : Ordinal.{u}} (hβ : β ∈ E) (hδ : δ ∈ E) (h : β < δ) :
    s.S.le (C β) (B δ) := by
  obtain ⟨-, -, -, -, -, -, -, -, hcc, -⟩ := hw
  exact (hcc β hβ δ hδ h).2.2.2.2.2.1

/-- Prop 7.1.10(a): `M₀ ≺⁺ M₁ → M₀ ≺^NF M₁`. -/
theorem prop_7_1_10_a [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (M₀ M₁ : Model U L) (h : s.ltPlus lam M₀ M₁) : s.ltNF lam M₀ M₁ := by
  classical
  have hs' : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h₀, h₁, A, B, C, E, hw⟩ := h
  obtain ⟨hAf, hBf⟩ := hw.filt
  obtain ⟨hA, hB, hCi, hCK, hE, h0, h1, hb, hcc, hd⟩ := id hw
  have hκ0 : (0 : Ordinal.{u}) < (Order.succ lam).ord :=
    Cardinal.lt_ord.2 (by rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam))
  obtain ⟨α₀, hα₀, -⟩ := hE.2.1 0 hκ0
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (hA.2.2 α₀ (hE.1 hα₀))
  have hNF : ∀ ε ∈ E, ∀ ζ ∈ E, ε < ζ → ζ < (Order.succ lam).ord →
      s.NF lam (A ε) (A ζ) (B ε) (B ζ) := by
    intro ε hε ζ hζ hlt _
    have n := Frame.nf_symm hU hs' (hcc ε hε ζ hζ hlt)
    exact Frame.nf_mid hU hs' n (hB.2.2 ε (hE.1 hε)) (hb ε hε).1 (hb ε hε).2
  obtain ⟨ε₀, -, hε₀, hnf⟩ := Frame.nfhat_of_club_filt hU hs hinf h₀ h₁ (ClubL.of_isClub hE) hAf hBf hNF
  refine ⟨⟨h₀, h₁, Frame.nfhat_le hs hinf hnf, _, hAf.2.2.1 ε₀ hε₀, _, hBf.2.2.1 ε₀ hε₀, hnf⟩, ?_⟩
  intro heq
  have kB := hB.2.2 α₀ (hE.1 hα₀)
  obtain ⟨X, hX, hlt⟩ := Frame.exists_strict hc kB
  obtain ⟨x, -, hbs⟩ := hc.ax2c _ kB X hX hlt
  obtain ⟨β, hβ, -, a, ha, hna, -⟩ := hw.real hc hα₀ (hE.1 hα₀) hbs
  obtain ⟨δ, hδ, hβδ⟩ := hE.2.1 β (hE.1 hβ)
  have haM₁ : a ∈ M₁.carrier := by
    rw [h1.1]
    exact mem_biUnion (hE.1 hδ) (hS.sub (hw.le_next hβ hδ hβδ) ha)
  rw [← heq, h0.1] at haM₁
  simp only [mem_iUnion, exists_prop] at haM₁
  obtain ⟨ζ, hζ, haζ⟩ := haM₁
  obtain ⟨δ', hδ', hlt'⟩ := hE.2.1 (max ζ β) (max_lt hζ (hE.1 hβ))
  have hζδ : ζ < δ' := (le_max_left _ _).trans_lt hlt'
  have hβδ' : β < δ' := (le_max_right _ _).trans_lt hlt'
  have haδ : a ∈ (A δ').carrier := hS.sub (hA.1 ζ hζ δ' (hE.1 hδ') hζδ) haζ
  have hd' := (prop_5_3_6 lam hU s hs' _ _ _ _).2 (hcc β hβ δ' hδ' hβδ')
  have : a ∈ (A β).carrier := hd' ▸ (⟨ha, haδ⟩ : a ∈ (C β).carrier ∩ (A δ').carrier)
  exact hna (hS.sub (hb β hβ).1 this)

/-- Prop 7.1.10(b): `M₀ ≺⁺ M₁ → M₁ ∈ K^sat`. -/
theorem prop_7_1_10_b (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (M₀ M₁ : Model U L) (h : s.ltPlus lam M₀ M₁) : M₁ ∈ s.Ksat lam := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, h₁, A, B, C, E, hw⟩ := h
  obtain ⟨-, hBf⟩ := hw.filt
  obtain ⟨hA, hB, -, -, hE, -, h1, -, -, -⟩ := id hw
  set κ := (Order.succ lam).ord with hκdef
  have hκ0 : (0 : Ordinal.{u}) < κ :=
    Cardinal.lt_ord.2 (by rw [Ordinal.card_zero]; exact zero_le.trans_lt (Order.lt_succ lam))
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc (hB.2.2 0 hκ0)
  let M' : Ordinal.{u} → Model U L := fun α => if α < κ then B α else M₁
  have e1 : ∀ α, α < κ → M' α = B α := fun α h => if_pos h
  have e2 : M' κ = M₁ := if_neg (lt_irrefl _)
  have hinc : IsIncreasing s.S.le M' (Iic κ) := by
    intro α hα β hβ hlt
    have hακ : α < κ := hlt.trans_le hβ
    rw [e1 α hακ]
    rcases (show β ≤ κ from hβ).lt_or_eq with h | h
    · rw [e1 β h]; exact hB.1 α hακ β h hlt
    · rw [h, e2]; exact hBf.le hS hinf hακ
  have hcont : IsContinuous M' (Iic κ) := by
    intro β hβ hl
    have hu : ∀ α ∈ Iio β, (M' α).carrier = (B α).carrier := fun α hα => by
      rw [e1 α (lt_of_lt_of_le hα hβ)]
    rw [Set.iUnion₂_congr hu]
    rcases (show β ≤ κ from hβ).lt_or_eq with h | h
    · rw [e1 β h]; exact hB.2.1 β h hl
    · subst h; rw [e2]; exact h1.1
  have hreal : ∀ α < κ, ∀ p ∈ s.Sbs (M' α), ∃ β, α < β ∧ β < κ ∧ Realizes s.S lam (M' β) (M' α) p := by
    intro α hα p hp
    rw [e1 α hα] at hp ⊢
    obtain ⟨α', hα'E, hαα'⟩ := hE.2.1 α hα
    have hα'κ := hE.1 hα'E
    have kα := hB.2.2 α hα
    have kα' := hB.2.2 α' hα'κ
    have lαα' := hB.1 α hα α' hα'κ hαα'
    obtain ⟨p', hp', hres⟩ : ∃ p' ∈ s.Sbs (B α'), res s.S lam p' (B α) = p := by
      by_cases heq : B α = B α'
      · refine ⟨p, heq ▸ hp, ?_⟩
        obtain ⟨N, b, hlt, kN, -, rfl⟩ := hc.ax2a _ kα hp
        exact res_tp hS (hS.refl kα.1)
      · obtain ⟨q, hq, -, hr⟩ := hc.ax3f _ kα _ kα' p hp ⟨lαα', heq⟩
        exact ⟨q, hq, hr⟩
    obtain ⟨β, hβ, hξ, a, ha, -, H⟩ := hw.real hc hα'E hα'κ hp'
    obtain ⟨δ, hδ, hβδ⟩ := hE.2.1 β (hE.1 hβ)
    have hδκ := hE.1 hδ
    have lCB := hw.le_next hβ hδ hβδ
    have kδ := hB.2.2 δ hδκ
    have hαδ : α < δ := (hαα'.trans hξ).trans hβδ
    refine ⟨δ, hαδ, hδκ, ?_⟩
    rw [e1 δ hδκ]
    refine ⟨a, hS.sub lCB ha, ?_⟩
    have t1 := H hξ
    have lαβ : s.S.le (B α') (C β) := hS.trans (hB.1 α' hα'κ β (hE.1 hβ) hξ) (by
      obtain ⟨-, -, -, -, -, -, -, b, -⟩ := id hw
      exact (b β hβ).2)
    have hK : (B α', B δ, a) ∈ s.S.K3 := by
      exact ⟨kα'.1 , kδ.1, hS.trans lαβ lCB, hS.sub lCB ha⟩
    rw [← hres, ← t1, tp_eq_of_le hS hK lCB lαβ ha, res_tp hS lαα']
  have := (thm_2_5_8_2 lam hU s ⟨hc.ax1a, hc.ax1b, hc.ax1c, hc.ax2a, hc.ax2b, hc.ax2c, hs.1.2.2.2.1⟩
    ⟨hc.ax0a, hc.ax0b⟩ M' ⟨hinc, hcont, fun α hα => by rw [e1 α hα]; exact hB.2.2 α hα⟩ hreal).2
  rw [e2] at this
  exact this

/-- Prop 7.1.10(c): `M₀ ≼^NF M₁ ≺⁺ M₂ → M₀ ≺⁺ M₂`. -/
theorem prop_7_1_10_c [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (M₀ M₁ M₂ : Model U L) (h₁ : s.leNF lam M₀ M₁)
    (h₂ : s.ltPlus lam M₁ M₂) : s.ltPlus lam M₀ M₂ := by
  classical
  have hs' : Hyp_5_1_1 s lam := hs
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨-, k2, A, B, C, E, hw⟩ := h₂
  obtain ⟨hAf, hBf⟩ := hw.filt
  obtain ⟨hA, hB, hCi, hCK, hE, h0, h1, hb, hcc, hd⟩ := id hw
  obtain ⟨k0, k1, l01, W, hW, -⟩ := id h₁
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hW
  obtain ⟨R, hR⟩ := hS.exists_filt hc.ax0b hinf k0
  obtain ⟨E', hE', hN⟩ := (Frame.leNF_iff_club hU hs hinf k0 k1 l01 hR hAf).1 h₁
  have hI := ((ClubL.inter hinf (ClubL.of_isClub hE) (ClubL.of_isClub hE')).isClub_inter)
  refine ⟨k0, k2, R, B, C, _, ⟨hR.1, hR.2.1, fun α hα => hR.2.2.1 α hα⟩, hB, hCi, hCK, hI, hR.2.2.2,
    h1, ?_, ?_, ?_⟩
  · rintro α ⟨⟨-, hαE, hαE'⟩, hακ⟩
    obtain ⟨ζ, hζ, hlt⟩ := hE'.2.1 α hακ
    exact ⟨hS.trans (hN α hαE' ζ hζ hlt).2.2.2.2.2.2.1 (hb α hαE).1, (hb α hαE).2⟩
  · rintro α ⟨⟨-, hαE, hαE'⟩, -⟩ β ⟨⟨-, hβE, hβE'⟩, -⟩ hlt
    exact Frame.nf_symm hU hs' (Frame.nf_trans2 hU hs' (hN α hαE' β hβE' hlt)
      (Frame.nf_symm hU hs' (hcc α hαE β hβE hlt)))
  · rintro α ⟨⟨-, hαE, -⟩, -⟩ p hp
    obtain ⟨γ, hγ, H⟩ := hd α hαE p hp
    exact ⟨γ, hγ, fun β hβ => H β hβ.1.2.1⟩

/-- Prop 7.1.10(d): `M₀ ≺⁺ M₁ ≺⁺ M₂ → M₀ ≺⁺ M₂`. -/
theorem prop_7_1_10_d [C : CitedResults.{u}] (lam : Cardinal.{u}) (hU : Room U lam) (s : Frame U L)
    (hs : Hyp_7_1_1 s lam) (M₀ M₁ M₂ : Model U L) (h₁ : s.ltPlus lam M₀ M₁)
    (h₂ : s.ltPlus lam M₁ M₂) : s.ltPlus lam M₀ M₂ :=
  prop_7_1_10_c lam hU s hs M₀ M₁ M₂ (prop_7_1_10_a lam hU s hs M₀ M₁ h₁).1 h₂

/-- Def 7.1.11: a strategy for player 1 in the `≺⁺_{λ⁺}`-game: it assigns `N_{1,α+1}` to
`(α, ⟨N_{0,β} : β ≤ α+1⟩, ⟨N_{1,β} : β ≤ α⟩)`. -/
abbrev PlusStrategy (U : Type u) (L : Language.{u, u}) :=
  (α : Ordinal.{u}) → (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L

-- AGENT-CHOICE (reading): the game is encoded by its plays. A play in which player 1 follows `F`
-- must also respect player 1's rules (an illegal answer counts as a loss), and the paper's
-- "player 2 wins" (a typo: there are players 0 and 1) is read as "player 1 wins".
-- PROOF-STAGE CHANGE (author-approved): plays may be partial (length `γ`), and player 0 must move
-- strictly, `N_{0,α} ≺ N_{0,α+1}`. The paper has `N_{0,α} ≼ N_{0,α+1}`; see `Frame.Winning` and
-- docs/ERRATA.md.
/-- Def 7.1.11: `⟨N_{0,α}⟩, ⟨N_{1,α}⟩` (`α < γ`) is a (possibly partial, `γ ≤ λ⁺`) play of the
`≺⁺_{λ⁺}`-game in which player 1 uses `F` and player 0 obeys the rules: move 0: `N_{0,0} ≼ N_{1,0}`
in `K_λ`; limit `α`: unions; move `α+1`: `N_{0,α} ≺ N_{0,α+1} ∈ K_λ`,
`N_{0,α+1} ∩ N_{1,α} = N_{0,α}`, and `N_{1,α+1} = F(α, ⟨N_{0,β} : β ≤ α+1⟩, ⟨N_{1,β} : β ≤ α⟩)`.

Original text of the paper, move `α+1`: "Player 0 chooses a model `N_{0,α+1}` such that
(1) `N_{0,α} ≼ N_{0,α+1}`, (2) `N_{0,α+1} ∩ N_{1,α} = N_{0,α}`." -/
def Frame.IsPlay (s : Frame U L) (lam : Cardinal.{u}) (F : PlusStrategy U L) (γ : Ordinal.{u})
    (A B : Ordinal.{u} → Model U L) : Prop :=
  (0 < γ → A 0 ∈ s.S.Kc lam ∧ B 0 ∈ s.S.Kc lam ∧ s.S.le (A 0) (B 0)) ∧
  (∀ α < γ, Order.IsSuccLimit α →
    IsUnionOf A (Iio α) (A α) ∧ IsUnionOf B (Iio α) (B α)) ∧
  ∀ α, α + 1 < γ → A (α + 1) ∈ s.S.Kc lam ∧ s.S.lt (A α) (A (α + 1)) ∧
    (A (α + 1)).carrier ∩ (B α).carrier = (A α).carrier ∧
    B (α + 1) = F α (fun i => A i) (fun i => B i)

-- PROOF-STAGE CHANGE (author-approved): (1) legality of player 1 is required at every stage of
-- every partial play, so a strategy cannot win because no complete play exists; (2) the winning
-- condition applies only when `⋃ N_{0,α} ∈ K_{λ⁺}`. See docs/ERRATA.md.
/-- Def 7.1.11: `F` is a winning strategy for player 1: (1) in every partial play by `F` reaching
move `α+1`, player 1's move is legal (`N_{1,α} ≼ N_{1,α+1}`,
`NF(N_{0,α}, N_{1,α}, N_{0,α+1}, N_{1,α+1})`); (2) in every play of length `λ⁺` by `F`, if
`⋃ N_{0,α} ∈ K_{λ⁺}` then `⋃ N_{0,α} ≺⁺_{λ⁺} ⋃ N_{1,α}`.

Original text of the paper: "At the end of the game, player 2 wins the game if
`⋃ {N_{0,α} : α < λ⁺} ≺⁺_{λ⁺} ⋃ {N_{1,α} : α < λ⁺}`"; "A winning strategy for player 1 is a
strategy for player 1, such that if player 1 acts by it, then he wins the game, no matter what
player 0 does." -/
def Frame.Winning (s : Frame U L) (lam : Cardinal.{u}) (F : PlusStrategy U L) : Prop :=
  (∀ α < (Order.succ lam).ord, ∀ A B, s.IsPlay lam F (α + 1 + 1) A B →
    B (α + 1) ∈ s.S.Kc lam ∧ s.S.le (B α) (B (α + 1)) ∧
      s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1))) ∧
  ∀ A B, s.IsPlay lam F (Order.succ lam).ord A B →
    ∀ M₀, IsUnionOf A (Iio (Order.succ lam).ord) M₀ → M₀ ∈ s.S.Kc (Order.succ lam) →
      ∃ M₁, IsUnionOf B (Iio (Order.succ lam).ord) M₁ ∧ s.ltPlus lam M₀ M₁

/-- AUX: not in paper. A model of `K_λ` has an extension in `K_λ` realizing a given family of at
most `λ` basic types. -/
theorem Frame.realize_many {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hc : s.Core lam)
    {M : Model U L} (hM : M ∈ s.S.Kc lam) {θ : Ordinal.{u}} (hθ : θ < (Order.succ lam).ord)
    (T : Ordinal.{u} → Set (Tri U L)) :
    ∃ C ∈ s.S.Kc lam, s.S.le M C ∧ ∀ ε < θ, T ε ∈ s.Sbs M → Realizes s.S lam C M (T ε) := by
  classical
  have hS : IsAEC s.S := hc.ax0a
  have hinf : ℵ₀ ≤ lam := Frame.aleph0_le hc hM
  let X : Ordinal.{u} → Model U L := fun _ => M
  have hX : IsIncCont s.S X (Iic θ) (s.S.Kc lam) := by
    refine ⟨fun _ _ _ _ _ => hS.refl hM.1, fun β _ hl => ?_, fun _ _ => hM⟩
    ext x
    simp only [mem_iUnion, exists_prop, X]
    exact ⟨fun hx => ⟨0, hl.bot_lt, hx⟩, fun ⟨_, _, hx⟩ => hx⟩
  let Step : Ordinal.{u} → QRel U L := fun ε P _ _ N' => P = M → T ε ∈ s.Sbs M →
    Realizes s.S lam N' M (T ε)
  obtain ⟨c, c1, c2, c3, c4, -, -, c7, c8⟩ := hS.chain_build hU hinf hθ hX hM (hS.refl hM.1) Step (by
    intro ε _ g P Q N hP hQ _ hN hPN _
    have hPQ : P = Q := hP.unique hQ
    subst hPQ
    by_cases h : P = M ∧ T ε ∈ s.Sbs M
    · obtain ⟨rfl, hT⟩ := h
      obtain ⟨W, b, hlt, kW, hb, hEq⟩ := hc.ax2a _ hM hT
      obtain ⟨k, N₅, k5, l5, hk, hkid⟩ := hS.amalg_along hU hc.ax1b hM kW hN hlt.1
        (IsEmb.of_le hS hPN)
      refine ⟨N₅, k5, l5, hS.trans hPN l5, fun _ _ => ⟨k b, ?_, ?_⟩⟩
      · obtain ⟨-, -, R, hR, hkR⟩ := hk
        exact hS.sub hR (hkR.mapsTo hb.1)
      · rw [hEq]
        exact (tp_emb hS ⟨hM.1, kW.1, hlt.1, hb.1⟩ (hS.trans hPN l5) hk
          (fun x hx => by rw [hkid x hx]; rfl)).symm
    · refine ⟨N, hN, hS.refl hN.1, hPN, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩)
  have hfix : ∀ ε ≤ θ, ∀ x ∈ M.carrier, (c ε).2 x = x := by
    intro ε hε x hx
    rcases (zero_le : (0 : Ordinal.{u}) ≤ ε).lt_or_eq with h | h
    · exact (c7 0 (mem_Iic.2 zero_le) ε (mem_Iic.2 hε) h x hx).trans (c3 x hx)
    · rw [← h]; exact c3 x hx
  have hle : ∀ ε ≤ θ, s.S.le M (c ε).1 := by
    intro ε hε
    rcases (zero_le : (0 : Ordinal.{u}) ≤ ε).lt_or_eq with h | h
    · have := c4 0 (mem_Iic.2 zero_le) ε (mem_Iic.2 hε) h
      simp only [c2] at this
      exact this
    · rw [← h, c2]; exact hS.refl hM.1
  refine ⟨(c θ).1, c1 θ le_rfl, hle θ le_rfl, fun ε hε hT => ?_⟩
  have hε1 : ε + 1 ≤ θ := Order.add_one_le_of_lt hε
  obtain ⟨P, Q, hP, -, hSt⟩ := c8 ε hε1
  have hPM : P = M := hP.unique ((IsoOn.refl M).congr fun x hx => (hfix ε hε.le x hx).symm)
  obtain ⟨a, ha, hat⟩ := hSt hPM hT
  rcases hε1.lt_or_eq with h | h
  · have l := c4 (ε + 1) (mem_Iic.2 hε1) θ (mem_Iic.2 le_rfl) h
    refine ⟨a, hS.sub l ha, ?_⟩
    have hK : (M, (c θ).1, a) ∈ s.S.K3 := ⟨hM.1, (c1 θ le_rfl).1, hle θ le_rfl, hS.sub l ha⟩
    rw [← hat]
    exact (tp_eq_of_le hS hK l (hle _ hε1) ha).symm
  · rw [← h]; exact ⟨a, ha, hat⟩

/-- AUX: not in paper. The corrected successor step of the strategy of Prop 7.1.12(c). -/
theorem Frame.plus_step [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) {A A' B : Model U L} {D : Set U} (kA : A ∈ s.S.Kc lam)
    (kA' : A' ∈ s.S.Kc lam) (kB : B ∈ s.S.Kc lam) (hAA' : s.S.le A A') (hAB : s.S.le A B)
    (hD : #D < #U) (hA'D : A'.carrier ⊆ D) (hDB : D ∩ B.carrier = A.carrier)
    {θ : Ordinal.{u}} (hθ : θ < (Order.succ lam).ord) (T : Ordinal.{u} → Set (Tri U L)) :
    ∃ C B' : Model U L, C ∈ s.S.Kc lam ∧ s.S.le B C ∧
      (∀ ε < θ, T ε ∈ s.Sbs B → Realizes s.S lam C B (T ε)) ∧ B' ∈ s.S.Kc lam ∧
      s.NF lam A C A' B' ∧ C.carrier ∩ D = A.carrier ∧ B'.carrier ∩ D = A'.carrier := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨C₀, kC₀, lBC₀, hreal⟩ := Frame.realize_many hU hc kB hθ T
  have hsm : ∀ {X : Model U L}, X ∈ s.S.Kc lam → #X.carrier < #U := fun {X} hX => by
    have : #X.carrier = lam := hX.2
    rw [this]; exact hU.2
  have hsmall : #(D ∪ B.carrier : Set U) < #U :=
    lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hD (hsm kB))
  obtain ⟨h, C, hC, hid, lBC, memC, hout⟩ := hS.rename hU.infinite D lBC₀ (IsoOn.refl B) hsmall
  have kC : C ∈ s.S.Kc lam := ⟨memC, by rw [hC.card_eq]; exact kC₀.2⟩
  have hidB : ∀ x ∈ B.carrier, h x = x := fun x hx => hid x hx
  have hCD : C.carrier ∩ D = A.carrier := by
    ext x
    constructor
    · rintro ⟨hx, hxD⟩
      rw [hC.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_cases hyB : y ∈ B.carrier
      · rw [hidB y hyB] at hxD ⊢
        exact hDB ▸ (⟨hxD, hyB⟩ : y ∈ D ∩ B.carrier)
      · exact absurd (Or.inl hxD) (hout y ⟨hy, hyB⟩)
    · intro hx
      have hxB := hS.sub hAB hx
      exact ⟨hS.sub lBC hxB, (hDB ▸ hx : x ∈ D ∩ B.carrier).1⟩
  have hAC : s.S.le A C := hS.trans hAB lBC
  have hdisj : C.carrier ∩ A'.carrier = A.carrier := by
    ext x
    exact ⟨fun hx => hCD ▸ (⟨hx.1, hA'D hx.2⟩ : x ∈ C.carrier ∩ D),
      fun hx => ⟨hS.sub hAC hx, hS.sub hAA' hx⟩⟩
  obtain ⟨B₀, kB₀, hNF⟩ := Frame.thm_5_3_7_a hU hs kA kC kA' hAC hAA' hdisj
  have hsmall2 : #(D ∪ id '' (C.carrier ∪ A'.carrier) : Set U) < #U := by
    rw [Set.image_id]
    exact lt_of_le_of_lt (Cardinal.mk_union_le _ _) (Cardinal.add_lt_of_lt hU.aleph0_le hD
      (hU.small_union (le_of_eq kC.2) (le_of_eq kA'.2)))
  obtain ⟨f, hinj, hfid, hfout⟩ := exists_rename hU.infinite (X := B₀.carrier) id (Set.injOn_id _)
    hsmall2
  have hfix : ∀ x ∈ C.carrier ∪ A'.carrier, f x = x := fun x hx => hfid x hx
  obtain ⟨B', hB'⟩ := exists_isoOn hinj
  have fixI : ∀ {X : Model U L}, X.carrier ⊆ C.carrier ∪ A'.carrier → IsoOn f X X := fun hX =>
    (IsoOn.refl _).congr fun x hx => (hfix x (hX hx)).symm
  have hNF' : s.NF lam A C A' B' := Frame.nf_iso hU hc hNF hB'
    (fixI fun x hx => Or.inl (hS.sub hAC hx)) (fixI fun x hx => Or.inl hx)
    (fixI fun x hx => Or.inr hx)
  refine ⟨C, B', kC, lBC, fun ε hε hT => ?_, hNF'.2.2.2.1, hNF', hCD, ?_⟩
  · obtain ⟨a, ha, hat⟩ := hreal ε hε hT
    have hemb : IsEmb s.S h C₀ C := ⟨kC₀.1, kC.1, C, hS.refl kC.1, hC⟩
    refine ⟨h a, hC.mapsTo ha, ?_⟩
    rw [← hat]
    exact (tp_emb hS ⟨kB.1, kC₀.1, lBC₀, ha⟩ lBC hemb hidB).symm
  · obtain ⟨-, -, -, -, -, -, -, l2, -⟩ := id hNF'
    ext x
    constructor
    · rintro ⟨hx, hxD⟩
      rw [hB'.carrier_eq] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      by_cases hyD : y ∈ C.carrier ∪ A'.carrier
      · rw [hfix y hyD] at hxD ⊢
        rcases hyD with h' | h'
        · exact hS.sub hAA' (hCD ▸ (⟨h', hxD⟩ : y ∈ C.carrier ∩ D))
        · exact h'
      · exact absurd (Or.inl hxD) (hfout y ⟨hy, hyD⟩)
    · intro hx
      exact ⟨hS.sub l2 hx, hA'D hx⟩

/-- AUX: not in paper. A pairing of `λ⁺` with itself. -/
theorem exists_pair_ord {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam) :
    ∃ pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}, ∀ γ < (Order.succ lam).ord,
      ∀ i < (Order.succ lam).ord, ∃ ε < (Order.succ lam).ord, pr ε = (γ, i) := by
  classical
  have hm : ℵ₀ ≤ #(Iio (Order.succ lam).ord : Set Ordinal.{u}) := by
    rw [Cardinal.mk_Iio_ordinal, Cardinal.card_ord]
    exact Cardinal.aleph0_le_lift.2 (hinf.trans (Order.le_succ lam))
  obtain ⟨e⟩ := Cardinal.eq.1 (show #(Iio (Order.succ lam).ord : Set Ordinal.{u}) =
    #((Iio (Order.succ lam).ord : Set Ordinal.{u}) × (Iio (Order.succ lam).ord : Set Ordinal.{u})) by
    rw [← Cardinal.mul_def, Cardinal.mul_eq_self hm])
  refine ⟨fun ε => if h : ε < (Order.succ lam).ord then
    (((e ⟨ε, h⟩).1 : Ordinal.{u}), ((e ⟨ε, h⟩).2 : Ordinal.{u})) else (0, 0), fun γ hγ i hi => ?_⟩
  set x := e.symm (⟨γ, hγ⟩, ⟨i, hi⟩) with hxdef
  have hx' : (x : Ordinal.{u}) < (Order.succ lam).ord := x.2
  have he : e x = (⟨γ, hγ⟩, ⟨i, hi⟩) := by simp [hxdef]
  refine ⟨x, hx', ?_⟩
  show (if h : (x : Ordinal.{u}) < (Order.succ lam).ord then
    (((e ⟨x, h⟩).1 : Ordinal.{u}), ((e ⟨x, h⟩).2 : Ordinal.{u})) else (0, 0)) = _
  rw [dif_pos hx']
  change (((e x).1 : Ordinal.{u}), ((e x).2 : Ordinal.{u})) = _
  rw [he]

/-- AUX: not in paper. By basic almost stability the basic types over each model of `K_λ` can be
listed in length `λ⁺`. -/
theorem Frame.exists_en {s : Frame U L} {lam : Cardinal.{u}} (hstab : s.BasicStab lam (Order.succ lam)) :
    ∃ en : Model U L → Ordinal.{u} → Set (Tri U L), ∀ M ∈ s.S.Kc lam, ∀ p ∈ s.Sbs M,
      ∃ i < (Order.succ lam).ord, en M i = p := by
  classical
  have H : ∀ M : Model U L, ∃ e : Ordinal.{u} → Set (Tri U L), M ∈ s.S.Kc lam → ∀ p ∈ s.Sbs M,
      ∃ i < (Order.succ lam).ord, e i = p := by
    intro M
    by_cases hM : M ∈ s.S.Kc lam
    · have hle : Cardinal.lift.{u+1} #(s.Sbs M) ≤
          Cardinal.lift.{u} #(Iio (Order.succ lam).ord : Set Ordinal.{u}) := by
        have h := hstab M hM
        rw [Cardinal.mk_Iio_ordinal, Cardinal.card_ord]
        have h' : Cardinal.lift.{u+1} #(s.Sbs M) ≤ Cardinal.lift.{u+1} (Order.succ lam) :=
          Cardinal.lift_le.2 h
        simpa only [Cardinal.lift_id', Cardinal.lift_lift] using h'
      obtain ⟨j⟩ := Cardinal.lift_mk_le'.1 hle
      refine ⟨fun i => if h : ∃ p : s.Sbs M, (j p : Ordinal.{u}) = i then (h.choose : Set (Tri U L)) else ∅,
        fun _ p hp => ⟨(j ⟨p, hp⟩ : Ordinal.{u}), (j ⟨p, hp⟩).2, ?_⟩⟩
      have hex : ∃ q : s.Sbs M, (j q : Ordinal.{u}) = (j ⟨p, hp⟩ : Ordinal.{u}) := ⟨⟨p, hp⟩, rfl⟩
      simp only [dif_pos hex]
      have := j.injective (Subtype.ext hex.choose_spec)
      exact congrArg Subtype.val this
    · exact ⟨fun _ => ∅, fun h => absurd h hM⟩
  choose en hen using H
  exact ⟨en, fun M hM => hen M hM⟩

theorem mem_self_succ (α : Ordinal.{u}) : α ∈ Iic (α + 1) :=
  mem_Iic.2 (Order.lt_add_one_iff.2 le_rfl).le

theorem mem_succ_self (α : Ordinal.{u}) : α + 1 ∈ Iic (α + 1) := mem_Iic.2 le_rfl

/-- AUX: not in paper. Bookkeeping for the strategy of Prop 7.1.12(c): the `ε`-th task at stage `α`,
namely the non-forking extension to `N_{1,α}` of the listed type coded by `ε`. -/
def Frame.plusTask (s : Frame U L) (lam : Cardinal.{u}) (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u})
    (en : Model U L → Ordinal.{u} → Set (Tri U L)) (α : Ordinal.{u}) (b : Iic α → Model U L)
    (ε : Ordinal.{u}) : Set (Tri U L) :=
  open Classical in
  if h : ∃ hγ : (pr ε).1 ≤ α, ∃ q ∈ s.Sbs (b ⟨α, mem_Iic.2 le_rfl⟩),
      s.IsNFExt lam (b ⟨(pr ε).1, mem_Iic.2 hγ⟩) (b ⟨α, mem_Iic.2 le_rfl⟩) q
        (en (b ⟨(pr ε).1, mem_Iic.2 hγ⟩) (pr ε).2)
  then h.choose_spec.choose else ∅

/-- AUX: not in paper. -/
theorem Frame.plusTask_spec {s : Frame U L} {lam : Cardinal.{u}}
    {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}} {en : Model U L → Ordinal.{u} → Set (Tri U L)}
    {α α' i ε : Ordinal.{u}} {b : Iic α → Model U L} (h1 : (pr ε).1 = α') (h2 : (pr ε).2 = i)
    (hα' : α' ≤ α)
    (hex : ∃ q ∈ s.Sbs (b ⟨α, mem_Iic.2 le_rfl⟩), s.IsNFExt lam (b ⟨α', mem_Iic.2 hα'⟩)
      (b ⟨α, mem_Iic.2 le_rfl⟩) q (en (b ⟨α', mem_Iic.2 hα'⟩) i)) :
    s.plusTask lam pr en α b ε ∈ s.Sbs (b ⟨α, mem_Iic.2 le_rfl⟩) ∧
      s.IsNFExt lam (b ⟨α', mem_Iic.2 hα'⟩) (b ⟨α, mem_Iic.2 le_rfl⟩) (s.plusTask lam pr en α b ε)
        (en (b ⟨α', mem_Iic.2 hα'⟩) i) := by
  subst h1 h2
  have h : ∃ hγ : (pr ε).1 ≤ α, ∃ q ∈ s.Sbs (b ⟨α, mem_Iic.2 le_rfl⟩),
      s.IsNFExt lam (b ⟨(pr ε).1, mem_Iic.2 hγ⟩) (b ⟨α, mem_Iic.2 le_rfl⟩) q
        (en (b ⟨(pr ε).1, mem_Iic.2 hγ⟩) (pr ε).2) := ⟨hα', hex⟩
  unfold Frame.plusTask
  rw [dif_pos h]
  exact h.choose_spec.choose_spec

/-- AUX: not in paper. A choice of the moves of the strategy of Prop 7.1.12(c). -/
theorem Frame.exists_plusG [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam)
    (hs : Hyp_5_1_1 s lam) (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u})
    (en : Model U L → Ordinal.{u} → Set (Tri U L))
    (D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U) :
    ∃ G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L,
      ∀ α a b A A' B, α < (Order.succ lam).ord → a ⟨α, mem_self_succ α⟩ = A →
        a ⟨α + 1, mem_succ_self α⟩ = A' → b ⟨α, mem_Iic.2 le_rfl⟩ = B →
        A ∈ s.S.Kc lam → A' ∈ s.S.Kc lam → B ∈ s.S.Kc lam → s.S.le A A' → s.S.le A B →
        #(D α a) < #U → A'.carrier ⊆ D α a → D α a ∩ B.carrier = A.carrier →
        (G α a b).1 ∈ s.S.Kc lam ∧ s.S.le B (G α a b).1 ∧
        (∀ ε < α, s.plusTask lam pr en α b ε ∈ s.Sbs B →
          Realizes s.S lam (G α a b).1 B (s.plusTask lam pr en α b ε)) ∧
        (G α a b).2 ∈ s.S.Kc lam ∧ s.NF lam A (G α a b).1 A' (G α a b).2 ∧
        (G α a b).1.carrier ∩ D α a = A.carrier ∧ (G α a b).2.carrier ∩ D α a = A'.carrier := by
  classical
  have H : ∀ α (a : Iic (α + 1) → Model U L) (b : Iic α → Model U L), ∃ p : Model U L × Model U L,
      ∀ A A' B, α < (Order.succ lam).ord → a ⟨α, mem_self_succ α⟩ = A →
        a ⟨α + 1, mem_succ_self α⟩ = A' → b ⟨α, mem_Iic.2 le_rfl⟩ = B →
        A ∈ s.S.Kc lam → A' ∈ s.S.Kc lam → B ∈ s.S.Kc lam → s.S.le A A' → s.S.le A B →
        #(D α a) < #U → A'.carrier ⊆ D α a → D α a ∩ B.carrier = A.carrier →
        p.1 ∈ s.S.Kc lam ∧ s.S.le B p.1 ∧
        (∀ ε < α, s.plusTask lam pr en α b ε ∈ s.Sbs B →
          Realizes s.S lam p.1 B (s.plusTask lam pr en α b ε)) ∧
        p.2 ∈ s.S.Kc lam ∧ s.NF lam A p.1 A' p.2 ∧
        p.1.carrier ∩ D α a = A.carrier ∧ p.2.carrier ∩ D α a = A'.carrier := by
    intro α a b
    by_cases hh : α < (Order.succ lam).ord ∧ a ⟨α, mem_self_succ α⟩ ∈ s.S.Kc lam ∧
        a ⟨α + 1, mem_succ_self α⟩ ∈ s.S.Kc lam ∧ b ⟨α, mem_Iic.2 le_rfl⟩ ∈ s.S.Kc lam ∧
        s.S.le (a ⟨α, mem_self_succ α⟩) (a ⟨α + 1, mem_succ_self α⟩) ∧
        s.S.le (a ⟨α, mem_self_succ α⟩) (b ⟨α, mem_Iic.2 le_rfl⟩) ∧ #(D α a) < #U ∧
        (a ⟨α + 1, mem_succ_self α⟩).carrier ⊆ D α a ∧
        D α a ∩ (b ⟨α, mem_Iic.2 le_rfl⟩).carrier = (a ⟨α, mem_self_succ α⟩).carrier
    · obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hh
      obtain ⟨C, B', c1, c2, c3, c4, c5, c6, c7⟩ := Frame.plus_step hU hs h2 h3 h4 h5 h6 h7 h8 h9 h1
        (s.plusTask lam pr en α b)
      refine ⟨(C, B'), ?_⟩
      rintro A A' B - rfl rfl rfl - - - - - - - -
      exact ⟨c1, c2, c3, c4, c5, c6, c7⟩
    · refine ⟨(a ⟨α, mem_self_succ α⟩, a ⟨α, mem_self_succ α⟩), ?_⟩
      rintro A A' B h1 rfl rfl rfl h2 h3 h4 h5 h6 h7 h8 h9
      exact absurd ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ hh
  choose G hG using H
  exact ⟨G, fun α a b A A' B => hG α a b A A' B⟩

/-- AUX: not in paper. The specification of the moves chosen by `Frame.exists_plusG`. -/
def Frame.IsPlusG (s : Frame U L) (lam : Cardinal.{u}) (pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u})
    (en : Model U L → Ordinal.{u} → Set (Tri U L))
    (D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U)
    (G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L) :
    Prop :=
  ∀ α a b A A' B, α < (Order.succ lam).ord → a ⟨α, mem_self_succ α⟩ = A →
    a ⟨α + 1, mem_succ_self α⟩ = A' → b ⟨α, mem_Iic.2 le_rfl⟩ = B →
    A ∈ s.S.Kc lam → A' ∈ s.S.Kc lam → B ∈ s.S.Kc lam → s.S.le A A' → s.S.le A B →
    #(D α a) < #U → A'.carrier ⊆ D α a → D α a ∩ B.carrier = A.carrier →
    (G α a b).1 ∈ s.S.Kc lam ∧ s.S.le B (G α a b).1 ∧
    (∀ ε < α, s.plusTask lam pr en α b ε ∈ s.Sbs B →
      Realizes s.S lam (G α a b).1 B (s.plusTask lam pr en α b ε)) ∧
    (G α a b).2 ∈ s.S.Kc lam ∧ s.NF lam A (G α a b).1 A' (G α a b).2 ∧
    (G α a b).1.carrier ∩ D α a = A.carrier ∧ (G α a b).2.carrier ∩ D α a = A'.carrier

/-- AUX: not in paper. A run of length `γ` of the construction of Prop 7.1.12. -/
def Frame.IsRun (s : Frame U L) (lam : Cardinal.{u})
    (D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U)
    (G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L)
    (γ : Ordinal.{u}) (A B : Ordinal.{u} → Model U L) : Prop :=
  (0 < γ → A 0 ∈ s.S.Kc lam ∧ B 0 ∈ s.S.Kc lam ∧ s.S.le (A 0) (B 0)) ∧
  (∀ α < γ, Order.IsSuccLimit α → IsUnionOf A (Iio α) (A α) ∧ IsUnionOf B (Iio α) (B α)) ∧
  ∀ α, α + 1 < γ → A (α + 1) ∈ s.S.Kc lam ∧ s.S.lt (A α) (A (α + 1)) ∧
    #(D α fun i => A i) < #U ∧ (A (α + 1)).carrier ⊆ D α (fun i => A i) ∧
    D α (fun i => A i) ∩ (B α).carrier = (A α).carrier ∧
    B (α + 1) = (G α (fun i => A i) (fun i => B i)).2

/-- AUX: not in paper. The invariant of a run at stage `α`. -/
def Frame.RunInv (s : Frame U L) (lam : Cardinal.{u}) (A B : Ordinal.{u} → Model U L)
    (α : Ordinal.{u}) : Prop :=
  A α ∈ s.S.Kc lam ∧ B α ∈ s.S.Kc lam ∧ s.S.le (A α) (B α) ∧
    IsIncreasing s.S.le A (Iic α) ∧ IsContinuous A (Iic α) ∧
    IsIncreasing s.S.le B (Iic α) ∧ IsContinuous B (Iic α)

/-- AUX: not in paper. -/
theorem inc_add_one {S : KSys U L} (hS : IsAEC S) {X : Ordinal.{u} → Model U L} {ξ : Ordinal.{u}}
    (h : IsIncreasing S.le X (Iic ξ)) (hx : S.le (X ξ) (X (ξ + 1))) :
    IsIncreasing S.le X (Iic (ξ + 1)) := by
  intro a ha b hb hab
  have haξ : a ≤ ξ := Order.lt_add_one_iff.1 (lt_of_lt_of_le hab hb)
  rcases (show b ≤ ξ + 1 from hb).lt_or_eq with h1 | h1
  · exact h a haξ b (Order.lt_add_one_iff.1 h1) hab
  · rw [h1]
    rcases haξ.lt_or_eq with h2 | h2
    · exact hS.trans (h a haξ ξ (mem_Iic.2 le_rfl) h2) hx
    · rw [h2]; exact hx

/-- AUX: not in paper. -/
theorem cont_add_one {X : Ordinal.{u} → Model U L} {ξ : Ordinal.{u}}
    (h : IsContinuous X (Iic ξ)) : IsContinuous X (Iic (ξ + 1)) := by
  intro b hb hl
  rcases (show b ≤ ξ + 1 from hb).lt_or_eq with h1 | h1
  · exact h b (Order.lt_add_one_iff.1 h1) hl
  · subst h1
    exact absurd (hl.add_one_lt (Order.lt_add_one_iff.2 le_rfl)) (lt_irrefl _)

/-- AUX: not in paper. A chain, known below a limit `α < λ⁺`, with `X α` its union. -/
theorem chain_lim {S : KSys U L} (hS : IsAEC S) {lam : Cardinal.{u}} (hinf : ℵ₀ ≤ lam)
    {α : Ordinal.{u}} (hl : Order.IsSuccLimit α) (hα : α < (Order.succ lam).ord)
    {X : Ordinal.{u} → Model U L}
    (ih : ∀ β < α, X β ∈ S.Kc lam ∧ IsIncreasing S.le X (Iic β) ∧ IsContinuous X (Iic β))
    (hu : IsUnionOf X (Iio α) (X α)) :
    X α ∈ S.Kc lam ∧ IsIncreasing S.le X (Iic α) ∧ IsContinuous X (Iic α) ∧
      IsIncreasing S.le X (Iio α) ∧ IsContinuous X (Iio α) ∧ ∀ β < α, S.le (X β) (X α) := by
  have i1 : IsIncreasing S.le X (Iio α) := fun a _ b hb hab =>
    (ih b hb).2.1 a (mem_Iic.2 hab.le) b (mem_Iic.2 le_rfl) hab
  have c1 : IsContinuous X (Iio α) := fun b hb hl' => (ih b hb).2.2 b (mem_Iic.2 le_rfl) hl'
  have hle := (hS.le_union hl i1 c1 hu).2
  have i2 : IsIncreasing S.le X (Iic α) := fun a _ b hb hab => by
    rcases (show b ≤ α from hb).lt_or_eq with h | h
    · exact i1 a (hab.trans h) b h hab
    · rw [h]; exact hle a (h ▸ hab)
  have c2 : IsContinuous X (Iic α) := fun b hb hl' => by
    rcases (show b ≤ α from hb).lt_or_eq with h | h
    · exact c1 b h hl'
    · rw [h]; exact hu.1
  exact ⟨hS.chain_mem_Kc hinf hα i2 c2 (ih 0 hl.bot_lt).1
    (fun ε hε => (ih (ε + 1) (hl.add_one_lt hε)).1) α le_rfl, i2, c2, i1, c1, hle⟩

/-- AUX: not in paper. The invariant holds along a run. -/
theorem Frame.run_inv {s : Frame U L} {lam : Cardinal.{u}} (hc : s.Core lam) (hinf : ℵ₀ ≤ lam)
    {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}} {en : Model U L → Ordinal.{u} → Set (Tri U L)}
    {D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U}
    {G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L}
    (hG : s.IsPlusG lam pr en D G) {γ : Ordinal.{u}} (hγ : γ ≤ (Order.succ lam).ord)
    {A B : Ordinal.{u} → Model U L} (h : s.IsRun lam D G γ A B) :
    ∀ α < γ, s.RunInv lam A B α := by
  have hS : IsAEC s.S := hc.ax0a
  obtain ⟨h0, hL, hSt⟩ := h
  intro α
  induction α using Ordinal.lt_wf.induction with
  | ind α ih =>
  intro hα
  have hακ := lt_of_lt_of_le hα hγ
  rcases Ordinal.zero_or_succ_or_isSuccLimit α with rfl | ⟨ξ, hξ⟩ | hl
  · obtain ⟨a, b, c⟩ := h0 hα
    have bad : ∀ {x y : Ordinal.{u}}, y ∈ Iic (0 : Ordinal.{u}) → x < y → False :=
      fun hy hxy => absurd (lt_of_lt_of_le hxy hy) (not_lt.2 zero_le)
    have bad' : ∀ {y : Ordinal.{u}}, y ∈ Iic (0 : Ordinal.{u}) → Order.IsSuccLimit y → False :=
      fun {y} hy hl => by
        have : y = 0 := le_antisymm hy zero_le
        rw [this] at hl; exact Order.not_isSuccLimit_bot hl
    exact ⟨a, b, c, fun _ _ _ hy hxy => (bad hy hxy).elim, fun _ hy hl => (bad' hy hl).elim,
      fun _ _ _ hy hxy => (bad hy hxy).elim, fun _ hy hl => (bad' hy hl).elim⟩
  · rw [Order.succ_eq_add_one] at hξ
    subst hξ
    have hξ1 : ξ < ξ + 1 := Order.lt_add_one_iff.2 le_rfl
    obtain ⟨kA, kB, l, iA, cA, iB, cB⟩ := ih ξ hξ1 (hξ1.trans hα)
    obtain ⟨kA', hlt, hD, hsub, hDB, hB⟩ := hSt ξ hα
    obtain ⟨g1, g2, -, g4, g5, -, -⟩ := hG ξ (fun i => A i) (fun i => B i) (A ξ) (A (ξ + 1)) (B ξ)
      (hξ1.trans hακ) rfl rfl rfl kA kA' kB hlt.1 l hD hsub hDB
    rw [← hB] at g4 g5
    obtain ⟨-, -, -, -, -, l13, -, l23, -⟩ := id g5
    exact ⟨kA', g4, l23, inc_add_one hS iA hlt.1, cont_add_one cA,
      inc_add_one hS iB (hS.trans g2 l13), cont_add_one cB⟩
  · obtain ⟨uA, uB⟩ := hL α hα hl
    obtain ⟨a1, a2, a3, a4, a5, a6⟩ := chain_lim hS hinf hl hακ (X := A)
      (fun β hβ => let i := ih β hβ (hβ.trans hα); ⟨i.1, i.2.2.2.1, i.2.2.2.2.1⟩) uA
    obtain ⟨b1, b2, b3, -, -, b6⟩ := chain_lim hS hinf hl hακ (X := B)
      (fun β hβ => let i := ih β hβ (hβ.trans hα); ⟨i.2.1, i.2.2.2.2.2.1, i.2.2.2.2.2.2⟩) uB
    have l : s.S.le (A α) (B α) := hS.smooth α hl A (B α) a4 a5
      (fun β hβ => hS.trans (ih β hβ (hβ.trans hα)).2.2.1 (b6 β hβ)) (A α) uA a1.1
    exact ⟨a1, b1, l, a2, a3, b2, b3⟩

/-- AUX: not in paper. The output of the successor move of a run. -/
theorem Frame.run_step [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_5_1_1 s lam)
    (hinf : ℵ₀ ≤ lam)
    {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}} {en : Model U L → Ordinal.{u} → Set (Tri U L)}
    {D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U}
    {G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L}
    (hG : s.IsPlusG lam pr en D G) {γ : Ordinal.{u}} (hγ : γ ≤ (Order.succ lam).ord)
    {A B : Ordinal.{u} → Model U L} (h : s.IsRun lam D G γ A B) {α : Ordinal.{u}} (hα : α + 1 < γ) :
    (G α (fun i => A i) (fun i => B i)).1 ∈ s.S.Kc lam ∧
      s.S.le (B α) (G α (fun i => A i) (fun i => B i)).1 ∧
      (∀ ε < α, s.plusTask lam pr en α (fun i => B i) ε ∈ s.Sbs (B α) →
        Realizes s.S lam (G α (fun i => A i) (fun i => B i)).1 (B α)
          (s.plusTask lam pr en α (fun i => B i) ε)) ∧
      B (α + 1) ∈ s.S.Kc lam ∧
      s.NF lam (A α) (G α (fun i => A i) (fun i => B i)).1 (A (α + 1)) (B (α + 1)) ∧
      s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)) := by
  have hc : s.Core lam := hs.1.1
  have hα1 : α < γ := (Order.lt_add_one_iff.2 le_rfl).trans hα
  obtain ⟨kA, kB, l, -⟩ := Frame.run_inv hc hinf hG hγ h α hα1
  obtain ⟨kA', hlt, hD, hsub, hDB, hB⟩ := h.2.2 α hα
  obtain ⟨g1, g2, g3, g4, g5, -, -⟩ := hG α (fun i => A i) (fun i => B i) (A α) (A (α + 1)) (B α)
    (lt_of_lt_of_le hα1 hγ) rfl rfl rfl kA kA' kB hlt.1 l hD hsub hDB
  rw [← hB] at g4 g5
  exact ⟨g1, g2, g3, g4, g5, Frame.nf_symm hU hs (Frame.nf_mid hU hs (Frame.nf_symm hU hs g5) kB l g2)⟩

/-- AUX: not in paper. A complete run gives witnesses for `≺⁺` (with `E = λ⁺`). -/
theorem Frame.run_wit [C : CitedResults.{u}]
    {s : Frame U L} {lam : Cardinal.{u}} (hU : Room U lam) (hs : Hyp_5_1_1 s lam)
    (hinf : ℵ₀ ≤ lam)
    {pr : Ordinal.{u} → Ordinal.{u} × Ordinal.{u}} {en : Model U L → Ordinal.{u} → Set (Tri U L)}
    (hpr : ∀ γ < (Order.succ lam).ord, ∀ i < (Order.succ lam).ord,
      ∃ ε < (Order.succ lam).ord, pr ε = (γ, i))
    (hen : ∀ M ∈ s.S.Kc lam, ∀ p ∈ s.Sbs M, ∃ i < (Order.succ lam).ord, en M i = p)
    {D : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → Set U}
    {G : ∀ α : Ordinal.{u}, (Iic (α + 1) → Model U L) → (Iic α → Model U L) → Model U L × Model U L}
    (hG : s.IsPlusG lam pr en D G) {A B : Ordinal.{u} → Model U L} {M₀ M₁ : Model U L}
    (h : s.IsRun lam D G (Order.succ lam).ord A B) (hM₀ : IsUnionOf A (Iio (Order.succ lam).ord) M₀)
    (hM₁ : IsUnionOf B (Iio (Order.succ lam).ord) M₁) :
    s.PlusWit lam M₀ M₁ A B (fun α => (G α (fun i => A i) (fun i => B i)).1)
      (Iio (Order.succ lam).ord) ∧
    ∀ α < (Order.succ lam).ord, s.NF lam (A α) (B α) (A (α + 1)) (B (α + 1)) := by
  classical
  have hc : s.Core lam := hs.1.1
  have hS : IsAEC s.S := hc.ax0a
  have hκl := Cardinal.isSuccLimit_ord (hinf.trans (Order.le_succ lam))
  have inv := Frame.run_inv hc hinf hG le_rfl h
  have out : ∀ α < (Order.succ lam).ord, _ := fun α hα =>
    Frame.run_step hU hs hinf hG le_rfl h (hκl.add_one_lt hα)
  have Ai : IsIncreasing s.S.le A (Iio (Order.succ lam).ord) := fun a _ b hb hab =>
    (inv b hb).2.2.2.1 a (mem_Iic.2 hab.le) b (mem_Iic.2 le_rfl) hab
  have Ac : IsContinuous A (Iio (Order.succ lam).ord) := fun b hb hl =>
